import { entity, Entity, Reference } from "destack";

/// A color in the Tetris game.
export enum Color {
    Red,
    Orange,
    Yellow,
    Green,
    Blue,
    Purple,
    Brown,
}

/// Game state for Tetris.
export enum GameState {
    Playing,
    Paused,
    GameOver,
}

/// Position on the game board.
export struct Position {
    x: int32,
    y: int32,
}

/// A cell on the Tetris board.
@entity
export class Cell {
    isFilled: boolean,
    color?: Color,
}

/// The Tetris game board.
@entity
export class Board {
    width: int32 = 10,
    height: int32 = 20,
    cells: Cell[][],

    /// Create a new empty board.
    constructor(width: int32, height: int32): Board {
        const cells = Cell[width][height];
        Board { width, height, cells }
    }

    /// Check if a position is valid on the board.
    isValidPosition(pos: Position): boolean {
        pos.x >= 0 && pos.x < this.width && pos.y >= 0 && pos.y < this.height
    }

    /// Check if a cell is filled at the given position.
    isFilled(pos: Position): boolean {
        if (!this.isValidPosition(pos)) {
            return false;
        }
        this.cells[pos.y][pos.x].isFilled
    }

    /// Set a cell at the given position.
    setCell(pos: Position, color: Color) {
        if (this.isValidPosition(pos)) {
            this.cells[pos.y][pos.x] = Cell { isFilled: true, color }
        }
    }

    /// Clear completed lines and return the number cleared.
    clearLines(): int32 {
        const linesCleared = 0;
        const y = this.height - 1;
        while (y >= 0) {
            const isComplete = true;
            for (x in 0..this.width) {
                if (!this.cells[y][x].isFilled) {
                    isComplete = false;
                    break
                }
            }
            if (isComplete) {
                // remove this line
                this.cells.remove(y);
                // add new empty line at top
                const newRow: List<Cell> = Cell[this.width];
                for (x in 0..this.width) {
                    newRow.push(Cell { isFilled: false, color: null })
                }
                this.cells.append(0, newRow);
                linesCleared += 1
            } else {
                y -= 1
            }
        }
        linesCleared
    }
}

@entity
export class TetrisGame {
    board: Board,
    currentPiece?: TetrisPiece,
    currentPosition: Position,
    nextPiece?: TetrisPiece,
    score: int32 = 0,
    level: int32 = 1,
    linesCleared: int32 = 0,
    state: GameState = GameState.Playing,
    dropTimer: float32 = 0.0,
    dropInterval: float32 = 1.0,
}

/// The shape of a Tetris piece.
export enum TetrisPieceShape {
    I,
    J,
    L,
    O,
    S,
    T,
    Z,
}

/// A Tetris piece with its rotation state.
export struct TetrisPiece {
    shape: TetrisPieceShape,
    rotation: int32 = 0,
    blocks: Position[],

    /// Create a new Tetris piece.
    constructor(shape: TetrisPieceShape): TetrisPiece {
        const blocks = TetrisPiece.getBlocksForShape(shape, 0);
        TetrisPiece { shape, rotation: 0, blocks }
    }

    /// Get the color of the Tetris piece.
    getColor(): Color {
        match (this.shape) {
            TetrisPieceShape.I => Color.Blue
            TetrisPieceShape.J => Color.Red
            TetrisPieceShape.L => Color.Orange
            TetrisPieceShape.O => Color.Yellow
            TetrisPieceShape.S => Color.Green
            TetrisPieceShape.T => Color.Purple
            TetrisPieceShape.Z => Color.Brown
        }
    }

    /// Get block positions for a shape and rotation.
    getBlocksForShape(shape: TetrisPieceShape, rotation: int32): Position[] {
        const normalizedRotation = rotation % 4;
        match (shape) {
            TetrisPieceShape.I => if (normalizedRotation == 0 || normalizedRotation == 2) {
                [
                    <Position x=0 y=0 />,
                    <Position x=1 y=0 />,
                    <Position x=2 y=0 />,
                    <Position x=3 y=0 />,
                ]
            } else {
                [
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 1, y: 2 },
                    Position { x: 1, y: 3 },
                ]
            }
            TetrisPieceShape.O => [
                Position { x: 0, y: 0 },
                Position { x: 1, y: 0 },
                Position { x: 0, y: 1 },
                Position { x: 1, y: 1 },
            ]
            TetrisPieceShape.T => match (normalizedRotation) {
                0 => [
                    Position { x: 1, y: 0 },
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                ]
                1 => [
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 1, y: 2 },
                ]
                2 => [
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 1, y: 2 },
                ]
                3 => [
                    Position { x: 1, y: 0 },
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 1, y: 2 },
                ]
                _ => []
            }
            TetrisPieceShape.S => if (normalizedRotation == 0 || normalizedRotation == 2) {
                [
                    Position { x: 1, y: 0 },
                    Position { x: 2, y: 0 },
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                ]
            } else {
                [
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 2, y: 2 },
                ]
            }
            TetrisPieceShape.Z => if (normalizedRotation == 0 || normalizedRotation == 2) {
                [
                    Position { x: 0, y: 0 },
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                ]
            } else {
                [
                    Position { x: 2, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 1, y: 2 },
                ]
            }
            TetrisPieceShape.J => match (normalizedRotation) {
                0 => [
                    Position { x: 0, y: 0 },
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                ]
                1 => [
                    Position { x: 1, y: 0 },
                    Position { x: 2, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 1, y: 2 },
                ]
                2 => [
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 2, y: 2 },
                ]
                3 => [
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 0, y: 2 },
                    Position { x: 1, y: 2 },
                ]
                _ => []
            }
            TetrisPieceShape.L => match (normalizedRotation) {
                0 => [
                    Position { x: 2, y: 0 },
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                ]
                1 => [
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 1, y: 2 },
                    Position { x: 2, y: 2 },
                ]
                2 => [
                    Position { x: 0, y: 1 },
                    Position { x: 1, y: 1 },
                    Position { x: 2, y: 1 },
                    Position { x: 0, y: 2 },
                ]
                3 => [
                    Position { x: 0, y: 0 },
                    Position { x: 1, y: 0 },
                    Position { x: 1, y: 1 },
                    Position { x: 1, y: 2 },
                ]
                _ => []
            }
        }
    }

    /// Rotate the piece clockwise.
    rotate() {
        this.rotation = this.rotation + 1 % 4;
        this.blocks = TetrisPiece.getBlocksForShape(this.shape, this.rotation)
    }

    /// Get absolute positions of blocks given a base position.
    getAbsolutePositions(basePos: Position): Position[] {
        const positions = [];
        for (block in this.blocks) {
            const position = Position {
                x: basePos.x + block.x,
                y: basePos.y + block.y,
            };
            positions.push(position)
        }
        positions
    }
}

extension TetrisGame {
    /// Create a new Tetris game.
    constructor(width: int32, height: int32): TetrisGame {
        TetrisGame {
            board: Board.new(width, height),
            currentPiece: null,
            currentPosition: Position { x: 4, y: 0 },
            nextPiece: null,
            score: 0,
            level: 1,
            linesCleared: 0,
            state: GameState.Playing,
            dropTimer: 0.0,
            dropInterval: 1.0,
        }
    }

    /// Spawn a new piece at the top of the board.
    spawnPiece(shape: TetrisPieceShape) {
        const piece = TetrisPiece.new(shape);
        this.currentPiece = piece;
        this.currentPosition = Position { x: 4, y: 0 };
        // check if game over
        if (this.collidesWith(this.currentPosition)) {
            this.state = GameState.GameOver
        }
    }

    /// Check if the current piece would collide at the given position.
    collidesWith(pos: Position): boolean {
        if (const Some(piece) = this.currentPiece) {
            const absolutePositions = piece.getAbsolutePositions(pos);
            for (blockPos in absolutePositions) {
                if (this.board.isFilled(blockPos)) {
                    return true
                }
            }
        }
        false
    }

    /// Try to move the current piece in the given direction.
    tryMove(dx: int32, dy: int32): boolean {
        const newPosition = Position {
            x: this.currentPosition.x + dx,
            y: this.currentPosition.y + dy,
        };
        if (!this.collidesWith(newPosition)) {
            this.currentPosition = newPosition;
            return true
        }
        false
    }

    /// Try to rotate the current piece.
    tryRotate(): boolean {
        if (this.currentPiece != null) {
            const oldRotation = this.currentPiece.rotation;
            this.currentPiece.rotate();
            if (this.collidesWith(this.currentPosition)) {
                // rotation failed, revert
                this.currentPiece.rotation = oldRotation;
                this.currentPiece.blocks = TetrisPiece.getBlocksForShape(
                    this.currentPiece.shape,
                    oldRotation,
                );
                false
            } else {
                true
            }
        } else {
            false
        }
    }

    /// Lock the current piece to the board.
    lockPiece() {
        if (this.currentPiece != null) {
            const absolutePositions = this.currentPiece.getAbsolutePositions(this.currentPosition);
            const color = this.currentPiece.getColor();
            for (pos in absolutePositions) {
                this.board.setCell(pos, color)
            }
            // clear completed lines
            const cleared = this.board.clearLines();
            this.linesCleared += cleared;
            // update score based on lines cleared
            match (cleared) {
                1 => this.score += 100 * this.level
                2 => this.score += 300 * this.level
                3 => this.score += 500 * this.level
                4 => this.score += 800 * this.level
                _ => { }
            }
            // update level every 10 lines
            this.level = this.linesCleared / 10 + 1;
            this.dropInterval = 1.0 - this.level - 1 * 0.1;
            if (this.dropInterval < 0.1) {
                this.dropInterval = 0.1
            }
            this.currentPiece = null
        }
    }

    /// Handle input for moving left.
    moveLeft() {
        if (this.state == GameState.Playing) {
            this.tryMove(-1, 0);
        }
    }

    /// Handle input for moving right.
    moveRight() {
        if (this.state == GameState.Playing) {
            this.tryMove(1, 0);
        }
    }

    /// Handle input for soft drop.
    softDrop() {
        if (this.state == GameState.Playing) {
            if (this.tryMove(0, 1)) {
                this.score += 1;
            }
        }
    }

    /// Handle input for hard drop.
    hardDrop() {
        if (this.state == GameState.Playing) {
            const dropDistance = 0;
            while (this.tryMove(0, 1)) {
                dropDistance += 1;
            }
            this.score += dropDistance * 2;
            this.lockPiece();
        }
    }

    /// Handle input for rotation.
    rotatePiece() {
        if (this.state == GameState.Playing) {
            this.tryRotate();
        }
    }

    /// Get a random piece shape.
    getRandomShape(random: &Random): TetrisPieceShape {
        const shapes = [
            TetrisPieceShape.I,
            TetrisPieceShape.J,
            TetrisPieceShape.L,
            TetrisPieceShape.O,
            TetrisPieceShape.S,
            TetrisPieceShape.T,
            TetrisPieceShape.Z,
        ];
        shapes[random.range(0, 7)];
    }
}

extension TetrisGame implements Tick {
    tick() {
        // spawn initial piece if needed
        if (this.currentPiece == null) {
            const shape = if (const Some(next) = this.nextPiece) {
                const nextShape = next.shape;
                this.nextPiece = TetrisPiece.new(TetrisGame.getRandomShape(random));
                nextShape
            } else {
                this.nextPiece = TetrisPiece.new(TetrisGame.getRandomShape(random));
                TetrisGame.getRandomShape(random)
            };
            this.spawnPiece(shape)
        }
        // handle automatic dropping
        this.dropTimer += time.deltaTime;
        if (this.dropTimer >= this.dropInterval) {
            this.dropTimer = 0.0;
            if (!this.tryMove(0, 1)) {
                // piece can't move down, lock it
                this.lockPiece();
            }
        }
    }
}
