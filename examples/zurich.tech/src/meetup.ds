/// The status of a Meetup.
export enum MeetupStatus {
    /// The Meetup is a draft.
    @default
    Draft,
    /// The Meetup is upcoming.
    Upcoming,
    /// The Meetup is cancelled.
    Cancelled,
    /// The Meetup is past.
    Past,
}

/// A Series of related Meetups (with a common prefix).
@entity
export class MeetupSeries {
    /// The name of the Meetup Series.
    name: string,
    /// The prefix of the Meetup Series.
    prefix: string,
}

/// The language of a Meetup.
export enum MeetupLanguage {
    /// The main language of the Meetup is English.
    English,
    /// The main language of the Meetup is German.
    German,
}

@entity
export class Meetup {
    /// When the Meetup is happening.
    date: DateTime,
    /// The name of the Meetup.
    name: string,
    /// The number of the Meetup.
    number: uint,
    /// The Series this Meetup is part of.
    series?: MeetupSeries,
    /// The language of the Meetup.
    language: MeetupLanguage,
    /// The status of the Meetup.
    status: MeetupStatus,
}

@entity
export class MeetupRegistration {
    /// The Meetup this registration is for.
    meetup: Meetup,
    /// The person registering.
    user: User,
}

/// Register for a Meetup.
@action
export async function register(meetup: Meetup, user: User): MeetupRegistration {
    const registration: MeetupRegistration = MeetupRegistration { meetup, user };
    session.create(registration);
    return registration;
}
