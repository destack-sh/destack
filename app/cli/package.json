{
    "name": "@destack/cli",
    "version": "0.55.4",
    "license": "MIT",
    "type": "module",
    "description": "Destack command-line interface",
    "bin": {
        "destack": "npm/dist/bin/destack.js",
        "ds": "npm/dist/bin/ds.js",
        "dsc": "npm/dist/bin/dsc.js",
        "dsx": "npm/dist/bin/dsx.js"
    },
    "files": [
        "npm/dist",
        "README.md"
    ],
    "scripts": {
        "build": "bun x tsc -p ./npm/tsconfig.build.json",
        "stage:binaries": "bun ./npm/stage-binaries.ts",
        "stage:artifacts": "bash ./install/stage-npm-binaries-from-artifacts.sh",
        "prepublishOnly": "npm run build && bun ./npm/validate-main-package.ts",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "optionalDependencies": {
        "@destack/cli-darwin-arm64": "0.55.4",
        "@destack/cli-darwin-x64": "0.55.4",
        "@destack/cli-linux-arm64-gnu": "0.55.4",
        "@destack/cli-linux-x64-gnu": "0.55.4",
        "@destack/cli-win32-x64-msvc": "0.55.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "typescript": "5.9.3"
    }
}
