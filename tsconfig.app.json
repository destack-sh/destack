{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": ["env.d.ts", "package.json", "frontend/src/**/*", "frontend/src/**/*.vue"],
  "exclude": ["frontend/src/**/__tests__/*"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "composite": true,
    "sourceMap": true,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  }
}
