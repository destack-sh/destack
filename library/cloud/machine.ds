use dyst

/// Types of machines that provide compute.
enum MachineType {
    Runtime = 10
    Ubuntu = 1000
    Mac = 1100
    Windows = 1200
    Custom = 9000
}

/// A Machine provides physical compute.
#entity
struct Machine: Entity {
    /// Machine type.
    type: MachineType = MachineType.Runtime
    /// Runtime version string.
    version: string
    /// External provider name.
    externalName: string?
    /// External provider id.
    externalId: string?
    /// Image id in provider.
    imageId: string?
    /// vCPU count.
    cpu: float32 = 1.0
    /// RAM in GB.
    ram: float32 = 1.0
    /// Virtual display width.
    width: uint32 = 1280
    /// Virtual display height.
    height: uint32 = 960
    /// Whether to run headless.
    isHeadless: boolean = false
}

