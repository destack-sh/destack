use dyst

/// Base event regarding a Membership.
@event
struct MembershipEvent {
    /// The Membership this event pertains to.
    membership: EntityReference<Membership>,
    /// The Joinable Entity of the Membership.
    joinable: EntityReference<Joinable>,
    /// The member Entity.
    member: EntityReference<Actor>,
}

/// Membership was joined.
@event
struct MembershipJoinedEvent { 
    use MembershipEvent 

    /// The Role assigned by the Membership.
    role: EntityReference<Role>,
    /// The type of the Role.
    roleType: RoleType,
}

/// Membership was left.
@event
struct MembershipLeftEvent { 
 use MembershipEvent 
 }

/// A Membership of an Actor in a Joinable.
@entity
struct Membership {
    /// The member Entity.
    member: EntityReference<Actor>,
    /// The Role assigned to the member.
    role: ?Role,
    /// The type of the Role assigned to the member.
    roleType: ?RoleType,
}


