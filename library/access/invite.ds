use dyst

/// Base event regarding an Invite.
@event
struct InviteEvent: Event {
    /// The Invite self event pertains to.
    invite: Reference<Invite>
    /// The Joinable Entity the Invite is for.
    joinable: Reference<Joinable>
    /// The invited member Entity.
    member: Reference<Actor>
}

/// Invite was sent.
@event
struct InviteSentEvent: Event {
    /// The Role assigned by the Invite.
    role: Reference<Role>
    /// The type of the Role.
    roleType: RoleType

    use InviteEvent
}

/// Invite was rescinded.
@event
struct InviteRescindedEvent: Event {
    use InviteEvent
}

/// Invite was accepted.
@event
struct InviteAcceptedEvent: Event {
    /// The Role accepted by the member.
    role: Reference<Role>
    /// The type of the Role.
    roleType: RoleType

    use InviteEvent
}

/// Invite was rejected.
@event
struct InviteRejectedEvent: Event {
    use InviteEvent
}

/// An Invite to a Joinable.
@entity
struct Invite: Entity {
    /// The invited member.
    member: Reference<Actor>
    /// The Role offered by the Invite.
    role: Reference<Role>?
    /// The type of the Role offered by the Invite.
    roleType: RoleType?

    // TODO! #Incomplete: should "partial" nodes like this be allowed (in limited places)? 
    @if x {
        // member: Reference<Actor>
    } else {
        // member: Reference<Actor>
    }
}

