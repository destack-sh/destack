using destack;

/// A type of Sanction.
enum SanctionType {
    Ban = 1,
    Mute = 2,
}

/// Base event regarding a Sanction.
@event
struct SanctionEvent {
    /// The Sanction this event pertains to.
    sanction: Sanction,
    /// The sanctioned target Entity.
    target: Entity,
}

/// Sanction was requested.
@event
struct SanctionRequestedEvent using SanctionEvent {}

/// Sanction was granted.
@event
struct SanctionGrantedEvent using SanctionEvent {}

/// Sanction was revoked.
@event
struct SanctionRevokedEvent using SanctionEvent {}

/// Sanction has expired.
@event
struct SanctionExpiredEvent using SanctionEvent {}

/// A Sanction on some Actor.
@entity
struct Sanction {
    /// The Sanction type.
    type: SanctionType,
    /// When the Sanction expires.
    expiresAt: Optional<Timestamp>,
    /// The target Entity of the Sanction.
    target: Entity,
}


