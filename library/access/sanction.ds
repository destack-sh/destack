use dyst

/// A type of Sanction.
enum SanctionType {
    Ban = 1
    Mute = 2
}

/// Base event regarding a Sanction.
#event
struct SanctionEvent: Event {
    /// The Sanction self event pertains to.
    sanction: Sanction
    /// The sanctioned target Entity.
    target: Entity
}

/// Sanction was requested.
#event
struct SanctionRequestedEvent: Event {
    ..SanctionEvent
}

/// Sanction was granted.
#event
struct SanctionGrantedEvent: Event {
    ..SanctionEvent
}

/// Sanction was revoked.
#event
struct SanctionRevokedEvent: Event {
    ..SanctionEvent
}

/// Sanction has expired.
#event
struct SanctionExpiredEvent: Event {
    ..SanctionEvent
}

/// A Sanction on some Actor.
#entity
struct Sanction: Entity {
    /// The Sanction type.
    type: SanctionType
    /// When the Sanction expires.
    expiresAt: Timestamp?
    /// The target Entity of the Sanction.
    target: Entity
}

