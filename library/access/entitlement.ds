using dyst

/// A type of Entitlement.
enum EntitlementType {
    Permission = 1,
    Role = 2,
}

/// Base event regarding an Entitlement.
@event
struct EntitlementEvent {
    /// The Entitlement this event pertains to.
    entitlement: Entitlement,
    /// The Entitled target Entity.
    target: Entity,
}

/// Entitlement was requested.
@event
struct EntitlementRequestedEvent using EntitlementEvent {}

/// Entitlement was granted.
@event
struct EntitlementGrantedEvent using EntitlementEvent {}

/// Entitlement was revoked.
@event
struct EntitlementRevokedEvent using EntitlementEvent {}

/// Entitlement has expired.
@event
struct EntitlementExpiredEvent using EntitlementEvent {}

/// An Entitlement to some Entity.
@entity
struct Entitlement {
    /// The Entitlement type.
    type: EntitlementType,
    /// When the Entitlement expires.
    expiresAt: ?Timestamp,
    /// The target Entity of the Entitlement.
    target: Entity,
}


