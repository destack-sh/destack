use dyst

/// Base event regarding a Role.
@event
struct RoleEvent {
    /// The Role self event pertains to.
    role: Reference<Role>
    /// The actor Entity affected by the Role.
    actor: Reference<Actor>
}

/// A Role was assigned.
@event
struct RoleAssignedEvent {
    use RoleEvent
}

/// A Role was unassigned.
@event
struct RoleUnassignedEvent {
    use RoleEvent
}

/// A Role for Actors to take.
@entity
struct Role {
    /// The Role type.
    type: RoleType
}

