import destack

/// Base event regarding a Role.
@event
export struct RoleEvent {
    /// The Role self event pertains to.
    role: Reference<Role>
    /// The actor Entity affected by the Role.
    actor: Reference<Actor>
}

/// A Role was assigned.
@event
export struct RoleAssignedEvent {
    ...RoleEvent
}

/// A Role was unassigned.
@event
export struct RoleUnassignedEvent {
    ...RoleEvent
}

/// A Role for Actors to take.
@entity
export struct Role {
    /// The Role type.
    type: RoleType
}

