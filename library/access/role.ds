using destack

/// Base event regarding a Role.
@event
struct RoleEvent {
    /// The Role this event pertains to.
    role: EntityReference<Role>,
    /// The actor Entity affected by the Role.
    actor: EntityReference<Actor>,
}

/// A Role was assigned.
@event
struct RoleAssignedEvent using RoleEvent {}

/// A Role was unassigned.
@event
struct RoleUnassignedEvent using RoleEvent {}

/// A Role for Actors to take.
@entity
struct Role {
    /// The Role type.
    type: RoleType,
}


