use dyst

/// Base event regarding a Role.
#event
struct RoleEvent: Event {
    /// The Role self event pertains to.
    role: Reference<Role>
    /// The actor Entity affected by the Role.
    actor: Reference<Actor>
}

/// A Role was assigned.
#event
struct RoleAssignedEvent: Event {
    use RoleEvent
}

/// A Role was unassigned.
#event
struct RoleUnassignedEvent: Event {
    use RoleEvent
}

/// A Role for Actors to take.
#entity
struct Role: Entity {
    /// The Role type.
    type: RoleType
}

