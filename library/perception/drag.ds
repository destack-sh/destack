using dyst

/// Base drag event
@event
struct DragEvent using InputEvent {
    position: Vector2,
}

/// Drag starts
@event
struct DragStartEvent using DragEvent {}

/// Drag ends
@event
struct DragEndEvent using DragEvent {}

/// Drag over an element
@event
struct DragOverEvent using DragEvent {}

/// Drag enters an element
@event
struct DragEnterEvent using DragEvent {}

/// Drag leaves an element
@event
struct DragLeaveEvent using DragEvent {}

/// Drag dropped on an element
@event
struct DropEvent using DragEvent {}


