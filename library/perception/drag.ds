import destack

/// Base drag event
@event
export struct DragEvent: InputEvent {
    position: Vector2
}

/// Drag starts
@event
export struct DragStartEvent: DragEvent { }

/// Drag ends
@event
export struct DragEndEvent: DragEvent { }

/// Drag over an element
@event
export struct DragOverEvent: DragEvent { }

/// Drag enters an element
@event
export struct DragEnterEvent: DragEvent { }

/// Drag leaves an element
@event
export struct DragLeaveEvent: DragEvent { }

/// Drag dropped on an element
@event
export struct DropEvent: DragEvent { }

