use destack

/// Base drag event
@event
struct DragEvent: InputEvent {
    position: Vector2
}

/// Drag starts
@event
struct DragStartEvent: DragEvent { }

/// Drag ends
@event
struct DragEndEvent: DragEvent { }

/// Drag over an element
@event
struct DragOverEvent: DragEvent { }

/// Drag enters an element
@event
struct DragEnterEvent: DragEvent { }

/// Drag leaves an element
@event
struct DragLeaveEvent: DragEvent { }

/// Drag dropped on an element
@event
struct DropEvent: DragEvent { }

