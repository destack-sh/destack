use dyst

/// A Pointer is a user input device that can be used to interact with the UI
#entity
struct Pointer2D: Entity {
    ..Body2D
}

/// Base pointer event with position, pressure and modifiers
#event
struct PointerEvent: InputEvent {
    position: Vector2
    pressure: float32?
    shiftKey: boolean
    altKey: boolean
    ctrlKey: boolean
    metaKey: boolean
}

/// A PointerEvent when a pointer is pressed down
#event
struct PointerDownEvent: PointerEvent { }

/// A PointerEvent when a pointer is released
#event
struct PointerUpEvent: PointerEvent { }

/// A PointerEvent when a pointer is moved
#event
struct PointerMoveEvent: PointerEvent { }

/// A PointerEvent when a pointer enters an element
#event
struct PointerEnterEvent: PointerEvent { }

/// A PointerEvent when a pointer is over an element
#event
struct PointerOverEvent: PointerEvent { }

/// A PointerEvent when a pointer leaves an element
#event
struct PointerLeaveEvent: PointerEvent { }

/// A PointerEvent when a pointer is pressed and held
#event
struct PointerLongPressEvent: PointerEvent { }

