using destack

/// A Mousing is a user input device that can be used to interact with the UI
@entity
struct Mouse2D using Pointer2D {}

/// Mousing buttons
enum MouseButton {
    Left = 1,
    Right = 2,
    Middle = 3,
}

/// Mouse-derived event with a button
@event
struct MouseEvent using PointerEvent {
    button: MouseButton,
}

/// Click event base
@event
struct ClickEvent using MouseEvent {}

/// Single click
@event
struct SingleClickEvent using ClickEvent {}

/// Double click
@event
struct DoubleClickEvent using ClickEvent {}

/// Triple click
@event
struct TripleClickEvent using ClickEvent {}

/// Wheel scroll
@event
struct WheelEvent using MouseEvent {
    delta: Vector2,
}


