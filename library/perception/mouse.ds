using destack;

/// A Mousing is a user input device that can be used to interact with the UI
@entity(Pointer2D)
struct Mouse2D {}

/// Mousing buttons
enum MouseButton {
    Left = 1,
    Right = 2,
    Middle = 3,
}

/// Mouse-derived event with a button
@event(PointerEvent)
struct MouseEvent {
    button: MouseButton,
}

/// Click event base
@event(MouseEvent)
struct ClickEvent {}

/// Single click
@event(ClickEvent)
struct SingleClickEvent {}

/// Double click
@event(ClickEvent)
struct DoubleClickEvent {}

/// Triple click
@event(ClickEvent)
struct TripleClickEvent {}

/// Wheel scroll
@event(MouseEvent)
struct WheelEvent {
    delta: Vector2,
}


