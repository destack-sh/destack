use dyst

/// A Mouse is a user input device that can be used to interact with the UI
@entity
struct Mouse2D { 
 use Pointer2D 
 }

/// Mouse buttons
enum MouseButton {
    Left = 1,
    Right = 2,
    Middle = 3,
}

/// Mouse-derived event with a button
@event
struct MouseEvent { 
    use PointerEvent 

    button: MouseButton,
}

/// Click event base
@event
struct ClickEvent { 
 use MouseEvent 
 }

/// Single click
@event
struct SingleClickEvent { 
 use ClickEvent 
 }

/// Double click
@event
struct DoubleClickEvent { 
 use ClickEvent 
 }

/// Triple click
@event
struct TripleClickEvent { 
 use ClickEvent 
 }

/// Wheel scroll
@event
struct WheelEvent { 
    use MouseEvent 

    delta: Vector2,
}


