import destack

/// A Mouse is a user input device that can be used to interact with the UI
@entity
export struct Mouse2D: Pointer2D { }

/// Mouse buttons
export enum MouseButton {
    Left = 1
    Right = 2
    Middle = 3
}

/// Mouse-derived event with a button
@event
export struct MouseEvent: PointerEvent {
    button: MouseButton
}

/// Click event base
@event
export struct ClickEvent: MouseEvent { }

/// Single click
@event
export struct SingleClickEvent: ClickEvent { }

/// Double click
@event
export struct DoubleClickEvent: ClickEvent { }

/// Triple click
@event
export struct TripleClickEvent: ClickEvent { }

/// Wheel scroll
@event
export struct WheelEvent: MouseEvent {
    delta: Vector2
}

