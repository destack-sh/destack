use dyst

enum KeyModifier {
    Shift
    Alt
    Ctrl
    Meta
}

/// Keyboard base event
@event
struct KeyEvent { 
    use InputEvent 

    /// The character pressed (e.g. 'a', 'B', '1', 'Enter')
    key: String,
    /// The unaltered code (e.g. 'KeyA', 'KeyB', 'Digit1', 'Enter')
    code: String,
    /// Whether the key is being held down
    isRepeat: boolean,
    /// Whether the key was masked (security/privacy)
    isRedacted: boolean,
    /// Modifiers
    modifiers: KeyModifier,
}

/// Key pressed down
@event
struct KeyDownEvent { 
 use KeyEvent 
 }

/// Key released
@event
struct KeyUpEvent { 
 use KeyEvent 
 }

/// Key pressed
@event
struct KeyPressEvent { 
 use KeyEvent 
 }


