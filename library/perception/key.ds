using destack;

@flag enum KeyModifier {
    Shift,
    Alt,
    Ctrl,
    Meta,
}

/// Keyboard base event
@event(InputEvent)
struct KeyEvent {
    /// The character pressed (e.g. 'a', 'B', '1', 'Enter')
    key: String,
    /// The unaltered code (e.g. 'KeyA', 'KeyB', 'Digit1', 'Enter')
    code: String,
    /// Whether the key is being held down
    isRepeat: boolean,
    /// Whether the key was masked (security/privacy)
    isRedacted: boolean,
    /// Modifiers
    modifiers: KeyModifier,
}

/// Key pressed down
@event(KeyEvent)
struct KeyDownEvent {}

/// Key released
@event(KeyEvent)
struct KeyUpEvent {}

/// Key pressed
@event(KeyEvent)
struct KeyPressEvent {}


