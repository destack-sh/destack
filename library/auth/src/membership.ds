import * as ds from "destack"

/// Base event regarding a Membership.
@event
export struct MembershipEvent {
    /// The Membership self event pertains to.
    membership: Reference<Membership>
    /// The Joinable Entity of the Membership.
    joinable: Reference<Joinable>
    /// The member Entity.
    member: Reference<Actor>
}

/// Membership was joined.
@event
export struct MembershipJoinedEvent {
    /// The Role assigned by the Membership.
    role: Reference<Role>
    /// The type of the Role.
    roleType: RoleType

    ...MembershipEvent
}

/// Membership was left.
@event
export struct MembershipLeftEvent {
    ...MembershipEvent
}

/// A Membership of an Actor in a Joinable.
@entity
export struct Membership {
    /// The member Entity.
    member: Reference<Actor>
    /// The Role assigned to the member.
    role: Role?
    /// The type of the Role assigned to the member.
    roleType: RoleType?
}

