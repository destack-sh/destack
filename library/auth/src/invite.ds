import destack

/// Base event regarding an Invite.
@event
export struct InviteEvent {
    /// The Invite self event pertains to.
    invite: Reference<Invite>
    /// The Joinable Entity the Invite is for.
    joinable: Reference<Joinable>
    /// The invited member Entity.
    member: Reference<Actor>
}

/// Invite was sent.
@event
export struct InviteSentEvent extends InviteEvent {
    /// The Role assigned by the Invite.
    role: Reference<Role>
    /// The type of the Role.
    roleType: RoleType
}

/// Invite was rescinded.
@event
export struct InviteRescindedEvent extends InviteEvent { }

/// Invite was accepted.
@event
export struct InviteAcceptedEvent extends InviteEvent {
    /// The Role accepted by the member.
    role: Reference<Role>
    /// The type of the Role.
    roleType: RoleType
}

/// Invite was rejected.
@event
export struct InviteRejectedEvent extends InviteEvent { }

/// An Invite to a Joinable.
@entity
export struct Invite {
    /// The invited member.
    member: Reference<Actor>
    /// The Role offered by the Invite.
    role: Reference<Role>?
    /// The type of the Role offered by the Invite.
    roleType: RoleType?
}

