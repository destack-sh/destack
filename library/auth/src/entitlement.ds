import * as ds from "destack"

/// A type of Entitlement.
export enum EntitlementType {
    Permission = 1
    Role = 2
}

/// Base event regarding an Entitlement.
@event
export struct EntitlementEvent {
    /// The Entitlement self event pertains to.
    entitlement: Reference<Entitlement>

    /// The Entitled target Entity.
    target
}

/// Entitlement was requested.
@event
export struct EntitlementRequestedEvent extends EntitlementEvent { }

/// Entitlement was granted.
@event
export struct EntitlementGrantedEvent extends EntitlementEvent { }

/// Entitlement was revoked.
@event
export struct EntitlementRevokedEvent extends EntitlementEvent { }

/// Entitlement has expired.
@event
export struct EntitlementExpiredEvent extends EntitlementEvent { }

/// An Entitlement to some Entity.
@entity
export struct Entitlement {
    /// The Entitlement type.
    type: EntitlementType
    /// When the Entitlement expires.
    expiresAt: Timestamp?
    /// The target Entity of the Entitlement.
    target: Reference<Entity>
}