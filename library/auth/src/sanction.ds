import * as ds from "destack"

/// A type of Sanction.
export enum SanctionType {
    Ban = 1
    Mute = 2
}

/// Base event regarding a Sanction.
@event
export struct SanctionEvent {
    /// The Sanction self event pertains to.
    sanction: Sanction
    /// The sanctioned target Entity.
    target: Reference<Entity>
}

/// Sanction was requested.
@event
export struct SanctionRequestedEvent {
    ...SanctionEvent
}

/// Sanction was granted.
@event
export struct SanctionGrantedEvent {
    ...SanctionEvent
}

/// Sanction was revoked.
@event
export struct SanctionRevokedEvent {
    ...SanctionEvent
}

/// Sanction has expired.
@event
export struct SanctionExpiredEvent {
    ...SanctionEvent
}

/// A Sanction on some Actor.
@entity
export struct Sanction {
    /// The Sanction type.
    type: SanctionType
    /// When the Sanction expires.
    expiresAt: Timestamp?
    /// The target Entity of the Sanction.
    target: Reference<Entity>
}

