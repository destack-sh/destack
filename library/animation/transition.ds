use dyst

/// Built-in transition types
enum TransitionType {
    Tween = 10,
    Spring = 11,
}

/// Built-in spring types
enum SpringType {
    Time = 1,
    Physical = 2,
}

/// A transition value
struct Transition {
    type: TransitionType = TransitionType.Tween,
    template: ?TransitionTemplate,
    delay: ?float32,
    duration: ?float32,
    ease: [float32],
    stiffness: ?float32,
    damping: ?float32,
    mass: ?float32,
    bounce: ?float32,
    springType: ?SpringType,
}

/// A transition templatecle
@entity
struct TransitionTemplate {
    type: TransitionType = TransitionType.Tween,
    delay: ?float32,
    duration: ?float32,
    ease: [float32],
    stiffness: ?float32,
    damping: ?float32,
    mass: ?float32,
    bounce: ?float32,
    springType: ?SpringType,
}