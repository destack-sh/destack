/// A Result value which may hold Success(T) or Error(E).
union Result<T, E> {
    Success(T)
    Failure(E)

    /// Check if the Result is a Success.
    function isSuccess(self): boolean {
        match self {
            Success(_) => true
            Failure(_) => false
        }
    }

    /// Check if the Result is an Error.
    function isError(self): boolean {
        match self {
            Success(_) => false
            Failure(_) => true
        }
    }
}