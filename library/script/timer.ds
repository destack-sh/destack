import destack

/// Timer types.
export enum TimerType {
    Once = 1
    Recurring = 2
}

/// Base Timer event.
@event
export struct TimerEvent {
    /// The Timer self event pertains to.
    timer: Timer
}

/// Timer started.
@event
export struct TimerStartedEvent {
    ..TimerEvent
}
/// Timer paused.
@event
export struct TimerPausedEvent {
    ..TimerEvent
}
/// Timer resumed.
@event
export struct TimerResumedEvent {
    ..TimerEvent
}
/// Timer completed.
@event
export struct TimerCompletedEvent {
    ..TimerEvent
}
/// Timer cancelled.
@event
export struct TimerCancelledEvent {
    ..TimerEvent
}

/// A Timer.
@entity
export struct Timer {
    /// The Timer type.
    type: TimerType
    /// The optional Schedule for the Timer.
    schedule: Schedule?
}

