using destack

/// Timer types.
enum TimerType { Once = 1, Recurring = 2 }

/// Base Timer event.
@event
struct TimerEvent {
    /// The Timer this event pertains to.
    timer: Timer,
}

/// Timer started.
@event
struct TimerStartedEvent using TimerEvent {}
/// Timer paused.
@event
struct TimerPausedEvent using TimerEvent {}
/// Timer resumed.
@event
struct TimerResumedEvent using TimerEvent {}
/// Timer completed.
@event
struct TimerCompletedEvent using TimerEvent {}
/// Timer cancelled.
@event
struct TimerCancelledEvent using TimerEvent {}

/// A Timer.
@entity
struct Timer {
    /// The Timer type.
    type: TimerType,
    /// The optional Schedule for the Timer.
    schedule: ?Schedule,
}


