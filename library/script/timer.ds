use dyst

/// Timer types.
enum TimerType {
    Once = 1
    Recurring = 2
}

/// Base Timer event.
#event
struct TimerEvent: Event {
    /// The Timer self event pertains to.
    timer: Timer
}

/// Timer started.
#event
struct TimerStartedEvent: Event {
    use TimerEvent
}
/// Timer paused.
#event
struct TimerPausedEvent: Event {
    use TimerEvent
}
/// Timer resumed.
#event
struct TimerResumedEvent: Event {
    use TimerEvent
}
/// Timer completed.
#event
struct TimerCompletedEvent: Event {
    use TimerEvent
}
/// Timer cancelled.
#event
struct TimerCancelledEvent: Event {
    use TimerEvent
}

/// A Timer.
#entity
struct Timer: Entity {
    /// The Timer type.
    type: TimerType
    /// The optional Schedule for the Timer.
    schedule: Schedule?
}

