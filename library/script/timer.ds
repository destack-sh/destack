import destack

/// Timer types.
enum TimerType {
    Once = 1
    Recurring = 2
}

/// Base Timer event.
@event
struct TimerEvent {
    /// The Timer self event pertains to.
    timer: Timer
}

/// Timer started.
@event
struct TimerStartedEvent {
    ..TimerEvent
}
/// Timer paused.
@event
struct TimerPausedEvent {
    ..TimerEvent
}
/// Timer resumed.
@event
struct TimerResumedEvent {
    ..TimerEvent
}
/// Timer completed.
@event
struct TimerCompletedEvent {
    ..TimerEvent
}
/// Timer cancelled.
@event
struct TimerCancelledEvent {
    ..TimerEvent
}

/// A Timer.
@entity
struct Timer {
    /// The Timer type.
    type: TimerType
    /// The optional Schedule for the Timer.
    schedule: Schedule?
}

