use dyst

/// Timer types.
enum TimerType { Once = 1, Recurring = 2 }

/// Base Timer event.
@event
struct TimerEvent {
    /// The Timer this event pertains to.
    timer: Timer,
}

/// Timer started.
@event
struct TimerStartedEvent { 
 use TimerEvent 
 }
/// Timer paused.
@event
struct TimerPausedEvent { 
 use TimerEvent 
 }
/// Timer resumed.
@event
struct TimerResumedEvent { 
 use TimerEvent 
 }
/// Timer completed.
@event
struct TimerCompletedEvent { 
 use TimerEvent 
 }
/// Timer cancelled.
@event
struct TimerCancelledEvent { 
 use TimerEvent 
 }

/// A Timer.
@entity
struct Timer {
    /// The Timer type.
    type: TimerType,
    /// The optional Schedule for the Timer.
    schedule: ?Schedule,
}


