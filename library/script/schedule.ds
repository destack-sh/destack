use dyst

/// Day of week.
enum DayOfWeek {
    Monday = 1
    Tuesday = 2
    Wednesday = 3
    Thursday = 4
    Friday = 5
    Saturday = 6
    Sunday = 7
}

/// Month of year.
enum Month {
    January = 1
    February = 2
    March = 3
    April = 4
    May = 5
    June = 6
    July = 7
    August = 8
    September = 9
    October = 10
    November = 11
    December = 12
}

/// Schedule frequency.
enum ScheduleFrequency {
    Year = 1
    Month = 2
    Week = 3
    Day = 4
    Hour = 5
    Minute = 6
}

/// The time-based schedule of something (compatible with rrule).
struct Schedule {
    /// The recurrence frequency.
    frequency: ScheduleFrequency
    /// The recurrence interval (>= 1).
    interval: uint32 = 1
    /// The optional start timestamp.
    start: Timestamp?
    /// The optional end timestamp.
    end: Timestamp?
    /// The optional total occurrence count.
    count: uint32?
    /// The optional week start day.
    weekStart: DayOfWeek?
    /// Positions to include in the set.
    bySetPos: List<uint32>?
    /// Months to include.
    byMonth: List<Month>?
    /// Month days to include.
    byMonthDay: List<uint8>?
    /// Year days to include.
    byYearDay: List<u16>?
    /// Easter offsets to include.
    byEaster: List<uint8>?
    /// Week numbers to include.
    byWeekNo: List<uint8>?
    /// Week days to include.
    byWeekDay: List<DayOfWeek>?
    /// Hours to include.
    byHour: List<uint8>?
    /// Minutes to include.
    byMinute: List<uint8>?
    /// Seconds to include.
    bySecond: List<uint8>?
}

