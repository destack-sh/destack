import destack

/// Definition of a builtin Function.
export struct FunctionDefinition {
    /// The Function id.
    id: uint16
    /// Whether the Function is asynchronous.
    isAsync: boolean
    /// Whether the Function is managed by the system.
    isManaged: boolean
}

/// Base Function entity.
@entity
export struct Function {
    /// The Method type.
    type: MethodType
    /// Optional textual body.
    text: Text?
}

