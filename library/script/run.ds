import destack

/// Run status values.
export enum RunStatus {
    Scheduled = 2
    Running = 10
    Paused = 21
    Yielded = 23
    Cancelled = 51
    Aborted = 52
    Failed = 53
    Completed = 54
}

/// Base event regarding a Run.
@event
export struct RunEvent {
    /// The Run self event pertains to.
    run: Run

    /// The target Entity of the Run, if any.
    target?
}

/// A Run was started.
@event
export struct RunStartedEvent: RunEvent { }

/// A Run pause was requested.
@event
export struct RunPauseRequestedEvent: RunEvent { }

/// A Run was paused.
@event
export struct RunPausedEvent: RunEvent { }

/// A Run resume was requested.
@event
export struct RunResumeRequestedEvent: RunEvent { }

/// A Run was resumed.
@event
export struct RunResumedEvent: RunEvent { }

/// A Run stop was requested.
@event
export struct RunStopRequestedEvent: RunEvent { }

/// A Run failed.
@event
export struct RunFailedEvent: RunEvent { }

/// A Run completed.
@event
export struct RunCompletedEvent: RunEvent { }

/// Run of an Action.
@entity
export struct Run {
    /// The Action being run.
    action: Reference<Action>
    /// The current Run status.
    status: RunStatus
    /// Duration from first attempt start to last attempt termination.
    duration: Duration?
    /// When the Run is scheduled to start.
    scheduledAt: Timestamp?
    /// When the Run first started.
    startedAt: Timestamp?
    /// When the Run was last active.
    seenAt: Timestamp?
    /// When the Run was interrupted.
    interruptedAt: Timestamp?
    /// When the Run was last terminated.
    terminatedAt: Timestamp?
}

