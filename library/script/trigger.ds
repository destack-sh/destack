import destack

/// Trigger types.
export enum TriggerType {
    Event = 1
}

/// Base Trigger event.
@event
export struct TriggerEvent {
    /// The Trigger self event pertains to.
    trigger: Trigger
}

/// A Trigger is a dynamic event to run something.
@entity
export struct Trigger {
    /// The Event type to react to.
    event: NodeType?
    /// The optional filter Condition for the Event payload.
    where: Condition?
    /// Arguments to pass to the target.
    arguments: Map<Uuid, Value>

    /// The target Entity to invoke.
    target?
}

