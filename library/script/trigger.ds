using destack

/// Trigger types.
enum TriggerType { Event = 1 }

/// Base Trigger event.
@event
struct TriggerEvent {
    /// The Trigger this event pertains to.
    trigger: Trigger,
}

/// A Trigger is a dynamic event to run something.
@entity
struct Trigger {
    /// The Event type to react to.
    event: Optional<NodeType>,
    /// The optional filter Condition for the Event payload.
    where: Optional<Condition>,
    /// The target Entity to invoke.
    target: Optional<Entity>,
    /// Arguments to pass to the target.
    arguments: Map<Uuid, Value>,
}


