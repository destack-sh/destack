import destack

/// Definition of a builtin Action.
struct ActionDefinition {
    /// The Action type.
    type: ActionType
    /// The input Message type.
    inputMessageType: StructType?
    /// The output Message type.
    outputMessageType: StructType?
    /// The Event types self Action may emit.
    emitsEventTypes: List<NodeType>?
}

/// An implementation of a unit of work implemented for some runtimes.
@entity
struct Action {
    /// The Action type.
    type: ActionType

    ..Function
}

