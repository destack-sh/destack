use destack;

/// Definition of a builtin Action.
struct ActionDefinition {
    /// The Action type.
    type: ActionType,
    /// The input Message type.
    inputMessageType: Optional<StructType>,
    /// The output Message type.
    outputMessageType: Optional<StructType>,
    /// The Event types this Action may emit.
    emitsEventTypes: Optional<List<NodeType>>,
}

/// An implementation of a unit of work implemented for some runtimes.
@entity(Function)
struct Action {
    /// The Action type.
    type: ActionType,
}


