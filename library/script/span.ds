use dyst

/// A Span traces a Run.
@event
struct SpanEvent {
    /// The span name.
    name: String
    /// Start time of the span.
    startTime: Timestamp
    /// End time of the span.
    endTime: Timestamp
    /// Duration of the span.
    duration: Duration
    /// Optional parent Span.
    parentSpan: SpanEvent?
    /// Optional Action associated with the Span.
    action: Action?
}

