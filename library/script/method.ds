use dyst

/// Definition of a builtin Method.
struct MethodDefinition {
    /// The Method type.
    type: MethodType,
    /// Optional id of the aliased Method.
    aliasOf: ?u16,
    /// Method input Properties.w
    inputProperties: List<PropertyDefinition>,
    /// Optional output Property.
    outputProperty: ?PropertyDefinition,
}

/// A Method is a small runtime-specific piece of logic.
@entity
struct Method use Function {}


