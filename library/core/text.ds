use dyst

/// Text span types.
enum TextSpanType {
    /// Text span.
    Text,
    /// Hard break span.
    HardBreak,
    /// Node span.
    Node,
    /// Link span.
    Link,
    /// Equation span.
    Equation,
}

/// Flags that can be applied to a TextSpan.
enum TextStyleFlag {
    /// Default style flag.
    Default,
    /// Bold style flag.
    Bold,
    /// Italic style flag.
    Italic,
    /// Strikethrough style flag.
    Strikethrough,
    /// Underline style flag.
    Underline,
    /// Code style flag.
    Code,
}

/// Span of text with optional styling.
struct TextSpan {
    /// The span type.
    type: TextSpanType = TextSpanType.Text,
    /// Optional textual content.
    content: ?String,
    /// Optional reference to a Node.
    node: ?EntityReference<Entity>,
    /// Optional hyperlink URL.
    url: ?String,
    /// Styling flags for self span.
    styleFlags: TextStyleFlag = TextStyleFlag.Default,
}

/// A single paragraph composed of TextSpans with inline styling.
struct Text {
    /// The spans composing the paragraph.
    spans: List<TextSpan>
    /// Styling flags for the whole paragraph.
    styleFlags: TextStyleFlag = TextStyleFlag.Default
}


