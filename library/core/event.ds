using dyst

/// The consensus status of an Event.
enum EventStatus {
    /// Event is pending consensus.
    Pending,
    /// Event is staged for consensus.
    Staged,
    /// Event has been approved by consensus.
    Approved,
    /// Event was skipped during consensus.
    Skipped,
    /// Event failed during consensus.
    Failed,
    /// Event was rejected by consensus.
    Rejected,
}

/// An immutable datum of something happening to an Entity.
@event
struct Event {
    /// The universally unique identifier of this Node.
    id: Uuid,
    /// The Space this Node is in.
    space: EntityReference<Space>,
    /// The Branch this Node is part of (in its Space).
    branch: EntityReference<Branch>,
    /// The Snapshot this Node is part of (in its Space and Branch).
    snapshot: EntityReference<Snapshot>,

    /// The logical time this Event was created (system).
    createdEpoch: uint64,
    /// The exclusive owner of this Entity (the root on access).
    owner: EntityReference<Entity>,
    /// The Client that created this Event (client, but verified).
    client: EntityReference<Client>,
    /// The nonce of the Client that created this Event (client).
    clientNonce: uint8,
    /// The logical time last seen from the system in the Client for this space (client).
    clientRemoteEpoch: uint64,
    /// The logical time in the Client when it created this Event (client).
    clientLocalEpoch: uint64,
    /// The status of the Event (system).
    status: EventStatus = EventStatus.Pending,
    /// The Event that caused this Event (if any).
    causedBy: Optional<EntityReference<Event>>,
}