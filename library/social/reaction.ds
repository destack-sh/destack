import destack

/// A Reaction is a relationship between an Actor and a reactable Node.
@entity
struct Reaction {
    /// The reaction content, e.g. an emoji.
    content: string
}

/// Base Reaction event.
@event
struct ReactionEvent {
    /// The Reaction self event pertains to.
    reaction: Reference<Reaction>
    /// The reaction content.
    content: string
}

/// Reaction added.
@event
struct ReactionAddedEvent: ReactionEvent { }

/// Reaction removed.
@event
struct ReactionRemovedEvent: ReactionEvent { }

