import destack

/// A Reaction is a relationship between an Actor and a reactable Node.
@entity
export struct Reaction {
    /// The reaction content, e.g. an emoji.
    content: string
}

/// Base Reaction event.
@event
export struct ReactionEvent {
    /// The Reaction self event pertains to.
    reaction: Reference<Reaction>
    /// The reaction content.
    content: string
}

/// Reaction added.
@event
export struct ReactionAddedEvent extends ReactionEvent { }

/// Reaction removed.
@event
export struct ReactionRemovedEvent extends ReactionEvent { }

