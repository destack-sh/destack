use dyst

/// A Follow is a relationship between an Actor and a followable Node.
@entity
struct Follow {}

/// Base Follow event.
@event
struct FollowEvent: Event {
    /// The Follow self event pertains to.
    follow: Reference<Follow>,
}

/// Follow added.
@event
struct FollowAddedEvent: FollowEvent {}

/// Follow removed.
@event
struct FollowRemovedEvent: FollowEvent {}