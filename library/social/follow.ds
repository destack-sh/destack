import destack

/// A Follow is a relationship between an Actor and a followable Node.
@entity
export struct Follow { }

/// Base Follow event.
@event
export struct FollowEvent {
    /// The Follow self event pertains to.
    follow: Reference<Follow>
}

/// Follow added.
@event
export struct FollowAddedEvent: FollowEvent { }

/// Follow removed.
@event
export struct FollowRemovedEvent: FollowEvent { }