use dyst

/// Notification status.
enum NotificationStatus {
    Unread = 1
    Read = 2
    Dismissed = 3
    Expired = 4
    Rescinded = 5
}

/// Base Notification event.
#event
struct NotificationEvent: Event {
    /// The Notification self event pertains to.
    notification: Reference<Notification>
}

/// Notification sent.
#event
struct NotificationSentEvent: NotificationEvent { }
/// Notification rescinded.
#event
struct NotificationRescindedEvent: NotificationEvent { }
/// Notification read.
#event
struct NotificationReadEvent: NotificationEvent { }
/// Notification dismissed.
#event
struct NotificationDismissedEvent: NotificationEvent { }
/// Notification expired.
#event
struct NotificationExpiredEvent: NotificationEvent { }

/// A Notification is a message about something.
#entity
struct Notification: Entity {
    /// The title of the Notification.
    title: string
    /// The status of the Notification.
    status: NotificationStatus
    /// Optional text content.
    text: Text?
}

