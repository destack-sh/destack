import destack

/// Notification status.
export enum NotificationStatus {
    Unread = 1
    Read = 2
    Dismissed = 3
    Expired = 4
    Rescinded = 5
}

/// Base Notification event.
@event
export struct NotificationEvent {
    /// The Notification self event pertains to.
    notification: Reference<Notification>
}

/// Notification sent.
@event
export struct NotificationSentEvent: NotificationEvent { }
/// Notification rescinded.
@event
export struct NotificationRescindedEvent: NotificationEvent { }
/// Notification read.
@event
export struct NotificationReadEvent: NotificationEvent { }
/// Notification dismissed.
@event
export struct NotificationDismissedEvent: NotificationEvent { }
/// Notification expired.
@event
export struct NotificationExpiredEvent: NotificationEvent { }

/// A Notification is a message about something.
@entity
export struct Notification {
    /// The title of the Notification.
    title: string
    /// The status of the Notification.
    status: NotificationStatus
    /// Optional text content.
    text: Text?
}

