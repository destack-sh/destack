use destack

/// A Star is a relationship between an Actor and a starred Node.
@entity
struct Star { }

/// Base Star event.
@event
struct StarEvent {
    /// The Star self event pertains to.
    star: Reference<Star>
}

/// Star added.
@event
struct StarAddedEvent: StarEvent { }

/// Star removed.
@event
struct StarRemovedEvent: StarEvent { }

