use dyst

/// A Path is a polyline of multiple points.
struct Path2D { 
    use Form2D 

    points: List<Vector2>
    isClosed: boolean
}

/// A PathShape is a shape that represents a polyline of multiple points.
@entity
struct PathShape2D: Shape2D { 
    use Path2D 
}

/// A Polyline3D is a polygonal chain in 3D space.
struct Polyline3D {
    use Form3D

    points: List<Vector3>
    isClosed: boolean
}

/// A PolylineShape3D represents a polygonal chain in 3D space.
@entity
struct PolylineShape3D: Shape3D { 
    use Polyline3D 
}
