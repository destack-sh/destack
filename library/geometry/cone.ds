import destack

/// A Cone is aligned with the local z axis with a base radius and height.
export struct Cone3D {
    radius: float32
    height: float32

    ...Form3D
}

/// A ConeShape3D is a 3D shape that represents a cone.
@entity
export struct ConeShape3D extends Shape3D {
    radius: float32
    height: float32

    ...Cone3D
}

