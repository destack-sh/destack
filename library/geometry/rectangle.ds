using destack;

/// A Rectangle is a rectangle.
struct Rectangle2D using Form2D {
    width: float32,
    height: float32,
}

/// A RectangleShape is a shape that represents a rectangle.
@entity(Shape2D)
struct RectangleShape2D using Rectangle2D {}

/// A Box is an axis-aligned box defined by width, height and depth.
struct Box3D using Form3D {
    width: float32,
    height: float32,
    depth: float32,
}

/// A BoxShape3D is a shape that represents an axis-aligned box.
@entity(Shape3D)
struct BoxShape3D using Box3D {}


