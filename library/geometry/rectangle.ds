use destack

/// A Rectangle is a rectangle.
struct Rectangle2D {
    width: float32
    height: float32

    ..Form2D
}

/// A RectangleShape is a shape that represents a rectangle.
@entity
struct RectangleShape2D: Shape2D {
    ..Rectangle2D
}

/// A Box is an axis-aligned box defined by width, height and depth.
struct Box3D: Form3D {
    width: float32
    height: float32
    depth: float32
}

/// A BoxShape3D is a shape that represents an axis-aligned box.
@entity
struct BoxShape3D: Shape3D {
    ..Box3D
}