using destack

/// A Segment is a line between two points.
struct Segment2D using Form2D {
    startOffset: Vector2,
    endOffset: Vector2,
}

/// A SegmentShape is a shape that represents a line between two points.
@entity
struct SegmentShape2D using Shape2D, Segment2D {}

/// A Segment3D is a line between two points in 3D space.
struct Segment3D using Form3D {
    startOffset: Vector3,
    endOffset: Vector3,
}

/// A SegmentShape3D is a shape that represents a line between two points in 3D.
@entity
struct SegmentShape3D using Shape3D, Segment3D {}