import destack

/// A Segment is a line between two points.
export struct Segment2D {
    startOffset: Vector2
    endOffset: Vector2

    ..Form2D
}

/// A SegmentShape is a shape that represents a line between two points.
@entity
export struct SegmentShape2D: Shape2D {
    ..Segment2D
}

/// A Segment3D is a line between two points in 3D space.
export struct Segment3D {
    startOffset: Vector3
    endOffset: Vector3

    ..Form3D
}

/// A SegmentShape3D is a shape that represents a line between two points in 3D.
@entity
export struct SegmentShape3D: Shape3D {
    ..Segment3D
}