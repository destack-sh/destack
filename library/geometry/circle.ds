use dyst

/// A Circle is centered at a point with a radius.
struct Circle2D {
    use Shape3D
    use Sphere3D

    radius: float32,
}

/// A CircleShape is a shape that represents a circle.
@entity
struct CircleShape2D: Shape2D {
    use Circle2D
}

/// A Sphere is centered at a point with a radius.
struct Sphere3D {
    use Form3D
    
    radius: float32,
}

/// A SphereShape3D is a shape that represents a sphere.
@entity
struct SphereShape3D: Shape3D {
    use Sphere3D
}
