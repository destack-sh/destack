/// A 4-dimensional vector with int32 components.
struct Vector4i {
    x: int32,
    y: int32,
    z: int32,
    w: int32,
}

implement Vector4i {
    /// The zero Vector4i (0, 0, 0, 0).
    const Zero: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: 0 };
    /// The one Vector4i (1, 1, 1, 1).
    const One: Vector4i = Vector4i { x: 1, y: 1, z: 1, w: 1 };
    /// The unit x Vector4i (1, 0, 0, 0).
    const UnitX: Vector4i = Vector4i { x: 1, y: 0, z: 0, w: 0 };
    /// The unit y Vector4i (0, 1, 0, 0).
    const UnitY: Vector4i = Vector4i { x: 0, y: 1, z: 0, w: 0 };
    /// The unit z Vector4i (0, 0, 1, 0).
    const UnitZ: Vector4i = Vector4i { x: 0, y: 0, z: 1, w: 0 };
    /// The unit w Vector4i (0, 0, 0, 1).
    const UnitW: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: 1 };
    /// The negative unit x Vector4i (-1, 0, 0, 0).
    const NegUnitX: Vector4i = Vector4i { x: -1, y: 0, z: 0, w: 0 };
    /// The negative unit y Vector4i (0, -1, 0, 0).
    const NegUnitY: Vector4i = Vector4i { x: 0, y: -1, z: 0, w: 0 };
    /// The negative unit z Vector4i (0, 0, -1, 0).
    const NegUnitZ: Vector4i = Vector4i { x: 0, y: 0, z: -1, w: 0 };
    /// The negative unit w Vector4i (0, 0, 0, -1).
    const NegUnitW: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: -1 };

    /// Construct a Vector4i from x, y, z and w components.
    function new(x: int32, y: int32, z: int32, w: int32) -> Vector4i {
        Vector4i { x, y, z, w }
    }

    /// Construct a Vector4i with all components set to the same value.
    function splat(v: int32) -> Vector4i {
        Vector4i { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector as float32.
    function length(self) -> float32 {
        let fx = self.x as float32;
        let fy = self.y as float32;
        let fz = self.z as float32;
        let fw = self.w as float32;
        (fx * fx + fy * fy + fz * fz + fw * fw).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    function lengthSquared(self) -> int32 {
        self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector4i) -> int32 {
        self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
    }

    /// Compute Euclidean distance to another Vector4i as float32.
    function distance(self, other: Vector4i) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector4i as int32.
    function distanceSquared(self, other: Vector4i) -> int32 {
        (self - other).lengthSquared()
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector4i {
        Vector4i { x: self.x.abs(), y: self.y.abs(), z: self.z.abs(), w: self.w.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector4i) -> Vector4i {
        Vector4i {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
            w: if self.w < other.w { self.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector4i) -> Vector4i {
        Vector4i {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
            w: if self.w > other.w { self.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector4i, max: Vector4i) -> Vector4i {
        let clampScalar = function (v: int32, lo: int32, hi: int32) -> int32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector4i {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
            w: clampScalar(self.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: int32) -> Vector4i {
        Vector4i { x, y: self.y, z: self.z, w: self.w }
    }

    /// Create a copy with a different y component.
    function withY(self, y: int32) -> Vector4i {
        Vector4i { x: self.x, y, z: self.z, w: self.w }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: int32) -> Vector4i {
        Vector4i { x: self.x, y: self.y, z, w: self.w }
    }

    /// Create a copy with a different w component.
    function withW(self, w: int32) -> Vector4i {
        Vector4i { x: self.x, y: self.y, z: self.z, w }
    }
}

