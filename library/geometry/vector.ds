use destack.simulation;

/// A 2-dimensional vector with float32 components.
struct Vector2 {
    x: float32,
    y: float32,
}
@assert(@sizeOf(Vector2) == 8)

implement Vector2 {
    /// The zero Vector2 (0, 0).
    const Zero: Vector2 = Vector2 { x: 0.0, y: 0.0 };
    /// The one Vector2 (1, 1).
    const One: Vector2 = Vector2 { x: 1.0, y: 1.0 };
    /// The unit x Vector2 (1, 0).
    const UnitX: Vector2 = Vector2 { x: 1.0, y: 0.0 };
    /// The unit y Vector2 (0, 1).
    const UnitY: Vector2 = Vector2 { x: 0.0, y: 1.0 };
    /// The negative unit x Vector2 (-1, 0).
    const NegUnitX: Vector2 = Vector2 { x: -1.0, y: 0.0 };
    /// The negative unit y Vector2 (0, -1).
    const NegUnitY: Vector2 = Vector2 { x: 0.0, y: -1.0 };

    /// Construct a Vector2 from x and y components.
    function new(x: float32, y: float32) -> Vector2 {
        Vector2 { x, y }
    }

    /// Construct a Vector2 with both components set to the same value.
    function splat(v: float32) -> Vector2 {
        Vector2 { x: v, y: v }
    }

    /// Returns the length of the Vector.
    function length(self) -> float32 {
        (self.x * self.x + self.y * self.y).sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) -> float32 {
        self.x * self.x + self.y * self.y
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector2) -> float32 {
        self.x * other.x + self.y * other.y
    }

    /// Returns the cross product of the two Vectors.
    function cross(self, other: Vector2) -> float32 {
        self.x * other.y - self.y * other.x
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) -> Vector2 {
        let len = self.length();
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector2.
    function distance(self, other: Vector2) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector2.
    function distanceSquared(self, other: Vector2) -> float32 {
        (self - other).lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector2, t: float32) -> Vector2 {
        self + (other - self) * t
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector2 {
        Vector2 { x: self.x.abs(), y: self.y.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector2) -> Vector2 {
        Vector2 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector2) -> Vector2 {
        Vector2 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector2, max: Vector2) -> Vector2 {
        let clampScalar = function (v: float32, lo: float32, hi: float32) -> float32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector2 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) -> Vector2 {
        Vector2 { x, y: self.y }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) -> Vector2 {
        Vector2 { x: self.x, y }
    }

    /// Rotate 90 degrees counter-clockwise (perpendicular vector).
    function perp(self) -> Vector2 {
        Vector2 { x: -self.y, y: self.x }
    }
}

implement Add<float32> for Vector2 {
    function add(self, other: float32) -> Vector2 {
        Vector2 { x: self.x + other, y: self.y + other }
    }
}

implement Add<Vector2> for Vector2 {
    function add(self, other: Vector2) -> Vector2 {
        Vector2 { x: self.x + other.x, y: self.y + other.y }
    }
}

implement Subtract<float32> for Vector2 {
    function subtract(self, other: float32) -> Vector2 {
        Vector2 { x: self.x - other, y: self.y - other }
    }
}

implement Subtract<Vector2> for Vector2 {
    function subtract(self, other: Vector2) -> Vector2 {
        Vector2 { x: self.x - other.x, y: self.y - other.y }
    }
}

implement Multiply<float32> for Vector2 {
    function multiply(self, other: float32) -> Vector2 {
        Vector2 { x: self.x * other, y: self.y * other }
    }
}

implement Multiply<Vector2> for Vector2 {
    function multiply(self, other: Vector2) -> Vector2 {
        Vector2 { x: self.x * other.x, y: self.y * other.y }
    }
}

implement Divide<float32> for Vector2 {
    function divide(self, other: float32) -> Vector2 {
        Vector2 { x: self.x / other, y: self.y / other }
    }
}


/// A 3-dimensional vector with float32 components.
struct Vector3 {
    x: float32,
    y: float32,
    z: float32,
}

implement Vector3 {
    /// The zero Vector3 (0, 0, 0).
    const Zero: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    /// The one Vector3 (1, 1, 1).
    const One: Vector3 = Vector3 { x: 1.0, y: 1.0, z: 1.0 };
    /// The unit x Vector3 (1, 0, 0).
    const UnitX: Vector3 = Vector3 { x: 1.0, y: 0.0, z: 0.0 };
    /// The unit y Vector3 (0, 1, 0).
    const UnitY: Vector3 = Vector3 { x: 0.0, y: 1.0, z: 0.0 };
    /// The unit z Vector3 (0, 0, 1).
    const UnitZ: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 1.0 };
    /// The negative unit x Vector3 (-1, 0, 0).
    const NegUnitX: Vector3 = Vector3 { x: -1.0, y: 0.0, z: 0.0 };
    /// The negative unit y Vector3 (0, -1, 0).
    const NegUnitY: Vector3 = Vector3 { x: 0.0, y: -1.0, z: 0.0 };
    /// The negative unit z Vector3 (0, 0, -1).
    const NegUnitZ: Vector3 = Vector3 { x: 0.0, y: 0.0, z: -1.0 };

    /// Construct a Vector3 from x, y and z components.
    function new(x: float32, y: float32, z: float32) -> Vector3 {
        Vector3 { x, y, z }
    }

    /// Construct a Vector3 with all components set to the same value.
    function splat(v: float32) -> Vector3 {
        Vector3 { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector.
    function length(self) -> float32 {
        (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) -> float32 {
        self.x * self.x + self.y * self.y + self.z * self.z
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector3) -> float32 {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    /// Returns the cross product of the two Vectors.
    function cross(self, other: Vector3) -> Vector3 {
        Vector3 {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x,
        }
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) -> Vector3 {
        let len = self.length();
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector3.
    function distance(self, other: Vector3) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector3.
    function distanceSquared(self, other: Vector3) -> float32 {
        (self - other).lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector3, t: float32) -> Vector3 {
        self + (other - self) * t
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector3 {
        Vector3 { x: self.x.abs(), y: self.y.abs(), z: self.z.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector3) -> Vector3 {
        Vector3 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector3) -> Vector3 {
        Vector3 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector3, max: Vector3) -> Vector3 {
        let clampScalar = function (v: float32, lo: float32, hi: float32) -> float32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector3 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) -> Vector3 {
        Vector3 { x, y: self.y, z: self.z }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) -> Vector3 {
        Vector3 { x: self.x, y, z: self.z }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: float32) -> Vector3 {
        Vector3 { x: self.x, y: self.y, z }
    }
}

implement Add<float32> for Vector3 {
    function add(self, other: float32) -> Vector3 {
        Vector3 { x: self.x + other, y: self.y + other, z: self.z + other }
    }
}

implement Add<Vector3> for Vector3 {
    function add(self, other: Vector3) -> Vector3 {
        Vector3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
    }
}

implement Subtract<float32> for Vector3 {
    function subtract(self, other: float32) -> Vector3 {
        Vector3 { x: self.x - other, y: self.y - other, z: self.z - other }
    }
}

implement Subtract<Vector3> for Vector3 {
    function subtract(self, other: Vector3) -> Vector3 {
        Vector3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z }
    }
}

implement Multiply<float32> for Vector3 {
    function multiply(self, other: float32) -> Vector3 {
        Vector3 { x: self.x * other, y: self.y * other, z: self.z * other }
    }
}

implement Multiply<Vector3> for Vector3 {
    function multiply(self, other: Vector3) -> Vector3 {
        Vector3 { x: self.x * other.x, y: self.y * other.y, z: self.z * other.z }
    }
}

implement Divide<float32> for Vector3 {
    function divide(self, other: float32) -> Vector3 {
        Vector3 { x: self.x / other, y: self.y / other, z: self.z / other }
    }
}

/// A 4-dimensional vector with float32 components.
struct Vector4 {
    x: float32,
    y: float32,
    z: float32,
    w: float32,
}

implement Vector4 {
    /// The zero Vector4 (0, 0, 0, 0).
    const Zero: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    /// The one Vector4 (1, 1, 1, 1).
    const One: Vector4 = Vector4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 };
    /// The unit x Vector4 (1, 0, 0, 0).
    const UnitX: Vector4 = Vector4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 };
    /// The unit y Vector4 (0, 1, 0, 0).
    const UnitY: Vector4 = Vector4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 };
    /// The unit z Vector4 (0, 0, 1, 0).
    const UnitZ: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 };
    /// The unit w Vector4 (0, 0, 0, 1).
    const UnitW: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 };
    /// The negative unit x Vector4 (-1, 0, 0, 0).
    const NegUnitX: Vector4 = Vector4 { x: -1.0, y: 0.0, z: 0.0, w: 0.0 };
    /// The negative unit y Vector4 (0, -1, 0, 0).
    const NegUnitY: Vector4 = Vector4 { x: 0.0, y: -1.0, z: 0.0, w: 0.0 };
    /// The negative unit z Vector4 (0, 0, -1, 0).
    const NegUnitZ: Vector4 = Vector4 { x: 0.0, y: 0.0, z: -1.0, w: 0.0 };
    /// The negative unit w Vector4 (0, 0, 0, -1).
    const NegUnitW: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: -1.0 };

    /// Construct a Vector4 from x, y, z and w components.
    function new(x: float32, y: float32, z: float32, w: float32) -> Vector4 {
        Vector4 { x, y, z, w }
    }

    /// Construct a Vector4 with all components set to the same value.
    function splat(v: float32) -> Vector4 {
        Vector4 { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector.
    function length(self) -> float32 {
        (self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w).sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) -> float32 {
        self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector4) -> float32 {
        self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) -> Vector4 {
        let len = self.length();
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector4.
    function distance(self, other: Vector4) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector4.
    function distanceSquared(self, other: Vector4) -> float32 {
        (self - other).lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector4, t: float32) -> Vector4 {
        self + (other - self) * t
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector4 {
        Vector4 { x: self.x.abs(), y: self.y.abs(), z: self.z.abs(), w: self.w.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector4) -> Vector4 {
        Vector4 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
            w: if self.w < other.w { self.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector4) -> Vector4 {
        Vector4 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
            w: if self.w > other.w { self.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector4, max: Vector4) -> Vector4 {
        let clampScalar = function (v: float32, lo: float32, hi: float32) -> float32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector4 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
            w: clampScalar(self.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) -> Vector4 {
        Vector4 { x, y: self.y, z: self.z, w: self.w }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) -> Vector4 {
        Vector4 { x: self.x, y, z: self.z, w: self.w }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: float32) -> Vector4 {
        Vector4 { x: self.x, y: self.y, z, w: self.w }
    }

    /// Create a copy with a different w component.
    function withW(self, w: float32) -> Vector4 {
        Vector4 { x: self.x, y: self.y, z: self.z, w }
    }
}

implement Add<float32> for Vector4 {
    function add(self, other: float32) -> Vector4 {
        Vector4 { x: self.x + other, y: self.y + other, z: self.z + other, w: self.w + other }
    }
}

implement Add<Vector4> for Vector4 {
    function add(self, other: Vector4) -> Vector4 {
        Vector4 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z, w: self.w + other.w }
    }
}

implement Subtract<float32> for Vector4 {
    function subtract(self, other: float32) -> Vector4 {
        Vector4 { x: self.x - other, y: self.y - other, z: self.z - other, w: self.w - other }
    }
}

implement Subtract<Vector4> for Vector4 {
    function subtract(self, other: Vector4) -> Vector4 {
        Vector4 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z, w: self.w - other.w }
    }
}

implement Multiply<float32> for Vector4 {
    function multiply(self, other: float32) -> Vector4 {
        Vector4 { x: self.x * other, y: self.y * other, z: self.z * other, w: self.w * other }
    }
}

implement Multiply<Vector4> for Vector4 {
    function multiply(self, other: Vector4) -> Vector4 {
        Vector4 { x: self.x * other.x, y: self.y * other.y, z: self.z * other.z, w: self.w * other.w }
    }
}

implement Divide<float32> for Vector4 {
    function divide(self, other: float32) -> Vector4 {
        Vector4 { x: self.x / other, y: self.y / other, z: self.z / other, w: self.w / other }
    }
}

/// A 2-dimensional vector with int32 components.
struct Vector2i {
    x: int32,
    y: int32,
}

implement Vector2i {
    /// The zero Vector2i (0, 0).
    const Zero: Vector2i = Vector2i { x: 0, y: 0 };
    /// The one Vector2i (1, 1).
    const One: Vector2i = Vector2i { x: 1, y: 1 };
    /// The unit x Vector2i (1, 0).
    const UnitX: Vector2i = Vector2i { x: 1, y: 0 };
    /// The unit y Vector2i (0, 1).
    const UnitY: Vector2i = Vector2i { x: 0, y: 1 };
    /// The negative unit x Vector2i (-1, 0).
    const NegUnitX: Vector2i = Vector2i { x: -1, y: 0 };
    /// The negative unit y Vector2i (0, -1).
    const NegUnitY: Vector2i = Vector2i { x: 0, y: -1 };

    /// Construct a Vector2i from x and y components.
    function new(x: int32, y: int32) -> Vector2i {
        Vector2i { x, y }
    }

    /// Construct a Vector2i with both components set to the same value.
    function splat(v: int32) -> Vector2i {
        Vector2i { x: v, y: v }
    }

    /// Returns the length of the Vector as float32.
    function length(self) -> float32 {
        let fx = self.x as float32;
        let fy = self.y as float32;
        (fx * fx + fy * fy).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    function lengthSquared(self) -> int32 {
        self.x * self.x + self.y * self.y
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector2i) -> int32 {
        self.x * other.x + self.y * other.y
    }

    /// Compute Euclidean distance to another Vector2i as float32.
    function distance(self, other: Vector2i) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector2i as int32.
    function distanceSquared(self, other: Vector2i) -> int32 {
        (self - other).lengthSquared()
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector2i {
        Vector2i { x: self.x.abs(), y: self.y.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector2i) -> Vector2i {
        Vector2i {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector2i) -> Vector2i {
        Vector2i {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector2i, max: Vector2i) -> Vector2i {
        let clampScalar = function (v: int32, lo: int32, hi: int32) -> int32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector2i {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: int32) -> Vector2i {
        Vector2i { x, y: self.y }
    }

    /// Create a copy with a different y component.
    function withY(self, y: int32) -> Vector2i {
        Vector2i { x: self.x, y }
    }
}

implement Add<int32> for Vector2i {
    function add(self, other: int32) -> Vector2i {
        Vector2i { x: self.x + other, y: self.y + other }
    }
}

implement Add<Vector2i> for Vector2i {
    function add(self, other: Vector2i) -> Vector2i {
        Vector2i { x: self.x + other.x, y: self.y + other.y }
    }
}

implement Subtract<int32> for Vector2i {
    function subtract(self, other: int32) -> Vector2i {
        Vector2i { x: self.x - other, y: self.y - other }
    }
}

implement Subtract<Vector2i> for Vector2i {
    function subtract(self, other: Vector2i) -> Vector2i {
        Vector2i { x: self.x - other.x, y: self.y - other.y }
    }
}

implement Multiply<int32> for Vector2i {
    function multiply(self, other: int32) -> Vector2i {
        Vector2i { x: self.x * other, y: self.y * other }
    }
}

implement Multiply<Vector2i> for Vector2i {
    function multiply(self, other: Vector2i) -> Vector2i {
        Vector2i { x: self.x * other.x, y: self.y * other.y }
    }
}

implement Divide<int32> for Vector2i {
    function divide(self, other: int32) -> Vector2i {
        Vector2i { x: self.x / other, y: self.y / other }
    }
}

/// A 3-dimensional vector with int32 components.
struct Vector3i {
    x: int32,
    y: int32,
    z: int32,
}

implement Vector3i {
    /// The zero Vector3i (0, 0, 0).
    const Zero: Vector3i = Vector3i { x: 0, y: 0, z: 0 };
    /// The one Vector3i (1, 1, 1).
    const One: Vector3i = Vector3i { x: 1, y: 1, z: 1 };
    /// The unit x Vector3i (1, 0, 0).
    const UnitX: Vector3i = Vector3i { x: 1, y: 0, z: 0 };
    /// The unit y Vector3i (0, 1, 0).
    const UnitY: Vector3i = Vector3i { x: 0, y: 1, z: 0 };
    /// The unit z Vector3i (0, 0, 1).
    const UnitZ: Vector3i = Vector3i { x: 0, y: 0, z: 1 };
    /// The negative unit x Vector3i (-1, 0, 0).
    const NegUnitX: Vector3i = Vector3i { x: -1, y: 0, z: 0 };
    /// The negative unit y Vector3i (0, -1, 0).
    const NegUnitY: Vector3i = Vector3i { x: 0, y: -1, z: 0 };
    /// The negative unit z Vector3i (0, 0, -1).
    const NegUnitZ: Vector3i = Vector3i { x: 0, y: 0, z: -1 };

    /// Construct a Vector3i from x, y and z components.
    function new(x: int32, y: int32, z: int32) -> Vector3i {
        Vector3i { x, y, z }
    }

    /// Construct a Vector3i with all components set to the same value.
    function splat(v: int32) -> Vector3i {
        Vector3i { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector as float32.
    function length(self) -> float32 {
        let fx = self.x as float32;
        let fy = self.y as float32;
        let fz = self.z as float32;
        (fx * fx + fy * fy + fz * fz).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    function lengthSquared(self) -> int32 {
        self.x * self.x + self.y * self.y + self.z * self.z
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector3i) -> int32 {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    /// Compute Euclidean distance to another Vector3i as float32.
    function distance(self, other: Vector3i) -> float32 {
        (self - other).length()
    }

    /// Compute squared Euclidean distance to another Vector3i as int32.
    function distanceSquared(self, other: Vector3i) -> int32 {
        (self - other).lengthSquared()
    }

    /// Component-wise absolute value.
    function abs(self) -> Vector3i {
        Vector3i { x: self.x.abs(), y: self.y.abs(), z: self.z.abs() }
    }

    /// Component-wise minimum.
    function min(self, other: Vector3i) -> Vector3i {
        Vector3i {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector3i) -> Vector3i {
        Vector3i {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector3i, max: Vector3i) -> Vector3i {
        let clampScalar = function (v: int32, lo: int32, hi: int32) -> int32 {
            if v < lo { lo } else { if v > hi { hi } else { v } }
        };
        Vector3i {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: int32) -> Vector3i {
        Vector3i { x, y: self.y, z: self.z }
    }

    /// Create a copy with a different y component.
    function withY(self, y: int32) -> Vector3i {
        Vector3i { x: self.x, y, z: self.z }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: int32) -> Vector3i {
        Vector3i { x: self.x, y: self.y, z }
    }
}

