import destack.simulation

/// A 2-dimensional vector with float32 components.
export struct Vector2 {
    x: float32
    y: float32

    /// Conexport struct a Vector2 from x and y components.
    constructor(x: float32, y: float32) => Vector2 {
        Vector2 { x, y }
    }
}

export async function clampScalar(v: float32, lo: float32, hi: float32) => float32 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

extension Vector2 {
    /// The zero Vector2 (0, 0).
    const Zero = Vector2 { x: 0.0, y: 0.0 }
    /// The one Vector2 (1, 1).
    const One = Vector2 { x: 1.0, y: 1.0 }
    /// The unit x Vector2 (1, 0).
    const UnitX = Vector2 { x: 1.0, y: 0.0 }
    /// The unit y Vector2 (0, 1).
    const UnitY = Vector2 { x: 0.0, y: 1.0 }
    /// The negative unit x Vector2 (-1, 0).
    const NegUnitX = Vector2 {
        x: -1.0,
        y: 0.0,
    }
    /// The negative unit y Vector2 (0, -1).
    const NegUnitY = Vector2 {
        x: 0.0,
        y: -1.0,
    }

    /// Conexport struct a Vector2 with both components set to the same value.
    function splat(v: float32) => Vector2 {
        Vector2 { x: v, y: v }
    }

    /// Returns the length of the Vector.
    function length(self) => float32 {
        self.x * self.x + self.y * self.y.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) => float32 {
        self.x * self.x + self.y * self.y
    }
    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector2) => float32 {
        self.x * other.x + self.y * other.y
    }

    /// Returns the cross product of the two Vectors.
    function cross(self, other: Vector2) => float32 {
        self.x * other.y - self.y * other.x
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) => Vector2 {
        const len = self.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector2.
    function distance(self, other: Vector2) => float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector2.
    function distanceSquared(self, other: Vector2) => float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector2, t: float32) => Vector2 {
        self + other - self * t
    }
    /// Component-wise absolute value.
    function abs(self) => Vector2 {
        Vector2 {
            x: self.x.abs(),
            y: self.y.abs(),
        }
    }

    /// Component-wise minimum.
    function min(self, other: Vector2) => Vector2 {
        Vector2 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector2) => Vector2 {
        Vector2 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector2, max: Vector2) => Vector2 {
        Vector2 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) => Vector2 {
        Vector2 { x, y: self.y }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) => Vector2 {
        Vector2 { x: self.x, y }
    }

    /// Rotate 90 degrees counter-clockwise (perpendicular vector).
    function perp(self) => Vector2 {
        Vector2 {
            x: -self.y,
            y: self.x,
        }
    }
}

extension Vector2 implements Numeric<float32> {
    function add(self, other: float32) => Vector2 {
        Vector2 {
            x: self.x + other,
            y: self.y + other,
        }
    }

    function subtract(self, other: float32) => Vector2 {
        Vector2 {
            x: self.x - other,
            y: self.y - other,
        }
    }

    function multiply(self, other: float32) => Vector2 {
        Vector2 {
            x: self.x * other,
            y: self.y * other,
        }
    }

    function divide(self, other: float32) => Vector2 {
        Vector2 {
            x: self.x / other,
            y: self.y / other,
        }
    }
}

extension Vector2 implements Numeric<Vector2> {
    function add(self, other: Vector2) => Vector2 {
        Vector2 {
            x: self.x + other.x,
            y: self.y + other.y,
        }
    }

    function subtract(self, other: Vector2) => Vector2 {
        Vector2 {
            x: self.x - other.x,
            y: self.y - other.y,
        }
    }

    function multiply(self, other: Vector2) => Vector2 {
        Vector2 {
            x: self.x * other.x,
            y: self.y * other.y,
        }
    }

    function divide(self, other: Vector2) => Vector2 {
        Vector2 {
            x: self.x / other.x,
            y: self.y / other.y,
        }
    }
}

/// A 3-dimensional vector with float32 components.
export struct Vector3 {
    x: float32
    y: float32
    z: float32
}

extension Vector3 {
    /// The zero Vector3 (0, 0, 0).
    const Zero = Vector3 { x: 0.0, y: 0.0, z: 0.0 }
    /// The one Vector3 (1, 1, 1).
    const One = Vector3 { x: 1.0, y: 1.0, z: 1.0 }
    /// The unit x Vector3 (1, 0, 0).
    const UnitX = Vector3 { x: 1.0, y: 0.0, z: 0.0 }
    /// The unit y Vector3 (0, 1, 0).
    const UnitY = Vector3 { x: 0.0, y: 1.0, z: 0.0 }
    /// The unit z Vector3 (0, 0, 1).
    const UnitZ = Vector3 { x: 0.0, y: 0.0, z: 1.0 }
    /// The negative unit x Vector3 (-1, 0, 0).
    const NegUnitX = Vector3 {
        x: -1.0,
        y: 0.0,
        z: 0.0,
    }
    /// The negative unit y Vector3 (0, -1, 0).
    const NegUnitY = Vector3 {
        x: 0.0,
        y: -1.0,
        z: 0.0,
    }
    /// The negative unit z Vector3 (0, 0, -1).
    const NegUnitZ = Vector3 {
        x: 0.0,
        y: 0.0,
        z: -1.0,
    }

    /// Conexport struct a Vector3 from x, y and z components.
    function new(x: float32, y: float32, z: float32) => Vector3 {
        Vector3 { x, y, z }
    }

    /// Conexport struct a Vector3 with all components set to the same value.
    function splat(v: float32) => Vector3 {
        Vector3 { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector.
    function length(self) => float32 {
        self.x * self.x + self.y * self.y + self.z * self.z.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) => float32 {
        self.x * self.x + self.y * self.y + self.z * self.z
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector3) => float32 {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    /// Returns the cross product of the two Vectors.
    function cross(self, other: Vector3) => Vector3 {
        Vector3 {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x,
        }
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) => Vector3 {
        const len = self.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector3.
    function distance(self, other: Vector3) => float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector3.
    function distanceSquared(self, other: Vector3) => float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector3, t: float32) => Vector3 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    function abs(self) => Vector3 {
        Vector3 {
            x: self.x.abs(),
            y: self.y.abs(),
            z: self.z.abs(),
        }
    }

    /// Component-wise minimum.
    function min(self, other: Vector3) => Vector3 {
        Vector3 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector3) => Vector3 {
        Vector3 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector3, max: Vector3) => Vector3 {
        Vector3 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) => Vector3 {
        Vector3 { x, y: self.y, z: self.z }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) => Vector3 {
        Vector3 { x: self.x, y, z: self.z }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: float32) => Vector3 {
        Vector3 { x: self.x, y: self.y, z }
    }
}

extension Vector3 implements Add<float32> {
    function add(self, other: float32) => Vector3 {
        Vector3 {
            x: self.x + other,
            y: self.y + other,
            z: self.z + other,
        }
    }
}

extension Vector3 implements Add<Vector3> {
    function add(self, other: Vector3) => Vector3 {
        Vector3 {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }
}

extension Vector3 implements Subtract<float32> {
    function subtract(self, other: float32) => Vector3 {
        Vector3 {
            x: self.x - other,
            y: self.y - other,
            z: self.z - other,
        }
    }
}

extension Vector3 implements Subtract<Vector3> {
    function subtract(self, other: Vector3) => Vector3 {
        Vector3 {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
        }
    }
}

extension Vector3 implements Multiply<float32> {
    function multiply(self, other: float32) => Vector3 {
        Vector3 {
            x: self.x * other,
            y: self.y * other,
            z: self.z * other,
        }
    }
}

extension Vector3 implements Multiply<Vector3> {
    function multiply(self, other: Vector3) => Vector3 {
        Vector3 {
            x: self.x * other.x,
            y: self.y * other.y,
            z: self.z * other.z,
        }
    }
}

extension Vector3 implements Divide<float32> {
    function divide(self, other: float32) => Vector3 {
        Vector3 {
            x: self.x / other,
            y: self.y / other,
            z: self.z / other,
        }
    }
}

/// A 4-dimensional vector with float32 components.
export struct Vector4 {
    x: float32
    y: float32
    z: float32
    w: float32
}

extension Vector4 {
    /// The zero Vector4 (0, 0, 0, 0).
    const Zero = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The one Vector4 (1, 1, 1, 1).
    const One = Vector4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 }
    /// The unit x Vector4 (1, 0, 0, 0).
    const UnitX = Vector4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The unit y Vector4 (0, 1, 0, 0).
    const UnitY = Vector4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 }
    /// The unit z Vector4 (0, 0, 1, 0).
    const UnitZ = Vector4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 }
    /// The unit w Vector4 (0, 0, 0, 1).
    const UnitW = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    /// The negative unit x Vector4 (-1, 0, 0, 0).
    const NegUnitX = Vector4 {
        x: -1.0,
        y: 0.0,
        z: 0.0,
        w: 0.0,
    }
    /// The negative unit y Vector4 (0, -1, 0, 0).
    const NegUnitY = Vector4 {
        x: 0.0,
        y: -1.0,
        z: 0.0,
        w: 0.0,
    }
    /// The negative unit z Vector4 (0, 0, -1, 0).
    const NegUnitZ = Vector4 {
        x: 0.0,
        y: 0.0,
        z: -1.0,
        w: 0.0,
    }
    /// The negative unit w Vector4 (0, 0, 0, -1).
    const NegUnitW = Vector4 {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        w: -1.0,
    }

    /// Conexport struct a Vector4 from x, y, z and w components.
    function new(x: float32, y: float32, z: float32, w: float32) => Vector4 {
        Vector4 { x, y, z, w }
    }

    /// Conexport struct a Vector4 with all components set to the same value.
    function splat(v: float32) => Vector4 {
        Vector4 { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector.
    function length(self) => float32 {
        self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(self) => float32 {
        self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    }

    /// Returns the dot product of the two Vectors.
    function dot(self, other: Vector4) => float32 {
        self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(self) => Vector4 {
        const len = self.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector4.
    function distance(self, other: Vector4) => float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector4.
    function distanceSquared(self, other: Vector4) => float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(self, other: Vector4, t: float32) => Vector4 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    function abs(self) => Vector4 {
        Vector4 {
            x: self.x.abs(),
            y: self.y.abs(),
            z: self.z.abs(),
            w: self.w.abs(),
        }
    }

    /// Component-wise minimum.
    function min(self, other: Vector4) => Vector4 {
        Vector4 {
            x: if self.x < other.x { self.x } else { other.x },
            y: if self.y < other.y { self.y } else { other.y },
            z: if self.z < other.z { self.z } else { other.z },
            w: if self.w < other.w { self.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    function max(self, other: Vector4) => Vector4 {
        Vector4 {
            x: if self.x > other.x { self.x } else { other.x },
            y: if self.y > other.y { self.y } else { other.y },
            z: if self.z > other.z { self.z } else { other.z },
            w: if self.w > other.w { self.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(self, min: Vector4, max: Vector4) => Vector4 {
        Vector4 {
            x: clampScalar(self.x, min.x, max.x),
            y: clampScalar(self.y, min.y, max.y),
            z: clampScalar(self.z, min.z, max.z),
            w: clampScalar(self.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    function withX(self, x: float32) => Vector4 {
        Vector4 { x, y: self.y, z: self.z, w: self.w }
    }

    /// Create a copy with a different y component.
    function withY(self, y: float32) => Vector4 {
        Vector4 { x: self.x, y, z: self.z, w: self.w }
    }

    /// Create a copy with a different z component.
    function withZ(self, z: float32) => Vector4 {
        Vector4 { x: self.x, y: self.y, z, w: self.w }
    }

    /// Create a copy with a different w component.
    function withW(self, w: float32) => Vector4 {
        Vector4 { x: self.x, y: self.y, z: self.z, w }
    }
}

extension Vector4 implements Add<float32> {
    function add(self, other: float32) => Vector4 {
        Vector4 {
            x: self.x + other,
            y: self.y + other,
            z: self.z + other,
            w: self.w + other,
        }
    }
}

extension Vector4 implements Add<Vector4> {
    function add(self, other: Vector4) => Vector4 {
        Vector4 {
            x: self.x + other.x,
            y: self.y + other.y,
