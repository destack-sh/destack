        }
    }
}

/// A 2-dimensional vector with int32 components.
export struct Vector2i {
    x: int32
    y: int32
}

extension Vector2i {
    /// The zero Vector2i (0, 0).
    const Zero = Vector2i { x: 0, y: 0 }
    /// The one Vector2i (1, 1).
    const One = Vector2i { x: 1, y: 1 }
    /// The unit x Vector2i (1, 0).
    const UnitX = Vector2i { x: 1, y: 0 }
    /// The unit y Vector2i (0, 1).
    const UnitY = Vector2i { x: 0, y: 1 }
    /// The negative unit x Vector2i (-1, 0).
    const NegUnitX = Vector2i {
        x: -1,
        y: 0,
    }
    /// The negative unit y Vector2i (0, -1).
    const NegUnitY = Vector2i {
        x: 0,
        y: -1,
    }

    /// Construct struct a Vector2i with both components set to the same value.
    function splat(v: int32): Vector2i {
        Vector2i { x: v, y: v }
    }

    /// Returns the length of the Vector as float32.
    function length(): float32 {
        const fx = this.x as float32
        const fy = this.y as float32
        fx * fx + fy * fy.sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    function lengthSquared(): int32 {
        this.x * this.x + this.y * this.y
    }

    /// Returns the dot product of the two Vectors.
    function dot(other: Vector2i): int32 {
        this.x * other.x + this.y * other.y
    }

    /// Compute Euclidean distance to another Vector2i as float32.
    function distance(other: Vector2i): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector2i as int32.
    function distanceSquared(other: Vector2i): int32 {
        self - other.lengthSquared()
    }

    /// Component-wise absolute value.
    function abs(): Vector2i {
        Vector2i {
            x: this.x.abs(),
            y: this.y.abs(),
        }
    }

    /// Component-wise minimum.
    function min(other: Vector2i): Vector2i {
        Vector2i {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    function max(other: Vector2i): Vector2i {
        Vector2i {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(min: Vector2i, max: Vector2i): Vector2i {
        Vector2i {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    function withX(x: int32): Vector2i {
        Vector2i { x, y: this.y }
    }

    /// Create a copy with a different y component.
    function withY(y: int32): Vector2i {
        Vector2i { x: this.x, y: y }
    }
}

extension Vector2i implements Add<int32> {
    function add(other: int32): Vector2i {
        Vector2i {
            x: this.x + other,
            y: this.y + other,
        }
    }
}

extension Vector2i implements Add<Vector2i> {
    function add(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x + other.x,
            y: this.y + other.y,
        }
    }
}

extension Vector2i implements Subtract<int32> {
    function subtract(other: int32): Vector2i {
        Vector2i {
            x: this.x - other,
            y: this.y - other,
        }
    }
}

extension Vector2i implements Subtract<Vector2i> {
    function subtract(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x - other.x,
            y: this.y - other.y,
        }
    }
}

extension Vector2i implements Multiply<int32> {
    function multiply(other: int32): Vector2i {
        Vector2i {
            x: this.x * other,
            y: this.y * other,
        }
    }
}

extension Vector2i implements Multiply<Vector2i> {
    function multiply(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x * other.x,
            y: this.y * other.y,
        }
    }
}

extension Vector2i implements Divide<int32> {
    function divide(other: int32): Vector2i {
        Vector2i {
            x: this.x / other,
            y: this.y / other,
        }
    }
}

/// A 3-dimensional vector with int32 components.
export struct Vector3i {
    x: int32
    y: int32
    z: int32
}

extension Vector3i {
    /// The zero Vector3i (0, 0, 0).
    const Zero = Vector3i { x: 0, y: 0, z: 0 }
    /// The one Vector3i (1, 1, 1).
    const One = Vector3i { x: 1, y: 1, z: 1 }
    /// The unit x Vector3i (1, 0, 0).
    const UnitX = Vector3i { x: 1, y: 0, z: 0 }
    /// The unit y Vector3i (0, 1, 0).
    const UnitY = Vector3i { x: 0, y: 1, z: 0 }
    /// The unit z Vector3i (0, 0, 1).
    const UnitZ = Vector3i { x: 0, y: 0, z: 1 }
    /// The negative unit x Vector3i (-1, 0, 0).
    const NegUnitX = Vector3i {
        x: -1,
        y: 0,
        z: 0,
    }
    /// The negative unit y Vector3i (0, -1, 0).
    const NegUnitY = Vector3i {
        x: 0,
        y: -1,
        z: 0,
    }
    /// The negative unit z Vector3i (0, 0, -1).
    const NegUnitZ = Vector3i {
        x: 0,
        y: 0,
        z: -1,
    }

    /// Construct struct a Vector3i with all components set to the same value.
    function splat(v: int32): Vector3i {
        Vector3i { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector as float32.
    function length(): float32 {
        const fx = this.x as float32
        const fy = this.y as float32
        const fz = this.z as float32
        fx * fx + fy * fy + fz * fz.sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    function lengthSquared(): int32 {
        this.x * this.x + this.y * this.y + this.z * this.z
    }

    /// Returns the dot product of the two Vectors.
    function dot(other: Vector3i): int32 {
        this.x * other.x + this.y * other.y + this.z * other.z
    }

    /// Compute Euclidean distance to another Vector3i as float32.
    function distance(other: Vector3i): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector3i as int32.
    function distanceSquared(other: Vector3i): int32 {
        self - other.lengthSquared()
    }

    /// Component-wise absolute value.
    function abs(): Vector3i {
        Vector3i {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
        }
    }

    /// Component-wise minimum.
    function min(other: Vector3i): Vector3i {
        Vector3i {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    function max(other: Vector3i): Vector3i {
        Vector3i {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(min: Vector3i, max: Vector3i): Vector3i {
        Vector3i {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    function withX(x: int32): Vector3i {
        Vector3i { x, y: this.y, z: this.z }
    }

    /// Create a copy with a different y component.
    function withY(y: int32): Vector3i {
        Vector3i { x: this.x, y, z: this.z }
    }

    /// Create a copy with a different z component.
    function withZ(z: int32): Vector3i {
        Vector3i { x: this.x, y: this.y, z }
    }
}

