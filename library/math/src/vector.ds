/// A 4-dimensional vector with int32 components.
export struct Vector4i {
    x: int32
    y: int32
    z: int32
    w: int32
}

implement Vector4i {
    /// The zero Vector4i (0, 0, 0, 0).
    static Zero: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: 0 }
    /// The one Vector4i (1, 1, 1, 1).
    static One: Vector4i = Vector4i { x: 1, y: 1, z: 1, w: 1 }
    /// The unit x Vector4i (1, 0, 0, 0).
    static UnitX: Vector4i = Vector4i { x: 1, y: 0, z: 0, w: 0 }
    /// The unit y Vector4i (0, 1, 0, 0).
    static UnitY: Vector4i = Vector4i { x: 0, y: 1, z: 0, w: 0 }
    /// The unit z Vector4i (0, 0, 1, 0).
    static UnitZ: Vector4i = Vector4i { x: 0, y: 0, z: 1, w: 0 }
    /// The unit w Vector4i (0, 0, 0, 1).
    static UnitW: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: 1 }
    /// The negative unit x Vector4i (-1, 0, 0, 0).
    static NegUnitX: Vector4i = Vector4i { x: -1, y: 0, z: 0, w: 0 }
    /// The negative unit y Vector4i (0, -1, 0, 0).
    static NegUnitY: Vector4i = Vector4i { x: 0, y: -1, z: 0, w: 0 }
    /// The negative unit z Vector4i (0, 0, -1, 0).
    static NegUnitZ: Vector4i = Vector4i { x: 0, y: 0, z: -1, w: 0 }
    /// The negative unit w Vector4i (0, 0, 0, -1).
    static NegUnitW: Vector4i = Vector4i { x: 0, y: 0, z: 0, w: -1 }

    /// Construct a Vector4i with all components set to the same value.
    static splat(v: int32): Vector4i {
        Vector4i { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector as float32.
    length(): float32 {
        let fx = this.x as float32
        let fy = this.y as float32
        let fz = this.z as float32
        let fw = this.w as float32
        (fx * fx + fy * fy + fz * fz + fw * fw).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    lengthSquared(): int32 {
        this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector4i): int32 {
        this.x * other.x + this.y * other.y + this.z * other.z + this.w * other.w
    }

    /// Compute Euclidean distance to another Vector4i as float32.
    distance(other: Vector4i): float32 {
        (this - other).length()
    }

    /// Compute squared Euclidean distance to another Vector4i as int32.
    distanceSquared(other: Vector4i): int32 {
        (this - other).lengthSquared()
    }

    /// Component-wise absolute value.
    abs(): Vector4i {
        Vector4i {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
            w: this.w.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector4i): Vector4i {
        Vector4i {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
            w: if this.w < other.w { this.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    max(other: Vector4i): Vector4i {
        Vector4i {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
            w: if this.w > other.w { this.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector4i, max: Vector4i): Vector4i {
        Vector4i {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
            w: clampScalar(this.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    withX(x: int32): Vector4i {
        Vector4i { x, y: this.y, z: this.z, w: this.w }
    }

    /// Create a copy with a different y component.
    withY(y: int32): Vector4i {
        Vector4i { x: this.x, y, z: this.z, w: this.w }
    }

    /// Create a copy with a different z component.
    withZ(z: int32): Vector4i {
        Vector4i { x: this.x, y: this.y, z, w: this.w }
    }

    /// Create a copy with a different w component.
    withW(w: int32): Vector4i {
        Vector4i { x: this.x, y: this.y, z: this.z, w }
    }
}

