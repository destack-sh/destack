import * as ds from "destack"

export async function clampScalar(v: float32, lo: float32, hi: float32): float32 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

/// A 2-dimensional vector with float32 components.
export struct Vector2 {
    x: float32,
    y: float32,

    /// The zero Vector2 (0, 0).
    static Zero = Vector2 { x: 0.0, y: 0.0 };
    /// The one Vector2 (1, 1).
    static One = Vector2 { x: 1.0, y: 1.0 };
    /// The unit x Vector2 (1, 0).
    static UnitX = Vector2 { x: 1.0, y: 0.0 };
    /// The unit y Vector2 (0, 1).
    static UnitY = Vector2 { x: 0.0, y: 1.0 };
    /// The negative unit x Vector2 (-1, 0).
    static NegUnitX = Vector2 { x: -1.0, y: 0.0 };
    /// The negative unit y Vector2 (0, -1).
    static NegUnitY = Vector2 { x: 0.0, y: -1.0 };

    /// Construct struct a Vector2 with both components set to the same value.
    static splat(v: float32): Vector2 {
        Vector2 { x: v, y: v }
    }

    /// Returns the length of the Vector.
    length(): float32 {
        this.x * this.x + this.y * this.y.sqrt()
    }

    /// Returns the squared length of the Vector.
    lengthSquared(): float32 {
        this.x * this.x + this.y * this.y
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector2): float32 {
        this.x * other.x + this.y * other.y
    }

    /// Returns the cross product of the two Vectors.
    cross(other: Vector2): float32 {
        this.x * other.y - this.y * other.x
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    normalized(): Vector2 {
        const len = this.length();
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector2.
    distance(other: Vector2): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector2.
    distanceSquared(other: Vector2): float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    lerp(other: Vector2, t: float32): Vector2 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    abs(): Vector2 {
        Vector2 {
            x: this.x.abs(),
            y: this.y.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector2): Vector2 {
        Vector2 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    max(other: Vector2): Vector2 {
        Vector2 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector2, max: Vector2): Vector2 {
        Vector2 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    withX(x: float32): Vector2 {
        Vector2 { x, y: this.y }
    }

    /// Create a copy with a different y component.
    withY(y: float32): Vector2 {
        Vector2 { x: this.x, y }
    }

    /// Rotate 90 degrees counter-clockwise (perpendicular vector).
    perp(): Vector2 {
        Vector2 {
            x: -this.y,
            y: this.x,
        }
    }
}

implement Vector2 implements Numeric<float32> {
    add(other: float32): Vector2 {
        Vector2 {
            x: this.x + other,
            y: this.y + other,
        }
    }

    subtract(other: float32): Vector2 {
        Vector2 {
            x: this.x - other,
            y: this.y - other,
        }
    }

    multiply(other: float32): Vector2 {
        Vector2 {
            x: this.x * other,
            y: this.y * other,
        }
    }

    divide(other: float32): Vector2 {
        Vector2 {
            x: this.x / other,
            y: this.y / other,
        }
    }
}

implement Vector2 implements Numeric<Vector2> {
    add(other: Vector2): Vector2 {
        Vector2 {
            x: this.x + other.x,
            y: this.y + other.y,
        }
    }

    subtract(other: Vector2): Vector2 {
        Vector2 {
            x: this.x - other.x,
            y: this.y - other.y,
        }
    }

    multiply(other: Vector2): Vector2 {
        Vector2 {
            x: this.x * other.x,
            y: this.y * other.y,
        }
    }

    divide(other: Vector2): Vector2 {
        Vector2 {
            x: this.x / other.x,
            y: this.y / other.y,
        }
    }
}

/// A 3-dimensional vector with float32 components.
export struct Vector3 {
    x: float32
    y: float32
    z: float32

    /// The zero Vector3 (0, 0, 0).
    static Zero: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 }
    /// The one Vector3 (1, 1, 1).
    static One: Vector3 = Vector3 { x: 1.0, y: 1.0, z: 1.0 }
    /// The unit x Vector3 (1, 0, 0).
    static UnitX: Vector3 = Vector3 { x: 1.0, y: 0.0, z: 0.0 }
    /// The unit y Vector3 (0, 1, 0).
    static UnitY: Vector3 = Vector3 { x: 0.0, y: 1.0, z: 0.0 }
    /// The unit z Vector3 (0, 0, 1).
    static UnitZ: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 1.0 }
    /// The negative unit x Vector3 (-1, 0, 0).
    static NegUnitX: Vector3 = Vector3 { x: -1.0, y: 0.0, z: 0.0 }
    /// The negative unit y Vector3 (0, -1, 0).
    static NegUnitY: Vector3 = Vector3 { x: 0.0, y: -1.0, z: 0.0 }
    /// The negative unit z Vector3 (0, 0, -1).
    static NegUnitZ: Vector3 = Vector3 { x: 0.0, y: 0.0, z: -1.0 }

    /// Construct a Vector3 with all components set to the same value.
    static splat(v: float32): Vector3 {
        Vector3 { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector3.
    length(): float32 {
        (this.x * this.x + this.y * this.y + this.z * this.z).sqrt()
    }

    /// Returns the squared length of the Vector3.
    lengthSquared(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector3): float32 {
        this.x * other.x + this.y * other.y + this.z * other.z
    }

    /// Returns the cross product of the two Vectors.
    cross(other: Vector3): Vector3 {
        Vector3 {
            x: this.y * other.z - this.z * other.y,
            y: this.z * other.x - this.x * other.z,
            z: this.x * other.y - this.y * other.x,
        }
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    normalized(): Vector3 {
        let len = this.length()
        if len == 0.0 { this } else { this / len }
    }

    /// Compute Euclidean distance to another Vector3.
    distance(other: Vector3): float32 {
        (this - other).length()
    }

    /// Compute squared Euclidean distance to another Vector3.
    distanceSquared(other: Vector3): float32 {
        (this - other).lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    lerp(other: Vector3, t: float32): Vector3 {
        this + (other - this) * t
    }

    /// Component-wise absolute value.
    abs(): Vector3 {
        Vector3 {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector3): Vector3 {
        Vector3 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    max(other: Vector3): Vector3 {
        Vector3 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector3, max: Vector3): Vector3 {
        Vector3 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    withX(x: float32): Vector3 {
        Vector3 { x, y: this.y, z: this.z }
    }

    /// Create a copy with a different y component.
    withY(y: float32): Vector3 {
        Vector3 { x: this.x, y, z: this.z }
    }

    /// Create a copy with a different z component.
    withZ(z: float32): Vector3 {
        Vector3 { x: this.x, y: this.y, z }
    }
}

implement Vector3 implements (
    Add<float32>,
    Subtract<float32>,
    Multiply<float32>,
    Divide<float32>,
    Add<Vector3>,
    Subtract<Vector3>,
    Multiply<Vector3>,
    Divide<Vector3>,
) {
    add(other: float32): Vector3 {
        Vector3 {
            x: this.x + other,
            y: this.y + other,
            z: this.z + other,
        }
    }

    add(other: Vector3): Vector3 {
        Vector3 {
            x: this.x + other.x,
            y: this.y + other.y,
            z: this.z + other.z,
        }
    }

    subtract(other: float32): Vector3 {
        Vector3 {
            x: this.x - other,
            y: this.y - other,
            z: this.z - other,
        }
    }

    subtract(other: Vector3): Vector3 {
        Vector3 {
            x: this.x - other.x,
            y: this.y - other.y,
            z: this.z - other.z,
        }
    }

    multiply(other: float32): Vector3 {
        Vector3 {
            x: this.x * other,
            y: this.y * other,
            z: this.z * other,
        }
    }

    multiply(other: Vector3): Vector3 {
        Vector3 {
            x: this.x * other.x,
            y: this.y * other.y,
            z: this.z * other.z,
        }
    }

    divide(other: float32): Vector3 {
        Vector3 {
            x: this.x / other,
            y: this.y / other,
            z: this.z / other,
        }
    }

    divide(other: Vector3): Vector3 {
        Vector3 {
            x: this.x / other.x,
            y: this.y / other.y,
            z: this.z / other.z,
        }
    }
}

/// A 4-dimensional vector with float32 components.
export struct Vector4 {
    x: float32
    y: float32
    z: float32
    w: float32

    /// The zero Vector4 (0, 0, 0, 0).
    static Zero: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The one Vector4 (1, 1, 1, 1).
    static One: Vector4 = Vector4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 }
    /// The unit x Vector4 (1, 0, 0, 0).
    static UnitX: Vector4 = Vector4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The unit y Vector4 (0, 1, 0, 0).
    static UnitY: Vector4 = Vector4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 }
    /// The unit z Vector4 (0, 0, 1, 0).
    static UnitZ: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 }
    /// The unit w Vector4 (0, 0, 0, 1).
    static UnitW: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    /// The negative unit x Vector4 (-1, 0, 0, 0).
    static NegUnitX: Vector4 = Vector4 { x: -1.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The negative unit y Vector4 (0, -1, 0, 0).
    static NegUnitY: Vector4 = Vector4 { x: 0.0, y: -1.0, z: 0.0, w: 0.0 }
    /// The negative unit z Vector4 (0, 0, -1, 0).
    static NegUnitZ: Vector4 = Vector4 { x: 0.0, y: 0.0, z: -1.0, w: 0.0 }
    /// The negative unit w Vector4 (0, 0, 0, -1).
    static NegUnitW: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: -1.0 }

    /// Construct a Vector4 with all components set to the same value.
    static splat(v: float32): Vector4 {
        Vector4 { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector4.
    length(): float32 {
        (this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w).sqrt()
    }

    /// Returns the squared length of the Vector4.
    lengthSquared(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector4): float32 {
        this.x * other.x + this.y * other.y + this.z * other.z + this.w * other.w
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    normalized(): Vector4 {
        let len = this.length()
        if len == 0.0 { this } else { this / len }
    }

    /// Compute Euclidean distance to another Vector4.
    distance(other: Vector4): float32 {
        (this - other).length()
    }

    /// Compute squared Euclidean distance to another Vector4.
    distanceSquared(other: Vector4): float32 {
        (this - other).lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    lerp(other: Vector4, t: float32): Vector4 {
        this + (other - this) * t
    }

    /// Component-wise absolute value.
    abs(): Vector4 {
        Vector4 {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
            w: this.w.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector4): Vector4 {
        Vector4 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
            w: if this.w < other.w { this.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    max(other: Vector4): Vector4 {
        Vector4 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
            w: if this.w > other.w { this.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector4, max: Vector4): Vector4 {
        Vector4 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
            w: clampScalar(this.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    withX(x: float32): Vector4 {
        Vector4 { x, y: this.y, z: this.z, w: this.w }
    }

    /// Create a copy with a different y component.
    withY(y: float32): Vector4 {
        Vector4 { x: this.x, y, z: this.z, w: this.w }
    }

    /// Create a copy with a different z component.
    withZ(z: float32): Vector4 {
        Vector4 { x: this.x, y: this.y, z, w: this.w }
    }

    /// Create a copy with a different w component.
    withW(w: float32): Vector4 {
        Vector4 { x: this.x, y: this.y, z: this.z, w }
    }
}

implement Vector4 implements (
    Add<float32>,
    Add<Vector4>,
    Subtract<float32>,
    Subtract<Vector4>,
    Multiply<float32>,
    Multiply<Vector4>,
    Divide<float32>
) {
    add(other: float32): Vector4 {
        Vector4 {
            x: this.x + other,
            y: this.y + other,
            z: this.z + other,
            w: this.w + other,
        }
    }

    add(other: Vector4): Vector4 {
        Vector4 {
            x: this.x + other.x,
            y: this.y + other.y,
            z: this.z + other.z,
            w: this.w + other.w,
        }
    }

    subtract(other: float32): Vector4 {
        Vector4 {
            x: this.x - other,
            y: this.y - other,
            z: this.z - other,
            w: this.w - other,
        }
    }

    subtract(other: Vector4): Vector4 {
        Vector4 {
            x: this.x - other.x,
            y: this.y - other.y,
            z: this.z - other.z,
            w: this.w - other.w,
        }
    }

    multiply(other: float32): Vector4 {
        Vector4 {
            x: this.x * other,
            y: this.y * other,
            z: this.z * other,
            w: this.w * other,
        }
    }

    multiply(other: Vector4): Vector4 {
        Vector4 {
            x: this.x * other.x,
            y: this.y * other.y,
            z: this.z * other.z,
            w: this.w * other.w,
        }
    }

    divide(other: float32): Vector4 {
        Vector4 {
            x: this.x / other,
            y: this.y / other,
            z: this.z / other,
            w: this.w / other,
        }
    }

    // Note: Divide<Vector4> should be implemented for completeness, but
    // omitted here since the surrounding code does not provide it. Add if needed.
}

/// A 2-dimensional vector with int32 components.
export struct Vector2i {
    x: int32
    y: int32

    /// The zero Vector2i (0, 0).
    static Zero: Vector2i = Vector2i { x: 0, y: 0 }
    /// The one Vector2i (1, 1).
    static One: Vector2i = Vector2i { x: 1, y: 1 }
    /// The unit x Vector2i (1, 0).
    static UnitX: Vector2i = Vector2i { x: 1, y: 0 }
    /// The unit y Vector2i (0, 1).
    static UnitY: Vector2i = Vector2i { x: 0, y: 1 }
    /// The negative unit x Vector2i (-1, 0).
    static NegUnitX: Vector2i = Vector2i { x: -1, y: 0 }
    /// The negative unit y Vector2i (0, -1).
    static NegUnitY: Vector2i = Vector2i { x: 0, y: -1 }

    /// Construct a Vector2i with all components set to the same value.
    static splat(v: int32): Vector2i {
        Vector2i { x: v, y: v }
    }

    /// Returns the length of the Vector as float32.
    length(): float32 {
        let fx = this.x as float32
        let fy = this.y as float32
        (fx * fx + fy * fy).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    lengthSquared(): int32 {
        this.x * this.x + this.y * this.y
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector2i): int32 {
        this.x * other.x + this.y * other.y
    }

    /// Compute Euclidean distance to another Vector2i as float32.
    distance(other: Vector2i): float32 {
        (this - other).length()
    }

    /// Compute squared Euclidean distance to another Vector2i as int32.
    distanceSquared(other: Vector2i): int32 {
        (this - other).lengthSquared()
    }

    /// Component-wise absolute value.
    abs(): Vector2i {
        Vector2i {
            x: this.x.abs(),
            y: this.y.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector2i): Vector2i {
        Vector2i {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    max(other: Vector2i): Vector2i {
        Vector2i {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector2i, max: Vector2i): Vector2i {
        Vector2i {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    withX(x: int32): Vector2i {
        Vector2i { x, y: this.y }
    }

    /// Create a copy with a different y component.
    withY(y: int32): Vector2i {
        Vector2i { x: this.x, y: y }
    }
}

implement Vector2i implements (
    Add<int32>,
    Add<Vector2i>,
    Subtract<int32>,
    Subtract<Vector2i>,
    Multiply<int32>,
    Multiply<Vector2i>,
    Divide<int32>
) {
    add(other: int32): Vector2i {
        Vector2i {
            x: this.x + other,
            y: this.y + other,
        }
    }

    add(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x + other.x,
            y: this.y + other.y,
        }
    }

    subtract(other: int32): Vector2i {
        Vector2i {
            x: this.x - other,
            y: this.y - other,
        }
    }

    subtract(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x - other.x,
            y: this.y - other.y,
        }
    }

    multiply(other: int32): Vector2i {
        Vector2i {
            x: this.x * other,
            y: this.y * other,
        }
    }

    multiply(other: Vector2i): Vector2i {
        Vector2i {
            x: this.x * other.x,
            y: this.y * other.y,
        }
    }

    divide(other: int32): Vector2i {
        Vector2i {
            x: this.x / other,
            y: this.y / other,
        }
    }
}

/// A 3-dimensional vector with int32 components.
export struct Vector3i {
    x: int32
    y: int32
    z: int32

    /// The zero Vector3i (0, 0, 0).
    static Zero: Vector3i = Vector3i { x: 0, y: 0, z: 0 }
    /// The one Vector3i (1, 1, 1).
    static One: Vector3i = Vector3i { x: 1, y: 1, z: 1 }
    /// The unit x Vector3i (1, 0, 0).
    static UnitX: Vector3i = Vector3i { x: 1, y: 0, z: 0 }
    /// The unit y Vector3i (0, 1, 0).
    static UnitY: Vector3i = Vector3i { x: 0, y: 1, z: 0 }
    /// The unit z Vector3i (0, 0, 1).
    static UnitZ: Vector3i = Vector3i { x: 0, y: 0, z: 1 }
    /// The negative unit x Vector3i (-1, 0, 0).
    static NegUnitX: Vector3i = Vector3i { x: -1, y: 0, z: 0 }
    /// The negative unit y Vector3i (0, -1, 0).
    static NegUnitY: Vector3i = Vector3i { x: 0, y: -1, z: 0 }
    /// The negative unit z Vector3i (0, 0, -1).
    static NegUnitZ: Vector3i = Vector3i { x: 0, y: 0, z: -1 }

    /// Construct a Vector3i with all components set to the same value.
    static splat(v: int32): Vector3i {
        Vector3i { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector as float32.
    length(): float32 {
        let fx = this.x as float32
        let fy = this.y as float32
        let fz = this.z as float32
        (fx * fx + fy * fy + fz * fz).sqrt()
    }

    /// Returns the squared length of the Vector as int32.
    lengthSquared(): int32 {
        this.x * this.x + this.y * this.y + this.z * this.z
    }

    /// Returns the dot product of the two Vectors.
    dot(other: Vector3i): int32 {
        this.x * other.x + this.y * other.y + this.z * other.z
    }

    /// Compute Euclidean distance to another Vector3i as float32.
    distance(other: Vector3i): float32 {
        (this - other).length()
    }

    /// Compute squared Euclidean distance to another Vector3i as int32.
    distanceSquared(other: Vector3i): int32 {
        (this - other).lengthSquared()
    }

    /// Component-wise absolute value.
    abs(): Vector3i {
        Vector3i {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
        }
    }

    /// Component-wise minimum.
    min(other: Vector3i): Vector3i {
        Vector3i {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    max(other: Vector3i): Vector3i {
        Vector3i {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    clamp(min: Vector3i, max: Vector3i): Vector3i {
        Vector3i {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    withX(x: int32): Vector3i {
        Vector3i { x, y: this.y, z: this.z }
    }

    /// Create a copy with a different y component.
    withY(y: int32): Vector3i {
        Vector3i { x: this.x, y, z: this.z }
    }

    /// Create a copy with a different z component.
    withZ(z: int32): Vector3i {
        Vector3i { x: this.x, y: this.y, z }
    }
}

