import * as ds from "destack"

/// A 2-dimensional vector with float32 components.
export struct Vector2 {
    x: float32
    y: float32
}

export async function clampScalar(v: float32, lo: float32, hi: float32): float32 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

extension Vector2 {
    /// The zero Vector2 (0, 0).
    const Zero = Vector2 { x: 0.0, y: 0.0 }
    /// The one Vector2 (1, 1).
    const One = Vector2 { x: 1.0, y: 1.0 }
    /// The unit x Vector2 (1, 0).
    const UnitX = Vector2 { x: 1.0, y: 0.0 }
    /// The unit y Vector2 (0, 1).
    const UnitY = Vector2 { x: 0.0, y: 1.0 }
    /// The negative unit x Vector2 (-1, 0).
    const NegUnitX = Vector2 { x: -1.0, y: 0.0 }
    /// The negative unit y Vector2 (0, -1).
    const NegUnitY = Vector2 { x: 0.0, y: -1.0 }

    /// Construct struct a Vector2 with both components set to the same value.
    function splat(v: float32): Vector2 {
        Vector2 { x: v, y: v }
    }

    /// Returns the length of the Vector.
    function length(): float32 {
        this.x * this.x + this.y * this.y.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(): float32 {
        this.x * this.x + this.y * this.y
    }

    /// Returns the dot product of the two Vectors.
    function dot(other: Vector2): float32 {
        this.x * other.x + this.y * other.y
    }

    /// Returns the cross product of the two Vectors.
    function cross(other: Vector2): float32 {
        this.x * other.y - this.y * other.x
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(): Vector2 {
        const len = this.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector2.
    function distance(other: Vector2): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector2.
    function distanceSquared(other: Vector2): float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(other: Vector2, t: float32): Vector2 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    function abs(): Vector2 {
        Vector2 {
            x: this.x.abs(),
            y: this.y.abs(),
        }
    }

    /// Component-wise minimum.
    function min(other: Vector2): Vector2 {
        Vector2 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
        }
    }

    /// Component-wise maximum.
    function max(other: Vector2): Vector2 {
        Vector2 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(min: Vector2, max: Vector2): Vector2 {
        Vector2 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
        }
    }

    /// Create a copy with a different x component.
    function withX(x: float32): Vector2 {
        Vector2 { x, y: this.y }
    }

    /// Create a copy with a different y component.
    function withY(y: float32): Vector2 {
        Vector2 { x: this.x, y }
    }

    /// Rotate 90 degrees counter-clockwise (perpendicular vector).
    function perp(): Vector2 {
        Vector2 {
            x: -this.y,
            y: this.x,
        }
    }
}

extension Vector2 implements Numeric<float32> {
    function add(other: float32): Vector2 {
        Vector2 {
            x: this.x + other,
            y: this.y + other,
        }
    }

    function subtract(other: float32): Vector2 {
        Vector2 {
            x: this.x - other,
            y: this.y - other,
        }
    }

    function multiply(other: float32): Vector2 {
        Vector2 {
            x: this.x * other,
            y: this.y * other,
        }
    }

    function divide(other: float32): Vector2 {
        Vector2 {
            x: this.x / other,
            y: this.y / other,
        }
    }
}

extension Vector2 implements Numeric<Vector2> {
    function add(other: Vector2): Vector2 {
        Vector2 {
            x: this.x + other.x,
            y: this.y + other.y,
        }
    }

    function subtract(other: Vector2): Vector2 {
        Vector2 {
            x: this.x - other.x,
            y: this.y - other.y,
        }
    }

    function multiply(other: Vector2): Vector2 {
        Vector2 {
            x: this.x * other.x,
            y: this.y * other.y,
        }
    }

    function divide(other: Vector2): Vector2 {
        Vector2 {
            x: this.x / other.x,
            y: this.y / other.y,
        }
    }
}

/// A 3-dimensional vector with float32 components.
export struct Vector3 {
    x: float32
    y: float32
    z: float32
}

extension Vector3 {
    /// The zero Vector3 (0, 0, 0).
    const Zero = Vector3 { x: 0.0, y: 0.0, z: 0.0 }
    /// The one Vector3 (1, 1, 1).
    const One = Vector3 { x: 1.0, y: 1.0, z: 1.0 }
    /// The unit x Vector3 (1, 0, 0).
    const UnitX = Vector3 { x: 1.0, y: 0.0, z: 0.0 }
    /// The unit y Vector3 (0, 1, 0).
    const UnitY = Vector3 { x: 0.0, y: 1.0, z: 0.0 }
    /// The unit z Vector3 (0, 0, 1).
    const UnitZ = Vector3 { x: 0.0, y: 0.0, z: 1.0 }
    /// The negative unit x Vector3 (-1, 0, 0).
    const NegUnitX = Vector3 { x: -1.0, y: 0.0, z: 0.0 }
    /// The negative unit y Vector3 (0, -1, 0).
    const NegUnitY = Vector3 { x: 0.0, y: -1.0, z: 0.0 }
    /// The negative unit z Vector3 (0, 0, -1).
    const NegUnitZ = Vector3 { x: 0.0, y: 0.0, z: -1.0 }

    /// Construct struct a Vector3 with all components set to the same value.
    function splat(v: float32): Vector3 {
        Vector3 { x: v, y: v, z: v }
    }

    /// Returns the length of the Vector.
    function length(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z
    }

    /// Returns the dot product of the two Vectors.
    function dot(other: Vector3): float32 {
        this.x * other.x + this.y * other.y + this.z * other.z
    }

    /// Returns the cross product of the two Vectors.
    function cross(other: Vector3): Vector3 {
        Vector3 {
            x: this.y * other.z - this.z * other.y,
            y: this.z * other.x - this.x * other.z,
            z: this.x * other.y - this.y * other.x,
        }
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(): Vector3 {
        const len = this.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector3.
    function distance(other: Vector3): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector3.
    function distanceSquared(other: Vector3): float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(other: Vector3, t: float32): Vector3 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    function abs(): Vector3 {
        Vector3 {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
        }
    }

    /// Component-wise minimum.
    function min(other: Vector3): Vector3 {
        Vector3 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
        }
    }

    /// Component-wise maximum.
    function max(other: Vector3): Vector3 {
        Vector3 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(min: Vector3, max: Vector3): Vector3 {
        Vector3 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
        }
    }

    /// Create a copy with a different x component.
    function withX(x: float32): Vector3 {
        Vector3 { x, y: this.y, z: this.z }
    }

    /// Create a copy with a different y component.
    function withY(y: float32): Vector3 {
        Vector3 { x: this.x, y, z: this.z }
    }

    /// Create a copy with a different z component.
    function withZ(z: float32): Vector3 {
        Vector3 { x: this.x, y: this.y, z }
    }
}

extension Vector3 implements (
    Add<float32>,
    Subtract<float32>,
    Multiply<float32>,
    Divide<float32>,
    Add<Vector3>,
    Subtract<Vector3>,
    Multiply<Vector3>,
    Divide<Vector3>,
) {
    function add(other: float32): Vector3 {
        Vector3 {
            x: this.x + other,
            y: this.y + other,
            z: this.z + other,
        }
    }

    function add(other: Vector3): Vector3 {
        Vector3 {
            x: this.x + other.x,
            y: this.y + other.y,
            z: this.z + other.z,
        }
    }

    function subtract(other: float32): Vector3 {
        Vector3 {
            x: this.x - other,
            y: this.y - other,
            z: this.z - other,
        }
    }

    function subtract(other: Vector3): Vector3 {
        Vector3 {
            x: this.x - other.x,
            y: this.y - other.y,
            z: this.z - other.z,
        }
    }

    function multiply(other: float32): Vector3 {
        Vector3 {
            x: this.x * other,
            y: this.y * other,
            z: this.z * other,
        }
    }

    function multiply(other: Vector3): Vector3 {
        Vector3 {
            x: this.x * other.x,
            y: this.y * other.y,
            z: this.z * other.z,
        }
    }

    function divide(other: float32): Vector3 {
        Vector3 {
            x: this.x / other,
            y: this.y / other,
            z: this.z / other,
        }
    }
}

/// A 4-dimensional vector with float32 components.
export struct Vector4 {
    x: float32
    y: float32
    z: float32
    w: float32
}

extension Vector4 {
    /// The zero Vector4 (0, 0, 0, 0).
    const Zero = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The one Vector4 (1, 1, 1, 1).
    const One = Vector4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 }
    /// The unit x Vector4 (1, 0, 0, 0).
    const UnitX = Vector4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }
    /// The unit y Vector4 (0, 1, 0, 0).
    const UnitY = Vector4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 }
    /// The unit z Vector4 (0, 0, 1, 0).
    const UnitZ = Vector4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 }
    /// The unit w Vector4 (0, 0, 0, 1).
    const UnitW = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    /// The negative unit x Vector4 (-1, 0, 0, 0).
    const NegUnitX = Vector4 {
        x: -1.0,
        y: 0.0,
        z: 0.0,
        w: 0.0,
    }
    /// The negative unit y Vector4 (0, -1, 0, 0).
    const NegUnitY = Vector4 {
        x: 0.0,
        y: -1.0,
        z: 0.0,
        w: 0.0,
    }
    /// The negative unit z Vector4 (0, 0, -1, 0).
    const NegUnitZ = Vector4 {
        x: 0.0,
        y: 0.0,
        z: -1.0,
        w: 0.0,
    }
    /// The negative unit w Vector4 (0, 0, 0, -1).
    const NegUnitW = Vector4 {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        w: -1.0,
    }

    /// Construct struct a Vector4 with all components set to the same value.
    function splat(v: float32): Vector4 {
        Vector4 { x: v, y: v, z: v, w: v }
    }

    /// Returns the length of the Vector.
    function length(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w.sqrt()
    }

    /// Returns the squared length of the Vector.
    function lengthSquared(): float32 {
        this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w
    }

    /// Returns the dot product of the two Vectors.
    function dot(other: Vector4): float32 {
        this.x * other.x + this.y * other.y + this.z * other.z + this.w * other.w
    }

    /// Compute a normalized Vector with length 1.0. Returns self if length is 0.
    function normalized(): Vector4 {
        const len = this.length()
        if len == 0.0 { self } else { self / len }
    }

    /// Compute Euclidean distance to another Vector4.
    function distance(other: Vector4): float32 {
        self - other.length()
    }

    /// Compute squared Euclidean distance to another Vector4.
    function distanceSquared(other: Vector4): float32 {
        self - other.lengthSquared()
    }

    /// Linearly interpolate towards `other` by factor `t` in [0, 1].
    function lerp(other: Vector4, t: float32): Vector4 {
        self + other - self * t
    }

    /// Component-wise absolute value.
    function abs(): Vector4 {
        Vector4 {
            x: this.x.abs(),
            y: this.y.abs(),
            z: this.z.abs(),
            w: this.w.abs(),
        }
    }

    /// Component-wise minimum.
    function min(other: Vector4): Vector4 {
        Vector4 {
            x: if this.x < other.x { this.x } else { other.x },
            y: if this.y < other.y { this.y } else { other.y },
            z: if this.z < other.z { this.z } else { other.z },
            w: if this.w < other.w { this.w } else { other.w },
        }
    }

    /// Component-wise maximum.
    function max(other: Vector4): Vector4 {
        Vector4 {
            x: if this.x > other.x { this.x } else { other.x },
            y: if this.y > other.y { this.y } else { other.y },
            z: if this.z > other.z { this.z } else { other.z },
            w: if this.w > other.w { this.w } else { other.w },
        }
    }

    /// Clamp each component between corresponding min and max values.
    function clamp(min: Vector4, max: Vector4): Vector4 {
        Vector4 {
            x: clampScalar(this.x, min.x, max.x),
            y: clampScalar(this.y, min.y, max.y),
            z: clampScalar(this.z, min.z, max.z),
            w: clampScalar(this.w, min.w, max.w),
        }
    }

    /// Create a copy with a different x component.
    function withX(x: float32): Vector4 {
        Vector4 { x, y: this.y, z: this.z, w: this.w }
    }

    /// Create a copy with a different y component.
    function withY(y: float32): Vector4 {
        Vector4 { x: this.x, y, z: this.z, w: this.w }
    }

    /// Create a copy with a different z component.
    function withZ(z: float32): Vector4 {
        Vector4 { x: this.x, y: this.y, z, w: this.w }
    }

    /// Create a copy with a different w component.
    function withW(w: float32): Vector4 {
        Vector4 { x: this.x, y: this.y, z: this.z, w }
    }
}

extension Vector4 implements Add<float32> {
    function add(other: float32): Vector4 {
        Vector4 {
            x: this.x + other,
            y: this.y + other,
            z: this.z + other,
            w: this.w + other,
        }
    }
}

