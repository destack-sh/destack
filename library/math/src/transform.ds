import { Vector2, Vector3 } from "./vector.ds"
import { Quaternion } from "./quaternion.ds"

/// A 2D affine transform with position, scale, and rotation.
export struct Transform2D {
    position: Vector2 = Vector2.Zero
    scale: Vector2 = Vector2.One
    rotation: float32 = 0.0
}

/// A 3D affine transform with position, scale, and rotation.
export struct Transform3D {
    position: Vector3 = Vector3.Zero
    scale: Vector3 = Vector3.One
    rotation: Quaternion = Quaternion.Identity
}

