import * as ds from "destack"

/// A Form2D is a 2D geometric form.
export struct Form2D {
    position: Vector2
}

/// A Form3D is a 3D geometric form.
export struct Form3D {
    position: Vector3
}

/// A Shape2D is a 2D geometric shape.
@entity
export struct Shape2D {
    ...Entity2D
}

/// A Shape3D is a 3D geometric shape.
@entity
export struct Shape3D {
    ...Entity3D
}

