set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# run static checks
lint:
    bun x biome lint .

# run tests
test:
    @echo "No library tests defined"

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint
    just test

# check with slow suites
check-full:
    just check-quick

# format code
format:
    bun x biome format --write .

# check formatting
format-check:
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# alias for format
alias fmt := format

# clean build artifacts
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && npm publish {{dry}} --access public
