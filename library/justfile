set shell := ["bash", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# --- ci ---

# install js dependencies required by library gates
ci-install:
    bun install --frozen-lockfile

# run library format gate
ci-format:
    just format-check

# run library lint gate
ci-lint:
    just lint

# run library test gate
ci-tests:
    just test-ci

# run all blocking library ci gates locally
ci:
    just ci-install
    just ci-format
    just ci-lint
    just ci-tests

# check
check:
    bun run biome lint .

# lint (alias for check)
lint:
    just check

# run quick tests for local development
test-quick:
    @echo "No library tests defined"

# run blocking ci test gates
test-ci:
    just test-quick

# run nightly test gates
test-nightly:
    just test-ci

# run release test gates
test-release:
    just test-ci

# run quick tests (alias for test-quick)
test:
    just test-quick

# format code
format:
    bun run biome format --write .

# check formatting
format-check:
    bun run biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# alias for format
alias fmt := format

# clean
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && bun publish {{dry}} --access public

# publish library packages as dry run
publish-dry:
    just publish --dry-run

# publish library packages live
publish-live:
    just publish ""
