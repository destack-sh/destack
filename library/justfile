set shell := ["bash", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# check
check:
    bun run biome lint .

# run library tests
test:
    @echo "No library tests defined"

# run the fast library gate
quick:
    just format-check
    just check
    just test

# run the full library gate
full:
    just quick

# format code
format:
    bun run biome format --write .

# check formatting
format-check:
    bun run biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# alias for format
alias fmt := format

# clean
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && npm publish {{dry}} --access public
