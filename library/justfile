set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# lint
lint:
    deno run -A npm:@biomejs/biome lint .

# test
test:
    just build/test

# check
check:
    just check-quick

# check quick
check-quick:
    just schema/check
    just resource/check
    just vault/check
    just storage/check
    just package/check
    just space/check
    just build/check
    just db/check
    just model/check
    just service/check
    just telemetry/check
    just signals/check
    just view/check
    just style/check
    just theme/check

# check full
check-full:
    just check-quick

# format
format:
    deno run -A npm:@biomejs/biome format --write .

# check formatting
format-check:
    deno run -A npm:@biomejs/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# format
alias fmt := format

# clean
clean:
    rm -rf node_modules

# --- release ---

# publish
publish dry="--dry-run":
    cd schema && npm publish {{dry}} --access public
