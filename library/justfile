set shell := ["bash", "-cu"]

packages := "-p destack_napi -p destack_wasm"

_default:
    @just --list --unsorted

# build napi bindings
napi:
    cargo build --release -p destack_napi
    cd napi && bun run build

# build wasm bindings
wasm:
    RUSTFLAGS='-C target-feature=+tail-call' cargo build --release -p destack_wasm --target wasm32-wasip2

# canonical wasm size analysis command
wasm-size:
    cd wasm && bun ./scripts/size-report.mjs --build --preset core --top 20 --retained-top 20 --crate-top 12 --mono-top 8 --symbols

# canonical wasm size analysis command without rebuilding
wasm-size-no-build:
    cd wasm && bun ./scripts/size-report.mjs --no-build --preset core --top 20 --retained-top 20 --crate-top 12 --mono-top 8 --symbols

# analyze one preset with canonical size report settings
wasm-size-preset preset="core":
    cd wasm && bun ./scripts/size-report.mjs --build --preset {{preset}} --top 20 --retained-top 20 --crate-top 12 --mono-top 8 --symbols

# check
check:
    cargo clippy --release -p destack_napi
    cargo check --release -p destack_wasm --target wasm32-wasip2
    bun x tsc --noEmit -p napi/tsconfig.json
    bun run biome lint .

# lint (alias for check)
lint:
    just check

# test
test:
    cargo test --release --all-targets -p destack_napi
    cargo test --release --all-targets -p destack_wasm
    cd napi && bun run build
    bun test

# format code
format:
    cargo fmt {{ packages }}
    bun run biome format --write .

# check formatting
format-check:
    cargo fmt --check {{ packages }}
    bun run biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# alias for format
alias fmt := format

# clean
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && bun publish {{dry}} --access public
