set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# run library static checks
check:
    bun x biome lint .

# run the library test aggregate
test:
    @echo "No library tests defined"

# run the library quick gate
quick:
    just format-check
    just check
    just test

# run the library full gate
full:
    just quick

# format code
format:
    bun x biome format --write .

# check formatting
format-check:
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .

# alias for format
alias fmt := format

# clean library build artifacts
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && npm publish {{dry}} --access public
