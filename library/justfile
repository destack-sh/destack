set shell := ["bash", "-cu"]

_default:
    @just --list --unsorted

# build napi bindings
napi:
    cargo build --release -p destack_napi
    cd napi && bun run build

# check
check:
    cargo clippy --release -p destack_napi
    bun x tsc --noEmit -p napi/tsconfig.json
    bun run biome lint .

# test
test:
    cargo test --release --all-targets -p destack_napi
    bun test

# format code
format:
    bun run biome format --write .

# alias for format
fmt := "format"

# clean
clean:
    rm -rf node_modules

# --- release ---

# publish npm packages (dry-run by default)
publish dry="--dry-run":
    cd schema && bun publish {{dry}} --access public
