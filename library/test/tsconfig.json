{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noImplicitAny": true,
        "esModuleInterop": true
    },
    "include": ["**/*"]
}
