using dyst

/// A Client to connect with the system.
@entity
struct Client {
    /// The client type.
    type: ClientType,
    /// The access token, if any.
    accessToken: ?String,
    /// When the client was last seen.
    seenAt: ?Timestamp,
    /// When the client last logged in.
    loggedInAt: ?Timestamp,
    /// The device type.
    deviceType: ?String,
    /// The device name.
    deviceName: ?String,
    /// The operating system name.
    operatingSystem: ?String,
    /// The browser name.
    browserName: ?String,
    /// The browser version.
    browserVersion: ?String,
}


