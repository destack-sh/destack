import destack

/// The result of creating a new Space.
export struct CreateSpaceResult {
    /// The created Space.
    space: Space
    /// The meta Branch.
    metaBranch: Branch
    /// The meta Snapshot.
    metaSnapshot: Snapshot
    /// The root Branch.
    rootBranch: Branch
    /// The head Snapshot.
    headSnapshot: Snapshot
}

/// A Space is the root of an isolated workspace in the Destack computational universe.
@entity
export struct Space {
    /// The URL-friendly slug of the Space.
    slug: string
    /// The hosting region for the Space.
    region: Region
}

