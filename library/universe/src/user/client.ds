import * as ds from "destack"

/// A Client to connect with the system.
@entity
export struct Client {
    /// The client type.
    type: ClientType
    /// The access token, if any.
    accessToken: string?
    /// When the client was last seen.
    seenAt: Timestamp?
    /// When the client last logged in.
    loggedInAt: Timestamp?
    /// The device type.
    deviceType: string?
    /// The device name.
    deviceName: string?
    /// The operating system name.
    operatingSystem: string?
    /// The browser name.
    browserName: string?
    /// The browser version.
    browserVersion: string?
}

