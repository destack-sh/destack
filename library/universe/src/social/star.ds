import * as ds from "destack"

/// A Star is a relationship between an Actor and a starred Node.
@entity
export struct Star { }

/// Base Star event.
@event
export struct StarEvent {
    /// The Star self event pertains to.
    star: Reference<Star>
}

/// Star added.
@event
export struct StarAddedEvent extends StarEvent { }

/// Star removed.
@event
export struct StarRemovedEvent extends StarEvent { }

