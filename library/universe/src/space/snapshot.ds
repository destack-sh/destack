import * as ds from "destack"

/// The type of a Snapshot.
export enum SnapshotType {
    Full = 10
    Root = 11
}

/// The status of a Snapshot.
export enum SnapshotStatus {
    Creating = 1
    Active = 10
    Passive = 50
}

/// A Snapshot is a point in Space-time.
@entity
export struct Snapshot {
    /// The Snapshot type.
    type: SnapshotType
    /// The Snapshot status.
    status: SnapshotStatus = SnapshotStatus.Active
}

