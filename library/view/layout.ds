import destack

/// Layout properties for a 2D view.
export struct LayoutComponent2D {
    /// How to layout the children of self View.
    layout: Layout?
    /// The direction in which the children of self View are laid out.
    direction: Direction?
    /// How to distribute the children of self View.
    distribute: Distribute?
    /// How to align the children of self View.
    align: Align?
    /// The gap between the children of self View.
    gap: Axis2?
    /// The padding around the children of self View.
    padding: Inset2?
    /// The grid in which the children of self View are laid out.
    grid: Grid2?
    /// The span of self View in the grid.
    gridSpan: GridSpan2?
    /// The aspect ratio of self View.
    aspectRatio: float32?
    /// Whether the children of self View are wrapped in the grid.
    isWrap: boolean?
}

/// A 2D layout View defines how its children are laid out.
@entity
export struct LayoutView2D: View2D {
    ..LayoutComponent2D
}