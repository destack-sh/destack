using destack

/// A 2D content View
@entity
struct ContentView2D using View2D {}

/// A 2D Text View
@entity
struct TextView2D using ContentView2D {
    /// The text to display
    text: Optional<Text>,
    /// The font to using for the text
    font: Optional<Font>,
    /// The color of the text
    color: Optional<Fill>,
}


