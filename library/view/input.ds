import destack

/// Base input View
@entity
export struct InputView2D: View2D { }

/// A 2D number input View
@entity
export struct NumberInputView2D: InputView2D {
    /// The numeric value
    value: float64?
    /// Placeholder text shown when empty
    placeholder: string?
}

/// A 2D slider input View
@entity
export struct SliderInputView2D: InputView2D {
    /// The current slider value
    value: float64?
}

