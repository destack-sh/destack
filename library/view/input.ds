use dyst

/// Base input View
@entity
struct InputView2D use View2D {}

/// A 2D number input View
@entity
struct NumberInputView2D use InputView2D {
    /// The numeric value
    value: ?float64,
    /// Placeholder text shown when empty
    placeholder: ?String,
}

/// A 2D slider input View
@entity
struct SliderInputView2D use InputView2D {
    /// The current slider value
    value: ?float64,
}


