        "./manifest": "./src/manifest/index.ts",
        "./code": "./src/code/index.ts",
        "./source": "./src/source/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./file": "./src/file/index.ts",
        "./import-meta": { "types": "./src/package/import-meta.d.ts" }
    },
    "scripts": {
        "check": "deno check src/index.ts src/code/index.ts src/source/index.ts src/inspect/index.ts src/file/index.ts src/package/import-meta.d.ts"
    },
    "dependencies": { "@destack/schema": "workspace:*" }
}
