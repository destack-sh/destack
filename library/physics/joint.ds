use dyst

/// Flags that modify Joint behavior
enum JointFlag {
    /// Default behavior
    Default = 0,
    /// Allow connected bodies to collide with each other
    CollideConnected = 1,
}

/// Spring parameters for soft constraints
struct JointSpring {
    /// Hooke stiffness of the spring (N/m or N·m/rad)
    stiffness: float32,
    /// Damping coefficient of the spring (N·s/m or N·m·s/rad)
    damping: float32,
}

/// Motor/servo constraint for a Joint DoF
struct JointMotor {
    /// Target velocity along the motorized DoF (m/s or rad/s)
    targetVelocity: float32,
    /// Maximum impulse the motor may apply in a single step (N·s or N·m·s)
    maxImpulse: float32,
    /// Optional target coordinate for servo mode (meters or radians)
    targetPosition: ?float32 = None,
    /// Optional servo stiffness for position tracking
    stiffness: ?float32 = None,
    /// Optional servo damping for position tracking
    damping: ?float32 = None,
}

/// Scalar (1D) limit for linear or angular coordinates
struct JointScalarLimit {
    /// Lower bound of the coordinate (meters or radians)
    minValue: float32,
    /// Upper bound of the coordinate (meters or radians)
    maxValue: float32,
    /// Bounciness applied when the limit is hit (0..1)
    restitution: float32,
    /// Early activation margin before the limit (meters or radians)
    contactDistance: float32,
}

/// Angular 1D twist limit around a defined axis
struct JointTwistLimit {
    /// Lower angular bound around the twist axis (radians)
    minAngle: float32,
    /// Upper angular bound around the twist axis (radians)
    maxAngle: float32,
    /// Bounciness applied when the twist limit is hit (0..1)
    restitution: float32,
    /// Early activation margin before the twist limit (radians)
    contactDistance: float32,
}

/// Elliptical swing (cone) limit for a ball-and-socket style joint
struct JointConeLimit {
    /// Maximum swing angle about the local Y axis (radians)
    swingY: float32,
    /// Maximum swing angle about the local Z axis (radians)
    swingZ: float32,
    /// Bounciness applied when the cone boundary is reached (0..1)
    restitution: float32,
    /// Early activation margin before the cone boundary (radians)
    contactDistance: float32,
}

/// Break thresholds for a Joint
struct JointBreakLimit {
    /// Maximum linear force the Joint can sustain before breaking (N)
    force: float32,
    /// Maximum angular torque the Joint can sustain before breaking (N·m)
    torque: float32,
}

/// Base Joint in 2D space
@entity
struct Joint2D use Entity2D {
    /// First body connected by the Joint
    bodyA: EntityReference<Body2D>,
    /// Second body connected by the Joint
    bodyB: EntityReference<Body2D>,
    /// Joint frame on Body A (local anchor position and orientation)
    frameA: JointFrame2D,
    /// Joint frame on Body B (local anchor position and orientation)
    frameB: JointFrame2D,
    /// Optional break thresholds for the Joint
    breakLimit: ?JointBreakLimit = None,
    /// Joint behavior flags
    flags: JointFlag = JointFlag.Default,
}

/// Frame for a Joint in 2D space (relative to a Body)
struct JointFrame2D {
    /// Local anchor position in Body space (meters)
    position: Vector2,
    /// Local orientation in Body space (radians)
    rotation: float32,
}

/// Revolute (hinge) joint in 2D
@entity
struct HingeJoint2D use Joint2D {
    /// Optional angular limit around the hinge axis (radians)
    limit: ?JointScalarLimit = None,
    /// Optional angular motor around the hinge axis (rad/s)
    motor: ?JointMotor = None,
    /// Optional soft constraint on hinge angle (spring-damper)
    angularSpring: ?JointSpring = None,
}

/// Prismatic (slider) joint in 2D
@entity
struct PrismaticJoint2D use Joint2D {
    /// Slide axis expressed in Body A local space (unit vector)
    axisA: Vector2,
    /// Optional linear limit along the slide axis (meters)
    limit: ?JointScalarLimit = None,
    /// Optional linear motor along the slide axis (m/s)
    motor: ?JointMotor = None,
    /// Optional linear spring along the slide axis (suspension)
    spring: ?JointSpring = None,
}

/// Fixed joint in 2D
@entity
struct FixedJoint2D use Joint2D {
    /// Optional softening for locked translation (spring-damper)
    linearSpring: ?JointSpring = None,
    /// Optional softening for locked rotation (spring-damper)
    angularSpring: ?JointSpring = None,
}

/// Rope/Distance joint in 2D
@entity
struct RopeJoint2D use Joint2D {
    /// Distance range between anchors (meters)
    distanceLimit: JointScalarLimit,
    /// Optional spring to model a compliant rope/rod
    spring: ?JointSpring = None,
}

/// Wheel joint in 2D
@entity
struct WheelJoint2D use Joint2D {
    /// Suspension (slide) axis in Body A local space (unit vector)
    suspensionAxisA: Vector2,
    /// Suspension spring-damper along the suspension axis
    suspension: JointSpring,
    /// Optional travel limit along the suspension axis (meters)
    linearLimit: ?JointScalarLimit = None,
    /// Optional angular motor for wheel spin about Z (rad/s)
    wheelMotor: ?JointMotor = None,
}

/// Base Joint in 3D space
@entity
struct Joint3D use Entity3D {
    /// First body connected by the Joint
    bodyA: EntityReference<Body3D>,
    /// Second body connected by the Joint
    bodyB: EntityReference<Body3D>,
    /// Joint frame on Body A (local anchor position and orientation)
    frameA: JointFrame3D,
    /// Joint frame on Body B (local anchor position and orientation)
    frameB: JointFrame3D,
    /// Optional break thresholds for the Joint
    breakLimit: ?JointBreakLimit = None,
    /// Joint behavior flags
    flags: JointFlag = JointFlag.Default,
}

/// Frame for a Joint in 3D space (relative to a Body)
struct JointFrame3D {
    /// Local anchor position in Body space (meters)
    position: Vector3,
    /// Local orientation in Body space (unit quaternion)
    rotation: Quaternion,
}

/// Spherical (ball-and-socket) joint in 3D
@entity
struct SphericalJoint3D use Joint3D {
    /// Swing (cone) limit around local Y/Z axes (radians)
    coneLimit: ?JointConeLimit = None,
    /// Twist limit around the local X axis (radians)
    twistLimit: ?JointTwistLimit = None,
    /// Soft constraint on relative orientation (spring-damper)
    angularSpring: ?JointSpring = None,
}

/// Hinge joint in 3D
@entity
struct HingeJoint3D use Joint3D {
    /// Hinge axis expressed in Body A local space (unit vector)
    axisA: Vector3,
    /// Optional angular limit around the hinge axis (radians)
    limit: ?JointTwistLimit = None,
    /// Optional angular motor around the hinge axis (rad/s)
    motor: ?JointMotor = None,
    /// Optional soft constraint on hinge angle (spring-damper)
    angularSpring: ?JointSpring = None,
}

/// Prismatic (slider) joint in 3D
@entity
struct PrismaticJoint3D use Joint3D {
    /// Slide axis expressed in Body A local space (unit vector)
    axisA: Vector3,
    /// Optional linear limit along the slide axis (meters)
    limit: ?JointScalarLimit = None,
    /// Optional linear motor along the slide axis (m/s)
    motor: ?JointMotor = None,
    /// Optional linear spring along the slide axis (suspension)
    spring: ?JointSpring = None,
}

/// Fixed joint in 3D
@entity
struct FixedJoint3D use Joint3D {
    /// Optional softening for locked translation (spring-damper)
    linearSpring: ?JointSpring = None,
    /// Optional softening for locked rotation (spring-damper)
    angularSpring: ?JointSpring = None,
}

/// Rope/Distance joint in 3D
@entity
struct RopeJoint3D use Joint3D {
    /// Distance range between anchors (meters)
    distanceLimit: JointScalarLimit,
    /// Optional spring to model a compliant rope/rod
    spring: ?JointSpring = None,
}

/// Wheel (suspension) joint in 3D
@entity
struct WheelJoint3D use Joint3D {
    /// Suspension (slide) axis in Body A local space (unit vector)
    suspensionAxisA: Vector3,
    /// Suspension spring-damper along the suspension axis
    suspension: JointSpring,
    /// Optional travel limit along the suspension axis (meters)
    linearLimit: ?JointScalarLimit = None,
    /// Optional angular motor for wheel spin about the hinge axis (rad/s)
    wheelMotor: ?JointMotor = None,
}


