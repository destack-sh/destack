import { Capsule2D, Capsule3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A CapsuleShape2D is a collision shape representing a capsule (stadium).
@entity
export struct CapsuleShape2D extends Shape2D {
    ...Capsule2D
}

/// A CapsuleShape3D is a collision shape representing a 3D capsule.
@entity
export struct CapsuleShape3D extends Shape3D {
    ...Capsule3D
}
