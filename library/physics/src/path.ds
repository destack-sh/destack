import * as ds from "destack"

/// A Path is a polyline of multiple points.
export struct Path2D {
    points: List<Vector2>
    isClosed: boolean

    ...Form2D
}

/// A PathShape is a shape that represents a polyline of multiple points.
@entity
export struct PathShape2D extends Shape2D {
    ...Path2D
}

/// A Polyline3D is a polygonal chain in 3D space.
export struct Polyline3D {
    points: List<Vector3>
    isClosed: boolean

    ...Form3D
}

/// A PolylineShape3D represents a polygonal chain in 3D space.
@entity
export struct PolylineShape3D extends Shape3D {
    ...Polyline3D
}