import { Path2D, Polyline3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A PathShape2D is a collision shape representing a polyline in 2D.
@entity
export struct PathShape2D extends Shape2D {
    ...Path2D
}

/// A PolylineShape3D is a collision shape representing a polyline in 3D.
@entity
export struct PolylineShape3D extends Shape3D {
    ...Polyline3D
}
