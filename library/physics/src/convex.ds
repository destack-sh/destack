import { ConvexPolygon2D, ConvexHull3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A ConvexShape2D is a collision shape representing a convex polygon.
@entity
export struct ConvexShape2D extends Shape2D {
    ...ConvexPolygon2D
}

/// A ConvexShape3D is a collision shape representing a convex hull.
@entity
export struct ConvexShape3D extends Shape3D {
    ...ConvexHull3D
}
