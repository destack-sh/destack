import { Vector2, Vector3 } from "@destack/math"
import { Entity2D, Entity3D } from "./entity.ds"

/// A Form2D is a base for 2D geometric forms with position.
export struct Form2D {
    position: Vector2 = Vector2.Zero
}

/// A Form3D is a base for 3D geometric forms with position.
export struct Form3D {
    position: Vector3 = Vector3.Zero
}

/// A Shape2D is a 2D geometric shape entity.
@entity
export struct Shape2D extends Entity2D { }

/// A Shape3D is a 3D geometric shape entity.
@entity
export struct Shape3D extends Entity3D { }
