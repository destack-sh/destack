import { Mesh2D, Mesh3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A MeshShape2D is a collision shape representing a triangle mesh in 2D.
@entity
export struct MeshShape2D extends Shape2D {
    ...Mesh2D
}

/// A MeshShape3D is a collision shape representing a triangle mesh in 3D.
@entity
export struct MeshShape3D extends Shape3D {
    ...Mesh3D
}
