import * as ds from "destack"

/// A Mesh2D is defined by vertices and triangle indices.
export struct Mesh2D {
    vertices: Vector2[]
    triangles: uint32[]
}

/// A Mesh3D is defined by vertices and triangle indices.
export struct Mesh3D {
    vertices: Vector3[]
    triangles: uint32[]
}

/// A MeshShape2D represents a triangle mesh.
@entity
export struct MeshShape2D extends Shape2D {
    ...Mesh2D
}

/// A MeshShape3D represents a triangle mesh.
@entity
export struct MeshShape3D extends Shape3D {
    ...Mesh3D
}