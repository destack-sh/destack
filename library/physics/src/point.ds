import { Point2D, Point3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A PointShape2D represents a zero-area shape in 2D.
@entity
export struct PointShape2D extends Shape2D {
    ...Point2D
}

/// A PointShape3D represents a zero-volume shape in 3D.
@entity
export struct PointShape3D extends Shape3D {
    ...Point3D
}
