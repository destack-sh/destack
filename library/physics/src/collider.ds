import { Entity2D, Entity3D } from "./entity.ds"

/// Base collider event.
@event
export struct ColliderEvent { }

/// Collision contact between two 2D colliders.
@event
export struct ColliderContactEvent2D extends ColliderEvent {
    colliderA: Reference<Collider2D>
    colliderB: Reference<Collider2D>
}

/// Collision contact between two 3D colliders.
@event
export struct ColliderContactEvent3D extends ColliderEvent {
    colliderA: Reference<Collider3D>
    colliderB: Reference<Collider3D>
}

/// A Collider in 2D space.
@entity
export struct Collider2D extends Entity2D { }

/// A Collider in 3D space.
@entity
export struct Collider3D extends Entity3D { }
