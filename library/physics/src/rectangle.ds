import { Rectangle2D, Box3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A RectangleShape2D is a collision shape representing a rectangle.
@entity
export struct RectangleShape2D extends Shape2D {
    ...Rectangle2D
}

/// A BoxShape3D is a collision shape representing an axis-aligned box.
@entity
export struct BoxShape3D extends Shape3D {
    ...Box3D
}
