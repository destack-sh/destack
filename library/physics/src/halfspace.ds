import { Halfspace2D, Plane3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A HalfspaceShape2D is a collision shape representing a half-space in 2D.
@entity
export struct HalfspaceShape2D extends Shape2D {
    ...Halfspace2D
}

/// A PlaneShape3D is a collision shape representing a half-space in 3D.
@entity
export struct PlaneShape3D extends Shape3D {
    ...Plane3D
}
