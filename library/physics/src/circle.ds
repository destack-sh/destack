import { Circle2D, Sphere3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A CircleShape2D is a collision shape representing a circle.
@entity
export struct CircleShape2D extends Shape2D {
    ...Circle2D
}

/// A SphereShape3D is a collision shape representing a sphere.
@entity
export struct SphereShape3D extends Shape3D {
    ...Sphere3D
}
