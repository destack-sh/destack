import { Ellipse2D, Ellipsoid3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// An EllipseShape2D is a collision shape representing an ellipse.
@entity
export struct EllipseShape2D extends Shape2D {
    ...Ellipse2D
}

/// An EllipsoidShape3D is a collision shape representing an ellipsoid.
@entity
export struct EllipsoidShape3D extends Shape3D {
    ...Ellipsoid3D
}
