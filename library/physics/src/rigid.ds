import { Vector2, Vector3 } from "@destack/math"
import { Body2D, Body3D } from "./body.ds"

/// Motion mode of a rigid body.
export enum RigidMotionMode {
    Static = 1
    Kinematic = 2
    Dynamic = 3
}

/// Kinematic properties for a 2D rigid body.
export struct Kinematic2D {
    velocity: Vector2 = Vector2.Zero
    angularVelocity: float32 = 0.0
    linearDamping: float32 = 0.0
    angularDamping: float32 = 0.0
    gravityScale: float32 = 1.0
}

/// Mass properties for a 2D rigid body.
export struct Mass2D {
    mass: float32 = 1.0
    centerOfMass: Vector2?
    inertia: float32 = 0.0
}

/// A solid simulated rigid body in 2D space.
@entity
export struct RigidBody2D extends Body2D {
    mode: RigidMotionMode = RigidMotionMode.Dynamic
    ...Kinematic2D
    ...Mass2D
}

/// Kinematic properties for a 3D rigid body.
export struct Kinematic3D {
    velocity: Vector3 = Vector3.Zero
    angularVelocity: Vector3 = Vector3.Zero
    linearDamping: float32 = 0.0
    angularDamping: float32 = 0.0
    gravityScale: float32 = 1.0
}

/// Mass properties for a 3D rigid body.
export struct Mass3D {
    mass: float32 = 1.0
    centerOfMass: Vector3?
    inertia: Vector3 = Vector3.Zero
}

/// A solid simulated rigid body in 3D space.
@entity
export struct RigidBody3D extends Body3D {
    mode: RigidMotionMode = RigidMotionMode.Dynamic
    ...Kinematic3D
    ...Mass3D
}
