import { Segment2D, Segment3D } from "@destack/math"
import { Shape2D, Shape3D } from "./shape.ds"

/// A SegmentShape2D is a collision shape representing a line segment in 2D.
@entity
export struct SegmentShape2D extends Shape2D {
    ...Segment2D
}

/// A SegmentShape3D is a collision shape representing a line segment in 3D.
@entity
export struct SegmentShape3D extends Shape3D {
    ...Segment3D
}
