use dyst

/// Base Collider event
@event
struct ColliderEvent {}

/// Collision contact between two colliders
@event
struct ColliderContactEvent: ColliderEvent { 

    /// First collider
    colliderA: Reference<Collider2D>,
    /// Second collider
    colliderB: Reference<Collider2D>,
}

/// A Collider in 2D space
@entity
struct Collider2D { 
 use Entity2D 
 }

/// A Collider in 3D space
@entity
struct Collider3D { 
 use Entity3D 
 }


