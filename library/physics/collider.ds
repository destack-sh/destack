using destack;

/// Base Collider event
@event
struct ColliderEvent {}

/// Collision contact between two colliders
@event
struct ColliderContactEvent using ColliderEvent {
    /// First collider
    colliderA: EntityReference<Collider2D>,
    /// Second collider
    colliderB: EntityReference<Collider2D>,
}

/// A Collider in 2D space
@entity
struct Collider2D using Entity2D {}

/// A Collider in 3D space
@entity
struct Collider3D using Entity3D {}


