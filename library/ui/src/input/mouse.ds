import * as ds from "destack";

/// A Mouse is a user input device that can be used to interact with the UI
@entity
export class Mouse2D extends Pointer2D { }

/// Mouse buttons
export enum MouseButton {
    Left,
    Right,
    Middle,
}

/// Mouse-derived event with a button
@event
export class MouseEvent extends PointerEvent {
    button: MouseButton,
}

/// Click event base
@event
export class ClickEvent extends MouseEvent { }

/// Single click
@event
export class SingleClickEvent extends ClickEvent { }

/// Double click
@event
export class DoubleClickEvent extends ClickEvent { }

/// Triple click
@event
export class TripleClickEvent extends ClickEvent { }

/// Wheel scroll
@event
export class WheelEvent extends MouseEvent {
    delta: Vector2,
}

