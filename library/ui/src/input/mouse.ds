import * as ds from "destack"

/// A Mouse is a user input device that can be used to interact with the UI
@entity
export struct Mouse2D extends Pointer2D { }

/// Mouse buttons
export enum MouseButton {
    Left = 1
    Right = 2
    Middle = 3
}

/// Mouse-derived event with a button
@event
export struct MouseEvent extends PointerEvent {
    button: MouseButton
}

/// Click event base
@event
export struct ClickEvent extends MouseEvent { }

/// Single click
@event
export struct SingleClickEvent extends ClickEvent { }

/// Double click
@event
export struct DoubleClickEvent extends ClickEvent { }

/// Triple click
@event
export struct TripleClickEvent extends ClickEvent { }

/// Wheel scroll
@event
export struct WheelEvent extends MouseEvent {
    delta: Vector2
}

