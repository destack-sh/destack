import * as ds from "destack"

export enum KeyModifier {
    Shift,
    Alt,
    Ctrl,
    Meta,
}

/// Keyboard base event
@event
export class KeyEvent extends InputEvent {
    /// The character pressed (e.g. 'a', 'B', '1', 'Enter')
    key: string,
    /// The unaltered code (e.g. 'KeyA', 'KeyB', 'Digit1', 'Enter')
    code: string,
    /// Whether the key is being held down
    isRepeat: boolean,
    /// Whether the key was masked (security/privacy)
    isRedacted: boolean,
    /// Modifiers
    modifiers: KeyModifier,
}

/// Key pressed down
@event
export class KeyDownEvent extends KeyEvent { }

/// Key released
@event
export class KeyUpEvent extends KeyEvent { }

/// Key pressed
@event
export class KeyPressEvent extends KeyEvent { }

