import * as ds from "destack"

/// A Pointer is a user input device that can be used to interact with the UI
@entity
export class Pointer2D {
    ...Body2D
}

/// Base pointer event with position, pressure and modifiers
@event
export class PointerEvent extends InputEvent {
    position: Vector2,
    pressure?: float32,
    shiftKey: boolean,
    altKey: boolean,
    ctrlKey: boolean,
    metaKey: boolean,
}

/// A PointerEvent when a pointer is pressed down
@event
export class PointerDownEvent extends PointerEvent { }

/// A PointerEvent when a pointer is released
@event
export class PointerUpEvent extends PointerEvent { }

/// A PointerEvent when a pointer is moved
@event
export class PointerMoveEvent extends PointerEvent { }

/// A PointerEvent when a pointer enters an element
@event
export class PointerEnterEvent extends PointerEvent { }

/// A PointerEvent when a pointer is over an element
@event
export class PointerOverEvent extends PointerEvent { }

/// A PointerEvent when a pointer leaves an element
@event
export class PointerLeaveEvent extends PointerEvent { }

/// A PointerEvent when a pointer is pressed and held
@event
export class PointerLongPressEvent extends PointerEvent { }

