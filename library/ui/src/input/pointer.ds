import * as ds from "destack"

/// A Pointer is a user input device that can be used to interact with the UI
@entity
export struct Pointer2D {
    ...Body2D
}

/// Base pointer event with position, pressure and modifiers
@event
export struct PointerEvent extends InputEvent {
    position: Vector2
    pressure?: float32
    shiftKey: boolean
    altKey: boolean
    ctrlKey: boolean
    metaKey: boolean
}

/// A PointerEvent when a pointer is pressed down
@event
export struct PointerDownEvent extends PointerEvent { }

/// A PointerEvent when a pointer is released
@event
export struct PointerUpEvent extends PointerEvent { }

/// A PointerEvent when a pointer is moved
@event
export struct PointerMoveEvent extends PointerEvent { }

/// A PointerEvent when a pointer enters an element
@event
export struct PointerEnterEvent extends PointerEvent { }

/// A PointerEvent when a pointer is over an element
@event
export struct PointerOverEvent extends PointerEvent { }

/// A PointerEvent when a pointer leaves an element
@event
export struct PointerLeaveEvent extends PointerEvent { }

/// A PointerEvent when a pointer is pressed and held
@event
export struct PointerLongPressEvent extends PointerEvent { }

