import * as ds from "destack"

/// Base focus event
@event
export struct FocusEvent extends InputEvent { }

/// Focus gained
@event
export struct FocusInEvent extends FocusEvent { }

/// Focus lost
@event
export struct FocusOutEvent extends FocusEvent { }

