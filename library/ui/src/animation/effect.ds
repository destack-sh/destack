import * as ds from "destack"

/// When the effect fires.
export enum EffectType {
    Appear = 10,
    Enter = 11,
    Exit = 12,
    Hover = 20,
    Press = 21,
    Drag = 22,
    Focus = 23,
    Loop = 30,
}

/// How a repeating animation behaves.
export enum RepeatType {
    Loop = 1,
    Reverse = 2,
    Mirror = 3,
}

/// How to split text for per-part effects.
export enum TextSplitType {
    Char = 1,
    Word = 2,
    Line = 3,
}

/// What happens when the element is offscreen.
export enum OffscreenBehavior {
    Play = 1,
    Pause = 2,
}

/// An effect value.
export struct Effect {
    /// When the effect is applied.
    type: EffectType,
    /// Optional template reference to inherit values from.
    template?: EffectTemplate,
    /// Optional opacity multiplier.
    opacity?: float32,
    /// Optional positional offset in 2D.
    offset?: Vector2,
    /// Optional uniform scale factor.
    scale?: float32,
    /// Optional 3D axis rotation.
    rotate?: Axis3,
    /// Optional 2D skew.
    skew?: Vector2,
    /// Optional perspective amount.
    perspective?: float32,
    /// Optional start delay.
    delay?: Duration,
    /// Optional playback duration.
    duration?: float32,
    /// Optional intersection threshold for visibility-driven effects.
    threshold?: float32,
    /// Whether to apply only once.
    once?: boolean,
    /// Optional repeat behavior.
    repeat?: RepeatType,
    /// Optional text split behavior.
    split?: TextSplitType,
    /// Offscreen behavior.
    offscreen?: OffscreenBehavior,
    /// Optional transition configuration.
    transition?: Transition,
}

/// An effect template.
@entity
export class EffectTemplate {
    /// When the effect is applied.
    type: EffectType,
    /// Optional opacity multiplier.
    opacity?: float32,
    /// Optional positional offset in 2D.
    offset?: Vector2,
    /// Optional uniform scale factor.
    scale?: float32,
    /// Optional 3D axis rotation.
    rotate?: Axis3,
    /// Optional 2D skew.
    skew?: Vector2,
    /// Optional perspective amount.
    perspective?: float32,
    /// Optional start delay.
    delay?: Duration,
    /// Optional playback duration.
    duration?: float32,
    /// Optional intersection threshold for visibility-driven effects.
    threshold?: float32,
    /// Whether to apply only once.
    once?: boolean,
    /// Optional repeat behavior.
    repeat?: RepeatType,
    /// Optional text split behavior.
    split?: TextSplitType,
    /// Offscreen behavior.
    offscreen?: OffscreenBehavior,
    /// Optional transition configuration.
    transition?: Transition,
}

