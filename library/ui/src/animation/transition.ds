import * as ds from "destack";

/// Built-in transition types
export enum TransitionType {
    Tween,
    Spring,
}

/// Built-in spring types
export enum SpringType {
    Time,
    Physical,
}

/// A transition value
export struct Transition {
    type: TransitionType = TransitionType.Tween,
    template?: TransitionTemplate,
    delay?: float32,
    duration?: float32,
    ease: float32[],
    stiffness?: float32,
    damping?: float32,
    mass?: float32,
    bounce?: float32,
    springType?: SpringType,
}

/// A transition templatecle
@entity
export class TransitionTemplate {
    type: TransitionType = TransitionType.Tween,
    delay?: float32,
    duration?: float32,
    ease: float32[],
    stiffness?: float32,
    damping?: float32,
    mass?: float32,
    bounce?: float32,
    springType?: SpringType,
}
