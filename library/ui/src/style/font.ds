/// Font family type.
export enum FontType {
    Serif = 10,
    Sans = 11,
    Mono = 12,
}

/// Font weight values.
export enum FontWeight {
    Thin = 100,
    ExtraLight = 200,
    Light = 300,
    Normal = 400,
    Medium = 500,
    SemiBold = 600,
    Bold = 700,
    ExtraBold = 800,
    Black = 900,
}

/// Font size presets.
export enum FontSize {
    Xs = 12,
    Sm = 14,
    Base = 16,
    Lg = 18,
    Xl = 20,
    Xl2 = 24,
    Xl3 = 30,
    Xl4 = 36,
    Xl5 = 48,
    Xl6 = 60,
    Xl7 = 72,
}

/// Text alignment options.
export enum TextAlign {
    Left = 1,
    Center = 2,
    Right = 3,
    Justify = 4,
}

/// Text decoration type.
export enum TextDecoration {
    None = 1,
    Underline = 2,
    Strikethrough = 3,
}

/// Text transform type.
export enum TextTransform {
    None = 1,
    Uppercase = 2,
    Lowercase = 3,
    Capitalize = 4,
}

/// Font value for a styled run or node.
export struct Font {
    /// Font family type.
    type: FontType,
    /// Reference to a reusable font style.
    template?: FontStyle,
    /// The weight of the font.
    weight?: FontWeight,
    /// The fill/foreground color of the font.
    fill?: Fill,
    /// The size of the font (preset).
    size?: FontSize,
    /// The text alignment.
    align?: TextAlign,
    /// Line height (custom length).
    lineHeight?: Length,
    /// Letter spacing (custom length).
    letterSpacing?: Length,
    /// Text decoration.
    decoration?: TextDecoration,
    /// Text transform.
    transform?: TextTransform,
}

/// A reusable font style.
export struct FontStyle extends Style {
    /// Font family type.
    type: FontType,
    /// The weight of the font.
    weight?: FontWeight,
    /// The fill/foreground color.
    fill?: Fill,
    /// The size of the font (preset).
    size?: FontSize,
    /// The text alignment.
    align?: TextAlign,
    /// Line height (custom length).
    lineHeight?: Length,
    /// Letter spacing (custom length).
    letterSpacing?: Length,
    /// Text decoration.
    decoration?: TextDecoration,
    /// Text transform.
    transform?: TextTransform,
}
