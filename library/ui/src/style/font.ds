/// Font family type.
export enum FontType {
    Serif,
    Sans,
    Mono,
}

/// Font weight values.
export enum FontWeight {
    Thin,
    ExtraLight,
    Light,
    Normal,
    Medium,
    SemiBold,
    Bold,
    ExtraBold,
    Black,
}

/// Font size presets.
export enum FontSize {
    Xs,
    Sm,
    Base,
    Lg,
    Xl,
    Xl2,
    Xl3,
    Xl4,
    Xl5,
    Xl6,
    Xl7,
}

/// Text alignment options.
export enum TextAlign {
    Left,
    Center,
    Right,
    Justify,
}

/// Text decoration type.
export enum TextDecoration {
    None,
    Underline,
    Strikethrough,
}

/// Text transform type.
export enum TextTransform {
    None,
    Uppercase,
    Lowercase,
    Capitalize,
}

/// Font value for a styled run or node.
export struct Font {
    /// Font family type.
    type: FontType,
    /// Reference to a reusable font style.
    template?: FontStyle,
    /// The weight of the font.
    weight?: FontWeight,
    /// The fill/foreground color of the font.
    fill?: Fill,
    /// The size of the font (preset).
    size?: FontSize,
    /// The text alignment.
    align?: TextAlign,
    /// Line height (custom length).
    lineHeight?: Length,
    /// Letter spacing (custom length).
    letterSpacing?: Length,
    /// Text decoration.
    decoration?: TextDecoration,
    /// Text transform.
    transform?: TextTransform,
}

/// A reusable font style.
export struct FontStyle extends Style {
    /// Font family type.
    type: FontType,
    /// The weight of the font.
    weight?: FontWeight,
    /// The fill/foreground color.
    fill?: Fill,
    /// The size of the font (preset).
    size?: FontSize,
    /// The text alignment.
    align?: TextAlign,
    /// Line height (custom length).
    lineHeight?: Length,
    /// Letter spacing (custom length).
    letterSpacing?: Length,
    /// Text decoration.
    decoration?: TextDecoration,
    /// Text transform.
    transform?: TextTransform,
}
