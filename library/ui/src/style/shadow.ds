/// Built-in shadow types.
export enum ShadowType {
    Box,
    Realistic,
}

/// Built-in shadow positions.
export enum ShadowPosition {
    Outside,
    Inside,
}

/// A shadow value for a styled surface.
export struct Shadow {
    /// The shadow type (box, realistic).
    type: ShadowType,
    /// Template for this shadow, if referenced.
    template?: ShadowStyle,
    /// Shadow color.
    color?: Color,
    /// Shadow position (inside or outside).
    position?: ShadowPosition,
    /// Shadow offset (x, y).
    offset?: Axis2,
    /// Shadow blur radius.
    blur?: float32,
    /// Shadow spread.
    spread?: float32,
    /// Shadow diffusion softness.
    diffusion?: float32,
}

/// A reusable shadow style.
export struct ShadowStyle extends Style {
    /// The shadow type (box, realistic).
    type: ShadowType,
    /// Shadow color.
    color?: Color,
    /// Shadow position (inside or outside).
    position?: ShadowPosition,
    /// Shadow offset (x, y).
    offset?: Axis2,
    /// Shadow blur radius.
    blur?: float32,
    /// Shadow spread.
    spread?: float32,
    /// Shadow diffusion softness.
    diffusion?: float32,
}
