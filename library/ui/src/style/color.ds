/// Built-in color formats.
export enum ColorType {
    Rgb,
    Hsl,
    P3,
}

/// Built-in color hues similar to SwiftUI or Tailwind.
export enum ColorHue {
    Gray,
    Red,
    Orange,
    Amber,
    Yellow,
    Lime,
    Green,
    Emerald,
    Teal,
    Cyan,
    Sky,
    Blue,
    Indigo,
    Violet,
    Purple,
    Fuchsia,
    Pink,
    Rose,
}

/// Built-in color shades a la Tailwind.
export enum ColorShade {
    S25,
    S50,
    S100,
    S200,
    S300,
    S400,
    S500,
    S600,
    S700,
    S800,
    S900,
    S950,
}

/// Built-in color intents for semantic meaning.
export enum ColorIntent {
    Primary,
    Secondary,
    Neutral,
    Muted,
    Success,
    Info,
    Warning,
    Error,
    Critical,
}

/// A color value (linear floats).
export struct Color {
    /// Red, 0.0 - 1.0 (linear).
    r: float32,
    /// Green, 0.0 - 1.0 (linear).
    g: float32,
    /// Blue, 0.0 - 1.0 (linear).
    b: float32,
    /// Alpha, 0.0 - 1.0 (linear).
    a: float32,
}

/// A color style, with an optional dark variant.
export struct ColorStyle extends Style {
    /// Color format (rgb, hsl, p3).
    type: ColorType,
    /// Reference hue, if set.
    hue?: ColorHue,
    /// Reference shade, if set.
    shade?: ColorShade,
    /// Semantic intent, if any.
    intent?: ColorIntent,
    /// Red channel (linear).
    r: float32,
    /// Green channel (linear).
    g: float32,
    /// Blue channel (linear).
    b: float32,
    /// Alpha channel.
    a: float32,
}

/// Convert hex color string to linear-space RGB floats with optional alpha.
export function hexToRgb(hex: string): (float32, float32, float32, float32?,) {
    throw new Error("Not implemented")
}

/// Convert 8-bit sRGB values to hex color string.
export function rgbToHex(r: uint32, g: uint32, b: uint32, a?: uint32): string {
    throw new Error("Not implemented")
}

/// Convert 8-bit sRGB values to HSL color space.
export function rgbToHsl(r: uint32, g: uint32, b: uint32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}

/// Convert HSL values to linear-space RGB floats.
export function hslToRgb(h: float32, s: float32, l: float32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}

/// Convert gamma-encoded sRGB to gamma-encoded Display-P3.
export function rgbToP3(r: float32, g: float32, b: float32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}

/// Convert gamma-encoded Display-P3 to gamma-encoded sRGB.
export function p3ToRgb(rp3: float32, gp3: float32, bp3: float32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}

/// Convert HSL to gamma-encoded Display-P3.
export function hslToP3(h: float32, s: float32, l: float32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}

/// Convert gamma-encoded Display-P3 to HSL.
export function p3ToHsl(rp3: float32, gp3: float32, bp3: float32): (float32, float32, float32,) {
    throw new Error("Not implemented")
}
