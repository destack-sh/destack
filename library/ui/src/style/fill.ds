import { Color, Gradient, Image, Style } from "@destack-sh/ui";

/// Type of Fill.
export enum FillType {
    Solid,
    Gradient,
    Image,
}

/// Position for an image or gradient fill.
export enum FillPosition {
    TopLeft,
    TopCenter,
    TopRight,
    Left,
    Center,
    Right,
    BottomLeft,
    BottomCenter,
    BottomRight,
}

/// Render size for an image or gradient fill.
export enum FillSize {
    Fill,
    Stretch,
    Fit,
    Tile,
}

/// A fill value for a styled surface.
export struct Fill {
    /// The fill type (solid, gradient, image).
    type: FillType,
    /// Template for this fill, if referenced.
    template?: FillStyle,
    /// Fill color.
    color?: Color,
    /// Gradient fill.
    gradient?: Gradient,
    /// Image fill.
    image?: Image,
    /// Fill position.
    position?: FillPosition,
    /// Fill sizing.
    size?: FillSize,
}

/// A reusable fill style.
export struct FillStyle extends Style {
    /// Fill type.
    type: FillType,
    /// Fill color.
    color?: Color,
    /// Gradient fill.
    gradient?: Gradient,
    /// Image fill.
    image?: Image,
    /// Fill position.
    position?: FillPosition,
    /// Fill sizing.
    size?: FillSize,
}
