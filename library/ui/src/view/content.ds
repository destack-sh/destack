import * as ds from "destack";

/// A 2D content View
@entity
export class ContentView2D extends View2D { }

/// A 2D Text View
@entity
export class TextView2D extends ContentView2D {
    /// The text to display
    text?: Text,
    /// The font to use for the text
    font?: Font,
    /// The color of the text
    color?: Fill,
}

