import * as ds from "destack";

/// Base input View
@entity
export class InputView2D extends View2D { }

/// A 2D number input View
@entity
export class NumberInputView2D extends InputView2D {
    /// The numeric value
    value?: float64,
    /// Placeholder text shown when empty
    placeholder?: string,
}

/// A 2D slider input View
@entity
export class SliderInputView2D extends InputView2D {
    /// The current slider value
    value?: float64,
}
