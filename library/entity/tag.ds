use dyst

/// Definition of a builtin Tag to associate builtin definitions to.
struct TagDefinition {
    /// The Tag id.
    id: uint8
    /// The Tag name.
    name: String
    /// The Tag description.
    description: ?String
    /// Whether self Tag is internal.
    isInternal: boolean
}

/// A Tag to tag an Entity with.
@entity
struct Tag {
    /// The designated Type for Values associated with self Tag. Any if unset.
    type: ?Type
}

