use dyst

/// An Entity Epoch.
struct Epoch(uint64) {
    let Zero = Epoch(0)
} 

/// The materialization level of an Entity.
enum(uint2) Materialization {
    /// The Entity is virtual.
    Virtual
    /// The Entity is partial.
    Partial
    /// The Entity is full.
    Full
    /// The Entity is root.
    Root
}

/// How an Entity should be treated for processing by the system.
@flag 
enum(uint4) ProcessFlag {
    /// The default process flag (no special processing).
    Default = 0
    /// The Entity is deleted.
    Deleted
    /// The Entity is inactive.
    Inactive
    /// The Entity is inactive and input is not processed.
    InactiveInput
    /// The Entity is sleeping and processed differently.
    Sleeping
}

/// How an Entity should be treated for extension by the system.
@flag 
enum(uint4) ExtensionFlag {
    /// The default extension flag (no special processing).
    Default = 0
    /// The Entity is instantiable.
    Instantiable
    /// The Entity is extensible.
    Extensible
}

struct Reference<T: Entity> {
    id: Uuid
    space_id: Uuid
    branch_id: Uuid
    snapshot_id: Uuid
}

struct Identity {
    /// The universally unique identifier of self Entity.
    id: Uuid
    /// The Space self Entity is in.
    space: Reference<Space>
    /// The Branch self Entity is part of (in its Space).
    branch: Reference<Branch>
    /// The Snapshot self Entity is part of (in its Space and Branch).
    snapshot: Reference<Snapshot>
}

implement TryDereference for Identity {
    function dereference(&self) with (
        GraphContext as graph
    ) {
        graph.get(self)
    } 

    function dereferenceVar(&self) with (
        GraphContext as graph
    ) {
        graph.get(self)
    }
}

/// A named, versioned, mutable object in the system.
@entity
struct Entity {
    use Identity as identity
    /// The materialization level of self Entity.
    materialization: Materialization = Materialization.Root
    /// The definition self Entity is an instance of.
    definition: ?Reference<Entity>
    /// The (root) Entity that is being instantiated.
    instance: ?Reference<Entity>
    
    /// The logical time self Entity was created.
    createdEpoch: Epoch
    /// The logical time self Entity was last updated.
    updatedEpoch: Epoch
    /// The exclusive owner of self Entity (the authority on access).
    owner: Reference<Entity>
    /// The exclusive controller of self Entity (the authority on changes).
    controller: Reference<Entity>
    /// The process flags of self Entity.
    processFlags: ProcessFlag = ProcessFlag.Default

    /// The parent of self Entity. Most Entities can be attached to any other Entity.
    parent: ?Reference<Entity>
    /// The name of self Entity.
    name: String
    /// The key of self Entity (for reconciliation and querying).
    key: ?String

    /// The extension flags of self Entity.
    extensionFlags: ExtensionFlag

    /// The Script of self Entity.
    script: ?Reference<Script>
}