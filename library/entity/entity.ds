use dyst

/// An Entity Epoch.
struct Epoch(uint64) {
    let Zero = Epoch(0)
}
/// The materialization level of an Entity.
enum(uint2) Materialization {
    Virtual
    Partial
    Full
    Root
}

/// How an Entity should be treated for processing by the system.
@flag
enum(uint4) ProcessFlag {
    Default = 0
    Deleted
    Inactive
    InactiveInput
    Sleeping
}

@flag
enum(uint4) ExtensionFlag {
    Default = 0
    Instantiable
    Extensible
}

/// A reference to an Entity.
struct Reference<T: Entity> {
    /// The universally unique identifier of self Entity.
    id: Uuid
    /// The Space self Entity is in.
    spaceId: Uuid
    /// The Branch self Entity is part of (in its Space).
    branchId: Uuid
}

/// Dereference a Reference to an Entity via Graph.
implement<T: Entity> Dereference<T> for Reference<&T> {
    function dereference(&self) with GraphContext as graph => &T? {
        graph.get(self)
    }
}

/// An Identity is globally unique identifier for an Entity.
struct Identity {
    /// The universally unique identifier of self Entity.
    id: Uuid
    /// The Space self Entity is in.
    space: Reference<Space>
    /// The Branch self Entity is part of (in its Space).
    branch: Reference<Branch>
}

/// A named, versioned, mutable object in the system.
struct Entity {
    #BeginGroup("main")
    /// The materialization level of the `Entity`.
    materialization: Materialization = Materialization.Root
    /// The Snapshot the `Entity` is part of (in its `Space` and `Branch`).
    snapshot: Reference<Snapshot>
    /// The definition the `Entity` is an instance of.
    definition: Reference<Entity>?
    /// The (root) `Entity` that is being instantiated.
    instance: Reference<Entity>?
    /// The logical time the `Entity` was created.
    createdAt: Epoch
    /// The logical time the `Entity` was last updated.
    updatedAt: Epoch
    /// The exclusive owner of the `Entity` (the authority on access).
    owner: Reference<Entity>
    /// The exclusive controller of the `Entity` (the authority on changes).
    controller: Reference<Entity>
    /// The process flags of the `Entity`.
    processing: ProcessFlag = ProcessFlag.Default
    #EndGroup

    #BeginGroup("tree")
    /// The parent of the `Entity`. Most `Entity`s can be attached to any other `Entity`.
    parent: Reference<Entity>?
    /// The name of the `Entity`.
    name: String
    /// The key of the `Entity` (for reconciliation and querying).
    key: String?
    #EndGroup

    #BeginGroup("extension")
    /// The extension flags of the `Entity`.
    extensibility: ExtensionFlag
    /// The Script of the `Entity`.
    script: Reference<Script>?
    #EndGroup

    /// The identity of the `Entity`.
    use Identity as identity
}