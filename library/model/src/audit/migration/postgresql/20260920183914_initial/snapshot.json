        },
        {
            "value": "\"version\" > 0",
            "name": "audit_version",
            "entityType": "checks",
            "schema": "public",
            "table": "audit_event"
        },
        {
            "value": "length(\"action\") > 0 AND strpos(\"action\", '.') > 0",
            "name": "audit_action",
            "entityType": "checks",
            "schema": "public",
            "table": "audit_event"
        },
        {
            "value": "\"outcome\" IN ('success', 'failure', 'denied')",
            "name": "audit_outcome",
            "entityType": "checks",
            "schema": "public",
            "table": "audit_event"
        },
        {
            "value": "\"outcome\" <> 'success' OR \"error_code\" IS NULL",
            "name": "audit_error",
            "entityType": "checks",
            "schema": "public",
            "table": "audit_event"
        },
        {
            "value": "\"space_id\" IS NULL OR \"account_id\" IS NOT NULL",
            "name": "audit_space_account",
            "entityType": "checks",
