import * as ds from "destack"

/// Run status values.
export enum RunStatus {
    Scheduled = 2
    Running = 10
    Paused = 21
    Yielded = 23
    Cancelled = 51
    Aborted = 52
    Failed = 53
    Completed = 54
}

/// Base event regarding a Run.
@event
export struct RunEvent {
    /// The Run self event pertains to.
    run: Run

    /// The target Entity of the Run, if any.
    target?
}

/// A Run was started.
@event
export struct RunStartedEvent extends RunEvent { }

/// A Run pause was requested.
@event
export struct RunPauseRequestedEvent extends RunEvent { }

/// A Run was paused.
@event
export struct RunPausedEvent extends RunEvent { }

/// A Run resume was requested.
@event
export struct RunResumeRequestedEvent extends RunEvent { }

/// A Run was resumed.
@event
export struct RunResumedEvent extends RunEvent { }

/// A Run stop was requested.
@event
export struct RunStopRequestedEvent extends RunEvent { }

/// A Run failed.
@event
export struct RunFailedEvent extends RunEvent { }

/// A Run completed.
@event
export struct RunCompletedEvent extends RunEvent { }

/// Run of an Action.
@entity
export struct Run {
    /// The Action being run.
    action: Reference<Action>
    /// The current Run status.
    status: RunStatus
    /// Duration from first attempt start to last attempt termination.
    duration?: Duration
    /// When the Run is scheduled to start.
    scheduledAt?: Timestamp
    /// When the Run first started.
    startedAt?: Timestamp
    /// When the Run was last active.
    seenAt?: Timestamp
    /// When the Run was interrupted.
    interruptedAt?: Timestamp
    /// When the Run was last terminated.
    terminatedAt?: Timestamp
}

