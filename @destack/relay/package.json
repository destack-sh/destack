{
    "name": "@destack/relay",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Relay HTTP requests for Destack names to the machines serving them.",
    "exports": {
        ".": "./src/index.ts",
        "./client": "./src/client/index.ts",
        "./error": "./src/error/index.ts",
        "./declare": "./src/declare/index.ts",
        "./server": "./src/server/index.ts",
        "./test": "./src/test/index.ts",
        "./package": "./src/package.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/stack": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/tunnel": "workspace:*"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@destack/universe": "workspace:*",
        "@types/bun": "1.4.2"
    }
}
