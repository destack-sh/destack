{
    "name": "@destack/relay",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Relay HTTP requests for Destack names to the cells serving them.",
    "exports": {
        ".": "./src/index.ts",
        "./server": "./src/server/index.ts",
        "./service": "./src/service/index.ts",
        "./bun": "./src/bun/index.ts",
        "./cloudflare": "./src/cloudflare/index.ts",
        "./tunnel": "./src/tunnel/index.ts",
        "./stack": "./src/stack/index.ts",
        "./test": "./src/test/index.ts",
        "./workload": "./src/workload/index.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/audit": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/directory": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/service": "workspace:*",
        "@destack/space": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/resource": "workspace:*"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2",
        "miniflare": "4.20260730.0"
    }
}
