{
    "name": "@destack/template-blank",
    "version": "2026.11.0",
    "license": "MIT",
    "type": "module",
    "description": "Start a new Destack package from an empty package with one setting.",
    "exports": {
        "./setting": "./src/setting/index.ts",
        "./package": "./src/package.ts"
    },
    "scripts": {
        "postinstall": "destack-check configure",
        "typecheck": "tsc --project tsconfig.json && destack-check readme"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "@types/bun": "1.4.4"
    },
    "dependencies": {
        "@destack/locale": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/template-stack": "workspace:*"
    }
}
