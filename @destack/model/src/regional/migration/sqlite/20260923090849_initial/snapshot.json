            "table": "package"
        },
        {
            "value": "length(\"directory\") > 0 AND substr(\"directory\", 1, 1) <> '/' AND \"directory\" NOT LIKE '../%' AND \"directory\" NOT LIKE '%/../%' AND \"directory\" <> '..' AND \"directory\" NOT LIKE '%/..'",
            "name": "package_directory",
            "entityType": "checks",
