        },
        {
            "value": "(\"hosting\" = 'platform' AND \"provider\" IS NOT NULL AND \"host_id\" IS NULL)\n            OR (\"hosting\" = 'external' AND \"provider\" IS NOT NULL AND \"remote\" IS NOT NULL AND \"host_id\" IS NULL)\n            OR (\"hosting\" = 'host' AND \"host_id\" IS NOT NULL AND \"provider\" IS NULL AND \"provider_repository_id\" IS NULL AND \"remote\" IS NULL)",
            "name": "repository_origin",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "(\"hosting\" IN ('platform', 'host') AND \"authentication\" IS NULL AND \"connected_account_id\" IS NULL AND \"secret_space_id\" IS NULL AND \"secret_id\" IS NULL)\n            OR (\"hosting\" = 'external' AND \"authentication\" IS NOT NULL AND (\n                (\"authentication\" = 'anonymous' AND \"connected_account_id\" IS NULL AND \"secret_space_id\" IS NULL AND \"secret_id\" IS NULL)\n                OR (\"authentication\" = 'connection' AND \"connected_account_id\" IS NOT NULL AND \"secret_space_id\" IS NULL AND \"secret_id\" IS NULL)\n                OR (\"authentication\" = 'secret' AND \"connected_account_id\" IS NULL AND \"secret_space_id\" IS NOT NULL AND \"secret_id\" IS NOT NULL)))",
            "name": "repository_authentication",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "\"default_reference\" IS NULL OR \"default_reference\" LIKE 'refs/heads/%'",
            "name": "repository_default_reference",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "\"remote\" IS NULL OR length(\"remote\") > 0",
            "name": "repository_remote",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "(\"provider\" IS NULL OR length(\"provider\") > 0)\n            AND (\"provider_repository_id\" IS NULL OR length(\"provider_repository_id\") > 0)",
            "name": "repository_provider",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "\"id\" IS NOT NULL",
            "name": "repository_id_not_null",
            "entityType": "checks",
            "table": "repository"
        },
        {
            "value": "\"name\" LIKE 'refs/%'",
            "name": "repository_ref_name",
            "entityType": "checks",
            "table": "repository_ref"
        },
        {
            "value": "length(\"object\") IN (40, 64) AND \"object\" NOT GLOB '*[^0-9a-f]*'",
            "name": "repository_ref_object",
            "entityType": "checks",
            "table": "repository_ref"
        },
        {
            "value": "\"commit\" IS NULL OR (length(\"commit\") IN (40, 64) AND \"commit\" NOT GLOB '*[^0-9a-f]*')",
            "name": "repository_ref_commit",
            "entityType": "checks",
            "table": "repository_ref"
        },
        {
            "value": "\"revision\" >= 1",
            "name": "repository_ref_revision",
            "entityType": "checks",
            "table": "repository_ref"
        },
        {
            "value": "length(\"commit\") IN (40, 64) AND \"commit\" NOT GLOB '*[^0-9a-f]*'",
            "name": "release_commit",
            "entityType": "checks",
            "table": "release"
        },
        {
            "value": "length(\"directory\") > 0 AND substr(\"directory\", 1, 1) <> '/' AND \"directory\" <> '..' AND \"directory\" NOT LIKE '../%' AND \"directory\" NOT LIKE '%/../%' AND \"directory\" NOT LIKE '%/..'",
            "name": "release_directory",
            "entityType": "checks",
            "table": "release"
        },
        {
            "value": "length(\"manifest\") = 64 AND \"manifest\" NOT GLOB '*[^0-9a-f]*'",
            "name": "release_manifest",
            "entityType": "checks",
            "table": "release"
        },
        {
            "value": "\"visibility\" IN ('public', 'unlisted', 'private')",
            "name": "package_visibility",
