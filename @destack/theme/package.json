{
    "name": "@destack/theme",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./declare": "./src/declare/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./motion": "./src/motion/index.ts",
        "./text": "./src/text/index.ts",
        "./theme.css": "./src/theme/theme.css",
        "./tokens.json": "./src/token/tokens.json",
        "./tokens.stylex": "./src/token/tokens.stylex.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts",
        "generate": "bun run src/token/generate.ts"
    },
    "dependencies": {
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/style": "workspace:*"
    },
    "devDependencies": {
        "@destack/environment": "workspace:*",
        "@destack/test": "workspace:*"
    }
}
