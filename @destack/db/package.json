{
    "name": "@destack/db",
    "version": "2026.9.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "Interact with SQL databases in Destack.",
    "sideEffects": false,
    "exports": {
        "./log": "./src/log/index.ts",
        "./query": "./src/query/index.ts",
        "./tree": "./src/tree/index.ts",
        "./error": "./src/error/index.ts",
        "./declare": "./src/declare/index.ts",
        ".": "./src/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./postgres": "./src/postgres/index.ts",
        "./bun": "./src/sqlite/bun/index.ts",
        "./test": "./src/test/index.ts",
        "./relay": "./src/relay/index.ts",
        "./shared": "./src/sqlite/shared/index.ts",
        "./sqlite": "./src/sqlite/index.ts",
        "./wasm": "./src/sqlite/wasm/index.ts"
    },
    "imports": {
        "#connector": {
            "bun": "./src/connector/bun.ts",
            "default": "./src/connector/none.ts"
        }
    },
    "scripts": {
        "check": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/package": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@sqlite.org/sqlite-wasm": "3.53.4-build1",
        "drizzle-orm": "1.0.0-rc.4",
        "postgres": "3.4.9",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@destack/test": "workspace:*"
    }
}
