{
    "name": "@destack/db",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "Interact with SQL databases in Destack.",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./error": "./src/error/index.ts",
        "./postgres": "./src/postgres/index.ts",
        "./bun": "./src/bun/index.ts",
        "./test": "./src/test/index.ts",
        "./test/run": "./src/test/run.ts",
        "./channel/socket": "./src/channel/socket.ts",
        "./sqlite": "./src/sqlite/index.ts",
        "./browser": "./src/browser/index.ts",
        "./cloudflare": "./src/cloudflare/index.ts",
        "./inspect": "./src/inspect/index.ts"
    },
    "imports": {
        "#connector": {
            "bun": "./src/bun/connector.ts",
            "default": "./src/declare/connector.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/fs": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@noble/ciphers": "2.4.0",
        "@sqlite.org/sqlite-wasm": "3.53.4-build1",
        "postgres": "3.4.9",
        "uuid": "14.0.2"
    },
    "peerDependencies": {
        "@destack/test": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@destack/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "esbuild": "~0.28.1",
        "miniflare": "4.20260730.0",
        "@types/node": "26.6.1"
    }
}
