{
    "name": "@destack/check",
    "version": "2026.9.0",
    "description": "Check and format Destack packages.",
    "license": "MIT",
    "bin": {
        "destack-check": "./src/main.ts"
    },
    "type": "module",
    "exports": {
        "./command": "./src/main.ts",
        ".": "./src/index.ts",
        "./lint": "./src/lint/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./error": "./src/error/index.ts",
        "./toolchain": "./src/toolchain/index.ts",
        "./workspace": "./src/workspace/index.ts",
        "./bun": "./src/bun/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@oxlint/plugins": "1.83.0",
        "typescript": "7.0.2",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-tsgolint": "7.0.2002",
        "@destack/error": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "1.4.2"
    }
}
