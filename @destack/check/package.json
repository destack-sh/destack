{
    "name": "@destack/check",
    "description": "Lint, format and check Destack packages and their READMEs with one command.",
    "license": "Apache-2.0",
    "bin": {
        "destack-check": "./src/main.ts"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./lint": "./src/lint/index.ts",
        "./diagnostic": "./src/diagnostic/index.ts",
        "./error": "./src/error/index.ts",
        "./project": "./src/project/index.ts",
        "./toolchain": "./src/toolchain/index.ts",
        "./workspace": "./src/workspace/index.ts",
        "./bun": "./src/bun/index.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/telemetry": "workspace:*"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@oxlint/plugins": "1.83.0",
        "@types/bun": "1.4.4",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@destack/test": "workspace:*",
        "@oxlint/plugins": "1.83.0",
        "oxfmt": "0.68.0",
        "typescript": "7.0.2"
    },
    "peerDependenciesMeta": {
        "@destack/test": {
            "optional": true
        },
        "@oxlint/plugins": {
            "optional": true
        },
        "oxfmt": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    }
}
