{
    "name": "@destack/build",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Inspect and build Destack packages.",
    "bin": {
        "destack-build": "./src/main.ts"
    },
    "exports": {
        "./browser": "./src/browser.d.ts",
        "./local": "./src/local/index.ts",
        "./template": "./src/template/index.ts",
        ".": "./src/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./error": "./src/error/index.ts",
        "./store": "./src/store/index.ts"
    },
    "scripts": {
        "check": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/check": "workspace:*",
        "@destack/locale": "workspace:*",
        "magic-string": "1.4.1",
        "@cloudflare/workers-types": "5.20260917.1",
        "@destack/service": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/test": "workspace:*",
        "vite": "8.3.0",
        "typescript": "7.0.2",
        "rolldown": "1.2.9",
        "@destack/bucket": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/sandbox": "workspace:*"
    },
    "devDependencies": {
        "@destack/sync": "workspace:*",
        "uuid": "14.0.2",
        "@types/bun": "1.4.2",
        "@destack/web": "workspace:*"
    }
}
