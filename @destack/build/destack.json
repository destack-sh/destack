{
    "$schema": "https://destack.app/schemas/2026.9.0/destack.json",
    "id": "package-01a0c80b-614f-73ec-82e0-7594bbf8213e",
    "role": "library",
    "language": "typescript",
    "runtimes": ["bun"],
    "entrypoints": ["src/main.ts"],
    "shares": ["@destack/build", "vite", "rolldown"],
    "check": {
        "expect": [
            {
                "files": ["src/cache/fingerprint.ts"],
                "rules": ["destack/no-ambient-effect"],
                "reason": "the compiler fingerprint resolves its entry's imports as Bun loads them, which only Bun's resolver over the host's files does"
            },
            {
                "files": ["src/main.ts"],
                "rules": ["destack/no-ambient-effect"],
                "reason": "the compiler's entry clears rolldown's binding path once the preload loaded it, before any other native binding reads it"
            }
        ]
    },
    "exports": {
        "./browser": {
            "runtimes": ["browser"],
            "internal": true
        },
        "./store": {
            "runtimes": ["bun", "workerd"],
            "internal": true
        },
        "./table": {
            "runtimes": ["bun", "workerd", "browser"],
            "internal": true
        },
        "./main": {
            "internal": true
        },
        "./local": {
            "internal": true
        },
        "./template": {
            "internal": true
        },
        ".": {
            "internal": true
        },
        "./error": {
            "internal": true
        }
    }
}
