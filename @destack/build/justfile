set shell := ["bash", "-cu"]

# check
check:
    bun run check

# test
test:
    bun run test

# update fixtures
update:
    UPDATE_BUILD_FIXTURES=1 bun run test --update

# format authored source, tests and fixture inputs, leaving generated expected outputs exact
format:
    bun run destack-check format src package.json destack.json tests/*.ts tests/fixture/*/request.ts tests/fixture/*/source/src tests/fixture/*/source/*.json tests/fixture/template
