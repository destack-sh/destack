{
    "name": "@example/stack",
    "version": "2026.11.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Start a space's stack from a template: a files bucket, a credentials vault, the baseline installations and an alert on fatal issues.",
    "exports": {
        ".": "./src/index.ts",
        "./stack": "./src/stack/index.ts",
        "./account": "./src/account/index.ts",
        "./setting": "./src/setting/index.ts"
    },
    "scripts": {
        "postinstall": "destack-check configure",
        "typecheck": "tsc --project tsconfig.json && destack-check readme"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "@types/bun": "1.4.4"
    },
    "dependencies": {
        "@destack/setting": "workspace:*",
        "@destack/view": "workspace:*",
        "@destack/access": "workspace:*",
        "@destack/stack": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/bucket": "workspace:*",
        "@destack/vault": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/observability": "workspace:*",
        "@destack/message": "workspace:*",
        "@destack/notification": "workspace:*",
        "@destack/social": "workspace:*"
    }
}
