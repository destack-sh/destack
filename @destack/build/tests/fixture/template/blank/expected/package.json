{
    "name": "@example/blank",
    "version": "2026.11.0",
    "license": "MIT",
    "type": "module",
    "description": "Start a new Destack package from an empty package with one setting.",
    "exports": {
        "./setting": "./src/setting/index.ts",
        "./package": "./src/package.ts"
    },
    "scripts": {
        "postinstall": "destack-check configure",
        "typecheck": "tsc --project tsconfig.json && destack-check readme"
    },
    "devDependencies": {
        "@destack/check": "2026.11.0"
    },
    "dependencies": {
        "@destack/locale": "workspace:*",
        "@destack/object": "2026.11.0",
        "@destack/package": "2026.11.0",
        "@destack/schema": "2026.11.0",
        "@destack/setting": "2026.11.0",
        "@example/stack": "2026.9.0"
    }
}
