{
    "name": "@destack/sandbox",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "description": "Launch processes with operating system filesystem and network restrictions.",
    "bin": {
        "destack-sandbox": "./src/main.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./error": "./src/error/index.ts",
        "./workload": "./src/workload/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json && destack-check readme",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@anthropic-ai/sandbox-runtime": "0.0.77",
        "@destack/schema": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4"
    }
}
