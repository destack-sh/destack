{
    "name": "@destack/mail",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Compose mail, submit it over SMTP or through Amazon SES, and send the email messages of the message kind.",
    "exports": {
        ".": "./src/index.ts",
        "./aws": "./src/aws/index.ts",
        "./mime": "./src/mime/index.ts",
        "./print": "./src/print/index.ts",
        "./provider": "./src/provider/index.ts",
        "./smtp": "./src/smtp/index.ts",
        "./test": "./src/test/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2"
    },
    "dependencies": {
        "@aws-crypto/sha256-browser": "5.2.0",
        "@destack/message": "workspace:*",
        "@destack/schema": "workspace:*",
        "@smithy/signature-v4": "5.7.4",
        "@destack/error": "workspace:*"
    }
}
