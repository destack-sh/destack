{
    "name": "@destack/mail",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Send email over SMTP or Amazon SES, or print it on machines without a provider.",
    "exports": {
        ".": "./src/index.ts",
        "./declare": "./src/declare/index.ts",
        "./error": "./src/error/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./transport": "./src/transport/index.ts",
        "./mime": "./src/mime/index.ts",
        "./smtp": "./src/smtp/index.ts",
        "./ses": "./src/ses/index.ts",
        "./print": "./src/print/index.ts",
        "./sender": "./src/sender/index.ts",
        "./test": "./src/test/index.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json && destack-check readme",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/object": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4"
    }
}
