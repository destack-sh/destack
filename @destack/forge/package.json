{
    "name": "@destack/forge",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Host the Git repositories of accounts and publish, resolve and distribute their Destack packages.",
    "exports": {
        "./error": "./src/error/index.ts",
        "./object": "./src/object/index.ts",
        "./client": "./src/client/index.ts",
        "./server": "./src/server.ts",
        "./test": "./src/test/index.ts",
        "./stack": "./src/stack/index.ts",
        "./pack": "./src/pack/index.ts",
        "./storage": "./src/storage/index.ts",
        "./local": "./src/local/index.ts",
        "./cloudflare": "./src/cloudflare/index.ts",
        "./github": "./src/github/index.ts",
        "./package": "./src/package.ts",
        "./inspect": "./src/inspect/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/bucket": "workspace:*",
        "@destack/build": "workspace:*",
        "@destack/connection": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/event": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/stack": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/vault": "workspace:*",
        "@destack/workflow": "workspace:*",
        "semver": "7.8.5"
    },
    "devDependencies": {
        "@destack/identity": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2",
        "@types/semver": "7.8.0"
    }
}
