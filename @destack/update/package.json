{
    "name": "@destack/update",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Update installed Destack distributions.",
    "exports": {
        ".": "./src/index.ts",
        "./release": "./src/release/index.ts",
        "./apple": "./src/apple/index.ts",
        "./error": "./src/error/index.ts",
        "./object": "./src/object/index.ts",
        "./publish": "./src/publish/index.ts",
        "./server": "./src/server/index.ts",
        "./test": "./src/test/index.ts",
        "./service": "./src/service/index.ts"
    },
    "dependencies": {
        "@destack/account": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/fs": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/service": "workspace:*",
        "@tufjs/models": "5.0.0",
        "tar": "7.5.22",
        "tuf-js": "6.0.0",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    }
}
