{
    "name": "@destack/universe",
    "version": "2026.9.0",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "description": "Run a universe: the account and setting packages over one store, on Bun or as a Cloudflare Worker.",
    "exports": {
        ".": "./src/index.ts",
        "./bun": "./src/bun/index.ts",
        "./cloudflare": "./src/cloudflare/index.ts",
        "./cloudflare/worker": "./src/cloudflare/worker.ts",
        "./destack.json": "./destack.json"
    },
