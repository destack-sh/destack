        "./client": "./src/client/index.ts",
        "./client/browser": "./src/client/browser.ts",
        "./device": "./src/device/index.ts",
        "./device/browser": "./src/device/browser.ts",
        "./test": "./src/test/index.ts",
        "./workload": "./src/workload/index.ts",
        "./bun": "./src/bun/index.ts",
        "./cloudflare": "./src/cloudflare/index.ts",
        "./scenario": "./src/scenario/index.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/color": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/event": "workspace:*",
        "@destack/icon": "workspace:*",
        "@destack/identity": "workspace:*",
