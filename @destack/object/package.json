        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@orpc/client": "1.15.1",
        "@orpc/contract": "1.15.1",
        "@orpc/json-schema": "1.15.1",
        "@orpc/openapi": "1.15.1",
        "@orpc/openapi-client": "1.15.1",
        "@orpc/server": "1.15.1",
        "@orpc/shared": "1.15.1",
        "@orpc/standard-server": "1.15.1",
        "@orpc/standard-server-peer": "1.15.1",
