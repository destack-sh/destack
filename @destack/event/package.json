{
    "name": "@destack/event",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Keep the append-only events of scopes, hot in their database and sealed into their bucket, and query, fold and follow them.",
    "exports": {
        ".": "./src/index.ts",
        "./destack.json": "./destack.json",
        "./declare": "./src/kind/index.ts",
        "./stack": "./src/stack/index.ts",
        "./test": "./src/test/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/bucket": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/service": "workspace:*",
        "hyparquet": "1.31.2",
        "hyparquet-writer": "0.16.10",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2"
    }
}
