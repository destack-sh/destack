{
    "name": "@destack/telemetry",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "Instrument Destack packages with traces, metrics, and logs.",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./trace": "./src/trace/index.ts",
        "./metric": "./src/metric/index.ts",
        "./sdk": "./src/sdk/index.ts",
        "./bun": "./src/bun/index.ts",
        "./browser": "./src/browser/index.ts",
        "./worker": "./src/worker/index.ts",
        "./otlp": "./src/otlp/index.ts",
        "./test": "./src/test/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/sdk-trace": "3.0.0",
        "@opentelemetry/sdk-metrics": "3.0.0",
        "@opentelemetry/sdk-logs": "3.0.0",
        "@opentelemetry/resources": "3.0.0",
        "@opentelemetry/context-async-hooks": "3.0.0",
        "@opentelemetry/core": "3.0.0",
        "@opentelemetry/otlp-transformer": "0.300.0",
        "@destack/error": "workspace:*"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/node": "26.6.1"
    }
}
