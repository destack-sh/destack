{
    "name": "@destack/environment",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Take every effect through one environment: time, randomness and the network, real or simulated.",
    "exports": {
        ".": "./src/index.ts",
        "./bun": "./src/bun.ts",
        "./browser": "./src/browser/index.ts",
        "./simulation": "./src/simulation/index.ts",
        "./browser/simulation": "./src/browser/simulation.ts",
        "./workerd": "./src/workerd/index.ts",
        "./destack.json": "./destack.json"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2"
    },
    "dependencies": {
        "@destack/error": "workspace:*",
        "@destack/schema": "workspace:*",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/context-async-hooks": "3.0.0",
        "@opentelemetry/core": "3.0.0",
        "@opentelemetry/sdk-logs": "3.0.0",
        "@opentelemetry/sdk-metrics": "3.0.0",
        "@opentelemetry/sdk-trace": "3.0.0"
    }
}
