{
    "name": "@destack/access",
    "version": "2026.11.0",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "description": "Decide who may do what to each object, and share, delegate and revoke that access.",
    "exports": {
        ".": "./src/index.ts",
        "./declare": "./src/declare/index.ts",
        "./error": "./src/error/index.ts",
        "./test": "./src/test/index.ts",
        "./token": "./src/token/index.ts"
    },
    "dependencies": {
        "@destack/db": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/sync": "workspace:*"
    },
    "devDependencies": {
        "@destack/environment": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4"
    },
    "scripts": {
        "typecheck": "destack-check readme && tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    }
}
