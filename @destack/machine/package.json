        "./device": "./src/computer/device/index.ts",
        "./test": "./src/computer/test/index.ts",
        "./benchmark": "./src/benchmark/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts --project \"test:*\"",
        "bench": "bun --bun run vitest run --config vitest.config.ts --project \"bench:*\""
