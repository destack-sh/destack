        "@destack/schema": "workspace:*",
        "@destack/service": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "uuid": "14.0.2",
        "@destack/space": "workspace:*",
        "@destack/vault": "workspace:*",
        "@destack/bucket": "workspace:*",
        "@destack/build": "workspace:*",
        "@destack/view": "workspace:*",
        "@destack/relay": "workspace:*",
        "@destack/registry": "workspace:*"
    },
    "devDependencies": {
        "@destack/directory": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/test": "workspace:*",
        "@template/stack": "workspace:*",
        "@types/bun": "1.4.2"
    }
