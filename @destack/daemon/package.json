{
    "name": "@destack/daemon",
    "version": "2026.9.2",
    "license": "MIT",
    "type": "module",
    "description": "Run a device host that serves spaces and keeps its logins, checkouts and previews.",
    "exports": {
        "./error": "./src/error/index.ts",
        ".": "./src/service/index.ts",
        "./client": "./src/client/index.ts",
        "./service/credential": "./src/service/credential.ts",
        "./client/local": "./src/client/local.ts",
        "./process": "./src/process/index.ts",
        "./run": "./src/daemon/daemon.ts",
        "./destack.json": "./destack.json",
        "./server": "./src/server/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./package": "./src/package.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/sync": "workspace:*",
        "@destack/host": "workspace:*",
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
