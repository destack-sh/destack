{
    "name": "@destack/workflow",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Run durable functions step by step as objects of the space they run in.",
    "exports": {
        ".": "./src/index.ts",
        "./destack.json": "./destack.json",
        "./inspect": "./src/inspect/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "cron-parser": "5.7.0"
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.2"
    }
}
