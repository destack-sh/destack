{
    "name": "@destack/identity",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Prove who a principal is and keep the keys proving it.",
    "exports": {
        ".": "./src/index.ts",
        "./error": "./src/error/index.ts",
