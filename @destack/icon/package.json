{
    "name": "@destack/icon",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Name Phosphor icons and store their SVG bodies, each one loaded only where it is used.",
    "exports": {
        ".": "./src/index.ts",
        "./name": "./src/name/index.ts",
        "./phosphor/*": "./src/phosphor/icon/*.ts",
        "./icons": "./src/phosphor/icons.ts"
    },
    "scripts": {
        "generate": "bun run src/phosphor/generate.ts"
    },
    "dependencies": {
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/test": "workspace:*",
        "@phosphor-icons/core": "2.1.1",
        "@types/bun": "1.4.4"
    },
    "peerDependencies": {
        "@destack/environment": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@destack/environment": {
            "optional": true
        }
    }
}
