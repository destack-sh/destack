{
    "name": "@destack/template-stack",
    "version": "2026.11.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Start a space's stack from a template: a files bucket, a credentials vault, the baseline installations and an automatic rollback.",
    "exports": {
        ".": "./src/index.ts",
        "./stack": "./src/stack/index.ts",
        "./account": "./src/account/index.ts",
        "./setting": "./src/setting/index.ts"
    },
    "scripts": {
        "postinstall": "destack-check configure",
        "typecheck": "tsc --project tsconfig.json && destack-check readme"
    },
    "devDependencies": {
        "@destack/check": "2026.11.0"
    },
    "dependencies": {
        "@destack/setting": "2026.11.0",
        "@destack/view": "2026.11.0",
        "@destack/access": "2026.11.0",
        "@destack/stack": "2026.11.0",
        "@destack/db": "2026.11.0",
        "@destack/bucket": "2026.11.0",
        "@destack/vault": "2026.11.0",
        "@destack/account": "2026.11.0",
        "@destack/observability": "2026.11.0",
        "@destack/message": "2026.11.0",
        "@destack/notification": "2026.11.0",
        "@destack/social": "2026.11.0"
    }
}
