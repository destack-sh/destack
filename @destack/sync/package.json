{
    "name": "@destack/sync",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Synchronize database rows to subscribers and local replicas, as each commit lands.",
    "exports": {
        ".": "./src/index.ts",
        "./error": "./src/error/index.ts",
        "./test": "./src/test/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json && destack-check readme",
        "test": "bun --bun run vitest run --config vitest.config.ts --project 'unit:*'",
        "bench": "bun --bun run vitest run --config vitest.config.ts --project 'bench:*'"
    },
    "dependencies": {
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*"
    },
    "peerDependencies": {
        "@destack/test": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@destack/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/node": "26.6.1"
    }
}
