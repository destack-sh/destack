{
    "name": "@destack/sync",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Synchronize database rows to subscribers and local replicas, as each commit lands.",
    "exports": {
        ".": "./src/index.ts",
        "./dataflow": "./src/dataflow.ts",
        "./error": "./src/error/index.ts",
        "./test": "./src/test/index.ts",
        "./scenario": "./src/scenario/index.ts"
    },
    "dependencies": {
        "@destack/db": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/telemetry": "workspace:*"
    },
    "peerDependencies": {
        "@destack/test": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@destack/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/locale": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/node": "26.6.1"
    }
}
