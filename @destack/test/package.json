{
    "name": "@destack/test",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Write and run Destack tests: unit tests on Vitest, simulated worlds, and scenarios played through drivers.",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config/index.ts",
        "./host": "./src/host/index.ts",
        "./world": "./src/world/index.ts"
    },
    "scripts": {
        "typecheck": "destack-check readme && tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/ui": "5.0.1",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
    },
    "devDependencies": {
        "@destack/environment": "workspace:*"
    }
}
