{
    "name": "@destack/vault",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Keep secrets as encrypted versions and rotate them without redeploying.",
    "exports": {
        ".": "./src/index.ts",
        "./declare": "./src/declare/index.ts",
        "./error": "./src/error/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./object": "./src/object/index.ts",
        "./provider": "./src/provider/index.ts",
        "./server": "./src/server.ts",
        "./package": "./src/package.ts",
        "./stack": "./src/stack/index.ts",
        "./test": "./src/test/index.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/locale": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/stack": "workspace:*",
        "@destack/sync": "workspace:*"
    },
    "peerDependencies": {
        "@destack/environment": "workspace:*",
        "@destack/test": "workspace:*",
        "@destack/control": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@destack/environment": {
            "optional": true
        },
        "@destack/test": {
            "optional": true
        },
        "@destack/control": {
            "optional": true
        }
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json && destack-check readme",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@destack/control": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/machine": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4"
    }
}
