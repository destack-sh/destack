{
    "name": "@destack/package",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Describe Destack packages, their declarations, builds and source code.",
    "exports": {
        "./template": "./src/template/index.ts",
        "./error": "./src/error/index.ts",
        ".": "./src/index.ts",
        "./manifest": "./src/manifest/index.ts",
        "./stack": "./src/stack/index.ts",
        "./archive": "./src/archive/index.ts",
        "./code": "./src/code/index.ts",
        "./source": "./src/source/index.ts",
        "./file": "./src/file/index.ts",
        "./import-meta": "./src/definition/import-meta.ts",
        "./runtime": "./src/runtime/index.ts",
        "./locator": "./src/locator/index.ts",
        "./transform": "./src/transform/index.ts",
        "./vite": "./src/vite/index.ts",
        "./bun": "./src/bun/index.ts",
        "./bun/preload": "./src/bun/preload.ts",
        "./workerd": "./src/workerd/index.ts",
        "./declare": "./src/declare/index.ts",
        "./build": "./src/build/index.ts",
        "./test": "./src/test/index.ts",
        "./schemas/destack.json": "./schemas/destack.json"
    },
    "scripts": {
        "typecheck": "destack-check readme && tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/schema": "workspace:*",
        "@jridgewell/trace-mapping": "0.3.31",
        "es-module-lexer": "3.0.4",
        "lightningcss": "1.33.0",
        "magic-string": "1.4.1"
    },
    "peerDependencies": {
        "rolldown": "1.2.16",
        "vite": "8.3.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4",
        "rolldown": "1.2.16",
        "vite": "8.3.0"
    }
}
