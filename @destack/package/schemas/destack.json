                    "type": "string",
                    "pattern": "^https:\\/\\/destack\\.app\\/schemas\\/[^/]+\\/destack\\.json$"
                },
                "id": {
                    "type": "string",
                    "pattern": "^package-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
                },
                "language": {
                    "type": "string",
                    "enum": [
                        "typescript",
                        "typescript++"
