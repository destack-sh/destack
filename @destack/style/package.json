{
    "name": "@destack/style",
    "description": "Describe colors and styles as the web does, and style components with StyleX.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./media.stylex": "./src/stylex/media.stylex.ts",
        "./frame.stylex": "./src/stylex/frame.stylex.ts",
        "./build": "./src/build/index.ts",
        "./preflight.css": "./src/preflight/preflight.css"
    },
    "dependencies": {
        "@destack/locale": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@stylexjs/stylex": "0.19.1"
    },
    "peerDependencies": {
        "@destack/environment": "workspace:*",
        "@stylexswc/rs-compiler": "0.20.1",
        "lightningcss": "1.33.0",
        "vite": "8.4.0-beta.1"
    },
    "peerDependenciesMeta": {
        "@destack/environment": {
            "optional": true
        },
        "@stylexswc/rs-compiler": {
            "optional": true
        },
        "lightningcss": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/build": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/test": "workspace:*",
        "@stylexswc/rs-compiler": "0.20.1",
        "lightningcss": "1.33.0",
        "vite": "8.4.0-beta.1"
    }
}
