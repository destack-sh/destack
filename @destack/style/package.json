{
    "name": "@destack/style",
    "description": "Style components with StyleX, compiled into one stylesheet per build.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./build": "./src/build/index.ts",
        "./media.stylex": "./src/style/media.stylex.ts",
        "./frame.stylex": "./src/style/frame.stylex.ts",
        "./preflight.css": "./src/preflight/preflight.css"
    },
    "dependencies": {
        "@destack/package": "workspace:*",
        "@stylexjs/stylex": "0.19.1"
    },
    "peerDependencies": {
        "@destack/environment": "workspace:*",
        "@destack/schema": "workspace:*",
        "@stylexjs/unplugin": "0.19.1",
        "lightningcss": "1.33.0",
        "vite": "8.3.8"
    },
    "peerDependenciesMeta": {
        "@destack/environment": {
            "optional": true
        },
        "@destack/schema": {
            "optional": true
        },
        "@stylexjs/unplugin": {
            "optional": true
        },
        "lightningcss": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@destack/build": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/test": "workspace:*",
        "@stylexjs/unplugin": "0.19.1",
        "lightningcss": "1.33.0",
        "vite": "8.3.8"
    }
}
