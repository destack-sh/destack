{
    "name": "@destack/style",
    "version": "2026.11.0",
    "description": "Style components with StyleX, compiled into one stylesheet per build.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./build": "./src/build/index.ts",
        "./media.stylex": "./src/style/media.stylex.ts",
        "./preflight.css": "./src/preflight/preflight.css"
    },
    "scripts": {
        "typecheck": "destack-check readme && tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@stylexjs/stylex": "0.19.1",
        "@stylexjs/unplugin": "0.19.1",
        "lightningcss": "1.33.0"
    },
    "peerDependencies": {
        "vite": "8.3.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "vite": "8.3.0",
        "@destack/test": "workspace:*"
    }
}
