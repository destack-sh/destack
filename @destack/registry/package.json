{
    "name": "@destack/registry",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "Publish, resolve, and distribute Destack packages.",
    "exports": {
        "./object": "./src/object/index.ts",
        "./server": "./src/server/index.ts",
