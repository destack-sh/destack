{
    "name": "@destack/observability",
    "version": "2026.9.0",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "description": "Query, follow and alert on the telemetry and analytics of Destack scopes, group their failures into issues, and measure what their spaces use.",
    "exports": {
        ".": "./src/index.ts",
        "./declare": "./src/declare/index.ts",
        "./inspect": "./src/inspect/index.ts",
        "./service": "./src/service/index.ts",
        "./server": "./src/server/index.ts",
        "./setting": "./src/setting/index.ts",
        "./stack": "./src/stack/index.ts",
        "./object": "./src/object/index.ts",
        "./meter": "./src/meter/index.ts",
        "./view": "./src/view/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "test": "bun --bun run vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/audit": "workspace:*",
        "@destack/bucket": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/error": "workspace:*",
        "@destack/event": "workspace:*",
        "@destack/finance": "workspace:*",
        "@destack/icon": "workspace:*",
        "@destack/locale": "workspace:*",
        "@destack/notification": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/service": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/social": "workspace:*",
        "@destack/space": "workspace:*",
        "@destack/style": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/theme": "workspace:*",
        "@destack/ui": "workspace:*",
        "@destack/view": "workspace:*",
        "@jridgewell/trace-mapping": "0.3.31"
    },
    "devDependencies": {
        "@destack/identity": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/node": "26.6.1"
    }
}
