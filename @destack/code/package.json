{
    "name": "@destack/code",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Parse, compare, patch and merge source code in the browser, in Bun and in workers.",
    "exports": {
        ".": "./src/index.ts",
        "./grammar/*": "./src/grammar/language/*.ts"
    },
    "scripts": {
        "generate": "bun run src/grammar/javascript/generate.ts"
    },
    "dependencies": {
        "@codemirror/legacy-modes": "6.5.5",
        "@codemirror/streamparser": "6.0.0",
        "@destack/schema": "workspace:*",
        "@lezer/common": "1.5.6",
        "@lezer/cpp": "1.1.6",
        "@lezer/css": "1.3.9",
        "@lezer/go": "1.0.1",
        "@lezer/highlight": "1.2.5",
        "@lezer/html": "1.3.13",
        "@lezer/java": "1.2.0",
        "@lezer/javascript": "1.5.6",
        "@lezer/json": "1.0.3",
        "@lezer/lr": "1.4.12",
        "@lezer/markdown": "1.8.1",
        "@lezer/php": "1.0.6",
        "@lezer/python": "1.1.19",
        "@lezer/rust": "1.0.3",
        "@lezer/sass": "1.1.0",
        "@lezer/xml": "1.0.6",
        "@lezer/yaml": "1.0.4"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/locale": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/test": "workspace:*",
        "@lezer/generator": "1.8.1",
        "@types/bun": "1.4.4"
    }
}
