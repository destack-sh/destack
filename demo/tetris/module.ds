use dyst

enum Color {
    Red
    Orange
    Yellow
    Green
    Blue
    Purple
    Brown
}

struct TetrisComponent {
    id: int32
}

@entity
struct TetrisGame {
    use TetrisComponent
}

implement Context for TetrisGame {

}

@entity 
struct TetrisBoard<Width: int32, Height: int32> {
    /// The grid of the board.
    grid: [[TetrisPiece; Width]; Height]
}

enum TetrisPieceShape {
    I
    J
    L
    O
    S
    T
    Z
}

@entity
union(TetrisPieceShape) TetrisPiece {
    use RigidBody2D
}

implement TetrisPiece {
    function new(shape: TetrisPieceShape) => TetrisPiece {
        TetrisPiece { shape }
    }

    function getColor(self) => Color {
        match self {
            TetrisPieceShape.I => Color.Blue
            TetrisPieceShape.J => Color.Red
            TetrisPieceShape.L => Color.Orange
            TetrisPieceShape.O => Color.Yellow
            TetrisPieceShape.S => Color.Green
            TetrisPieceShape.T => Color.Purple
            TetrisPieceShape.Z => Color.Brown
        }
    }
}

implement Tick for TetrisGame {
    function tick(*var self) with Time, Random {
        
    }
}

implement Draw for TetrisGame {
    function draw(self) {
        // ...
    }
}