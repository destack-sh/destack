import { entity, Entity, Reference } from "destack"
import { DateTime } from "destack.time"

/// The status of a Meetup.
export enum MeetupStatus {
    /// The Meetup is a draft.
    @default
    Draft = 1
    /// The Meetup is upcoming.
    Upcoming
    /// The Meetup is cancelled.
    Cancelled
    /// The Meetup is past.
    Past
}

/// A Series of related Meetups (with a common prefix).
@entity
export struct MeetupSeries {
    // The name of the Meetup Series.
    name: string
    /// The prefix of the Meetup Series.
    prefix: string
}

@entity
export struct Meetup {
    // When the Meetup is happening.
    date: DateTime
    // The name of the Meetup.
    name: string
    // The number of the Meetup.
    number: uint
    // The Series this Meetup is part of.
    series: Reference<MeetupSeries>
    // The status of the Meetup.
    status: MeetupStatus
}

/// Registration for a Meetup.
@entity
export struct MeetupRegistration {
    // The Meetup this registration is for.
    meetup: Reference<Meetup>
    // The person registering.
    user: Reference<User>
}

/// Register for a Meetup.
@action(commit: true)
export async function register(
    meetup: Reference<Meetup>,
    user: Reference<User>,
): MeetupRegistration {
    const registration = MeetupRegistration { meetup, user }
    session.create(registration)
    return registration
}