import destack

/// A Series of related Meetups (with a common prefix).
@entity
export struct MeetupSeries {
    // The name of the Meetup Series.
    name: string
    /// The prefix of the Meetup Series.
    prefix: string
}

@entity
export struct Meetup {
    // When the Meetup is happening.
    date: Date
    // The name of the Meetup.
    name: string
    // The number of the Meetup.
    number: uint32
    // The Series this Meetup is part of.
    series: Reference<MeetupSeries>

    // {
    //     function get(self) { return @format("{self.name} {self.surname}") }
    //     function set(self, value: string) { self.name = value }
    // }
}

