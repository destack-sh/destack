set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# all service crates
packages := "-p destack_daemon"
format-packages := "-p destack_daemon"
test-packages := "-p destack_daemon"

_default:
    @just --list --unsorted

# keep rust test concurrency on one repo wide knob when configured
_run-rust-test *args:
    cargo_bin="cargo"; if [ "${OS:-}" = "Windows_NT" ] && command -v cargo.exe >/dev/null 2>&1; then cargo_bin="cargo.exe"; fi; test_threads="${DESTACK_TEST_THREADS:-${RUST_TEST_THREADS:-}}"; if [ -n "${test_threads}" ]; then export RUST_TEST_THREADS="${test_threads}"; fi; "${cargo_bin}" test {{args}}

# --- build ---

# run service static checks
check:
    cargo clippy --release {{ packages }}

# build all service crates
build:
    cargo build --release {{ packages }}

# format code
format:
    cargo fmt {{ format-packages }}

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean

# --- test ---

# run the service test aggregate
test:
    just _run-rust-test --release --all-targets {{ test-packages }}

# run the service quick gate
quick:
    just format-check
    just check
    just test

# run the service full gate
full:
    just quick
