set shell := ["bash", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# all service crates
packages := "-p destack_daemon -p destack_lsp -p destack_lsp_server -p destack_lsp_types"
format-packages := "-p destack_daemon -p destack_lsp -p destack_lsp_server -p destack_lsp_types"
test-packages := "-p destack_daemon -p destack_lsp -p destack_lsp_server -p destack_lsp_types"

_default:
    @just --list --unsorted

# keep rust test concurrency on one repo wide knob when configured
_run-rust-test *args:
    #!/usr/bin/env bash
    set -euo pipefail

    test_threads="${DESTACK_TEST_THREADS:-${RUST_TEST_THREADS:-}}"

    if [ -n "${test_threads}" ]; then
        export RUST_TEST_THREADS="${test_threads}"
    fi

    cargo test {{args}}

# --- build ---

# check service crates
check:
    cargo clippy --release {{ packages }}

# build all service crates
build:
    cargo build --release {{ packages }}

# format code
format:
    cargo fmt {{ format-packages }}

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean

# --- test ---

# run service tests
test:
    just _run-rust-test --release --all-targets {{ test-packages }}

# run the fast service gate
quick:
    just format-check
    just check
    just test

# run the full service gate
full:
    just quick
