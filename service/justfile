set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# selected crates
packages := "-p destack_daemon"
format-packages := "-p destack_daemon"
test-packages := "-p destack_daemon"

_default:
    @just --list --unsorted

# --- build ---

# run static checks
lint:
    cargo clippy --release {{ packages }} --no-deps

# build packages
build:
    cargo build --release {{ packages }}

# format code
format:
    cargo fmt {{ format-packages }}

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean

# --- test ---

# run tests
test:
    cargo test --release --all-targets {{ test-packages }}

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint
    just test

# check with slow suites
check-full:
    just check-quick
