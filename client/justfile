set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# selected crates
packages := "-p destack_client_generate -p destack_napi -p destack_wasm -p destack -p destack_python"
format-packages := "-p destack_client_generate -p destack_napi -p destack_wasm -p destack -p destack_python"
test-packages := "-p destack_client_generate -p destack_napi -p destack_wasm -p destack -p destack_python"

_default:
    @just --list --unsorted

# --- setup ---

# validate supported toolchains
install-toolchain:
    bash scripts/client-toolchain.sh install

# inspect supported toolchains
doctor-toolchain:
    bash scripts/client-toolchain.sh doctor

# ensure supported toolchains
ensure-toolchain:
    bash scripts/client-toolchain.sh ensure

# --- build ---

# generate client target bindings
generate:
    cargo run -p destack_client_generate

# run static checks
lint:
    just generate
    cargo clippy --release {{ packages }}
    bun run --cwd napi build
    bun run --cwd wasm build
    bun x tsc -p typescript/tsconfig.json
    bun x biome lint napi wasm typescript

# build packages
build:
    just generate
    cargo build --release {{ packages }}
    just build-napi
    just build-wasm
    bun run --cwd typescript build

# build napi package
build-napi:
    bun run --cwd napi build

# build wasm package
build-wasm:
    bun run --cwd wasm build

# canonical wasm size analysis command
wasm-size:
    cd wasm && bun ./scripts/size-report.mjs

# format code
format:
    just generate
    cargo fmt {{ format-packages }}
    bun x biome format --write napi wasm typescript
    cd python && uv run --no-project --with ruff==0.15.18 ruff format src tests

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false napi wasm typescript
    cd python && uv run --no-project --with ruff==0.15.18 ruff format --check src tests

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean
    rm -rf napi/node_modules wasm/node_modules typescript/node_modules
    rm -rf typescript/dist
    rm -rf python/.venv python/dist
    rm -f python/src/destack/_native*.so

# --- test ---

# run tests
test:
    just generate
    cargo test --release --all-targets {{ test-packages }}
    bun run --cwd napi test
    bun run --cwd wasm test
    bun run --cwd typescript test
    just test-python

# synchronize python client development tools
sync-python:
    cd python && uv sync --no-install-project --group publish

# run python client tests
test-python:
    just sync-python
    cd python && uv run --no-sync maturin develop --quiet
    cd python && uv run --no-sync pytest tests

# default check
check *args:
    just check-quick {{args}}

# normal check
check-quick *args:
    just format-check
    just lint
    just test

# check with slow suites
check-full *args:
    just check-quick {{args}}

# --- release ---

# publish npm sdk packages dry by default
publish-npm dry="--dry-run":
    cd napi && npm publish {{dry}} --access public
    cd wasm && npm publish {{dry}} --access public
    cd typescript && npm publish {{dry}} --access public

# publish cargo sdk crate dry by default
publish-cargo dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cargo check -p destack; \
        (cd rust && cargo package --allow-dirty --list >/dev/null); \
    else \
        if [ -z "${CARGO_TOKEN:-}" ]; then \
            echo "missing CARGO_TOKEN env var for live cargo publish"; \
            exit 1; \
        fi; \
        (cd rust && cargo publish --token "${CARGO_TOKEN}"); \
    fi

# publish pypi package dry by default
publish-pypi dry="--dry-run":
    just sync-python
    rm -rf python/dist
    cd python && uv run --no-sync python -m build
    cd python && uv run --no-sync twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" uv run --no-sync twine upload --non-interactive dist/*; \
    fi
    @if [ -d "python/dist" ]; then \
        rm -r python/dist; \
    fi

# publish packages dry by default
publish dry="--dry-run":
    just publish-npm "{{dry}}"
    just publish-cargo "{{dry}}"
    just publish-pypi "{{dry}}"
