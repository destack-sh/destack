{
    "name": "@destack/language-napi",
    "version": "2026.9.0",
    "description": "Node-API language bindings for Destack",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/destack-sh/destack.git",
        "directory": "client/napi"
    },
    "homepage": "https://github.com/destack-sh/destack/tree/main/client/napi",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "keywords": [
        "destack",
        "napi",
        "bindings",
        "typescript"
    ],
    "files": [
        "dist",
        "Cargo.toml"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "rm -rf dist && bun x @napi-rs/cli build --release --platform --esm --output-dir dist --js index.js --dts index.d.ts",
        "test": "bun run build",
        "prepublishOnly": "bun run build",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {},
    "devDependencies": {
        "@napi-rs/cli": "3.7.0",
        "typescript": "5.8.3"
    }
}
