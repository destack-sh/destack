{
    "name": "@destack/language",
    "version": "0.55.4",
    "description": "Destack language client for JavaScript and TypeScript",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/destack-sh/destack.git",
        "directory": "client/typescript"
    },
    "homepage": "https://github.com/destack-sh/destack/tree/main/client/typescript",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "keywords": [
        "destack",
        "language",
        "javascript",
        "sdk",
        "client"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./napi": {
            "types": "./dist/napi.d.ts",
            "import": "./dist/napi.js",
            "default": "./dist/napi.js"
        },
        "./wasm": {
            "types": "./dist/wasm.d.ts",
            "import": "./dist/wasm.js",
            "default": "./dist/wasm.js"
        },
        "./workspace": {
            "types": "./dist/workspace/workspace.d.ts",
            "import": "./dist/workspace/workspace.js",
            "default": "./dist/workspace/workspace.js"
        },
        "./protocol/codec": {
            "types": "./dist/protocol/codec.d.ts",
            "import": "./dist/protocol/codec.js",
            "default": "./dist/protocol/codec.js"
        },
        "./protocol/defaults": {
            "types": "./dist/_generated/protocol/defaults.d.ts",
            "import": "./dist/_generated/protocol/defaults.js",
            "default": "./dist/_generated/protocol/defaults.js"
        },
        "./protocol/serde": {
            "types": "./dist/protocol/serde.d.ts",
            "import": "./dist/protocol/serde.js",
            "default": "./dist/protocol/serde.js"
        },
        "./protocol/connection": {
            "types": "./dist/protocol/connection/index.d.ts",
            "import": "./dist/protocol/connection/index.js",
            "default": "./dist/protocol/connection/index.js"
        },
        "./protocol/workspace": {
            "types": "./dist/protocol/workspace.d.ts",
            "import": "./dist/protocol/workspace.js",
            "default": "./dist/protocol/workspace.js"
        },
        "./_generated/*": {
            "types": "./dist/_generated/*.d.ts",
            "import": "./dist/_generated/*.js",
            "default": "./dist/_generated/*.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "generate": "cargo run -p destack_client_generate",
        "build": "bun run generate && rm -rf dist && bun x tsc -p tsconfig.json",
        "test": "bun run --cwd ../napi build && bun run build && bun test ./test/*.ts",
        "prepublishOnly": "bun run build",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@destack/language-napi": "0.55.4",
        "@destack/language-wasm": "0.55.4"
    },
    "devDependencies": {
        "typescript": "5.8.3"
    }
}
