{
    "name": "@destack/language-wasm",
    "version": "2026.9.0",
    "description": "WebAssembly language bindings for Destack",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/destack-sh/destack.git",
        "directory": "client/wasm"
    },
    "homepage": "https://github.com/destack-sh/destack/tree/main/client/wasm",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "keywords": [
        "destack",
        "wasm",
        "webassembly",
        "typescript"
    ],
    "files": [
        "dist",
        "loader.d.ts",
        "loader.js",
        "scripts",
        "Cargo.toml"
    ],
    "main": "./loader.js",
    "types": "./loader.d.ts",
    "exports": {
        ".": {
            "types": "./loader.d.ts",
            "import": "./loader.js",
            "default": "./loader.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "rm -rf dist && bun x wasm-pack build --release --target web --out-dir dist",
        "test": "bun run build",
        "size:report": "bun ./scripts/size-report.mjs",
        "size:report:all": "bun ./scripts/size-report.mjs --brotli",
        "prepublishOnly": "bun run build",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {},
    "devDependencies": {
        "wasm-pack": "0.15.0",
        "typescript": "5.8.3"
    }
}
