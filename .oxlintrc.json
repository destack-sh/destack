        },
        { "files": ["@destack/view/src/test/dom.ts"], "rules": { "eslint/id-length": "off" } },
        {
            "files": [
                "@destack/view/src/document/script.tsx",
                "@destack/view/src/document/font.tsx"
            ],
            "rules": { "destack/prevent-abbreviations": "off" }
        },
        {
            "files": [
                "@destack/view/src/primitives/event-props.ts",
                "@destack/view/src/primitives/intersection-observer.ts",
                "@destack/view/src/primitives/resize-observer.ts",
                "@destack/view/src/primitives/bounds.ts",
                "@destack/view/src/primitives/media.ts",
                "@destack/view/src/primitives/event-listener.ts",
                "@destack/view/src/router/search.ts"
            ],
            "rules": { "destack/no-overload-cast": "off" }
        },
        {
            "files": ["@destack/view/src/test/server.ts"],
            "rules": { "destack/no-overload-cast": "off" }
        },
        {
            "files": ["@platform/release/src/distribution/executable.ts"],
            "rules": { "destack/no-ambient-effect": "off" }
        },
        {
            "files": ["@platform/site/src/view/content/asset.ts"],
            "rules": { "destack/no-ambient-effect": "off" }
        }
    ],
