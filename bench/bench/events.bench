--- events ---
enum EntityType:
- Asset
- Organization
- Person
- Location

type Entity:
- name: string "The canonical name of the entity"
- mentioned_as: [string] "The entity's names as they appear in the text"
- 'type': EntityType

enum EventType:
- Listing "A new entity is listed on the exchange"
- Filing "Some regulatory filing is made"

enum EventPriority:
- Critical "The event is incredibly important"
- High
- Medium
- Low

type Event:
"Something that happened"
- title: string? "The title of the event (if relevant)"
- summary: string "What happened"
- datetime: string? "The date and time of the event"
- 'type': EventType
- priority: EventPriority
- entities: [Entity] "The entities involved in the event"

task 'extract events' :: (input: string) -> (events: [Event]):
"Extract events from the given text"
    expect 'event follows from text':
    "The text should imply the event"
    expect 'non-overlapping events':
    "The events should be distinct in content"