--- lib.x ---
enum EntityType :: string:
"Type of an entity"
Person = `"PER"`
Location = `"LOC"`
Organization = `"ORG"`
Misc = `"MISC"`

type Entity:
"A named entity in a text"
name: string "Canonical name of the entity"
'type': EntityType
confidence: number | null "Confidence in the detected type"

    like data samples :: (name: string, 'type': EntityType):
    "Common uses of {Entity}"
    ```csv
    "Barack Obama","PER"
    "London","LOC"
    "Google","ORG"
    ```

--- main.x ---
# Describe what to do
import type Entity from .lib
import type EntityType from .lib

task 'extract entities' :: (input: string) -> [Entity]:
"Extract the distinct entities from the text"
    expect 'no duplicates' on output:
    "The entities are distinct"
        verify code check_no_duplicates :: (entities: [Entity]) -> boolean:
        "Check that the entities are distinct (very crudely)"
        ```python
        entities_by_name = {e.name: e for e in entities}
        return len(entities_by_name) == len(entities)
        ```

# Build
require openai.std@latest
import model text-davinci-003 from openai.std.text

compile prod:
    task 'extract entities'
    model text-davinci-003

run ner-prod:
    task 'extract entities'
    compile prod

--- compiled.x ---
import model text-davinci-003 from openai.std.text
import type Entity from .lib
import type EntityType from .lib

# do we need to copy all deps?

data 'Entity_best samples' :: (name: string, 'type': EntityType):
```csv
"Barack Obama","PER"
"London","LOC"
"Google","ORG"
```

code extract_entities :: (input: string) -> [Entity]:
```bpl
pragma(max_tokens=2048, temperature=0.3)
pragma(model=context['text-davinci-003'])
# prompt
"Extract the distinct entities from the text. Be precise and follow the format exactly.\n"
"Example entities:\n"
for entity in context['Entity_best samples']:
    type = entity['type'] # should be EntityType but data isn't typed (yet?)
    name = entity['name']
    "\{'type': '{type: string}', 'name': '{name: string}'\}\n"
"Input: \n\"{input}\"\n"
"The number of entities mentioned in the above text followed by the entities as jsonl:"
"\n# entities = [num_entities: number]\n"
entities = []
for i in range(int(num_entities)):
    # "[entity: Entity]\n"
    "\{'type': '[type: EntityType]', 'name': '[name: string]'\}"
    if i < num_entities - 1:
        "\n"
    confidence = 0.5 # TODO @Incomplete: get confidence from token reads (holes and entire span)
    entity = Entity(name=name, type=type, confidence=confidence)
    entities.append(entity)
    # "[cont: ',\n' | '\n']" # TODO @Incomplete: need proper continuation signal
    # if cont == '\n':
    #    break
return entities
```