--- complete.x ---

enum CodeLanguage :: string:
PYTHON = `"python"`
SQL = `"sql"`
R = `"r"`

enum UnsafeCodePolicy :: string:
ALLOW = `"allow"`
WARN_WITH_COMMENT = `"warn_with_comment"`
HIDE = `"hide"`

type CodeContext:
primary_language: CodeLanguage | null
preceding_code: string
unsafe_policy: UnsafeCodePolicy

type CodeCompletion = string

task complete_code :: (context: CodeContext) -> CodeCompletion:
"Complete the code in the most useful way possible."
    like data 'good completions'

    expect 'idiomatic code' on output:
    "The code should be idiomatic for the language."
        like data 'idiomatic code'
        unlike data 'bad code'

    expect 'safe code':
    "The code should be safe in context."
        like data 'safe code'
        unlike data 'unsafe code'

    expect 'useful code':
    "The code should be useful in the context"
        expect 'no repetition':
        "The code should not repeat itself unnecessarily"
            verify code check_repetition

    expect 'no response if no idea':
    "No code should be generated if it has no idea what to do"
        verify code check_no_idea

    # control control flow without leaving abstraction
    with code _implementation_:
    ```python
    how?
    ```

    task 'lookup docs' :: ??? -> ???:
    "Consider the docs for the language and context (if needed)"
        task 'get searchable terms' :: ??? -> ???:
        "Find searchable terms relevant to the given context"
        with code lookup_docs

    task 'handle safety' :: ??? -> ???:
    "Handle unsafe code giving the safety policy"

code lookup_docs :: (term: string) -> string | null:
```python
return await lookup_docs_somewhere(term, context.primary_language)
```

code check_repetition :: (prev_code: string, completion: str) -> boolean:
```python
# very simple and stupid check for repetition
return input not in prev_code
```

