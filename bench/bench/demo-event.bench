--- events.x ---
enum EntityType :: string:
ASSET = `"asset"`
ORGANIZATION = `"organization"`
PERSON = `"person"`
LOCATION = `"location"`

type Entity:
name: string "The canonical name of the entity"
mentioned_as: [string] "The entity's names as they appear in the text"
'type': EntityType

enum EventType :: string:
LISTING = `"listing"` "A new entity is listed on the exchange"
FILING = `"filing"` "Some regulatory filing is made"

enum EventPriority :: number:
CRITICAL = `3`
HIGH = `2`
MEDIUM = `1`
LOW = `0`

type Event:
"Something that happened"
title: string | null "The title of the event (if relevant)"
summary: string "What happened"
datetime: string | null "The date and time of the event"
'type': EventType
priority: EventPriority
entities: [Entity] "The entities involved in the event"

task 'extract events' :: (input: string) -> [Event]:
"Extract events from the given text"
    expect 'event follows from text':
    "The text should imply the event"
    expect 'non-overlapping events' on output:
    "The events should be distinct in content"

require openai.std@latest
import model text-davinci-003 from openai.std.text

build main:
    task 'extract events'
    model text-davinci-003