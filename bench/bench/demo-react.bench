--- react ---
# # Bench port of [ReAct](https://arxiv.org/pdf/2210.03629.pdf) as a library

enum ReactMode :: string:
Thought = `"tho"`
Observation = `"obs"`
Action = `"act"`

type ReactStep:
mode: ReactMode
action_type: ActionT
subject: string | null

task 'react' :: (input: string, max_steps: number) -> string | null "Answer":
"Step the react loop until it is finished"
    var type ActionT
    var code act :: (action: ActionT) -> string | null

    with code implementation :: ():
    ```python
    for i in range(max_steps):
        step = decide_step(input, i)
        if step.mode == ReactMode.Action:
            result = act(step.action_type, step.subject)
            emit(ReactMode.Observation, i, result)
    ```

    task 'decide step' :: (input: string, i: number) -> ReactStep:
    "Decide what to do next"

    # buildd implementation
    with code implementation :: ():
    ```bpl
    # context
    "{samples}"
    # prompt
    "{input}"
    for i in range(max_steps):
        "[mode: ReactMode] {i}: "
        if mode == ReactMode.Thought:
           "[thought: string]\n"
        elif mode == ReactMode.Action:
           "[action_type: ActionT] [subject: string | null]\n"
           result = act(action_type, subject)
           "{ReactMode.Observation} {i}: {result}\n"
        else: # nothing to do
           "[observation: string]\n"
           pass
    ```

--- wiki-react ---

enum WikiActionType :: string:
Search = `"search"` "Get paragraph from wikipedia page"
Lookup = `"lookup"` "Get next sentence mentioning the string"
Finish = `"finish"` "Finish the question (final answer or unanswerable)"

task 'answer with react' :: (question: string) -> string | null "Answer":
"Answer the given query with the tools at hand"
    extend task 'react loop'
        with type ActionT = WikiActionType