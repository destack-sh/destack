    or "\{'type': [type: EntityType], 'name': \"[name: string]\", 'confidence': [confidence: number | null]\}\n"
    or "\{'type': [type: EntityType], 'name': \"[name: string]\"\}\n"
    confidence = ... get confidence from token reads (holes and entire span)
    entity = Entity(name=name, type=type, confidence=confidence)
    entities.append(entity)
return entities
