--- math ---
task calculate :: (input: string) -> number:
"Compute a mathematical value from any expression"

task 'solve equation' :: (equation: string, variable: string) -> number | string:
"Solve an equation for a variable"

capability 'basic math':
"Perform basic arithmetic operations"
    task calculate
    task 'solve equation'

--- scratchpad ---
import capability 'basic math' from .math

# 'using' applies a symbol to the current scope
# should the using apply to the task? build? both?
# what about 'using' for other symbols?
# using capability 'basic math'

task 'count fruits' :: (input: string) -> number:
"Count the number of distinct fruits mentioned"

