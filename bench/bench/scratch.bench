# # Enums
enum Behavior:
"Enums as symbolic constants"
Basic
Advanced
Extended

enum EntityType :: (string):
"Enums as value unions (usual style)"
PER = 'person'
ORG = 'organization' "The organization entity type"
LOC = 'location' "The location entity type"
MISC = 'miscellaneous' "The miscellaneous entity type"

enum Fruit :: (number, string | null):
"Enums as flexible value unions (Python style)"
Apple = (1, null)
Banana = (2, 'yellow')
Orange = (3, 'orange')
Pineapple = (4)

enum Entity:
"Enums as type unions (Rust-style)"
Person :: (name: string, age: number)
Organization :: (name: string, location: Entity)
Location :: (name: string, country: string)
Miscellaneous :: (info: string)
# this could also be a different thing, like "type enum Entity"
# or just an internal type tag for TYPE_ENUM and VALUE_ENUM (or just ENUM)