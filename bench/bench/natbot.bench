--- natbot ---

enum CommandType:
"The action to take"
- ScrollUp "scroll up"
- ScrollDown "scroll down"
- Click "click on the given element"
- Type "type the given text"
- TypeSubmit "type the given text and submit"

type Command:
"An action to take in the browser"
- 'type': CommandType
- element_id: number?
- content: string?

enum BrowserElementType:
- Link
- Button
- Input
- Image
- Text

type BrowserElement:
"A simplified element from a real web page"
- 'type': BrowserElementType
- id: number
- text: string? "Text content or alt text if any"

type BrowserContext:
"The current state of the browser"
- elements: [BrowserElement] "All elements on the page"
- current_url: string

code 'browse to goal' :: (objective: string, max_steps: number?):
"Use a web browser to achieve the given objective"
```python

num_steps: int = 0
```