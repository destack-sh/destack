--- zoo.x ---

enum AnimalType :: string:
Sheep = `"sheep"` "The fluffy white cloud"
Goat = `"goat"` "The proud mountain creature"
HouseCat = `"house cat"` "The domesticated feline"
Lion = `"lion"` "The king of the jungle"
Penguin = `"penguin"` "The majestic bird fish"

task 'identify animal speaker' :: (input: string) -> AnimalType | null "The type of author":
"Classify the given input text by the animal type of the author."
    expect 'no output if unclear':
    "Do not output an animal type if it's unclear"

import model text-davinci-003 from openai.std.text

compile main:
    model text-davinci-003
    task 'identify animal speaker'

--- compiled.x ---

# Manually "compiled" from zoo.x
import type AnimalType from .zoo
require openai.std@latest
import model text-davinci-003 from openai.std.text

data samples :: (input: string, target: AnimalType | null):
"Meta generated samples"
```csv
"I'm the greatest mountain creature that headbutts people","goat"
"Meehh bleh bleh I like grass and eating","sheep"
"The king of the jungle enters the room, step aside","lion"
"I just had the most amazing fish for breakfast","penguin"
"Whatup brah","null"
```

code identify_animal_speaker :: (input: string) -> AnimalType | null:
```bpl
pragma(model=context["text-davinci-003"])
pragma(temperature=0.5, max_tokens=600)
"Classify the given input text by the animal type of the author.\n"
"The possible animal types are:\n"
for animal_type in AnimalType:
    " - \"{animal_type: AnimalType}\": \"{animal_type.description}\"\n"
"Output \"null\" as the animal type if it's unclear which one it is.\n"
"Some fun examples:\n"
for sample in samples:
    # aliased here because bpl parser can't grok nested brackets yet
    sample_input = sample['input']
    sample_target = sample['target']
    "\"{sample_input}\""
    " -> \"{sample_target}\"\n"
"\"{input}\""
" -> \"[animal_type: AnimalType]\""
return animal_type
```

# Copied from actually compiled code (with minor edits)
code 'identify animal speaker' :: (input: string) -> AnimalType | null "The type of author":
```bpl
pragma(temperature=0.5, max_tokens=1024, model=context["text-davinci-003"])
# Task metadata
"task \"identify animal speaker\"\n"
"Classify the given input text by the animal type of the author.\n"

# Task type instruction
"type of task\"identify animal speaker\n"
"input: string\n"
"output: AnimalType \"The type of author\"\n"

"type of AnimalType:\n"
"Sheep = `\"sheep\"` \"The fluffy white cloud\""
"Goat = `\"goat\"` \"The proud mountain creature\""
"HouseCat = `\"house cat\"` \"The domesticated feline\""
"Lion = `\"lion\"` \"The king of the jungle\""
"Penguin = `\"penguin\"` \"The majestic bird fish\""

# Task inference
"\"input\": {input}\n"
"\"output\": [output: AnimalType]\n"
```
