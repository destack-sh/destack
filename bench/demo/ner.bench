--- main.instruct ---
# Describe what to do

# type EntityType = enum:
# PER "Person"
# LOC "Location"
# ORG "Organization"
# MISC "Miscellaneous"

type Entity:
"A named entity in a text"
name: string "Canonical name of the entity"
'type': string
confidence: number | null "Confidence in the detected type"

task 'extract entities' :: (input: string) -> [EntityT]:
"Extract the distinct entities from the text"
#    var type EntityT :: Entity

# Build
require openai.stdlib@latest

compile prod:
    task 'extract entities'

run ner-prod:
    with compile target = compile prod
    task 'extract entities'