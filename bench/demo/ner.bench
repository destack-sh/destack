--- lib.instruct ---
# EntityType should really be an enum
type EntityType = string

type Entity:
"A named entity in a text"
name: string "Canonical name of the entity"
'type': EntityType
confidence: number | null "Confidence in the detected type"

    like data samples :: (name: string, 'type': EntityType):
    "Common uses of [Entity]"
    ```csv
    "Barack Obama","PER"
    "London","LOC"
    "Google","ORG"
    ```

--- main.instruct ---
# Describe what to do
import type Entity from .lib
import type EntityType from .lib

task 'extract entities' :: (input: string) -> [Entity]:
"Extract the distinct entities from the text"

# Build
require openai.std@latest
import model 'text-davinci-003' from openai.std.text

compile prod:
    task 'extract entities'
    with model 'text-davinci-003'

run ner-prod:
    with compile target = compile prod
    task 'extract entities'