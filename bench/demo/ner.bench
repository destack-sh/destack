--- project.bench ---
# Basic NER example
require openai.stdlib@latest
require symbolx.stdlib@latest

# Compilations
import task 'extract entities' from .main
import model text-davinci-003 from openai.stdlib.text

compile prod:
    with model text-davinci-003
    task 'extract entities'

# Run configurations
# run task 'extract entities' as extract-prod:
#     with compile target = compile prod
# (this doesn't work right now because compilations cannot be redefinitions)

--- main.instruct ---
schema entity:
`{ name: string, type: string }`

task 'extract entities':
`Extract the entities from the text`
    schema ner:
    `{ input: string, output: [entity] }`