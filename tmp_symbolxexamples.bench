--- CLI Assistant ---
# A basic CLI assistant that provides help and suggests completions when it is safe to do so.

enum Shell :: string:
"The CLI environment"
zsh = `"zsh"`
bash = `"bash"`
PowerShell = `"PowerShell"`

type CLICompletion:
command: string | null
followupQuestion: string | null
potentiallyUnsafe: boolean
explanation: string

task 'complete shell' :: (prompt: string, shell: Shell | null) -> CLICompletion:
"Provide a helpful completion "
    # Let's get more specific about what we want.
    expect 'complete command':
    "Output should be the complete command required to perform the given action"
    
    expect 'follow up':
    "Add a follow up question if the prompt isn't clear"
    
    expect 'safety indicator':
    "The completion should be marked as potentially unsafe if it is"
        # Add some examples here to clarify "unsafe".
        like data 'unsafe commands' :: (command: string, reason: string):
        ```jsonl
        {"reason": "Deletes everything", "command": "rm -rf .", "explanation": "Deletes everything"}
        {"reason": "Fork bomb", "command": ":(){ :|:& };:"}
        {"reason": "Fill up disk space", "command": "cat /dev/zero > bigfile.txt"}
        ```

build main:
    task 'complete shell'
    model openai.std.text.gpt-3-5-turbo


--- Copilot ---
# A simple take on GitHub's copilot that also supports suggested fixes & edits.

# ## Basic programming
# Like in programming, we can break out repeated instruction. This lets use re-compose and instruct on a higher level.
    # Here, we just break out some relevant assumptions about good outputs.
expect 'idiomatic code':
"The generated code should be idiomatic in the given language"

# ## Completions
type CodeCompletion:
'code': string
complete: string

task 'complete code' :: (precedingCode: string, language: string | null) -> CodeCompletion:
"Generate the most useful code completion"
    expect 'idiomatic code'

# ## Edits
# If we can complete code, we can make also suggest edits.
enum CodeEditType :: string:
"What kind of edit the user wants"
Fix = `"Fix"`
'Speed up' = `"Speed up"`
Condense = `"Condense"`
Document = `"Document"`

type CodeEdit:
"Suggest edit or fix to existing code"
'code': string
'type': CodeEditType

task 'suggest code edits' :: ('code': string, 'type': CodeEditType) -> CodeEdit:
"None"
    expect 'idiomatic code'

build main:
    model openai.std.text.gpt-3-5-turbo
    task 'suggest code edits'


--- Event Extraction ---
# Expanding on our NER example, we build an Event extractor.
# First, we again define some basic types, starting with some common event types.
enum EventType :: string:
Government = `"Government"`
Education = `"Education"`
Health = `"Health"`
Economy = `"Economy"`
Entertainment = `"Entertainment"`
Sport = `"Sport"`

# And the event struct, re-using the Entity instruction we already have.
type Event:
"An event that happened to some entities"
title: string
'type': .NER.EntityType | null
entities: [.NER.Entity]
otherType: string | null
    # Note that we don't _need_ to give any examples here - instruction is extrapolated and inferred, and we get to refine and clarify as needed.

# And instruct the actual task to produce the event - just one for now.
task 'extract event' :: (input: string) -> Event:
"Extract the most prominent event from the text"
    # This would be enough, but we set some additional expectations to be more specific.
    expect entailment:
    "The event should be evident from the source text"
    expect 'most important':
    "Only the most important event should be given (and only its entities)"
    
# Build it and they will come.
build main:
    task 'extract event'
    model openai.std.text.gpt-3-5-turbo

--- Knowledge Graphs ---
# **Note: This example is a work in progress.** 

# We can also get slightly fancier and start building knowledge graphs from text.

type Entity:
"Any entity"
name: string
'type': string

type Tuple:
subject: Entity
object: Entity
verb: string

task 'extract tuples' :: (input: string) -> [Tuple]:
"Extract the tuples from the given text"


--- NER ---
# ## Your basic NER
# First, we define the entity types we want.
enum EntityType :: string:
"Type of an entity"
Person = `"Person"`
Organization = `"Organization"`
Misc = `"Misc"`
Location = `"Location"`

# ## Types
# Then we define the actual Entity type we want to extract
type Entity:
"A named entity in a text"
name: string
'type': EntityType
    # We give a few examples to refine our instruction (partial is okay)
    like data samples :: (name: string, 'type': EntityType):
    "Some common uses of Entity"
    ```csv
    "Barack Obama","Person"
    "London","Location"
    "Google","Organization"
    ```

# Define the actual task using our types
# Build the task with the model we need (can be automatic)
task 'extract entities' :: (input: string) -> [Entity]:
"Extract the distinct entities from the text"
    expect 'no duplicates':
    "The entities are distinct"

build prod:
    task 'extract entities'
    model openai.std.text.gpt-3-5-turbo

# Now we can build on this instruction and get into [event extraction](/symbolx/examples#Events).

--- __implicit__ ---
require symbolx.std@latest
require openai.std@latest
