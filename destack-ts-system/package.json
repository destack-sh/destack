{
  "name": "destack-ts-system",
  "version": "2025.12.01.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bun": {
    "alias": {
      "@destack/*": "../destack-ts/src/*"
    }
  },
  "scripts": {
    "dev": "bun run --env-file ../.env.dev --env-file ../.env.dev.local src/cli/index.tsx",
    "build": "tsc",
    "test": "bun test --env-file ../.env.dev --env-file ../.env.dev.local",
    "lint": "eslint .",
    "format": "prettier --write src/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "destack": "link:destack",
    "ink": "^6.0.1",
    "meow": "^13.2.0",
    "pino": "^9.7.0",
    "pyodide": "^0.28.0",
    "temporal-polyfill": "^0.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-static-block": "^7.21.0",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/bun": "^1.2.18",
    "@types/node": "^22.16.4",
    "@types/react": "^19.1.8",
    "eslint": "^9.31.0",
    "fake-indexeddb": "^6.0.1",
    "fast-check": "^4.2.0",
    "jsdom": "^26.1.0",
    "mitata": "^1.0.34",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}