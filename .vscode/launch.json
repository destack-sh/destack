{
  "version": "0.2.0",
  "configurations": [
    // test configs
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately also interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": false
    },
    {
      // run pytest collect to debug collection issues
      "name": "test.collect",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/destack-py/venv/bin/pytest",
      "args": ["--collect-only"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
    },
    // general configs
    {
      "name": "destack.generate",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["generate"],
      "justMyCode": true
    },
  ],
}
