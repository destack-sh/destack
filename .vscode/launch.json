{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "stopOnEntry": true
        },
        {
            "name": "destack_cli_transpile",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["transpile", "--string", "import { Color } from 'destack';"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_compile",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["compile", "--file", "library/entity/src/entity/entity.ds"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
