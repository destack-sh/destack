{
  "version": "0.2.0",
  "configurations": [
    // test configs
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately also interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": true
    },
    {
      // run pytest collect to debug collection issues
      "name": "test.collect",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/venv/bin/pytest",
      "args": ["--collect-only"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
    },
    // general configs
    {
      "name": "bench.build",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["build"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.migrate.make",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["migrate", "make", "--no-downgrade"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.schema",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["instruct", "schema"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "0.0.0.0", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "0.0.0.0", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
