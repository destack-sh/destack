{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "stopOnEntry": true
        },
        {
            "name": "destack_tokei",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["tokei"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_ast",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["ast", "--string", "if y 2 else 4"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_fmt",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["fmt", "--file", "library/entity/scratch.ds"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_dir",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["dir", "--file", "library/view/view.ds"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
