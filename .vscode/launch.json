{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "60061"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DEBUG": "1"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "60062"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DEBUG": "1",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench
        "BENCH_ID": "56cf3720-e93e-4238-92c5-e14f565bc0d7",
        "CLIENT_ID": "b3e7422c-2bec-4332-ab91-71a31e0d54be",
        "CLIENT_ACCESS_TOKEN": "G16fnGUAdFoJog29iZvRSAHqSAVP8VC1KUdCUgpZbBMG",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
