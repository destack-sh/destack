{
  "version": "0.2.0",
  "configurations": [
    // test configs
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "ENVIRONMENT": "test"
      },
    },
    {
      // run pytest collect to debug collection issues
      "name": "test.collect",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["--collect-only", "destack/"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "ENVIRONMENT": "test"
      },
    },
    // general configs
    {
      "name": "destack.generate",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "module": "destack",
      "args": ["generate"],
      "justMyCode": true,
      "env": {
        "ENVIRONMENT": "development"
      },
    },  
    {
      "name": "destack.manual",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "module": "destack",
      "args": ["manual"],
      "justMyCode": true,
      "env": {
        "ENVIRONMENT": "development"
      },
    },
  ],
}
