{
  "version": "0.2.0",
  "configurations": [
    // test configs
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately also interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": false
    },
    {
      // run pytest collect to debug collection issues
      "name": "test.collect",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/venv/bin/pytest",
      "args": ["--collect-only"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
    },
    // general configs
    {
      "name": "bench.build",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["build"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "cli",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "0.0.0.0", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "0.0.0.0", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench (should probably set this in a local.env?)
        "BENCH_ID": "d52bbc09-e583-44f3-bbd7-a4893d2f45be",
        "SERVER_ID": "5555bf22-fca4-4c26-83a2-746c4b9ae386",
        "MACHINE_ID": "c6cdd5ac-a6a5-478b-8525-be49cfada62d",
        "CLIENT_TYPE": "10",
        "CLIENT_ID": "3d0ec254-7e0c-41a1-bbe2-b68dccc9d975",
        "CLIENT_ACCESS_TOKEN": "CbcRRDLLyyA5ptUWWfA6vkzivu6GsgwarV38RgP1AgL4"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
