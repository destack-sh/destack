{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "destack_lang_lex",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin", "destack_std_cli"],
        "filter": { "kind": "bin", "name": "destack_std_cli" }
      },
      "args": ["parse", "lex", "--file", "std/geometry/module.ds"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
