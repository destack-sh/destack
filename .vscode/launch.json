{
  "version": "0.2.0",
  "configurations": [
    // test configs
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately also interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": false
    },
    {
      // run pytest collect to debug collection issues
      "name": "test.collect",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/destack-py/venv/bin/pytest",
      "args": ["--collect-only"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
    },
    // general configs
    {
      "name": "destack.user.setpassword",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["user", "setpassword", "florian", "florian"],
      "justMyCode": true
    },
    {
      "name": "destack.generate",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["generate"],
      "justMyCode": true
    },
    {
      "name": "destack.generate.proto",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["generate", "--only", "proto"],
      "justMyCode": true
    },
    {
      "name": "destack.generate.language",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["generate", "--only", "language"],
      "justMyCode": true
    },
    {
      "name": "destack.migrate.make",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["migrate", "make", "--no-downgrade"],
      "justMyCode": true
    },
    {
      "name": "destack.bootstrap",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}y",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["system", "bootstrap", "--region", "eu-zurich", "--upsert"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "destack-system",
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }, 
     {
      "name": "destack.system",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["serve", "system", "--watch", "0.0.0.0", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "destack-system",
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "destack.runtime",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["serve", "runtime", "--watch", "0.0.0.0", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "destack-machine-runtime",
        "DESTACK_URL": "http://localhost:60061",
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    },
    {
      "name": "destack.machine",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/destack-py/main.py",
      "args": ["serve", "machine", "--watch", "0.0.0.0", "60063"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "destack-machine-desktop",
        "DESTACK_URL": "http://localhost:60061",
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-machine/bin/python"
    },
  ],
  "compounds": [
    {
      "name": "destack.all",
      "configurations": ["destack.system", "destack.runtime"]
    }
  ]
}
