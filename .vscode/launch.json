{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "stopOnEntry": true
        },
        {
            "name": "destack_library_cli",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_library_cli"],
                "filter": { "kind": "bin", "name": "destack_library_cli" }
            },
            "args": ["fmt", "--string", "1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_extension_lsp",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_extension_lsp"],
                "filter": { "kind": "bin", "name": "destack_extension_lsp" }
            },
            "args": ["lsp"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
