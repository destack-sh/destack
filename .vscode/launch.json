{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "stopOnEntry": true
        },
        {
            "name": "destack_cli_transpile",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["transpile", "--string", "import { Color } from 'destack';"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_compile",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["compile", "--string", "import { Gradient, Image } from 'destack-ui';"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_cli_resolve",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin", "destack_cli"],
                "filter": { "kind": "bin", "name": "destack_cli" }
            },
            "args": ["resolve", "zod"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_test_smoke",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--test", "smoke", "--package", "destack_test", "--no-run"],
                "filter": { "kind": "test", "name": "smoke" }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "destack_test_formatter",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--test", "formatter", "--package", "destack_test", "--no-run"],
                "filter": { "kind": "test", "name": "formatter" }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
