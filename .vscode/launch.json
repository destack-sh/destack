{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "50051"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DEBUG": "1"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "50052"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DEBUG": "1",
        "SUPERVISOR_URL": "http://localhost:50051",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
