{
  "version": "0.2.0",
  "configurations": [
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": false
    },
    // general configs
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench (should probably set this in a local.env?)
        "BENCH_ID": "fa491f38-3514-4365-b781-bfe3f6d6cc00",
        "MACHINE_ID": "00d42d4c-757c-4458-8aac-f0270b768dce",
        "CLIENT_TYPE": "10",
        "CLIENT_ID": "83d7dc96-c75a-4a8b-ace6-bc8faf51bdbb",
        "CLIENT_ACCESS_TOKEN": "HqHhGbvPXoYMPU6WkhDWd4Dtq9pJcnqWqUM6ipd2gG86"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
