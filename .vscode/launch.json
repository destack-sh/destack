{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "destack_language_lexer",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin", "destack_library_cli"],
        "filter": { "kind": "bin", "name": "destack_library_cli" }
      },
      "args": ["parse", "lex", "--file", "library/geometry/module.ds"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
