{
  "version": "0.2.0",
  "configurations": [
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    // general configs
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench (should probably set this in a local.env?)
        "BENCH_ID": "ec2dfb64-bd9b-4264-905b-7e8fcfa49f82",
        "MACHINE_ID": "942c9bcc-161f-49cc-9368-5c1877ecbc96",
        "CLIENT_TYPE": "10",
        "CLIENT_ID": "6299c3c5-cb9e-4de3-a856-f7512158df0c",
        "CLIENT_ACCESS_TOKEN": "2ZuD945EP6QaJdXQNmJ6wW934zby8UrLLcUzK2xoF6bc"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
