{
  "version": "0.2.0",
  "configurations": [
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    // general configs
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench (should probably set this in a local.env?)
        "BENCH_ID": "56cf3720-e93e-4238-92c5-e14f565bc0d7",
        "CLIENT_TYPE": "10",
        "CLIENT_ID": "b81d8261-d738-4ed9-adda-84cfa844a601",
        "CLIENT_ACCESS_TOKEN": "ABqEoQRK9ACknUShfNUdcYBjHKvUkc7d7Jt2p88pJiPY"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
