{
  "version": "0.2.0",
  "configurations": [
    // NOTE: custom test config is useful for stepping into library code during tests
    //   but unfortunately interferes with the pytest runner output (it's just blank)
    {
      "name": "python.debug.tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "env": {
        "PYTEST_ADDOPTS": "--no-cov",
      },
      "justMyCode": false
    },
    // general configs
    {
      "name": "bench.system",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "system", "--watch", "127.0.0.1", "60061"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "system",
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "bench.runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench.py",
      "args": ["serve", "runtime", "--watch", "127.0.0.1", "60062"],
      "env": {
        "ENVIRONMENT": "dev",
        "PYTHONUNBUFFERED": "1",
        "SERVICE_NAME": "runtime",
        "SUPERVISOR_URL": "http://localhost:60061",
        // this is the 'test' bench (should probably set this in a local.env?)
        "BENCH_ID": "77c37dca-8c9a-4952-ac0f-63fb464d4e28",
        "MACHINE_ID": "afe89c4d-13a3-492f-80e1-ef217552b2f6",
        "CLIENT_TYPE": "10",
        "CLIENT_ID": "a762b429-a8ec-40db-a0e5-517e3f4e52c3",
        "CLIENT_ACCESS_TOKEN": "5s3CB8ZMivGgH1Uy21xEWfnw6HUV5MVQvjVQbTbyw8Jz"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "${workspaceFolder}/venv-runtime/bin/python"
    }, 
  ],
  "compounds": [
    {
      "name": "bench.all",
      "configurations": ["bench.system", "bench.runtime"]
    }
  ]
}
