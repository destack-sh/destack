{
    "name": "@platform/pricing",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Price Destack: its plans and the features they grant, the units its usage is billed in, and the list prices of the providers it runs on.",
    "exports": {
        ".": "./src/index.ts",
        "./cloudflare": "./src/vendor/cloudflare.ts",
        "./hetzner": "./src/vendor/hetzner.ts",
        "./destack.json": "./destack.json"
    },
    "scripts": {
        "typecheck": "destack-check readme && tsc --project tsconfig.json",
        "refresh": "bun run scripts/refresh.ts"
    },
    "dependencies": {
        "@destack/account": "workspace:*",
        "@destack/finance": "workspace:*",
        "@destack/locale": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/stack": "workspace:*"
    },
    "devDependencies": {
        "@destack/environment": "workspace:*",
        "@types/bun": "1.4.4"
    }
}
