{
    "name": "@platform/pricing",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "description": "Destack's plans and units, the features its plans grant, and the list prices of the providers it runs on.",
    "exports": {
