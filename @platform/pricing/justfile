set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# typecheck
typecheck:
    bun run typecheck

# lint
lint:
    bun run destack-check check src tests scripts vitest.config.ts README.md

# check formatting
format-check:
    bun run destack-check format-check src tests scripts vitest.config.ts package.json destack.json

# typecheck, lint and check formatting
check: typecheck lint format-check

# test
test:
    bun run test

# read every vendor's list prices from its catalog and rewrite the vendor modules
refresh *vendors:
    bun run refresh {{vendors}}

# print each unit's price beside its cost and the hyperscalers' prices on its meter
compare:
    bun run compare

# format
format *args:
    bun run destack-check format {{args}} src tests scripts vitest.config.ts package.json destack.json
