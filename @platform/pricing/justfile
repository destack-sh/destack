set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# typecheck
typecheck:
    bun run typecheck

# lint
lint:
    bun run destack-check check src scripts README.md

# check formatting
format-check:
    bun run destack-check format-check src scripts package.json destack.json

# typecheck, lint and check formatting
check: typecheck lint format-check

# read Cloudflare's list prices from its docs and rewrite its module
refresh:
    bun run refresh

# format
format *args:
    bun run destack-check format {{args}} src scripts package.json destack.json
