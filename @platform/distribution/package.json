{
    "name": "@platform/distribution",
    "type": "module",
    "description": "Ship Destack: build, sign and publish the desktop, the CLI and the machine as one distribution, with the first-party releases it bundles.",
    "exports": {
        ".": "./src/index.ts",
        "./catalog": "./src/distribution/catalog.ts"
    },
    "scripts": {
        "build": "bun run src/main.ts distribution build",
        "pack": "bun run src/main.ts distribution pack",
        "icon": "bun run src/main.ts distribution icon",
        "installer": "bun run src/main.ts installer build",
        "sign": "bun run src/main.ts update sign",
        "publish": "bun run --env-file=../../.env.local src/main.ts update publish",
        "refresh": "bun run src/main.ts update renew",
        "release": "gh workflow run release.yml --ref main"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20260917.1",
        "@destack/sandbox": "workspace:*",
        "@destack/test": "workspace:*",
        "@types/bun": "1.4.4",
        "miniflare": "4.20260730.0"
    },
    "dependencies": {
        "@destack/access": "workspace:*",
        "@destack/account": "workspace:*",
        "@destack/bucket": "workspace:*",
        "@destack/build": "workspace:*",
        "@destack/check": "workspace:*",
        "@destack/connection": "workspace:*",
        "@destack/db": "workspace:*",
        "@destack/desktop": "workspace:*",
        "@destack/environment": "workspace:*",
        "@destack/finance": "workspace:*",
        "@destack/forge": "workspace:*",
        "@destack/identity": "workspace:*",
        "@destack/machine": "workspace:*",
        "@destack/mail": "workspace:*",
        "@destack/message": "workspace:*",
        "@destack/notification": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/observability": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/registry": "workspace:*",
        "@destack/relay": "workspace:*",
        "@destack/resource": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/setting": "workspace:*",
        "@destack/social": "workspace:*",
        "@destack/stack": "workspace:*",
        "@destack/sync": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/universe": "workspace:*",
        "@destack/update": "workspace:*",
        "@destack/vault": "workspace:*",
        "@destack/view": "workspace:*",
        "@platform/brand": "workspace:*",
        "@platform/pricing": "workspace:*",
        "@platform/stack": "workspace:*",
        "@tufjs/canonical-json": "2.0.0",
        "@tufjs/models": "5.0.0",
        "magic-string": "1.4.1",
        "reflect-metadata": "0.2.2",
        "rolldown": "1.3.3",
        "tuf-js": "6.0.0",
        "wrangler": "4.158.0"
    }
}
