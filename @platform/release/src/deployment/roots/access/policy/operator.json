{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IdentityRead",
            "Effect": "Allow",
            "Action": ["iam:Get*", "iam:List*"],
            "Resource": "*"
        },
        {
            "Sid": "WorkerUserBounded",
            "Effect": "Allow",
            "Action": "iam:CreateUser",
            "Resource": "arn:aws:iam::${account}:user/destack-*",
            "Condition": {
                "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::${account}:policy/destack-worker-boundary" }
            }
        },
        {
            "Sid": "WorkerUserMaintained",
            "Effect": "Allow",
            "Action": [
                "iam:PutUserPolicy",
                "iam:DeleteUserPolicy",
                "iam:CreateAccessKey",
                "iam:DeleteAccessKey",
                "iam:DeleteUser",
                "iam:TagUser",
                "iam:UntagUser"
            ],
            "Resource": "arn:aws:iam::${account}:user/destack-*"
        },
        {
            "Sid": "BoundariesFixed",
            "Effect": "Deny",
            "Action": [
                "iam:PutUserPermissionsBoundary",
                "iam:DeleteUserPermissionsBoundary",
                "iam:AttachUserPolicy",
                "iam:AddUserToGroup",
                "iam:CreatePolicyVersion",
                "iam:SetDefaultPolicyVersion",
                "iam:DeletePolicy",
                "iam:DeletePolicyVersion"
            ],
            "Resource": "*"
        }
    ]
}
