{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IdentityRead",
            "Effect": "Allow",
            "Action": ["iam:Get*", "iam:List*"],
            "Resource": "*"
        },
        {
            "Sid": "IdentityUntouched",
            "Effect": "Deny",
            "NotAction": ["iam:Get*", "iam:List*", "iam:CreateServiceLinkedRole"],
            "Resource": "arn:aws:iam::${account}:*"
        },
        {
            "Sid": "RootKeysUntouched",
            "Effect": "Deny",
            "Action": [
                "kms:CreateKey",
                "kms:PutKeyPolicy",
                "kms:ReplicateKey",
                "kms:CreateGrant",
                "kms:DisableKey",
                "kms:ScheduleKeyDeletion",
                "kms:UpdatePrimaryRegion",
                "kms:CreateAlias",
                "kms:UpdateAlias",
                "kms:DeleteAlias",
                "kms:TagResource",
                "kms:UntagResource"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DataKept",
            "Effect": "Deny",
            "Action": ["rds:DeleteDBInstance", "rds:DeleteDBSnapshot", "s3:DeleteBucket"],
            "Resource": "*"
        }
    ]
}
