{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SendDestackMail",
            "Effect": "Allow",
            "Action": ["ses:SendEmail", "ses:SendRawEmail"],
            "Resource": [
                "arn:aws:ses:eu-central-1:${account}:identity/destack.app",
                "arn:aws:ses:eu-central-1:${account}:configuration-set/destack-mail"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "eu-central-1"
                }
            }
        }
    ]
}
