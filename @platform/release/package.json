        "@destack/service": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/package": "workspace:*",
        "rolldown": "1.2.9",
        "magic-string": "1.4.1",
        "@opentui/solid": "0.5.12",
        "@tufjs/models": "5.0.0",
        "tuf-js": "6.0.0",
        "@destack/build": "workspace:*",
