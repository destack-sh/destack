set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

bun := env("DESTACK_BUN", "bun")

_default:
    @just --list --unsorted

# typecheck
typecheck:
    {{bun}} run typecheck

# lint
lint:
    {{bun}} run destack-check check src vitest.config.ts README.md

# check formatting
format-check:
    {{bun}} run destack-check format-check src vitest.config.ts package.json destack.json

# typecheck, lint and check formatting
check: typecheck lint format-check

# test
test:
    {{bun}} run test

# format
format *args:
    {{bun}} run destack-check format {{args}} src vitest.config.ts package.json destack.json

# build
build target="":
    {{bun}} run src/distribution/build.ts {{target}}

# pack
pack target="":
    {{bun}} run src/distribution/pack.ts {{target}}

# build application icons
icon *args:
    {{bun}} run src/icon/icon.ts {{args}}

# installer
installer name="universal-apple-darwin":
    {{bun}} run src/installer/build.ts {{name}}

# verify a native archive with disposable signing keys
rehearse version archive:
    {{bun}} run src/distribution/rehearse.ts "{{version}}" "{{archive}}"

# sign
sign +targets:
    {{bun}} run src/repository/sign.ts {{targets}}

# publish
publish directory="dist/update":
    {{bun}} run --env-file=../../.env.local src/repository/upload.ts {{directory}}

# refresh
refresh:
    {{bun}} run src/repository/renew.ts
