{
    "name": "@platform/site",
    "private": true,
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "Destack website, documentation, and blog",
    "exports": {
        ".": "./src/view/view.ts"
    },
    "scripts": {
        "build": "bun run generate && bun run build/main.ts build",
        "check": "bun run typecheck && bun run lint && bun run format-check && bun run test && bun run build",
        "dev": "bun run generate && bun run build/main.ts dev",
        "format": "destack-check format src build scripts content.ts",
        "format-check": "destack-check format-check src build scripts content.ts",
        "lint": "destack-check check src build scripts content.ts",
        "test": "bun run scripts/test-highlighting.ts && bun run scripts/test-markdown.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p build/tsconfig.json --noEmit",
        "generate": "bun run scripts/generate-release.ts && bun run scripts/generate-pricing.ts && bun run scripts/generate-headword.ts"
    },
    "dependencies": {
        "@destack/environment": "workspace:*",
        "@destack/icon": "workspace:*",
        "@destack/object": "workspace:*",
        "@destack/package": "workspace:*",
        "@destack/schema": "workspace:*",
        "@destack/shader": "workspace:*",
        "@destack/style": "workspace:*",
        "@destack/telemetry": "workspace:*",
        "@destack/theme": "workspace:*",
        "@destack/ui": "workspace:*",
        "@destack/view": "workspace:*",
        "@fontsource-variable/ibm-plex-sans": "5.3.0",
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/ibm-plex-sans-condensed": "5.3.0",
        "@fontsource/limelight": "5.3.0",
        "@platform/brand": "workspace:*",
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "highlight.js": "11.11.1",
        "lowlight": "3.3.0",
        "mermaid": "12.0.0",
        "remark-directive": "4.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "solid-js": "2.0.0-rc.8",
        "unified": "11.0.5"
    },
    "devDependencies": {
        "@destack/build": "workspace:*",
        "@destack/check": "workspace:*",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@platform/pricing": "workspace:*",
        "fontkitten": "1.0.3",
        "vite": "8.3.0"
    }
}
