{
    "name": "@destack/site",
    "private": true,
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "Destack website, documentation, and blog",
    "scripts": {
        "build": "bun run generate && bun run build/main.ts build",
        "check": "bun run typecheck && bun run test && bun run build",
        "dev": "bun run generate && bun run build/main.ts dev",
        "format": "echo \"No site formatter defined\"",
        "test": "bun run scripts/test-highlighting.ts && bun run scripts/test-listing.ts && bun run scripts/test-presentation.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p build/tsconfig.json --noEmit",
        "generate": "bun run scripts/sync-assets.ts && bun run scripts/generate-release.ts && bun run scripts/generate-content.ts"
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "5.3.0",
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/ibm-plex-sans-condensed": "5.3.0",
        "@fontsource/limelight": "5.3.0",
        "marked": "^18.0.4",
        "mermaid": "12.0.0",
        "@destack/view": "workspace:*",
        "@destack/signals": "workspace:*",
        "@destack/style": "workspace:*",
        "@destack/theme": "workspace:*"
    },
    "devDependencies": {
        "@destack/check": "workspace:*",
        "wrangler": "4.134.0",
        "highlight.js": "11.11.1",
        "@destack/build": "workspace:*",
        "vite": "8.3.0"
    }
}
