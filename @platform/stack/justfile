set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# typecheck
typecheck:
    bun run typecheck

# lint
lint:
    bun run destack-check check src README.md

# check formatting
format-check:
    bun run destack-check format-check src

# typecheck, lint and check formatting
check: typecheck lint format-check

# format
format:
    bun run destack-check format src
