set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# typecheck
typecheck:
    bun run typecheck

# lint
lint:
    bun run destack-check check generate.ts README.md

# check formatting
format-check:
    bun run destack-check format-check generate.ts package.json

# typecheck, lint and check formatting
check: typecheck lint format-check

# format
format *args:
    bun run destack-check format {{args}} generate.ts package.json
