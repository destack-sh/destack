{
    "name": "@platform/brand",
    "version": "2026.11.0",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "description": "Draw Destack's brand: its mark, wordmarks, app icons, favicons and social banners.",
    "exports": {
        "./mark.svg": "./mark.svg",
        "./icon/*": "./icon/*",
        "./favicon/*": "./favicon/*",
        "./banner/*": "./banner/*",
        "./wordmark/*": "./wordmark/*"
    },
    "scripts": {
        "generate": "bun run generate.ts",
        "typecheck": "tsc --project tsconfig.json"
    },
    "devDependencies": {
        "@destack/environment": "workspace:*",
        "@types/bun": "1.4.4"
    }
}
