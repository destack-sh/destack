CLOUD=private
REGION=eu-zurich
LOG_LEVEL=TRACE
LOG_MODE=PLAIN
TRACING=1
TRACE_LOCKS=0
OTLP_ENDPOINT="http://localhost:4317"
SERVICE_NAME="test"
TEST_PROFILE=default

# Sharding
CELL_MAP="eu-zurich/test-0=127.0.0.1"
GLOBAL_DATABASE_URL="postgresql://bench:bench@127.0.0.1:5432/bench-global"
DATABASE_MAP="eu-zurich/test-0/db-1=postgresql://bench:bench@127.0.0.1:5432/bench-db-1"

# S3
S3_REGION="eu-central-1"
S3_ENDPOINT="http://localhost:19000"
S3_ACCESS_KEY="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_KEY="UKht5CaJPQ5ZCaAsfFY52URhg7RWv8V2489e9qSpoAhJRw97gttSBkEWU65wtGz"

# Computer
KUBERNETES_KUBECONFIG_PATH=~/.kube/config
