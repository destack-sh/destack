{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "noUncheckedSideEffectImports": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "lib": [
            "ES2024",
            "ESNext.Array",
            "ESNext.TypedArrays",
            "ES2025.Collection",
            "ES2025.Promise",
            "ES2025.RegExp",
            "ESNext.Disposable"
        ],
        "types": ["bun"]
    },
    "include": ["**/*"],
    "exclude": [
        "node_modules",
        "dist",
        "target",
        "coverage",
        "out",
        "@destack/access",
        "@destack/account",
        "@destack/bucket",
        "@destack/build",
        "@destack/check",
        "@destack/cli",
        "@destack/connection",
        "@destack/control",
        "@destack/db",
        "@destack/desktop",
        "@destack/environment",
        "@destack/error",
        "@destack/event",
        "@destack/finance",
        "@destack/forge",
        "@destack/git",
        "@destack/home",
        "@destack/icon",
        "@destack/identity",
        "@destack/locale",
        "@destack/machine",
        "@destack/mail",
        "@destack/message",
        "@destack/notification",
        "@destack/object",
        "@destack/observability",
        "@destack/package",
        "@destack/registry",
        "@destack/relay",
        "@destack/resource",
        "@destack/sandbox",
        "@destack/schema",
        "@destack/setting",
        "@destack/shader",
        "@destack/social",
        "@destack/stack",
        "@destack/style",
        "@destack/sync",
        "@destack/telemetry",
        "@destack/template-blank",
        "@destack/template-stack",
        "@destack/template-tasks",
        "@destack/test",
        "@destack/theme",
        "@destack/tunnel",
        "@destack/ui",
        "@destack/update",
        "@destack/vault",
        "@destack/view",
        "@destack/workflow",
        "@platform/brand",
        "@platform/pricing",
        "@platform/release",
        "@platform/site",
        "@platform/stack"
    ]
}
