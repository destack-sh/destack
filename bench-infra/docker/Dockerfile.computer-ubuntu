FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source=https://github.com/symbolx/bench
LABEL org.opencontainers.image.description="Bench"

#
# OS
#

# install libraries
RUN apt-get update && apt-get install -y \
    cmake \
    curl \
    dbus \
    dbus-x11 \
    evince \
    ffmpeg \
    g++ \
    gcc \
    gfortran \
    git \
    imagemagick \
    liblapack-dev \
    libopenblas-dev \
    libpq-dev \
    libsm6 \
    libxext6 \
    libxml2-dev \
    libxslt-dev \
    libzbar-dev \
    libreoffice \
    mousepad \
    netcat-openbsd \
    novnc \
    jupyter \
    p7zip-full \
    pkg-config \
    policykit-1 \
    postgresql-client \
    software-properties-common \
    sudo \
    thunar \
    unzip \
    websockify \
    wget \
    x11-apps \
    x11vnc \
    xdotool \
    xfce4 \
    xfce4-goodies \
    xfce4-terminal \
    xvfb && \
    curl -fsSL https://get.docker.com -o /tmp/get-docker.sh && \
    chmod 700 /tmp/get-docker.sh && \
    /tmp/get-docker.sh

# install Python 3.13
RUN add-apt-repository ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y python3.13 python3.13-dev \
 && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.13 

# cleanup
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# install uv globally
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && mv /root/.local/bin/uv /usr/local/bin/ && rm /uv-installer.sh
ENV PATH="/usr/local/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# remove GNOME keyring
RUN apt-get remove -y gnome-keyring

#
# Users
#

RUN useradd -ms /bin/bash bench-system && \
    useradd -ms /bin/bash bench-user && \
    echo "bench-user ALL=(root) NOPASSWD: /usr/bin/apt-get install *, /usr/bin/apt-get update" >> /etc/sudoers
RUN chown -R bench-system:bench-system /home/bench-system
RUN chown -R bench-user:bench-user /home/bench-user

#
# Python packages (installed system-wide by privileged user)
#

COPY --chown=bench-system:bench-system bench/requirements/computer.txt bench/requirements.txt
RUN uv pip install --system --python python3.13 --no-cache -r bench/requirements.txt

# disable screensaver
RUN apt-get remove -y xscreensaver light-locker xfce4-screensaver

#
# Chrome
#

# install Chromium
RUN add-apt-repository ppa:xtradeb/apps -y
RUN apt-get update
RUN apt-get install -y chromium

# install uBlock Origin extension
RUN mkdir -p /usr/lib/chromium/extensions/ublock && \
    curl -sSL https://github.com/uBlockOrigin/uBOL-home/releases/download/uBOLite_2025.4.1.700/uBOLite_2025.4.1.700.chromium.mv3.zip -o ublock.zip && \
    unzip -q ublock.zip -d /tmp/ublock-ext && \
    mv /tmp/ublock-ext/* /usr/lib/chromium/extensions/ublock && \
    chown -R bench-user:bench-user /usr/lib/chromium/extensions/ublock && \
    rm -rf /tmp/ublock-ext ublock.zip

# create chrome profile with pre-approved uBlock Origin Lite (no popups)
RUN mkdir -p /tmp/chrome-profile/Default && \
    cat <<'EOF' > /tmp/chrome-profile/Default/Preferences
{
  "intl": {
    "accept_languages": "en-US,en",
    "selected_languages": "en-US,en"
  },
  "bookmark_bar": {
    "show_on_all_tabs": false
  },
  "extensions": {
    "settings": {
      "kmkbmpjakngkkahilgegpddnmicjhjei": {
        "active_permissions": {
          "api": [
            "activeTab",
            "storage",
            "declarativeNetRequest",
            "declarativeNetRequestFeedback",
            "scripting"
          ],
          "explicit_host": ["<all_urls>"],
          "explicit_host_permissions": ["<all_urls>"],
          "manifest_permissions": [],
          "scriptable_host": []
        },
        "granted_permissions": {
          "api": [
            "activeTab",
            "storage",
            "declarativeNetRequest",
            "declarativeNetRequestFeedback",
            "scripting"
          ],
          "explicit_host": ["<all_urls>"],
          "explicit_host_permissions": ["<all_urls>"],
          "manifest_permissions": [],
          "scriptable_host": []
        },
        "state": 1,
        "was_installed_by_default": true,
        "from_webstore": false,
        "location": 8,
        "path": "/usr/lib/chromium/extensions/ublock",
        "manifest": {
          "name": "uBlock Origin Lite",
          "version": "2025.4.1.700"
        },
        "withholding_permissions": false
      }
    }
  }
}
EOF
RUN chown -R bench-user:bench-user /tmp/chrome-profile

# create chromium launcher wrapper and disable bookmarks bar
RUN cat <<'EOF' > /usr/local/bin/chromium
#!/bin/sh
export DISPLAY=:99
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p "$XDG_RUNTIME_DIR"
exec /usr/bin/chromium \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-software-rasterizer \
  --disable-default-apps \
  --disable-translate \
  --disable-features=TranslateUI \
  --disable-background-networking \
  --disable-sync \
  --metrics-recording-only \
  --disable-component-update \
  --disable-domain-reliability \
  --safebrowsing-disable-auto-update \
  --disable-client-side-phishing-detection \
  --disable-notifications \
  --disable-prompt-on-repost \
  --disable-infobars \
  --no-service-autorun \
  --no-first-run \
  --disable-component-update \
  --start-maximized \
  --user-data-dir=/tmp/chrome-profile \
  --load-extension=/usr/lib/chromium/extensions/ublock \
  "$@" >> /tmp/chromium.log 2>&1
EOF
RUN chmod +x /usr/local/bin/chromium

# create Chromium desktop icon
RUN mkdir -p /home/bench-user/Desktop && \
    cat <<'EOF' > /home/bench-user/Desktop/chromium.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium
Exec=chromium
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
EOF
RUN chmod +x /home/bench-user/Desktop/chromium.desktop && chown bench-user:bench-user /home/bench-user/Desktop/chromium.desktop

# make Chromium default browser
RUN update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/local/bin/chromium 200 && \
    update-alternatives --set x-www-browser /usr/local/bin/chromium
RUN mkdir -p /home/bench-user/.config/xfce4/helpers && \
    echo "WebBrowser=chromium" > /home/bench-user/.config/xfce4/helpers.rc && \
    chown -R bench-user:bench-user /home/bench-user/.config/xfce4

#
# Bench
#

# copy source code (privileged only)
COPY --chown=bench-system:bench-system bench.py /home/bench-system/
COPY --chown=bench-system:bench-system pyproject.toml /home/bench-system/
COPY --chown=bench-system:bench-system version /home/bench-system/
COPY --chown=bench-system:bench-system bench/ /home/bench-system/bench/
# prune unnecessary files
RUN rm -rf /home/bench-system/bench/system /home/bench-system/bench/test /home/bench-system/bench/runtime
RUN find /home/bench-system/bench/ -type f -name 'test_*.py' -delete
RUN chmod -R 700 /home/bench-system

#
# Startup
#

# startup script (runs GUI as bench-user, backend as bench-system)
RUN cat <<'EOF' > /start.sh
#!/bin/sh
# display setup
export DISPLAY=:99
Xvfb :99 -screen 0 "$DISPLAY_SIZE" &
until xdpyinfo -display :99 >/dev/null 2>&1; do sleep 0.1; done
# dbus
mkdir -p /var/run/dbus
dbus-daemon --system --fork
# vnc
x11vnc -passwd bench -shared -display :99 -forever -listen 0.0.0.0 -rfbport 5900 &
until nc -z localhost 5900; do sleep 0.1; done
# websockify
websockify -D 6080 localhost:5900
# user
mkdir -p /tmp/runtime-bench-user
chown bench-user:bench-user /tmp/runtime-bench-user
su bench-user -s /bin/bash -c '
  export DISPLAY=:99
  export XDG_RUNTIME_DIR=/tmp/runtime-bench-user
  eval $(dbus-launch --sh-syntax)
  xfce4-session &
'
# system
su bench-system -s /bin/bash -m -c "DISPLAY=:99 python3.13 /home/bench-system/bench.py serve computer 0.0.0.0 5432"
EOF
RUN chmod +x /start.sh

# (start as root, but we switch to users in start script)
USER root 
WORKDIR /home/bench-system

CMD ["/start.sh"]

ARG GIT_COMMIT
ARG VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV VERSION=$VERSION
ENV DISPLAY_SIZE="1280x960x24"

ENV DESKTOP_SESSION=xfce
ENV XDG_CURRENT_DESKTOP=XFCE

EXPOSE 5900 5432 6080
