FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source=https://github.com/symbolx/bench
LABEL org.opencontainers.image.description="Bench"

# install libs
RUN apt-get update && apt-get install -y \
    netcat \
    xfce4 \
    xfce4-goodies \
    x11vnc \
    xvfb \
    xdotool \
    imagemagick \
    x11-apps \
    sudo \
    software-properties-common \
    libpq-dev \
    libzbar-dev \
    postgresql-client \
    ffmpeg \
    gcc \
    gfortran \
    g++ \
    pkg-config \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libxml2-dev \
    libxslt-dev \
    git \
    curl \
    libreoffice \
    thunar \
    evince \
    mousepad \
    xfce4-terminal \
    websockify \
    novnc \
 && apt-get remove -y light-locker xfce4-screensaver xfce4-power-manager || true \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# install Chromium browser with extensions and fonts
RUN apt-get update && apt-get install -y \
    chromium-browser \
    chromium-chromedriver \
    fonts-freefont-ttf \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto \
    libgbm-dev \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libx11-xcb1 \
    libxtst6 \
    unzip \
    --no-install-recommends \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# install uBlock Origin extension correctly
RUN mkdir -p /usr/lib/chromium/extensions/ublock \
 && curl -sSL https://github.com/gorhill/uBlock/releases/download/1.63.2/uBlock0_1.63.2.chromium.zip -o ublock.zip \
 && unzip ublock.zip -d /usr/lib/chromium/extensions/ublock \
 && rm ublock.zip

# add 'chromium' command
RUN echo '#!/bin/sh\nexec chromium-browser --no-sandbox --disable-dev-shm-usage --load-extension=/usr/lib/chromium/extensions/ublock "$@"' \
    > /usr/local/bin/chromium && chmod +x /usr/local/bin/chromium

# create XFCE autostart entry for Chromium
RUN mkdir -p /etc/xdg/autostart && \
    echo '[Desktop Entry]\nType=Application\nExec=chromium\nHidden=false\nNoDisplay=false\nX-GNOME-Autostart-enabled=true\nName=Chromium' \
    > /etc/xdg/autostart/chromium.desktop

# install Python 3.13
RUN add-apt-repository ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y python3.13 python3.13-dev \
 && rm -f /usr/bin/python3 \
 && ln -s /usr/bin/python3.13 /usr/bin/python3 \
 && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.13 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# install uv globally
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && mv /root/.local/bin/uv /usr/local/bin/ && rm /uv-installer.sh
ENV PATH="/usr/local/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# python harness (install packages as root)
COPY bench/requirements/computer.txt bench/requirements.txt
RUN uv pip install --system --python python3.13 --no-cache -r bench/requirements.txt

# explicitly create and set permissions on /tmp/.X11-unix
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# create non-root user
RUN useradd -ms /bin/bash bench \
    && echo "bench ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
USER bench
WORKDIR /home/bench

# copy application files
COPY --chown=bench:bench bench.py .
COPY --chown=bench:bench pyproject.toml .
COPY --chown=bench:bench version .
COPY --chown=bench:bench bench/__init__.py bench/__init__.py
# TODO :Security!: narrow down bench/language import for computer somehow 
# (unfortunately we need to import proto service stuff, maybe we can factor that out?)
COPY --chown=bench:bench bench/language bench/language
COPY --chown=bench:bench bench/computer bench/computer
COPY --chown=bench:bench bench/utils bench/utils
COPY --chown=bench:bench bench/cli bench/cli
COPY --chown=bench:bench bench/proto bench/proto
COPY --chown=bench:bench bench/pb2 bench/pb2

# set x11vnc password ("bench")
RUN x11vnc -storepasswd bench /home/bench/.vncpass

# run Xvfb, x11vnc, websockify, Xfce (no login manager)
CMD ["/bin/sh", "-c", "\
export DISPLAY=:99 && \
Xvfb :99 -screen 0 1280x800x24 & \
until xdpyinfo -display :99 >/dev/null 2>&1; do \
  sleep 0.1; \
done && \
x11vnc -display :99 -forever -rfbauth /home/bench/.vncpass -listen 127.0.0.1 -rfbport 5900 & \
until nc -z localhost 5900; do \
  sleep 0.1; \
done && \
DISPLAY=:99 xfce4-session & \
websockify --web=/usr/share/novnc 6080 localhost:5900 & \
exec python3 bench.py serve computer 0.0.0.0 5432"]

ARG GIT_COMMIT
ARG VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV VERSION=$VERSION

EXPOSE 5900 5432 6080