FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source=https://github.com/symbolx/bench
LABEL org.opencontainers.image.description="Bench"

# install libs
RUN apt-get update && apt-get install -y \
    xfce4 \
    xfce4-goodies \
    x11vnc \
    xvfb \
    xdotool \
    imagemagick \
    x11-apps \
    sudo \
    software-properties-common \
    libpq-dev \
    libzbar-dev \
    postgresql-client \
    ffmpeg \
    gcc \
    gfortran \
    g++ \
    pkg-config \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libxml2-dev \
    libxslt-dev \
    git \
    curl \
 && apt-get remove -y light-locker xfce4-screensaver xfce4-power-manager || true \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# add the mozillateam PPA and install Firefox ESR
RUN add-apt-repository ppa:mozillateam/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends firefox-esr \
 && update-alternatives --set x-www-browser /usr/bin/firefox-esr \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# install Python 3.13
RUN add-apt-repository ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y python3.13 python3.13-dev \
 && rm -f /usr/bin/python3 \
 && ln -s /usr/bin/python3.13 /usr/bin/python3 \
 && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.13 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# install uv globally
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && mv /root/.local/bin/uv /usr/local/bin/ && rm /uv-installer.sh
ENV PATH="/usr/local/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# python harness (install packages as root)
COPY bench/requirements/computer.txt bench/requirements.txt
RUN uv pip install --system --python python3.13 --no-cache -r bench/requirements.txt

# create non-root user
RUN useradd -ms /bin/bash bench \
    && echo "bench ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER bench
WORKDIR /home/bench

# copy application files
COPY --chown=bench:bench bench.py .
COPY --chown=bench:bench pyproject.toml .
COPY --chown=bench:bench version .
COPY --chown=bench:bench bench/__init__.py bench/__init__.py
COPY --chown=bench:bench bench/language/core/const.py bench/language/core/const.py
COPY --chown=bench:bench bench/utils bench/utils
COPY --chown=bench:bench bench/cli bench/cli
COPY --chown=bench:bench bench/proto bench/proto
COPY --chown=bench:bench bench/pb2 bench/pb2

# set x11vnc password ("bench")
RUN x11vnc -storepasswd bench /home/bench/.vncpass

# run Xvfb, x11vnc, Xfce (no login manager)
CMD ["/bin/sh", "-c", "\
Xvfb :99 -screen 0 1280x800x24 >/dev/null 2>&1 & \
x11vnc -display :99 -forever -rfbauth /home/bench/.vncpass -listen 0.0.0.0 -rfbport 5900 >/dev/null 2>&1 & \
export DISPLAY=:99 && \
startxfce4 >/dev/null 2>&1 & \
python3 bench.py serve computer 0.0.0.0 5432"]

ARG GIT_COMMIT
ARG VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV VERSION=$VERSION 

EXPOSE 5900
EXPOSE 5432
