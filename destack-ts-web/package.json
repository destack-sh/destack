{
  "name": "destack-ts-web",
  "version": "2025.08.08.1",
  "private": true,
  "type": "module",
  "bun": {
    "alias": {
      "@destack/*": "../destack-ts/src/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "bun --env-file ../.env.test --env-file ../.env.test.local test",
    "build": "vite build",
    "check": "tsc --noEmit && biome check --write --unsafe src/",
    "format": "biome check --write --unsafe src/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:web",
    "@codemirror/commands": "catalog:web",
    "@codemirror/lang-python": "catalog:web",
    "@codemirror/language": "catalog:web",
    "@codemirror/lint": "catalog:web",
    "@codemirror/search": "catalog:web",
    "@codemirror/state": "catalog:web",
    "@codemirror/view": "catalog:web",
    "destack": "link:destack-ts",
    "motion": "catalog:web",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "catalog:build",
    "@babel/plugin-proposal-class-static-block": "catalog:build",
    "@babel/plugin-proposal-decorators": "catalog:build",
    "@babel/plugin-transform-class-static-block": "catalog:build",
    "@babel/plugin-transform-typescript": "catalog:build",
    "@babel/preset-typescript": "catalog:build",
    "@biomejs/biome": "catalog:build",
    "@tsconfig/node20": "catalog:build",
    "@types/bun": "catalog:types",
    "@types/jsdom": "catalog:types",
    "@types/node": "catalog:types",
    "buffer": "catalog:web",
    "fake-indexeddb": "catalog:test",
    "fast-check": "catalog:test",
    "jsdom": "catalog:test",
    "mitata": "catalog:test",
    "postcss": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-static-copy": "catalog:build",
    "vite-tsconfig-paths": "catalog:build"
  }
}
