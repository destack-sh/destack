	"Bench View SFC": {
		"prefix": "view",
		"description": "A Bench View as a Vue SFC",
		"body": [
			"<script lang=\"tsx\" setup>",
			"import { ViewData, NodeReferenceData } from \"@/proto/wire/\";",
			"import { viewEmits, ViewExposed, makeViewId } from \"@/views/common\";",
			"import { canvas } from \"@/system/space\";",
			"import { toRef } from \"vue\";",
			"",
			"const props = defineProps<{self: NodeReferenceData} & Pick<ViewData, \"name\" | \"title\" | \"text\" | \"icon\" | \"nodePtr\">>();",
			"const emit = defineEmits(viewEmits());",
			"const self = toRef(props, \"self\");",
			"const id = makeViewId(self);",
			"",
			"const { graph: spaceGraph, connection: spaceConnection } = useLoadedGraph(self);",
			"",
			"canvas.registerCurrent(id, self);",
			"defineExpose<ViewExposed>({ self });",
			"</script>",
			"<template>",
			"  <div>$1</div>",
			"</template>"
		]
	}
}