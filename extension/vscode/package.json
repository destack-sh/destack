{
    "name": "destack-extension-vscode",
    "displayName": "Destack & Dyst",
    "description": "Destack & Dyst for VSCode (.ds, .dst, .dsb, .dsx)",
    "version": "2025.10.18-0",
    "license": "proprietary",
    "engines": {
        "vscode": "^1.90.0"
    },
    "publisher": "symbol-industries",
    "categories": [
        "Programming Languages",
        "Language Packs",
        "Languages",
        "Linters",
        "Formatters",
        "Visualization"
    ],
    "repository": {
        "type": "web",
        "url": "https://destack.sh"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "ds-configuration.json",
        "dst-configuration.json",
        "package.json",
        "README.md",
        "LICENSE.txt"
    ],
    "contributes": {
        "configuration": {
            "title": "Destack",
            "properties": {
                "destack.server.command": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Absolute path to Destack LSP. If empty, the extension tries PATH, then Cargo. Supports `~` and `${workspaceFolder}`."
                },
                "destack.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional arguments to pass to the language server."
                },
                "destack.server.cwd": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory for the language server. Supports `~` and `${workspaceFolder}`."
                }
            }
        },
        "commands": [
            {
                "command": "destack.restart",
                "title": "Destack: Restart Server"
            }
        ],
        "languages": [
            {
                "id": "dyst",
                "aliases": [
                    "Dyst",
                    "ds"
                ],
                "extensions": [
                    ".ds"
                ],
                "configuration": "./ds-configuration.json"
            },
            {
                "id": "dst",
                "aliases": [
                    "Destack Text Format"
                ],
                "extensions": [
                    ".dst"
                ],
                "configuration": "./dst-configuration.json"
            },
            {
                "id": "dsb",
                "aliases": [
                    "Destack Binary Format"
                ],
                "extensions": [
                    ".dsb"
                ]
            },
            {
                "id": "dsx",
                "aliases": [
                    "Destack Executable Format"
                ],
                "extensions": [
                    ".dsx"
                ]
            }
        ]
    },
    "scripts": {
        "bundle": "esbuild typescript/extension.ts --bundle --platform=node --format=cjs --legal-comments=none --minify --outfile=out/extension.js --external:vscode",
        "vscode:prepublish": "bun run bundle",
        "package": "bunx --bun @vscode/vsce@latest package --no-dependencies"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^20.11.25",
        "@types/vscode": "^1.90.0",
        "esbuild": "^0.25.9",
        "typescript": "~5.5.4",
        "vsce": "^2.15.0",
        "vscode": "^1.1.37",
        "vscode-languageclient": "^9.0.1"
    }
}