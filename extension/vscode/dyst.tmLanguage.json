{
  "name": "Dyst",
  "scopeName": "source.dyst",
  "fileTypes": [
    "ds"
  ],
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#literals"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dyst",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dyst",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.dyst"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.dyst"
            }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "include": "#literal-boolean"
        },
        {
          "include": "#literal-nullish"
        },
        {
          "include": "#literal-numeric"
        },
        {
          "include": "#literal-string"
        },
        {
          "include": "#literal-template"
        },
        {
          "include": "#literal-regex"
        },
        {
          "include": "#literal-type"
        }
      ]
    },
    "literal-boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.dyst",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "literal-nullish": {
      "patterns": [
        {
          "name": "constant.language.null.dyst",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.undefined.dyst",
          "match": "\\bundefined\\b"
        }
      ]
    },
    "literal-numeric": {
      "patterns": [
        {
          "name": "constant.numeric.binary.dyst",
          "match": "\\b0[bB][01_]+n?\\b"
        },
        {
          "name": "constant.numeric.octal.dyst",
          "match": "\\b0[oO][0-7_]+n?\\b"
        },
        {
          "name": "constant.numeric.hex.dyst",
          "match": "\\b0[xX][0-9a-fA-F_]+n?\\b"
        },
        {
          "name": "constant.numeric.bigint.decimal.dyst",
          "match": "\\b(?:0|[1-9][\\d_]*)n\\b"
        },
        {
          "name": "constant.numeric.decimal.dyst",
          "match": "(?x)\\b(?:\\d[\\d_]*)(?:\\.(?:\\d[\\d_]*))?(?:[eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.decimal.dyst",
          "match": "(?x)(?<![\\w$])\\.(?:\\d[\\d_]*)(?:[eE][+-]?\\d[\\d_]*)?\\b"
        }
      ]
    },
    "literal-string": {
      "patterns": [
        {
          "name": "string.quoted.double.byte.dyst",
          "begin": "b\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.byte.dyst",
          "begin": "b'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.byte.dyst",
          "begin": "br\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          }
        },
        {
          "name": "string.quoted.double.dyst",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.dyst",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.dyst",
          "begin": "r\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          }
        }
      ]
    },
    "literal-template": {
      "patterns": [
        {
          "name": "string.template.dyst",
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "name": "meta.embedded.line.dyst",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.dyst"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.dyst"
                }
              },
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            }
          ]
        }
      ]
    },
    "literal-regex": {
      "patterns": [
        {
          "name": "string.regexp.dyst",
          "begin": "(?x)(?<![\\w$\\)\\]\\}])/(?![/*])",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dyst"
            }
          },
          "end": "/[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dyst"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dyst",
              "match": "\\\\."
            },
            {
              "name": "constant.other.class.set.dyst",
              "begin": "\\[",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.character-class.begin.dyst"
                }
              },
              "end": "\\]",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.character-class.end.dyst"
                }
              },
              "patterns": [
                {
                  "name": "constant.character.escape.dyst",
                  "match": "\\\\."
                }
              ]
            }
          ]
        }
      ]
    },
    "literal-type": {
      "patterns": [
        {
          "name": "support.type.builtin.dyst",
          "match": "\\b(?:any|never|unknown|boolean|bool|character|char|string|str|number|Self|void)\\b"
        },
        {
          "name": "support.type.numeric.dyst",
          "match": "\\b(?:int(?:\\d+)?|uint(?:\\d+)?|float(?:\\d+)?|i\\d+|u\\d+|f\\d+)\\b"
        },
        {
          "name": "support.type.composite.dyst",
          "match": "\\b(?:type|struct|enum|union|tuple|interface|function)\\b"
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.dyst",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|u[0-9A-Fa-f]{4}|[0-9]{1,3}|.)"
        }
      ]
    }
  }
}
