{
  "name": "Dyst",
  "scopeName": "source.ds",
  "fileTypes": [
    "ds"
  ],
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#entity-definition"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#wildcard"
        },
        {
          "include": "#decorator"
        },
        {
          "include": "#optional-operator"
        },
        {
          "include": "#binding"
        },
        {
          "include": "#path"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#function-call"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ds",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ds",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.ds"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.ds"
            }
          }
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "include": "#literal-boolean"
        },
        {
          "include": "#literal-nullish"
        },
        {
          "include": "#literal-numeric"
        },
        {
          "include": "#literal-string"
        },
        {
          "include": "#literal-template"
        },
        {
          "include": "#literal-regex"
        },
        {
          "include": "#literal-type"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.other.modifier.ds",
          "match": "\\b(?:public|protected|private|readonly|mut|static|final|default|abstract|override)\\b"
        },
        {
          "name": "keyword.other.context.ds",
          "match": "\\b(?:self|this|super|package)\\b"
        },
        {
          "name": "keyword.declaration.import.ds",
          "match": "\\b(?:import|export|from|use|with)\\b"
        },
        {
          "name": "keyword.declaration.type.ds",
          "match": "\\b(?:const|let|var|namespace|module|type|struct|class|enum|union|interface|function|extension|declare|constructor)\\b"
        },
        {
          "name": "keyword.operator.new.ds",
          "match": "\\b(?:new|delete)\\b"
        },
        {
          "name": "keyword.operator.type.ds",
          "match": "\\b(?:tuple|where)\\b"
        },
        {
          "name": "keyword.other.type.ds",
          "match": "\\b(?:any|never)\\b"
        },
        {
          "name": "keyword.control.conditional.ds",
          "match": "\\b(?:if|else|match|switch|case)\\b"
        },
        {
          "name": "keyword.control.loop.ds",
          "match": "\\b(?:do|while|for|loop)\\b"
        },
        {
          "name": "keyword.control.flow.ds",
          "match": "\\b(?:break|continue|defer|return|yield|goto)\\b"
        },
        {
          "name": "keyword.control.exception.ds",
          "match": "\\b(?:try|catch|throw|finally)\\b"
        },
        {
          "name": "keyword.control.async.ds",
          "match": "\\b(?:async|await)\\b"
        },
        {
          "name": "keyword.other.accessor.ds",
          "match": "\\b(?:get|set)\\b"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.postfix.ds",
          "match": "(?x)(?<=\\w|\\]|\\))(?:\\+\\+|--|!(?![=])|\\?(?!\\?))"
        },
        {
          "name": "keyword.operator.postfix.ds",
          "match": "(?x)(?<=\\w|\\]|\\))\\?(?!\\?)"
        },
        {
          "name": "keyword.operator.prefix.ds",
          "match": "(?x)(?<!\\w)(?:\\+\\+(?=\\s*[\\w(])|--(?=\\s*[\\w(])|!(?![=])|~|\\.\\.\\.)"
        },
        {
          "name": "keyword.operator.type.unary.ds",
          "match": "\\b(?:typeof|keyof|infer)\\b"
        },
        {
          "name": "keyword.operator.multiplication.ds",
          "match": "(?x)(?:\\*\\*(?!=)|\\*\\|(?!=)|\\*%(?!=)|\\*(?![=|%])|/(?![=])|%(?![=]))"
        },
        {
          "name": "keyword.operator.addition.ds",
          "match": "(?x)(?:\\+\\|(?!=)|\\+%(?!=)|\\+(?![=|%+])|-\\|(?!=)|-%(?!=)|-(?![=>=\\-\\|%]))"
        },
        {
          "name": "keyword.operator.shift.ds",
          "match": "(?x)(?:<<\\|(?!=)|<<(?![=|])|>>(?![=]))"
        },
        {
          "name": "keyword.operator.elementwise.ds",
          "match": "(?x)(?:&(?![&=])|\\^(?!=)|\\|(?![|=]))"
        },
        {
          "name": "keyword.operator.assignment.ds",
          "match": "=(?![=>])"
        },
        {
          "name": "keyword.operator.assignment.multiplication.ds",
          "match": "(?x)(?:\\*\\*=|\\*\\|=|\\*%=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.assignment.addition.ds",
          "match": "(?x)(?:\\+\\|=|\\+%=|\\+=|-\\|=|-%=|-=)"
        },
        {
          "name": "keyword.operator.assignment.shift.ds",
          "match": "(?x)(?:<<\\|=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.assignment.elementwise.ds",
          "match": "(?x)(?:&=|\\^=|\\|=)"
        },
        {
          "name": "keyword.operator.assignment.boolean.ds",
          "match": "(?x)(?:&&=|\\|\\|=|\\?\\?=)"
        },
        {
          "name": "keyword.operator.comparison.ds",
          "match": "(?x)(?:===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.boolean.ds",
          "match": "(?x)(?:&&(?!=)|\\|\\|(?!=)|\\?\\?(?!=))"
        },
        {
          "name": "keyword.operator.postfix.ds",
          "match": "(?x)\\?(?!\\?)"
        },
        {
          "name": "keyword.operator.container.ds",
          "match": "\\b(?:in|of)\\b"
        },
        {
          "name": "keyword.operator.type.binary.ds",
          "match": "\\b(?:as|is|instanceof|satisfies|extends|implements)\\b"
        }
      ]
    },
    "literal-boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.ds",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "literal-nullish": {
      "patterns": [
        {
          "name": "constant.language.null.ds",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.undefined.ds",
          "match": "\\bundefined\\b"
        }
      ]
    },
    "literal-numeric": {
      "patterns": [
        {
          "name": "constant.numeric.binary.ds",
          "match": "\\b0[bB][01_]+n?\\b"
        },
        {
          "name": "constant.numeric.octal.ds",
          "match": "\\b0[oO][0-7_]+n?\\b"
        },
        {
          "name": "constant.numeric.hex.ds",
          "match": "\\b0[xX][0-9a-fA-F_]+n?\\b"
        },
        {
          "name": "constant.numeric.bigint.decimal.ds",
          "match": "\\b(?:0|[1-9][\\d_]*)n\\b"
        },
        {
          "name": "constant.numeric.decimal.ds",
          "match": "(?x)\\b(?:\\d[\\d_]*)(?:\\.(?:\\d[\\d_]*))?(?:[eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.decimal.ds",
          "match": "(?x)(?<![\\w$])\\.(?:\\d[\\d_]*)(?:[eE][+-]?\\d[\\d_]*)?\\b"
        }
      ]
    },
    "literal-string": {
      "patterns": [
        {
          "name": "string.quoted.double.byte.ds",
          "begin": "b\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.byte.ds",
          "begin": "b'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.byte.ds",
          "begin": "br\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          }
        },
        {
          "name": "string.quoted.double.ds",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.ds",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.ds",
          "begin": "r\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          }
        }
      ]
    },
    "literal-template": {
      "patterns": [
        {
          "name": "string.template.ds",
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "name": "meta.embedded.line.ds",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.ds"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.ds"
                }
              },
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            }
          ]
        }
      ]
    },
    "literal-regex": {
      "patterns": [
        {
          "name": "string.regexp.ds",
          "begin": "(?x)(?<![\\w$\\)\\]\\}])/(?![/*])(?=(?:\\\\.|\\[(?:\\\\.|[^\\]\\n])*\\]|[^/\\n])*/[a-z]*\\b)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ds"
            }
          },
          "end": "(?<!\\\\)/(?:[a-z]*)|(?=\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ds"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ds",
              "match": "\\\\."
            },
            {
              "name": "string.regexp.class.ds",
              "begin": "\\[",
              "end": "\\](?!\\])",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.brackets.begin.ds"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.brackets.end.ds"
                }
              },
              "patterns": [
                {
                  "name": "constant.character.escape.ds",
                  "match": "\\\\."
                }
              ]
            }
          ],
          "applyEndPatternLast": true
        }
      ]
    },
    "literal-type": {
      "patterns": [
        {
          "name": "support.type.builtin.ds",
          "match": "\\b(?:unknown|boolean|bool|character|char|string|str|number|Self|void)\\b"
        },
        {
          "name": "support.type.numeric.ds",
          "match": "\\b(?:int(?:\\d+)?|uint(?:\\d+)?|float(?:\\d+)?|i\\d+|u\\d+|f\\d+)\\b"
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.ds",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|u[0-9A-Fa-f]{4}|[0-9]{1,3}|.)"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.definition.ds",
          "match": "(?x)\\b(function)\\s+([A-Za-z_]\\w*)(?=\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.ds"
            },
            "2": {
              "name": "entity.name.function.definition.ds"
            }
          }
        }
      ]
    },
    "binding": {
      "patterns": [
        {
          "name": "variable.other.binding.ds",
          "match": "(?x)\\b([A-Za-z_]\\w*)\\b(?=\\s*[?!]?\\s*:(?!:))"
        },
        {
          "name": "variable.other.binding.ds",
          "match": "(?x)\\b([A-Za-z_]\\w*)\\b(?=\\s*=(?![=]))"
        }
      ]
    },
    "wildcard": {
      "patterns": [
        {
          "name": "keyword.other.wildcard.ds",
          "match": "(?x)(?<!\\w)_(?!\\w)"
        }
      ]
    },
    "decorator": {
      "patterns": [
        {
          "name": "meta.decorator.call.ds",
          "match": "(?x)([#@])([A-Za-z_]\\w*)(?=\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.decorator.ds"
            },
            "2": {
              "name": "entity.name.function.decorator.ds"
            }
          }
        },
        {
          "name": "meta.decorator.ds",
          "match": "(?x)([#@])([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "entity.name.function.decorator.ds"
            },
            "2": {
              "name": "entity.name.function.decorator.ds"
            }
          }
        }
      ]
    },
    "optional-operator": {
      "patterns": [
        {
          "name": "keyword.operator.postfix.ds",
          "match": "(?x)(?<!\\?)\\?(?!\\?)"
        }
      ]
    },
    "path": {
      "patterns": [
        {
          "name": "meta.path.segment.ds",
          "match": "(?x)(\\.)(\\s*)([A-Za-z_]\\w*+)(?!\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.ds"
            },
            "3": {
              "name": "variable.other.member.ds"
            }
          }
        }
      ]
    },
    "entity-definition": {
      "patterns": [
        {
          "name": "meta.entity.definition.ds",
          "match": "(?x)\\b(struct|interface|extension|module|namespace|class|enum|union)\\b(?:\\s*\\([^)]*\\))*\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.ds"
            },
            "2": {
              "name": "entity.name.type.definition.ds"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function.call.ds",
          "match": "(?x)\\b([A-Za-z_]\\w*)\\b(?=\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.ds"
            }
          }
        }
      ]
    }
  }
}
