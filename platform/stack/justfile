set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# install provider bindings
install:
    bun x sst install

# build provider bindings
build:
    just install

# format code
format:
    @echo "No stack formatting defined"

# check formatting
format-check:
    @echo "No stack formatting checks defined"

# run static checks
lint:
    just install
    bun x sst version

# run tests
test:
    @echo "No stack tests defined"

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint

# check with slow suites
check-full:
    just check-quick

# preview production changes
diff:
    just install
    bun x sst diff --stage production

# deploy production
deploy:
    just install
    bun x sst deploy --stage production

# remove production
remove:
    just install
    bun x sst remove --stage production

# clean build artifacts
clean:
    rm -rf .sst
