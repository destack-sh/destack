set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../../.env.local"

_default:
    @just --list --unsorted

# install provider bindings
install:
    bun x sst install

# build provider bindings
build:
    just install

# format code
format:
    @echo "No stack formatting defined"

# check formatting
format-check:
    @echo "No stack formatting checks defined"

# run static checks
lint:
    just install
    bun x sst version

# run tests
test:
    @echo "No stack tests defined"

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint

# check with slow suites
check-full:
    just check-quick

# preview stage changes
diff stage:
    just install
    CLOUDFLARE_DEFAULT_ACCOUNT_ID="${CLOUDFLARE_DEFAULT_ACCOUNT_ID:-${CLOUDFLARE_ACCOUNT_ID:-}}" bun x sst diff --stage {{stage}}

# deploy stage
deploy stage:
    just install
    CLOUDFLARE_DEFAULT_ACCOUNT_ID="${CLOUDFLARE_DEFAULT_ACCOUNT_ID:-${CLOUDFLARE_ACCOUNT_ID:-}}" bun x sst deploy --stage {{stage}}

# remove stage
remove stage:
    just install
    CLOUDFLARE_DEFAULT_ACCOUNT_ID="${CLOUDFLARE_DEFAULT_ACCOUNT_ID:-${CLOUDFLARE_ACCOUNT_ID:-}}" bun x sst remove --stage {{stage}}

# clean build artifacts
clean:
    rm -rf .sst
