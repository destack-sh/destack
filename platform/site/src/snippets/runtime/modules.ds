/**
* Runtime modules carry typed metadata and a static source graph.
* `import.meta` exposes the module metadata to checked code.
*/

import { Result } from "destack:error";

newtype UserId = uint64;

struct User {
    id: UserId;
    name: string;
}

struct LoadError {
    message: string;
}

module {
    // metadata is part of the module graph
    const role = "server";
    const labels = {
        feature: ["registry", "documents"],
    };
}

declare function readUser(id: UserId): Result<User, LoadError>;

// exports remain ordinary static module exports
export function loadUser(id: UserId): Result<User, LoadError> {
    readUser(id)
}

// metadata fields are typed by the module block
import.meta.role satisfies "server";
