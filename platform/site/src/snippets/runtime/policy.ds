/**
* Runtime policy declares host capability access for a module.
* Calls through host bindings can be checked against the policy.
*/

import { Result } from "destack:error";

@policy({
    // allowed host effects stay explicit
    allow: [
        "fs.read:./public",
        "net.connect:https://api.destack.sh",
    ],
    // denied effects fail at the boundary
    deny: [
        "process.spawn",
    ],
})
module {
    const role = "server";
}

struct IOError {
    message: string;
}

declare function readPublic(path: string): Result<string, IOError>;
declare function spawn(command: string): Result<void, IOError>;

// host calls are checked against module policy
const text = readPublic("./public/index.html")?;
