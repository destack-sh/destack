/**
* Macros are decorators backed by bounded comptime module editing.
* Expansion runs recursively until no macro work remains.
*/

import { Result } from "destack:error";
import { FunctionDeclaration, Macro } from "destack:macro";

newtype UserId = uint64;

newtype memoize = {
    capacity?: uint;
};

struct User {
    id: UserId;
    name: string;
}

struct LoadError {
    message: string;
}

struct MemoizeState {
    innerName: string;
}

declare function readUser(id: UserId): Result<User, LoadError>;

// macro decorators are just typed values
@memoize({ capacity: 1024 })
function load(id: UserId): Result<User, LoadError> {
    readUser(id)
}

// expansion receives the target and bounded edit context
extension of memoize implements Macro<FunctionDeclaration, MemoizeState> {
    static expand(target, context, config): MemoizeState {
        const innerName = `${context.name}Inner`;
        context.renameTarget(innerName);
        context.add(renderWrapper(context.name, innerName, config));

        return MemoizeState { innerName };
    }
}

// generated code is rendered as a virtual `.ds` source file
function renderWrapper(name: string, innerName: string, config: memoize): string {
    const capacity = config.capacity ?? 256;

    return `
        const ${name}Cache = new LruCache<UserId, Result<User, LoadError>>(${capacity});

        function ${name}(id: UserId): Result<User, LoadError> {
            if (${name}Cache.has(id)) {
                return ${name}Cache.get(id)!;
            }

            const value = ${innerName}(id);
            ${name}Cache.set(id, value);
            return value;
        }
    `;
}
