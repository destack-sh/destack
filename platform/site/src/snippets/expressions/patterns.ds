/**
* Destructuring uses the same pattern families as match arms.
* Irrefutable patterns bind names directly in let declarations.
*/

struct Header {
    requestId: string;
    retries: uint8;
}

struct Packet {
    header: Header;
    bytes: [uint8; 4];
}

declare const packet: Packet;

// struct patterns keep nominal identity explicit
let Packet {
    header: Header { requestId, retries },
    bytes: [tag, ...payload],
} = packet;

// bindings inherit precise field and element types
requestId satisfies string;
retries satisfies uint8;
tag satisfies uint8;
payload satisfies [uint8; 3];
