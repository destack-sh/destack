/**
* In Destack, all expressions are values, much like in Rust.
* Blocks can compute values without introducing object literal ambiguity.
*/

import { Result } from "destack:error";

newtype UserId = uint64;

declare const condition: boolean;
declare function loadUser(id: UserId): Result<UserRecord, IOError>;
declare function userFromRecord(record: UserRecord): User;

// `if`s and `block`s produce values
const value = if (condition) {
    2
} else {
    4
};
value satisfies 2 | 4;

// do blocks disambiguate from `{ .. }` object literals
const user = do {
    const record = loadUser(UserId(1))?;
    userFromRecord(record)
};
user satisfies User;

// this also works in functions
function add(left: int32, right: int32): int32 {
    left + right
}
