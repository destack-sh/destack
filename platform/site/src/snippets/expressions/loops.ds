/**
* Loops are expressions when a label names their break value.
* Plain `for` loops remain familiar TypeScript-shaped iteration.
*/

declare function readInput(): string;
declare function process(line: string): void;

// labeled loop breaks produce the expression value
const status = input: loop {
    const line = readInput();

    if (line === "quit") {
        break input: "done";
    }

    process(line);
};

// ordinary counted loops stay familiar
for (let retry = 0; retry < 3; retry++) {
    process(`attempt ${retry}`);
}

status satisfies "done";
