/**
* `using` is lexical cleanup separate from `Drop`.
* Cleanup runs on fallthrough, return, break, continue, and `?`.
*/

import { Result } from "destack:error";

interface DatabaseConnection {
    query(sql: string): Result<Row[], DatabaseError>;
}

interface DatabasePool {
    connect(): Promise<DatabaseConnection>;
}

declare function openFile(path: string): Result<File, IOError>;
declare function copy(input: File, output: File): Result<void, IOError>;
declare function index(file: File): Result<void, IOError>;
declare const pool: DatabasePool;
declare const files: File[];

function copyFile(inputPath: string, outputPath: string): Result<void, IOError> {
    // resources dispose in reverse declaration order
    using input = openFile(inputPath)?;
    using output = openFile(outputPath)?;

    copy(input, output)
}

async function query(sql: string): Result<Row[], DatabaseError> {
    // async cleanup is awaited at scope exit
    await using connection = await pool.connect();

    await connection.query(sql)
}

// loop resources are cleaned up after each iteration
for (using file of files) {
    index(file)?;
}
