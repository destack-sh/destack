/**
* Module blocks attach typed metadata to the current source module.
* Global blocks make selected language items visible without dynamic imports.
*/

import { Clone, Debug } from "destack:decorator";
import { HtmlTree } from "destack:ui/html";

@noHeap
module {
    // metadata is statically visible through import.meta
    const tree = HtmlTree;
    const derive = [Debug, Clone];
    const role = "server";
    const labels = {
        feature: ["registry", "documents"],
    };
}

global {
    // selected globals enter the active module set
    export { Add, Subtract } from "destack:ops";
}

import.meta.role satisfies "server";
import.meta.tree satisfies TreeTagBuilder;
