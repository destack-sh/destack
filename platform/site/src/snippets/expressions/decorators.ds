/**
* Decorators are unified annotations whose target decides the behavior.
* Providers can remain inert or implement macro and diagnostic protocols.
*/

import { Clone, Debug, derive } from "destack:decorator";
import { Result } from "destack:error";

newtype UserId = uint64;
newtype deprecated = () | (string,);

struct LoadError {
    message: string;
}

// inert annotations can still carry typed data
@deprecated("use loadUser instead")
declare function readUser(id: UserId): Result<User, LoadError>;

// derive-style providers are ordinary decorators
@derive(Clone, Debug)
struct User {
    id: UserId;
    name: string;
}

// diagnostics can be configured with structured arguments
@allow("no-floating-promises", {
    if: import.meta.dev,
    otherwise: "deny",
    reason: "debug telemetry",
})
module {}
