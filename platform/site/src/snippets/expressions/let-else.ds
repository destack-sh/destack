/**
* Let else handles refutable patterns without nesting the success path.
* Bindings are available only after the pattern has succeeded.
*/

import { Result } from "destack:error";

struct Header {
    size: uint32;
    checksum: uint32;
}

struct DecodeError {
    message: string;
}

declare function decodeHeader(bytes: [uint8]): Header | null;
declare function decodeError(message: string): DecodeError;

function frameSize(bytes: [uint8]): Result<uint32, DecodeError> {
    let Header { size, checksum: _ } = decodeHeader(bytes) else {
        return Result.err(decodeError("missing header"));
    };

    // annotations can refine the successful binding
    let checked: 0..=1048576 = size else {
        return Result.err(decodeError("frame too large"));
    };

    Result.ok(checked)
}
