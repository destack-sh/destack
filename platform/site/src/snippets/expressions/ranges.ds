/**
* Ranges are half-open by default and implement `RangeBounds<T>`.
* Inclusive ranges use `..=` when the end bound is included.
*/

let values: [uint32] = [10, 20, 30, 40, 50];

// slice indexing accepts all range bounds
const middle = values[1..4];
const prefix = values[..3];
const suffix = values[2..];
const whole = values[..];

middle satisfies [uint32];
prefix satisfies [uint32];
suffix satisfies [uint32];
whole satisfies [uint32];

type HttpStatus = 100..=599;

struct LogEntry {
    message: string;
}

declare const status: HttpStatus;
declare function scan(range: RangeBounds<usize>): [LogEntry];

// ranges can be passed as first-class bounds
const recent = scan(0..100);
const tail = scan(100..);

// range patterns classify scalar values
const kind = match (status) {
    200..=299 => "ok"
    400..=499 => "client-error"
    500..=599 => "server-error"
    _ => "other"
};
