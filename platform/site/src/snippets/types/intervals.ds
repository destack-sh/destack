/**
* Ranges in type position define static interval types.
* Intervals work for bounded scalar types like integers and chars.
*/

type Digit = 0..=9;
type LowerAscii = 'a'..='z';
type UserPort = 1024..=65535;
type HexDigit = Digit | 'a'..='f';

newtype Port = UserPort;

// interval bounds can constrain comptime values
struct InlineBuffer<T, comptime Size: 0..=4096> {
    storage: [T; Size];
}

// valid literals inherit the scalar base type
const digit: Digit = 7;
const letter: LowerAscii = 'm';
const port = Port(8080);

// invalid literals fail before runtime
const invalid: UserPort = 70000;
                          ~~~~~
                          error: value is outside 1024..=65535

digit satisfies int;
letter satisfies char;
port satisfies Port;
