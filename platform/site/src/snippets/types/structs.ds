/**
* Structs are nominal value records.
* Classes are still available when identity and methods on managed objects matter.
*/

struct Point {
    x: float32;
    y: float32;
}

// classes keep managed identity and methods
class Counter {
    value: int32;

    constructor(value: int32) {
        this.value = value;
    }

    increment(): int32 {
        this.value += 1;
        this.value
    }
}

// struct literals construct nominal values
const point = Point { x: 1.0, y: 2.0 };
const counter = new Counter(1);
counter.increment() satisfies int32;
