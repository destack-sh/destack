/**
* Associated types and constants belong to the interface implementation.
* They are statically selected and occupy no instance space.
*/

import { Result } from "destack:error";
import { Option } from "destack:option";

struct IOError {
    message: string;
}

interface Iterator {
    type Item;

    next(): Option<this.Item>;
}

interface RegisterBlock {
    comptime const Width: uint;

    // associated constants can shape method types
    read(): [uint8; this.Width];
    write(bytes: &[uint8; this.Width]): Result<void, IOError>;
}

// associated result types flow through generics
function collect<I: Iterator>(items: I): I.Item[] {
    items.toArray()
}
