/**
* In `.ds`, `readonly T` is a deep readonly view.
* Nested mutation requires a mutable view of the original value.
*/

struct Profile {
    name: string;
}

struct User {
    profile: Profile;
    tags: string[];
}

declare const user: readonly User;

// nested members inherit readonly access
user.profile satisfies readonly Profile;
user.profile.name satisfies string;
user.tags satisfies readonly string[];

// mutation through readonly access is rejected
user.profile.name = "Grace";
~~~~~~~~~~~~~~~~~
error: cannot assign through readonly User
