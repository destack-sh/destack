/**
* Tagged unions are ordinary nominal unions with a shared discriminant.
* Userland macros can derive the constructor and pattern helpers.
*/

import { Tagged } from "destack:decorator";

// the macro derives constructors from the shared tag
@derive(Tagged)
newtype Shape =
    | { kind: "rectangle"; width: int32; height: int32 }
    | { kind: "circle"; radius: int32 };

extension of Shape {
    static DEFAULT = Shape.Rectangle({
        width: 10,
        height: 20,
    });

    // match arms narrow each variant payload
    area(): int32 {
        match (this) {
            Shape.Rectangle({ width, height }) => width * height
            Shape.Circle({ radius }) => radius * radius
        }
    }
}
