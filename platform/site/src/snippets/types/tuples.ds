/**
* Tuples are fixed heterogeneous value containers.
* `.ds` uses parenthesized tuples instead of TypeScript array tuples.
*/

type Cell = (uint32, string, boolean);
type Empty = ();
type One = (uint32,);

declare const cell: Cell;

// tuple patterns bind positions by arity
let (id, label, isActive) = cell;

id satisfies uint32;
label satisfies string;
isActive satisfies boolean;

// nested tuples preserve nested element types
let nested: ((uint32, uint32), string) = ((120, 80), "thumbnail");
let ((width, height), name) = nested;

width satisfies uint32;
height satisfies uint32;
name satisfies string;
