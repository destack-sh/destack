/**
* `newtype` adds nominal identity around a backing representation.
* Backing values do not satisfy the new type by accident.
*/

newtype UserId = uint64;
newtype Email = string;

// raw backing values do not pass as nominal ids
const invalid: UserId = 42;
                        ~~
                        error: expected UserId, found uint64

// construction is explicit at the boundary
const userId = UserId(42);
const email = Email("ada@destack.sh");

userId satisfies UserId;
email satisfies Email;
