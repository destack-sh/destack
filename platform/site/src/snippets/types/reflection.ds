/**
* Types can be reflected as values and evaluated at comptime.
* Layout queries stay in the static world unless explicitly used at runtime.
*/

struct User {
    name: string;
    age: uint;
}

struct Request<Body> {
    headers: string[];
    body: Body;
}

// type values can be carried at runtime
const UserType: Type<User> = User;
const SameUserType = Type.of<User>();

// layout queries can run at comptime
const userSize = comptime sizeOf<User>();
const requestLayout = comptime layoutOf<Request<string>>();

type InlineBytes<T> = [uint8; sizeOf<T>()];

userSize satisfies usize;
requestLayout satisfies TypeLayout;
