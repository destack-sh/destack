/**
* Generics can take types, variadic parameters, and comptime values.
* Value parameters participate in inference and static layout.
*/

type Buffer<comptime Size: uint> = [uint8; Size];
type Callback<...Parameters, Return> = (...parameters: Parameters) => Return;

// comptime values become part of the instantiated type
function copy<T, comptime Size: uint>(source: [T; Size]): [T; Size] {
    let target: [T; Size];
    for (let index = 0; index < Size; index++) {
        target[index] = source[index];
    }
    target
}

// dynamic arguments can still be required to evaluate statically
function repeat<T>(value: T, comptime count: uint): [T; count] {
    [value; count]
}

// inference keeps literal lengths
const rgb = copy<uint8, 3>([255, 128, 0]);
const names = repeat("destack", 2);

rgb satisfies Buffer<3>;
names satisfies [string; 2];
