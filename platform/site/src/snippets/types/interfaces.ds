/**
* Structural interfaces are transparent static constraints.
* Newtype interfaces are nominal and require explicit implementation.
*/

import { Result } from "destack:error";

struct IOError {
    message: string;
}

interface Writer {
    write(bytes: [uint8]): Result<uint, IOError>;
}

// structural interfaces match by shape
declare function writeLog(writer: Writer): Result<uint, IOError>;
declare const sink: Writer;

writeLog(sink)?;

newtype interface Add<T = this> {
    type Output;

    add(other: T): this.Output;
}

// nominal interfaces are explicit opt-in capabilities
declare function add<T: Add<T>>(left: T, right: T): T.Output;
