/**
* Slices are sized first-class views over contiguous elements.
* `[T]` is distinct from both dynamic arrays and fixed arrays.
*/

struct Image {
    pixels: [uint8];
}

declare const bytes: [uint8];
declare function decodeImage(bytes: [uint8]): Image;

// slice patterns can bind a head and keep a slice tail
let [magic, ...body] = bytes;

magic satisfies uint8;
body satisfies [uint8];

// functions can accept slices without owning the backing storage
const image = decodeImage(body);

image.pixels satisfies [uint8];
