/**
* Safe code can create and carry raw pointers.
* Unsafe code is required only for operations that may violate invariants.
*/

class User {
    name: string = "";
}

let user = new User();

// converting a borrow to a pointer is safe
let borrow: &User = &user;
let pointer: *User = borrow;
let bytes: *uint8 = pointer as *uint8;

pointer satisfies *User;
bytes satisfies *uint8;

// dereferencing raw memory requires an unsafe boundary
@unsafe
function readName(pointer: *User): string {
    const user = asReference(pointer);
    user.name
}

// safe wrappers must restore the invariant
@safe
function get<T>(items: Slice<T>, index: usize): T {
    items.unsafeGet(index)
}
