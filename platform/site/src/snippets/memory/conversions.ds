/**
* Conversions between memory forms preserve validity and exclusivity.
* Raw pointers can be carried safely, but dereference requires unsafe code.
*/

class User {
    name: string = "";
}

let user = new User();
let owned: ^User = new User();

// managed values can be borrowed locally
let borrow: &User = &user;
let readonlyBorrow: &readonly User = borrow;

// owned values can provide exclusive access
let exclusive: &exclusive User = &exclusive owned;
let reborrow: &readonly User = exclusive;

// raw pointers are explicit and inert
let pointer: *User = borrow;

// each conversion keeps the access promise visible
borrow satisfies &User;
readonlyBorrow satisfies &readonly User;
exclusive satisfies &exclusive User;
reborrow satisfies &readonly User;
pointer satisfies *User;
