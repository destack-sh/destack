/**
* Dispose and AsyncDispose are lexical resource cleanup protocols.
* `using` runs cleanup on every exit path, including `?`.
*/

import { Promise } from "destack:async";
import { Result } from "destack:error";
import { AsyncDispose, Dispose } from "destack:memory";

class FileHandle implements Dispose {
    descriptor: int32;

    // close the host resource at scope exit
    dispose(): void {
        close(descriptor);
    }
}

class Connection implements AsyncDispose {
    // wait for the remote close handshake
    asyncDispose(): Promise<void> {
        flushAndClose()
    }
}

declare function open(path: string): Result<FileHandle, IOError>;
declare function close(descriptor: int32): void;
declare function flushAndClose(): Promise<void>;
declare function copy(input: FileHandle): Result<void, IOError>;

function copyFile(path: string): Result<void, IOError> {
    using file = open(path)?;

    copy(file)
}
