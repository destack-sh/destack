/**
* Borrowing keeps references valid while their source remains alive.
* Exclusive borrows cannot overlap with any live borrow of the same path.
*/

struct Point {
    x: int32;
    y: int32;
}

let point = ^Point { x: 1, y: 2 };

// disjoint fields can be borrowed at the same time
let readX = &readonly point.x;
let writeY = &point.y;

*writeY = 3;
readX satisfies &readonly int32;

// exclusive access conflicts with the live readonly borrow
let exclusiveX = &exclusive point.x;
                 ~~~~~~~~~~~~~~~~~~
                 error: overlaps live readonly borrow readX

*exclusiveX = 4;

// full exclusive access is required for invalidating operations
declare function translate(point: &exclusive Point): void;
translate(&exclusive point);
