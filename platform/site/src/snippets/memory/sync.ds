/**
* Synchronization is explicit userland structure on top of placement.
* Shared placement alone does not imply atomic access or locking.
*/

import { Arc, AsyncLock, Rc, SharedLock } from "destack:sync";
import { PlaceIn, Send, Sync } from "destack:memory";

// pointer and lock choices can depend on placement
type Ref<T> =
    PlaceIn<T, "local"> extends "shared" ? Arc<T> : Rc<T>;

type Lock<T> =
    PlaceIn<T, "local"> extends "shared" ? SharedLock<T> : AsyncLock<T>;

// shared queues require transferable jobs
struct Queue<T: Send> where T: Sync {
    jobs: shared ConcurrentQueue<T>;
    lock: Lock<shared T>;
}

// the API remains generic over the job type
function submit<T: Send>(queue: &Queue<T>, job: T): void where T: Sync {
    queue.jobs.push(job);
}
