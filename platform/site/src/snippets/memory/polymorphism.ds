/**
* Generic code can dispatch on the selected memory form.
* Iteration preserves access and ownership in the yielded value.
*/

struct Point {
    x: number;
    y: number;
}

declare const points: Point[];

// default iteration yields ordinary values
for (const point of points) {
    point satisfies Point;
}

// readonly iteration preserves readonly access
for (const point of &readonly points) {
    point satisfies &readonly Point;
}

// exclusive iteration permits mutation of each item
for (const point of &exclusive points) {
    point satisfies &exclusive Point;
}

// owned iteration consumes the owner
for (const point of ^points) {
    point satisfies Point;
}
