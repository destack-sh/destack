/**
* Drop follows ownership lifetime, not lexical scope.
* It is for memory-shaped finalization and owned fields.
*/

import { Drop, ManuallyDrop, drop, forget } from "destack:memory";

struct Buffer implements Drop {
    pointer: *uint8;
    length: usize;

    // release owned allocation storage
    drop(): void {
        free(pointer, length);
    }
}

declare function allocate(length: usize): ^Buffer;
declare function free(pointer: *uint8, length: usize): void;
declare function process(buffer: &readonly Buffer): void;

function run(): void {
    let buffer = allocate(4096);
    process(&buffer);

    // ownership can end before scope exit
    drop(buffer);
}

// low-level code can suppress automatic drop
let staged = ManuallyDrop.new(allocate(1024));
let leaked = staged.intoInner();

forget(leaked);
