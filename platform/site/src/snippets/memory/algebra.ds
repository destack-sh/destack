/**
* Ownership, access, lifetime, and placement are ordinary type-level forms.
* Userland code can inspect and rewrite them with type algebra.
*/

import { AccessOf, OwnershipOf, PlaceOf, WithAccess } from "destack:memory";

struct User {
    name: string;
}

type ReadUser = WithAccess<User, "readonly">;
type SharedOwned = shared ^User;

// memory forms can be reflected as type-level values
OwnershipOf<^User> satisfies "owned";
OwnershipOf<&User> satisfies "borrowed";
AccessOf<readonly User> satisfies "readonly";
AccessOf<&exclusive User> satisfies "exclusive";
PlaceOf<shared User> satisfies "shared";

// rewritten forms behave like handwritten forms
declare const user: ReadUser;
user satisfies readonly User;
