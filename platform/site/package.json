{
    "name": "@destack/site",
    "private": true,
    "version": "0.55.4",
    "license": "MIT",
    "type": "module",
    "description": "Destack website, documentation, and blog",
    "scripts": {
        "build": "bun scripts/sync-assets.mjs && bun scripts/generate-content.mjs && vinxi build && bun scripts/postbuild.mjs",
        "check": "bun scripts/generate-content.mjs --check && bun x tsc -p tsconfig.json --noEmit && bun run build",
        "dev": "bun scripts/sync-assets.mjs && bun scripts/generate-content.mjs && vinxi dev",
        "format": "echo \"No site formatter defined\"",
        "typecheck": "bun x tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "5.3.0",
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@solidjs/meta": "^0.29.4",
        "@solidjs/router": "^0.16.1",
        "@solidjs/start": "1.3.2",
        "@stylexjs/stylex": "^0.19.0",
        "highlight.js": "^11.11.1",
        "marked": "^18.0.4",
        "solid-js": "1.9.13",
        "vinxi": "0.5.11",
        "vite": "7.2.4"
    },
    "devDependencies": {
        "@stylexjs/unplugin": "^0.19.0"
    }
}
