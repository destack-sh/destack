set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# build production output
build:
    bun scripts/sync-assets.mjs
    bun scripts/generate-snippets.mjs
    bun scripts/generate-posts.mjs
    bun x vinxi build
    bun scripts/postbuild.mjs

# format source
format:
    @echo "No site formatter defined"

# check source formatting
format-check:
    @echo "No site formatter defined"

# regenerate generated files
generate:
    bun scripts/generate-snippets.mjs
    bun scripts/generate-posts.mjs

# check generated files
generate-check:
    bun scripts/generate-snippets.mjs --check
    bun scripts/generate-posts.mjs --check

# type check source
typecheck:
    bun x tsc -p tsconfig.json --noEmit

# run static checks
lint:
    just typecheck
    just build

# run tests
test:
    @echo "No site tests defined"

# default check
check:
    just check-quick

# normal check
check-quick:
    just generate-check
    just lint

# check with slow suites
check-full:
    just check-quick

# run dev server
dev:
    bun scripts/sync-assets.mjs
    bun scripts/generate-snippets.mjs
    bun scripts/generate-posts.mjs
    bun x vinxi dev

# clean build artifacts
clean:
    rm -rf .vinxi .output dist
