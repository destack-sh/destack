set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# build production output
build:
    bun scripts/sync-assets.ts
    bun scripts/generate-release.ts
    bun scripts/generate-reference.ts
    bun scripts/generate-content.ts
    bun x vinxi build
    bun scripts/postbuild.ts

# format source
format:
    @echo "No site formatter defined"

# check source formatting
format-check:
    @echo "No site formatter defined"

# regenerate generated files
generate:
    bun scripts/generate-release.ts
    bun scripts/generate-reference.ts
    bun scripts/generate-content.ts

# check generated files
generate-check:
    bun scripts/generate-release.ts --check
    bun scripts/generate-reference.ts
    bun scripts/generate-content.ts --check

# type check source
typecheck:
    bun x tsc -p tsconfig.json --noEmit

# run static checks
lint:
    just typecheck
    just build

# run tests
test:
    bun scripts/test-highlighting.ts
    bun scripts/test-reference.ts
    bun scripts/test-listing.ts
    bun scripts/test-rules.ts
    bun scripts/test-presentation.ts

# default check
check:
    just check-quick

# normal check
check-quick:
    just generate-check
    just lint

# check with slow suites
check-full:
    just check-quick

# run dev server
dev:
    bun scripts/sync-assets.ts
    bun scripts/generate-release.ts
    bun scripts/generate-reference.ts
    bun scripts/generate-content.ts
    bun x vinxi dev

# clean build artifacts
clean:
    rm -rf .generated .vinxi .output dist
