set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# build
build:
    bun run build

# deploy
deploy:
    CLOUDFLARE_API_TOKEN="${CLOUDFLARE_COMPANY_API_TOKEN:?CLOUDFLARE_COMPANY_API_TOKEN is required}" bun run wrangler deploy

# format
format:
    bun run destack-check format src build scripts

# check formatting
format-check:
    bun run destack-check format-check src build scripts

# generate
generate:
    bun run generate

# generate check
generate-check:
    bun run scripts/generate-release.ts --check
    bun run scripts/generate-content.ts --check

# typecheck
typecheck:
    bun run typecheck

# lint
lint:
    just typecheck
    just build

# test
test:
    bun run test

# check
check:
    just check-quick

# check quick
check-quick:
    just generate-check
    just lint

# check full
check-full:
    just check-quick

# dev
dev:
    bun run dev

# clean
clean:
    rm -rf .generated .vinxi .output dist
