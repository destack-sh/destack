set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

_default:
    @just --list --unsorted

# build
build:
    deno task build

# deploy
deploy:
    CLOUDFLARE_API_TOKEN="${CLOUDFLARE_COMPANY_API_TOKEN:?CLOUDFLARE_COMPANY_API_TOKEN is required}" deno run -A npm:wrangler deploy

# format
format:
    @echo "No site formatter defined"

# check formatting
format-check:
    @echo "No site formatter defined"

# generate
generate:
    deno task generate

# generate reference
generate-reference:
    deno run -A scripts/generate-release.ts
    deno run -A scripts/generate-content.ts --reference

# generate check
generate-check:
    deno run -A scripts/generate-release.ts --check
    deno run -A scripts/generate-content.ts --check

# typecheck
typecheck:
    deno task typecheck

# lint
lint:
    just typecheck
    just build

# test
test:
    deno task test

# check
check:
    just check-quick

# check quick
check-quick:
    just generate-check
    just lint

# check full
check-full:
    just check-quick

# dev
dev:
    deno task dev

# clean
clean:
    rm -rf .generated .vinxi .output dist
