{
    "name": "destack",
    "displayName": "Destack",
    "description": "Destack for VSCode (.ds, .d.ds, .dst, .mir)",
    "version": "0.53.0",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "publisher": "symbol-industries",
    "categories": [
        "AI",
        "Debuggers",
        "Formatters",
        "Language Packs",
        "Languages",
        "Linters",
        "Programming Languages",
        "Testing",
        "Visualization"
    ],
    "repository": {
        "type": "web",
        "url": "https://destack.sh"
    },
    "activationEvents": [
        "onLanguage:destack",
        "onLanguage:dst",
        "onLanguage:dsb",
        "onLanguage:destack-mir",
        "workspaceContains:dsconfig.json"
    ],
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "destack.json",
        "destack.tmLanguage.json",
        "destack.tmTheme.json",
        "destack-mir.tmLanguage.json",
        "destack-mir.json",
        "dsconfig.schema.json",
        "package.json",
        "LICENSE.txt"
    ],
    "contributes": {
        "configuration": {
            "title": "Destack",
            "properties": {
                "destack.server.command": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Command for the Destack LSP. If empty, tries `destack`, `ds`, or `dsc` on PATH, then Cargo in the workspace. Supports `~` and `${workspaceFolder}`."
                },
                "destack.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional arguments to pass to the language server."
                },
                "destack.server.cwd": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory for the language server. Supports `~` and `${workspaceFolder}`."
                }
            }
        },
        "commands": [
            {
                "command": "destack.restart",
                "title": "Destack: Restart Server"
            }
        ],
        "languages": [
            {
                "id": "destack",
                "aliases": [
                    "Destack",
                    "ds"
                ],
                "extensions": [
                    ".ds",
                    ".d.ds"
                ],
                "configuration": "./destack.json"
            },
            {
                "id": "dst",
                "aliases": [
                    "Destack Text Format"
                ],
                "extensions": [
                    ".dst"
                ],
                "configuration": "./destack.json"
            },
            {
                "id": "dsb",
                "aliases": [
                    "Destack Binary Format"
                ],
                "extensions": [
                    ".dsb"
                ]
            },
            {
                "id": "destack-mir",
                "aliases": [
                    "Destack MIR"
                ],
                "extensions": [
                    ".mir"
                ],
                "configuration": "./destack-mir.json"
            }
        ],
        "grammars": [
            {
                "language": "destack",
                "scopeName": "source.ds",
                "path": "./destack.tmLanguage.json"
            },
            {
                "language": "dst",
                "scopeName": "source.ds",
                "path": "./destack.tmLanguage.json"
            },
            {
                "language": "destack-mir",
                "scopeName": "source.dsmir",
                "path": "./destack-mir.tmLanguage.json"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": ["dsconfig.json", "*.dsconfig.json"],
                "url": "./dsconfig.schema.json"
            }
        ]
    },
    "scripts": {
        "bundle": "esbuild typescript/extension.ts --bundle --platform=node --format=cjs --legal-comments=none --minify --outfile=out/extension.js --external:vscode",
        "vscode:prepublish": "bun run bundle",
        "package": "bunx --bun @vscode/vsce@latest package --no-dependencies",
        "publish:live": "bunx --bun @vscode/vsce@latest publish",
        "check:grammar": "node scripts/check-grammar.mjs",
        "test:grammar": "node scripts/check-grammar.mjs && bunx vscode-tmgrammar-test --grammar destack.tmLanguage.json \"typescript/tests/*.txt\" && bunx vscode-tmgrammar-test --grammar destack-mir.tmLanguage.json \"typescript/tests-mir/*.txt\""
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^20.11.25",
        "@types/vscode": "^1.90.0",
        "esbuild": "^0.25.9",
        "typescript": "~5.5.4",
        "vsce": "^2.15.0",
        "vscode": "^1.1.37",
        "vscode-languageclient": "^9.0.1",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
