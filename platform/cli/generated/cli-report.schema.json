{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandReport",
  "description": "Report output for a command invocation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Report schema version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "command": {
      "description": "Command name.",
      "type": "string"
    },
    "status": {
      "description": "Result status.",
      "$ref": "#/$defs/CommandStatus"
    },
    "exit_code": {
      "description": "Exit code returned by the command.",
      "type": "integer",
      "format": "int32"
    },
    "summary": {
      "description": "Short summary for text output.",
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "description": "Diagnostics payload for tooling.",
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticOutputJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "description": "Structured error payload when diagnostics are not available.",
      "anyOf": [
        {
          "$ref": "#/$defs/CommandError"
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "description": "Compiler stats snapshot for tooling.",
      "anyOf": [
        {
          "$ref": "#/$defs/CommandStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "description": "Command-specific payload."
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "exit_code",
    "data"
  ],
  "$defs": {
    "CommandStatus": {
      "description": "Result status for a command report.",
      "oneOf": [
        {
          "description": "Command completed successfully.",
          "type": "string",
          "const": "success"
        },
        {
          "description": "Command failed.",
          "type": "string",
          "const": "failure"
        }
      ]
    },
    "DiagnosticOutputJson": {
      "description": "Diagnostic output payload for JSON output.",
      "type": "object",
      "properties": {
        "diagnostics": {
          "description": "The diagnostics list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticJson"
          }
        },
        "summary": {
          "description": "Summary counts by severity.",
          "$ref": "#/$defs/DiagnosticSummaryJson"
        },
        "statistics": {
          "description": "Optional statistics grouped by rule.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/DiagnosticStatistic"
          }
        }
      },
      "required": [
        "diagnostics",
        "summary"
      ]
    },
    "DiagnosticJson": {
      "description": "Diagnostic entry serialized in JSON output.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The diagnostic code.",
          "type": "string"
        },
        "severity": {
          "description": "The severity label.",
          "type": "string"
        },
        "message": {
          "description": "The diagnostic message.",
          "type": "string"
        },
        "file": {
          "description": "The file path or label.",
          "type": "string"
        },
        "line": {
          "description": "The 1-based starting line.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "column": {
          "description": "The 1-based starting column.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "description": "The 1-based ending line.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_column": {
          "description": "The 1-based ending column.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "file",
        "line",
        "column",
        "end_line",
        "end_column"
      ]
    },
    "DiagnosticSummaryJson": {
      "description": "Summary counts for diagnostics.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "Total error count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "warnings": {
          "description": "Total warning count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "notes": {
          "description": "Total note count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "errors",
        "warnings",
        "notes"
      ]
    },
    "DiagnosticStatistic": {
      "description": "Diagnostic statistic counts.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The code of the diagnostic.",
          "type": "string"
        },
        "count": {
          "description": "The count of the diagnostic.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "severity": {
          "description": "The severity of the diagnostic.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "count",
        "severity"
      ]
    },
    "CommandError": {
      "description": "Structured error payload for command failures.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Machine-readable error code.",
          "type": "string"
        },
        "kind": {
          "description": "Error category for tooling.",
          "type": "string"
        },
        "message": {
          "description": "Human-readable error message.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "kind",
        "message"
      ]
    },
    "CommandStats": {
      "description": "Summary statistics for command execution.",
      "type": "object",
      "properties": {
        "elapsed_ms": {
          "description": "Elapsed time in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tasks_completed": {
          "description": "Number of tasks completed by the compiler.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "tasks_failed": {
          "description": "Number of tasks failed by the compiler.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "modules_processed": {
          "description": "Number of modules processed.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "lines_processed": {
          "description": "Number of lines processed.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "slow_tasks": {
          "description": "Number of slow tasks detected.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "cache": {
          "description": "Cache statistics for the command.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommandCacheStats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "elapsed_ms",
        "tasks_completed",
        "tasks_failed",
        "modules_processed",
        "lines_processed",
        "slow_tasks"
      ]
    },
    "CommandCacheStats": {
      "description": "Cache statistics for command output.",
      "type": "object",
      "properties": {
        "hits_memory": {
          "description": "Cache hits from memory.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "hits_disk": {
          "description": "Cache hits from disk.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "misses": {
          "description": "Cache misses.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "writes_memory": {
          "description": "Cache writes to memory.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "writes_disk": {
          "description": "Cache writes to disk.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "errors": {
          "description": "Cache errors.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "hit_rate": {
          "description": "Cache hit rate across all cache kinds.",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "hits_memory",
        "hits_disk",
        "misses",
        "writes_memory",
        "writes_disk",
        "errors",
        "hit_rate"
      ]
    }
  }
}
