set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

_default:
    @just --list --unsorted

# build packages
build:
    just site/build
    just stack/build

# format packages
format:
    just site/format
    just stack/format

# check formatting
format-check:
    just site/format-check
    just stack/format-check

# run static checks
lint:
    just site/lint
    just stack/lint

# run tests
test:
    just site/test
    just stack/test

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint
    just test

# check with slow suites
check-full:
    just check-quick

# preview stage changes
diff stage:
    just stack/diff {{stage}}

# deploy stage
deploy stage:
    just stack/deploy {{stage}}

# remove stage
remove stage:
    just stack/remove {{stage}}

# clean build artifacts
clean:
    just site/clean
    just stack/clean
