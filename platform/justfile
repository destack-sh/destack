set shell := ["bash", "-cu"]

# all platform crates
packages := "-p destack_cli -p destack_lsp -p destack_vscode -p destack_daemon"

_default:
    @just --list --unsorted

# check
check:
    cargo clippy --release {{ packages }}

# build all platform packages
build:
    cargo build --release {{ packages }}
    just build-vscode

# build vscode extension
build-vscode:
    cd vscode && bun run bundle && bun run package

# test
test:
    cargo test --release --all-targets {{ packages }}
    cd vscode && bun run test:grammar

# format
fmt:
    cargo fmt {{ packages }}
