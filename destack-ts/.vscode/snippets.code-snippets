	"Destack View SFC": {
		"prefix": "viewd",
		"description": "A Destack View as a Vue SFC. Detachable = can be used without 'self' view identity.",
		"body": [
			"<script lang=\"ts\" setup>",
      "import { ViewData, NodeType } from \"@/proto/wire\";",
      "import { type ViewEmits, type ViewExpose } from \"@/views/common\";",
      "import { canvas } from \"@/system/space\";",
      "import { toRef } from \"vue\";",
      "import { TypedNodeReferenceData } from \"@/proto/wiring\";",
      "",
      "const props = defineProps<",
      "  { self?: TypedNodeReferenceData<NodeType.VIEW>; id: string } & Partial<Pick<ViewData, \"name\" | \"title\" | \"icon\" | \"nodePtr\">>",
      ">();",
      "const emit = defineEmits<ViewEmits>();",
      "const self = toRef(props, \"self\");",
      "const id = toRef(props, \"id\");",
      "canvas.registerView(self, id);",
      "",
      "defineExpose<ViewExpose>({ self, id });",
      "</script>",
      "<template>",
      "  <div>$1</div>",
      "</template>"
		]
	}
}