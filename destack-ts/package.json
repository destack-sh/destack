{
  "name": "destack",
  "version": "2025.08.13.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "bun": {
    "alias": {
      "@destack/*": "src/*"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun --env-file ../.env.test --env-file ../.env.test.local test",
    "check": "tsc --noEmit && biome check --write --unsafe src/",
    "fmt": "biome check --write --unsafe src/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-static-block": "catalog:build",
    "@babel/plugin-proposal-decorators": "catalog:build",
    "@babel/plugin-transform-class-static-block": "catalog:build",
    "@babel/plugin-transform-typescript": "catalog:build",
    "@babel/preset-typescript": "catalog:build",
    "@biomejs/biome": "catalog:build",
    "@types/bun": "catalog:types",
    "fast-check": "catalog:test",
    "mitata": "catalog:test",
    "typescript": "catalog:build",
    "vite-plugin-babel": "catalog:build",
    "vite-tsconfig-paths": "catalog:build"
  }
}