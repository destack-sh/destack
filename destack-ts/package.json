{
  "name": "destack",
  "version": "2025.07.21.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "bun": {
    "alias": {
      "@destack/*": "src/*"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check": "tsc --noEmit && biome check --write --unsafe src/",
    "fmt": "biome check --write --unsafe src/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:telemetry",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:telemetry",
    "@opentelemetry/instrumentation": "catalog:telemetry",
    "@opentelemetry/resources": "catalog:telemetry",
    "@opentelemetry/semantic-conventions": "catalog:telemetry",
    "js-xxhash": "catalog:",
    "pino": "catalog:",
    "temporal-polyfill": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-static-block": "catalog:build",
    "@babel/plugin-proposal-decorators": "catalog:build",
    "@babel/plugin-transform-class-static-block": "catalog:build",
    "@babel/plugin-transform-typescript": "catalog:build",
    "@babel/preset-typescript": "catalog:build",
    "@biomejs/biome": "catalog:build",
    "@types/bun": "catalog:types",
    "@types/uuid": "catalog:types",
    "fast-check": "catalog:test",
    "mitata": "catalog:test",
    "pino-pretty": "catalog:dev",
    "typescript": "catalog:build",
    "vite-plugin-babel": "catalog:build",
    "vite-tsconfig-paths": "catalog:build"
  }
}
