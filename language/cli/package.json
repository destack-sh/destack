{
    "name": "@destack/tspp",
    "version": "2026.9.0",
    "license": "MIT",
    "type": "module",
    "description": "TS++ command-line interface",
    "bin": {
        "tspp": "npm/dist/bin/tspp.js",
        "tsppc": "npm/dist/bin/tsppc.js"
    },
    "exports": {
        "./launcher": "./npm/dist/index.js"
    },
    "files": [
        "npm/dist"
    ],
    "scripts": {
        "build": "deno run -A npm:typescript/tsc -p ./npm/tsconfig.build.json",
        "stage:binaries": "deno run -A ./npm/stage-binaries.ts",
        "stage:artifacts": "bash ./install/stage-npm-binaries-from-artifacts.sh",
        "prepublishOnly": "deno task build && deno run -A ./npm/validate-main-package.ts",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "optionalDependencies": {
        "@destack/tspp-darwin-arm64": "2026.9.0",
        "@destack/tspp-darwin-x64": "2026.9.0",
        "@destack/tspp-linux-arm64-gnu": "2026.9.0",
        "@destack/tspp-linux-x64-gnu": "2026.9.0",
        "@destack/tspp-win32-x64-msvc": "2026.9.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "typescript": "5.8.3"
    }
}
