{
    "$schema": "https://destack.sh/schemas/destack.schema.json",
    "name": "__DESTACK_PROJECT__",
    "version": "0.1.0",
    "private": true,
    "targets": {
        "default": {
            "entry": [
                "src/main.ds"
            ],
            "entrypoint": {
                "module": "src/main.ds",
                "export": "main"
            },
            "output": "program"
        }
    },
    "defaultTarget": "default"
}
