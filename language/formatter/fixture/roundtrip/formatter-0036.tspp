import * as codec from "../src/Codec";

declare const NumberFromString: codec.Codec<string, string, number>;

//
// fromStruct
//

// $ExpectType Codec<{ a: unknown; b: { c: string; }; }, { a: string; b: { c: string; }; }, { a: string; b: { c: number; }; }>
codec.fromStruct({
    a: codec.string,
    b: codec.fromStruct({
        c: NumberFromString,
    }),
});

//
// struct
//

// $ExpectType Codec<unknown, { a: string; b: { c: number; }; }, { a: string; b: { c: number; }; }>
codec.struct({
    a: codec.string,
    b: codec.struct({
        c: codec.number,
    }),
});

//
// fromPartial
//

// $ExpectType Codec<Partial<{ a: unknown; b: Partial<{ c: string; }>; }>, Partial<{ a: string; b: Partial<{ c: string; }>; }>, Partial<{ a: string; b: Partial<{ c: number; }>; }>>
codec.fromPartial({
    a: codec.string,
    b: codec.fromPartial({
        c: NumberFromString,
    }),
});

//
// partial
//

// $ExpectType Codec<unknown, Partial<{ a: string; b: Partial<{ c: number; }>; }>, Partial<{ a: string; b: Partial<{ c: number; }>; }>>
codec.partial({
    a: codec.string,
    b: codec.partial({
        c: codec.number,
    }),
});

//
// fromArray
//

// $ExpectType Codec<string[], string[], number[]>
codec.fromArray(NumberFromString);

//
// array
//

// $ExpectType Codec<unknown, string[], string[]>
codec.array(codec.string);

//
// fromRecord
//

// $ExpectType Codec<Record<string, string>, Record<string, string>, Record<string, number>>
codec.fromRecord(NumberFromString);

//
// record
//

// $ExpectType Codec<unknown, Record<string, string>, Record<string, string>>
codec.record(codec.string);

//
// fromTuple
//

// $ExpectType Codec<[unknown, string, unknown], [string, string, boolean], [string, number, boolean]>
codec.fromTuple(codec.string, NumberFromString, codec.boolean);

//
// tuple
//

// $ExpectType Codec<unknown, [string, number, boolean], [string, number, boolean]>
codec.tuple(codec.string, codec.number, codec.boolean);

//
// fromSum
//

// $ExpectType Codec<{ _tag: unknown; a: unknown; } | { _tag: unknown; b: string; }, { _tag: "A"; a: string; } | { _tag: "B"; b: string; }, { _tag: "A"; a: string; } | { _tag: "B"; b: number; }>
codec.fromSum("_tag")({
    A: codec.fromStruct({ _tag: codec.literal("A"), a: codec.string }),
    B: codec.fromStruct({ _tag: codec.literal("B"), b: NumberFromString }),
});

//
// sum
//

const S1 = codec.struct({ _tag: codec.literal("A"), a: codec.string });
const S2 = codec.struct({ _tag: codec.literal("B"), b: codec.number });

// $ExpectType Codec<unknown, { _tag: "A"; a: string; } | { _tag: "B"; b: number; }, { _tag: "A"; a: string; } | { _tag: "B"; b: number; }>
codec.sum("_tag")({ A: S1, B: S2 });
// // @ts-expect-error
// codec.sum('_tag')({ A: S1, B: S1 })
