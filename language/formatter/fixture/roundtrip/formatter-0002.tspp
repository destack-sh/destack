import { Entity, entity, Reference } from "tspp";

@description("The status of a Meetup.")
export enum MeetupStatus {
    @default
    @description("The Meetup is a draft.")
    Draft,
    @description("The Meetup is upcoming.")
    Upcoming,
    @description("The Meetup is cancelled.")
    Cancelled,
    @description("The Meetup is past.")
    Past,
}

/// A Series of related Meetups (with a common prefix).
@entity
export class MeetupSeries {
    @description("The name of the Meetup Series.")
    name: string;

    @description("The prefix of the Meetup Series.")
    prefix: string;
}

@description("The language of a Meetup.")
export enum MeetupLanguage {
    @description("The main language of the Meetup is English.")
    English,
    @description("The main language of the Meetup is German.")
    German,
}

@entity
export class Meetup {
    @description("When the Meetup is happening.")
    date: DateTime;

    @description("The name of the Meetup.")
    name: string;

    @description("The number of the Meetup.")
    number: uint;

    @description("The Series this Meetup is part of.")
    series?: MeetupSeries;

    @description("The language of the Meetup.")
    language: MeetupLanguage;

    @description("The status of the Meetup.")
    status: MeetupStatus;
}

@entity
export class MeetupRegistration {
    @description("The Meetup this registration is for.")
    meetup: Meetup;

    @description("The person registering.")
    user: User;
}
