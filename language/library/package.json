{
  "name": "tspp",
  "version": "2026.9.0",
  "private": true,
  "description": "TS++ standard library.",
  "packageManager": "tspp@2026.9.0",
  "exports": {
    ".": "./src/index.tspp",
    "./assert": "./src/assert/index.tspp",
    "./async": "./src/async/index.tspp",
    "./binding": "./src/binding/index.tspp",
    "./bytes": "./src/bytes/index.tspp",
    "./channel": "./src/channel/index.tspp",
    "./collections": "./src/collections/index.tspp",
    "./console": "./src/console/index.tspp",
    "./context": "./src/context/index.tspp",
    "./convert": "./src/convert/index.tspp",
    "./debug": "./src/debug/index.tspp",
    "./decorator": "./src/decorator/index.tspp",
    "./error": "./src/error/index.tspp",
    "./fs": "./src/fs/index.tspp",
    "./fs/binding": "./src/fs/binding/index.tspp",
    "./hint": "./src/hint/index.tspp",
    "./iter": "./src/iter/index.tspp",
    "./intl": "./src/intl/index.tspp",
    "./json": "./src/json/index.tspp",
    "./math": "./src/math/index.tspp",
    "./memory": "./src/memory/index.tspp",
    "./memory/binding": "./src/memory/binding/index.tspp",
    "./module": "./src/module/index.tspp",
    "./net": "./src/net/index.tspp",
    "./net/binding": "./src/net/binding/index.tspp",
    "./ops": "./src/ops/index.tspp",
    "./profile": "./src/profile/index.tspp",
    "./prelude": "./src/prelude.tspp",
    "./random": "./src/random/index.tspp",
    "./random/binding": "./src/random/binding/index.tspp",
    "./range": "./src/range/index.tspp",
    "./reflect": "./src/reflect/index.tspp",
    "./regexp": "./src/regexp/index.tspp",
    "./runtime": "./src/runtime/index.tspp",
    "./serde": "./src/serde/index.tspp",
    "./signal": "./src/signal/index.tspp",
    "./stream": "./src/stream/index.tspp",
    "./string": "./src/string/index.tspp",
    "./sync": "./src/sync/index.tspp",
    "./telemetry": "./src/telemetry/index.tspp",
    "./telemetry/binding": "./src/telemetry/binding/index.tspp",
    "./test": "./src/test/index.tspp",
    "./time": "./src/time/index.tspp",
    "./time/binding": "./src/time/binding/index.tspp",
    "./topology": "./src/topology/index.tspp",
    "./topology/binding": "./src/topology/binding/index.tspp",
    "./tree": "./src/tree/index.tspp",
    "./types": "./src/types/index.tspp",
    "./worker": "./src/worker/index.tspp"
  },
  "stability": "experimental",
  "targets": {
    "default": {
      "output": "program",
      "include": [
        "src/**/*.tspp"
      ]
    }
  },
  "defaultTarget": "default"
}
