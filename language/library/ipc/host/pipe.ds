import { ResourceId } from "destack:runtime/resource";
import { HostError } from "destack:error/host";

/// Handle for a pipe endpoint.
export newtype PipeHandle = ResourceId;

/// Pipe creation flags.
export newtype PipeFlags = uint32;

/// Create the pipe endpoints in nonblocking mode.
export const PIPE_NONBLOCK: PipeFlags = PipeFlags(0x1);

/// Create the pipe endpoints as close-on-exec or non-inheritable.
export const PIPE_CLOEXEC: PipeFlags = PipeFlags(0x2);

/// Pair of anonymous pipe endpoints.
export struct PipePair {
    /// Read endpoint.
    read: PipeHandle;
    /// Write endpoint.
    write: PipeHandle;
}

/// Create one anonymous pipe pair.
@binding("destack.ipc.pipe.create", {
    effect: "external",
    requires: ["host.ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function createPipe(flags: PipeFlags): Result<PipePair, HostError>;

/// Close one pipe endpoint.
@binding("destack.ipc.pipe.close", {
    effect: "external",
    requires: ["host.ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closePipe(pipe: PipeHandle): Result<void, HostError>;

/// Read bytes from one pipe endpoint.
@binding("destack.ipc.pipe.read", {
    effect: "external",
    requires: ["host.ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readPipe(
    pipe: PipeHandle,
    buffer: &[uint8],
): Result<uint64, HostError>;

/// Write bytes to one pipe endpoint.
@binding("destack.ipc.pipe.write", {
    effect: "external",
    requires: ["host.ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writePipe(
    pipe: PipeHandle,
    bytes: &readonly [uint8],
): Result<uint64, HostError>;
