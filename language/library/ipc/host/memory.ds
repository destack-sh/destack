import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for an IPC shared memory object.
export newtype SharedMemoryHandle = ResourceId;

/// Shared memory creation flags.
export newtype SharedMemoryFlags = uint32;

/// Create the object only when it does not already exist.
export const SHARED_MEMORY_CREATE_EXCLUSIVE: SharedMemoryFlags = SharedMemoryFlags(0x1);

/// Shared memory mapping protection flags.
export newtype SharedMemoryMapFlags = uint32;

/// Map the range readable.
export const SHARED_MEMORY_MAP_READ: SharedMemoryMapFlags = SharedMemoryMapFlags(0x1);

/// Map the range writable.
export const SHARED_MEMORY_MAP_WRITE: SharedMemoryMapFlags = SharedMemoryMapFlags(0x2);

/// Shared memory mapping result.
export struct SharedMemoryMap {
    /// Base address in process virtual memory.
    address: uint64;
    /// Mapping length in bytes.
    length: uint64;
}

/// Create one named shared memory object.
@binding("destack.ipc.memory.create", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function createSharedMemory(
    name: &readonly string,
    size: uint64,
    flags: SharedMemoryFlags,
): Result<SharedMemoryHandle, HostError>;

/// Create one anonymous shared memory object.
@binding("destack.ipc.memory.createAnonymous", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function createAnonymousSharedMemory(
    size: uint64,
    flags: SharedMemoryFlags,
): Result<SharedMemoryHandle, HostError>;

/// Open one named shared memory object.
@binding("destack.ipc.memory.open", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openSharedMemory(
    name: &readonly string,
    flags: SharedMemoryFlags,
): Result<SharedMemoryHandle, HostError>;

/// Remove one named shared memory object.
@binding("destack.ipc.memory.remove", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["unix"],
    simulation: true,
})
export declare function removeSharedMemory(name: &readonly string): Result<void, HostError>;

/// Close one shared memory object handle.
@binding("destack.ipc.memory.close", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeSharedMemory(memory: SharedMemoryHandle): Result<void, HostError>;

/// Map one shared memory range.
@binding("destack.ipc.memory.map", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mapSharedMemory(
    memory: SharedMemoryHandle,
    offset: uint64,
    length: uint64,
    flags: SharedMemoryMapFlags,
): Result<SharedMemoryMap, HostError>;

/// Unmap one shared memory range.
@binding("destack.ipc.memory.unmap", {
    effect: "external",
    requires: ["host.ipc.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unmapSharedMemory(address: uint64, length: uint64): Result<void, HostError>;
