import { type Error, type Result } from "destack:error";

/// Infallible conversion from `T`.
export newtype interface From<T> {
    /// Convert `value`.
    static from(value: T): this;
}

/// Fallible conversion from `T`.
export newtype interface TryFrom<T, E = Error> {
    /// Convert `value`, or return an error.
    static tryFrom(value: T): Result<this, E>;
}
