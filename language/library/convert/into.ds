import { Error, Result } from "destack:error";

import { From, TryFrom } from "./from.ds";

/// Infallible conversion into `T`.
export newtype interface Into<T> {
    /// Convert this value.
    into(): T;
}

export extension<T, U> of T implements Into<U> where U: From<T> {
    /// Convert this value through `U.from`.
    into(): U {
        U.from(this)
    }
}

/// Fallible conversion into `T`.
export newtype interface TryInto<T, E = Error> {
    /// Convert this value, or return an error.
    tryInto(): Result<T, E>;
}

export extension<T, U, E = Error> of T implements TryInto<U, E> where U: TryFrom<T, E> {
    /// Convert this value through `U.tryFrom`.
    tryInto(): Result<U, E> {
        U.tryFrom(this)
    }
}
