import { Access, WithAccess } from "destack:memory";

/// Equivalent borrowed form of a value.
///
/// Borrowed values must preserve equality, hashing, and ordering with the owner.
@languageItem("convert.Borrow")
export newtype interface Borrow<T, A: Access = "readonly"> {
    /// Borrow this value.
    borrow(this: WithAccess<&this, A>): WithAccess<&T, A>;
}

export extension<T, A: Access = "readonly"> of T implements Borrow<T, A> {
    /// Borrow this value as itself.
    borrow(this: WithAccess<&T, A>): WithAccess<&T, A> {
        this
    }
}

/// Owned form of a borrowed value.
@languageItem("convert.ToOwned")
export newtype interface ToOwned {
    /// The owned value type.
    type Owned;

    /// Copy this value into owned storage.
    toOwned(this: &readonly this): this.Owned;
}
