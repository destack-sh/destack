import { PlatformError } from "destack:platform/error";
import { ObservationHandle, ObservationOptions, ObservationRecord, WorldHandle } from "./types.ds";

/// Open one runtime observation subscription.
@binding("destack.runtime.observation.open", {
    effect: "deterministic",
    requires: ["runtime.observation.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function observationOpen(
    world: WorldHandle,
    options?: ObservationOptions,
): Result<ObservationHandle, PlatformError>;

/// Close one runtime observation subscription.
@binding("destack.runtime.observation.close", {
    effect: "deterministic",
    requires: ["runtime.observation.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function observationClose(handle: ObservationHandle): Result<void, PlatformError>;

/// Read the next batch of observation records.
@binding("destack.runtime.observation.next", {
    effect: "deterministic",
    requires: ["runtime.observation.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function observationNext(
    handle: ObservationHandle,
    limit?: uint32,
): Result<Array<ObservationRecord>, PlatformError>;
