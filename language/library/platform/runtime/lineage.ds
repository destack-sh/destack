import { PlatformError } from "destack:platform/error";
import {
    BranchDescriptor,
    BranchFilter,
    BranchId,
    CheckpointFilter,
    CheckpointDescriptor,
    CheckpointId,
    ImageFilter,
    ImageDescriptor,
    ImageId,
    RevisionFilter,
    RevisionDescriptor,
    RevisionId,
    RuntimeLabel,
    WorldHandle,
} from "./types.ds";

/// Return the active branch for one world.
@binding("destack.runtime.lineage.worldBranch", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldBranch(world: WorldHandle): Result<BranchId, PlatformError>;

/// Return the active revision for one world.
@binding("destack.runtime.lineage.worldRevision", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRevision(world: WorldHandle): Result<RevisionId, PlatformError>;

/// Describe one branch.
@binding("destack.runtime.lineage.branchDescribe", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function branchDescribe(
    world: WorldHandle,
    branchId: BranchId,
): Result<BranchDescriptor, PlatformError>;

/// List branches in one world lineage.
@binding("destack.runtime.lineage.branchList", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function branchList(
    world: WorldHandle,
    filter?: BranchFilter,
    after?: BranchId,
    limit?: uint32,
): Result<Array<BranchDescriptor>, PlatformError>;

/// Describe one revision.
@binding("destack.runtime.lineage.revisionDescribe", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function revisionDescribe(
    world: WorldHandle,
    revisionId: RevisionId,
): Result<RevisionDescriptor, PlatformError>;

/// List revisions in one world lineage.
@binding("destack.runtime.lineage.revisionList", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function revisionList(
    world: WorldHandle,
    filter?: RevisionFilter,
    after?: RevisionId,
    limit?: uint32,
): Result<Array<RevisionDescriptor>, PlatformError>;

/// Create one checkpoint on the active branch.
@binding("destack.runtime.lineage.checkpointCreate", {
    effect: "deterministic",
    requires: ["runtime.lineage.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointCreate(
    world: WorldHandle,
    name?: string,
    labels?: Array<RuntimeLabel>,
): Result<CheckpointId, PlatformError>;

/// Describe one checkpoint.
@binding("destack.runtime.lineage.checkpointDescribe", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointDescribe(
    world: WorldHandle,
    checkpointId: CheckpointId,
): Result<CheckpointDescriptor, PlatformError>;

/// List checkpoints in one world lineage.
@binding("destack.runtime.lineage.checkpointList", {
    effect: "deterministic",
    requires: ["runtime.lineage.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointList(
    world: WorldHandle,
    filter?: CheckpointFilter,
    after?: CheckpointId,
    limit?: uint32,
): Result<Array<CheckpointDescriptor>, PlatformError>;

/// Rewind one world to one revision.
@binding("destack.runtime.lineage.worldRewindRevision", {
    effect: "deterministic",
    requires: ["runtime.lineage.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRewindRevision(
    world: WorldHandle,
    revisionId: RevisionId,
): Result<void, PlatformError>;

/// Rewind one world to one checkpoint.
@binding("destack.runtime.lineage.worldRewindCheckpoint", {
    effect: "deterministic",
    requires: ["runtime.lineage.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRewindCheckpoint(
    world: WorldHandle,
    checkpointId: CheckpointId,
): Result<void, PlatformError>;

/// Fork one child world from one revision.
@binding("destack.runtime.lineage.worldFork", {
    effect: "deterministic",
    requires: ["runtime.world.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldFork(
    world: WorldHandle,
    revisionId: RevisionId,
    name?: string,
    labels?: Array<RuntimeLabel>,
): Result<WorldHandle, PlatformError>;

/// Capture one image at the active revision.
@binding("destack.runtime.lineage.imageCapture", {
    effect: "deterministic",
    requires: ["runtime.snapshot.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageCapture(world: WorldHandle): Result<ImageId, PlatformError>;

/// Describe one image.
@binding("destack.runtime.lineage.imageDescribe", {
    effect: "deterministic",
    requires: ["runtime.snapshot.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageDescribe(
    world: WorldHandle,
    imageId: ImageId,
): Result<ImageDescriptor, PlatformError>;

/// List images in one world lineage.
@binding("destack.runtime.lineage.imageList", {
    effect: "deterministic",
    requires: ["runtime.snapshot.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageList(
    world: WorldHandle,
    filter?: ImageFilter,
    after?: ImageId,
    limit?: uint32,
): Result<Array<ImageDescriptor>, PlatformError>;
