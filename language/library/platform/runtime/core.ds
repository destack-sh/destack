import type { PlatformError } from "../error/index.ds";
import {
    WorkerCreateOptions,
    WorkerDescriptor,
    WorkerHandle,
    RuntimeCreateOptions,
    RuntimeDescriptor,
    RuntimeHandle,
    RuntimeTickOutcome,
    WorldCreateOptions,
    WorldDescriptor,
    WorldHandle,
} from "./types.ds";

/// Create one world.
@binding("destack.runtime.core.worldCreate", {
    effect: "deterministic",
    requires: ["runtime.world.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldCreate(options?: WorldCreateOptions): Result<WorldHandle, PlatformError>;

/// Close one world.
@binding("destack.runtime.core.worldClose", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldClose(world: WorldHandle): Result<void, PlatformError>;

/// Describe one world.
@binding("destack.runtime.core.worldDescribe", {
    effect: "deterministic",
    requires: ["runtime.world.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldDescribe(world: WorldHandle): Result<WorldDescriptor, PlatformError>;

/// Advance one world by one scheduler step.
@binding("destack.runtime.core.worldTick", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldTick(world: WorldHandle): Result<RuntimeTickOutcome, PlatformError>;

/// Spawn one runtime in one world.
@binding("destack.runtime.core.runtimeCreate", {
    effect: "deterministic",
    requires: ["runtime.runtime.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function runtimeCreate(
    world: WorldHandle,
    options?: RuntimeCreateOptions,
): Result<RuntimeHandle, PlatformError>;

/// Close one runtime.
@binding("destack.runtime.core.runtimeClose", {
    effect: "deterministic",
    requires: ["runtime.runtime.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function runtimeClose(runtimeHandle: RuntimeHandle): Result<void, PlatformError>;

/// Describe one runtime.
@binding("destack.runtime.core.runtimeDescribe", {
    effect: "deterministic",
    requires: ["runtime.runtime.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function runtimeDescribe(
    runtimeHandle: RuntimeHandle,
): Result<RuntimeDescriptor, PlatformError>;

/// Spawn one worker in one runtime.
@binding("destack.runtime.core.workerCreate", {
    effect: "deterministic",
    requires: ["runtime.worker.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function workerCreate(
    runtimeHandle: RuntimeHandle,
    options?: WorkerCreateOptions,
): Result<WorkerHandle, PlatformError>;

/// Close one worker.
@binding("destack.runtime.core.workerClose", {
    effect: "deterministic",
    requires: ["runtime.worker.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function workerClose(worker: WorkerHandle): Result<void, PlatformError>;

/// Describe one worker.
@binding("destack.runtime.core.workerDescribe", {
    effect: "deterministic",
    requires: ["runtime.worker.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function workerDescribe(worker: WorkerHandle): Result<WorkerDescriptor, PlatformError>;
