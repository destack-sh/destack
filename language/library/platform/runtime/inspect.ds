/// Open one pinned world view.
@binding("destack.runtime.inspect.worldViewOpen", {
    effect: "deterministic",
    requires: ["runtime.inspect.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldViewOpen(
    world: WorldHandle,
    options?: WorldViewOptions,
): Result<WorldViewHandle, PlatformError>;

/// Close one pinned world view.
@binding("destack.runtime.inspect.worldViewClose", {
    effect: "deterministic",
    requires: ["runtime.inspect.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldViewClose(view: WorldViewHandle): Result<void, PlatformError>;

