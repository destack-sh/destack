import { PlatformError } from "destack:platform/error";
import {
    CheckpointId,
    RevisionId,
    TraceCursorHandle,
    TraceCursorOptions,
    TraceDescriptor,
    TraceRecord,
    TraceSequence,
    WorldHandle,
} from "./types.ds";

/// Describe one world's causal trace.
@binding("destack.runtime.trace.describe", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceDescribe(world: WorldHandle): Result<TraceDescriptor, PlatformError>;

/// Open one causal trace cursor.
@binding("destack.runtime.trace.open", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceOpen(
    world: WorldHandle,
    options?: TraceCursorOptions,
): Result<TraceCursorHandle, PlatformError>;

/// Close one causal trace cursor.
@binding("destack.runtime.trace.close", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceClose(cursor: TraceCursorHandle): Result<void, PlatformError>;

/// Read the next batch of causal trace records.
@binding("destack.runtime.trace.next", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceNext(
    cursor: TraceCursorHandle,
    limit?: uint32,
): Result<Array<TraceRecord>, PlatformError>;

/// Return the current sequence position of one causal trace cursor.
@binding("destack.runtime.trace.tell", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceTell(cursor: TraceCursorHandle): Result<TraceSequence, PlatformError>;

/// Seek one causal trace cursor to one sequence.
@binding("destack.runtime.trace.seekSequence", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceSeekSequence(
    cursor: TraceCursorHandle,
    sequence: TraceSequence,
): Result<void, PlatformError>;

/// Seek one causal trace cursor to one revision boundary.
@binding("destack.runtime.trace.seekRevision", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceSeekRevision(
    cursor: TraceCursorHandle,
    revisionId: RevisionId,
): Result<void, PlatformError>;

/// Seek one causal trace cursor to one checkpoint boundary.
@binding("destack.runtime.trace.seekCheckpoint", {
    effect: "deterministic",
    requires: ["runtime.trace.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceSeekCheckpoint(
    cursor: TraceCursorHandle,
    checkpointId: CheckpointId,
): Result<void, PlatformError>;

/// Append one explicit trace marker.
@binding("destack.runtime.trace.mark", {
    effect: "deterministic",
    requires: ["runtime.trace.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function traceMark(
    world: WorldHandle,
    label: string,
): Result<TraceSequence, PlatformError>;
