import type { PlatformError } from "../error/index.ds";
import { SemaphoreHandle, SharedMemoryHandle } from "../resource/index.ds";

/// Create one named semaphore.
@binding("destack.ipc.sync.semaphoreCreate", {
    effect: "external",
    requires: ["ipc.semaphore"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function semaphoreCreate(
    name: string,
    initial: uint32,
    flags: uint32,
): Result<SemaphoreHandle, PlatformError>;

/// Wait one semaphore count.
@binding("destack.ipc.sync.semaphoreWait", {
    effect: "external",
    requires: ["ipc.semaphore"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function semaphoreWait(
    handle: SemaphoreHandle,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Increment one semaphore count.
@binding("destack.ipc.sync.semaphorePost", {
    effect: "external",
    requires: ["ipc.semaphore"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function semaphorePost(
    handle: SemaphoreHandle,
    count: uint32,
): Result<void, PlatformError>;

/// Wait on one shared-memory futex word.
@binding("destack.ipc.sync.futexWait", {
    effect: "external",
    requires: ["ipc.futex"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function futexWait(
    sharedMemory: SharedMemoryHandle,
    offset: uint64,
    expected: uint32,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Wake futex waiters for one shared-memory word.
@binding("destack.ipc.sync.futexWake", {
    effect: "external",
    requires: ["ipc.futex"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function futexWake(
    sharedMemory: SharedMemoryHandle,
    offset: uint64,
    count: uint32,
): Result<uint32, PlatformError>;
