import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketHandle, TransferredHandle } from "../resource/index.ds";

/// Peer credentials for one unix-domain socket endpoint.
export struct UnixPeerCredentials {
    /// Peer process identifier when available.
    pid: uint32 | void;
    /// Peer user identifier.
    uid: uint32;
    /// Peer group identifier.
    gid: uint32;
}

/// Received unix ancillary payload.
export struct UnixReceiveAncillary {
    /// Received payload bytes.
    bytes: uint64;
    /// Received transferred handles.
    handles: Array<TransferredHandle>;
    /// Peer credentials when available.
    credentials: UnixPeerCredentials | void;
}

/// Unix ancillary bindings.
/// Send payload and transferred handles.
///
/// Send one payload and optional transferred handles over a unix-domain socket.
/// Handle transfer semantics follow host ancillary message ownership rules.
///
/// # Platform
/// Unix.
/// Uses sendmsg with SCM_RIGHTS and optional credential control messages.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `ipc.unix`, `ipc.fd.pass`.
///
/// # Replay
/// External, recordable.
@binding("destack.ipc.unix.send", {
    effect: "external",
    replay: "recordable",
    capabilities: ["ipc.unix", "ipc.fd.pass"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function unixSend(
    socket: SocketHandle,
    payload: Slice<uint8>,
    handles: Slice<TransferredHandle>,
): Result<uint64, PlatformError>;

/// Receive payload and transferred handles.
///
/// Receive one ancillary message payload with transferred handles and credentials.
/// Handle ownership transfer is explicit and host-limited.
///
/// # Platform
/// Unix.
/// Uses recvmsg with SCM_RIGHTS and peer credential control messages.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `ipc.unix`, `ipc.fd.pass`.
///
/// # Replay
/// External, recordable.
@binding("destack.ipc.unix.receive", {
    effect: "external",
    replay: "recordable",
    capabilities: ["ipc.unix", "ipc.fd.pass"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function unixReceive(
    socket: SocketHandle,
    maxHandles: uint32,
): Result<UnixReceiveAncillary, PlatformError>;
