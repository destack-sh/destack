import type { PlatformError } from "../error/index.ds";
import { SocketHandle, TransferredHandle } from "../resource/index.ds";
import { MessageFlags } from "../net/socket.ds";

/// Unix peer credentials.
export struct UnixCredentials {
    /// Peer process identifier when available.
    pid?: uint32;
    /// Peer user identifier.
    uid: uint32;
    /// Peer group identifier.
    gid: uint32;
}

/// Unix message receive result.
export struct UnixMessage {
    /// Payload bytes copied into the caller buffer.
    bytes: uint64;
    /// Transferred handles copied into the caller buffer.
    handleCount: uint64;
    /// Message flags returned by the host.
    flags: MessageFlags;
    /// Peer credentials when available.
    credentials?: UnixCredentials;
}

/// Send one Unix-domain socket message with transferred handles.
@binding("destack.ipc.unix.send", {
    effect: "external",
    requires: ["ipc.unix", "ipc.handle.pass"],
    families: ["unix"],
    simulation: true,
})
export declare function sendUnixMessage(
    socket: SocketHandle,
    payload: &readonly [uint8],
    handles: &readonly [TransferredHandle],
    flags: MessageFlags,
): Result<uint64, PlatformError>;

/// Receive one Unix-domain socket message with transferred handles.
@binding("destack.ipc.unix.receive", {
    effect: "external",
    requires: ["ipc.unix", "ipc.handle.pass"],
    families: ["unix"],
    simulation: true,
})
export declare function receiveUnixMessage(
    socket: SocketHandle,
    payload: &[uint8],
    handles: &[TransferredHandle],
    flags: MessageFlags,
): Result<UnixMessage, PlatformError>;
