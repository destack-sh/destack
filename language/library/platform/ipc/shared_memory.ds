import type { PlatformError } from "../error/index.ds";
import { SharedMemoryHandle } from "../resource/index.ds";

/// Shared memory mapping result.
export struct SharedMemoryMapping {
    /// Base address in the process virtual space.
    address: uint64;
    /// Mapping length in bytes.
    length: uint64;
}

/// Create one named shared memory object.
@binding("destack.ipc.sharedMemory.create", {
    effect: "external",
    requires: ["ipc.shared.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sharedMemoryCreate(
    name: string,
    size: uint64,
    flags: uint32,
): Result<SharedMemoryHandle, PlatformError>;

/// Open one named shared memory object.
@binding("destack.ipc.sharedMemory.open", {
    effect: "external",
    requires: ["ipc.shared.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sharedMemoryOpen(
    name: string,
    flags: uint32,
): Result<SharedMemoryHandle, PlatformError>;

/// Close one shared memory object handle.
@binding("destack.ipc.sharedMemory.close", {
    effect: "external",
    requires: ["ipc.shared.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sharedMemoryClose(handle: SharedMemoryHandle): Result<void, PlatformError>;

/// Map one shared memory range.
@binding("destack.ipc.sharedMemory.map", {
    effect: "external",
    requires: ["ipc.shared.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sharedMemoryMap(
    handle: SharedMemoryHandle,
    offset: uint64,
    length: uint64,
    flags: uint32,
): Result<SharedMemoryMapping, PlatformError>;

/// Unmap one shared memory range.
@binding("destack.ipc.sharedMemory.unmap", {
    effect: "external",
    requires: ["ipc.shared.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sharedMemoryUnmap(address: uint64, length: uint64): Result<void, PlatformError>;
