import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { PipeHandle } from "../resource/index.ds";

/// Pair of pipe handles.
export struct PipePair {
    /// Read endpoint.
    read: PipeHandle;
    /// Write endpoint.
    write: PipeHandle;
}

/// Create one unnamed pipe pair.
@binding("destack.ipc.pipe.open", {
    effect: "external",
    requires: ["ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipeOpen(flags: uint32): Result<PipePair, PlatformError>;

/// Close one pipe endpoint.
@binding("destack.ipc.pipe.close", {
    effect: "external",
    requires: ["ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipeClose(handle: PipeHandle): Result<void, PlatformError>;

/// Read bytes from a pipe endpoint.
@binding("destack.ipc.pipe.read", {
    effect: "external",
    requires: ["ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipeRead(
    handle: PipeHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write bytes to a pipe endpoint.
@binding("destack.ipc.pipe.write", {
    effect: "external",
    requires: ["ipc.pipe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipeWrite(
    handle: PipeHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;
