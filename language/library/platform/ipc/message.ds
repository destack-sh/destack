import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { MessageQueueHandle } from "../resource/index.ds";

/// Message queue receive result.
export struct MessageQueueReceive {
    /// Number of payload bytes copied into the caller buffer.
    bytes: uint32;
    /// Priority value for the received message.
    priority: uint32;
}

/// Open or create a message queue.
@binding("destack.ipc.message.queueOpen", {
    effect: "external",
    requires: ["ipc.message"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function messageQueueOpen(
    name: string,
    flags: uint32,
    mode: uint32,
    maxMessages: uint32,
    maxMessageBytes: uint32,
): Result<MessageQueueHandle, PlatformError>;

/// Close a message queue.
@binding("destack.ipc.message.queueClose", {
    effect: "external",
    requires: ["ipc.message"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function messageQueueClose(handle: MessageQueueHandle): Result<void, PlatformError>;

/// Remove a named message queue.
@binding("destack.ipc.message.queueUnlink", {
    effect: "external",
    requires: ["ipc.message"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function messageQueueUnlink(name: string): Result<void, PlatformError>;

/// Send one message to a queue.
@binding("destack.ipc.message.queueSend", {
    effect: "external",
    requires: ["ipc.message"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function messageQueueSend(
    handle: MessageQueueHandle,
    priority: uint32,
    timeoutNs: uint64,
    payload: Slice<uint8>,
): Result<void, PlatformError>;

/// Receive one message from a queue.
@binding("destack.ipc.message.queueReceive", {
    effect: "external",
    requires: ["ipc.message"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function messageQueueReceive(
    handle: MessageQueueHandle,
    timeoutNs: uint64,
    buffer: Slice<uint8>,
): Result<MessageQueueReceive, PlatformError>;
