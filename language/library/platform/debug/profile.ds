import type { PlatformError } from "../error/index.ds";
import { ProfileHandle } from "../resource/index.ds";

/// Profiling session kind.
export enum ProfileKind {
    /// CPU sampling profile.
    Cpu = 1,
    /// Heap allocation profile.
    Heap = 2,
    /// Runtime event profile.
    Event = 3,
}

/// Profiling control bindings.
/// Start a profiling session.
///
/// Start one runtime profiler with the selected profile kind.
/// Sampling cadence and event capture depend on runtime profiling policy.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime profiler integration, optionally backed by host perf APIs.
///
/// # Errors
/// Returns invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `debug.profile`.
///
/// # Replay
/// External, recordable.
@binding("destack.debug.profile.start", {
    effect: "external",
    replay: "recordable",
    capabilities: ["debug.profile"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "sometimes",
    affinity: "any",
})
export declare function profileStart(kind: ProfileKind): Result<ProfileHandle, PlatformError>;

/// Stop a profiling session.
///
/// Stop one active profiling session and release profiler resources.
/// Profile data remains available for snapshot export until explicit cleanup.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime profiler teardown.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `debug.profile`.
///
/// # Replay
/// External, recordable.
@binding("destack.debug.profile.stop", {
    effect: "external",
    replay: "recordable",
    capabilities: ["debug.profile"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "sometimes",
    affinity: "any",
})
export declare function profileStop(handle: ProfileHandle): Result<void, PlatformError>;

/// Capture a profiling snapshot.
///
/// Export one profile snapshot as bytes for offline analysis.
/// Output format is runtime-defined but versioned for tooling compatibility.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime profiler snapshot serialization.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `debug.profile`.
///
/// # Replay
/// External, recordable.
@binding("destack.debug.profile.snapshot", {
    effect: "external",
    replay: "recordable",
    capabilities: ["debug.profile"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "sometimes",
    affinity: "any",
})
export declare function profileSnapshot(handle: ProfileHandle): Result<Array<uint8>, PlatformError>;
