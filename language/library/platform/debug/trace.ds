import { PlatformError } from "destack:platform/error";
import { TraceHandle } from "destack:platform/resource";

/// Trace verbosity level.
export enum TraceLevel {
    /// Emit critical events only.
    Error = 1,
    /// Emit warning and critical events.
    Warn = 2,
    /// Emit informational and above events.
    Info = 3,
    /// Emit verbose diagnostic events.
    Debug = 4,
}

/// Start a debug trace stream.
@binding("destack.debug.trace.start", {
    effect: "external",
    requires: ["debug.trace"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function traceStart(
    level: TraceLevel,
    destination: string,
): Result<TraceHandle, PlatformError>;

/// Stop a debug trace stream.
@binding("destack.debug.trace.stop", {
    effect: "external",
    requires: ["debug.trace"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function traceStop(handle: TraceHandle): Result<void, PlatformError>;

/// Emit one debug trace event.
@binding("destack.debug.trace.emit", {
    effect: "external",
    requires: ["debug.trace"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function traceEmit(
    category: string,
    name: string,
    payloadJson: string,
): Result<void, PlatformError>;
