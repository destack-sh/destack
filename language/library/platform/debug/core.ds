import type { PlatformError } from "../error/index.ds";

/// Mark a debug timeline point.
@binding("destack.debug.core.mark", {
    effect: "external",
    requires: ["debug.trace"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function mark(label: string): Result<void, PlatformError>;

/// Request a runtime debug break.
@binding("destack.debug.core.breakNow", {
    effect: "external",
    requires: ["debug.inspect"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function breakNow(): Result<void, PlatformError>;
