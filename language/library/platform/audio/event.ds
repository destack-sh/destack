import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { AudioEventHandle, AudioStreamHandle } from "../resource/index.ds";
import { AudioBackend, AudioBackendSelectionPolicy } from "./backend.ds";
import { AudioStreamStatusFlags } from "./stream.ds";

/// Event subscription flags.
export newtype AudioEventSubscriptionFlags = uint32;

/// Event delivery mode selector.
export enum AudioEventDeliveryMode {
    /// Use native backend events when available, otherwise synthesize from polling.
    Auto = 1,
    /// Require native backend events and fail when unavailable.
    NativeOnly = 2,
    /// Force synthesized polling-driven events.
    PollOnly = 3,
}

/// Event queue overflow policy selector.
export enum AudioEventOverflowPolicy {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report overflow as an error.
    Error = 3,
}

/// Event source selector.
export enum AudioEventSource {
    /// Event came from one native backend notification feed.
    Native = 1,
    /// Event was synthesized from runtime polling snapshots.
    SyntheticPoll = 2,
}

/// Shared metadata for all audio events.
export struct AudioEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number for one subscription queue.
    sequence: uint64;
    /// Number of events dropped before this event.
    droppedCount: uint64;
    /// Event source selector.
    source: AudioEventSource;
    /// Backend selector for this event.
    backend: AudioBackend;
    /// Event flags.
    flags: uint32;
}

/// Device-added event.
export struct AudioDeviceAddedEvent {
    /// Discriminator for this audio event variant.
    kind: "deviceAdded";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Device-removed event.
export struct AudioDeviceRemovedEvent {
    /// Discriminator for this audio event variant.
    kind: "deviceRemoved";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Default-playback-changed event.
export struct AudioDefaultPlaybackChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "defaultPlaybackChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Default-capture-changed event.
export struct AudioDefaultCaptureChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "defaultCaptureChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Default-loopback-changed event.
export struct AudioDefaultLoopbackChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "defaultLoopbackChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Device-format-changed event.
export struct AudioDeviceFormatChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "deviceFormatChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Device-rerouted event.
export struct AudioDeviceReroutedEvent {
    /// Discriminator for this audio event variant.
    kind: "deviceRerouted";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Interruption-began event.
export struct AudioInterruptionBeganEvent {
    /// Discriminator for this audio event variant.
    kind: "interruptionBegan";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
}

/// Interruption-ended event.
export struct AudioInterruptionEndedEvent {
    /// Discriminator for this audio event variant.
    kind: "interruptionEnded";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
}

/// Backend-disconnected event.
export struct AudioBackendDisconnectedEvent {
    /// Discriminator for this audio event variant.
    kind: "backendDisconnected";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
}

/// Stream-xrun event.
export struct AudioStreamXRunEvent {
    /// Discriminator for this audio event variant.
    kind: "streamXRun";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
    /// Current stream status flags.
    statusFlags: AudioStreamStatusFlags;
    /// Xrun count delta for this event.
    xrunCountDelta: uint64;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Stream-device-changed event.
export struct AudioStreamDeviceChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "streamDeviceChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
    /// Current stream status flags.
    statusFlags: AudioStreamStatusFlags;
    /// Target device identifier when present.
    deviceId: string | void;
}

/// Stream-state-changed event.
export struct AudioStreamStateChangedEvent {
    /// Discriminator for this audio event variant.
    kind: "streamStateChanged";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
    /// Current stream status flags.
    statusFlags: AudioStreamStatusFlags;
}

/// Backend-reset event.
export struct AudioBackendResetEvent {
    /// Discriminator for this audio event variant.
    kind: "backendReset";
    /// Shared event metadata.
    metadata: AudioEventMetadata;
    /// Target stream handle when present.
    stream: AudioStreamHandle | void;
}

/// Event subscription options.
export struct AudioEventSubscriptionOptions {
    /// Backend selector for this subscription.
    backend: AudioBackend;
    /// Backend selection policy.
    backendPolicy: AudioBackendSelectionPolicy;
    /// Subscription behavior flags.
    flags: AudioEventSubscriptionFlags;
    /// Event delivery mode.
    deliveryMode: AudioEventDeliveryMode;
    /// Queue overflow policy.
    overflowPolicy: AudioEventOverflowPolicy;
    /// Stream to monitor when provided.
    stream: AudioStreamHandle | void;
    /// Requested queue capacity, or zero for backend default.
    queueCapacity: uint32;
    /// Requested backend poll interval in nanoseconds, or zero for backend default.
    pollIntervalNs: uint64;
}

/// Audio event payload.
export newtype AudioEvent =
    | AudioDeviceAddedEvent
    | AudioDeviceRemovedEvent
    | AudioDefaultPlaybackChangedEvent
    | AudioDefaultCaptureChangedEvent
    | AudioDefaultLoopbackChangedEvent
    | AudioDeviceFormatChangedEvent
    | AudioDeviceReroutedEvent
    | AudioInterruptionBeganEvent
    | AudioInterruptionEndedEvent
    | AudioBackendDisconnectedEvent
    | AudioStreamXRunEvent
    | AudioStreamDeviceChangedEvent
    | AudioStreamStateChangedEvent
    | AudioBackendResetEvent;

/// Open one audio event subscription.
@binding("destack.audio.event.open", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventOpen(
    options: AudioEventSubscriptionOptions,
): Result<AudioEventHandle, PlatformError>;

/// Close one audio event subscription.
@binding("destack.audio.event.close", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventClose(handle: AudioEventHandle): Result<void, PlatformError>;

/// Wait for one audio event.
@binding("destack.audio.event.read", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventRead(
    handle: AudioEventHandle,
    timeoutNs: uint64,
): Result<AudioEvent, PlatformError>;

/// Wait for one batch of audio events.
@binding("destack.audio.event.readBatch", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventReadBatch(
    handle: AudioEventHandle,
    maxEvents: uint32,
    timeoutNs: uint64,
): Result<Slice<AudioEvent>, PlatformError>;

/// Poll one audio event without blocking.
@binding("destack.audio.event.tryRead", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventTryRead(handle: AudioEventHandle): Result<AudioEvent, PlatformError>;

/// Poll one batch of audio events without blocking.
@binding("destack.audio.event.tryReadBatch", {
    effect: "external",
    requires: ["audio.device.monitor"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventTryReadBatch(
    handle: AudioEventHandle,
    maxEvents: uint32,
): Result<Slice<AudioEvent>, PlatformError>;

/// Subscribe to device hotplug add and remove events.
export const AUDIO_EVENT_SUBSCRIBE_DEVICE_HOTPLUG: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x1);
/// Subscribe to default-route change events.
export const AUDIO_EVENT_SUBSCRIBE_DEFAULT_ROUTE: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x2);
/// Subscribe to format-change events.
export const AUDIO_EVENT_SUBSCRIBE_FORMAT_CHANGE: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x4);
/// Subscribe to reroute events.
export const AUDIO_EVENT_SUBSCRIBE_REROUTE: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x8);
/// Subscribe to interruption begin and end events.
export const AUDIO_EVENT_SUBSCRIBE_INTERRUPTION: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x10);
/// Subscribe to backend disconnect and reset events.
export const AUDIO_EVENT_SUBSCRIBE_BACKEND: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x20);
/// Subscribe to stream xrun, state, and device-change events.
export const AUDIO_EVENT_SUBSCRIBE_STREAM: AudioEventSubscriptionFlags =
    AudioEventSubscriptionFlags(0x40);
