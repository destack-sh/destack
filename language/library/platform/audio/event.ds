import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { AudioEventHandle, AudioStreamHandle } from "destack:platform/resource";
import { AudioBackendKind, AudioBackendSelection } from "./backend.ds";
import { AudioDirection } from "./device.ds";
import { AudioStreamState } from "./stream.ds";

/// Audio event subscription flags.
export newtype AudioEventFlags = uint32;

/// Subscribe to device hotplug events.
export const AUDIO_EVENT_DEVICE: AudioEventFlags = AudioEventFlags(0x1);

/// Subscribe to default-route change events.
export const AUDIO_EVENT_ROUTE: AudioEventFlags = AudioEventFlags(0x2);

/// Subscribe to stream state and xrun events.
export const AUDIO_EVENT_STREAM: AudioEventFlags = AudioEventFlags(0x4);

/// Subscribe to backend availability events.
export const AUDIO_EVENT_BACKEND: AudioEventFlags = AudioEventFlags(0x8);

/// Audio event overflow policy.
export enum AudioEventOverflow {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report queue overflow as an error.
    Error = 3,
}

/// Audio event subscription.
export struct AudioEventSubscription {
    /// Backend selection.
    backend: AudioBackendSelection;
    /// Event flags.
    flags: AudioEventFlags;
    /// Stream to monitor, omitted for backend and device events.
    stream?: AudioStreamHandle;
    /// Queue capacity in events, or zero for backend default.
    capacity: uint32;
    /// Queue overflow policy.
    overflow: AudioEventOverflow;
}

/// Audio event.
export newtype AudioEvent =
    | {
          kind: "device";
          timestampNs: uint64;
          sequence: uint64;
          backend: AudioBackendKind;
          deviceId: string;
          direction: AudioDirection;
          isPresent: boolean;
          isDefault: boolean;
      }
    | {
          kind: "stream";
          timestampNs: uint64;
          sequence: uint64;
          stream: AudioStreamHandle;
          state: AudioStreamState;
          xrunCount: uint64;
      }
    | {
          kind: "backend";
          timestampNs: uint64;
          sequence: uint64;
          backend: AudioBackendKind;
          isAvailable: boolean;
      }
    | { kind: "overflow"; timestampNs: uint64; sequence: uint64; droppedCount: uint64 };

/// Open one audio event subscription.
@binding("destack.audio.event.open", {
    effect: "external",
    requires: ["host.audio.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openAudioEvents(
    subscription: &readonly AudioEventSubscription,
): Result<AudioEventHandle, PlatformError>;

/// Close one audio event subscription.
@binding("destack.audio.event.close", {
    effect: "external",
    requires: ["host.audio.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeAudioEvents(events: AudioEventHandle): Result<void, PlatformError>;

/// Read audio events.
@binding("destack.audio.event.read", {
    effect: "external",
    requires: ["host.audio.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readAudioEvents(
    events: AudioEventHandle,
    maxEvents: uint32,
    timeoutNs?: uint64,
): Result<^Array<AudioEvent>, PlatformError>;
