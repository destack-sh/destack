import { PlatformError } from "destack:platform/error";
import { LibraryHandle, SymbolHandle } from "destack:platform/resource";

/// Resolve a symbol from a loaded library.
@binding("destack.ffi.symbol.lookup", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.ffi.symbol"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function symbolLookup(
    library: LibraryHandle,
    name: string,
): Result<SymbolHandle, PlatformError>;

/// Return a raw address for a resolved symbol handle.
@binding("destack.ffi.symbol.address", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.ffi.symbol"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function symbolAddress(symbol: SymbolHandle): Result<uint64, PlatformError>;
