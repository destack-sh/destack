import type { PlatformError } from "../error/index.ds";

/// Opaque foreign pointer.
export newtype FfiPointer = uint64;

/// Create a pointer from a raw address.
@binding("destack.ffi.pointer.fromAddress", {
    effect: "deterministic",
    requires: ["ffi.pointer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function fromAddress(address: uint64): Result<FfiPointer, PlatformError>;

/// Return the raw address for an opaque pointer.
@binding("destack.ffi.pointer.address", {
    effect: "deterministic",
    requires: ["ffi.pointer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function address(pointer: FfiPointer): Result<uint64, PlatformError>;
