import type { PlatformError } from "../error/index.ds";
import { LibraryHandle } from "../resource/index.ds";
import { Path } from "../fs/path.ds";

/// Open a dynamic library.
@binding("destack.ffi.library.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["ffi.load"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function open(path: Path, flags: uint32): Result<LibraryHandle, PlatformError>;

/// Close a dynamic library.
@binding("destack.ffi.library.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["ffi.load"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function close(handle: LibraryHandle): Result<void, PlatformError>;
