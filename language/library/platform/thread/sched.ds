import type { PlatformError } from "../error/index.ds";
import { ThreadHandle } from "../resource/index.ds";

/// Logical processor identifier for thread affinity.
export struct ThreadCpu {
    /// Processor group on hosts that partition logical processors.
    /// Unix targets always use `0`.
    group: uint16;
    /// Logical processor index within the processor group.
    cpu: uint16;
}

/// CPU affinity set for one thread.
export struct ThreadCpuSet {
    /// Logical processors in the affinity set.
    cpus: ThreadCpu[];
}

/// Set thread priority.
@binding("destack.thread.sched.setPriority", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.sched"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPriority(handle: ThreadHandle, priority: int32): Result<void, PlatformError>;

/// Read thread priority.
@binding("destack.thread.sched.getPriority", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.sched"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getPriority(handle: ThreadHandle): Result<int32, PlatformError>;

/// Set thread CPU affinity.
@binding("destack.thread.sched.setAffinity", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.sched"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setAffinity(
    handle: ThreadHandle,
    cpus: ThreadCpuSet,
): Result<void, PlatformError>;

/// Read thread CPU affinity.
@binding("destack.thread.sched.getAffinity", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.sched"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getAffinity(handle: ThreadHandle): Result<ThreadCpuSet, PlatformError>;
