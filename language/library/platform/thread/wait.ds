import type { PlatformError } from "../error/index.ds";

/// Wait on one memory address value.
@binding("destack.thread.wait.addressWait", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addressWait(
    address: uint64,
    expected: uint32,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Wake one waiter on one memory address.
@binding("destack.thread.wait.addressWakeOne", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addressWakeOne(address: uint64): Result<void, PlatformError>;

/// Wake all waiters on one memory address.
@binding("destack.thread.wait.addressWakeAll", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addressWakeAll(address: uint64): Result<void, PlatformError>;
