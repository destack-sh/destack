import type { PlatformError } from "../error/index.ds";
import { ThreadEntryHandle, ThreadHandle } from "../resource/index.ds";

/// Thread spawn options.
export struct ThreadOptions {
    /// Requested stack size in bytes.
    stackBytes: uint64;
    /// Thread creation flags.
    flags: uint32;
}

/// Spawn one host thread.
@binding("destack.thread.spawn.start", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.spawn"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function spawn(
    entry: ThreadEntryHandle,
    argument: uint64,
    options: ThreadOptions,
): Result<ThreadHandle, PlatformError>;

/// Join one host thread.
@binding("destack.thread.spawn.join", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.spawn"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function join(handle: ThreadHandle): Result<uint64, PlatformError>;

/// Detach one host thread.
@binding("destack.thread.spawn.detach", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.spawn"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function detach(handle: ThreadHandle): Result<void, PlatformError>;
