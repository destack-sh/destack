import type { PlatformError } from "../error/index.ds";
import { ThreadLocalKey } from "../resource/index.ds";

/// Create one thread-local key.
@binding("destack.thread.local.create", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.local"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function localCreate(): Result<ThreadLocalKey, PlatformError>;

/// Store one thread-local value.
@binding("destack.thread.local.set", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.local"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function localSet(key: ThreadLocalKey, value: uint64): Result<void, PlatformError>;

/// Read one thread-local value.
@binding("destack.thread.local.get", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.local"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function localGet(key: ThreadLocalKey): Result<uint64, PlatformError>;

/// Delete one thread-local key.
@binding("destack.thread.local.delete", {
    effect: "external",
    replay: "forbidden",
    requires: ["thread.local"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function localDelete(key: ThreadLocalKey): Result<void, PlatformError>;
