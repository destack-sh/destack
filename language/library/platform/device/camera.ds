    effect: "external",
    replay: "recordable",
    capabilities: ["device.camera.capture"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function cameraStreamTakePhoto(
    handle: CameraStreamHandle,
    settings: CameraPhotoSettings,
    timeoutNs: uint64,
): Result<CameraPhoto, PlatformError>;
