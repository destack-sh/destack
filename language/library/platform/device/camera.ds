@binding("destack.device.camera.stream.photoState", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.camera.capture"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function cameraStreamPhotoState(
    handle: CameraStreamHandle,
