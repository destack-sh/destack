import { Slice } from "core";
import type { PlatformError } from "../../error/index.ds";
import { MidiEventHandle } from "../../resource/index.ds";
import { MidiBackend, MidiBackendSelectionPolicy } from "./backend.ds";
import { MidiPortDescriptor, MidiPortDirection, MidiPortDirectionFlags } from "./port.ds";

/// MIDI event subscription flags.
export newtype MidiEventSubscriptionFlags = uint32;

/// MIDI event delivery mode selector.
export enum MidiEventDeliveryMode {
    /// Use native backend events when available, otherwise synthesize from polling.
    Auto = 1,
    /// Require native backend events and fail when unavailable.
    NativeOnly = 2,
    /// Force synthesized polling-driven events.
    PollOnly = 3,
}

/// MIDI event queue overflow policy selector.
export enum MidiEventOverflowPolicy {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report overflow as an error.
    Error = 3,
}

/// MIDI event source selector.
export enum MidiEventSource {
    /// Event came from one native backend notification feed.
    Native = 1,
    /// Event was synthesized from runtime polling snapshots.
    SyntheticPoll = 2,
}

/// Shared metadata for all MIDI topology events.
export struct MidiEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number for one subscription queue.
    sequence: uint64;
    /// Number of events dropped before this event.
    droppedCount: uint64;
    /// Event source selector.
    source: MidiEventSource;
    /// Backend selector for this event.
    backend: MidiBackend;
}

/// MIDI port-added event.
export struct MidiPortAddedEvent {
    /// Discriminator for this MIDI event variant.
    kind: "portAdded";
    /// Shared event metadata.
    metadata: MidiEventMetadata;
    /// Direction for the added endpoint.
    direction: MidiPortDirection;
    /// Added endpoint descriptor.
    descriptor: MidiPortDescriptor;
}

/// MIDI port-removed event.
export struct MidiPortRemovedEvent {
    /// Discriminator for this MIDI event variant.
    kind: "portRemoved";
    /// Shared event metadata.
    metadata: MidiEventMetadata;
    /// Direction for the removed endpoint.
    direction: MidiPortDirection;
    /// Stable runtime endpoint identifier.
    id: string;
    /// Stable runtime group identifier when still known.
    groupId: string | void;
}

/// MIDI port-changed event.
export struct MidiPortChangedEvent {
    /// Discriminator for this MIDI event variant.
    kind: "portChanged";
    /// Shared event metadata.
    metadata: MidiEventMetadata;
    /// Direction for the changed endpoint.
    direction: MidiPortDirection;
    /// Updated endpoint descriptor.
    descriptor: MidiPortDescriptor;
}

/// MIDI backend-disconnected event.
export struct MidiBackendDisconnectedEvent {
    /// Discriminator for this MIDI event variant.
    kind: "backendDisconnected";
    /// Shared event metadata.
    metadata: MidiEventMetadata;
    /// Reserved for future backend-specific detail flags.
    flags: uint32;
}

/// MIDI event subscription options.
export struct MidiEventSubscriptionOptions {
    /// Backend selector for this subscription.
    backend: MidiBackend;
    /// Backend selection policy.
    backendPolicy: MidiBackendSelectionPolicy;
    /// Subscription behavior flags.
    flags: MidiEventSubscriptionFlags;
    /// Endpoint directions to include in this subscription.
    /// Zero is invalid.
    directionMask: MidiPortDirectionFlags;
    /// Event delivery mode.
    deliveryMode: MidiEventDeliveryMode;
    /// Queue overflow policy.
    overflowPolicy: MidiEventOverflowPolicy;
    /// Requested queue capacity, or zero for backend default.
    queueCapacity: uint32;
    /// Requested backend poll interval in nanoseconds, or zero for backend default.
    pollIntervalNs: uint64;
}

/// Include virtual endpoints in synthesized polling snapshots when the backend can report them.
export const MIDI_EVENT_SUBSCRIPTION_INCLUDE_VIRTUAL: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x1);

/// Include disconnected endpoints in synthesized polling snapshots when the backend can report them.
export const MIDI_EVENT_SUBSCRIPTION_INCLUDE_DISCONNECTED: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x2);

/// MIDI event payload.
export newtype MidiEvent =
    | MidiPortAddedEvent
    | MidiPortRemovedEvent
    | MidiPortChangedEvent
    | MidiBackendDisconnectedEvent;

/// MIDI event bindings.
/// Open one MIDI topology event subscription.
///
/// Open one backend event subscription for MIDI topology changes.
/// Subscription routing and queue depth follow host backend behavior.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function eventOpen(
    options: MidiEventSubscriptionOptions,
): Result<MidiEventHandle, PlatformError>;

/// Close one MIDI topology event subscription.
///
/// Close one MIDI event subscription and release backend notification resources.
/// Pending events are discarded.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function eventClose(handle: MidiEventHandle): Result<void, PlatformError>;

/// Wait for one MIDI topology event.
///
/// Wait for one pending event from one subscription queue.
/// Timeout uses nanoseconds in the runtime monotonic domain.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function eventRead(
    handle: MidiEventHandle,
    timeoutNs: uint64,
): Result<MidiEvent, PlatformError>;

/// Wait for one batch of MIDI topology events.
///
/// Wait for pending events from one subscription queue and return up to `maxEvents`.
/// Timeout uses nanoseconds in the runtime monotonic domain.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.readBatch", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function eventReadBatch(
    handle: MidiEventHandle,
    maxEvents: uint32,
    timeoutNs: uint64,
): Result<Slice<MidiEvent>, PlatformError>;

/// Poll one MIDI topology event without blocking.
///
/// Poll one pending event from one subscription queue.
/// Empty queue state is reported through ioWouldBlock.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.tryRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function eventTryRead(handle: MidiEventHandle): Result<MidiEvent, PlatformError>;

/// Poll one batch of MIDI topology events without blocking.
///
/// Poll pending events from one subscription queue and return up to `maxEvents`.
/// Empty queue state is reported through ioWouldBlock.
///
/// # Platform
/// Android, Unix, Windows, and iOS.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.midi.observe`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.midi.event.tryReadBatch", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.midi.observe"],
    platforms: ["android", "windows", "unix", "ios"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function eventTryReadBatch(
    handle: MidiEventHandle,
    maxEvents: uint32,
): Result<Slice<MidiEvent>, PlatformError>;

/// Subscribe to port-added notifications.
export const MIDI_EVENT_SUBSCRIBE_PORT_ADDED: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x1);

/// Subscribe to port-removed notifications.
export const MIDI_EVENT_SUBSCRIBE_PORT_REMOVED: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x2);

/// Subscribe to port-changed notifications.
export const MIDI_EVENT_SUBSCRIBE_PORT_CHANGED: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x4);

/// Subscribe to backend-disconnected notifications.
export const MIDI_EVENT_SUBSCRIBE_BACKEND_DISCONNECTED: MidiEventSubscriptionFlags =
    MidiEventSubscriptionFlags(0x8);
