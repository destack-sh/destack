import { Array, Slice } from "core";
import type { PlatformError } from "../../error/index.ds";
import { MidiOutputPortHandle } from "../../resource/index.ds";
import {
    MidiOutputPortOpenOptions,
    MidiPortDescriptor,
    MidiPortListOptions,
    MidiVirtualOutputCreateOptions,
} from "./port.ds";
import { MidiDataFormat, MidiProtocol, MidiRecordFraming } from "./protocol.ds";

/// One outbound MIDI transport record.
export struct MidiOutputRecord {
    /// Scheduled send timestamp in nanoseconds in the runtime monotonic domain when supported.
    sendAtNs: uint64 | void;
    /// Transport data format for this record payload.
    dataFormat: MidiDataFormat;
    /// Protocol semantics for this record payload when the backend reports them.
    /// `Midi2` requires `Ump`.
    protocol: MidiProtocol | void;
    /// Transport framing for this record payload.
    framing: MidiRecordFraming;
    /// Raw record payload bytes.
    /// This stores one low-level transport record in the selected data format.
    /// For `Midi1Bytes`, this stores the backend-native record bytes for this fragment or complete record.
    /// For `Ump`, this stores one or more whole packed 32-bit words in big-endian byte order.
    data: Slice<uint8>;
}

/// List available MIDI output endpoints.
@binding("destack.device.midi.output.port.list", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputPortList(
    options: MidiPortListOptions,
): Result<Slice<MidiPortDescriptor>, PlatformError>;

/// Open one MIDI output endpoint.
@binding("destack.device.midi.output.port.open", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputPortOpen(
    id: string,
    options: MidiOutputPortOpenOptions,
): Result<MidiOutputPortHandle, PlatformError>;

/// Describe one opened MIDI output endpoint.
@binding("destack.device.midi.output.port.descriptor", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputPortDescriptor(
    handle: MidiOutputPortHandle,
): Result<MidiPortDescriptor, PlatformError>;

/// Close one opened MIDI output endpoint.
@binding("destack.device.midi.output.port.close", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputPortClose(handle: MidiOutputPortHandle): Result<void, PlatformError>;

/// Write one batch of outbound MIDI records.
@binding("destack.device.midi.output.write", {
    effect: "external",
    requires: ["device.midi.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputWrite(
    handle: MidiOutputPortHandle,
    records: Array<MidiOutputRecord>,
): Result<uint32, PlatformError>;

/// Create one virtual MIDI output endpoint.
@binding("destack.device.midi.output.virtual.create", {
    effect: "external",
    requires: ["device.midi.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function outputVirtualCreate(
    options: MidiVirtualOutputCreateOptions,
): Result<MidiOutputPortHandle, PlatformError>;
