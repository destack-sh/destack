import { Array, Slice } from "core";
import type { PlatformError } from "../../error/index.ds";
import { MidiInputPortHandle } from "../../resource/index.ds";
import {
    MidiInputPortOpenOptions,
    MidiPortDescriptor,
    MidiPortListOptions,
    MidiVirtualInputCreateOptions,
} from "./port.ds";
import { MidiDataFormat, MidiProtocol, MidiRecordFraming } from "./protocol.ds";

/// One inbound MIDI transport record.
export struct MidiInputRecord {
    /// Receive timestamp in nanoseconds in the runtime monotonic domain.
    receivedAtNs: uint64;
    /// Stable identifier for the source endpoint when the backend reports one.
    sourceId: string | void;
    /// Transport data format for this record payload.
    dataFormat: MidiDataFormat;
    /// Protocol semantics for this record payload when the backend reports them.
    /// `Midi2` requires `Ump`.
    protocol: MidiProtocol | void;
    /// Transport framing for this record payload.
    framing: MidiRecordFraming;
    /// Raw record payload bytes.
    /// This stores one low-level transport record in the selected data format.
    /// For `Midi1Bytes`, this stores the backend-native record bytes for this fragment or complete record.
    /// For `Ump`, this stores one or more whole packed 32-bit words in big-endian byte order.
    data: Slice<uint8>;
}

/// List available MIDI input endpoints.
@binding("destack.device.midi.input.port.list", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputPortList(
    options: MidiPortListOptions,
): Result<Slice<MidiPortDescriptor>, PlatformError>;

/// Open one MIDI input endpoint.
@binding("destack.device.midi.input.port.open", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputPortOpen(
    id: string,
    options: MidiInputPortOpenOptions,
): Result<MidiInputPortHandle, PlatformError>;

/// Describe one opened MIDI input endpoint.
@binding("destack.device.midi.input.port.descriptor", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputPortDescriptor(
    handle: MidiInputPortHandle,
): Result<MidiPortDescriptor, PlatformError>;

/// Close one opened MIDI input endpoint.
@binding("destack.device.midi.input.port.close", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputPortClose(handle: MidiInputPortHandle): Result<void, PlatformError>;

/// Read one MIDI input record.
@binding("destack.device.midi.input.read", {
    effect: "external",
    requires: ["device.midi.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputRead(
    handle: MidiInputPortHandle,
    timeoutNs: uint64,
): Result<MidiInputRecord, PlatformError>;

/// Read one batch of MIDI input records.
@binding("destack.device.midi.input.readBatch", {
    effect: "external",
    requires: ["device.midi.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputReadBatch(
    handle: MidiInputPortHandle,
    maxRecords: uint32,
    timeoutNs: uint64,
): Result<Array<MidiInputRecord>, PlatformError>;

/// Poll one MIDI input record without blocking.
@binding("destack.device.midi.input.tryRead", {
    effect: "external",
    requires: ["device.midi.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputTryRead(
    handle: MidiInputPortHandle,
): Result<MidiInputRecord, PlatformError>;

/// Poll one batch of MIDI input records without blocking.
@binding("destack.device.midi.input.tryReadBatch", {
    effect: "external",
    requires: ["device.midi.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputTryReadBatch(
    handle: MidiInputPortHandle,
    maxRecords: uint32,
): Result<Array<MidiInputRecord>, PlatformError>;

/// Create one virtual MIDI input endpoint.
@binding("destack.device.midi.input.virtual.create", {
    effect: "external",
    requires: ["device.midi.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function inputVirtualCreate(
    options: MidiVirtualInputCreateOptions,
): Result<MidiInputPortHandle, PlatformError>;
