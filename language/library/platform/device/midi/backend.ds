import { Slice } from "core";
import type { BackendSupport } from "../../core/index.ds";
import type { PlatformError } from "../../error/index.ds";
import { MidiDataFormatFlags, MidiProtocolFlags } from "./protocol.ds";

/// MIDI backend selector.
export enum MidiBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// ALSA backend.
    Alsa = 1,
    /// JACK MIDI backend.
    JackMidi = 2,
    /// CoreMIDI backend.
    CoreMIDI = 3,
    /// Windows MIDI Services backend.
    WindowsMidi = 4,
    /// WinMM MIDI backend.
    WinMM = 5,
    /// WinRT MIDI backend.
    WinRT = 6,
    /// Android MIDI backend.
    AndroidMidi = 7,
    /// Null backend for tests and simulation.
    Null = 255,
}

/// Backend selection policy.
export enum MidiBackendSelectionPolicy {
    /// Require that the requested backend is used with no fallback.
    Strict = 1,
    /// Allow fallback to a host-default backend when the requested backend is unavailable.
    AllowFallback = 2,
}

/// MIDI backend action flags.
export newtype MidiBackendCapabilityFlags = uint64;

/// MIDI backend descriptor.
export struct MidiBackendDescriptor {
    /// Backend selector.
    backend: MidiBackend;
    /// Stable backend name.
    name: string;
    /// Host backend support state for this selector.
    support: BackendSupport;
    /// Priority in default auto-selection order, or zero when auto does not consider this selector.
    priority: uint16;
    /// Backend-level action flags.
    capabilityFlags: MidiBackendCapabilityFlags;
    /// Supported transport data formats for this backend.
    supportedDataFormats: MidiDataFormatFlags;
    /// Supported protocol flags for this backend.
    supportedProtocols: MidiProtocolFlags;
}

/// Backend supports topology notifications.
export const MIDI_BACKEND_CAP_TOPOLOGY_EVENTS: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x1);

/// Backend supports virtual input endpoints.
export const MIDI_BACKEND_CAP_VIRTUAL_INPUT: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x2);

/// Backend supports virtual output endpoints.
export const MIDI_BACKEND_CAP_VIRTUAL_OUTPUT: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x4);

/// Backend supports scheduled outbound delivery timestamps.
export const MIDI_BACKEND_CAP_SCHEDULED_OUTPUT: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x8);

/// Backend reports host receive timestamps.
export const MIDI_BACKEND_CAP_RECEIVE_TIMESTAMPS: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x10);

/// Backend exposes native notification feeds instead of synthesized polling.
export const MIDI_BACKEND_CAP_NATIVE_EVENT_FEED: MidiBackendCapabilityFlags =
    MidiBackendCapabilityFlags(0x20);

/// Backend supports Universal MIDI Packet transport.
export const MIDI_BACKEND_CAP_UMP: MidiBackendCapabilityFlags = MidiBackendCapabilityFlags(0x40);

/// List host MIDI backends.
@binding("destack.device.midi.backend.list", {
    effect: "external",
    requires: ["device.midi.port"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function backendList(): Result<Slice<MidiBackendDescriptor>, PlatformError>;
