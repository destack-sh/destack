import { PlatformError } from "destack:platform/error";
import {
    BluetoothAdapterWatchHandle,
    BluetoothDeviceHandle,
    BluetoothScanHandle,
    BluetoothSubscriptionHandle,
} from "destack:platform/resource";

/// Bluetooth scan mode.
export enum BluetoothScanMode {
    /// Passive scan mode.
    Passive = 1,
    /// Active scan mode.
    Active = 2,
}

/// Bluetooth LE transport classification.
export enum BluetoothTransport {
    /// Host did not classify the transport.
    Unknown = 0,
    /// LE-only transport.
    LowEnergy = 1,
    /// Dual-mode transport.
    DualMode = 2,
}

/// Bluetooth LE PHY selector.
export enum BluetoothPhy {
    /// Host default PHY policy.
    Any = 0,
    /// LE 1M PHY.
    Le1M = 1,
    /// LE 2M PHY.
    Le2M = 2,
    /// LE coded PHY.
    LeCoded = 3,
}

/// Bluetooth pairing state.
export enum BluetoothPairing {
    /// Pairing state is unknown.
    Unknown = 0,
    /// Device is not paired.
    Unpaired = 1,
    /// Pairing is in progress.
    Pairing = 2,
    /// Device is paired.
    Paired = 3,
}

/// Bluetooth GATT characteristic property flags.
export newtype BluetoothGattProperties = uint32;

/// Characteristic supports reads.
export const BLUETOOTH_GATT_READ: BluetoothGattProperties = BluetoothGattProperties(0x0001);

/// Characteristic supports writes with response.
export const BLUETOOTH_GATT_WRITE: BluetoothGattProperties = BluetoothGattProperties(0x0002);

/// Characteristic supports writes without response.
export const BLUETOOTH_GATT_WRITE_WITHOUT_RESPONSE: BluetoothGattProperties =
    BluetoothGattProperties(0x0004);

/// Characteristic supports notifications.
export const BLUETOOTH_GATT_NOTIFY: BluetoothGattProperties = BluetoothGattProperties(0x0008);

/// Characteristic supports indications.
export const BLUETOOTH_GATT_INDICATE: BluetoothGattProperties = BluetoothGattProperties(0x0010);

/// Bluetooth GATT write mode.
export enum BluetoothGattWriteMode {
    /// Write with an ATT response.
    WithResponse = 1,
    /// Write without an ATT response.
    WithoutResponse = 2,
}

/// Bluetooth adapter.
export struct BluetoothAdapter {
    /// Stable adapter identifier.
    id: string;
    /// Host-visible adapter name.
    name: string;
    /// Whether the adapter is powered.
    isPowered: boolean;
    /// Whether the adapter is currently scanning when known.
    isScanning?: boolean;
}

/// Bluetooth adapter topology event.
export newtype BluetoothAdapterEvent =
    | { kind: "attached"; timestampNs: uint64; sequence: uint64; adapter: BluetoothAdapter }
    | { kind: "changed"; timestampNs: uint64; sequence: uint64; adapter: BluetoothAdapter }
    | { kind: "detached"; timestampNs: uint64; sequence: uint64; adapter: BluetoothAdapter }
    | { kind: "overflow"; timestampNs: uint64; sequence: uint64; droppedCount: uint64 };

/// Bluetooth payload filter.
export struct BluetoothDataFilter {
    /// Required leading payload bytes.
    prefix: [uint8];
    /// Optional bit mask applied to the prefix.
    mask?: [uint8];
}

/// Bluetooth manufacturer-data filter.
export struct BluetoothManufacturerFilter {
    /// Bluetooth company identifier.
    companyId: uint16;
    /// Optional manufacturer payload filter.
    data?: BluetoothDataFilter;
}

/// Bluetooth service-data filter.
export struct BluetoothServiceFilter {
    /// Service UUID.
    serviceUuid: string;
    /// Optional service payload filter.
    data?: BluetoothDataFilter;
}

/// Bluetooth scan options.
export struct BluetoothScanOptions {
    /// Adapter identifier, or absent for host default.
    adapterId?: string;
    /// Service UUID filters.
    serviceUuids: [string];
    /// Exact local-name filter.
    name?: string;
    /// Local-name prefix filter.
    namePrefix?: string;
    /// Manufacturer-data filters.
    manufacturerData: [BluetoothManufacturerFilter];
    /// Service-data filters.
    serviceData: [BluetoothServiceFilter];
    /// Whether repeated advertisements should be delivered.
    keepRepeatedDevices: boolean;
    /// Minimum signal strength in dBm.
    minimumRssi?: int32;
    /// Preferred scan mode.
    scanMode?: BluetoothScanMode;
    /// Preferred primary PHY.
    primaryPhy?: BluetoothPhy;
    /// Preferred secondary PHY.
    secondaryPhy?: BluetoothPhy;
}

/// Bluetooth advertisement manufacturer payload.
export struct BluetoothManufacturerData {
    /// Bluetooth company identifier.
    companyId: uint16;
    /// Manufacturer payload bytes.
    data: [uint8];
}

/// Bluetooth advertisement service payload.
export struct BluetoothServiceData {
    /// Service UUID.
    serviceUuid: string;
    /// Service payload bytes.
    data: [uint8];
}

/// Bluetooth advertisement payload.
export struct BluetoothAdvertisement {
    /// Advertised local name when available.
    localName?: string;
    /// Advertised transmit power in dBm when available.
    txPower?: int16;
    /// Service UUIDs.
    serviceUuids: [string];
    /// Manufacturer payload entries.
    manufacturerData: [BluetoothManufacturerData];
    /// Service payload entries.
    serviceData: [BluetoothServiceData];
}

/// Bluetooth device.
export struct BluetoothDevice {
    /// Stable device identifier.
    id: string;
    /// Device address string when the host exposes one.
    address?: string;
    /// Host-visible device name when available.
    name?: string;
    /// Signal strength in dBm when available.
    rssi?: int32;
    /// Pairing state when reported by host.
    pairing?: BluetoothPairing;
    /// Whether the device is currently connected.
    isConnected: boolean;
    /// Whether the advertisement indicates connectability when known.
    isConnectable?: boolean;
    /// Host-reported transport classification when available.
    transport?: BluetoothTransport;
    /// Advertisement payload.
    advertisement: BluetoothAdvertisement;
}

/// Bluetooth scan event.
@derive(Tagged)
export newtype BluetoothScanEvent =
    | { kind: "discovered"; timestampNs: uint64; sequence: uint64; device: BluetoothDevice }
    | { kind: "updated"; timestampNs: uint64; sequence: uint64; device: BluetoothDevice }
    | { kind: "lost"; timestampNs: uint64; sequence: uint64; deviceId: string }
    | { kind: "overflow"; timestampNs: uint64; sequence: uint64; droppedCount: uint64 };

/// Bluetooth session event.
@derive(Tagged)
export newtype BluetoothSessionEvent =
    | { kind: "disconnected"; timestampNs: uint64; sequence: uint64 }
    | { kind: "pairingChanged"; timestampNs: uint64; sequence: uint64; pairing: BluetoothPairing }
    | { kind: "gattChanged"; timestampNs: uint64; sequence: uint64 }
    | { kind: "overflow"; timestampNs: uint64; sequence: uint64; droppedCount: uint64 };

/// Bluetooth GATT service.
export struct BluetoothGattService {
    /// Stable service identifier within this device session.
    id: string;
    /// Service UUID.
    uuid: string;
    /// Whether this is a primary service.
    isPrimary: boolean;
    /// Included service identifiers.
    includedServiceIds: [string];
}

/// Bluetooth GATT characteristic.
export struct BluetoothGattCharacteristic {
    /// Stable characteristic identifier within this device session.
    id: string;
    /// Owning service identifier.
    serviceId: string;
    /// Characteristic UUID.
    uuid: string;
    /// Characteristic property flags.
    properties: BluetoothGattProperties;
}

/// Bluetooth GATT descriptor.
export struct BluetoothGattDescriptor {
    /// Stable descriptor identifier within this device session.
    id: string;
    /// Owning characteristic identifier.
    characteristicId: string;
    /// Descriptor UUID.
    uuid: string;
}

/// Bluetooth GATT value event.
export struct BluetoothGattValueEvent {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this subscription.
    sequence: uint64;
    /// Characteristic identifier.
    characteristicId: string;
    /// Value bytes written.
    bytes: uint64;
}

/// List Bluetooth adapters.
@binding("destack.device.bluetooth.adapter.list", {
    effect: "external",
    requires: ["host.device.bluetooth.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listBluetoothAdapters(): Result<^Array<BluetoothAdapter>, PlatformError>;

/// Open a Bluetooth adapter topology watch.
@binding("destack.device.bluetooth.adapter.watch.open", {
    effect: "external",
    requires: ["host.device.bluetooth.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openBluetoothAdapterWatch(): Result<
    BluetoothAdapterWatchHandle,
    PlatformError
>;

/// Close a Bluetooth adapter topology watch.
@binding("destack.device.bluetooth.adapter.watch.close", {
    effect: "external",
    requires: ["host.device.bluetooth.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeBluetoothAdapterWatch(
    watch: BluetoothAdapterWatchHandle,
): Result<void, PlatformError>;

/// Read one Bluetooth adapter topology event.
@binding("destack.device.bluetooth.adapter.watch.read", {
    effect: "external",
    requires: ["host.device.bluetooth.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothAdapterWatch(
    watch: BluetoothAdapterWatchHandle,
    timeoutNs?: uint64,
): Result<BluetoothAdapterEvent, PlatformError>;

/// Open a Bluetooth LE scan.
@binding("destack.device.bluetooth.scan.open", {
    effect: "external",
    requires: ["host.device.bluetooth.scan"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openBluetoothScan(
    options: &readonly BluetoothScanOptions,
): Result<BluetoothScanHandle, PlatformError>;

/// Close a Bluetooth LE scan.
@binding("destack.device.bluetooth.scan.close", {
    effect: "external",
    requires: ["host.device.bluetooth.scan"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeBluetoothScan(scan: BluetoothScanHandle): Result<void, PlatformError>;

/// Read one Bluetooth scan event.
@binding("destack.device.bluetooth.scan.read", {
    effect: "external",
    requires: ["host.device.bluetooth.scan"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothScan(
    scan: BluetoothScanHandle,
    timeoutNs?: uint64,
): Result<BluetoothScanEvent, PlatformError>;

/// Open a Bluetooth device session.
@binding("destack.device.bluetooth.open", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openBluetoothDevice(
    id: &readonly string,
): Result<BluetoothDeviceHandle, PlatformError>;

/// Close a Bluetooth device session.
@binding("destack.device.bluetooth.close", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeBluetoothDevice(
    device: BluetoothDeviceHandle,
): Result<void, PlatformError>;

/// Describe a Bluetooth device session.
@binding("destack.device.bluetooth.describe", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeBluetoothDevice(
    device: BluetoothDeviceHandle,
): Result<BluetoothDevice, PlatformError>;

/// Read one Bluetooth session event.
@binding("destack.device.bluetooth.event.read", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothEvent(
    device: BluetoothDeviceHandle,
    timeoutNs?: uint64,
): Result<BluetoothSessionEvent, PlatformError>;

/// Pair a Bluetooth device.
@binding("destack.device.bluetooth.pair", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pairBluetoothDevice(
    device: BluetoothDeviceHandle,
): Result<void, PlatformError>;

/// Unpair a Bluetooth device.
@binding("destack.device.bluetooth.unpair", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unpairBluetoothDevice(
    device: BluetoothDeviceHandle,
): Result<void, PlatformError>;

/// Read Bluetooth signal strength.
@binding("destack.device.bluetooth.rssi", {
    effect: "external",
    requires: ["host.device.bluetooth.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothRssi(
    device: BluetoothDeviceHandle,
): Result<int32, PlatformError>;

/// List Bluetooth GATT services.
@binding("destack.device.bluetooth.gatt.service.list", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listBluetoothGattServices(
    device: BluetoothDeviceHandle,
): Result<^Array<BluetoothGattService>, PlatformError>;

/// List Bluetooth GATT characteristics.
@binding("destack.device.bluetooth.gatt.characteristic.list", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listBluetoothGattCharacteristics(
    device: BluetoothDeviceHandle,
    serviceId: &readonly string,
): Result<^Array<BluetoothGattCharacteristic>, PlatformError>;

/// List Bluetooth GATT descriptors.
@binding("destack.device.bluetooth.gatt.descriptor.list", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listBluetoothGattDescriptors(
    device: BluetoothDeviceHandle,
    characteristicId: &readonly string,
): Result<^Array<BluetoothGattDescriptor>, PlatformError>;

/// Read a Bluetooth GATT characteristic.
@binding("destack.device.bluetooth.gatt.characteristic.read", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothGattCharacteristic(
    device: BluetoothDeviceHandle,
    characteristicId: &readonly string,
    buffer: &[uint8],
): Result<uint64, PlatformError>;

/// Write a Bluetooth GATT characteristic.
@binding("destack.device.bluetooth.gatt.characteristic.write", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeBluetoothGattCharacteristic(
    device: BluetoothDeviceHandle,
    characteristicId: &readonly string,
    value: &readonly [uint8],
    mode: BluetoothGattWriteMode,
): Result<void, PlatformError>;

/// Read a Bluetooth GATT descriptor.
@binding("destack.device.bluetooth.gatt.descriptor.read", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothGattDescriptor(
    device: BluetoothDeviceHandle,
    descriptorId: &readonly string,
    buffer: &[uint8],
): Result<uint64, PlatformError>;

/// Write a Bluetooth GATT descriptor.
@binding("destack.device.bluetooth.gatt.descriptor.write", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeBluetoothGattDescriptor(
    device: BluetoothDeviceHandle,
    descriptorId: &readonly string,
    value: &readonly [uint8],
): Result<void, PlatformError>;

/// Subscribe to Bluetooth GATT value notifications.
@binding("destack.device.bluetooth.gatt.subscribe", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function subscribeBluetoothGatt(
    device: BluetoothDeviceHandle,
    characteristicId: &readonly string,
): Result<BluetoothSubscriptionHandle, PlatformError>;

/// Unsubscribe from Bluetooth GATT value notifications.
@binding("destack.device.bluetooth.gatt.unsubscribe", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unsubscribeBluetoothGatt(
    subscription: BluetoothSubscriptionHandle,
): Result<void, PlatformError>;

/// Read one Bluetooth GATT value notification.
@binding("destack.device.bluetooth.gatt.event.read", {
    effect: "external",
    requires: ["host.device.bluetooth.gatt"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBluetoothGattEvent(
    subscription: BluetoothSubscriptionHandle,
    buffer: &[uint8],
    timeoutNs?: uint64,
): Result<BluetoothGattValueEvent, PlatformError>;
