/// Read USB string descriptors.
@binding("destack.device.usb.stringDescriptor", {
    effect: "external",
    requires: ["device.usb.enumerate"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbStringDescriptor(
    handle: UsbDeviceHandle,
