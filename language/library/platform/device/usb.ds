import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { UsbDeviceHandle, UsbWatchHandle } from "../resource/index.ds";

/// USB endpoint descriptor.
export struct UsbEndpointDescriptor {
    /// Endpoint number.
    endpointNumber: uint8;
    /// Endpoint transfer direction.
    direction: UsbEndpointDirection;
    /// Endpoint transfer type.
    transferType: UsbEndpointTransferType;
    /// Endpoint max-packet size in bytes.
    maxPacketSize: uint16;
    /// Endpoint polling interval.
    interval: uint8;
}

/// USB endpoint selector.
export struct UsbEndpointSelector {
    /// Endpoint number.
    number: uint8;
    /// Endpoint transfer direction.
    direction: UsbEndpointDirection;
}

/// USB endpoint direction.
export enum UsbEndpointDirection {
    /// Device-to-host endpoint direction.
    In = 1,
    /// Host-to-device endpoint direction.
    Out = 2,
}

/// USB endpoint transfer type.
export enum UsbEndpointTransferType {
    /// Bulk transfer endpoint.
    Bulk = 1,
    /// Interrupt transfer endpoint.
    Interrupt = 2,
    /// Isochronous transfer endpoint.
    Isochronous = 3,
}

/// USB interface descriptor.
export struct UsbInterfaceDescriptor {
    /// Interface number.
    number: uint8;
    /// Alternate setting number.
    alternateSetting: uint8;
    /// Interface class code.
    classCode: uint8;
    /// Interface subclass code.
    subclassCode: uint8;
    /// Interface protocol code.
    protocolCode: uint8;
    /// Interface string descriptor when available.
    name?: string;
    /// Endpoints for this interface.
    endpoints: Slice<UsbEndpointDescriptor>;
}

/// USB device descriptor.
export struct UsbDeviceDescriptor {
    /// Stable USB device identifier.
    id: string;
    /// USB specification version in binary-coded decimal form.
    usbVersionBcd?: uint16;
    /// Device release version in binary-coded decimal form.
    deviceVersionBcd?: uint16;
    /// USB vendor identifier.
    vendorId: uint16;
    /// USB product identifier.
    productId: uint16;
    /// Device class code.
    classCode: uint8;
    /// Device subclass code.
    subclassCode: uint8;
    /// Device protocol code.
    protocolCode: uint8;
    /// Device manufacturer string when available.
    manufacturer?: string;
    /// Device product string when available.
    product?: string;
    /// Device serial-number string when available.
    serialNumber?: string;
    /// Negotiated or observed device speed when available.
    speed?: UsbDeviceSpeed;
    /// Host bus number when the topology exposes one.
    busNumber?: uint8;
    /// Host port path from root hub to device when available.
    portPath?: Slice<uint8>;
}

/// USB device speed.
export enum UsbDeviceSpeed {
    /// Host did not expose device speed.
    Unknown = 1,
    /// USB low-speed.
    Low = 2,
    /// USB full-speed.
    Full = 3,
    /// USB high-speed.
    High = 4,
    /// USB SuperSpeed.
    Superspeed = 5,
    /// USB SuperSpeedPlus.
    SuperspeedPlus = 6,
}

/// USB control transfer type.
export enum UsbControlTransferType {
    /// USB standard request type.
    Standard = 1,
    /// USB class-specific request type.
    Class = 2,
    /// USB vendor-specific request type.
    Vendor = 3,
}

/// USB device control-transfer target.
export struct UsbControlDeviceTarget {
    /// Discriminator for this control-target variant.
    kind: "device";
}

/// USB interface control-transfer target.
export struct UsbControlInterfaceTarget {
    /// Discriminator for this control-target variant.
    kind: "interface";
    /// Interface number.
    interfaceNumber: uint8;
}

/// USB endpoint control-transfer target.
export struct UsbControlEndpointTarget {
    /// Discriminator for this control-target variant.
    kind: "endpoint";
    /// Endpoint selector.
    endpoint: UsbEndpointSelector;
}

/// USB other-recipient control-transfer target.
export struct UsbControlOtherTarget {
    /// Discriminator for this control-target variant.
    kind: "other";
    /// Raw recipient index value.
    index: uint16;
}

/// USB control-transfer target selector.
export newtype UsbControlTarget =
    | UsbControlDeviceTarget
    | UsbControlInterfaceTarget
    | UsbControlEndpointTarget
    | UsbControlOtherTarget;

/// USB setup packet for control transfers.
export struct UsbControlSetup {
    /// USB control transfer type selector.
    transferType: UsbControlTransferType;
    /// USB control transfer target selector.
    target: UsbControlTarget;
    /// bRequest field.
    request: uint8;
    /// wValue field.
    value: uint16;
    /// wLength field.
    length: uint16;
}

/// USB transfer completion status.
export enum UsbTransferStatus {
    /// Transfer completed successfully.
    Ok = 1,
    /// Endpoint reported a stall condition.
    Stall = 2,
    /// Host detected a babble condition.
    Babble = 3,
}

/// USB configuration descriptor.
export struct UsbConfigurationDescriptor {
    /// Configuration value.
    value: uint8;
    /// Configuration string descriptor when available.
    name?: string;
    /// Whether this configuration is self-powered.
    selfPowered: boolean;
    /// Whether this configuration supports remote wakeup.
    remoteWakeup: boolean;
    /// Maximum bus power in milliamps.
    maxPowerMilliAmps: uint16;
    /// Interface descriptors for this configuration.
    interfaces: Slice<UsbInterfaceDescriptor>;
}

/// USB inbound transfer result.
export struct UsbInTransferResult {
    /// Transfer completion status.
    status: UsbTransferStatus;
    /// Transfer payload bytes.
    bytes: Slice<uint8>;
}

/// USB outbound transfer result.
export struct UsbOutTransferResult {
    /// Transfer completion status.
    status: UsbTransferStatus;
    /// Number of bytes accepted by the host transfer.
    bytesWritten: uint32;
}

/// USB isochronous packet result.
export struct UsbIsochronousPacketResult {
    /// Packet completion status.
    status: UsbTransferStatus;
    /// Packet transfer length in bytes.
    actualLength: uint32;
}

/// USB isochronous transfer result.
export struct UsbIsochronousTransferResult {
    /// Flattened transfer bytes for all packets.
    bytes: Slice<uint8>;
    /// Per-packet transfer results.
    packets: Slice<UsbIsochronousPacketResult>;
}

/// Shared metadata for all USB hotplug events.
export struct UsbHotplugEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Hotplug device descriptor payload.
    device: UsbDeviceDescriptor;
}

/// Shared metadata for one USB hotplug watch overflow.
export struct UsbHotplugOverflowEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Number of dropped hotplug records since the last surfaced overflow.
    droppedCount: uint64;
}

/// USB-attached hotplug event.
export struct UsbHotplugAttachedEvent {
    /// Discriminator for this usb hotplug event variant.
    kind: "attached";
    /// Shared event metadata.
    metadata: UsbHotplugEventMetadata;
}

/// USB-detached hotplug event.
export struct UsbHotplugDetachedEvent {
    /// Discriminator for this usb hotplug event variant.
    kind: "detached";
    /// Shared event metadata.
    metadata: UsbHotplugEventMetadata;
}

/// USB-hotplug-overflow event.
export struct UsbHotplugOverflowEvent {
    /// Discriminator for this usb hotplug event variant.
    kind: "overflow";
    /// Shared overflow metadata.
    metadata: UsbHotplugOverflowEventMetadata;
}

/// USB hotplug event payload.
export newtype UsbHotplugEvent =
    | UsbHotplugAttachedEvent
    | UsbHotplugDetachedEvent
    | UsbHotplugOverflowEvent;

/// USB string descriptor payload.
export struct UsbStringDescriptor {
    /// Language identifier used for string reads.
    languageId: uint16;
    /// Manufacturer string value when available.
    manufacturer?: string;
    /// Product string value when available.
    product?: string;
    /// Serial-number string value when available.
    serialNumber?: string;
}

/// USB BOS capability kind.
export enum UsbBosCapabilityKind {
    /// Host did not classify the capability.
    Unknown = 1,
    /// Wireless USB capability.
    WirelessUsb = 2,
    /// USB 2.0 extension capability.
    Usb20Extension = 3,
    /// SuperSpeed USB capability.
    SuperspeedUsb = 4,
    /// Container identifier capability.
    ContainerId = 5,
    /// Platform capability.
    Platform = 6,
    /// Billboard capability.
    Billboard = 7,
    /// Configuration summary capability.
    ConfigurationSummary = 8,
}

/// USB BOS capability descriptor.
export struct UsbBosCapabilityDescriptor {
    /// Normalized BOS capability classification.
    kind: UsbBosCapabilityKind;
    /// Raw bDevCapabilityType value.
    capabilityType: uint8;
    /// Platform capability UUID when applicable.
    platformUuid?: string;
    /// Raw capability payload bytes.
    bytes: Slice<uint8>;
}

/// USB bindings.
/// List USB devices.
///
/// Enumerate attached USB devices and return stable descriptors for the current bus topology.
/// Descriptor identity is bus or topology based so callers can correlate list and hotplug results without opening devices.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb topology enumeration on macOS, Linux-class Unix, and Windows, and the Android USB host bridge on Android.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.list", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbList(): Result<Slice<UsbDeviceDescriptor>, PlatformError>;

/// Open USB hotplug watch stream.
///
/// Open one hotplug watch stream for USB attach and detach events.
/// The stream reports topology changes independently from any later opened device session.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb hotplug callbacks or snapshot polling on macOS, Linux-class Unix, and Windows, and the Android USB host bridge on Android.
///
/// # Errors
/// Returns ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.watchOpen", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbWatchOpen(): Result<UsbWatchHandle, PlatformError>;

/// Close USB hotplug watch stream.
///
/// Close one opened USB hotplug watch stream and release its host subscription state.
/// Closing a watch does not affect any separately opened USB device handle.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb hotplug watch teardown on macOS, Linux-class Unix, and Windows, and Android host watch teardown on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.watchClose", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbWatchClose(handle: UsbWatchHandle): Result<void, PlatformError>;

/// Wait for one USB hotplug event.
///
/// Wait for the next queued USB hotplug event from one opened watch stream.
/// The returned event carries a full descriptor snapshot so attach consumers do not need a follow-up enumeration race.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses watch queues fed by libusb hotplug callbacks or snapshot polling on macOS, Linux-class Unix, and Windows, and host watch streams on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.watchRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbWatchRead(
    handle: UsbWatchHandle,
    timeoutNs: uint64,
): Result<UsbHotplugEvent, PlatformError>;

/// Poll one USB hotplug event without blocking.
///
/// Read the next queued USB hotplug event from one opened watch stream without waiting.
/// This operation only consumes already published attach or detach events.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses watch queues fed by libusb hotplug callbacks or snapshot polling on macOS, Linux-class Unix, and Windows, and host watch streams on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.watchTryRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function usbWatchTryRead(handle: UsbWatchHandle): Result<UsbHotplugEvent, PlatformError>;

/// Open USB device.
///
/// Open one USB device for descriptor, configuration, interface, and transfer operations.
/// Opening creates a device session whose lifetime and claimed interfaces are independent from further topology events.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb device sessions on macOS, Linux-class Unix, and Windows, and Android host open plus libusb session wrapping on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbOpen(id: string): Result<UsbDeviceHandle, PlatformError>;

/// Close USB device.
///
/// Close one opened USB device and release its underlying host session.
/// Closing a device also releases any claimed interfaces and pending transfer ownership for that session.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb device-session teardown on macOS, Linux-class Unix, and Windows, and wrapped libusb session teardown on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbClose(handle: UsbDeviceHandle): Result<void, PlatformError>;

/// Claim USB interface.
///
/// Claim one interface on one opened USB device.
/// Claimed interfaces become the authority boundary for subsequent endpoint transfers and alternate-setting changes.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb interface claims on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.claimInterface", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbClaimInterface(
    handle: UsbDeviceHandle,
    interfaceNumber: uint8,
): Result<void, PlatformError>;

/// Release USB interface.
///
/// Release one interface previously claimed on one opened USB device.
/// Releasing an interface ends the session's authority over its endpoints without closing the device itself.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses libusb interface release calls on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.releaseInterface", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbReleaseInterface(
    handle: UsbDeviceHandle,
    interfaceNumber: uint8,
): Result<void, PlatformError>;

/// Set USB interface alternate setting.
///
/// Select one alternate setting for one claimed interface.
/// Alternate-setting changes are session local and immediately redefine the active endpoint layout for that interface.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses SET_INTERFACE style interface reconfiguration through libusb on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.setInterfaceAlternateSetting", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbSetInterfaceAlternateSetting(
    handle: UsbDeviceHandle,
    interfaceNumber: uint8,
    alternateSetting: uint8,
): Result<void, PlatformError>;

/// Read active USB device descriptor.
///
/// Read the active device descriptor and host topology metadata for one opened USB device.
/// This snapshot describes the device itself and is independent from any currently claimed interface state.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses cached standard device-descriptor reads with host topology metadata on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.descriptor", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbDescriptor(
    handle: UsbDeviceHandle,
): Result<UsbDeviceDescriptor, PlatformError>;

/// List USB string-descriptor language identifiers.
///
/// Enumerate the language identifiers that the device exposes for string-descriptor reads.
/// Callers can use the returned identifiers to select deterministic manufacturer, product, and serial text reads.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses standard GET_DESCRIPTOR string-language queries on the default control pipe through libusb, including the wrapped Android session after host open handoff.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.stringLanguageList", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbStringLanguageList(
    handle: UsbDeviceHandle,
): Result<Slice<uint16>, PlatformError>;

/// Read USB string descriptors.
///
/// Read manufacturer, product, and serial-number string descriptors for one selected language identifier.
/// Missing strings remain absent rather than being synthesized from transport-specific fallback metadata.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses standard string-descriptor control transfers on the default control pipe through libusb, including the wrapped Android session after host open handoff.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.stringDescriptor", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbStringDescriptor(
    handle: UsbDeviceHandle,
    languageId: uint16,
): Result<UsbStringDescriptor, PlatformError>;

/// List USB BOS capabilities.
///
/// Enumerate BOS capability descriptors for one opened USB device.
/// Raw BOS payload bytes are preserved so callers can interpret platform and vendor capabilities without data loss.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses standard BOS descriptor reads on the default control pipe through libusb, including the wrapped Android session after host open handoff.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.bosCapabilityList", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbBosCapabilityList(
    handle: UsbDeviceHandle,
): Result<Slice<UsbBosCapabilityDescriptor>, PlatformError>;

/// List USB configurations.
///
/// Enumerate USB configurations and their nested interface and endpoint descriptors for one opened device.
/// The returned tree is a descriptor snapshot and does not imply that any configuration or interface is currently active.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses standard configuration-descriptor reads and host descriptor parsing through libusb, including the wrapped Android session after host open handoff.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.enumerate`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.configurationList", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.enumerate"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbConfigurationList(
    handle: UsbDeviceHandle,
): Result<Slice<UsbConfigurationDescriptor>, PlatformError>;

/// Read active USB configuration value.
///
/// Read the currently selected configuration value for one opened USB device.
/// This reports live device state rather than the first configuration in descriptor order.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses live configuration queries through the device control path on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.configurationGet", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbConfigurationGet(handle: UsbDeviceHandle): Result<uint8, PlatformError>;

/// Set active USB configuration value.
///
/// Select the active configuration value for one opened USB device.
/// Configuration changes are device state transitions and may invalidate previously claimed interfaces.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses SET_CONFIGURATION control requests through libusb on macOS, Linux-class Unix, and Windows, and the wrapped Android libusb session after host open handoff on Android.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `device.usb.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.configurationSet", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.control"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function usbConfigurationSet(
    handle: UsbDeviceHandle,
    configurationValue: uint8,
): Result<void, PlatformError>;

/// Read control-transfer response bytes.
///
/// Execute one control-transfer read and return both transfer status and response bytes.
/// The setup packet is passed through without higher-level interpretation so callers can issue standard, class, or vendor requests explicitly.
///
/// # Platform
/// macOS, Linux-class Unix, Windows, and Android.
/// Uses synchronous or deadline-bounded default-control transfers through libusb, including the wrapped Android session after host open handoff.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `device.usb.transfer`.
///
/// # Replay
/// External, recordable.
@binding("destack.device.usb.controlRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["device.usb.transfer"],
    platforms: ["android", "windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
