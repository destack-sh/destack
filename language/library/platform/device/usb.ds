): Result<UsbInTransferResult, PlatformError>;

/// Write interrupt endpoint bytes.
@binding("destack.device.usb.interruptWrite", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbInterruptWrite(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
    bytes: Slice<uint8>,
    timeoutNs: uint64,
