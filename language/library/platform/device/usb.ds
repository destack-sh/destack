/// Release USB interface.
@binding("destack.device.usb.releaseInterface", {
    effect: "external",
    requires: ["device.usb.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbReleaseInterface(
    handle: UsbDeviceHandle,
