/// List USB configurations.
@binding("destack.device.usb.configurationList", {
    effect: "external",
    requires: ["device.usb.enumerate"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbConfigurationList(
    handle: UsbDeviceHandle,
