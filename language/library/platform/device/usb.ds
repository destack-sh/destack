/// List USB BOS actions.
@binding("destack.device.usb.bosCapabilityList", {
    effect: "external",
    requires: ["device.usb.enumerate"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbBosCapabilityList(
    handle: UsbDeviceHandle,
