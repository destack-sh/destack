/// Read active USB configuration value.
@binding("destack.device.usb.configurationGet", {
    effect: "external",
    requires: ["device.usb.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbConfigurationGet(handle: UsbDeviceHandle): Result<uint8, PlatformError>;

/// Set active USB configuration value.
@binding("destack.device.usb.configurationSet", {
    effect: "external",
    requires: ["device.usb.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbConfigurationSet(
    handle: UsbDeviceHandle,
    configurationValue: uint8,
): Result<void, PlatformError>;

/// Read control-transfer response bytes.
@binding("destack.device.usb.controlRead", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbControlRead(
    handle: UsbDeviceHandle,
    setup: UsbControlSetup,
    timeoutNs: uint64,
): Result<UsbInTransferResult, PlatformError>;

/// Write control-transfer request bytes.
@binding("destack.device.usb.controlWrite", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbControlWrite(
    handle: UsbDeviceHandle,
    setup: UsbControlSetup,
    bytes: Slice<uint8>,
    timeoutNs: uint64,
): Result<UsbOutTransferResult, PlatformError>;

/// Read bulk endpoint bytes.
@binding("destack.device.usb.bulkRead", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbBulkRead(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
    maxBytes: uint32,
    timeoutNs: uint64,
