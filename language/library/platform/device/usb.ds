/// Read one isochronous transfer.
@binding("destack.device.usb.isochronousRead", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbIsochronousRead(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
    packetSizes: Slice<uint32>,
    timeoutNs: uint64,
): Result<UsbIsochronousTransferResult, PlatformError>;

/// Write one isochronous transfer.
@binding("destack.device.usb.isochronousWrite", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbIsochronousWrite(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
    bytes: Slice<uint8>,
    packetSizes: Slice<uint32>,
    timeoutNs: uint64,
): Result<UsbIsochronousTransferResult, PlatformError>;

/// Cancel pending transfers on one endpoint.
@binding("destack.device.usb.transferCancel", {
    effect: "external",
    replay: "forbidden",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbTransferCancel(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
): Result<void, PlatformError>;

/// Cancel all pending transfers on one opened USB device.
@binding("destack.device.usb.transferCancelAll", {
    effect: "external",
    replay: "forbidden",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbTransferCancelAll(handle: UsbDeviceHandle): Result<void, PlatformError>;

/// Clear halt condition on one endpoint.
@binding("destack.device.usb.clearHalt", {
    effect: "external",
    requires: ["device.usb.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbClearHalt(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
): Result<void, PlatformError>;

/// Reset one USB device.
@binding("destack.device.usb.reset", {
    effect: "external",
    replay: "forbidden",
    requires: ["device.usb.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbReset(handle: UsbDeviceHandle): Result<void, PlatformError>;
