/// Read interrupt endpoint bytes.
@binding("destack.device.usb.interruptRead", {
    effect: "external",
    requires: ["device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function usbInterruptRead(
    handle: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
    maxBytes: uint32,
