import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { Path } from "../fs/path.ds";
import { SerialPortHandle, SerialWatchHandle } from "../resource/index.ds";

/// Serial parity mode.
export enum SerialParity {
    /// No parity bit.
    None = 1,
    /// Odd parity bit.
    Odd = 2,
    /// Even parity bit.
    Even = 3,
    /// Mark parity bit.
    Mark = 4,
    /// Space parity bit.
    Space = 5,
}

/// Serial stop-bit mode.
export enum SerialStopBits {
    /// One stop bit.
    One = 1,
    /// One and one-half stop bits.
    OnePointFive = 2,
    /// Two stop bits.
    Two = 3,
}

/// Serial data-bit count.
export enum SerialDataBits {
    /// Five data bits per frame.
    Five = 5,
    /// Six data bits per frame.
    Six = 6,
    /// Seven data bits per frame.
    Seven = 7,
    /// Eight data bits per frame.
    Eight = 8,
}

/// Serial flow-control configuration.
export struct SerialFlowControl {
    /// Whether RTS or CTS hardware flow control is enabled.
    requestToSendClearToSendEnabled: boolean;
    /// Whether DTR or DSR hardware flow control is enabled.
    dataTerminalReadyDataSetReadyEnabled: boolean;
    /// Whether XON or XOFF software flow control is enabled.
    xonXoffEnabled: boolean;
}

/// Serial transport kind.
export enum SerialPortTransport {
    /// Native serial controller transport.
    Native = 1,
    /// USB-backed serial transport.
    Usb = 2,
    /// Bluetooth-backed serial transport.
    Bluetooth = 3,
    /// Host did not classify the transport.
    Unknown = 4,
}

/// Serial endpoint configuration.
export struct SerialPortConfig {
    /// Baud rate in symbols per second.
    baudRate: uint32;
    /// Number of data bits per frame.
    dataBits: SerialDataBits;
    /// Parity mode.
    parity: SerialParity;
    /// Stop-bit mode.
    stopBits: SerialStopBits;
    /// Flow-control mode.
    flowControl: SerialFlowControl;
}

/// Serial open options.
export struct SerialPortOpenOptions {
    /// Serial line configuration to apply when opening.
    config: SerialPortConfig;
    /// Whether the open should request exclusive access.
    exclusive?: boolean;
    /// Preferred inbound host buffer size in bytes.
    readBufferSize?: uint32;
    /// Preferred outbound host buffer size in bytes.
    writeBufferSize?: uint32;
}

/// Serial endpoint descriptor.
export struct SerialPortDescriptor {
    /// Stable serial endpoint identifier.
    id: string;
    /// Host-classified serial transport kind.
    transport: SerialPortTransport;
    /// Host-visible endpoint name.
    name: string;
    /// Host-visible manufacturer string when available.
    manufacturer?: string;
    /// Host-visible product string when available.
    product?: string;
    /// Host-visible device serial number when available.
    serialNumber?: string;
    /// Device path for the endpoint.
    path: Path;
    /// USB vendor identifier when the endpoint is USB backed.
    usbVendorId?: uint16;
    /// USB product identifier when the endpoint is USB backed.
    usbProductId?: uint16;
    /// Bluetooth service-class identifier when the endpoint is Bluetooth backed.
    bluetoothServiceClassId?: string;
}

/// Shared metadata for serial topology events.
export struct SerialWatchEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Serial endpoint descriptor payload.
    port: SerialPortDescriptor;
}

/// Serial-attached event.
export struct SerialAttachedEvent {
    /// Discriminator for this serial watch event variant.
    kind: "attached";
    /// Shared event metadata.
    metadata: SerialWatchEventMetadata;
}

/// Serial-detached event.
export struct SerialDetachedEvent {
    /// Discriminator for this serial watch event variant.
    kind: "detached";
    /// Shared event metadata.
    metadata: SerialWatchEventMetadata;
}

/// Shared metadata for one serial watch overflow event.
export struct SerialWatchOverflowEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Number of dropped topology events since the last delivered overflow marker.
    droppedCount: uint64;
}

/// Serial-watch-overflow event.
export struct SerialWatchOverflowEvent {
    /// Discriminator for this serial watch event variant.
    kind: "overflow";
    /// Shared overflow metadata.
    metadata: SerialWatchOverflowEventMetadata;
}

/// Serial topology event.
export newtype SerialWatchEvent =
    | SerialAttachedEvent
    | SerialDetachedEvent
    | SerialWatchOverflowEvent;

/// Serial input signal state.
export struct SerialInputSignals {
    /// Clear-to-send line state.
    clearToSend: boolean;
    /// Data-set-ready line state.
    dataSetReady: boolean;
    /// Data-carrier-detect line state.
    dataCarrierDetect: boolean;
    /// Ring-indicator line state.
    ringIndicator: boolean;
}

/// Serial output signal state update.
export struct SerialOutputSignals {
    /// Data-terminal-ready output line state when updated.
    dataTerminalReady?: boolean;
    /// Request-to-send output line state when updated.
    requestToSend?: boolean;
    /// Break signaling state when updated.
    breakConditionActive?: boolean;
}

/// Serial error kind.
export enum SerialErrorKind {
    /// Host did not provide a stronger error classification.
    Unknown = 1,
    /// Break condition was detected on the line.
    Break = 2,
    /// Framing error was detected on the line.
    Framing = 3,
    /// Parity error was detected on the line.
    Parity = 4,
    /// Receiver overrun was detected on the line.
    Overrun = 5,
    /// Backend receive buffer overflow was detected.
    BufferOverflow = 6,
}

/// Shared metadata for all serial events.
export struct SerialEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this serial event stream.
    sequence: uint64;
}

/// Read-ready serial event.
export struct SerialReadReadyEvent {
    /// Discriminator for this serial event variant.
    kind: "readReady";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Estimated number of readable bytes.
    availableBytes?: uint64;
}

/// Modem-status-changed serial event.
export struct SerialModemStatusChangedEvent {
    /// Discriminator for this serial event variant.
    kind: "modemStatusChanged";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Current serial input signal state.
    signals: SerialInputSignals;
}

/// Error serial event.
export struct SerialErrorEvent {
    /// Discriminator for this serial event variant.
    kind: "error";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Normalized error classification.
    errorKind: SerialErrorKind;
    /// Backend-specific error code when available.
    backendCode?: int32;
    /// Backend-specific detail value when available.
    backendDetail?: int32;
}

/// Disconnected serial event.
export struct SerialDisconnectedEvent {
    /// Discriminator for this serial event variant.
    kind: "disconnected";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
}

/// Shared metadata for one serial session overflow event.
export struct SerialOverflowEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this serial event stream.
    sequence: uint64;
    /// Number of dropped session events since the last delivered overflow marker.
    droppedCount: uint64;
}

/// Serial-overflow event.
export struct SerialOverflowEvent {
    /// Discriminator for this serial event variant.
    kind: "overflow";
    /// Shared overflow metadata.
    metadata: SerialOverflowEventMetadata;
}

/// Serial event.
export newtype SerialEvent =
    | SerialReadReadyEvent
    | SerialModemStatusChangedEvent
    | SerialDisconnectedEvent
    | SerialErrorEvent
    | SerialOverflowEvent;

/// List serial endpoints.
@binding("destack.device.serial.list", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialList(): Result<Slice<SerialPortDescriptor>, PlatformError>;

/// Open a serial topology watch stream.
@binding("destack.device.serial.watchOpen", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialWatchOpen(): Result<SerialWatchHandle, PlatformError>;

/// Close a serial topology watch stream.
@binding("destack.device.serial.watchClose", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialWatchClose(handle: SerialWatchHandle): Result<void, PlatformError>;

/// Read one serial topology event.
@binding("destack.device.serial.watchRead", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialWatchRead(
    handle: SerialWatchHandle,
    timeoutNs: uint64,
): Result<SerialWatchEvent, PlatformError>;

/// Poll one serial topology event without blocking.
@binding("destack.device.serial.watchTryRead", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialWatchTryRead(
    handle: SerialWatchHandle,
): Result<SerialWatchEvent, PlatformError>;

/// Open a serial endpoint.
@binding("destack.device.serial.open", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialOpen(
    id: string,
    options: SerialPortOpenOptions,
): Result<SerialPortHandle, PlatformError>;

/// Close a serial endpoint.
@binding("destack.device.serial.close", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialClose(handle: SerialPortHandle): Result<void, PlatformError>;

/// Read a serial endpoint descriptor.
@binding("destack.device.serial.descriptor", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialDescriptor(
    handle: SerialPortHandle,
): Result<SerialPortDescriptor, PlatformError>;

/// Read serial endpoint configuration.
@binding("destack.device.serial.config", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialConfig(handle: SerialPortHandle): Result<SerialPortConfig, PlatformError>;

/// Reconfigure a serial endpoint.
@binding("destack.device.serial.configure", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialConfigure(
    handle: SerialPortHandle,
    config: SerialPortConfig,
): Result<void, PlatformError>;

/// Read serial bytes.
@binding("destack.device.serial.readInto", {
    effect: "external",
    requires: ["device.serial.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialReadInto(
    handle: SerialPortHandle,
    buffer: Slice<uint8>,
    timeoutNs: uint64,
): Result<uint64, PlatformError>;

/// Poll serial bytes without blocking.
@binding("destack.device.serial.tryReadInto", {
    effect: "external",
    requires: ["device.serial.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialTryReadInto(
    handle: SerialPortHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write serial bytes.
@binding("destack.device.serial.write", {
    effect: "external",
    requires: ["device.serial.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialWrite(
    handle: SerialPortHandle,
    data: Slice<uint8>,
    timeoutNs: uint64,
): Result<uint64, PlatformError>;

/// Drain serial output.
@binding("destack.device.serial.drain", {
    effect: "external",
    requires: ["device.serial.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialDrain(handle: SerialPortHandle): Result<void, PlatformError>;

/// Discard queued inbound serial bytes.
@binding("destack.device.serial.discardInput", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialDiscardInput(handle: SerialPortHandle): Result<void, PlatformError>;

/// Discard queued outbound serial bytes.
@binding("destack.device.serial.discardOutput", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialDiscardOutput(handle: SerialPortHandle): Result<void, PlatformError>;

/// Read serial input signal state.
@binding("destack.device.serial.getSignals", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialGetSignals(
    handle: SerialPortHandle,
): Result<SerialInputSignals, PlatformError>;

/// Update serial output signal state.
@binding("destack.device.serial.setSignals", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialSetSignals(
    handle: SerialPortHandle,
    signals: SerialOutputSignals,
): Result<void, PlatformError>;

/// Read one serial event.
@binding("destack.device.serial.readEvent", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialReadEvent(
    handle: SerialPortHandle,
    timeoutNs: uint64,
): Result<SerialEvent, PlatformError>;

/// Poll one serial event without blocking.
@binding("destack.device.serial.tryReadEvent", {
    effect: "external",
    requires: ["device.serial.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function serialTryReadEvent(
    handle: SerialPortHandle,
): Result<SerialEvent, PlatformError>;
