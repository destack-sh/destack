import { PlatformError } from "destack:platform/error";
import {
    MidiInputPortHandle,
    MidiOutputPortHandle,
    MidiWatchHandle,
} from "destack:platform/resource";

/// MIDI transport data format.
export enum MidiFormat {
    /// MIDI 1.0 byte-stream transport.
    Midi1Bytes = 1,
    /// Universal MIDI Packet transport.
    Ump = 2,
}

/// MIDI transport data-format flags.
export newtype MidiFormatFlags = uint32;

/// No MIDI transport data formats.
export const MIDI_FORMAT_NONE: MidiFormatFlags = MidiFormatFlags(0x0);

/// MIDI 1.0 byte-stream transport.
export const MIDI_FORMAT_MIDI1_BYTES: MidiFormatFlags = MidiFormatFlags(0x1);

/// Universal MIDI Packet transport.
export const MIDI_FORMAT_UMP: MidiFormatFlags = MidiFormatFlags(0x2);

/// MIDI protocol.
export enum MidiProtocol {
    /// MIDI 1.0 protocol.
    Midi1 = 1,
    /// MIDI 2.0 protocol.
    Midi2 = 2,
}

/// MIDI protocol flags.
export newtype MidiProtocolFlags = uint32;

/// No MIDI protocols.
export const MIDI_PROTOCOL_NONE: MidiProtocolFlags = MidiProtocolFlags(0x0);

/// MIDI 1.0 protocol.
export const MIDI_PROTOCOL_MIDI1: MidiProtocolFlags = MidiProtocolFlags(0x1);

/// MIDI 2.0 protocol.
export const MIDI_PROTOCOL_MIDI2: MidiProtocolFlags = MidiProtocolFlags(0x2);

/// MIDI backend kind.
export enum MidiBackendKind {
    /// Let the host choose the default backend.
    Auto = 0,
    /// CoreMIDI backend.
    CoreMidi = 1,
    /// Windows MIDI backend.
    WindowsMidi = 2,
    /// ALSA sequencer backend.
    Alsa = 3,
    /// JACK MIDI backend.
    Jack = 4,
}

/// MIDI backend capability flags.
export newtype MidiBackendFlags = uint64;

/// Backend can report topology events.
export const MIDI_BACKEND_EVENTS: MidiBackendFlags = MidiBackendFlags(0x01);

/// Backend can create virtual input ports.
export const MIDI_BACKEND_VIRTUAL_INPUT: MidiBackendFlags = MidiBackendFlags(0x02);

/// Backend can create virtual output ports.
export const MIDI_BACKEND_VIRTUAL_OUTPUT: MidiBackendFlags = MidiBackendFlags(0x04);

/// Backend can schedule output by timestamp.
export const MIDI_BACKEND_SCHEDULED_OUTPUT: MidiBackendFlags = MidiBackendFlags(0x08);

/// Backend can report input timestamps.
export const MIDI_BACKEND_INPUT_TIMESTAMPS: MidiBackendFlags = MidiBackendFlags(0x10);

/// MIDI backend.
export struct MidiBackend {
    /// Backend identifier.
    kind: MidiBackendKind;
    /// Backend capability flags.
    flags: MidiBackendFlags;
    /// Supported transport data formats.
    formats: MidiFormatFlags;
    /// Supported MIDI protocols.
    protocols: MidiProtocolFlags;
}

/// List MIDI backends.
@binding("destack.device.midi.backend.list", {
    effect: "external",
    requires: ["host.device.midi.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listMidiBackends(): Result<^Array<MidiBackend>, PlatformError>;

/// MIDI port direction flags.
export newtype MidiDirectionFlags = uint32;

/// No MIDI port direction.
export const MIDI_DIRECTION_NONE: MidiDirectionFlags = MidiDirectionFlags(0x0);

/// MIDI input port direction.
export const MIDI_DIRECTION_INPUT: MidiDirectionFlags = MidiDirectionFlags(0x1);

/// MIDI output port direction.
export const MIDI_DIRECTION_OUTPUT: MidiDirectionFlags = MidiDirectionFlags(0x2);

/// MIDI input and output port directions.
export const MIDI_DIRECTION_ALL: MidiDirectionFlags = MidiDirectionFlags(0x3);

/// MIDI port list flags.
export newtype MidiListFlags = uint32;

/// Include virtual ports.
export const MIDI_LIST_VIRTUAL: MidiListFlags = MidiListFlags(0x01);

/// Include disconnected ports when the backend reports them.
export const MIDI_LIST_DISCONNECTED: MidiListFlags = MidiListFlags(0x02);

/// MIDI port.
export struct MidiPort {
    /// Stable runtime port identifier.
    id: string;
    /// Backend that owns the port.
    backend: MidiBackendKind;
    /// Port direction flags.
    directions: MidiDirectionFlags;
    /// Host-visible port name.
    name: string;
    /// Host-visible group identifier when available.
    groupId?: string;
    /// Backend-native port identifier when available.
    backendId?: string;
    /// Host-visible group name when available.
    groupName?: string;
    /// Host-visible manufacturer name when available.
    manufacturer?: string;
    /// Host-visible model name when available.
    model?: string;
    /// Host-visible version string when available.
    version?: string;
    /// Supported transport data formats.
    formats: MidiFormatFlags;
    /// Default transport data format when known.
    defaultFormat?: MidiFormat;
    /// Supported MIDI protocols.
    protocols: MidiProtocolFlags;
    /// Default MIDI protocol when known.
    defaultProtocol?: MidiProtocol;
    /// Whether this is a virtual port.
    isVirtual: boolean;
    /// Whether this port is currently connected.
    isConnected: boolean;
}

/// MIDI port list options.
export struct MidiListOptions {
    /// Backend selector.
    backend: MidiBackendKind;
    /// Direction filter.
    directions: MidiDirectionFlags;
    /// List behavior flags.
    flags: MidiListFlags;
}

/// MIDI port open options.
export struct MidiOpenOptions {
    /// Backend selector.
    backend: MidiBackendKind;
    /// Requested transport data format when exact format is required.
    format?: MidiFormat;
    /// Requested MIDI protocol when exact protocol is required.
    protocol?: MidiProtocol;
    /// Requested record queue capacity, or zero for backend default.
    queueCapacity: uint32;
}

/// Virtual MIDI port options.
export struct MidiVirtualOptions {
    /// Backend selector.
    backend: MidiBackendKind;
    /// Host-visible port name.
    name: string;
    /// Host-visible manufacturer name when available.
    manufacturer?: string;
    /// Host-visible model name when available.
    model?: string;
    /// Host-visible version string when available.
    version?: string;
    /// Transport data format exposed by this port.
    format: MidiFormat;
    /// MIDI protocol exposed by this port.
    protocol: MidiProtocol;
    /// Requested queue capacity, or zero for backend default.
    queueCapacity: uint32;
}

/// MIDI topology watch flags.
export newtype MidiWatchFlags = uint32;

/// Include virtual ports.
export const MIDI_WATCH_VIRTUAL: MidiWatchFlags = MidiWatchFlags(0x01);

/// Include disconnected ports when the backend reports them.
export const MIDI_WATCH_DISCONNECTED: MidiWatchFlags = MidiWatchFlags(0x02);

/// MIDI topology watch options.
export struct MidiWatchOptions {
    /// Backend selector.
    backend: MidiBackendKind;
    /// Direction filter.
    directions: MidiDirectionFlags;
    /// Watch behavior flags.
    flags: MidiWatchFlags;
}

/// MIDI attached event.
export struct MidiEventAttached {
    /// Event discriminator.
    kind: "attached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// MIDI port.
    port: MidiPort;
}

/// MIDI detached event.
export struct MidiEventDetached {
    /// Event discriminator.
    kind: "detached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// MIDI port.
    port: MidiPort;
}

/// MIDI changed event.
export struct MidiEventChanged {
    /// Event discriminator.
    kind: "changed";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// MIDI port.
    port: MidiPort;
}

/// MIDI backend detached event.
export struct MidiEventBackendDetached {
    /// Event discriminator.
    kind: "backendDetached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// MIDI backend.
    backend: MidiBackendKind;
}

/// MIDI overflow event.
export struct MidiEventOverflow {
    /// Event discriminator.
    kind: "overflow";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Number of dropped events.
    droppedCount: uint64;
}

/// MIDI topology event.
export newtype MidiEvent =
    | MidiEventAttached
    | MidiEventDetached
    | MidiEventChanged
    | MidiEventBackendDetached
    | MidiEventOverflow;

/// Open a MIDI topology watch.
@binding("destack.device.midi.event.open", {
    effect: "external",
    requires: ["host.device.midi.observe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openMidiWatch(
    options: &readonly MidiWatchOptions,
): Result<MidiWatchHandle, PlatformError>;

/// Close a MIDI topology watch.
@binding("destack.device.midi.event.close", {
    effect: "external",
    requires: ["host.device.midi.observe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeMidiWatch(watch: MidiWatchHandle): Result<void, PlatformError>;

/// Read one MIDI topology event.
@binding("destack.device.midi.event.read", {
    effect: "external",
    requires: ["host.device.midi.observe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readMidiWatch(
    watch: MidiWatchHandle,
    timeoutNs?: uint64,
): Result<MidiEvent, PlatformError>;

/// MIDI input record.
export struct MidiInputRecord {
    /// Receive timestamp in nanoseconds when available.
    timestampNs?: uint64;
    /// Source port identifier when the backend reports one.
    sourceId?: string;
    /// Transport data format.
    format: MidiFormat;
    /// MIDI protocol when the backend reports one.
    protocol?: MidiProtocol;
    /// Raw transport record bytes.
    bytes: [uint8];
}

/// List MIDI input ports.
@binding("destack.device.midi.input.list", {
    effect: "external",
    requires: ["host.device.midi.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listMidiInputs(
    options: &readonly MidiListOptions,
): Result<^Array<MidiPort>, PlatformError>;

/// Open a MIDI input port.
@binding("destack.device.midi.input.open", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openMidiInput(
    id: &readonly string,
    options: &readonly MidiOpenOptions,
): Result<MidiInputPortHandle, PlatformError>;

/// Close a MIDI input port.
@binding("destack.device.midi.input.close", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeMidiInput(input: MidiInputPortHandle): Result<void, PlatformError>;

/// Describe a MIDI input port.
@binding("destack.device.midi.input.describe", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeMidiInput(
    input: MidiInputPortHandle,
): Result<MidiPort, PlatformError>;

/// Read MIDI input records.
@binding("destack.device.midi.input.read", {
    effect: "external",
    requires: ["host.device.midi.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readMidiInput(
    input: MidiInputPortHandle,
    records: &[MidiInputRecord],
    timeoutNs?: uint64,
): Result<uint32, PlatformError>;

/// Create a virtual MIDI input port.
@binding("destack.device.midi.input.virtual.open", {
    effect: "external",
    requires: ["host.device.midi.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openVirtualMidiInput(
    options: &readonly MidiVirtualOptions,
): Result<MidiInputPortHandle, PlatformError>;

/// MIDI output record.
export struct MidiOutputRecord {
    /// Send timestamp in nanoseconds when scheduled output is supported.
    timestampNs?: uint64;
    /// Transport data format.
    format: MidiFormat;
    /// MIDI protocol when exact protocol is required.
    protocol?: MidiProtocol;
    /// Raw transport record bytes.
    bytes: [uint8];
}

/// List MIDI output ports.
@binding("destack.device.midi.output.list", {
    effect: "external",
    requires: ["host.device.midi.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listMidiOutputs(
    options: &readonly MidiListOptions,
): Result<^Array<MidiPort>, PlatformError>;

/// Open a MIDI output port.
@binding("destack.device.midi.output.open", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openMidiOutput(
    id: &readonly string,
    options: &readonly MidiOpenOptions,
): Result<MidiOutputPortHandle, PlatformError>;

/// Close a MIDI output port.
@binding("destack.device.midi.output.close", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeMidiOutput(output: MidiOutputPortHandle): Result<void, PlatformError>;

/// Describe a MIDI output port.
@binding("destack.device.midi.output.describe", {
    effect: "external",
    requires: ["host.device.midi.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeMidiOutput(
    output: MidiOutputPortHandle,
): Result<MidiPort, PlatformError>;

/// Write MIDI output records.
@binding("destack.device.midi.output.write", {
    effect: "external",
    requires: ["host.device.midi.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeMidiOutput(
    output: MidiOutputPortHandle,
    records: &readonly [MidiOutputRecord],
): Result<uint32, PlatformError>;

/// Create a virtual MIDI output port.
@binding("destack.device.midi.output.virtual.open", {
    effect: "external",
    requires: ["host.device.midi.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openVirtualMidiOutput(
    options: &readonly MidiVirtualOptions,
): Result<MidiOutputPortHandle, PlatformError>;
