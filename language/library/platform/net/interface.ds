import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketAddress } from "./address.ds";

/// Network interface flags.
export newtype NetInterfaceFlags = uint64;

/// Network interface descriptor.
export struct NetInterface {
    /// Interface name.
    name: string;
    /// Interface index.
    index: uint32;
    /// Interface flags.
    flags: NetInterfaceFlags;
    /// Interface mtu in bytes.
    mtu: uint32;
    /// Interface hardware address.
    macAddress: uint8[];
    /// Interface addresses.
    addresses: Array<SocketAddress>;
}

/// List network interfaces with addresses and flags.
@binding("destack.net.interface.listInterfaces", {
    effect: "external",
    requires: ["net.interface"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listInterfaces(): Result<Array<NetInterface>, PlatformError>;

/// Resolve an interface name to an index.
@binding("destack.net.interface.interfaceIndex", {
    effect: "external",
    requires: ["net.interface"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function interfaceIndex(name: string): Result<uint32, PlatformError>;

/// Resolve an interface index to a name.
@binding("destack.net.interface.interfaceName", {
    effect: "external",
    requires: ["net.interface"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function interfaceName(index: uint32): Result<string, PlatformError>;
