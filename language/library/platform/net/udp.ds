import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";
import { IpAddress } from "./address.ds";

/// Multicast interface selector.
export newtype MulticastInterface =
    | { kind: "any" }
    | { kind: "address"; address: IpAddress }
    | { kind: "index"; index: uint32 };

/// Multicast group membership.
export struct MulticastGroup {
    /// Multicast group address.
    group: IpAddress;
    /// Interface used for membership.
    networkInterface: MulticastInterface;
}

/// Source-specific multicast group membership.
export struct SourceMulticastGroup {
    /// Multicast group address.
    group: IpAddress;
    /// Source address.
    source: IpAddress;
    /// Interface used for membership.
    networkInterface: MulticastInterface;
}

/// UDP multicast option key.
export enum MulticastOption {
    /// Multicast loopback.
    Loopback = 1,
    /// Multicast time-to-live or hop limit.
    HopLimit = 2,
    /// Default multicast interface.
    Interface = 3,
}

/// UDP multicast option value.
export newtype MulticastOptionValue =
    | { kind: "loopback"; value: boolean }
    | { kind: "hopLimit"; value: uint32 }
    | { kind: "interface"; value: MulticastInterface };

/// Join one multicast group.
@binding("destack.net.udp.joinMulticast", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function joinMulticast(
    socket: SocketHandle,
    group: MulticastGroup,
): Result<void, PlatformError>;

/// Leave one multicast group.
@binding("destack.net.udp.leaveMulticast", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function leaveMulticast(
    socket: SocketHandle,
    group: MulticastGroup,
): Result<void, PlatformError>;

/// Join one source-specific multicast group.
@binding("destack.net.udp.joinSourceMulticast", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function joinSourceMulticast(
    socket: SocketHandle,
    group: SourceMulticastGroup,
): Result<void, PlatformError>;

/// Leave one source-specific multicast group.
@binding("destack.net.udp.leaveSourceMulticast", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function leaveSourceMulticast(
    socket: SocketHandle,
    group: SourceMulticastGroup,
): Result<void, PlatformError>;

/// Set one multicast option.
@binding("destack.net.udp.setMulticastOption", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setMulticastOption(
    socket: SocketHandle,
    option: MulticastOptionValue,
): Result<void, PlatformError>;

/// Read one multicast option.
@binding("destack.net.udp.getMulticastOption", {
    effect: "external",
    requires: ["net.multicast"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getMulticastOption(
    socket: SocketHandle,
    option: MulticastOption,
): Result<MulticastOptionValue, PlatformError>;
