    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function leaveMulticastSourceV6(
    handle: SocketHandle,
    membership: UdpSourceMembershipV6,
