    effect: "external",
    replay: "recordable",
    capabilities: ["net.multicast"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function setMulticastInterfaceV4(
    handle: SocketHandle,
    interfaceAddress: string,
): Result<void, PlatformError>;

/// Read the default IPv4 multicast interface for one socket.
