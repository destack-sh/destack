import { PlatformError } from "destack:platform/error";
import { SocketHandle } from "destack:platform/resource";

/// Socket linger settings.
export struct SocketLinger {
    /// Whether linger is enabled.
    isEnabled: boolean;
    /// Linger duration in milliseconds.
    milliseconds: uint32;
}

/// TCP keepalive settings.
export struct TcpKeepAlive {
    /// Whether keepalive probes are enabled.
    isEnabled: boolean;
    /// Idle time before probes begin, in milliseconds.
    idleMilliseconds: uint32;
    /// Interval between probes, in milliseconds.
    intervalMilliseconds: uint32;
    /// Number of failed probes before timeout.
    probeCount: uint32;
}

/// Socket packet timestamping mode.
export enum SocketPacketTimestampMode {
    /// Packet timestamps are disabled.
    Off = 0,
    /// Software timestamps are enabled.
    Software = 1,
    /// Hardware timestamps are enabled when available.
    Hardware = 2,
}

/// Socket option key.
@derive(Tagged)
export newtype SocketOption =
    | { kind: "reuseAddress" }
    | { kind: "reusePort" }
    | { kind: "broadcast" }
    | { kind: "receiveBufferBytes" }
    | { kind: "sendBufferBytes" }
    | { kind: "receiveTimeoutMilliseconds" }
    | { kind: "sendTimeoutMilliseconds" }
    | { kind: "linger" }
    | { kind: "ttl" }
    | { kind: "trafficClass" }
    | { kind: "ipv6Only" }
    | { kind: "tcpNoDelay" }
    | { kind: "tcpKeepAlive" }
    | { kind: "packetMark" }
    | { kind: "packetTimestamp" };

/// Socket option value.
@derive(Tagged)
export newtype SocketOptionValue =
    | { kind: "reuseAddress"; value: boolean }
    | { kind: "reusePort"; value: boolean }
    | { kind: "broadcast"; value: boolean }
    | { kind: "receiveBufferBytes"; value: uint32 }
    | { kind: "sendBufferBytes"; value: uint32 }
    | { kind: "receiveTimeoutMilliseconds"; value: uint32 }
    | { kind: "sendTimeoutMilliseconds"; value: uint32 }
    | { kind: "linger"; value: SocketLinger }
    | { kind: "ttl"; value: uint32 }
    | { kind: "trafficClass"; value: uint32 }
    | { kind: "ipv6Only"; value: boolean }
    | { kind: "tcpNoDelay"; value: boolean }
    | { kind: "tcpKeepAlive"; value: TcpKeepAlive }
    | { kind: "packetMark"; value: uint32 }
    | { kind: "packetTimestamp"; value: SocketPacketTimestampMode };

/// Raw socket option key.
export struct RawSocketOption {
    /// Socket option level.
    level: int32;
    /// Socket option name.
    name: int32;
}

/// Set one normalized socket option.
@binding("destack.net.options.set", {
    effect: "external",
    requires: ["host.net.option"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setSocketOption(
    socket: SocketHandle,
    option: SocketOptionValue,
): Result<void, PlatformError>;

/// Read one normalized socket option.
@binding("destack.net.options.get", {
    effect: "external",
    requires: ["host.net.option"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getSocketOption(
    socket: SocketHandle,
    option: SocketOption,
): Result<SocketOptionValue, PlatformError>;

/// Set one raw socket option from bytes.
@binding("destack.net.options.setRaw", {
    effect: "external",
    requires: ["host.net.option"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setRawSocketOption(
    socket: SocketHandle,
    option: RawSocketOption,
    value: &readonly [uint8],
): Result<void, PlatformError>;

/// Read one raw socket option into a caller-owned buffer.
@binding("destack.net.options.getRaw", {
    effect: "external",
    requires: ["host.net.option"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getRawSocketOption(
    socket: SocketHandle,
    option: RawSocketOption,
    value: &[uint8],
): Result<uint64, PlatformError>;
