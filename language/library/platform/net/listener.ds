import type { PlatformError } from "../error/index.ds";
import { ListenerHandle, SocketHandle } from "../resource/index.ds";
import { SocketAddress } from "./address.ds";

/// Accept flags for listener sockets.
///
/// This value is a normalized accept-flag bitset.
/// The runtime maps it to native accept controls such as SOCK_NONBLOCK and SOCK_CLOEXEC.
export newtype AcceptFlags = uint32;
/// Accept the socket in nonblocking mode.
export const ACCEPT_NONBLOCK: AcceptFlags = AcceptFlags(1 << 0);
/// Accept the socket with close-on-exec or non-inheritable semantics.
export const ACCEPT_CLOEXEC: AcceptFlags = AcceptFlags(1 << 1);

/// Start listening on a raw socket address.
@binding("destack.net.listener.listen", {
    effect: "external",
    requires: ["net.listen"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listen(
    address: SocketAddress,
    backlog: uint32,
): Result<ListenerHandle, PlatformError>;

/// Bind an existing socket to a raw address.
@binding("destack.net.listener.bind", {
    effect: "external",
    requires: ["net.listen"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bind(handle: SocketHandle, address: SocketAddress): Result<void, PlatformError>;

/// Accept a new connection from a listener.
@binding("destack.net.listener.accept", {
    effect: "external",
    requires: ["net.accept"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function accept(
    listener: ListenerHandle,
    flags: AcceptFlags,
): Result<SocketHandle, PlatformError>;

/// Close a listener handle.
@binding("destack.net.listener.closeListener", {
    effect: "external",
    requires: ["net.close"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeListener(handle: ListenerHandle): Result<void, PlatformError>;
