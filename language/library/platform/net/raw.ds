import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketFamily } from "./address.ds";
import { SocketHandle } from "../resource/index.ds";

/// Packet timestamp mode.
export enum PacketTimestampMode {
    /// Disable packet timestamps.
    Disabled = 0,
    /// Enable software timestamps.
    Software = 1,
    /// Enable hardware timestamps when available.
    Hardware = 2,
}

/// Packet timestamp clock domain.
export enum PacketTimestampClock {
    /// No packet timestamp is present.
    None = 0,
    /// Timestamp is in the host wall-clock domain.
    Wall = 1,
    /// Timestamp is in the host monotonic clock domain.
    Monotonic = 2,
    /// Timestamp is in one backend-specific hardware clock domain.
    HardwareRaw = 3,
}

/// Packet backend selector.
export enum PacketBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Linux AF_PACKET backend.
    AfPacket = 1,
    /// BSD BPF device backend.
    Bpf = 2,
    /// Windows raw-socket backend.
    WinRawSocket = 3,
    /// Null backend for tests and simulation.
    Null = 255,
}

/// Packet backend selection policy.
export enum PacketBackendSelectionPolicy {
    /// Require that the requested backend is used with no fallback.
    Strict = 1,
    /// Allow fallback to one host-default backend when unavailable.
    AllowFallback = 2,
}

/// Packet backend action flags.
export newtype PacketBackendCapabilityFlags = uint64;

/// Packet backend descriptor.
export struct PacketBackendDescriptor {
    /// Backend selector.
    backend: PacketBackend;
    /// Stable backend name.
    name: string;
    /// Whether this backend is currently available on this host.
    available: boolean;
    /// Priority in default auto-selection order.
    priority: uint16;
    /// Backend action flags.
    capabilityFlags: PacketBackendCapabilityFlags;
}

/// Backend action flag bit for packet capture operations.
export const PACKET_BACKEND_CAP_CAPTURE: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x1);
/// Backend action flag bit for packet send operations.
export const PACKET_BACKEND_CAP_SEND: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x2);
/// Backend action flag bit for timestamp configuration.
export const PACKET_BACKEND_CAP_TIMESTAMP: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x4);
/// Backend action flag bit for packet filter programs.
export const PACKET_BACKEND_CAP_FILTER: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x8);
/// Backend action flag bit for packet fanout operations.
export const PACKET_BACKEND_CAP_FANOUT: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x10);
/// Backend action flag bit for packet ring operations.
export const PACKET_BACKEND_CAP_RING: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x20);

/// Packet capture options.
export struct PacketCaptureOptions {
    /// Preferred packet backend selector.
    backend: PacketBackend;
    /// Packet backend selection policy.
    backendPolicy: PacketBackendSelectionPolicy;
    /// Interface index for capture.
    interfaceIndex: uint32;
    /// Maximum frame bytes per packet.
    snapLength: uint32;
    /// Capture timeout in milliseconds.
    timeoutMs: int32;
    /// Whether promiscuous mode is requested.
    promiscuous: boolean;
}

/// Captured packet metadata.
export struct PacketCaptureRecord {
    /// Number of packet bytes written to the target buffer.
    bytes: uint64;
    /// Interface index that produced the packet.
    interfaceIndex: uint32;
    /// Packet timestamp clock domain.
    timestampClock: PacketTimestampClock;
    /// Capture timestamp in nanoseconds for `timestampClock`.
    timestampNs: uint64;
    /// Whether packet bytes were truncated.
    truncated: boolean;
}

/// Packet capture backend statistics.
export struct PacketCaptureStats {
    /// Number of packets received by the backend.
    receivedPackets: uint64;
    /// Number of packets dropped by the backend.
    droppedPackets: uint64;
    /// Number of packets dropped by the interface.
    interfaceDroppedPackets: uint64;
}

/// Packet fanout mode for shared packet sockets.
export enum PacketFanoutMode {
    /// Hash packets across sockets.
    Hash = 0,
    /// Load balance packets across sockets.
    LoadBalance = 1,
    /// Forward packets to the same CPU socket.
    Cpu = 2,
    /// Use round robin packet distribution.
    RoundRobin = 3,
    /// Use rollover failover packet distribution.
    Rollover = 4,
    /// Keep flows and load balance across sockets.
    QueueMap = 5,
}

/// Packet fanout options for packet sockets.
export struct PacketFanoutOptions {
    /// Fanout group identifier.
    groupId: uint16;
    /// Fanout algorithm mode.
    mode: PacketFanoutMode;
    /// Mode-specific fanout flags.
    flags: uint16;
}

/// Packet ring options for rx and tx packet queues.
export struct PacketRingOptions {
    /// Ring block size in bytes.
    blockSize: uint32;
    /// Number of blocks in the ring.
    blockCount: uint32;
    /// Frame size in bytes.
    frameSize: uint32;
    /// Number of frames in the ring.
    frameCount: uint32;
    /// Block retire timeout in milliseconds.
    retireTimeoutMs: uint32;
}

/// List host packet backends.
@binding("destack.net.raw.packetBackendList", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetBackendList(): Result<Slice<PacketBackendDescriptor>, PlatformError>;

/// Open a raw IP socket.
@binding("destack.net.raw.socket", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawSocket(
    family: SocketFamily,
    protocol: int32,
): Result<SocketHandle, PlatformError>;

/// Enable or disable IP header inclusion on a raw socket.
@binding("destack.net.raw.setHeaderIncluded", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawSetHeaderIncluded(
    handle: SocketHandle,
    enabled: boolean,
): Result<void, PlatformError>;

/// Open a packet capture or inject endpoint.
@binding("destack.net.raw.packetOpen", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetOpen(options: PacketCaptureOptions): Result<SocketHandle, PlatformError>;

/// Receive one packet from a packet endpoint.
@binding("destack.net.raw.packetReceive", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetReceive(
    handle: SocketHandle,
    payload: Slice<uint8>,
): Result<PacketCaptureRecord, PlatformError>;

/// Send one packet through a packet endpoint.
@binding("destack.net.raw.packetSend", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSend(
    handle: SocketHandle,
    payload: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Configure packet timestamp mode for a socket or packet endpoint.
@binding("destack.net.raw.packetSetTimestampMode", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSetTimestampMode(
    handle: SocketHandle,
    mode: PacketTimestampMode,
): Result<void, PlatformError>;

/// Attach one packet filter program to a raw endpoint.
@binding("destack.net.raw.packetSetFilter", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSetFilter(
    handle: SocketHandle,
    filterProgram: Slice<uint8>,
): Result<void, PlatformError>;

/// Clear the active packet filter program.
@binding("destack.net.raw.packetClearFilter", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetClearFilter(handle: SocketHandle): Result<void, PlatformError>;

/// Set packet fanout on a packet endpoint.
@binding("destack.net.raw.packetSetFanout", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSetFanout(
    handle: SocketHandle,
    options: PacketFanoutOptions,
): Result<void, PlatformError>;

/// Clear packet fanout from a packet endpoint.
@binding("destack.net.raw.packetClearFanout", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetClearFanout(handle: SocketHandle): Result<void, PlatformError>;

/// Configure one packet rx ring for zero-copy capture.
@binding("destack.net.raw.packetSetRxRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSetRxRing(
    handle: SocketHandle,
    options: PacketRingOptions,
): Result<void, PlatformError>;

/// Configure one packet tx ring for zero-copy transmit.
@binding("destack.net.raw.packetSetTxRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetSetTxRing(
    handle: SocketHandle,
    options: PacketRingOptions,
): Result<void, PlatformError>;

/// Clear packet rx and tx ring configuration.
@binding("destack.net.raw.packetClearRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetClearRing(handle: SocketHandle): Result<void, PlatformError>;

/// Read packet capture statistics from one endpoint.
@binding("destack.net.raw.packetStats", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetStats(handle: SocketHandle): Result<PacketCaptureStats, PlatformError>;
