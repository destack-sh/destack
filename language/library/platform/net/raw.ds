import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { PacketHandle, SocketHandle } from "../resource/index.ds";
import { SocketFamily } from "./address.ds";

/// Packet backend selector.
export enum PacketBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Linux AF_PACKET backend.
    AfPacket = 1,
    /// BSD BPF device backend.
    Bpf = 2,
    /// Windows raw socket backend.
    WindowsRawSocket = 3,
}

/// Packet backend features.
export newtype PacketBackendFeatures = uint64;

/// Backend supports packet capture.
export const PACKET_CAPTURE: PacketBackendFeatures = PacketBackendFeatures(0x1);

/// Backend supports packet injection.
export const PACKET_SEND: PacketBackendFeatures = PacketBackendFeatures(0x2);

/// Backend supports packet timestamps.
export const PACKET_TIMESTAMP: PacketBackendFeatures = PacketBackendFeatures(0x4);

/// Backend supports packet filters.
export const PACKET_FILTER: PacketBackendFeatures = PacketBackendFeatures(0x8);

/// Backend supports fanout groups.
export const PACKET_FANOUT: PacketBackendFeatures = PacketBackendFeatures(0x10);

/// Backend supports packet rings.
export const PACKET_RING: PacketBackendFeatures = PacketBackendFeatures(0x20);

/// Packet backend status.
export struct PacketBackendStatus {
    /// Backend selector.
    backend: PacketBackend;
    /// Stable backend name.
    name: string;
    /// Whether this backend is available.
    isAvailable: boolean;
    /// Priority in auto-selection order.
    priority: uint16;
    /// Backend features.
    features: PacketBackendFeatures;
}

/// Packet timestamp clock domain.
export enum PacketTimestampClock {
    /// No packet timestamp is present.
    None = 0,
    /// Timestamp is in the host wall-clock domain.
    Wall = 1,
    /// Timestamp is in the host monotonic clock domain.
    Monotonic = 2,
    /// Timestamp is in one backend-specific hardware clock domain.
    Hardware = 3,
}

/// Packet endpoint options.
export struct PacketOpenOptions {
    /// Preferred packet backend.
    backend: PacketBackend;
    /// Interface index for capture or injection.
    interfaceIndex: uint32;
    /// Maximum frame bytes per packet.
    snapLength: uint32;
    /// Capture timeout in milliseconds.
    timeoutMilliseconds?: uint32;
    /// Whether promiscuous mode is requested.
    isPromiscuous: boolean;
}

/// Captured packet metadata.
export struct PacketRecord {
    /// Packet bytes written to the payload buffer.
    bytes: uint64;
    /// Interface index that produced the packet.
    interfaceIndex: uint32;
    /// Packet timestamp clock domain.
    timestampClock: PacketTimestampClock;
    /// Capture timestamp in nanoseconds for `timestampClock`.
    timestampNanoseconds: uint64;
    /// Whether packet bytes were truncated.
    isTruncated: boolean;
}

/// Packet capture statistics.
export struct PacketStats {
    /// Packets received by the backend.
    receivedPackets: uint64;
    /// Packets dropped by the backend.
    droppedPackets: uint64;
    /// Packets dropped by the interface.
    interfaceDroppedPackets: uint64;
}

/// Packet fanout mode.
export enum PacketFanoutMode {
    /// Hash packets across sockets.
    Hash = 0,
    /// Load balance packets across sockets.
    LoadBalance = 1,
    /// Forward packets to the same CPU socket.
    Cpu = 2,
    /// Use round-robin packet distribution.
    RoundRobin = 3,
    /// Use rollover failover packet distribution.
    Rollover = 4,
    /// Keep flows and load balance across sockets.
    QueueMap = 5,
}

/// Packet fanout options.
export struct PacketFanoutOptions {
    /// Fanout group identifier.
    groupId: uint16;
    /// Fanout mode.
    mode: PacketFanoutMode;
    /// Mode-specific flags.
    flags: uint16;
}

/// Packet ring options.
export struct PacketRingOptions {
    /// Ring block size in bytes.
    blockSize: uint32;
    /// Number of blocks in the ring.
    blockCount: uint32;
    /// Frame size in bytes.
    frameSize: uint32;
    /// Number of frames in the ring.
    frameCount: uint32;
    /// Block retire timeout in milliseconds.
    retireTimeoutMilliseconds: uint32;
}

/// List host packet backends.
@binding("destack.net.raw.packetBackends", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listPacketBackends(): Result<^Array<PacketBackendStatus>, PlatformError>;

/// Open a raw IP socket.
@binding("destack.net.raw.socket", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openRawSocket(
    family: SocketFamily,
    protocol: int32,
): Result<SocketHandle, PlatformError>;

/// Enable or disable IP header inclusion on a raw socket.
@binding("destack.net.raw.headerIncluded", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setHeaderIncluded(
    socket: SocketHandle,
    isEnabled: boolean,
): Result<void, PlatformError>;

/// Open a packet capture or injection endpoint.
@binding("destack.net.raw.packetOpen", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openPacketEndpoint(
    options: PacketOpenOptions,
): Result<PacketHandle, PlatformError>;

/// Receive one packet from a packet endpoint.
@binding("destack.net.raw.packetReceive", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function receivePacket(
    packet: PacketHandle,
    payload: &[uint8],
): Result<PacketRecord, PlatformError>;

/// Send one packet through a packet endpoint.
@binding("destack.net.raw.packetSend", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sendPacket(
    packet: PacketHandle,
    payload: &readonly [uint8],
): Result<uint64, PlatformError>;

/// Attach one packet filter program to an endpoint.
@binding("destack.net.raw.packetFilter", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPacketFilter(
    packet: PacketHandle,
    program: &readonly [uint8],
): Result<void, PlatformError>;

/// Clear the active packet filter program.
@binding("destack.net.raw.packetClearFilter", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clearPacketFilter(packet: PacketHandle): Result<void, PlatformError>;

/// Set packet fanout on an endpoint.
@binding("destack.net.raw.packetFanout", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPacketFanout(
    packet: PacketHandle,
    options: PacketFanoutOptions,
): Result<void, PlatformError>;

/// Clear packet fanout from an endpoint.
@binding("destack.net.raw.packetClearFanout", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clearPacketFanout(packet: PacketHandle): Result<void, PlatformError>;

/// Configure one packet receive ring.
@binding("destack.net.raw.packetReceiveRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPacketReceiveRing(
    packet: PacketHandle,
    options: PacketRingOptions,
): Result<void, PlatformError>;

/// Configure one packet transmit ring.
@binding("destack.net.raw.packetSendRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPacketSendRing(
    packet: PacketHandle,
    options: PacketRingOptions,
): Result<void, PlatformError>;

/// Clear packet ring configuration.
@binding("destack.net.raw.packetClearRing", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clearPacketRing(packet: PacketHandle): Result<void, PlatformError>;

/// Read packet endpoint statistics.
@binding("destack.net.raw.packetStats", {
    effect: "external",
    requires: ["net.raw"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function packetStats(packet: PacketHandle): Result<PacketStats, PlatformError>;
