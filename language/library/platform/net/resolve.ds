import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketAddress, SocketFamily } from "./address.ds";

/// Address resolution flags.
///
/// This value maps to native resolver flags such as AI_PASSIVE and AI_ADDRCONFIG.
/// Unsupported bits are rejected with `invalidArgument` or `notSupported`.
export newtype ResolveFlags = uint32;

/// Reverse lookup flags.
///
/// This value maps to native reverse-lookup flags such as NI_NUMERICHOST and NI_NUMERICSERV.
/// Unsupported bits are rejected with `invalidArgument` or `notSupported`.
export newtype ReverseLookupFlags = uint32;

/// Host and service query payload for address resolution.
export struct ResolveQuery {
    /// Hostname or numeric host literal when provided.
    host: string | void;
    /// Service name or numeric port string when provided.
    service: string | void;
    /// Requested address family filter.
    family: SocketFamily;
    /// Native resolver flags.
    flags: ResolveFlags;
}

/// Reverse lookup host and service result.
export struct ReverseLookupName {
    /// Resolved host value.
    host: string;
    /// Resolved service value.
    service: string;
}

/// Resolve a host and service query into raw socket addresses.
///
/// Resolve the requested host and service to one or more socket addresses.
/// Name-service order, search domains, and canonicalization follow host resolver policy.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses getaddrinfo(3) on Unix and GetAddrInfoW on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.dns`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.resolve.lookup", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.dns"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function resolve(query: ResolveQuery): Result<Array<SocketAddress>, PlatformError>;

/// Reverse lookup a raw socket address into host and service names.
///
/// Resolve a socket address back to host and service names.
/// Reverse lookup policy and name formatting follow host resolver behavior.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses getnameinfo(3) on Unix and GetNameInfoW on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.dns`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.resolve.reverseLookup", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.dns"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function reverseLookup(
    address: SocketAddress,
    flags: ReverseLookupFlags,
): Result<Array<ReverseLookupName>, PlatformError>;
