import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { IpAddress, IpEndpoint, SocketAddress, SocketFamily } from "./address.ds";
import { SocketProtocol, SocketType } from "./socket.ds";

/// Address lookup flags.
export newtype LookupFlags = uint32;

/// Return socket addresses that can be used for bind.
export const LOOKUP_PASSIVE: LookupFlags = LookupFlags(0x1);

/// Return canonical names when available.
export const LOOKUP_CANONICAL_NAME: LookupFlags = LookupFlags(0x2);

/// Return only addresses configured on this host.
export const LOOKUP_ADDRESS_CONFIGURED: LookupFlags = LookupFlags(0x4);

/// Return numeric host results only.
export const LOOKUP_NUMERIC_HOST: LookupFlags = LookupFlags(0x8);

/// Return numeric service results only.
export const LOOKUP_NUMERIC_SERVICE: LookupFlags = LookupFlags(0x10);

/// Host and service lookup query.
export struct LookupQuery {
    /// Hostname or numeric host literal.
    host?: string;
    /// Service name or numeric port string.
    service?: string;
    /// Requested address family.
    family: SocketFamily;
    /// Requested socket type.
    socketType?: SocketType;
    /// Requested protocol.
    protocol?: SocketProtocol;
    /// Lookup flags.
    flags: LookupFlags;
}

/// Host and service lookup result.
export struct LookupAddress {
    /// Resolved socket address.
    address: SocketAddress;
    /// Canonical name when requested and available.
    canonicalName?: string;
}

/// DNS record type number.
export newtype DnsRecordType = uint16;

/// IPv4 address record.
export const DNS_A: DnsRecordType = DnsRecordType(1);

/// Authoritative name server record.
export const DNS_NS: DnsRecordType = DnsRecordType(2);

/// Canonical name record.
export const DNS_CNAME: DnsRecordType = DnsRecordType(5);

/// Start of authority record.
export const DNS_SOA: DnsRecordType = DnsRecordType(6);

/// Pointer record.
export const DNS_PTR: DnsRecordType = DnsRecordType(12);

/// Mail exchange record.
export const DNS_MX: DnsRecordType = DnsRecordType(15);

/// Text record.
export const DNS_TXT: DnsRecordType = DnsRecordType(16);

/// IPv6 address record.
export const DNS_AAAA: DnsRecordType = DnsRecordType(28);

/// Service locator record.
export const DNS_SRV: DnsRecordType = DnsRecordType(33);

/// Naming authority pointer record.
export const DNS_NAPTR: DnsRecordType = DnsRecordType(35);

/// Certification authority authorization record.
export const DNS_CAA: DnsRecordType = DnsRecordType(257);

/// DNS resolver options.
export struct DnsOptions {
    /// Explicit DNS servers.
    servers: Array<IpEndpoint>;
    /// Query timeout in milliseconds.
    timeoutMilliseconds: uint32;
    /// Maximum attempts before failure.
    attempts: uint32;
}

/// DNS query.
export struct DnsQuery {
    /// DNS name.
    name: string;
    /// Requested record type.
    record: DnsRecordType;
    /// Resolver options.
    options: DnsOptions;
}

/// Mail exchange record payload.
export struct MxRecord {
    /// Exchange priority.
    priority: uint16;
    /// Exchange host.
    exchange: string;
}

/// Start of authority record payload.
export struct SoaRecord {
    /// Primary name server.
    primary: string;
    /// Responsible mailbox.
    mailbox: string;
    /// Zone serial.
    serial: uint32;
    /// Refresh interval in seconds.
    refresh: uint32;
    /// Retry interval in seconds.
    retry: uint32;
    /// Expiry interval in seconds.
    expire: uint32;
    /// Minimum TTL in seconds.
    minimum: uint32;
}

/// Service locator record payload.
export struct SrvRecord {
    /// Record priority.
    priority: uint16;
    /// Record weight.
    weight: uint16;
    /// Service port.
    port: uint16;
    /// Target host.
    target: string;
}

/// Naming authority pointer record payload.
export struct NaptrRecord {
    /// Record order.
    order: uint16;
    /// Record preference.
    preference: uint16;
    /// Flags string.
    flags: string;
    /// Service string.
    service: string;
    /// Replacement expression.
    regexp: string;
    /// Replacement domain.
    replacement: string;
}

/// Certification authority authorization record payload.
export struct CaaRecord {
    /// Record flags.
    flags: uint8;
    /// Property tag.
    tag: string;
    /// Property value.
    value: string;
}

/// Raw DNS record payload.
export struct RawDnsRecord {
    /// Record type number.
    record: DnsRecordType;
    /// Record payload bytes.
    bytes: uint8[];
}

/// DNS record payload.
export newtype DnsRecord =
    | { kind: "address"; address: IpAddress }
    | { kind: "name"; name: string }
    | { kind: "text"; chunks: Array<string> }
    | { kind: "mx"; record: MxRecord }
    | { kind: "soa"; record: SoaRecord }
    | { kind: "srv"; record: SrvRecord }
    | { kind: "naptr"; record: NaptrRecord }
    | { kind: "caa"; record: CaaRecord }
    | { kind: "raw"; record: RawDnsRecord };

/// Reverse lookup flags.
export newtype ReverseLookupFlags = uint32;

/// Return numeric host results.
export const REVERSE_NUMERIC_HOST: ReverseLookupFlags = ReverseLookupFlags(0x1);

/// Return numeric service results.
export const REVERSE_NUMERIC_SERVICE: ReverseLookupFlags = ReverseLookupFlags(0x2);

/// Reverse lookup result.
export struct ReverseLookupName {
    /// Resolved host value.
    host: string;
    /// Resolved service value.
    service: string;
}

/// Resolve a host and service through host address lookup.
@binding("destack.net.resolve.lookup", {
    effect: "external",
    requires: ["net.dns"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function lookupAddress(
    query: LookupQuery,
): Result<Array<LookupAddress>, PlatformError>;

/// Resolve DNS records.
@binding("destack.net.resolve.record", {
    effect: "external",
    requires: ["net.dns"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function resolveRecord(query: DnsQuery): Result<Array<DnsRecord>, PlatformError>;

/// Reverse lookup a socket address into host and service names.
@binding("destack.net.resolve.reverseLookup", {
    effect: "external",
    requires: ["net.dns"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function reverseLookup(
    address: SocketAddress,
    flags: ReverseLookupFlags,
): Result<Array<ReverseLookupName>, PlatformError>;
