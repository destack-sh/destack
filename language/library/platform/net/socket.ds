import { Array, Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { TransferredHandle, SocketHandle } from "../resource/index.ds";
import { SocketAddress, SocketFamily } from "./address.ds";

/// Native socket type.
export newtype SocketType = uint32;

/// Native socket protocol.
export newtype SocketProtocol = int32;

/// Message flags for send and receive operations.
export newtype SocketMessageFlags = uint32;

/// Shutdown mode for sockets.
export enum SocketShutdown {
    /// Shut down reads.
    Read = 0,
    /// Shut down writes.
    Write = 1,
    /// Shut down reads and writes.
    ReadWrite = 2,
}

/// Socket credentials captured from ancillary data.
export struct SocketCredentials {
    /// Process identifier.
    pid: uint32;
    /// User identifier.
    uid: uint32;
    /// Group identifier.
    gid: uint32;
}

/// Raw ancillary control buffer payload.
export newtype SocketControlBuffer = uint8[];

/// Outbound message metadata for sendmsg.
export struct SocketSendMessage {
    /// Destination address for explicit routing.
    address: SocketAddress | void;
    /// Resource handles to pass.
    fds: Array<TransferredHandle>;
    /// Raw ancillary control payload.
    control: SocketControlBuffer;
    /// Per-send flags passed to sendmsg.
    flags: SocketMessageFlags;
    /// Credentials to send when enabled.
    credentials: SocketCredentials | void;
}

/// Inbound message metadata for recvmsg.
export struct SocketRecvMessage {
    /// Number of payload bytes received.
    bytes: uint64;
    /// Source address when returned by the host.
    address: SocketAddress | void;
    /// Flags returned by recvmsg.
    recvFlags: SocketMessageFlags;
    /// Whether payload bytes were truncated.
    payloadTruncated: boolean;
    /// Whether ancillary data was truncated.
    controlTruncated: boolean;
    /// Raw ancillary control payload.
    control: SocketControlBuffer;
    /// Resource handles received from the peer.
    fds: Array<TransferredHandle>;
    /// Credentials captured from the peer when available.
    credentials: SocketCredentials | void;
}

/// Outbound payload for sendto-style calls.
export struct SocketSendTo {
    /// Destination address.
    address: SocketAddress;
    /// Per-send flags passed to sendto.
    flags: SocketMessageFlags;
}

/// Inbound payload for recvfrom-style calls.
export struct SocketRecvFrom {
    /// Number of payload bytes received.
    bytes: uint64;
    /// Source address.
    address: SocketAddress;
    /// Flags returned by recvfrom-style calls.
    recvFlags: SocketMessageFlags;
}

/// One sendmmsg entry payload.
export struct SocketSendBatchEntry {
    /// Payload bytes for this message.
    payload: Slice<uint8>;
    /// Message metadata for this payload.
    message: SocketSendMessage;
}

/// One recvmmsg entry request.
export struct SocketRecvBatchRequest {
    /// Payload buffer for this message.
    payload: Slice<uint8>;
    /// Per-message receive flags.
    recvFlags: SocketMessageFlags;
}

/// Pair of connected socket handles.
export struct SocketPair {
    /// First socket in the pair.
    first: SocketHandle;
    /// Second socket in the pair.
    second: SocketHandle;
}

/// Create a socket from a native family, type, and protocol.
///
/// Allocate a new socket endpoint with the requested family, type, and protocol number.
/// Protocol defaults and socket limits are determined by the host kernel.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses socket(2) on Unix and WSASocketW on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.control"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function socket(
    family: SocketFamily,
    socketType: SocketType,
    protocol: SocketProtocol,
): Result<SocketHandle, PlatformError>;

/// Create a connected socket pair.
///
/// Allocate two already-connected peer sockets for local full-duplex communication.
/// `SocketFamily.Unspecified` creates one local AF_UNIX pair where supported, while `SocketFamily.IPv4` and `SocketFamily.IPv6` use one loopback transport pair.
/// Pair creation semantics and descriptor inheritance follow host kernel behavior.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses socketpair(2) for `SocketFamily.Unspecified` and loopback-pair emulation for IP families.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.openPair", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function socketPair(
    family: SocketFamily,
    socketType: SocketType,
    protocol: SocketProtocol,
): Result<SocketPair, PlatformError>;

/// Connect to a remote socket address.
///
/// Connect the socket to a specific remote endpoint.
/// Handshake progress and connection failure conditions follow host kernel connect semantics.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses connect(2) on Unix and connect/WSAConnect on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.connect", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function connect(
    handle: SocketHandle,
    address: SocketAddress,
): Result<void, PlatformError>;

/// Close a socket handle.
///
/// Close the target socket descriptor.
/// Close-on-pending-I/O behavior follows host kernel socket semantics.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses close(2) on Unix and closesocket on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.close`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.close"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function close(handle: SocketHandle): Result<void, PlatformError>;

/// Read from a socket into the provided slice.
///
/// Transfer bytes directly between caller buffers and host descriptors using short I/O semantics.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses read(2)/recv(2) on Unix and recv on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function read(handle: SocketHandle, buffer: Slice<uint8>): Result<uint64, PlatformError>;

/// Read into multiple buffers.
///
/// Transfer bytes directly between caller buffers and host descriptors using short I/O semantics.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses readv(2)/recvmsg(2) on Unix and WSARecv on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.readv", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function readv(
    handle: SocketHandle,
    buffers: Slice<Slice<uint8>>,
): Result<uint64, PlatformError>;

/// Write to a socket from the provided slice.
///
/// Write data directly from caller provided buffers to the target descriptor using native transfer semantics.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses write(2)/send(2) on Unix and send on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.write", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function write(
    handle: SocketHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write from multiple buffers.
///
/// Write data directly from caller provided buffers to the target descriptor using native transfer semantics.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses writev(2)/sendmsg(2) on Unix and WSASend on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.connect`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.writev", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.connect"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function writev(
    handle: SocketHandle,
    buffers: Slice<Slice<uint8>>,
): Result<uint64, PlatformError>;

/// Receive a message with ancillary data.
///
/// Receive a message with ancillary data via host kernel APIs.
/// Caller controls descriptor and control payload extraction limits through `maxFds` and `maxControlBytes`.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses recvmsg(2) on Unix and WSARecvMsg on Windows where available.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.recvMsg", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.control"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function recvMsg(
    handle: SocketHandle,
    buffer: Slice<uint8>,
    recvFlags: SocketMessageFlags,
    maxFds: uint32,
    wantCredentials: boolean,
    maxControlBytes: uint32,
): Result<SocketRecvMessage, PlatformError>;

/// Send a message with ancillary data.
///
/// Send a message with ancillary data via host kernel APIs.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses sendmsg(2) on Unix and WSASendMsg on Windows where available.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.sendMsg", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.control"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function sendMsg(
    handle: SocketHandle,
    buffer: Slice<uint8>,
    message: SocketSendMessage,
): Result<uint64, PlatformError>;

/// Receive a packet from a remote socket address.
///
/// Receive one datagram and source address from a datagram socket.
/// Source address decoding and flag reporting follow host kernel recvfrom semantics.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses recvfrom(2) on Unix and recvfrom on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.udp`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.socket.recvFrom", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.udp"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function recvFrom(
    handle: SocketHandle,
    buffer: Slice<uint8>,
    recvFlags: SocketMessageFlags,
): Result<SocketRecvFrom, PlatformError>;

/// Send a packet to a remote socket address.
///
/// Send a packet to a remote socket address via host kernel APIs.
/// Partial transfers are preserved exactly as reported by the host, and callers must loop when full completion is required.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses sendto(2) on Unix and sendto on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.udp`.
