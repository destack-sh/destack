import type { PlatformError } from "../error/index.ds";
import { ListenerHandle, SocketHandle } from "../resource/index.ds";
import { Path } from "../fs/path.ds";
import { SocketPair, SocketType } from "./socket.ds";

/// Filesystem-backed unix domain socket address payload.
export struct UdsPathAddress {
    /// Discriminator for this uds address variant.
    kind: "path";
    /// Filesystem socket path.
    path: Path;
}

/// Linux abstract unix domain socket address payload.
export struct UdsAbstractAddress {
    /// Discriminator for this uds address variant.
    kind: "abstract";
    /// Abstract namespace name.
    abstractName: uint8[];
}

/// Unnamed unix domain socket address payload.
export struct UdsUnnamedAddress {
    /// Discriminator for this uds address variant.
    kind: "unnamed";
}

/// Unix domain socket address payload.
export newtype UdsAddress = UdsPathAddress | UdsAbstractAddress | UdsUnnamedAddress;

/// On byte path targets, `kind: "utf16"` inputs are transcoded before syscall dispatch.
@binding("destack.net.uds.udsConnect", {
    effect: "external",
    requires: ["net.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function udsConnect(address: UdsAddress): Result<SocketHandle, PlatformError>;

/// Listen on a UDS address.
@binding("destack.net.uds.udsListen", {
    effect: "external",
    requires: ["net.listen"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function udsListen(
    address: UdsAddress,
    backlog: uint32,
): Result<ListenerHandle, PlatformError>;

/// Accept a connection from a UDS listener.
@binding("destack.net.uds.udsAccept", {
    effect: "external",
    requires: ["net.accept"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function udsAccept(listener: ListenerHandle): Result<SocketHandle, PlatformError>;

/// Close a UDS listener handle.
@binding("destack.net.uds.udsCloseListener", {
    effect: "external",
    requires: ["net.close"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function udsCloseListener(handle: ListenerHandle): Result<void, PlatformError>;

/// Create a connected UDS socket pair.
@binding("destack.net.uds.udsSocketPair", {
    effect: "external",
    requires: ["net.connect"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function udsSocketPair(socketType: SocketType): Result<SocketPair, PlatformError>;
