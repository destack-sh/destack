import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { IpAddress, SocketFamily } from "./address.ds";

/// IP prefix.
export struct IpPrefix {
    /// Prefix address.
    address: IpAddress;
    /// Prefix length in bits.
    length: uint8;
}

/// Network route entry kind.
export enum NetworkRouteKind {
    /// Unicast route.
    Unicast = 1,
    /// Local route.
    Local = 2,
    /// Broadcast route.
    Broadcast = 3,
    /// Multicast route.
    Multicast = 4,
    /// Blackhole route.
    Blackhole = 5,
}

/// Network route table entry.
export struct NetworkRouteEntry {
    /// Route family.
    family: SocketFamily;
    /// Destination prefix.
    destination: IpPrefix;
    /// Next-hop gateway address.
    gateway?: IpAddress;
    /// Output interface index.
    interfaceIndex: uint32;
    /// Route metric.
    metric: uint32;
    /// Route kind.
    kind: NetworkRouteKind;
}

/// List route table entries.
@binding("destack.net.route.list", {
    effect: "external",
    requires: ["net.route.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listNetworkRoutes(
    family: SocketFamily,
): Result<^Array<NetworkRouteEntry>, PlatformError>;

/// Add a route table entry.
@binding("destack.net.route.add", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addNetworkRoute(route: NetworkRouteEntry): Result<void, PlatformError>;

/// Remove a route table entry.
@binding("destack.net.route.remove", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function removeNetworkRoute(route: NetworkRouteEntry): Result<void, PlatformError>;
