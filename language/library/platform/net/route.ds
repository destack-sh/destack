import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketAddress, SocketFamily } from "./address.ds";

/// Route entry kind.
export enum RouteKind {
    /// Unicast route.
    Unicast = 1,
    /// Local route.
    Local = 2,
    /// Broadcast route.
    Broadcast = 3,
    /// Multicast route.
    Multicast = 4,
    /// Blackhole route.
    Blackhole = 5,
}

/// Route table entry.
export struct RouteEntry {
    /// Route family.
    family: SocketFamily;
    /// Destination prefix address.
    destination: SocketAddress;
    /// Prefix length in bits.
    prefixLength: uint8;
    /// Next-hop gateway address.
    gateway: SocketAddress;
    /// Output interface index.
    interfaceIndex: uint32;
    /// Route metric.
    metric: uint32;
    /// Route kind.
    kind: RouteKind;
}

/// List route table entries.
@binding("destack.net.route.routeList", {
    effect: "external",
    requires: ["net.route.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function routeList(family: SocketFamily): Result<Array<RouteEntry>, PlatformError>;

/// Add a route table entry.
@binding("destack.net.route.routeAdd", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function routeAdd(route: RouteEntry): Result<void, PlatformError>;

/// Remove a route table entry.
@binding("destack.net.route.routeDelete", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function routeDelete(route: RouteEntry): Result<void, PlatformError>;
