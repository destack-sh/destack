import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { IpAddress, SocketFamily } from "./address.ds";

/// IP prefix.
export struct IpPrefix {
    /// Prefix address.
    address: IpAddress;
    /// Prefix length in bits.
    length: uint8;
}

/// Route entry kind.
export enum RouteKind {
    /// Unicast route.
    Unicast = 1,
    /// Local route.
    Local = 2,
    /// Broadcast route.
    Broadcast = 3,
    /// Multicast route.
    Multicast = 4,
    /// Blackhole route.
    Blackhole = 5,
}

/// Route table entry.
export struct RouteEntry {
    /// Route family.
    family: SocketFamily;
    /// Destination prefix.
    destination: IpPrefix;
    /// Next-hop gateway address.
    gateway?: IpAddress;
    /// Output interface index.
    interfaceIndex: uint32;
    /// Route metric.
    metric: uint32;
    /// Route kind.
    kind: RouteKind;
}

/// List route table entries.
@binding("destack.net.route.list", {
    effect: "external",
    requires: ["net.route.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listRoutes(family: SocketFamily): Result<^Array<RouteEntry>, PlatformError>;

/// Add a route table entry.
@binding("destack.net.route.add", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addRoute(route: RouteEntry): Result<void, PlatformError>;

/// Remove a route table entry.
@binding("destack.net.route.remove", {
    effect: "external",
    requires: ["net.route.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function removeRoute(route: RouteEntry): Result<void, PlatformError>;
