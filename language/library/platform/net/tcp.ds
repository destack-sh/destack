import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";

/// TCP keepalive parameters.
export struct KeepAliveConfig {
    /// Whether keepalive probes are enabled.
    enabled: boolean;
    /// Idle time before probes begin, in seconds.
    idleSeconds: uint32;
    /// Interval between probes, in seconds.
    intervalSeconds: uint32;
    /// Number of failed probes before timeout.
    probeCount: uint32;
}

/// Enable or disable TCP_NODELAY.
@binding("destack.net.tcp.setNoDelay", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setNoDelay(handle: SocketHandle, enabled: boolean): Result<void, PlatformError>;

/// Read TCP_NODELAY.
@binding("destack.net.tcp.getNoDelay", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getNoDelay(handle: SocketHandle): Result<boolean, PlatformError>;

/// Write full TCP keepalive parameters.
@binding("destack.net.tcp.setKeepAlive", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setKeepAlive(
    handle: SocketHandle,
    config: KeepAliveConfig,
): Result<void, PlatformError>;

/// Read full TCP keepalive parameters.
@binding("destack.net.tcp.getKeepAlive", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getKeepAlive(handle: SocketHandle): Result<KeepAliveConfig, PlatformError>;
