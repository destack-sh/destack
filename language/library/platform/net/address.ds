import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";

/// Socket address family.
export enum SocketFamily {
    /// Unspecified address family.
    Unspecified = 0,
    /// IPv4 address.
    IPv4 = 4,
    /// IPv6 address.
    IPv6 = 6,
}

/// Raw socket address payload.
export struct SocketAddress {
    /// Native address family.
    family: uint16;
    /// Length of the valid sockaddr payload in bytes.
    length: uint32;
    /// Raw sockaddr bytes.
    bytes: uint8[];
}

/// Read the local socket address as raw bytes.
///
/// Query the local socket endpoint currently bound to this handle.
/// The returned `length` and `bytes` preserve the host sockaddr layout for the active family.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses getsockname(2) on Unix and getsockname on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.address.localAddress", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.control"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function localAddress(handle: SocketHandle): Result<SocketAddress, PlatformError>;

/// Read the remote socket address as raw bytes.
///
/// Query the remote peer endpoint currently associated with this handle.
/// The returned `length` and `bytes` preserve the host sockaddr layout for the active family.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
/// Uses getpeername(2) on Unix and getpeername on Windows.
///
/// # Errors
/// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `net.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.net.address.peerAddress", {
    effect: "external",
    replay: "recordable",
    capabilities: ["net.control"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function peerAddress(handle: SocketHandle): Result<SocketAddress, PlatformError>;
