import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";

/// Enable or disable SO_REUSEADDR.
@binding("destack.net.reuse.setReuseAddr", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setReuseAddr(
    handle: SocketHandle,
    enabled: boolean,
): Result<void, PlatformError>;

/// Enable or disable SO_REUSEPORT.
@binding("destack.net.reuse.setReusePort", {
    effect: "external",
    requires: ["net.control"],
    families: ["unix"],
    simulation: true,
})
export declare function setReusePort(
    handle: SocketHandle,
    enabled: boolean,
): Result<void, PlatformError>;

/// Read SO_REUSEADDR.
@binding("destack.net.reuse.getReuseAddr", {
    effect: "external",
    requires: ["net.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getReuseAddr(handle: SocketHandle): Result<boolean, PlatformError>;

/// Read SO_REUSEPORT.
@binding("destack.net.reuse.getReusePort", {
    effect: "external",
    requires: ["net.control"],
    families: ["unix"],
    simulation: true,
})
export declare function getReusePort(handle: SocketHandle): Result<boolean, PlatformError>;
