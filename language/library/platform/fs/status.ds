import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { FileHandle } from "../resource/index.ds";
import { Entry } from "./entry.ds";
import { FileSize } from "./range.ds";

/// File permission mode bits.
export newtype FileMode = uint32;

/// File type bits mask.
export const MODE_TYPE: FileMode = FileMode(0xf000);

/// FIFO file type bits.
export const MODE_FIFO: FileMode = FileMode(0x1000);

/// Character device file type bits.
export const MODE_CHARACTER: FileMode = FileMode(0x2000);

/// Directory file type bits.
export const MODE_DIRECTORY: FileMode = FileMode(0x4000);

/// Block device file type bits.
export const MODE_BLOCK: FileMode = FileMode(0x6000);

/// Regular file type bits.
export const MODE_FILE: FileMode = FileMode(0x8000);

/// Symbolic link file type bits.
export const MODE_SYMLINK: FileMode = FileMode(0xa000);

/// Socket file type bits.
export const MODE_SOCKET: FileMode = FileMode(0xc000);

/// Owner read permission bit.
export const MODE_OWNER_READ: FileMode = FileMode(0x0100);

/// Owner write permission bit.
export const MODE_OWNER_WRITE: FileMode = FileMode(0x0080);

/// Owner execute permission bit.
export const MODE_OWNER_EXECUTE: FileMode = FileMode(0x0040);

/// Group read permission bit.
export const MODE_GROUP_READ: FileMode = FileMode(0x0020);

/// Group write permission bit.
export const MODE_GROUP_WRITE: FileMode = FileMode(0x0010);

/// Group execute permission bit.
export const MODE_GROUP_EXECUTE: FileMode = FileMode(0x0008);

/// Other read permission bit.
export const MODE_OTHER_READ: FileMode = FileMode(0x0004);

/// Other write permission bit.
export const MODE_OTHER_WRITE: FileMode = FileMode(0x0002);

/// Other execute permission bit.
export const MODE_OTHER_EXECUTE: FileMode = FileMode(0x0001);

/// File timestamp in nanoseconds since the Unix epoch.
export newtype FileTime = int64;

/// Access and modification timestamps.
export struct FileTimes {
    /// Last access time.
    access: FileTime;
    /// Last modification time.
    modification: FileTime;
}

/// Windows security identifier bytes.
export newtype PrincipalSid = Slice<uint8>;

/// File owner principal.
export newtype Principal =
    | { kind: "unix"; id: uint32 }
    | { kind: "windows"; sid: PrincipalSid };

/// File owner assignment.
export struct FileOwner {
    /// User owner principal.
    user: Principal | void;
    /// Group owner principal.
    group: Principal | void;
}

/// File status field mask.
export newtype StatusMask = uint32;

/// Request device identifier.
export const STATUS_DEVICE: StatusMask = StatusMask(0x0001);

/// Request node identifier.
export const STATUS_NODE: StatusMask = StatusMask(0x0002);

/// Request mode bits.
export const STATUS_MODE: StatusMask = StatusMask(0x0004);

/// Request hard link count.
export const STATUS_LINKS: StatusMask = StatusMask(0x0008);

/// Request owner principals.
export const STATUS_OWNER: StatusMask = StatusMask(0x0010);

/// Request node device identifier.
export const STATUS_NODE_DEVICE: StatusMask = StatusMask(0x0020);

/// Request file size.
export const STATUS_SIZE: StatusMask = StatusMask(0x0040);

/// Request allocated block fields.
export const STATUS_BLOCKS: StatusMask = StatusMask(0x0080);

/// Request access timestamp.
export const STATUS_ACCESS_TIME: StatusMask = StatusMask(0x0100);

/// Request modification timestamp.
export const STATUS_MODIFICATION_TIME: StatusMask = StatusMask(0x0200);

/// Request status change timestamp.
export const STATUS_CHANGE_TIME: StatusMask = StatusMask(0x0400);

/// Request file creation time.
export const STATUS_CREATED: StatusMask = StatusMask(0x0800);

/// Request mount identifier.
export const STATUS_MOUNT: StatusMask = StatusMask(0x1000);

/// Request the common portable status fields.
export const STATUS_BASIC: StatusMask = StatusMask(0x07ff);

/// Request all fields the host can provide.
export const STATUS_ALL: StatusMask = StatusMask(0x1fff);

/// File status flags.
export newtype StatusFlags = uint32;

/// Do not force attribute synchronization.
export const STATUS_DONT_SYNC: StatusFlags = StatusFlags(0x4000);

/// Force attribute synchronization when the host supports it.
export const STATUS_FORCE_SYNC: StatusFlags = StatusFlags(0x2000);

/// Allow an empty path for handle status by empty path.
export const STATUS_EMPTY_PATH: StatusFlags = StatusFlags(0x10);

/// File status options.
export struct StatusOptions {
    /// Whether the final path component should be followed when it is a symlink.
    isFollowing: boolean;
    /// Status behavior flags.
    flags: StatusFlags;
    /// Requested field mask.
    mask: StatusMask;
}

/// File status returned by host metadata operations.
export struct FileStatus {
    /// Mask of fields populated by the host.
    mask: StatusMask;
    /// Device identifier.
    device: uint64;
    /// Inode or file identifier.
    node: uint64;
    /// File mode bits.
    mode: FileMode;
    /// Hard link count.
    links: uint32;
    /// File owner principals.
    owner: FileOwner;
    /// Device identifier for device nodes.
    nodeDevice: uint64;
    /// File size in bytes.
    size: FileSize;
    /// Preferred block size for I/O.
    blockSize: uint64;
    /// Allocated block count.
    blocks: uint64;
    /// Last access time.
    accessTime: FileTime;
    /// Last modification time.
    modificationTime: FileTime;
    /// Last status change time.
    changeTime: FileTime;
    /// Creation time when available.
    creationTime: FileTime;
    /// Mount identifier when available.
    mount: uint64;
}

/// Read status for a filesystem entry.
@binding("destack.fs.status.entry", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function entryStatus(
    entry: Entry,
    options: StatusOptions,
): Result<FileStatus, PlatformError>;

/// Read status for an open file.
@binding("destack.fs.status.file", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function fileStatus(
    file: FileHandle,
    options: StatusOptions,
): Result<FileStatus, PlatformError>;
