/// Raw byte path on byte-oriented hosts.
export newtype PathBytes = uint8[];

/// UTF-16 path on UTF-16-oriented hosts.
export newtype PathUtf16 = uint16[];

/// Raw byte path output buffer.
export newtype PathByteBuffer = [uint8];

/// UTF-16 path output buffer.
export newtype PathUtf16Buffer = [uint16];

/// Byte-oriented host path.
export struct BytePath {
    /// Path representation tag.
    kind: "bytes";
    /// Raw path bytes.
    bytes: PathBytes;
}

/// UTF-16-oriented host path.
export struct Utf16Path {
    /// Path representation tag.
    kind: "utf16";
    /// UTF-16 code units.
    units: PathUtf16;
}

/// Host path payload.
export newtype Path = BytePath | Utf16Path;

/// Byte-oriented host path output buffer.
export struct BytePathBuffer {
    /// Path representation tag.
    kind: "bytes";
    /// Raw path byte buffer.
    bytes: PathByteBuffer;
}

/// UTF-16-oriented host path output buffer.
export struct Utf16PathBuffer {
    /// Path representation tag.
    kind: "utf16";
    /// UTF-16 unit buffer.
    units: PathUtf16Buffer;
}

/// Host path output buffer.
export newtype PathBuffer = BytePathBuffer | Utf16PathBuffer;

/// Path buffer span in bytes or UTF-16 units.
export struct PathSpan {
    /// Offset into the path buffer.
    offset: uint64;
    /// Length in bytes or UTF-16 units.
    length: uint64;
}

/// Build a byte-oriented host path.
export function pathBytes(bytes: PathBytes): Path {
    BytePath {
        kind: "bytes",
        bytes,
    }
}

/// Build a UTF-16-oriented host path.
export function pathUtf16(units: PathUtf16): Path {
    Utf16Path {
        kind: "utf16",
        units,
    }
}

/// Build a byte-oriented host path output buffer.
export function pathByteBuffer(bytes: PathByteBuffer): PathBuffer {
    BytePathBuffer {
        kind: "bytes",
        bytes,
    }
}

/// Build a UTF-16-oriented host path output buffer.
export function pathUtf16Buffer(units: PathUtf16Buffer): PathBuffer {
    Utf16PathBuffer {
        kind: "utf16",
        units,
    }
}
