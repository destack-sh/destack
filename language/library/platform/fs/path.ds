@binding("destack.fs.path.mkfifoat", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.special"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function mkfifoat(
    dir: DirectoryHandle,
    path: OsPath,
    mode: FileMode,
): Result<void, PlatformError>;

