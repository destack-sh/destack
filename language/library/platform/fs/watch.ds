import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { WatchHandle } from "../resource/index.ds";
import { Entry } from "./entry.ds";
import { PathBuffer, PathSpan } from "./path.ds";

/// Filesystem watch mask bitset.
export newtype WatchMask = uint32;

/// Watch mask bit for create events.
export const WATCH_CREATE: WatchMask = WatchMask(1 << 0);

/// Watch mask bit for remove events.
export const WATCH_REMOVE: WatchMask = WatchMask(1 << 1);

/// Watch mask bit for modify events.
export const WATCH_MODIFY: WatchMask = WatchMask(1 << 2);

/// Watch mask bit for rename events.
export const WATCH_RENAME: WatchMask = WatchMask(1 << 3);

/// Watch mask bit for metadata events.
export const WATCH_METADATA: WatchMask = WatchMask(1 << 4);

/// Watch mask bit for overflow events.
export const WATCH_OVERFLOW: WatchMask = WatchMask(1 << 5);

/// Watch mask value that subscribes to all event classes.
export const WATCH_ALL: WatchMask = WatchMask(0x3f);

/// Filesystem watch options.
export struct WatchOptions {
    /// Event mask to subscribe to.
    mask: WatchMask;
    /// Whether recursive watching is requested.
    isRecursive: boolean;
    /// Whether symlink entries should be followed.
    isFollowing: boolean;
}

/// Filesystem watch event.
export newtype WatchEvent =
    | { kind: "create"; cookie: uint64; path: PathSpan }
    | { kind: "remove"; cookie: uint64; path: PathSpan }
    | { kind: "modify"; cookie: uint64; path: PathSpan }
    | { kind: "rename"; cookie: uint64; path: PathSpan; related: PathSpan }
    | { kind: "metadata"; cookie: uint64; path: PathSpan }
    | { kind: "overflow"; cookie: uint64 };

/// Watch events written by one read operation.
export struct WatchBatch {
    /// Number of events written into the output slice.
    count: uint64;
    /// Path buffer length consumed by event paths.
    pathLength: uint64;
    /// Whether the host reported dropped events.
    hasOverflow: boolean;
}

/// Start watching one filesystem entry.
@binding("destack.fs.watch.open", {
    effect: "external",
    requires: ["fs.watch"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function watch(entry: Entry, options: WatchOptions): Result<WatchHandle, PlatformError>;

/// Read watch events into an output slice.
@binding("destack.fs.watch.read", {
    effect: "external",
    requires: ["fs.watch"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readWatch(
    watch: WatchHandle,
    events: Slice<WatchEvent>,
    paths: PathBuffer,
): Result<WatchBatch, PlatformError>;
