import { PlatformError } from "destack:platform/error";
import { FileHandle } from "destack:platform/resource";
import { FilesystemEntry } from "./entry.ds";

/// Volume mount flags.
export newtype FileVolumeFlags = uint64;

/// Volume status field mask.
export newtype FileVolumeMask = uint32;

/// Request transfer size fields.
export const FILE_VOLUME_TRANSFER: FileVolumeMask = FileVolumeMask(0x0003);

/// Request block count fields.
export const FILE_VOLUME_BLOCKS: FileVolumeMask = FileVolumeMask(0x001c);

/// Request file node count fields.
export const FILE_VOLUME_FILES: FileVolumeMask = FileVolumeMask(0x0060);

/// Request volume identifier.
export const FILE_VOLUME_ID: FileVolumeMask = FileVolumeMask(0x0080);

/// Request mount flags.
export const FILE_VOLUME_FLAGS: FileVolumeMask = FileVolumeMask(0x0100);

/// Request maximum filename length.
export const FILE_VOLUME_NAME_LENGTH: FileVolumeMask = FileVolumeMask(0x0200);

/// Request all fields the host can provide.
export const FILE_VOLUME_ALL: FileVolumeMask = FileVolumeMask(0x03ff);

/// Volume status returned by host metadata operations.
export struct FileVolumeStatus {
    /// Mask of fields populated by the host.
    mask: FileVolumeMask;
    /// Preferred transfer block size.
    blockSize: uint64;
    /// Fragment block size.
    fragmentSize: uint64;
    /// Total data block count.
    blocks: uint64;
    /// Free data block count.
    blocksFree: uint64;
    /// Free data block count available to unprivileged users.
    blocksAvailable: uint64;
    /// Total file node count.
    files: uint64;
    /// Free file node count.
    filesFree: uint64;
    /// Volume identifier.
    id: uint64;
    /// Volume mount flags.
    flags: FileVolumeFlags;
    /// Maximum filename length.
    nameLength: uint64;
}

/// Read status for the volume containing an entry.
@binding("destack.fs.volume.entry", {
    effect: "external",
    requires: ["fs.metadata"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readEntryVolume(
    entry: &readonly FilesystemEntry,
): Result<FileVolumeStatus, PlatformError>;

/// Read status for the volume containing an open file.
@binding("destack.fs.volume.file", {
    effect: "external",
    requires: ["fs.metadata"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readFileVolume(file: FileHandle): Result<FileVolumeStatus, PlatformError>;

/// Synchronize the volume containing an open file.
@binding("destack.fs.volume.sync", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncFileVolume(file: FileHandle): Result<void, PlatformError>;
