import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { FileHandle } from "../resource/index.ds";
import { Entry } from "./entry.ds";

/// Extended attribute creation flags.
export newtype XattrFlags = uint32;

/// Create an attribute and fail if it already exists.
export const XATTR_CREATE: XattrFlags = XattrFlags(0x1);

/// Replace an attribute and fail if it does not exist.
export const XATTR_REPLACE: XattrFlags = XattrFlags(0x2);

/// Target for extended attribute operations.
export newtype XattrTarget =
    | { kind: "entry"; entry: Entry; isFollowing: boolean }
    | { kind: "file"; file: FileHandle };

/// Read one extended attribute into an output buffer.
@binding("destack.fs.xattr.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.xattr"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function readXattr(
    target: XattrTarget,
    name: Slice<uint8>,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write one extended attribute.
@binding("destack.fs.xattr.write", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.xattr"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function writeXattr(
    target: XattrTarget,
    name: Slice<uint8>,
    value: Slice<uint8>,
    flags: XattrFlags,
): Result<void, PlatformError>;

/// List extended attribute names into an output buffer.
@binding("destack.fs.xattr.list", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.xattr"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function listXattrs(
    target: XattrTarget,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Remove one extended attribute.
@binding("destack.fs.xattr.remove", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.xattr"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function removeXattr(
    target: XattrTarget,
    name: Slice<uint8>,
): Result<void, PlatformError>;
