@binding("destack.fs.xattr.fsetxattr", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.xattr"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function fsetxattr(
    handle: FileHandle,
