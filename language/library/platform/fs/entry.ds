import { DirectoryHandle } from "../resource/index.ds";
import { Path } from "./path.ds";

/// Filesystem entry addressed by an optional directory root and host path.
export struct Entry {
    /// Directory root for relative resolution.
    directory: DirectoryHandle | void;
    /// Host path payload.
    path: Path;
}

/// Build an entry resolved from the ambient process namespace.
export function entry(path: Path): Entry {
    Entry {
        directory: undefined,
        path,
    }
}

/// Build an entry resolved relative to a directory handle.
export function entryAt(directory: DirectoryHandle, path: Path): Entry {
    Entry {
        directory,
        path,
    }
}
