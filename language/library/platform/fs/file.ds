import { PlatformError } from "destack:platform/error";
import { FileHandle } from "destack:platform/resource";
import { FilesystemEntry } from "./entry.ds";
import { FileOffset, FileRange, FileSize } from "./range.ds";
import { FileMode } from "./status.ds";

/// File open flags.
export newtype FileOpenFlags = uint32;

/// Open for reads.
export const FILE_OPEN_READ: FileOpenFlags = FileOpenFlags(0x0001);

/// Open for writes.
export const FILE_OPEN_WRITE: FileOpenFlags = FileOpenFlags(0x0002);

/// Create the entry when it does not exist.
export const FILE_OPEN_CREATE: FileOpenFlags = FileOpenFlags(0x0004);

/// Fail when the created entry already exists.
export const FILE_OPEN_EXCLUSIVE: FileOpenFlags = FileOpenFlags(0x0008);

/// Truncate the entry after opening.
export const FILE_OPEN_TRUNCATE: FileOpenFlags = FileOpenFlags(0x0010);

/// Append writes to the end of the file.
export const FILE_OPEN_APPEND: FileOpenFlags = FileOpenFlags(0x0020);

/// Require the entry to be a directory.
export const FILE_OPEN_DIRECTORY: FileOpenFlags = FileOpenFlags(0x0040);

/// Do not follow the final symlink component.
export const FILE_OPEN_NOFOLLOW: FileOpenFlags = FileOpenFlags(0x0080);

/// Request nonblocking file behavior.
export const FILE_OPEN_NONBLOCK: FileOpenFlags = FileOpenFlags(0x0100);

/// Request uncached direct I/O.
export const FILE_OPEN_DIRECT: FileOpenFlags = FileOpenFlags(0x0200);

/// Synchronize written data before writes complete.
export const FILE_OPEN_DATA_SYNC: FileOpenFlags = FileOpenFlags(0x0400);

/// Synchronize written data and metadata before writes complete.
export const FILE_OPEN_SYNC: FileOpenFlags = FileOpenFlags(0x0800);

/// Resolve flags for path opening.
export newtype FileResolveFlags = uint64;

/// Reject traversal that crosses into a different mount.
export const FILE_RESOLVE_NO_XDEV: FileResolveFlags = FileResolveFlags(0x01);

/// Reject magic link traversal.
export const FILE_RESOLVE_NO_MAGIC_LINKS: FileResolveFlags = FileResolveFlags(0x02);

/// Reject symlink traversal.
export const FILE_RESOLVE_NO_SYMLINKS: FileResolveFlags = FileResolveFlags(0x04);

/// Require the result to stay beneath the starting directory.
export const FILE_RESOLVE_BENEATH: FileResolveFlags = FileResolveFlags(0x08);

/// Treat the starting directory as the logical root.
export const FILE_RESOLVE_IN_ROOT: FileResolveFlags = FileResolveFlags(0x10);

/// Use only already cached resolution state.
export const FILE_RESOLVE_CACHED: FileResolveFlags = FileResolveFlags(0x20);

/// File open options.
export struct FileOpenOptions {
    /// Open behavior flags.
    flags: FileOpenFlags;
    /// File mode used when creating an entry.
    mode: FileMode;
    /// Path resolution flags.
    resolve: FileResolveFlags;
}

/// File read flags.
export newtype FileReadFlags = uint32;

/// Prefer high priority polling I/O when the host supports it.
export const FILE_READ_HIGH_PRIORITY: FileReadFlags = FileReadFlags(0x1);

/// Request nonblocking cache miss behavior when supported.
export const FILE_READ_NOWAIT: FileReadFlags = FileReadFlags(0x8);

/// File write flags.
export newtype FileWriteFlags = uint32;

/// Apply data-only sync mode to the write.
export const FILE_WRITE_DATA_SYNC: FileWriteFlags = FileWriteFlags(0x2);

/// Apply full sync mode to the write.
export const FILE_WRITE_SYNC: FileWriteFlags = FileWriteFlags(0x4);

/// Request nonblocking cache miss behavior when supported.
export const FILE_WRITE_NOWAIT: FileWriteFlags = FileWriteFlags(0x8);

/// Force append mode for the write.
export const FILE_WRITE_APPEND: FileWriteFlags = FileWriteFlags(0x10);

/// File read options.
export struct FileReadOptions {
    /// Explicit byte offset, or current descriptor position when absent.
    offset?: FileOffset;
    /// Read behavior flags.
    flags: FileReadFlags;
}

/// File write options.
export struct FileWriteOptions {
    /// Explicit byte offset, or current descriptor position when absent.
    offset?: FileOffset;
    /// Write behavior flags.
    flags: FileWriteFlags;
}

/// Seek origin.
export enum FileSeekOrigin {
    /// Seek from the start of the file.
    Start = 0,
    /// Seek from the current position.
    Current = 1,
    /// Seek from the end of the file.
    End = 2,
}

/// Sync range flags.
export newtype FileSyncFlags = uint32;

/// Wait for earlier writeback in the requested range.
export const FILE_SYNC_WAIT_BEFORE: FileSyncFlags = FileSyncFlags(0x1);

/// Start writeback for the requested range.
export const FILE_SYNC_WRITE: FileSyncFlags = FileSyncFlags(0x2);

/// Wait for writeback completion in the requested range.
export const FILE_SYNC_WAIT_AFTER: FileSyncFlags = FileSyncFlags(0x4);

/// File allocation flags.
export newtype FileAllocateFlags = uint32;

/// Allocate blocks without extending apparent file size.
export const FILE_ALLOCATE_KEEP_SIZE: FileAllocateFlags = FileAllocateFlags(0x01);

/// Deallocate blocks in the requested range.
export const FILE_ALLOCATE_PUNCH_HOLE: FileAllocateFlags = FileAllocateFlags(0x02);

/// Do not hide stale data when the host supports that mode.
export const FILE_ALLOCATE_NO_HIDE_STALE: FileAllocateFlags = FileAllocateFlags(0x04);

/// Remove the requested range and collapse later data downward.
export const FILE_ALLOCATE_COLLAPSE_RANGE: FileAllocateFlags = FileAllocateFlags(0x08);

/// Convert the requested range into explicit zeroed blocks.
export const FILE_ALLOCATE_ZERO_RANGE: FileAllocateFlags = FileAllocateFlags(0x10);

/// Insert a hole and push later data upward.
export const FILE_ALLOCATE_INSERT_RANGE: FileAllocateFlags = FileAllocateFlags(0x20);

/// Break shared extents before future writes.
export const FILE_ALLOCATE_UNSHARE_RANGE: FileAllocateFlags = FileAllocateFlags(0x40);

/// File access pattern advice.
export enum FileAdvice {
    /// No special behavior.
    Normal = 0,
    /// File will be accessed sequentially.
    Sequential = 1,
    /// File will be accessed randomly.
    Random = 2,
    /// File data will be needed soon.
    WillNeed = 3,
    /// File data will not be needed soon.
    DontNeed = 4,
    /// File data will be used once.
    NoReuse = 5,
}

/// File lock mode.
export enum FileLockMode {
    /// Acquire a shared lock.
    Shared = 1,
    /// Acquire an exclusive lock.
    Exclusive = 2,
    /// Release an existing lock.
    Unlock = 3,
}

/// File lock options.
export struct FileLockOptions {
    /// Lock mode.
    mode: FileLockMode;
    /// Byte range covered by the lock.
    range: FileRange;
    /// Whether the operation should fail instead of blocking.
    isNonblocking: boolean;
}

/// Open one filesystem entry as a file handle.
@binding("destack.fs.file.open", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openFile(
    entry: &readonly FilesystemEntry,
    options: FileOpenOptions,
): Result<FileHandle, PlatformError>;

/// Read bytes from an open file into an output buffer.
@binding("destack.fs.file.read", {
    effect: "external",
    requires: ["fs.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readFile(
    file: FileHandle,
    buffer: &[uint8],
    options: FileReadOptions,
): Result<uint64, PlatformError>;

/// Write bytes to an open file from an input buffer.
@binding("destack.fs.file.write", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeFile(
    file: FileHandle,
    buffer: &readonly [uint8],
    options: FileWriteOptions,
): Result<uint64, PlatformError>;

/// Read bytes from an open file into multiple output buffers.
@binding("destack.fs.file.readMany", {
    effect: "external",
    requires: ["fs.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readFileMany(
    file: FileHandle,
    buffers: &[[uint8]],
    options: FileReadOptions,
): Result<uint64, PlatformError>;

/// Write bytes to an open file from multiple input buffers.
@binding("destack.fs.file.writeMany", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeFileMany(
    file: FileHandle,
    buffers: &readonly [[uint8]],
    options: FileWriteOptions,
): Result<uint64, PlatformError>;

/// Reposition an open file and return the new offset.
@binding("destack.fs.file.seek", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function seekFile(
    file: FileHandle,
    offset: FileOffset,
    origin: FileSeekOrigin,
): Result<FileOffset, PlatformError>;

/// Truncate an open file to the requested size.
@binding("destack.fs.file.truncate", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function truncateFile(file: FileHandle, size: FileSize): Result<void, PlatformError>;

/// Synchronize file contents and metadata with storage.
@binding("destack.fs.file.sync", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncFile(file: FileHandle): Result<void, PlatformError>;

/// Synchronize file contents with storage.
@binding("destack.fs.file.syncData", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncFileData(file: FileHandle): Result<void, PlatformError>;

/// Synchronize one byte range with storage.
@binding("destack.fs.file.syncRange", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncFileRange(
    file: FileHandle,
    range: FileRange,
    flags: FileSyncFlags,
): Result<void, PlatformError>;

/// Copy bytes between two open files.
@binding("destack.fs.file.copyRange", {
    effect: "external",
    requires: ["fs.read", "fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function copyFileRange(
    source: FileHandle,
    sourceRange: FileRange,
    target: FileHandle,
    targetOffset: FileOffset,
): Result<uint64, PlatformError>;

/// Clone bytes between two open files.
@binding("destack.fs.file.cloneRange", {
    effect: "external",
    requires: ["fs.read", "fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cloneFileRange(
    source: FileHandle,
    sourceRange: FileRange,
    target: FileHandle,
    targetOffset: FileOffset,
): Result<void, PlatformError>;

/// Allocate, release, or reshape storage for one byte range.
@binding("destack.fs.file.allocate", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function allocateFile(
    file: FileHandle,
    range: FileRange,
    flags: FileAllocateFlags,
): Result<void, PlatformError>;

/// Provide access pattern advice for one byte range.
@binding("destack.fs.file.advise", {
    effect: "external",
    requires: ["fs.metadata"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function adviseFile(
    file: FileHandle,
    range: FileRange,
    advice: FileAdvice,
): Result<void, PlatformError>;

/// Apply or release one advisory file lock.
@binding("destack.fs.file.lock", {
    effect: "external",
    requires: ["fs.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function lockFile(
    file: FileHandle,
    options: FileLockOptions,
): Result<void, PlatformError>;

/// Duplicate an open file handle into a new owned resource.
@binding("destack.fs.file.duplicate", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function duplicateFile(file: FileHandle): Result<FileHandle, PlatformError>;
