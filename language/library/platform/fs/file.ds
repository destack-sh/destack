    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function writev(
    handle: FileHandle,
    buffers: Slice<Slice<uint8>>,
): Result<uint64, PlatformError>;

/// Read into multiple buffers at the given file offset.
