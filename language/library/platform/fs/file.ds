    effect: "external",
    replay: "recordable",
    capabilities: ["fs.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function readv(
    handle: FileHandle,
    buffers: Slice<Slice<uint8>>,
): Result<uint64, PlatformError>;

/// Write from multiple buffers.
///
/// Write bytes from a gather buffer list at the current file position.
/// Buffer consumption order follows host iovec semantics and advances the file position by bytes written.
///
/// # Platform
