import type { PlatformError } from "../error/index.ds";
import { FileHandle } from "../resource/index.ds";
import { Entry } from "./entry.ds";
import { FileOffset, FileRange, FileSize } from "./range.ds";
import { FileMode } from "./status.ds";

/// File open flags.
export newtype OpenFlags = uint32;

/// Open for reads.
export const OPEN_READ: OpenFlags = OpenFlags(0x0001);

/// Open for writes.
export const OPEN_WRITE: OpenFlags = OpenFlags(0x0002);

/// Create the entry when it does not exist.
export const OPEN_CREATE: OpenFlags = OpenFlags(0x0004);

/// Fail when the created entry already exists.
export const OPEN_EXCLUSIVE: OpenFlags = OpenFlags(0x0008);

/// Truncate the entry after opening.
export const OPEN_TRUNCATE: OpenFlags = OpenFlags(0x0010);

/// Append writes to the end of the file.
export const OPEN_APPEND: OpenFlags = OpenFlags(0x0020);

/// Require the entry to be a directory.
export const OPEN_DIRECTORY: OpenFlags = OpenFlags(0x0040);

/// Do not follow the final symlink component.
export const OPEN_NOFOLLOW: OpenFlags = OpenFlags(0x0080);

/// Request nonblocking file behavior.
export const OPEN_NONBLOCK: OpenFlags = OpenFlags(0x0100);

/// Request uncached direct I/O.
export const OPEN_DIRECT: OpenFlags = OpenFlags(0x0200);

/// Synchronize written data before writes complete.
export const OPEN_DATA_SYNC: OpenFlags = OpenFlags(0x0400);

/// Synchronize written data and metadata before writes complete.
export const OPEN_SYNC: OpenFlags = OpenFlags(0x0800);

/// Resolve flags for path opening.
export newtype ResolveFlags = uint64;

/// Reject traversal that crosses into a different mount.
export const RESOLVE_NO_XDEV: ResolveFlags = ResolveFlags(0x01);

/// Reject magic link traversal.
export const RESOLVE_NO_MAGIC_LINKS: ResolveFlags = ResolveFlags(0x02);

/// Reject symlink traversal.
export const RESOLVE_NO_SYMLINKS: ResolveFlags = ResolveFlags(0x04);

/// Require the result to stay beneath the starting directory.
export const RESOLVE_BENEATH: ResolveFlags = ResolveFlags(0x08);

/// Treat the starting directory as the logical root.
export const RESOLVE_IN_ROOT: ResolveFlags = ResolveFlags(0x10);

/// Use only already cached resolution state.
export const RESOLVE_CACHED: ResolveFlags = ResolveFlags(0x20);

/// File open options.
export struct OpenOptions {
    /// Open behavior flags.
    flags: OpenFlags;
    /// File mode used when creating an entry.
    mode: FileMode;
    /// Path resolution flags.
    resolve: ResolveFlags;
}

/// File read flags.
export newtype ReadFlags = uint32;

/// Prefer high priority polling I/O when the host supports it.
export const READ_HIGH_PRIORITY: ReadFlags = ReadFlags(0x1);

/// Request nonblocking cache miss behavior when supported.
export const READ_NOWAIT: ReadFlags = ReadFlags(0x8);

/// File write flags.
export newtype WriteFlags = uint32;

/// Apply data-only sync mode to the write.
export const WRITE_DATA_SYNC: WriteFlags = WriteFlags(0x2);

/// Apply full sync mode to the write.
export const WRITE_SYNC: WriteFlags = WriteFlags(0x4);

/// Request nonblocking cache miss behavior when supported.
export const WRITE_NOWAIT: WriteFlags = WriteFlags(0x8);

/// Force append mode for the write.
export const WRITE_APPEND: WriteFlags = WriteFlags(0x10);

/// File read options.
export struct ReadOptions {
    /// Explicit byte offset, or current descriptor position when absent.
    offset?: FileOffset;
    /// Read behavior flags.
    flags: ReadFlags;
}

/// File write options.
export struct WriteOptions {
    /// Explicit byte offset, or current descriptor position when absent.
    offset?: FileOffset;
    /// Write behavior flags.
    flags: WriteFlags;
}

/// Seek origin.
export enum SeekOrigin {
    /// Seek from the start of the file.
    Start = 0,
    /// Seek from the current position.
    Current = 1,
    /// Seek from the end of the file.
    End = 2,
}

/// Sync range flags.
export newtype SyncFlags = uint32;

/// Wait for earlier writeback in the requested range.
export const SYNC_WAIT_BEFORE: SyncFlags = SyncFlags(0x1);

/// Start writeback for the requested range.
export const SYNC_WRITE: SyncFlags = SyncFlags(0x2);

/// Wait for writeback completion in the requested range.
export const SYNC_WAIT_AFTER: SyncFlags = SyncFlags(0x4);

/// File allocation flags.
export newtype AllocateFlags = uint32;

/// Allocate blocks without extending apparent file size.
export const ALLOCATE_KEEP_SIZE: AllocateFlags = AllocateFlags(0x01);

/// Deallocate blocks in the requested range.
export const ALLOCATE_PUNCH_HOLE: AllocateFlags = AllocateFlags(0x02);

/// Do not hide stale data when the host supports that mode.
export const ALLOCATE_NO_HIDE_STALE: AllocateFlags = AllocateFlags(0x04);

/// Remove the requested range and collapse later data downward.
export const ALLOCATE_COLLAPSE_RANGE: AllocateFlags = AllocateFlags(0x08);

/// Convert the requested range into explicit zeroed blocks.
export const ALLOCATE_ZERO_RANGE: AllocateFlags = AllocateFlags(0x10);

/// Insert a hole and push later data upward.
export const ALLOCATE_INSERT_RANGE: AllocateFlags = AllocateFlags(0x20);

/// Break shared extents before future writes.
export const ALLOCATE_UNSHARE_RANGE: AllocateFlags = AllocateFlags(0x40);

/// File access pattern advice.
export enum FileAdvice {
    /// No special behavior.
    Normal = 0,
    /// File will be accessed sequentially.
    Sequential = 1,
    /// File will be accessed randomly.
    Random = 2,
    /// File data will be needed soon.
    WillNeed = 3,
    /// File data will not be needed soon.
    DontNeed = 4,
    /// File data will be used once.
    NoReuse = 5,
}

/// File lock mode.
export enum LockMode {
    /// Acquire a shared lock.
    Shared = 1,
    /// Acquire an exclusive lock.
    Exclusive = 2,
    /// Release an existing lock.
    Unlock = 3,
}

/// File lock options.
export struct LockOptions {
    /// Lock mode.
    mode: LockMode;
    /// Byte range covered by the lock.
    range: FileRange;
    /// Whether the operation should fail instead of blocking.
    isNonblocking: boolean;
}

/// Open one filesystem entry as a file handle.
@binding("destack.fs.file.open", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function open(
    entry: &readonly Entry,
    options: OpenOptions,
): Result<FileHandle, PlatformError>;

/// Read bytes from an open file into an output buffer.
@binding("destack.fs.file.read", {
    effect: "external",
    requires: ["fs.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function read(
    file: FileHandle,
    buffer: &[uint8],
    options: ReadOptions,
): Result<uint64, PlatformError>;

/// Write bytes to an open file from an input buffer.
@binding("destack.fs.file.write", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function write(
    file: FileHandle,
    buffer: &readonly [uint8],
    options: WriteOptions,
): Result<uint64, PlatformError>;

/// Read bytes from an open file into multiple output buffers.
@binding("destack.fs.file.readMany", {
    effect: "external",
    requires: ["fs.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readMany(
    file: FileHandle,
    buffers: &[[uint8]],
    options: ReadOptions,
): Result<uint64, PlatformError>;

/// Write bytes to an open file from multiple input buffers.
@binding("destack.fs.file.writeMany", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeMany(
    file: FileHandle,
    buffers: &readonly [[uint8]],
    options: WriteOptions,
): Result<uint64, PlatformError>;

/// Reposition an open file and return the new offset.
@binding("destack.fs.file.seek", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function seek(
    file: FileHandle,
    offset: FileOffset,
    origin: SeekOrigin,
): Result<FileOffset, PlatformError>;

/// Truncate an open file to the requested size.
@binding("destack.fs.file.truncate", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function truncate(file: FileHandle, size: FileSize): Result<void, PlatformError>;

/// Synchronize file contents and metadata with storage.
@binding("destack.fs.file.sync", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sync(file: FileHandle): Result<void, PlatformError>;

/// Synchronize file contents with storage.
@binding("destack.fs.file.syncData", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncData(file: FileHandle): Result<void, PlatformError>;

/// Synchronize one byte range with storage.
@binding("destack.fs.file.syncRange", {
    effect: "external",
    requires: ["fs.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncRange(
    file: FileHandle,
    range: FileRange,
    flags: SyncFlags,
): Result<void, PlatformError>;

/// Copy bytes between two open files.
@binding("destack.fs.file.copyRange", {
    effect: "external",
    requires: ["fs.read", "fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function copyRange(
    source: FileHandle,
    sourceRange: FileRange,
    target: FileHandle,
    targetOffset: FileOffset,
): Result<uint64, PlatformError>;

/// Clone bytes between two open files.
@binding("destack.fs.file.cloneRange", {
    effect: "external",
    requires: ["fs.read", "fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cloneRange(
    source: FileHandle,
    sourceRange: FileRange,
    target: FileHandle,
    targetOffset: FileOffset,
): Result<void, PlatformError>;

/// Allocate, release, or reshape storage for one byte range.
@binding("destack.fs.file.allocate", {
    effect: "external",
    requires: ["fs.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function allocate(
    file: FileHandle,
    range: FileRange,
    flags: AllocateFlags,
): Result<void, PlatformError>;

/// Provide access pattern advice for one byte range.
@binding("destack.fs.file.advise", {
    effect: "external",
    requires: ["fs.metadata"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function advise(
    file: FileHandle,
    range: FileRange,
    advice: FileAdvice,
): Result<void, PlatformError>;

/// Apply or release one advisory file lock.
@binding("destack.fs.file.lock", {
    effect: "external",
    requires: ["fs.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function lock(
    file: FileHandle,
    options: LockOptions,
): Result<void, PlatformError>;

/// Duplicate an open file handle into a new owned resource.
@binding("destack.fs.file.duplicate", {
    effect: "external",
    requires: ["fs.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function duplicate(file: FileHandle): Result<FileHandle, PlatformError>;
