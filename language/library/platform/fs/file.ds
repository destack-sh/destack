    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function preadv2(
    handle: FileHandle,
    buffers: Slice<Slice<uint8>>,
    offset: FileOffset,
    flags: ReadWriteFlags,
): Result<uint64, PlatformError>;

