    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function truncate(path: OsPath, size: FileOffset): Result<void, PlatformError>;

/// Truncate a file by handle.
