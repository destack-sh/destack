import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import {
    DirectoryHandle,
    FileHandle,
    PipeHandle,
    ResourceId,
    SocketHandle,
} from "../resource/index.ds";
import {
    AllocFlags,
    FdFlags,
    FileAdvice,
    FileLockFlags,
    FileMode,
    FileOffset,
    FileSize,
    OpenResolveFlags,
    OpenFlags,
    ReadWriteFlags,
    SeekWhence,
