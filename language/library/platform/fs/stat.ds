import type { PlatformError } from "../error/index.ds";
import { DirectoryHandle, FileHandle } from "../resource/index.ds";
import { AtFlags, FileMode, FileSize } from "./flags.ds";
import { OsPath } from "./path.ds";

/// statx mask bits.
export newtype StatxMask = uint32;

/// statx flags bits.
export newtype StatxFlags = uint32;

/// Filesystem mount flags returned by statfs.
export newtype StatFsFlags = uint64;

/// File metadata returned by stat calls.
export struct Stat {
    /// Device id.
    dev: uint64;
    /// Inode number.
    ino: uint64;
    /// File mode bits.
    mode: FileMode;
    /// Hard link count.
    nlink: uint32;
    /// User id of owner.
    uid: uint32;
    /// Group id of owner.
    gid: uint32;
    /// Device id for special files.
    rdev: uint64;
    /// File size in bytes.
    size: FileSize;
    /// Block size for filesystem I/O.
    blksize: uint64;
    /// Number of allocated blocks.
    blocks: uint64;
    /// Last access time in nanoseconds.
    atimeNs: uint64;
    /// Last modification time in nanoseconds.
    mtimeNs: uint64;
    /// Last status change time in nanoseconds.
    ctimeNs: uint64;
    /// File creation time in nanoseconds.
    birthtimeNs: uint64;
}

/// Filesystem metadata returned by statfs calls.
export struct StatFs {
    /// Optimal transfer block size.
    bsize: uint64;
    /// Fragment size.
    frsize: uint64;
    /// Total data blocks in filesystem.
    blocks: uint64;
    /// Free blocks in filesystem.
    bfree: uint64;
    /// Free blocks available to unprivileged user.
    bavail: uint64;
    /// Total file nodes in filesystem.
    files: uint64;
    /// Free file nodes in filesystem.
    ffree: uint64;
    /// Filesystem ID.
    fsid: uint64;
    /// Mount flags.
    flags: StatFsFlags;
    /// Maximum filename length.
    namelen: uint64;
}

/// Extended stat metadata returned by statx.
export struct Statx {
    /// Mask of fields populated by the kernel.
    mask: StatxMask;
    /// Block size for filesystem I/O.
    blksize: uint32;
    /// Mount identifier.
    mountId: uint64;
    /// Device major number.
    devMajor: uint32;
    /// Device minor number.
    devMinor: uint32;
    /// Inode number.
    ino: uint64;
    /// File mode bits.
    mode: FileMode;
    /// Hard link count.
    nlink: uint32;
    /// User id of owner.
    uid: uint32;
    /// Group id of owner.
    gid: uint32;
    /// Device major for special files.
    rdevMajor: uint32;
    /// Device minor for special files.
    rdevMinor: uint32;
    /// File size in bytes.
    size: FileSize;
    /// Number of allocated blocks.
    blocks: uint64;
    /// Last access time in nanoseconds.
    atimeNs: uint64;
    /// Creation time in nanoseconds.
    btimeNs: uint64;
    /// Last status change time in nanoseconds.
    ctimeNs: uint64;
    /// Last modification time in nanoseconds.
    mtimeNs: uint64;
}

/// Stat a file.
///
/// Stat a file via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses stat(2) on Unix and GetFileInformationByHandleEx on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.path", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function stat(path: OsPath): Result<Stat, PlatformError>;

/// Stat a file relative to a directory handle.
///
/// Stat a file relative to a directory handle via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses fstatat(2) on Unix and handle-relative stat on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.pathat", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function statat(
    dir: DirectoryHandle,
    path: OsPath,
    flags: AtFlags,
): Result<Stat, PlatformError>;

/// Stat a file by handle.
///
/// Stat a file by handle via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses fstat(2) on Unix and GetFileInformationByHandleEx on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.fstat", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function fstat(handle: FileHandle): Result<Stat, PlatformError>;

/// Stat a file without following symlinks.
///
/// Stat a file without following symlinks via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses lstat(2) on Unix and reparse-point aware metadata query on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.lstat", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function lstat(path: OsPath): Result<Stat, PlatformError>;

/// Stat a filesystem.
///
/// Stat a filesystem via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses statfs/statvfs on Unix and GetDiskFreeSpaceExW/GetVolumeInformationW on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.pathfs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function statfs(path: OsPath): Result<StatFs, PlatformError>;

/// Stat a filesystem by handle.
///
/// Stat a filesystem by handle via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses fstatfs/statvfs by handle on Unix and volume information by handle on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.fstatfs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function fstatfs(handle: FileHandle): Result<StatFs, PlatformError>;

/// Stat a path with statx semantics.
///
/// Stat a path with statx semantics via host kernel APIs.
/// Paths are forwarded from `OsPath` without runtime normalization or canonicalization, and permission checks follow host filesystem rules.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
/// Uses statx(2) on linux and runtime fallback on other targets.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `fs.metadata`.
///
/// # Replay
/// External, recordable.
@binding("destack.fs.stat.pathx", {
    effect: "external",
    replay: "recordable",
    capabilities: ["fs.metadata"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function statx(
    dir: DirectoryHandle,
    path: OsPath,
    flags: StatxFlags,
    mask: StatxMask,
): Result<Statx, PlatformError>;

/// Request basic file stats.
export const STATX_BASIC_STATS: StatxMask = StatxMask(0x07ff);
/// Request file birth time.
export const STATX_BTIME: StatxMask = StatxMask(0x0800);
/// Request all available fields.
export const STATX_ALL: StatxMask = StatxMask(0x0fff);
/// Stat without forcing sync.
export const STATX_DONT_SYNC: StatxFlags = StatxFlags(0x4000);
/// Force attribute sync from server.
export const STATX_FORCE_SYNC: StatxFlags = StatxFlags(0x2000);
/// Allow empty path for statx.
export const STATX_EMPTY_PATH: StatxFlags = StatxFlags(0x10);
/// Do not follow symlinks for statx.
export const STATX_NOFOLLOW: StatxFlags = StatxFlags(0x1);
