/// Error code returned by platform bindings.
export enum PlatformErrorCode {
    /// Unclassified invalid argument.
    InvalidArgument = 1000,
    /// Invalid argument type.
    InvalidArgumentType = 1001,
    /// Invalid argument value.
    InvalidArgumentValue = 1002,
    /// Null pointer passed across the platform boundary.
    NullPointer = 1100,
    /// Feature is not supported.
    NotSupported = 1200,

    /// Generic I/O error.
    Io = 2000,
    /// I/O read failed.
    IoReadFailed = 2100,
    /// I/O write failed.
    IoWriteFailed = 2101,
    /// File or resource not found.
    IoNotFound = 2102,
    /// Permission denied.
    IoPermissionDenied = 2103,
    /// File or resource already exists.
    IoAlreadyExists = 2104,
    /// Path component is not a directory.
    IoNotDirectory = 2105,
    /// Path points to a directory where a file is required.
    IoIsDirectory = 2106,
    /// Directory is not empty.
    IoNotEmpty = 2107,
    /// Read-only file system.
    IoReadOnly = 2108,
    /// Path name is too long.
    IoNameTooLong = 2109,
    /// File is too large.
    IoFileTooLarge = 2110,
    /// Too many open files.
    IoTooManyOpenFiles = 2111,
    /// System file table is full.
    IoFileTableOverflow = 2112,
    /// Invalid data or format.
    IoInvalidData = 2113,
    /// Cross-device link not permitted.
    IoCrossDevice = 2114,
    /// Broken pipe.
    IoBrokenPipe = 2115,
    /// I/O timed out.
    IoTimedOut = 2116,
    /// I/O interrupted.
    IoInterrupted = 2117,
    /// Resource is busy.
    IoBusy = 2118,
    /// Operation would block.
    IoWouldBlock = 2119,

    /// Generic network error.
    Net = 3000,
    /// Connection refused.
    NetConnectionRefused = 3100,
    /// Connection timed out.
    NetTimedOut = 3101,
    /// Connection reset.
    NetConnectionReset = 3102,
    /// Address already in use.
    NetAddressInUse = 3103,
    /// Address not available.
    NetAddressNotAvailable = 3104,
    /// Network unreachable.
    NetNetworkUnreachable = 3105,
    /// Host unreachable.
    NetHostUnreachable = 3106,
    /// Connection aborted.
    NetConnectionAborted = 3107,
    /// Broken pipe.
    NetBrokenPipe = 3108,
    /// DNS lookup failed.
    NetDnsFailed = 3109,
    /// Socket is not connected.
    NetNotConnected = 3110,
    /// Socket is already connected.
    NetAlreadyConnected = 3111,
    /// Message is too large for target transport.
    NetMessageTooLarge = 3112,
    /// Handle is not a socket.
    NetNotSocket = 3113,
    /// Protocol operation failed.
    NetProtocolError = 3114,
    /// Operation is in progress.
    NetInProgress = 3115,
    /// Socket is shutdown for this operation.
    NetShutdown = 3116,
    /// Address family is not supported.
    NetUnsupportedFamily = 3117,
    /// Protocol is not supported.
    NetUnsupportedProtocol = 3118,
    /// No buffer space available.
    NetNoBufferSpace = 3119,

    /// Generic process error.
    Process = 4000,
    /// Process spawn failed.
    ProcessSpawnFailed = 4100,
    /// Process not found.
    ProcessNotFound = 4101,
    /// Process permission denied.
    ProcessPermissionDenied = 4102,
    /// Process exec failed.
    ProcessExecFailed = 4103,
    /// Process wait failed.
    ProcessWaitFailed = 4104,
    /// Process terminated by signal.
    ProcessSignaled = 4105,
    /// Process operation timed out.
    ProcessTimedOut = 4106,

    /// Randomness error.
    Random = 5000,
    /// Randomness unavailable.
    RandomUnavailable = 5100,

    /// Time source error.
    Time = 6000,
    /// Time source unavailable.
    TimeUnavailable = 6100,

    /// Generic IPC error.
    Ipc = 7000,
    /// IPC payload too large.
    IpcMessageTooLarge = 7100,
    /// IPC operation timed out.
    IpcTimedOut = 7101,
    /// IPC endpoint is closed.
    IpcClosed = 7102,
    /// IPC operation would block.
    IpcWouldBlock = 7103,
    /// IPC resource already exists.
    IpcAlreadyExists = 7104,

    /// Generic security error.
    Security = 7200,
    /// Security policy denied operation.
    SecurityDenied = 7210,
    /// Security policy violation.
    SecurityViolation = 7211,

    /// Generic FFI error.
    Ffi = 7400,
    /// FFI library load failed.
    FfiLibraryLoadFailed = 7410,
    /// FFI symbol not found.
    FfiSymbolNotFound = 7411,
    /// FFI call failed.
    FfiCallFailed = 7412,

    /// Generic device error.
    Device = 7500,
    /// Device unavailable.
    DeviceUnavailable = 7510,

    /// Generic display error.
    Display = 7600,
    /// Display unavailable.
    DisplayUnavailable = 7610,

    /// Generic audio error.
    Audio = 7700,
    /// Audio device unavailable.
    AudioUnavailable = 7710,

    /// Generic GPU error.
    Gpu = 7800,
    /// GPU device unavailable.
    GpuUnavailable = 7810,
    /// GPU out of memory.
    GpuOutOfMemory = 7811,
    /// GPU device lost.
    GpuDeviceLost = 7812,

    /// Generic resource-table error.
    Resource = 7900,
    /// Resource not found.
    ResourceNotFound = 7910,
    /// Resource already closed.
    ResourceClosed = 7911,
    /// Resource busy.
    ResourceBusy = 7912,
    /// Resource type mismatch.
    ResourceTypeMismatch = 7913,

    /// Generic I/O driver error.
    IoDriver = 8000,
    /// I/O submission failed.
    IoSubmissionFailed = 8010,
    /// I/O completion failed.
    IoCompletionFailed = 8011,
    /// I/O operation canceled.
    IoCancelled = 8012,

    /// Generic platform error.
    Generic = 9000,
}

/// POSIX errno source payload.
export struct PlatformSystemSourceErrno {
    /// Discriminator for this system-source variant.
    kind: "errno";
    /// Numeric errno value.
    value: int32;
    /// Optional symbolic errno name.
    name?: string;
}

/// Winsock source payload.
export struct PlatformSystemSourceWinsock {
    /// Discriminator for this system-source variant.
    kind: "winsock";
    /// Numeric WSA error value.
    value: int32;
    /// Optional symbolic WSA name.
    name?: string;
}

/// HRESULT source payload.
export struct PlatformSystemSourceHResult {
    /// Discriminator for this system-source variant.
    kind: "hresult";
    /// Numeric HRESULT value.
    value: int32;
    /// Optional symbolic HRESULT name.
    name?: string;
}

/// EAI source payload.
export struct PlatformSystemSourceEai {
    /// Discriminator for this system-source variant.
    kind: "eai";
    /// Numeric getaddrinfo/getnameinfo error value.
    value: int32;
    /// Optional symbolic EAI name.
    name?: string;
}

/// Signal source payload.
export struct PlatformSystemSourceSignal {
    /// Discriminator for this system-source variant.
    kind: "signal";
    /// Numeric signal value.
    value: int32;
    /// Optional symbolic signal name.
    name?: string;
}

/// Other source payload.
export struct PlatformSystemSourceOther {
    /// Discriminator for this system-source variant.
    kind: "other";
    /// Numeric source value.
    value: int32;
    /// Optional symbolic source name.
    name?: string;
}

/// Host-level system source metadata.
export newtype PlatformSystemSource =
    | PlatformSystemSourceErrno
    | PlatformSystemSourceWinsock
    | PlatformSystemSourceHResult
    | PlatformSystemSourceEai
    | PlatformSystemSourceSignal
    | PlatformSystemSourceOther;

/// Byte-path payload attached to an error context.
export struct PlatformPathPayloadBytes {
    /// Discriminator for this path-payload variant.
    kind: "bytes";
    /// Raw path bytes.
    bytes: uint8[];
}

/// UTF-16 path payload attached to an error context.
export struct PlatformPathPayloadUtf16 {
    /// Discriminator for this path-payload variant.
    kind: "utf16";
    /// UTF-16 path code units.
    utf16: uint16[];
}

/// Path payload attached to an error context.
export newtype PlatformPathPayload = PlatformPathPayloadBytes | PlatformPathPayloadUtf16;

/// Generic platform-error context payload.
export struct PlatformErrorContextGeneric {
    /// Discriminator for this error-context variant.
    kind: "generic";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional argument name.
    argument?: string;
    /// Optional pointer label.
    pointer?: string;
    /// Optional feature identifier.
    feature?: string;
}

/// I/O platform-error context payload.
export struct PlatformErrorContextIo {
    /// Discriminator for this error-context variant.
    kind: "io";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional primary path payload.
    path?: PlatformPathPayload;
    /// Optional destination path payload.
    dest?: PlatformPathPayload;
    /// Optional primary path text fallback.
    pathText?: string;
    /// Optional destination path text fallback.
    destText?: string;
    /// Optional file descriptor.
    fd?: int32;
}

/// Network platform-error context payload.
export struct PlatformErrorContextNet {
    /// Discriminator for this error-context variant.
    kind: "net";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional network address text.
    address?: string;
    /// Optional network port.
    port?: uint16;
    /// Optional host name.
    hostname?: string;
}

/// Process platform-error context payload.
export struct PlatformErrorContextProcess {
    /// Discriminator for this error-context variant.
    kind: "process";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional process id.
    pid?: uint64;
    /// Optional signal name.
    signal?: string;
    /// Optional exit code.
    exitCode?: int32;
}

/// Timer platform-error context payload.
export struct PlatformErrorContextTimer {
    /// Discriminator for this error-context variant.
    kind: "timer";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional timer id.
    timerId?: uint64;
    /// Optional timer deadline.
    deadlineNs?: uint64;
}

/// Resource platform-error context payload.
export struct PlatformErrorContextResource {
    /// Discriminator for this error-context variant.
    kind: "resource";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional resource id.
    resourceId?: uint64;
    /// Optional resource kind.
    resourceKind?: string;
}

/// Security platform-error context payload.
export struct PlatformErrorContextSecurity {
    /// Discriminator for this error-context variant.
    kind: "security";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional action name.
    action?: string;
    /// Optional policy name.
    policy?: string;
}

/// FFI platform-error context payload.
export struct PlatformErrorContextFfi {
    /// Discriminator for this error-context variant.
    kind: "ffi";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional FFI library name.
    library?: string;
    /// Optional FFI symbol name.
    symbol?: string;
}

/// IPC platform-error context payload.
export struct PlatformErrorContextIpc {
    /// Discriminator for this error-context variant.
    kind: "ipc";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional primary path payload.
    path?: PlatformPathPayload;
    /// Optional primary path text fallback.
    pathText?: string;
    /// Optional file descriptor.
    fd?: int32;
}

/// Device platform-error context payload.
export struct PlatformErrorContextDevice {
    /// Discriminator for this error-context variant.
    kind: "device";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional primary path payload.
    path?: PlatformPathPayload;
    /// Optional primary path text fallback.
    pathText?: string;
    /// Optional feature identifier.
    feature?: string;
}

/// Display platform-error context payload.
export struct PlatformErrorContextDisplay {
    /// Discriminator for this error-context variant.
    kind: "display";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional feature identifier.
    feature?: string;
}

/// Audio platform-error context payload.
export struct PlatformErrorContextAudio {
    /// Discriminator for this error-context variant.
    kind: "audio";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional feature identifier.
    feature?: string;
}

/// GPU platform-error context payload.
export struct PlatformErrorContextGpu {
    /// Discriminator for this error-context variant.
    kind: "gpu";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional feature identifier.
    feature?: string;
}

/// I/O-driver platform-error context payload.
export struct PlatformErrorContextIoDriver {
    /// Discriminator for this error-context variant.
    kind: "ioDriver";
    /// Optional syscall or host API name.
    syscall?: string;
    /// Optional file descriptor.
    fd?: int32;
    /// Optional feature identifier.
    feature?: string;
}

/// Typed context for platform error metadata.
export newtype PlatformErrorContext =
    | PlatformErrorContextGeneric
    | PlatformErrorContextIo
    | PlatformErrorContextNet
    | PlatformErrorContextProcess
    | PlatformErrorContextTimer
    | PlatformErrorContextResource
    | PlatformErrorContextSecurity
    | PlatformErrorContextFfi
    | PlatformErrorContextIpc
    | PlatformErrorContextDevice
    | PlatformErrorContextDisplay
    | PlatformErrorContextAudio
    | PlatformErrorContextGpu
    | PlatformErrorContextIoDriver;

/// Error returned by platform bindings.
export newtype PlatformError = {
    code: PlatformErrorCode;
    op?: string;
    source?: PlatformSystemSource;
    context?: PlatformErrorContext;
    message?: string;
};

/// Error bindings for runtime error propagation.
@binding("destack.error.error.takePlatformError", {
    effect: "deterministic",
    requires: ["runtime.diagnostic.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function takePlatformError(errorId: uint64): Result<PlatformError, PlatformError>;
