import { PlatformError } from "destack:platform/error";
import { TimerFdHandle } from "destack:platform/resource";

/// Linux timerfd clock.
export enum TimerFdClock {
    /// Use the realtime clock.
    Realtime = 1,
    /// Use the monotonic clock.
    Monotonic = 2,
    /// Use the boottime clock.
    Boottime = 3,
}

/// Linux timerfd open flags.
export newtype TimerFdFlags = uint32;

/// Linux timerfd schedule flags.
export newtype TimerFdScheduleFlags = uint32;

/// Linux timerfd schedule.
export struct TimerFdSchedule {
    /// Initial expiration offset or absolute deadline.
    initialNs: uint64;
    /// Repeating interval, zero for a one-shot timer.
    intervalNs: uint64;
}

/// Open a Linux timerfd descriptor.
@binding("destack.time.timerfd.open", {
    effect: "external",
    requires: ["host.time.timerfd"],
    platforms: ["linux"],
    simulation: true,
})
export declare function openTimerFd(
    clock: TimerFdClock,
    flags: TimerFdFlags,
): Result<TimerFdHandle, PlatformError>;

/// Close a Linux timerfd descriptor.
@binding("destack.time.timerfd.close", {
    effect: "external",
    requires: ["host.time.timerfd"],
    platforms: ["linux"],
    simulation: true,
})
export declare function closeTimerFd(timer: TimerFdHandle): Result<void, PlatformError>;

/// Update a Linux timerfd schedule.
@binding("destack.time.timerfd.set", {
    effect: "external",
    requires: ["host.time.timerfd"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setTimerFd(
    timer: TimerFdHandle,
    schedule: TimerFdSchedule,
    flags: TimerFdScheduleFlags,
): Result<void, PlatformError>;

/// Read a Linux timerfd schedule.
@binding("destack.time.timerfd.get", {
    effect: "external",
    requires: ["host.time.timerfd"],
    platforms: ["linux"],
    simulation: true,
})
export declare function getTimerFd(timer: TimerFdHandle): Result<TimerFdSchedule, PlatformError>;

/// Read a Linux timerfd expiration counter.
@binding("destack.time.timerfd.read", {
    effect: "external",
    requires: ["host.time.timerfd"],
    platforms: ["linux"],
    simulation: true,
})
export declare function readTimerFd(timer: TimerFdHandle): Result<uint64, PlatformError>;
