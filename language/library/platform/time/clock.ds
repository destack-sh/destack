import type { PlatformError } from "../error/index.ds";

/// Runtime clock selector.
export enum ClockId {
    /// Wall-clock time.
    Wall = 1,
    /// Monotonic clock time.
    Monotonic = 2,
    /// Process CPU time.
    ProcessCpu = 3,
    /// Thread CPU time.
    ThreadCpu = 4,
    /// Boot-time monotonic clock when available.
    Boot = 5,
    /// Raw monotonic clock when available.
    MonotonicRaw = 6,
}

/// Host clock source kind.
export enum ClockSource {
    /// POSIX-like realtime source.
    Realtime = 1,
    /// POSIX-like monotonic source.
    Monotonic = 2,
    /// High-resolution performance counter source.
    PerformanceCounter = 3,
    /// Runtime virtualized source.
    Virtual = 4,
}

/// Runtime clock metadata.
export struct ClockMetadata {
    /// Clock identifier.
    id: ClockId;
    /// Host clock source kind.
    source: ClockSource;
    /// Reported resolution in nanoseconds.
    resolutionNs: uint64;
    /// Whether the clock is monotonic.
    isMonotonic: boolean;
}

/// Return wall clock time in nanoseconds since the runtime epoch.
///
/// Read wall-clock time with runtime policy controls for determinism and replay.
/// Epoch choice and leap-second behavior follow the active runtime time policy.
///
/// # Platform
/// Runtime-integrated clock available on Unix and Windows targets.
/// Uses clock_gettime(CLOCK_REALTIME) on Unix and GetSystemTimePreciseAsFileTime on Windows.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.wall.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.wallNs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.wall.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function wallNs(): Result<uint64, PlatformError>;

/// Return monotonic time in nanoseconds.
///
/// Read a monotonic clock source that does not move backwards.
/// Resolution and origin are platform-specific.
///
/// # Platform
/// Runtime-integrated clock available on Unix and Windows targets.
/// Uses Mach absolute time on Apple, CLOCK_MONOTONIC on other Unix targets, and QueryPerformanceCounter on Windows.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.monotonic.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.monoNs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.monotonic.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function monoNs(): Result<uint64, PlatformError>;

/// Return process CPU time in nanoseconds.
///
/// Read CPU time consumed by the current process.
/// Time excludes wall-clock idle periods and depends on host accounting granularity.
///
/// # Platform
/// Unix and Windows.
/// Uses CLOCK_PROCESS_CPUTIME_ID or getrusage on Unix and GetProcessTimes on Windows.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.monotonic.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.processCpuNs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.monotonic.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function processCpuNs(): Result<uint64, PlatformError>;

/// Return current thread CPU time in nanoseconds.
///
/// Read CPU time consumed by the current thread.
/// Time excludes wall-clock idle periods and depends on host accounting granularity.
///
/// # Platform
/// Unix and Windows.
/// Uses CLOCK_THREAD_CPUTIME_ID or thread clocks on Unix and GetThreadTimes on Windows.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.monotonic.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.threadCpuNs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.monotonic.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function threadCpuNs(): Result<uint64, PlatformError>;

/// Read one selected clock in nanoseconds.
///
/// Read one clock value by explicit clock identifier.
/// Clock identifier support varies by host and runtime configuration.
///
/// # Platform
/// Runtime-integrated clock available on Unix and Windows targets.
/// Uses host clock APIs selected by clock identifier and runtime policy.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.monotonic.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.nowNs", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.monotonic.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function nowNs(clock: ClockId): Result<uint64, PlatformError>;

/// Query one selected clock metadata.
///
/// Return metadata for one clock identifier, including source and resolution.
/// Metadata is normalized by runtime policy across host operating systems.
///
/// # Platform
/// Runtime-integrated clock available on Unix and Windows targets.
/// Uses runtime clock registry metadata and host clock probes.
///
/// # Errors
/// Returns timeUnavailable, ioInterrupted, invalidArgument, notSupported.
///
/// # Security
/// Requires `time.monotonic.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.time.clock.metadata", {
    effect: "external",
    replay: "recordable",
    capabilities: ["time.monotonic.read"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function clockMetadata(clock: ClockId): Result<ClockMetadata, PlatformError>;
