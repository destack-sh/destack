import { PlatformError } from "destack:platform/error";

/// Sleep clock domain.
export enum SleepClock {
    /// Sleep against wall-clock time.
    Wall = 1,
    /// Sleep against monotonic time.
    Monotonic = 2,
}

/// Sleep for at least the given duration in nanoseconds.
@binding("destack.time.sleep.ns", {
    effect: "external",
    requires: ["host.time.wall.sleep"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sleepNs(duration: uint64): Result<void, PlatformError>;

/// Sleep until the given wall-clock deadline in nanoseconds.
@binding("destack.time.sleep.untilNs", {
    effect: "external",
    requires: ["host.time.wall.sleep"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sleepUntilNs(deadline: uint64): Result<void, PlatformError>;

/// Sleep for at least the given duration on one clock domain.
@binding("destack.time.sleep.onNs", {
    effect: "external",
    requires: ["host.time.wall.sleep"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sleepOnNs(duration: uint64, clock: SleepClock): Result<void, PlatformError>;

/// Sleep until one deadline on one clock domain.
@binding("destack.time.sleep.untilOnNs", {
    effect: "external",
    requires: ["host.time.wall.sleep"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sleepUntilOnNs(
    deadline: uint64,
    clock: SleepClock,
): Result<void, PlatformError>;
