import { TimerHandle } from "../resource/index.ds";
import type { PlatformError } from "../error/index.ds";

/// Flags for timer scheduling behavior.
export newtype TimerFlags = uint32;

/// Timer clock domain selector.
export enum TimerClock {
    /// Wall-clock timer domain.
    Wall = 1,
    /// Monotonic timer domain.
    Monotonic = 2,
}

/// Timer scheduling options.
export struct TimerOptions {
    /// Clock domain used for delay and deadline interpretation.
    clock: TimerClock;
    /// Timer behavior flags.
    flags: TimerFlags;
}

/// Schedule a one-shot timer.
@binding("destack.time.timer.once", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerOnce(
    delayNs: uint64,
    options: TimerOptions,
): Result<TimerHandle, PlatformError>;

/// Schedule a repeating timer.
@binding("destack.time.timer.interval", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerInterval(
    periodNs: uint64,
    options: TimerOptions,
): Result<TimerHandle, PlatformError>;

/// Schedule a timer for an absolute deadline.
@binding("destack.time.timer.at", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerAt(
    deadlineNs: uint64,
    options: TimerOptions,
): Result<TimerHandle, PlatformError>;

/// Cancel one scheduled timer.
@binding("destack.time.timer.cancel", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerCancel(handle: TimerHandle): Result<void, PlatformError>;

/// Pause one running timer.
@binding("destack.time.timer.pause", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerPause(handle: TimerHandle): Result<void, PlatformError>;

/// Resume one paused timer.
@binding("destack.time.timer.resume", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerResume(handle: TimerHandle): Result<void, PlatformError>;

/// Return whether one timer is currently active.
@binding("destack.time.timer.isActive", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerIsActive(handle: TimerHandle): Result<boolean, PlatformError>;

/// Return remaining timer delay in nanoseconds.
@binding("destack.time.timer.remainingNs", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerRemainingNs(handle: TimerHandle): Result<uint64, PlatformError>;

/// Reset one timer with a new relative delay.
@binding("destack.time.timer.reset", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerReset(handle: TimerHandle, delayNs: uint64): Result<void, PlatformError>;

/// Update one timer interval period.
@binding("destack.time.timer.updateInterval", {
    effect: "external",
    requires: ["time.timer"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
})
export declare function timerUpdateInterval(
    handle: TimerHandle,
    periodNs: uint64,
): Result<void, PlatformError>;
