export const DISPLAY_BACKEND_CAP_WINDOW_MODAL: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x80000000);
/// Backend action flag bit for aspect-ratio lock control.
export const DISPLAY_BACKEND_CAP_WINDOW_ASPECT_RATIO: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x100000000);
/// Backend action flag bit for file and text drop window events.
export const DISPLAY_BACKEND_CAP_WINDOW_DROP_EVENTS: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x200000000);
/// Backend action flag bit for window chrome-style control.
export const DISPLAY_BACKEND_CAP_WINDOW_CHROME: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x400000000);
/// Backend action flag bit for taskbar and dock visibility control.
export const DISPLAY_BACKEND_CAP_WINDOW_TASKBAR_VISIBILITY: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x800000000);
/// Backend action flag bit for popup window role support.
export const DISPLAY_BACKEND_CAP_WINDOW_ROLE_POPUP: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x1000000000);
/// Backend action flag bit for overlay window role support.
export const DISPLAY_BACKEND_CAP_WINDOW_ROLE_OVERLAY: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x2000000000);
/// Backend action flag bit for explicit window content-rect queries.
export const DISPLAY_BACKEND_CAP_WINDOW_CONTENT_RECT: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x4000000000);
/// Backend action flag bit for explicit framebuffer-size queries.
export const DISPLAY_BACKEND_CAP_WINDOW_FRAMEBUFFER_SIZE: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x8000000000);
/// Backend action flag bit for explicit window render-state reporting.
export const DISPLAY_BACKEND_CAP_WINDOW_RENDER_STATE: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x10000000000);
/// Backend action flag bit for host begin-frame streams.
export const DISPLAY_BACKEND_CAP_BEGIN_FRAME_STREAM: DisplayBackendCapabilityFlags =
