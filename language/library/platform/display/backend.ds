import { Slice } from "destack:collections";
import { BackendSupport } from "destack:platform/core";
import { PlatformError } from "destack:platform/error";

/// Display backend selector.
export enum DisplayBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Wayland compositor backend.
    Wayland = 1,
    /// X11 window-system backend.
    X11 = 2,
    /// Win32 window-system backend.
    Win32 = 3,
    /// AppKit backend.
    AppKit = 4,
    /// UIKit backend.
    UIKit = 5,
    /// Android native-activity backend.
    Android = 6,
    /// Null backend for simulation and tests.
    Null = 255,
}

/// Backend selection policy.
export enum DisplayBackendSelectionPolicy {
    /// Require that the requested backend is used with no fallback.
    Strict = 1,
    /// Allow fallback to a host-default backend when the requested backend is unavailable.
    AllowFallback = 2,
}

/// Display backend action flags.
export newtype DisplayBackendCapabilityFlags = uint64;

/// Display event queue overflow policy.
export enum DisplayEventOverflowPolicy {
    /// Drop the oldest queued event when the queue is full.
    DropOldest = 1,
    /// Drop the newest incoming event when the queue is full.
    DropNewest = 2,
    /// Surface overflow as an explicit error.
    Error = 3,
}

/// Display event queue options.
export struct DisplayEventQueueOptions {
    /// Requested queue capacity, or zero for backend default.
    queueCapacity: uint32;
    /// Queue overflow policy.
    overflowPolicy: DisplayEventOverflowPolicy;
}

/// Display backend descriptor.
export struct DisplayBackendDescriptor {
    /// Backend selector.
    backend: DisplayBackend;
    /// Stable backend name.
    name: string;
    /// Host backend support state for this selector.
    support: BackendSupport;
    /// Priority in default auto-selection order, or zero when auto does not consider this selector.
    priority: uint16;
    /// Backend-level action flags.
    capabilityFlags: DisplayBackendCapabilityFlags;
}

/// Backend action flag bit for window creation and management.
export const DISPLAY_BACKEND_CAP_WINDOW: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x1);
/// Backend action flag bit for point-in-time window state and descriptor reads.
export const DISPLAY_BACKEND_CAP_WINDOW_STATE: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x2);
/// Backend action flag bit for monitor enumeration and mode management.
export const DISPLAY_BACKEND_CAP_MONITOR: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x4);
/// Backend action flag bit for window-event streams.
export const DISPLAY_BACKEND_CAP_WINDOW_EVENTS: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x8);
/// Backend action flag bit for monitor-event streams.
export const DISPLAY_BACKEND_CAP_MONITOR_EVENTS: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x10);
/// Backend action flag bit for monitor mode-setting operations.
export const DISPLAY_BACKEND_CAP_MONITOR_MODE_SET: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x20);
/// Backend action flag bit for monitor color-state queries.
export const DISPLAY_BACKEND_CAP_MONITOR_COLOR_STATE: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x40);
/// Backend action flag bit for monitor HDR-mode control.
export const DISPLAY_BACKEND_CAP_MONITOR_HDR_CONTROL: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x80);
/// Backend action flag bit for monitor gamma-ramp control.
export const DISPLAY_BACKEND_CAP_MONITOR_GAMMA_CONTROL: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x100);
/// Backend action flag bit for exclusive fullscreen.
export const DISPLAY_BACKEND_CAP_EXCLUSIVE_FULLSCREEN: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x200);
/// Backend action flag bit for borderless fullscreen.
export const DISPLAY_BACKEND_CAP_BORDERLESS_FULLSCREEN: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x400);
/// Backend action flag bit for cursor lock mode.
export const DISPLAY_BACKEND_CAP_CURSOR_LOCK: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x800);
/// Backend action flag bit for cursor confine mode.
export const DISPLAY_BACKEND_CAP_CURSOR_CONFINE: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x1000);
/// Backend action flag bit for cursor warping and explicit cursor-position updates.
export const DISPLAY_BACKEND_CAP_CURSOR_WARP: DisplayBackendCapabilityFlags =
