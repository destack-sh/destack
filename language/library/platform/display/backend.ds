/// Backend action flag bit for host begin-frame timing metadata.
export const DISPLAY_BACKEND_CAP_BEGIN_FRAME_TIMING: DisplayBackendCapabilityFlags =
    DisplayBackendCapabilityFlags(0x40000000000);

/// List host display backends.
@binding("destack.display.backend.list", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function backendList(): Result<Slice<DisplayBackendDescriptor>, PlatformError>;
