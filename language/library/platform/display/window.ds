/// Set one window size constraint.
@binding("destack.display.window.limits", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function setWindowSizeLimits(
    window: WindowHandle,
    limits: &readonly WindowSizeLimits,
