import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { MonitorHandle, WindowHandle } from "destack:platform/resource";
import { DisplayBackendKind, DisplayBackendSelection } from "./backend.ds";
import { MonitorMode } from "./monitor.ds";

/// Window visibility state.
export enum WindowVisibility {
    /// Window is hidden.
    Hidden = 1,
    /// Window is visible.
    Visible = 2,
    /// Window is minimized.
    Minimized = 3,
    /// Window is maximized.
    Maximized = 4,
}

/// Cursor interaction mode.
export enum WindowCursorMode {
    /// Cursor is visible and unconstrained.
    Normal = 1,
    /// Cursor is hidden and unconstrained.
    Hidden = 2,
    /// Cursor is locked to one position.
    Locked = 3,
    /// Cursor is confined to one window.
    Confined = 4,
}

/// Standard system cursor icon.
export enum WindowCursorIcon {
    /// Default platform pointer icon.
    Default = 1,
    /// Text insertion icon.
    Text = 2,
    /// Crosshair icon.
    Crosshair = 3,
    /// Hand pointer icon.
    Pointer = 4,
    /// Context help icon.
    Help = 5,
    /// Busy icon.
    Wait = 6,
    /// Move icon.
    Move = 7,
    /// Prohibited operation icon.
    NotAllowed = 8,
    /// Grab icon.
    Grab = 9,
    /// Active grab icon.
    Grabbing = 10,
    /// Horizontal resize icon.
    ResizeHorizontal = 11,
    /// Vertical resize icon.
    ResizeVertical = 12,
    /// Northeast-southwest resize icon.
    ResizeNesw = 13,
    /// Northwest-southeast resize icon.
    ResizeNwse = 14,
    /// Zoom in icon.
    ZoomIn = 15,
    /// Zoom out icon.
    ZoomOut = 16,
}

/// Window resize edge.
export enum WindowResizeEdge {
    /// North edge.
    North = 1,
    /// South edge.
    South = 2,
    /// East edge.
    East = 3,
    /// West edge.
    West = 4,
    /// Northeast corner.
    NorthEast = 5,
    /// Northwest corner.
    NorthWest = 6,
    /// Southeast corner.
    SouthEast = 7,
    /// Southwest corner.
    SouthWest = 8,
}

/// Window attention request level.
export enum WindowAttentionLevel {
    /// Noncritical attention request.
    Informational = 1,
    /// Critical attention request.
    Critical = 2,
}

/// Host theme value.
export enum WindowTheme {
    /// Backend did not report one theme.
    Unknown = 0,
    /// Light theme.
    Light = 1,
    /// Dark theme.
    Dark = 2,
    /// Light high-contrast theme.
    HighContrastLight = 3,
    /// Dark high-contrast theme.
    HighContrastDark = 4,
}

/// Window renderability state.
export enum WindowRenderState {
    /// Backend cannot determine renderability.
    Unknown = 0,
    /// Window can render and present frames.
    Renderable = 1,
    /// Window is hidden.
    Hidden = 2,
    /// Window is occluded.
    Occluded = 3,
    /// Window is suspended by host lifecycle policy.
    Suspended = 4,
    /// Window has zero drawable pixels.
    ZeroSized = 5,
    /// Window lost its drawable host surface.
    SurfaceLost = 6,
}

/// Logical window size in platform points.
export struct WindowSize {
    /// Logical width.
    width: float64;
    /// Logical height.
    height: float64;
}

/// Physical window size in pixels.
export struct WindowPixelSize {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
}

/// Window rectangle in logical platform points.
export struct WindowRect {
    /// Logical x coordinate.
    x: float64;
    /// Logical y coordinate.
    y: float64;
    /// Logical width.
    width: float64;
    /// Logical height.
    height: float64;
}

/// Window position in desktop pixels.
export struct WindowPosition {
    /// Desktop x coordinate.
    x: int32;
    /// Desktop y coordinate.
    y: int32;
}

/// Window-local point in logical platform units.
export struct WindowPoint {
    /// Logical x coordinate.
    x: float64;
    /// Logical y coordinate.
    y: float64;
}

/// Window size constraints.
export struct WindowSizeLimits {
    /// Minimum logical size.
    min?: WindowSize;
    /// Maximum logical size.
    max?: WindowSize;
}

/// Window safe-area insets in logical platform points.
export struct WindowSafeArea {
    /// Top inset.
    top: float64;
    /// Right inset.
    right: float64;
    /// Bottom inset.
    bottom: float64;
    /// Left inset.
    left: float64;
}

/// Window icon image.
export struct WindowIcon {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
    /// RGBA8 pixel bytes.
    rgba: Array<uint8>;
}

/// Windowed display mode.
export struct WindowModeWindowed {
    /// Mode discriminator.
    kind: "windowed";
}

/// Borderless display mode.
export struct WindowModeBorderless {
    /// Mode discriminator.
    kind: "borderless";
    /// Target monitor when explicit.
    monitor?: MonitorHandle;
}

/// Exclusive fullscreen display mode.
export struct WindowModeExclusiveFullscreen {
    /// Mode discriminator.
    kind: "exclusiveFullscreen";
    /// Target monitor.
    monitor: MonitorHandle;
    /// Target monitor mode.
    mode: MonitorMode;
}

/// Window display mode.
export newtype WindowMode =
    | WindowModeWindowed
    | WindowModeBorderless
    | WindowModeExclusiveFullscreen;

/// Window open request.
export struct WindowRequest {
    /// Backend selection.
    backend: DisplayBackendSelection;
    /// Window title.
    title: string;
    /// Initial logical content size.
    size: WindowSize;
    /// Initial desktop position.
    position?: WindowPosition;
    /// Initial display mode.
    mode: WindowMode;
    /// Initial visibility.
    visibility: WindowVisibility;
    /// Whether the host window can be resized.
    isResizable: boolean;
    /// Whether the host should draw standard window decorations.
    isDecorated: boolean;
    /// Whether the window background may be transparent.
    isTransparent: boolean;
    /// Optional window icon images.
    icons: Array<WindowIcon>;
}

/// Window descriptor.
export struct WindowDescriptor {
    /// Host backend.
    backend: DisplayBackendKind;
    /// Window title.
    title: string;
    /// Display mode.
    mode: WindowMode;
    /// Whether the host window can be resized.
    isResizable: boolean;
    /// Whether the host draws standard window decorations.
    isDecorated: boolean;
    /// Whether the window background may be transparent.
    isTransparent: boolean;
}

/// Window state snapshot.
export struct WindowState {
    /// Window visibility.
    visibility: WindowVisibility;
    /// Logical content rectangle.
    content: WindowRect;
    /// Drawable framebuffer size.
    framebuffer: WindowPixelSize;
    /// Desktop position.
    position: WindowPosition;
    /// Scale factor in milli-scale units.
    scaleFactorMilli: uint32;
    /// Renderability state.
    renderState: WindowRenderState;
    /// Current host theme.
    theme: WindowTheme;
    /// Current safe-area insets.
    safeArea?: WindowSafeArea;
    /// Whether the window is focused.
    isFocused: boolean;
}

/// Open one window.
@binding("destack.display.window.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function openWindow(
    request: &readonly WindowRequest,
): Result<WindowHandle, PlatformError>;

/// Close one window.
@binding("destack.display.window.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function closeWindow(window: WindowHandle): Result<void, PlatformError>;

/// Describe one window.
@binding("destack.display.window.describe", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function describeWindow(
    window: WindowHandle,
): Result<WindowDescriptor, PlatformError>;

/// Read one window state snapshot.
@binding("destack.display.window.state", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowState(window: WindowHandle): Result<WindowState, PlatformError>;

