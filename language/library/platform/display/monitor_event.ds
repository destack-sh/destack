import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { DisplayEventHandle } from "../resource/index.ds";
import {
    DisplayBackend,
    DisplayBackendSelectionPolicy,
    DisplayEventQueueOptions,
} from "./backend.ds";
import { DisplayDescriptor, DisplayMetricChangedMask, DisplayMode } from "./monitor.ds";

/// Display added-event payload.
export struct DisplayAddedPayload {
    /// Descriptor after this event.
    descriptor: DisplayDescriptor;
}

/// Display removed-event payload.
export struct DisplayRemovedPayload {
    /// Identifier for the removed display.
    id: string;
    /// Last known descriptor before removal when available.
    descriptor: DisplayDescriptor | void;
}

/// Display primary-change payload.
export struct DisplayPrimaryPayload {
    /// Previous primary display identifier when available.
    previousId: string | void;
    /// Current primary display identifier when available.
    currentId: string | void;
}

/// Display descriptor-change payload.
export struct DisplayDescriptorChangedPayload {
    /// Descriptor before this event when available.
    previous: DisplayDescriptor | void;
    /// Descriptor after this event.
    current: DisplayDescriptor;
    /// Changed descriptor fields as bit flags.
    changedMask: DisplayMetricChangedMask;
}

/// Display mode-change payload.
export struct DisplayModeChangedPayload {
    /// Active mode before this event when available.
    previous: DisplayMode | void;
    /// Active mode after this event.
    current: DisplayMode;
}

/// Shared metadata for all display monitor events.
export struct DisplayMonitorEventMetadata {
    /// Resolved backend that produced this event.
    backend: DisplayBackend;
    /// Display identifier associated with this event.
    displayId: string | void;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic event sequence number.
    sequence: uint64;
    /// Number of events dropped by this stream before this event.
    droppedCount: uint64;
}

/// Display-added event.
export struct DisplayAddedEvent {
    /// Discriminator for this display event variant.
    kind: "added";
    /// Shared event metadata.
    metadata: DisplayMonitorEventMetadata;
    /// Added payload.
    payload: DisplayAddedPayload;
}

/// Display-removed event.
export struct DisplayRemovedEvent {
    /// Discriminator for this display event variant.
    kind: "removed";
    /// Shared event metadata.
    metadata: DisplayMonitorEventMetadata;
    /// Removed payload.
    payload: DisplayRemovedPayload;
}

/// Display-primary-changed event.
export struct DisplayPrimaryChangedEvent {
    /// Discriminator for this display event variant.
    kind: "primaryChanged";
    /// Shared event metadata.
    metadata: DisplayMonitorEventMetadata;
    /// Primary-change payload.
    payload: DisplayPrimaryPayload;
}

/// Display-descriptor-changed event.
export struct DisplayDescriptorChangedEvent {
    /// Discriminator for this display event variant.
    kind: "descriptorChanged";
    /// Shared event metadata.
    metadata: DisplayMonitorEventMetadata;
    /// Descriptor-change payload.
    payload: DisplayDescriptorChangedPayload;
}

/// Display-mode-changed event.
export struct DisplayModeChangedEvent {
    /// Discriminator for this display event variant.
    kind: "modeChanged";
    /// Shared event metadata.
    metadata: DisplayMonitorEventMetadata;
    /// Mode-change payload.
    payload: DisplayModeChangedPayload;
}

/// Monitor event payload.
export newtype DisplayMonitorEvent =
    | DisplayAddedEvent
    | DisplayRemovedEvent
    | DisplayPrimaryChangedEvent
    | DisplayDescriptorChangedEvent
    | DisplayModeChangedEvent;

/// Monitor-event kind filter mask.
export newtype DisplayMonitorEventKindMask = uint32;

/// Event kind bit for `added`.
export const DISPLAY_MONITOR_EVENT_KIND_ADDED: DisplayMonitorEventKindMask =
    DisplayMonitorEventKindMask(0x1);
/// Event kind bit for `removed`.
export const DISPLAY_MONITOR_EVENT_KIND_REMOVED: DisplayMonitorEventKindMask =
    DisplayMonitorEventKindMask(0x2);
/// Event kind bit for `primaryChanged`.
export const DISPLAY_MONITOR_EVENT_KIND_PRIMARY_CHANGED: DisplayMonitorEventKindMask =
    DisplayMonitorEventKindMask(0x4);
/// Event kind bit for `descriptorChanged`.
export const DISPLAY_MONITOR_EVENT_KIND_DESCRIPTOR_CHANGED: DisplayMonitorEventKindMask =
    DisplayMonitorEventKindMask(0x8);
/// Event kind bit for `modeChanged`.
export const DISPLAY_MONITOR_EVENT_KIND_MODE_CHANGED: DisplayMonitorEventKindMask =
    DisplayMonitorEventKindMask(0x10);

/// Monitor-event stream filter options.
export struct DisplayMonitorEventFilter {
    /// Restrict events to one display identifier when set.
    displayId: string | void;
    /// Restrict events to selected kinds when set.
    kindMask: DisplayMonitorEventKindMask | void;
}

/// Monitor event stream open options.
export struct DisplayMonitorEventOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Event queue configuration.
    queue: DisplayEventQueueOptions;
    /// Optional filter for narrowing delivered events.
    filter: DisplayMonitorEventFilter | void;
}

/// Open a global monitor-event stream.
@binding("destack.display.monitor.eventOpen", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventOpen(
    options: DisplayMonitorEventOpenOptions,
): Result<DisplayEventHandle, PlatformError>;

/// Close a global monitor-event stream.
@binding("destack.display.monitor.eventClose", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventClose(handle: DisplayEventHandle): Result<void, PlatformError>;

/// Wait for a monitor event.
@binding("destack.display.monitor.eventRead", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventRead(
    handle: DisplayEventHandle,
    timeoutNs: uint64,
): Result<DisplayMonitorEvent, PlatformError>;

/// Poll a monitor event without blocking.
@binding("destack.display.monitor.eventTryRead", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventTryRead(
    handle: DisplayEventHandle,
): Result<DisplayMonitorEvent, PlatformError>;

/// Wait for a batch of monitor events.
@binding("destack.display.monitor.eventReadBatch", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventReadBatch(
    handle: DisplayEventHandle,
    maxEvents: uint32,
    timeoutNs: uint64,
): Result<Array<DisplayMonitorEvent>, PlatformError>;

/// Poll a batch of monitor events without blocking.
@binding("destack.display.monitor.eventTryReadBatch", {
    effect: "external",
    requires: ["display.read"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function monitorEventTryReadBatch(
    handle: DisplayEventHandle,
    maxEvents: uint32,
): Result<Array<DisplayMonitorEvent>, PlatformError>;
