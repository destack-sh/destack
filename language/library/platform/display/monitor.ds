import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { DisplayHandle } from "../resource/index.ds";
import { DisplayBackend, DisplayBackendSelectionPolicy } from "./backend.ds";

/// Display output orientation.
export enum DisplayOrientation {
    /// Unknown or backend-unspecified orientation.
    Unknown = 0,
    /// Landscape orientation.
    Landscape = 1,
    /// Portrait orientation.
    Portrait = 2,
    /// Inverted landscape orientation.
    LandscapeFlipped = 3,
    /// Inverted portrait orientation.
    PortraitFlipped = 4,
}

/// Display descriptor metric bit flags.
export newtype DisplayMetricChangedMask = uint32;

/// Display-mode pixel-format identifier.
export newtype DisplayPixelFormat = uint32;

/// Display metric changed-mask bit for display-name updates.
export const DISPLAY_METRIC_CHANGED_NAME: DisplayMetricChangedMask = DisplayMetricChangedMask(0x1);
/// Display metric changed-mask bit for primary-display updates.
export const DISPLAY_METRIC_CHANGED_PRIMARY: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x2);
/// Display metric changed-mask bit for desktop-bounds updates.
export const DISPLAY_METRIC_CHANGED_BOUNDS: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x4);
/// Display metric changed-mask bit for work-area updates.
export const DISPLAY_METRIC_CHANGED_WORK_AREA: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x8);
/// Display metric changed-mask bit for scale-factor updates.
export const DISPLAY_METRIC_CHANGED_SCALE_FACTOR: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x10);
/// Display metric changed-mask bit for orientation updates.
export const DISPLAY_METRIC_CHANGED_ORIENTATION: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x20);
/// Display metric changed-mask bit for color-state updates.
export const DISPLAY_METRIC_CHANGED_COLOR_STATE: DisplayMetricChangedMask =
    DisplayMetricChangedMask(0x40);

/// Support status for one capability that may be unknown on some hosts.
export enum DisplaySupportStatus {
    /// Backend cannot determine support status.
    Unknown = 0,
    /// Backend determined this capability is unsupported.
    Unsupported = 1,
    /// Backend determined this capability is supported.
    Supported = 2,
}

/// One display mode descriptor.
export struct DisplayMode {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
    /// Refresh rate in millihertz.
    refreshMilliHz: uint32;
    /// Pixel-format identifier.
    format: DisplayPixelFormat;
    /// Color depth in bits per pixel.
    bitDepth: uint16;
}

/// Display HDR policy mode.
export enum DisplayHdrMode {
    /// Backend does not expose a concrete HDR mode.
    Unknown = 0,
    /// Use host-default HDR policy.
    System = 1,
    /// Force SDR output mode.
    Sdr = 2,
    /// Force HDR output mode.
    Hdr = 3,
}

/// Display color-space selector.
export enum DisplayColorSpace {
    /// Backend does not expose a concrete color space.
    Unknown = 0,
    /// Standard RGB color space.
    Srgb = 1,
    /// Display-P3 color space.
    DisplayP3 = 2,
    /// BT.2020 color space.
    Bt2020 = 3,
    /// scRGB color space.
    ScRgb = 4,
    /// HDR10 transfer and primaries.
    Hdr10 = 5,
}

/// Display color-state snapshot.
export struct DisplayColorState {
    /// Current HDR policy mode.
    hdrMode: DisplayHdrMode;
    /// Current output color space.
    colorSpace: DisplayColorSpace;
    /// Effective color-channel depth in bits when available.
    bitsPerChannel: uint16 | void;
}

/// Display gamma-ramp payload.
export struct DisplayGammaRamp {
    /// Red channel gamma table entries.
    red: Slice<uint16>;
    /// Green channel gamma table entries.
    green: Slice<uint16>;
    /// Blue channel gamma table entries.
    blue: Slice<uint16>;
}

/// One monitor descriptor snapshot.
export struct DisplayDescriptor {
    /// Resolved backend that produced this descriptor.
    backend: DisplayBackend;
    /// Stable runtime display identifier.
    id: string;
    /// Host display name.
    name: string;
    /// Whether this display is primary.
    primary: boolean;
    /// Display origin x coordinate in desktop space.
    x: int32;
    /// Display origin y coordinate in desktop space.
    y: int32;
    /// Display width in physical pixels.
    widthPx: uint32;
    /// Display height in physical pixels.
    heightPx: uint32;
    /// Work-area origin x coordinate in desktop space.
    workAreaX: int32;
    /// Work-area origin y coordinate in desktop space.
    workAreaY: int32;
    /// Work-area width in physical pixels.
    workAreaWidthPx: uint32;
    /// Work-area height in physical pixels.
    workAreaHeightPx: uint32;
    /// Physical width in millimeters when reported by the backend.
    widthMm: uint32;
    /// Physical height in millimeters when reported by the backend.
    heightMm: uint32;
    /// Scale factor in milli-scale units.
    scaleFactorMilli: uint32;
    /// Current orientation.
    orientation: DisplayOrientation;
    /// Built-in panel status.
    builtinPanel: DisplaySupportStatus;
    /// Variable-refresh capability status.
    variableRefreshSupport: DisplaySupportStatus;
    /// HDR capability status.
    hdrSupport: DisplaySupportStatus;
    /// Current display color state when exposed by the backend.
    colorState: DisplayColorState | void;
}

/// Display monitor list request.
export struct DisplayMonitorListRequest {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
}

/// Display monitor open options.
export struct DisplayMonitorOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
}

/// Display monitor bindings.
/// List available displays.
///
/// List host display outputs with stable identifiers and physical metadata.
///
/// # Platform
/// Unix and Windows.
/// Declared backend kinds include mobile and Apple backends, while this host runtime currently implements one subset.
/// Uses host display-enumeration APIs on Unix and Windows targets.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
///
/// # Security
/// Requires `display.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.list", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "eventLoop",
})
export declare function monitorList(
    request: DisplayMonitorListRequest,
): Result<Slice<DisplayDescriptor>, PlatformError>;

/// Read the current primary display handle.
///
/// Return the current primary display handle when available.
/// Returns `void` when the backend has no discoverable primary display.
///
/// # Platform
/// Unix and Windows.
/// Uses compositor and system-display primary-output selection.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
///
/// # Security
/// Requires `display.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.primary", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "eventLoop",
})
export declare function monitorPrimary(
    request: DisplayMonitorListRequest,
): Result<DisplayHandle | void, PlatformError>;

/// Open a display endpoint.
///
/// Open a display endpoint by identifier for mode queries and updates.
///
/// # Platform
/// Unix and Windows.
/// Uses backend-specific display open handles.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `display.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "eventLoop",
})
export declare function monitorOpen(
    id: string,
    options: DisplayMonitorOpenOptions,
): Result<DisplayHandle, PlatformError>;

/// Close a display endpoint.
///
/// Close a display endpoint and release host resources.
///
/// # Platform
/// Unix and Windows.
/// Uses backend-specific display close operations.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `display.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "eventLoop",
})
export declare function monitorClose(handle: DisplayHandle): Result<void, PlatformError>;

/// Read display descriptor metadata.
///
/// Read the current descriptor snapshot for a display endpoint.
///
/// # Platform
/// Unix and Windows.
/// Uses backend-specific monitor metadata queries.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `display.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.descriptor", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "eventLoop",
})
export declare function monitorDescriptor(
    handle: DisplayHandle,
): Result<DisplayDescriptor, PlatformError>;

/// Read available display modes.
///
/// Read all host-supported modes for a display endpoint.
/// Mode ordering follows backend reporting behavior.
///
/// # Platform
/// Unix and Windows.
/// Uses host mode-enumeration APIs on Unix and Windows targets.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `display.mode`.
///
/// # Replay
/// External, recordable.
@binding("destack.display.monitor.modes", {
    effect: "external",
    replay: "recordable",
    capabilities: ["display.mode"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "eventLoop",
})
export declare function monitorModes(handle: DisplayHandle): Result<Slice<DisplayMode>, PlatformError>;

/// Read the current mode for a display.
///
/// Read the active mode for a display endpoint.
///
/// # Platform
/// Unix and Windows.
/// Uses backend-specific current-mode queries.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
