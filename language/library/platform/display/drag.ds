import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { Path } from "destack:platform/fs";
import { DisplayDragSessionHandle, WindowHandle } from "destack:platform/resource";

/// Drag operation selector.
export enum DisplayDragOperation {
    /// No accepted operation.
    None = 1,
    /// Copy the dragged payload.
    Copy = 2,
    /// Move the dragged payload.
    Move = 3,
    /// Link to the dragged payload.
    Link = 4,
}

/// Drag operation mask.
export newtype DisplayDragOperationMask = uint32;

/// No allowed operations.
export const DISPLAY_DRAG_OPERATION_NONE: DisplayDragOperationMask = DisplayDragOperationMask(0x0);

/// Copy operation.
export const DISPLAY_DRAG_OPERATION_COPY: DisplayDragOperationMask = DisplayDragOperationMask(0x1);

/// Move operation.
export const DISPLAY_DRAG_OPERATION_MOVE: DisplayDragOperationMask = DisplayDragOperationMask(0x2);

/// Link operation.
export const DISPLAY_DRAG_OPERATION_LINK: DisplayDragOperationMask = DisplayDragOperationMask(0x4);

/// Item kind for one drag-transfer entry.
export enum DisplayDragItemKind {
    /// One textual payload.
    String = 1,
    /// One filesystem payload.
    File = 2,
    /// One arbitrary binary payload.
    Binary = 3,
}

/// Drag position in window-local logical coordinates.
export struct DisplayDragPosition {
    /// Window-local logical x coordinate.
    x: int32;
    /// Window-local logical y coordinate.
    y: int32;
}

/// One lazily readable drag-transfer item descriptor.
export struct DisplayDragItemDescriptor {
    /// Item kind.
    kind: DisplayDragItemKind;
    /// MIME type or platform-native type identifier when available.
    itemType: string | void;
    /// Suggested display name for file or binary payloads.
    name: string | void;
    /// Whether one file payload refers to one directory.
    isDirectory: boolean;
    /// Payload length in bytes when available.
    byteLength: uint64 | void;
}

/// Shared drag-transfer metadata.
export struct DisplayDragTransfer {
    /// Stable drag session handle.
    session: DisplayDragSessionHandle;
    /// Whether the transfer originated outside the current runtime.
    isExternal: boolean;
    /// Operations offered by the drag source.
    allowedOperations: DisplayDragOperationMask;
    /// Host-proposed operation from source state and gesture modifiers when known.
    proposedOperation: DisplayDragOperation | void;
    /// Transfer position in window-local logical coordinates when available.
    position: DisplayDragPosition | void;
    /// Offered transfer items in source order.
    items: Slice<DisplayDragItemDescriptor>;
}

/// One source-side drag item.
export struct DisplayDragSourceItem {
    /// Item kind.
    kind: DisplayDragItemKind;
    /// MIME type for this payload.
    itemType: string | void;
    /// Suggested display name for file or binary payloads.
    name: string | void;
    /// Text payload for string items.
    text: string | void;
    /// Filesystem payload for file items.
    path: Path | void;
    /// Binary payload for binary items.
    bytes: Slice<uint8> | void;
}

/// One source-side drag preview image.
export struct DisplayDragPreview {
    /// Preview pixel format identifier.
    pixelFormat: uint32;
    /// Preview width in pixels.
    width: uint32;
    /// Preview height in pixels.
    height: uint32;
    /// Pixel data in row-major order.
    pixels: Slice<uint8>;
    /// Cursor hotspot x coordinate in pixels.
    hotspotX: int32;
    /// Cursor hotspot y coordinate in pixels.
    hotspotY: int32;
}

/// Source-side drag options.
export struct DisplayDragBeginOptions {
    /// Source window when one explicit window scope is required.
    /// When omitted, the active backend focus context is used.
    window: WindowHandle | void;
    /// Operations offered to the drop destination.
    allowedOperations: DisplayDragOperationMask;
    /// Drag items in source order.
    items: Slice<DisplayDragSourceItem>;
    /// Suggested starting position in window-local logical coordinates.
    position: DisplayDragPosition | void;
    /// Optional preview image.
    preview: DisplayDragPreview | void;
}

/// Read one text item from one drag session.
@binding("destack.display.drag.sessionReadText", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragSessionReadText(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<string, PlatformError>;

/// Read one binary item from one drag session.
@binding("destack.display.drag.sessionReadBytes", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragSessionReadBytes(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<Slice<uint8>, PlatformError>;

/// Read one filesystem item from one drag session.
@binding("destack.display.drag.sessionReadPath", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragSessionReadPath(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<Path, PlatformError>;

/// Select one accepted operation for one drag session.
@binding("destack.display.drag.sessionSetOperation", {
    effect: "external",
    replay: "forbidden",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragSessionSetOperation(
    session: DisplayDragSessionHandle,
    operation: DisplayDragOperation,
): Result<void, PlatformError>;

/// Close one drag session handle.
@binding("destack.display.drag.sessionClose", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragSessionClose(
    session: DisplayDragSessionHandle,
): Result<void, PlatformError>;

/// Begin one source-side drag session.
@binding("destack.display.drag.begin", {
    effect: "external",
    replay: "forbidden",
    requires: ["display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function dragBegin(
    options: DisplayDragBeginOptions,
): Result<DisplayDragOperation, PlatformError>;
