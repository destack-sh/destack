export struct WindowDragEnteredEvent {
    /// Discriminator for this window event variant.
    kind: "dragEntered";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
    /// Drag-transfer payload.
    payload: DisplayDragTransfer;
}

/// Window drag-updated event.
export struct WindowDragUpdatedEvent {
    /// Discriminator for this window event variant.
    kind: "dragUpdated";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
