/// Window event payload.
export newtype WindowEvent =
    | WindowCreatedEvent
    | WindowCloseRequestedEvent
    | WindowDestroyedEvent
    | WindowFocusChangedEvent
    | WindowVisibilityChangedEvent
    | WindowOcclusionChangedEvent
    | WindowPositionChangedEvent
    | WindowSizeChangedEvent
    | WindowContentRectChangedEvent
    | WindowFramebufferSizeChangedEvent
    | WindowScaleFactorChangedEvent
    | WindowRenderStateChangedEvent
    | WindowModeChangedEvent
    | WindowDisplayChangedEvent
    | WindowThemeChangedEvent
    | WindowChromeChangedEvent
    | WindowTaskbarVisibilityChangedEvent
    | WindowSafeAreaChangedEvent
    | WindowOpacityChangedEvent
    | WindowParentChangedEvent
    | WindowTransientChangedEvent
    | WindowModalChangedEvent
    | WindowMousePassthroughChangedEvent
    | WindowAspectRatioChangedEvent
    | WindowDragEnteredEvent
    | WindowDragUpdatedEvent
    | WindowDragExitedEvent
    | WindowDroppedEvent;

/// Window-event kind filter mask.
export newtype WindowEventKindMask = uint64;

/// Event kind bit for `created`.
export const WINDOW_EVENT_KIND_CREATED: WindowEventKindMask = WindowEventKindMask(0x1);
/// Event kind bit for `closeRequested`.
export const WINDOW_EVENT_KIND_CLOSE_REQUESTED: WindowEventKindMask = WindowEventKindMask(0x2);
/// Event kind bit for `destroyed`.
export const WINDOW_EVENT_KIND_DESTROYED: WindowEventKindMask = WindowEventKindMask(0x4);
/// Event kind bit for `focusChanged`.
export const WINDOW_EVENT_KIND_FOCUS_CHANGED: WindowEventKindMask = WindowEventKindMask(0x8);
/// Event kind bit for `visibilityChanged`.
export const WINDOW_EVENT_KIND_VISIBILITY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x10);
/// Event kind bit for `occlusionChanged`.
export const WINDOW_EVENT_KIND_OCCLUSION_CHANGED: WindowEventKindMask = WindowEventKindMask(0x20);
/// Event kind bit for `positionChanged`.
export const WINDOW_EVENT_KIND_POSITION_CHANGED: WindowEventKindMask = WindowEventKindMask(0x40);
/// Event kind bit for `sizeChanged`.
export const WINDOW_EVENT_KIND_SIZE_CHANGED: WindowEventKindMask = WindowEventKindMask(0x80);
/// Event kind bit for `contentRectChanged`.
export const WINDOW_EVENT_KIND_CONTENT_RECT_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x100);
/// Event kind bit for `framebufferSizeChanged`.
export const WINDOW_EVENT_KIND_FRAMEBUFFER_SIZE_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x200);
/// Event kind bit for `scaleFactorChanged`.
export const WINDOW_EVENT_KIND_SCALE_FACTOR_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x400);
/// Event kind bit for `renderStateChanged`.
export const WINDOW_EVENT_KIND_RENDER_STATE_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x800);
/// Event kind bit for `modeChanged`.
export const WINDOW_EVENT_KIND_MODE_CHANGED: WindowEventKindMask = WindowEventKindMask(0x1000);
/// Event kind bit for `displayChanged`.
export const WINDOW_EVENT_KIND_DISPLAY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x2000);
/// Event kind bit for `themeChanged`.
export const WINDOW_EVENT_KIND_THEME_CHANGED: WindowEventKindMask = WindowEventKindMask(0x4000);
/// Event kind bit for `chromeChanged`.
export const WINDOW_EVENT_KIND_CHROME_CHANGED: WindowEventKindMask = WindowEventKindMask(0x8000);
/// Event kind bit for `taskbarVisibilityChanged`.
export const WINDOW_EVENT_KIND_TASKBAR_VISIBILITY_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x10000);
/// Event kind bit for `safeAreaChanged`.
export const WINDOW_EVENT_KIND_SAFE_AREA_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x20000);
/// Event kind bit for `opacityChanged`.
export const WINDOW_EVENT_KIND_OPACITY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x40000);
/// Event kind bit for `parentChanged`.
export const WINDOW_EVENT_KIND_PARENT_CHANGED: WindowEventKindMask = WindowEventKindMask(0x80000);
/// Event kind bit for `transientChanged`.
export const WINDOW_EVENT_KIND_TRANSIENT_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x100000);
/// Event kind bit for `modalChanged`.
export const WINDOW_EVENT_KIND_MODAL_CHANGED: WindowEventKindMask = WindowEventKindMask(0x200000);
/// Event kind bit for `mousePassthroughChanged`.
export const WINDOW_EVENT_KIND_MOUSE_PASSTHROUGH_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x400000);
/// Event kind bit for `aspectRatioChanged`.
export const WINDOW_EVENT_KIND_ASPECT_RATIO_CHANGED: WindowEventKindMask =
    WindowEventKindMask(0x800000);
/// Event kind bit for `dragEntered`.
export const WINDOW_EVENT_KIND_DRAG_ENTERED: WindowEventKindMask = WindowEventKindMask(0x1000000);
/// Event kind bit for `dragUpdated`.
export const WINDOW_EVENT_KIND_DRAG_UPDATED: WindowEventKindMask = WindowEventKindMask(0x2000000);
/// Event kind bit for `dragExited`.
export const WINDOW_EVENT_KIND_DRAG_EXITED: WindowEventKindMask = WindowEventKindMask(0x4000000);
/// Event kind bit for `dropped`.
export const WINDOW_EVENT_KIND_DROPPED: WindowEventKindMask = WindowEventKindMask(0x8000000);

/// Window-event stream filter options.
export struct WindowEventFilter {
    /// Restrict events to one window when set.
    window: WindowHandle | void;
    /// Restrict events to selected kinds when set.
    kindMask: WindowEventKindMask | void;
}

/// Window event stream open options.
export struct WindowEventOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Event queue configuration.
    queue: DisplayEventQueueOptions;
    /// Optional filter for narrowing delivered events.
    filter: WindowEventFilter | void;
}

/// Open a global window-event stream.
@binding("destack.display.window.eventOpen", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventOpen(
    options: WindowEventOpenOptions,
): Result<WindowEventHandle, PlatformError>;

/// Close a global window-event stream.
@binding("destack.display.window.eventClose", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventClose(handle: WindowEventHandle): Result<void, PlatformError>;

/// Wait for a window event.
@binding("destack.display.window.eventRead", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventRead(
    handle: WindowEventHandle,
    timeoutNs: uint64,
): Result<WindowEvent, PlatformError>;

/// Poll a window event without blocking.
@binding("destack.display.window.eventTryRead", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventTryRead(
    handle: WindowEventHandle,
): Result<WindowEvent, PlatformError>;

/// Wait for a batch of window events.
@binding("destack.display.window.eventReadBatch", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventReadBatch(
    handle: WindowEventHandle,
    maxEvents: uint32,
    timeoutNs: uint64,
): Result<Array<WindowEvent>, PlatformError>;

/// Poll a batch of window events without blocking.
@binding("destack.display.window.eventTryReadBatch", {
    effect: "external",
    requires: ["display.window.events"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function windowEventTryReadBatch(
    handle: WindowEventHandle,
    maxEvents: uint32,
): Result<Array<WindowEvent>, PlatformError>;
