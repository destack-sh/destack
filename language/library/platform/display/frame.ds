import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { DisplayBeginFrameHandle, WindowHandle } from "destack:platform/resource";
import {
    DisplayBackend,
    DisplayBackendSelectionPolicy,
    DisplayEventQueueOptions,
} from "./backend.ds";

/// Begin-frame event payload.
export struct DisplayBeginFrameEvent {
    /// Resolved backend that produced this begin-frame event.
    backend: DisplayBackend;
    /// Window handle associated with this begin-frame event.
    window: WindowHandle;
    /// Monotonic begin-frame identifier for this window.
    beginFrameId: uint64;
    /// Host scheduling timestamp in nanoseconds.
    scheduledAtNs: uint64;
    /// Earliest wakeup hint in nanoseconds when the host provides one.
    targetWakeupTimestampNs: uint64 | void;
    /// Predicted presentation timestamp in nanoseconds when the host provides one.
    /// This is a hint, not the actual presentation timestamp.
    predictedPresentationTimestampNs: uint64 | void;
    /// Predicted render deadline in nanoseconds when the host provides one.
    deadlineNs: uint64 | void;
    /// Predicted begin-frame interval in nanoseconds when the host provides one.
    intervalNs: uint64 | void;
    /// Delivery timestamp in nanoseconds.
    deliveredAtNs: uint64;
    /// Monotonic event sequence number.
    sequence: uint64;
    /// Number of events dropped by this stream before this event.
    droppedCount: uint64;
}

/// Begin-frame stream filter options.
export struct DisplayBeginFrameFilter {
    /// Restrict events to one window when set.
    window: WindowHandle | void;
}

/// Begin-frame stream open options.
export struct DisplayBeginFrameOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Event queue configuration.
    queue: DisplayEventQueueOptions;
    /// Optional filter for narrowing delivered events.
    filter: DisplayBeginFrameFilter | void;
}

/// Open a global begin-frame stream.
@binding("destack.display.frame.beginOpen", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameOpen(
    options: DisplayBeginFrameOpenOptions,
): Result<DisplayBeginFrameHandle, PlatformError>;

/// Close a begin-frame stream.
@binding("destack.display.frame.beginClose", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameClose(handle: DisplayBeginFrameHandle): Result<void, PlatformError>;

/// Wait for a begin-frame event.
@binding("destack.display.frame.beginRead", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameRead(
    handle: DisplayBeginFrameHandle,
    timeoutNs: uint64,
): Result<DisplayBeginFrameEvent, PlatformError>;

/// Poll a begin-frame event without blocking.
@binding("destack.display.frame.beginTryRead", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameTryRead(
    handle: DisplayBeginFrameHandle,
): Result<DisplayBeginFrameEvent, PlatformError>;

/// Wait for a batch of begin-frame events.
@binding("destack.display.frame.beginReadBatch", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameReadBatch(
    handle: DisplayBeginFrameHandle,
    maxEvents: uint32,
    timeoutNs: uint64,
): Result<Array<DisplayBeginFrameEvent>, PlatformError>;

/// Poll a batch of begin-frame events without blocking.
@binding("destack.display.frame.beginTryReadBatch", {
    effect: "external",
    requires: ["host.display.window"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginFrameTryReadBatch(
    handle: DisplayBeginFrameHandle,
    maxEvents: uint32,
): Result<Array<DisplayBeginFrameEvent>, PlatformError>;
