export struct DisplayEventOverflow {
    /// Event discriminator.
    kind: "overflow";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Number of dropped events.
    droppedCount: uint64;
}

/// Display event.
@derive(Tagged)
export newtype DisplayEvent =
    | DisplayEventMonitorAdded
    | DisplayEventMonitorRemoved
    | DisplayEventMonitorChanged
    | DisplayEventMonitorModeChanged
    | DisplayEventWindowCloseRequested
    | DisplayEventWindowDestroyed
    | DisplayEventWindowFocusChanged
    | DisplayEventWindowVisibilityChanged
    | DisplayEventWindowMoved
    | DisplayEventWindowResized
    | DisplayEventWindowModeChanged
    | DisplayEventWindowRenderStateChanged
    | DisplayEventWindowThemeChanged
    | DisplayEventDragEntered
    | DisplayEventDragMoved
    | DisplayEventDragLeft
    | DisplayEventDragDropped
    | DisplayEventOverflow;

/// Open one display event subscription.
@binding("destack.display.event.open", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function openDisplayEvents(
    subscription: &readonly DisplayEventSubscription,
): Result<DisplayEventHandle, PlatformError>;

/// Close one display event subscription.
@binding("destack.display.event.close", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function closeDisplayEvents(events: DisplayEventHandle): Result<void, PlatformError>;

/// Read display events.
@binding("destack.display.event.read", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readDisplayEvents(
    events: DisplayEventHandle,
    maxEvents: uint32,
    timeoutNs?: uint64,
): Result<^Array<DisplayEvent>, PlatformError>;
