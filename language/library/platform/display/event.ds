import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import {
    DisplayDragSessionHandle,
    DisplayEventHandle,
    MonitorHandle,
    WindowHandle,
} from "destack:platform/resource";
import { DisplayBackendKind, DisplayBackendSelection } from "./backend.ds";
import { DisplayDragTransfer } from "./drag.ds";
import { Monitor, MonitorMode } from "./monitor.ds";
import {
    WindowMode,
    WindowPixelSize,
    WindowPoint,
    WindowPosition,
    WindowRenderState,
    WindowSize,
    WindowTheme,
    WindowVisibility,
} from "./window.ds";

/// Display event flags.
export newtype DisplayEventFlags = uint64;

/// Subscribe to monitor events.
export const DISPLAY_EVENT_MONITOR: DisplayEventFlags = DisplayEventFlags(0x01);

/// Subscribe to window lifecycle events.
export const DISPLAY_EVENT_WINDOW: DisplayEventFlags = DisplayEventFlags(0x02);

/// Subscribe to window geometry events.
export const DISPLAY_EVENT_WINDOW_GEOMETRY: DisplayEventFlags = DisplayEventFlags(0x04);

/// Subscribe to window renderability events.
export const DISPLAY_EVENT_WINDOW_RENDER: DisplayEventFlags = DisplayEventFlags(0x08);

/// Subscribe to drag and drop events.
export const DISPLAY_EVENT_DRAG: DisplayEventFlags = DisplayEventFlags(0x10);

/// Display event overflow policy.
export enum DisplayEventOverflow {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report queue overflow as an error.
    Error = 3,
}

/// Display event subscription.
export struct DisplayEventSubscription {
    /// Backend selection.
    backend: DisplayBackendSelection;
    /// Event flags.
    flags: DisplayEventFlags;
    /// Window filter.
    window?: WindowHandle;
    /// Monitor filter.
    monitor?: MonitorHandle;
    /// Queue capacity in events, or zero for backend default.
    capacity: uint32;
    /// Queue overflow policy.
    overflow: DisplayEventOverflow;
}

/// Display event.
@derive(Tagged)
export newtype DisplayEvent =
    | {
          kind: "monitorAdded";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          monitor: Monitor;
      }
    | {
          kind: "monitorRemoved";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          monitorId: string;
      }
    | {
          kind: "monitorChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          monitor: Monitor;
      }
    | {
          kind: "monitorModeChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          monitor: MonitorHandle;
          mode: MonitorMode;
      }
    | {
          kind: "windowCloseRequested";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
      }
    | {
          kind: "windowDestroyed";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
      }
    | {
          kind: "windowFocusChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          isFocused: boolean;
      }
    | {
          kind: "windowVisibilityChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          visibility: WindowVisibility;
      }
    | {
          kind: "windowMoved";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          position: WindowPosition;
      }
    | {
          kind: "windowResized";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          size: WindowSize;
          framebuffer: WindowPixelSize;
          scaleFactorMilli: uint32;
      }
    | {
          kind: "windowModeChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          mode: WindowMode;
      }
    | {
          kind: "windowRenderStateChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          renderState: WindowRenderState;
      }
    | {
          kind: "windowThemeChanged";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          theme: WindowTheme;
      }
    | {
          kind: "dragEntered";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          transfer: DisplayDragTransfer;
      }
    | {
          kind: "dragMoved";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          session: DisplayDragSessionHandle;
          position: WindowPoint;
      }
    | {
          kind: "dragLeft";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          session: DisplayDragSessionHandle;
      }
    | {
          kind: "dragDropped";
          timestampNs: uint64;
          sequence: uint64;
          droppedCount: uint64;
          backend: DisplayBackendKind;
          window: WindowHandle;
          transfer: DisplayDragTransfer;
      }
    | { kind: "overflow"; timestampNs: uint64; sequence: uint64; droppedCount: uint64 };

/// Open one display event subscription.
@binding("destack.display.event.open", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function openDisplayEvents(
    subscription: &readonly DisplayEventSubscription,
): Result<DisplayEventHandle, PlatformError>;

/// Close one display event subscription.
@binding("destack.display.event.close", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function closeDisplayEvents(events: DisplayEventHandle): Result<void, PlatformError>;

/// Read display events.
@binding("destack.display.event.read", {
    effect: "external",
    requires: ["host.display.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readDisplayEvents(
    events: DisplayEventHandle,
    maxEvents: uint32,
    timeoutNs?: uint64,
): Result<^Array<DisplayEvent>, PlatformError>;
