import { PlatformError } from "destack:platform/error";
import { TlsContextHandle } from "destack:platform/resource";

/// TLS protocol version.
export enum TlsVersion {
    /// TLS 1.2.
    Tls12 = 0x0303,
    /// TLS 1.3.
    Tls13 = 0x0304,
}

/// TLS endpoint role.
export enum TlsRole {
    /// Client endpoint.
    Client = 0,
    /// Server endpoint.
    Server = 1,
}

/// TLS hostname verification mode.
export enum TlsHostnameVerificationMode {
    /// Enforce strict hostname verification against the expected server name.
    Strict = 0,
    /// Permit hostname mismatch while still validating certificate trust.
    AllowMismatch = 1,
    /// Disable hostname verification checks.
    Disabled = 2,
}

/// TLS session resumption policy.
export enum TlsSessionResumptionMode {
    /// Disable session resumption.
    Disabled = 0,
    /// Enable stateful session cache resumption.
    Stateful = 1,
    /// Enable stateless ticket resumption.
    Stateless = 2,
    /// Enable stateful and stateless resumption.
    StatefulAndStateless = 3,
}

/// Options for opening one TLS context.
export struct TlsContextOptions {
    /// Client or server role.
    role: TlsRole;
    /// Minimum protocol version.
    minVersion: TlsVersion;
    /// Maximum protocol version.
    maxVersion: TlsVersion;
    /// Require peer certificate validation.
    verifyPeer: boolean;
    /// Application layer protocol identifiers in preference order.
    alpnProtocols: [[uint8]];
}

/// Open one TLS context.
@binding("destack.tls.context.open", {
    effect: "external",
    requires: ["tls.context"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openTlsContext(
    options: &readonly TlsContextOptions,
): Result<TlsContextHandle, PlatformError>;

/// Close one TLS context.
@binding("destack.tls.context.close", {
    effect: "external",
    requires: ["tls.context"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeTlsContext(context: TlsContextHandle): Result<void, PlatformError>;

/// Set one local certificate chain and private key on a TLS context.
@binding("destack.tls.context.identity.pem.set", {
    effect: "external",
    requires: ["tls.context", "tls.identity.use", "tls.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsIdentityPem(
    context: TlsContextHandle,
    certificateChainPem: &readonly [uint8],
    privateKeyPem: &readonly [uint8],
): Result<void, PlatformError>;

/// Set trust anchors on a TLS context from one PEM bundle.
@binding("destack.tls.context.trust.pem.set", {
    effect: "external",
    requires: ["tls.context", "tls.trust.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsTrustAnchorsPem(
    context: TlsContextHandle,
    trustAnchorsPem: &readonly [uint8],
): Result<void, PlatformError>;

/// Set allowed TLS cipher suites for one context.
@binding("destack.tls.context.cipherSuites.set", {
    effect: "external",
    requires: ["tls.context", "tls.policy"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsCipherSuites(
    context: TlsContextHandle,
    suites: &readonly [string],
): Result<void, PlatformError>;

/// Set allowed TLS key exchange groups for one context.
@binding("destack.tls.context.groups.set", {
    effect: "external",
    requires: ["tls.context", "tls.policy"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsGroups(
    context: TlsContextHandle,
    groups: &readonly [string],
): Result<void, PlatformError>;

/// Set allowed TLS signature algorithms for one context.
@binding("destack.tls.context.signatureAlgorithms.set", {
    effect: "external",
    requires: ["tls.context", "tls.policy"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsSignatureAlgorithms(
    context: TlsContextHandle,
    algorithms: &readonly [string],
): Result<void, PlatformError>;

/// Set hostname verification mode for one context.
@binding("destack.tls.context.hostnameVerification.set", {
    effect: "external",
    requires: ["tls.context", "tls.hostname.verify"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsHostnameVerification(
    context: TlsContextHandle,
    mode: TlsHostnameVerificationMode,
): Result<void, PlatformError>;

/// Set session resumption policy for one context.
@binding("destack.tls.context.resumption.set", {
    effect: "external",
    requires: ["tls.context", "tls.resumption"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setTlsSessionResumption(
    context: TlsContextHandle,
    mode: TlsSessionResumptionMode,
): Result<void, PlatformError>;
