import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { SocketHandle, TlsContextHandle, TlsSessionHandle } from "../resource/index.ds";

/// Tls handshake status.
export enum TlsHandshakeStatus {
    /// Handshake is complete.
    Complete = 0,
    /// Handshake needs more transport reads.
    WantRead = 1,
    /// Handshake needs more transport writes.
    WantWrite = 2,
}

/// Tls resumption state for one session.
export enum TlsSessionResumptionState {
    /// Session was not resumed.
    Fresh = 0,
    /// Session resumed from one cached state or ticket.
    Resumed = 1,
}

/// Tls session bindings for socket-backed transports.
@binding("destack.tls.session.open", {
    effect: "external",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionOpen(
    context: TlsContextHandle,
    socket: SocketHandle,
    serverName: string,
): Result<TlsSessionHandle, PlatformError>;

/// Advance one tls handshake state machine.
@binding("destack.tls.session.handshake", {
    effect: "external",
    requires: ["tls.handshake"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionHandshake(
    handle: TlsSessionHandle,
): Result<TlsHandshakeStatus, PlatformError>;

/// Read decrypted application bytes from one tls session.
@binding("destack.tls.session.read", {
    effect: "external",
    replay: "forbidden",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionRead(
    handle: TlsSessionHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write plaintext application bytes to one tls session.
@binding("destack.tls.session.write", {
    effect: "external",
    replay: "forbidden",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionWrite(
    handle: TlsSessionHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Shutdown one tls session.
@binding("destack.tls.session.shutdown", {
    effect: "external",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionShutdown(handle: TlsSessionHandle): Result<void, PlatformError>;

/// Close one tls session object.
@binding("destack.tls.session.close", {
    effect: "external",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionClose(handle: TlsSessionHandle): Result<void, PlatformError>;

/// Return negotiated alpn protocol bytes.
@binding("destack.tls.session.negotiatedAlpn", {
    effect: "external",
    requires: ["tls.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionNegotiatedAlpn(
    handle: TlsSessionHandle,
): Result<Slice<uint8>, PlatformError>;

/// Return the peer certificate chain bytes in pem encoding.
@binding("destack.tls.session.peerCertificatesPem", {
    effect: "external",
    replay: "forbidden",
    requires: ["tls.certificate.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionPeerCertificatesPem(
    handle: TlsSessionHandle,
): Result<Slice<uint8>, PlatformError>;

/// Export keying material bytes for one tls session.
@binding("destack.tls.session.exportKeyingMaterial", {
    effect: "external",
    replay: "forbidden",
    requires: ["tls.session", "tls.exporter"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionExportKeyingMaterial(
    handle: TlsSessionHandle,
    label: string,
    context: Slice<uint8>,
    outputLength: uint32,
): Result<Slice<uint8>, PlatformError>;

/// Return whether one session resumed from cached state or ticket.
@binding("destack.tls.session.resumptionState", {
    effect: "external",
    requires: ["tls.session", "tls.resumption"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sessionResumptionState(
    handle: TlsSessionHandle,
): Result<TlsSessionResumptionState, PlatformError>;
