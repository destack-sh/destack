import { PlatformError } from "destack:platform/error";
import { WindowHandle } from "destack:platform/resource";
import { AccessibilityNodeId } from "./node.ds";
import { AccessibilityLiveRegionPoliteness } from "./state.ds";
import { AccessibilityTextRange, AccessibilityTextRevision } from "./text.ds";
import { AccessibilityTreeRevision } from "./tree.ds";

/// Accessibility notification kind.
export enum AccessibilityNotificationKind {
    /// One announcement should be spoken.
    Announcement = 1,
    /// One focused node changed.
    FocusChanged = 2,
    /// One live region changed.
    LiveRegionChanged = 3,
    /// One screen or top level semantic context changed.
    ScreenChanged = 4,
    /// One layout subtree changed.
    LayoutChanged = 5,
    /// One node child list changed.
    ChildrenChanged = 6,
    /// One value changed.
    ValueChanged = 7,
    /// One text value changed.
    TextChanged = 8,
    /// One selection changed.
    SelectionChanged = 9,
    /// One text selection changed.
    TextSelectionChanged = 10,
    /// One title or accessible name changed.
    TitleChanged = 11,
    /// Selected child elements changed for one container.
    SelectedChildrenChanged = 12,
    /// Selected rows changed for one table or grid.
    SelectedRowsChanged = 13,
    /// Selected columns changed for one table or grid.
    SelectedColumnsChanged = 14,
    /// One collection row count changed.
    RowCountChanged = 15,
}

/// Accessibility notification.
export struct AccessibilityNotification {
    /// Notification kind.
    kind: AccessibilityNotificationKind;
    /// Target node when the notification applies to one node.
    nodeId?: AccessibilityNodeId;
    /// Tree revision current when the notification was posted.
    treeRevision?: AccessibilityTreeRevision;
    /// Text revision current when the notification targets text.
    textRevision?: AccessibilityTextRevision;
    /// Announcement or replacement text payload.
    text?: string;
    /// Live region politeness when relevant.
    politeness?: AccessibilityLiveRegionPoliteness;
    /// Text range when the notification targets one text span.
    textRange?: AccessibilityTextRange;
}

/// Post one accessibility notification.
@binding("destack.accessibility.notification.post", {
    effect: "external",
    requires: ["host.accessibility.notification"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function postAccessibilityNotification(
    window: WindowHandle,
    notification: &readonly AccessibilityNotification,
): Result<void, PlatformError>;
