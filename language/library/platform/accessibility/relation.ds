import { Slice } from "core";
import { AccessibilityNodeId } from "./role.ds";

/// Accessibility relations that correspond to ARIA id reference properties.
export struct AccessibilityNodeRelations {
    /// `aria-activedescendant`.
    activeDescendantId: AccessibilityNodeId | void;
    /// `aria-controls`.
    controlledIds: Slice<AccessibilityNodeId>;
    /// Header nodes for the current column when the backend exposes them.
    columnHeaderIds: Slice<AccessibilityNodeId>;
    /// `aria-describedby`.
    describedByIds: Slice<AccessibilityNodeId>;
    /// `aria-details`.
    detailsIds: Slice<AccessibilityNodeId>;
    /// `aria-errormessage`.
    errorMessageIds: Slice<AccessibilityNodeId>;
    /// `aria-flowto`.
    flowToIds: Slice<AccessibilityNodeId>;
    /// `aria-labelledby`.
    labeledByIds: Slice<AccessibilityNodeId>;
    /// `aria-owns`.
    ownedIds: Slice<AccessibilityNodeId>;
    /// Header nodes for the current row when the backend exposes them.
    rowHeaderIds: Slice<AccessibilityNodeId>;
}
