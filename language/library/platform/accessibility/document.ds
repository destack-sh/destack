import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { AccessibilityDocumentHandle, WindowHandle } from "../resource/index.ds";
import { AccessibilityNodeId } from "./role.ds";
import { AccessibilityTextRange, AccessibilityTextSelection } from "./text.ds";

/// Supported text-selection model for one document.
export enum AccessibilitySupportedTextSelection {
    /// The document does not support text selection.
    None = 1,
    /// The document supports one active selection.
    Single = 2,
    /// The document supports multiple active selections.
    Multiple = 3,
}

/// Text navigation unit.
export enum AccessibilityTextUnit {
    /// One individual UTF-16 code unit boundary.
    Character = 1,
    /// One contiguous formatting run.
    Format = 2,
    /// One word boundary.
    Word = 3,
    /// One line boundary.
    Line = 4,
    /// One paragraph boundary.
    Paragraph = 5,
    /// One page boundary.
    Page = 6,
    /// The full document range.
    Document = 7,
}

/// Supported text navigation units.
export newtype AccessibilityTextUnitFlags = uint32;

/// No text navigation units.
export const ACCESSIBILITY_TEXT_UNIT_NONE: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x0);

/// Character-unit navigation.
export const ACCESSIBILITY_TEXT_UNIT_CHARACTER: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x1);

/// Format-run navigation.
export const ACCESSIBILITY_TEXT_UNIT_FORMAT: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x2);

/// Word-unit navigation.
export const ACCESSIBILITY_TEXT_UNIT_WORD: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x4);

/// Line-unit navigation.
export const ACCESSIBILITY_TEXT_UNIT_LINE: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x8);

/// Paragraph-unit navigation.
export const ACCESSIBILITY_TEXT_UNIT_PARAGRAPH: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x10);

/// Page-unit navigation.
export const ACCESSIBILITY_TEXT_UNIT_PAGE: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x20);

/// Whole-document navigation.
export const ACCESSIBILITY_TEXT_UNIT_DOCUMENT: AccessibilityTextUnitFlags =
    AccessibilityTextUnitFlags(0x40);

/// Logical bounds for one text fragment.
export struct AccessibilityTextRect {
    /// Window-local logical x coordinate.
    x: float64;
    /// Window-local logical y coordinate.
    y: float64;
    /// Logical width.
    width: float64;
    /// Logical height.
    height: float64;
}

/// One attributed text run.
export struct AccessibilityTextStyleRun {
    /// Covered text range in UTF-16 code units.
    range: AccessibilityTextRange;
    /// BCP 47 language tag for this run when available.
    languageTag: string | void;
    /// Font family name when available.
    fontFamily: string | void;
    /// Font size in typographic points when available.
    fontSizePoints: float64 | void;
    /// Foreground color encoded as `0xRRGGBBAA` when available.
    foregroundColorRgba: uint32 | void;
    /// Background color encoded as `0xRRGGBBAA` when available.
    backgroundColorRgba: uint32 | void;
    /// Whether this run is bold.
    isBold: boolean;
    /// Whether this run is italic.
    isItalic: boolean;
    /// Whether this run is underlined.
    isUnderline: boolean;
    /// Whether this run is struck through.
    isStruckThrough: boolean;
    /// Whether this run is superscript.
    isSuperscript: boolean;
    /// Whether this run is subscript.
    isSubscript: boolean;
    /// Whether this run carries one spelling error annotation.
    isMisspelled: boolean;
    /// Whether this run carries one grammar error annotation.
    isGrammarError: boolean;
    /// Canonical URL for link runs when available.
    linkUrl: string | void;
}

/// Inline embedded object anchored in document text.
export struct AccessibilityEmbeddedObject {
    /// Covered placeholder or attachment range in UTF-16 code units.
    range: AccessibilityTextRange;
    /// Referenced accessibility node identifier.
    nodeId: AccessibilityNodeId;
}

/// One advanced text-document snapshot.
export struct AccessibilityTextDocument {
    /// Monotonic document revision for this published snapshot.
    revision: uint64;
    /// Full document range in UTF-16 code units.
    documentRange: AccessibilityTextRange;
    /// Supported selection model for the document.
    supportedSelection: AccessibilitySupportedTextSelection;
    /// Supported text navigation units.
    supportedUnits: AccessibilityTextUnitFlags;
    /// Current text selections in source order.
    selections: Slice<AccessibilityTextSelection>;
    /// Currently visible text ranges in source order.
    visibleRanges: Slice<AccessibilityTextRange>;
}

/// Shared metadata for all document queries.
export struct AccessibilityDocumentQueryMetadata {
    /// Stable query identifier for one request-response round trip.
    requestId: uint64;
    /// Target window for this query.
    window: WindowHandle;
    /// Target node identifier.
    nodeId: AccessibilityNodeId;
    /// Document revision that was current when this query was issued when available.
    documentRevision: uint64 | void;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this query stream.
    sequence: uint64;
    /// Number of document queries dropped by this stream before this query.
    droppedCount: uint64;
}

/// Accessibility document-query stream options.
export struct AccessibilityDocumentOpenOptions {
    /// Requested queue capacity, or zero for the backend default.
    queueCapacity: uint32;
}

/// Status for one document query response.
export enum AccessibilityDocumentQueryStatus {
    /// The query completed successfully.
    Ok = 1,
    /// The requested data is not currently available.
    Unavailable = 2,
    /// The provider does not support this query.
    Unsupported = 3,
    /// The requested range or offset is invalid.
    InvalidRange = 4,
    /// The requested document revision is no longer current.
    Stale = 5,
}

/// Read-text document query.
export struct AccessibilityDocumentReadTextQuery {
    /// Discriminator for this query variant.
    kind: "readText";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested document range.
    range: AccessibilityTextRange;
}

/// Read-unit-ranges document query.
export struct AccessibilityDocumentReadUnitRangesQuery {
    /// Discriminator for this query variant.
    kind: "readUnitRanges";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested text navigation unit.
    unit: AccessibilityTextUnit;
    /// Covering document range.
    range: AccessibilityTextRange;
}

/// Range-for-unit document query.
export struct AccessibilityDocumentRangeForUnitQuery {
    /// Discriminator for this query variant.
    kind: "rangeForUnit";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested text navigation unit.
    unit: AccessibilityTextUnit;
    /// Requested UTF-16 offset.
    offset: uint32;
}

/// Range-at-point document query.
export struct AccessibilityDocumentRangeAtPointQuery {
    /// Discriminator for this query variant.
    kind: "rangeAtPoint";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Window-local logical x coordinate.
    x: float64;
    /// Window-local logical y coordinate.
    y: float64;
}

/// Range-for-child document query.
export struct AccessibilityDocumentRangeForChildQuery {
    /// Discriminator for this query variant.
    kind: "rangeForChild";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Embedded child node identifier.
    childNodeId: AccessibilityNodeId;
}

/// Read-range-bounds document query.
export struct AccessibilityDocumentReadRangeBoundsQuery {
    /// Discriminator for this query variant.
    kind: "readRangeBounds";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested document range.
    range: AccessibilityTextRange;
}

/// Read-style-runs document query.
export struct AccessibilityDocumentReadStyleRunsQuery {
    /// Discriminator for this query variant.
    kind: "readStyleRuns";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested document range.
    range: AccessibilityTextRange;
}

/// Read-embedded-objects document query.
export struct AccessibilityDocumentReadEmbeddedObjectsQuery {
    /// Discriminator for this query variant.
    kind: "readEmbeddedObjects";
    /// Shared query metadata.
    metadata: AccessibilityDocumentQueryMetadata;
    /// Requested document range.
    range: AccessibilityTextRange;
}

/// One inbound document query.
export newtype AccessibilityDocumentQuery =
    | AccessibilityDocumentReadTextQuery
    | AccessibilityDocumentReadUnitRangesQuery
    | AccessibilityDocumentRangeForUnitQuery
    | AccessibilityDocumentRangeAtPointQuery
    | AccessibilityDocumentRangeForChildQuery
    | AccessibilityDocumentReadRangeBoundsQuery
    | AccessibilityDocumentReadStyleRunsQuery
    | AccessibilityDocumentReadEmbeddedObjectsQuery;

/// Read-text document response.
export struct AccessibilityDocumentTextResponse {
    /// Discriminator for this response variant.
    kind: "text";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// UTF-8 text payload when the query succeeded.
    text: string | void;
}

/// Range-list document response.
export struct AccessibilityDocumentRangesResponse {
    /// Discriminator for this response variant.
    kind: "ranges";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// Range list payload when the query succeeded.
    ranges: Slice<AccessibilityTextRange> | void;
}

/// Single-range document response.
export struct AccessibilityDocumentRangeResponse {
    /// Discriminator for this response variant.
    kind: "range";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// Range payload when the query succeeded.
    range: AccessibilityTextRange | void;
}

/// Range-bounds document response.
export struct AccessibilityDocumentRangeBoundsResponse {
    /// Discriminator for this response variant.
    kind: "rangeBounds";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// Bounding rectangles when the query succeeded.
    rects: Slice<AccessibilityTextRect> | void;
}

/// Style-run document response.
export struct AccessibilityDocumentStyleRunsResponse {
    /// Discriminator for this response variant.
    kind: "styleRuns";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// Attributed runs when the query succeeded.
    runs: Slice<AccessibilityTextStyleRun> | void;
}

/// Embedded-object document response.
export struct AccessibilityDocumentEmbeddedObjectsResponse {
    /// Discriminator for this response variant.
    kind: "embeddedObjects";
    /// Matched query identifier.
    requestId: uint64;
    /// Document revision used to produce this response when available.
    documentRevision: uint64 | void;
    /// Response status.
    status: AccessibilityDocumentQueryStatus;
    /// Embedded objects when the query succeeded.
    objects: Slice<AccessibilityEmbeddedObject> | void;
}

/// One outbound document response.
export newtype AccessibilityDocumentResponse =
    | AccessibilityDocumentTextResponse
    | AccessibilityDocumentRangesResponse
    | AccessibilityDocumentRangeResponse
    | AccessibilityDocumentRangeBoundsResponse
    | AccessibilityDocumentStyleRunsResponse
    | AccessibilityDocumentEmbeddedObjectsResponse;

/// Open one inbound document-query stream for one window.
@binding("destack.accessibility.document.open", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentOpen(
    window: WindowHandle,
    options: AccessibilityDocumentOpenOptions,
): Result<AccessibilityDocumentHandle, PlatformError>;

/// Close one inbound document-query stream.
@binding("destack.accessibility.document.close", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentClose(handle: AccessibilityDocumentHandle): Result<void, PlatformError>;

/// Wait for one document query.
@binding("destack.accessibility.document.read", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentRead(
    handle: AccessibilityDocumentHandle,
    timeoutNs: uint64,
): Result<AccessibilityDocumentQuery, PlatformError>;

/// Poll one document query without blocking.
@binding("destack.accessibility.document.tryRead", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentTryRead(
    handle: AccessibilityDocumentHandle,
): Result<AccessibilityDocumentQuery, PlatformError>;

/// Respond to one document query.
@binding("destack.accessibility.document.respond", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentRespond(
    handle: AccessibilityDocumentHandle,
    response: AccessibilityDocumentResponse,
): Result<void, PlatformError>;

/// Publish one advanced text-document snapshot for one node.
@binding("destack.accessibility.document.set", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentSet(
    window: WindowHandle,
    nodeId: AccessibilityNodeId,
    document: AccessibilityTextDocument,
): Result<void, PlatformError>;

/// Clear the advanced text-document snapshot for one node.
@binding("destack.accessibility.document.clear", {
    effect: "external",
    requires: ["accessibility.publish"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function documentClear(
    window: WindowHandle,
    nodeId: AccessibilityNodeId,
): Result<void, PlatformError>;
