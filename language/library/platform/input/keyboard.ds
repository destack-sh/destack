import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";

/// Physical key location selector.
export enum InputKeyLocation {
    /// Standard key position.
    Standard = 0,
    /// Left-side modifier or duplicate key.
    Left = 1,
    /// Right-side modifier or duplicate key.
    Right = 2,
    /// Numpad location.
    Numpad = 3,
}

/// Normalized keyboard modifier and lock state.
export struct InputModifierState {
    /// Whether Alt is active.
    isAlt: boolean;
    /// Whether AltGraph is active.
    isAltGraph: boolean;
    /// Whether Caps Lock is active.
    isCapsLock: boolean;
    /// Whether Control is active.
    isControl: boolean;
    /// Whether Fn is active.
    isFn: boolean;
    /// Whether one Fn lock is active.
    isFnLock: boolean;
    /// Whether Meta is active.
    isMeta: boolean;
    /// Whether Num Lock is active.
    isNumLock: boolean;
    /// Whether Scroll Lock is active.
    isScrollLock: boolean;
    /// Whether Shift is active.
    isShift: boolean;
    /// Whether Symbol is active.
    isSymbol: boolean;
    /// Whether one Symbol lock is active.
    isSymbolLock: boolean;
}

/// Keyboard layout metadata when the backend exposes it.
export struct InputKeyboardLayoutInfo {
    /// Stable backend layout identifier when available.
    layoutId: string | void;
    /// Display name for the active layout when available.
    name: string | void;
    /// BCP 47 locale tag when available.
    locale: string | void;
    /// Backend variant identifier when available.
    variant: string | void;
}

/// Keyboard state snapshot.
export struct InputKeyboardState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Backend modifier bitset for active modifiers.
    backendModifiers: uint32;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
    /// Normalized physical codes currently pressed.
    pressedCodes: Array<string>;
    /// Normalized logical keys currently pressed.
    pressedKeys: Array<string>;
    /// Backend key codes currently pressed.
    pressedBackendCodes: Array<uint32>;
    /// Backend hardware scan codes currently pressed when available.
    pressedScanCodes: Array<uint32>;
    /// Active layout metadata when available.
    layout: InputKeyboardLayoutInfo | void;
    /// Whether the keyboard is currently within one active composition session.
    isComposing: boolean;
}

/// Read one keyboard state snapshot.
@binding("destack.input.keyboard.state", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyboardState(
    handle: InputDeviceHandle,
): Result<InputKeyboardState, PlatformError>;

/// Query keyboard layout metadata.
@binding("destack.input.keyboard.layout", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyboardLayout(
    handle: InputDeviceHandle,
): Result<InputKeyboardLayoutInfo, PlatformError>;
