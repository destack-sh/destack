import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { InputDeviceHandle } from "destack:platform/resource";

/// Touch contact phase.
export enum InputTouchContactPhase {
    /// Contact began.
    Begin = 1,
    /// Contact moved.
    Move = 2,
    /// Contact ended.
    End = 3,
    /// Contact was canceled.
    Cancel = 4,
}

/// Touch contact snapshot.
export struct InputTouchContactState {
    /// Backend contact identifier.
    contactId: uint32;
    /// Contact phase.
    phase: InputTouchContactPhase;
    /// Contact x coordinate in backend-native units.
    x: float64;
    /// Contact y coordinate in backend-native units.
    y: float64;
    /// Contact pressure in the normalized range [0, 1] when available.
    pressure: float64;
    /// Contact major radius in backend-native units when available.
    radiusX: float64;
    /// Contact minor radius in backend-native units when available.
    radiusY: float64;
    /// Contact tilt around x axis in degrees when available.
    tiltX: float64;
    /// Contact tilt around y axis in degrees when available.
    tiltY: float64;
}

/// Touch state snapshot.
export struct InputTouchState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Active contacts for this snapshot.
    contacts: Array<InputTouchContactState>;
}

/// Read one touch state snapshot.
@binding("destack.input.touch.state", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function touchState(handle: InputDeviceHandle): Result<InputTouchState, PlatformError>;
