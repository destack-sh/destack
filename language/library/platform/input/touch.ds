import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";

/// Touch contact phase.
export enum InputTouchContactPhase {
    /// Contact began.
    Begin = 1,
    /// Contact moved.
    Move = 2,
    /// Contact ended.
    End = 3,
    /// Contact was canceled.
    Cancel = 4,
}

/// Touch contact snapshot.
export struct InputTouchContactState {
    /// Backend contact identifier.
    contactId: uint32;
    /// Contact phase.
    phase: InputTouchContactPhase;
    /// Contact x coordinate in backend-native units.
    x: float64;
    /// Contact y coordinate in backend-native units.
    y: float64;
    /// Contact pressure in the normalized range [0, 1] when available.
    pressure: float64;
    /// Contact major radius in backend-native units when available.
    radiusX: float64;
    /// Contact minor radius in backend-native units when available.
    radiusY: float64;
    /// Contact tilt around x axis in degrees when available.
    tiltX: float64;
    /// Contact tilt around y axis in degrees when available.
    tiltY: float64;
}

/// Touch state snapshot.
export struct InputTouchState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Active contacts for this snapshot.
    contacts: Array<InputTouchContactState>;
}

/// Input touch bindings.
/// Read one touch state snapshot.
///
/// Return one current touch-contact snapshot for one opened touch-capable device.
/// Contact ordering follows backend delivery order.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` where touch snapshots are unavailable.
/// Uses backend-specific contact tables from evdev or libinput-style paths on Unix.
/// Uses pointer-contact APIs on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.touch.state", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function touchState(handle: InputDeviceHandle): Result<InputTouchState, PlatformError>;
