import { Array, Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";

/// Input device kind.
export enum InputDeviceKind {
    /// Keyboard input source.
    Keyboard = 1,
    /// Mouse input source.
    Mouse = 2,
    /// Touch input source.
    Touch = 3,
    /// Gamepad input source.
    Gamepad = 4,
    /// Pen or stylus input source.
    Pen = 5,
    /// Raw or vendor-specific input source.
    Raw = 255,
}

/// Input device information.
export struct InputDeviceDescriptor {
    /// Stable runtime input device identifier.
    id: string;
    /// Stable runtime instance identifier for this connection.
    instanceId: string;
    /// Stable backend hardware identifier when available.
    hardwareId: string;
    /// Stable backend serial number when available.
    serialNumber: string | void;
    /// Stable backend location identifier when available.
    locationId: string | void;
    /// Stable gamepad-style guid when available.
    guid: string | void;
    /// Host device name.
    name: string;
    /// Backend transport name when available.
    transport: string;
    /// Device kind.
    kind: InputDeviceKind;
    /// Vendor identifier when available.
    /// Zero when the backend does not report one vendor id.
    vendorId: uint16;
    /// Product identifier when available.
    /// Zero when the backend does not report one product id.
    productId: uint16;
    /// Number of logical keys when reported by the backend.
    /// Zero when the backend does not report key topology.
    keyCount: uint16;
    /// Number of logical buttons when reported by the backend.
    /// Zero when the backend does not report button topology.
    buttonCount: uint16;
    /// Number of logical axes when reported by the backend.
    /// Zero when the backend does not report axis topology.
    axisCount: uint16;
    /// Whether this device is currently connected.
    connected: boolean;
    /// Whether this endpoint supports exclusive-grab mode.
    supportsExclusiveGrab: boolean;
    /// Whether this endpoint can emit raw host-native events.
    supportsRaw: boolean;
    /// Whether this endpoint can emit text events.
    supportsText: boolean;
    /// Whether this endpoint can provide haptic output.
    supportsRumble: boolean;
    /// Whether this endpoint reports battery metadata.
    supportsBattery: boolean;
    /// Whether this endpoint supports light-control output.
    supportsLight: boolean;
    /// Whether this endpoint supports raw-hid reports.
    supportsRawHid: boolean;
    /// Whether this endpoint is virtual or emulated.
    isVirtual: boolean;
    /// Whether this endpoint is provided by the system stack.
    isSystem: boolean;
}

/// Input device capability kind.
export enum InputDeviceCapabilityKind {
    /// Keyboard key and modifier capabilities.
    Keyboard = 1,
    /// Pointer motion, button, and wheel capabilities.
    Pointer = 2,
    /// Touch contact capabilities.
    Touch = 3,
    /// Pen and stylus capabilities.
    Pen = 4,
    /// Gamepad and joystick capabilities.
    Gamepad = 5,
    /// Sensor capabilities.
    Sensor = 6,
    /// Haptic actuator capabilities.
    Haptics = 7,
    /// Text input and composition capabilities.
    TextInput = 8,
}

/// Capability metadata origin kind.
export enum InputCapabilityMetadataOrigin {
    /// Metadata was read from backend capability tables.
    BackendDescriptor = 1,
    /// Metadata was derived from device summary fields.
    DeviceSummary = 2,
    /// Metadata was derived from count-only topology fallback.
    CountDerived = 3,
    /// Metadata was merged from multiple origin kinds.
    Mixed = 255,
}

/// Capability metadata fidelity level.
export enum InputCapabilityMetadataFidelity {
    /// Metadata contains full backend detail for this field family.
    Full = 1,
    /// Metadata contains partial backend detail with normalized defaults.
    Partial = 2,
    /// Metadata contains minimal count-derived placeholders only.
    Minimal = 3,
}

/// Input axis capability entry.
export struct InputAxisMetadata {
    /// Backend-native axis code.
    code: uint32;
    /// Minimum normalized axis value.
    minimum: float64;
    /// Maximum normalized axis value.
    maximum: float64;
    /// Neutral deadzone width when reported by backend.
    flat: float64;
    /// Noise threshold when reported by backend.
    fuzz: float64;
    /// Unit resolution when reported by backend.
    resolution: float64;
}

/// Input button capability entry.
export struct InputButtonMetadata {
    /// Backend-native button code.
    code: uint32;
    /// Whether this button reports analog values.
    analog: boolean;
}

/// Full input device capability descriptor.
export struct InputDeviceCapabilities {
    /// High-level capability categories for the device.
    kinds: Array<InputDeviceCapabilityKind>;
    /// Axis capability entries when reported by backend.
    axes: Array<InputAxisMetadata>;
    /// Button capability entries when reported by backend.
    buttons: Array<InputButtonMetadata>;
    /// Aggregate metadata origin for this capability snapshot.
    metadataOrigin: InputCapabilityMetadataOrigin;
    /// Aggregate axis metadata fidelity for this capability snapshot.
    axisMetadataFidelity: InputCapabilityMetadataFidelity;
    /// Aggregate button metadata fidelity for this capability snapshot.
    buttonMetadataFidelity: InputCapabilityMetadataFidelity;
    /// Whether relative-pointer mode can be enabled.
    supportsRelativePointer: boolean;
    /// Whether pointer confinement or locking is supported.
    supportsPointerGrab: boolean;
    /// Whether pointer capture outside one window is supported.
    supportsPointerCapture: boolean;
    /// Whether pointer warping is supported.
    supportsPointerWarp: boolean;
    /// Whether text input activation is supported.
    supportsTextInput: boolean;
    /// Whether composition events are supported.
    supportsComposition: boolean;
    /// Whether edit-intent events are supported.
    supportsEditIntents: boolean;
    /// Whether whole-device rumble is supported.
    supportsRumble: boolean;
    /// Whether trigger rumble is supported.
    supportsTriggerRumble: boolean;
    /// Whether device-side sensors are supported.
    supportsSensors: boolean;
    /// Whether gamepad or controller battery state is supported.
    supportsBatteryState: boolean;
    /// Whether controller or device light-control output is supported.
    supportsLightControl: boolean;
    /// Whether raw-hid reports are supported.
    supportsRawHid: boolean;
    /// Whether player-index assignment is supported.
    supportsPlayerIndex: boolean;
    /// Whether pointer-event coalescing metadata is supported.
    supportsPointerCoalescing: boolean;
    /// Whether predicted pointer updates are supported.
    supportsPointerPrediction: boolean;
    /// Whether stylus hover distance is supported.
    supportsPenHoverDistance: boolean;
    /// Whether stylus azimuth and altitude angles are supported.
    supportsPenOrientationAngles: boolean;
}

/// Input device bindings.
/// List available input devices.
///
/// Enumerate host input devices and return stable identifiers and typed device metadata.
/// Device ordering and hotplug visibility follow host input subsystem semantics.
///
/// # Platform
/// Unix and Windows.
/// Returns operation-level `notSupported` on hosts that do not expose one discoverable input backend.
/// Uses evdev device-node enumeration on Linux.
/// Uses global-session and terminal discovery on macOS.
/// Uses terminal input discovery on other Unix hosts.
/// Uses console and raw-state discovery on Windows.
///
/// # Errors
/// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.device.list", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function list(): Result<Slice<InputDeviceDescriptor>, PlatformError>;

/// Open one input device.
///
/// Open one input device endpoint for event reads and optional control operations.
/// Exclusive-grab behavior and permission checks are host-defined.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one openable input backend.
/// Uses evdev device-node open on Linux.
/// Uses global-session or terminal-device open on macOS.
/// Uses terminal-device open on other Unix hosts.
/// Uses duplicated console-input handles or raw-state handles on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.device.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function open(id: string): Result<InputDeviceHandle, PlatformError>;

/// Close one input device.
///
/// Close one opened input device endpoint and release host resources.
/// Pending unread events are discarded according to host backend behavior.
///
/// # Platform
/// Unix and Windows.
/// Uses close(2) on Unix and CloseHandle on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.device.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function close(handle: InputDeviceHandle): Result<void, PlatformError>;

/// Query capabilities for one opened input device.
///
/// Return detailed axis, button, and feature capability metadata for one opened device.
/// Metadata values are backend-derived and may be partially unavailable.
///
/// # Platform
/// Unix and Windows.
/// Uses evdev and libinput-style capability tables on Linux.
/// Uses HID and raw-input capability queries on Windows.
/// Uses backend capability tables when available.
/// Falls back to deriving capabilities from available device summary metadata.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.device.capabilities", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function capabilities(
    handle: InputDeviceHandle,
): Result<InputDeviceCapabilities, PlatformError>;
