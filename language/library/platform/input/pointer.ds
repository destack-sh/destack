import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";
import { InputModifierState } from "./keyboard.ds";
import { InputWindowTarget } from "./target.ds";

/// Pointer device family.
export enum InputPointerType {
    /// Mouse-style pointer.
    Mouse = 1,
    /// Pen or stylus pointer.
    Pen = 2,
    /// Touch contact pointer.
    Touch = 3,
    /// Unknown pointer family.
    Unknown = 255,
}

/// Pen tool kind.
export enum InputPenToolKind {
    /// Standard stylus or pencil tip.
    Stylus = 1,
    /// Eraser tip or backend eraser tool mode.
    Eraser = 2,
    /// Unknown pen tool mode.
    Unknown = 255,
}

/// Pointer coordinate space.
export enum InputCoordinateSpace {
    /// Window-local logical coordinates.
    WindowLogical = 1,
    /// Window-local physical pixel coordinates.
    WindowPhysical = 2,
    /// Global desktop logical coordinates.
    GlobalLogical = 3,
    /// Global desktop physical pixel coordinates.
    GlobalPhysical = 4,
    /// Relative motion delta coordinates.
    Relative = 5,
}

/// Scroll delta unit.
export enum InputWheelDeltaMode {
    /// Pixel deltas.
    Pixel = 1,
    /// Line deltas.
    Line = 2,
    /// Page deltas.
    Page = 3,
}

/// Pointer contact geometry.
export struct InputPointerContactGeometry {
    /// Contact width in the reported coordinate space.
    width: float64;
    /// Contact height in the reported coordinate space.
    height: float64;
}

/// Pen-specific pointer state.
export struct InputPenState {
    /// Pen tool kind.
    toolKind: InputPenToolKind;
    /// Pen pressure in the normalized range [0, 1] when available.
    pressure: float64;
    /// Pen tangential pressure in the normalized range [-1, 1] when available.
    tangentialPressure: float64;
    /// Pen tilt around x axis in degrees when available.
    tiltX: float64;
    /// Pen tilt around y axis in degrees when available.
    tiltY: float64;
    /// Pen altitude angle in radians when available.
    altitudeAngleRadians: float64 | void;
    /// Pen azimuth angle in radians when available.
    azimuthAngleRadians: float64 | void;
    /// Hover distance from the surface when available.
    hoverDistance: float64 | void;
    /// Pen barrel rotation in degrees when available.
    twist: float64;
    /// Whether the pen tip is currently in contact with the surface.
    inContact: boolean;
    /// Whether the pen is currently in proximity range.
    inRange: boolean;
}

/// One pointer motion sample.
export struct InputPointerMotionSample {
    /// Coordinate space for the reported position.
    coordinateSpace: InputCoordinateSpace;
    /// Absolute x coordinate when available.
    positionX: float64;
    /// Absolute y coordinate when available.
    positionY: float64;
    /// Relative x delta when available.
    deltaX: float64;
    /// Relative y delta when available.
    deltaY: float64;
    /// Contact geometry for this sample when available.
    contact: InputPointerContactGeometry | void;
    /// Pen-specific state for this sample when available.
    pen: InputPenState | void;
    /// Monotonic sample timestamp in nanoseconds.
    timestampNs: uint64;
}

/// Pointer state snapshot.
export struct InputPointerState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Stable pointer identifier for this active pointer.
    pointerId: uint64;
    /// Pointer device family.
    pointerType: InputPointerType;
    /// Whether this is the primary pointer for its type.
    isPrimary: boolean;
    /// Position coordinate space.
    coordinateSpace: InputCoordinateSpace;
    /// Pointer x position.
    x: float64;
    /// Pointer y position.
    y: float64;
    /// Relative x delta since the previous snapshot when available.
    deltaX: float64;
    /// Relative y delta since the previous snapshot when available.
    deltaY: float64;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
    /// Pen-specific state when available.
    pen: InputPenState | void;
    /// Contact geometry when available.
    contact: InputPointerContactGeometry | void;
}

/// Pointer grab mode.
export enum InputPointerGrabMode {
    /// Do not grab the pointer.
    None = 0,
    /// Constrain pointer movement to the active window bounds.
    Confined = 1,
    /// Lock pointer movement and report relative deltas.
    Locked = 2,
}

/// Input pointer bindings.
/// Read one absolute pointer state snapshot.
///
/// Return one current pointer position and button state snapshot for one opened pointer-capable device.
/// Position values follow the coordinate space reported in the snapshot.
///
/// # Platform
/// Unix and Windows.
/// Uses backend-specific pointer state queries from evdev or libinput-style streams on Unix.
/// Uses raw-input or console pointer state snapshots on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.state", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function pointerState(
    handle: InputDeviceHandle,
): Result<InputPointerState, PlatformError>;

/// Read one relative pointer state snapshot.
///
/// Return one relative motion and button state snapshot for one opened pointer-capable device.
/// Relative mode must be enabled before this lane becomes readable.
///
/// # Platform
/// Unix and Windows.
/// Uses backend pointer snapshots plus runtime-managed relative baselines.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `input.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.relativeState", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.read"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function pointerRelativeState(
    handle: InputDeviceHandle,
): Result<InputPointerState, PlatformError>;

/// Enable or disable relative pointer mode.
///
/// Toggle relative pointer mode for one opened pointer-capable device.
/// Relative mode semantics follow backend pointer-lock behavior.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` where relative mode is unavailable.
/// Uses backend-specific relative mode toggles for active input endpoints.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `input.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.setRelativeMode", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.control"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function pointerSetRelativeMode(
    handle: InputDeviceHandle,
    enabled: boolean,
): Result<void, PlatformError>;

/// Set pointer grab mode.
///
/// Apply one grab mode for one opened pointer-capable device and one optional window target.
/// Grab modes can confine or lock pointer movement depending on backend support and target scope.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` where one grab mode or one window scope is unavailable.
/// Uses backend-specific pointer grab or lock primitives for global or window-scoped paths.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `input.grab`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.setGrabMode", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.grab"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function pointerSetGrabMode(
    handle: InputDeviceHandle,
    target: InputWindowTarget,
    mode: InputPointerGrabMode,
): Result<void, PlatformError>;

/// Enable or disable pointer capture.
///
/// Toggle pointer capture for one opened pointer-capable device and one optional window target.
/// Captured pointers can continue delivering events outside focused bounds when supported for that target scope.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` where capture or one window scope is unavailable.
/// Uses backend-specific pointer capture primitives for global or window-scoped paths.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `input.grab`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.capture", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.grab"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function pointerCapture(
    handle: InputDeviceHandle,
    target: InputWindowTarget,
    enabled: boolean,
): Result<void, PlatformError>;

/// Warp pointer position.
///
/// Set one pointer position for one opened pointer-capable device and one optional window target.
/// Warped coordinates are interpreted in backend-native window or surface space for the selected target scope.
///
/// # Platform
/// Unix and Windows, with operation-level `notSupported` where pointer warping or one window scope is unavailable.
/// Uses backend-specific pointer warp operations for global or window-scoped paths.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `input.control`.
///
/// # Replay
/// External, recordable.
@binding("destack.input.pointer.warp", {
    effect: "external",
    replay: "recordable",
    capabilities: ["input.control"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function pointerWarp(
    handle: InputDeviceHandle,
    target: InputWindowTarget,
    x: float64,
    y: float64,
): Result<void, PlatformError>;
