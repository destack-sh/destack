import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { Path } from "destack:platform/fs";

/// Clipboard item representation kind.
export enum ClipboardItemRepresentationKind {
    /// One textual representation.
    String = 1,
    /// One filesystem representation.
    File = 2,
    /// One arbitrary binary representation.
    Binary = 3,
}

/// Clipboard presentation style.
export enum ClipboardPresentationStyle {
    /// No presentation preference is declared.
    Unspecified = 0,
    /// The item prefers inline presentation.
    Inline = 1,
    /// The item prefers attachment presentation.
    Attachment = 2,
}

/// One clipboard item representation descriptor.
export struct ClipboardItemRepresentationDescriptor {
    /// MIME type or platform-native format identifier.
    mimeType: string;
    /// Representation kind.
    kind: ClipboardItemRepresentationKind;
    /// Suggested representation name when available.
    name: string | void;
    /// Whether one filesystem representation refers to one directory.
    isDirectory: boolean;
    /// Representation length in bytes when available.
    byteLength: uint64 | void;
}

/// One clipboard item descriptor.
export struct ClipboardItemDescriptor {
    /// Item presentation style.
    presentationStyle: ClipboardPresentationStyle;
    /// Item representations in provider order.
    representations: Slice<ClipboardItemRepresentationDescriptor>;
}

/// One clipboard item representation payload.
export struct ClipboardItemRepresentation {
    /// MIME type or platform-native format identifier.
    mimeType: string;
    /// Representation kind.
    kind: ClipboardItemRepresentationKind;
    /// Suggested representation name when available.
    name: string | void;
    /// Text payload for string representations.
    text: string | void;
    /// Filesystem payload for file representations.
    path: Path | void;
    /// Binary payload for binary representations.
    bytes: Slice<uint8> | void;
}

/// One clipboard item payload.
export struct ClipboardItem {
    /// Item presentation style.
    presentationStyle: ClipboardPresentationStyle;
    /// Item representations in provider order.
    representations: Slice<ClipboardItemRepresentation>;
}

/// Query whether text clipboard payload exists.
@binding("destack.input.clipboard.hasText", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardHasText(): Result<boolean, PlatformError>;

/// List clipboard items.
@binding("destack.input.clipboard.listItems", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardListItems(): Result<Slice<ClipboardItemDescriptor>, PlatformError>;

/// Read one text clipboard payload.
@binding("destack.input.clipboard.readText", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardReadText(): Result<string, PlatformError>;

/// Read one text clipboard item representation.
@binding("destack.input.clipboard.readItemText", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardReadItemText(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<string, PlatformError>;

/// Read one binary clipboard item representation.
@binding("destack.input.clipboard.readItemBytes", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardReadItemBytes(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<Slice<uint8>, PlatformError>;

/// Read one filesystem clipboard item representation.
@binding("destack.input.clipboard.readItemPath", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardReadItemPath(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<Path, PlatformError>;

/// Write one text clipboard payload.
@binding("destack.input.clipboard.writeText", {
    effect: "external",
    replay: "forbidden",
    requires: ["input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardWriteText(text: string): Result<void, PlatformError>;

/// Write clipboard items.
@binding("destack.input.clipboard.writeItems", {
    effect: "external",
    replay: "forbidden",
    requires: ["input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardWriteItems(items: Slice<ClipboardItem>): Result<void, PlatformError>;

/// Read clipboard sequence number.
@binding("destack.input.clipboard.sequence", {
    effect: "external",
    requires: ["input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardSequence(): Result<uint64, PlatformError>;

/// Clear clipboard payload.
@binding("destack.input.clipboard.clear", {
    effect: "external",
    replay: "forbidden",
    requires: ["input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clipboardClear(): Result<void, PlatformError>;
