import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { InputDeviceHandle } from "destack:platform/resource";

/// Haptic effect type.
export enum InputHapticEffectType {
    /// Whole-device dual-rumble effect.
    DualRumble = 1,
    /// Trigger-localized rumble effect.
    TriggerRumble = 2,
}

/// Haptic playback result.
export enum InputHapticsResult {
    /// Playback request completed.
    Complete = 1,
    /// Playback request was preempted by one newer request.
    Preempted = 2,
}

/// Haptic effect parameters.
export struct InputHapticEffectParameters {
    /// Effect duration in milliseconds.
    durationMs: uint64;
    /// Effect start delay in milliseconds.
    startDelayMs: uint64;
    /// Low-frequency or strong-motor magnitude in the range [0, 1].
    strongMagnitude: float64;
    /// High-frequency or weak-motor magnitude in the range [0, 1].
    weakMagnitude: float64;
    /// Left trigger rumble magnitude in the range [0, 1].
    leftTrigger: float64;
    /// Right trigger rumble magnitude in the range [0, 1].
    rightTrigger: float64;
}

/// List supported haptic effects.
@binding("destack.input.haptics.effects", {
    effect: "external",
    requires: ["input.haptics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function hapticsEffects(
    handle: InputDeviceHandle,
): Result<Array<InputHapticEffectType>, PlatformError>;

/// Play one haptic effect.
@binding("destack.input.haptics.play", {
    effect: "external",
    requires: ["input.haptics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function hapticsPlay(
    handle: InputDeviceHandle,
    effect: InputHapticEffectType,
    parameters: InputHapticEffectParameters,
): Result<InputHapticsResult, PlatformError>;

/// Stop active haptic effects.
@binding("destack.input.haptics.stop", {
    effect: "external",
    requires: ["input.haptics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function hapticsStop(handle: InputDeviceHandle): Result<void, PlatformError>;
