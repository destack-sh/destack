import { Array, Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { InputDeviceHandle, InputMonitorHandle, WindowHandle } from "destack:platform/resource";
import { InputDeviceKind } from "./device.ds";
import { InputKeyLocation, InputModifierState } from "./keyboard.ds";
import {
    InputCoordinateSpace,
    InputPointerMotionSample,
    InputPenState,
    InputPointerContactGeometry,
    InputPointerType,
    InputWheelDeltaMode,
} from "./pointer.ds";

/// Input event action.
export enum InputEventAction {
    /// One input control became active.
    Press = 1,
    /// One input control became inactive.
    Release = 2,
    /// One input control repeated while held.
    Repeat = 3,
    /// One continuous control moved.
    Move = 4,
    /// One scroll axis changed.
    Scroll = 5,
    /// One analog axis changed.
    Axis = 6,
    /// One text payload was emitted.
    Text = 7,
    /// One source became available.
    Connect = 8,
    /// One source became unavailable.
    Disconnect = 9,
    /// One active gesture or contact was canceled.
    Cancel = 10,
    /// One composite operation started.
    Begin = 11,
    /// One composite operation updated.
    Update = 12,
    /// One composite operation committed.
    Commit = 13,
    /// One composite operation ended.
    End = 14,
}

/// Input read mode.
export enum InputReadMode {
    /// Read translated events where the host backend applies keymap and composition behavior when applicable.
    Cooked = 1,
    /// Read raw hardware-style events where available.
    Raw = 2,
}

/// Gamepad control kind.
export enum InputGamepadControlKind {
    /// One gamepad button.
    Button = 1,
    /// One gamepad axis.
    Axis = 2,
    /// One gamepad touch contact.
    Touch = 3,
}

/// Key event payload.
export struct InputKeyEventPayload {
    /// Key action.
    action: InputEventAction;
    /// Normalized logical key value when available.
    key: string | void;
    /// Normalized physical code value when available.
    code: string | void;
    /// Physical key location.
    location: InputKeyLocation;
    /// Backend-native key code.
    backendCode: uint32;
    /// Backend-native scan code when available.
    backendScanCode: uint32;
    /// Backend-native key value.
    backendValue: int64;
    /// Backend modifier bitset.
    backendModifiers: uint32;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
    /// Whether this key event is a repeat.
    repeat: boolean;
    /// Whether this key event belongs to one active composition session.
    isComposing: boolean;
}

/// Pointer motion event payload.
export struct InputPointerMotionEventPayload {
    /// Stable pointer identifier.
    pointerId: uint64;
    /// Pointer device family.
    pointerType: InputPointerType;
    /// Whether this is the primary pointer for its type.
    isPrimary: boolean;
    /// Coordinate space for the reported position.
    coordinateSpace: InputCoordinateSpace;
    /// Absolute x coordinate when available.
    positionX: float64;
    /// Absolute y coordinate when available.
    positionY: float64;
    /// Relative x delta when available.
    deltaX: float64;
    /// Relative y delta when available.
    deltaY: float64;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Backend button bitset.
    backendButtons: uint32;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
    /// Contact geometry when available.
    contact: InputPointerContactGeometry | void;
    /// Pen-specific state when available.
    pen: InputPenState | void;
    /// Coalesced motion samples represented by this update.
    coalescedSamples: Slice<InputPointerMotionSample>;
    /// Predicted motion samples when the backend exposes them.
    predictedSamples: Slice<InputPointerMotionSample>;
}

/// Pointer button event payload.
export struct InputPointerButtonEventPayload {
    /// Button action.
    action: InputEventAction;
    /// Stable pointer identifier.
    pointerId: uint64;
    /// Pointer device family.
    pointerType: InputPointerType;
    /// Whether this is the primary pointer for its type.
    isPrimary: boolean;
    /// Canonical button index when available.
    button: int16;
    /// Canonical pressed-button bitset after this event.
    buttons: uint32;
    /// Backend-native button code.
    backendCode: uint32;
    /// Backend-native button value.
    backendValue: int64;
    /// Pointer x coordinate.
    positionX: float64;
    /// Pointer y coordinate.
    positionY: float64;
    /// Coordinate space for the reported position.
    coordinateSpace: InputCoordinateSpace;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
    /// Contact geometry when available.
    contact: InputPointerContactGeometry | void;
    /// Pen-specific state when available.
    pen: InputPenState | void;
}

/// Scroll event payload.
export struct InputScrollEventPayload {
    /// Stable pointer identifier when available.
    pointerId: uint64 | void;
    /// Pointer device family when available.
    pointerType: InputPointerType | void;
    /// Scroll delta unit.
    deltaMode: InputWheelDeltaMode;
    /// Horizontal wheel delta.
    deltaX: float64;
    /// Vertical wheel delta.
    deltaY: float64;
    /// Pointer x coordinate.
    positionX: float64;
    /// Pointer y coordinate.
    positionY: float64;
    /// Coordinate space for the reported position.
    coordinateSpace: InputCoordinateSpace;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Normalized modifier and lock state.
    modifierState: InputModifierState;
}

/// Touch event payload.
export struct InputTouchEventPayload {
    /// Touch action.
    action: InputEventAction;
    /// Stable pointer identifier for this contact.
    pointerId: uint64;
    /// Whether this is the primary touch contact.
    isPrimary: boolean;
    /// Contact x coordinate.
    positionX: float64;
    /// Contact y coordinate.
    positionY: float64;
    /// Coordinate space for the reported position.
    coordinateSpace: InputCoordinateSpace;
    /// Contact pressure when available.
    pressure: float64;
    /// Contact geometry when available.
    contact: InputPointerContactGeometry | void;
    /// Contact tilt around x axis in degrees when available.
    tiltX: float64;
    /// Contact tilt around y axis in degrees when available.
    tiltY: float64;
    /// Contact twist in degrees when available.
    twist: float64;
}

/// Gamepad event payload.
export struct InputGamepadEventPayload {
    /// Gamepad action.
    action: InputEventAction;
    /// Control kind.
    controlKind: InputGamepadControlKind;
    /// Canonical control index when available.
    controlIndex: uint32;
    /// Backend-native control code.
    backendCode: uint32;
    /// Backend-native control value.
    backendValue: int64;
    /// Normalized control value.
    value: float64;
    /// Whether the control is pressed after this event when applicable.
    pressed: boolean;
    /// Whether the control is touched after this event when applicable.
    touched: boolean;
}

/// Text event payload.
export struct InputTextEventPayload {
    /// UTF-8 text payload.
    text: string;
    /// Whether this text emission belongs to one active composition session.
    isComposing: boolean;
}

/// Device event payload.
export struct InputDeviceEventPayload {
    /// Device action.
    action: InputEventAction;
    /// Backend-native device code.
    backendCode: uint32;
    /// Backend-native device value.
    backendValue: int64;
}

/// Sensor event payload.
export struct InputSensorEventPayload {
    /// Sensor action.
    action: InputEventAction;
    /// Backend-native sensor code.
    backendCode: uint32;
    /// Backend-native sensor value.
    backendValue: int64;
    /// Sensor x component when available.
    x: float64;
    /// Sensor y component when available.
    y: float64;
    /// Sensor z component when available.
    z: float64;
    /// Sensor w component when available.
    w: float64;
}

/// Composition event payload.
export struct InputCompositionEventPayload {
    /// Composition action.
    action: InputEventAction;
    /// UTF-8 composition text.
    text: string;
    /// Selection start offset when available.
    selectionStart: int32;
    /// Selection end offset when available.
    selectionEnd: int32;
}

/// Shared metadata for all input events.
export struct InputEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Target window when this input event is routed to one concrete window.
    targetWindow: WindowHandle | void;
}

/// Key input event.
export struct InputKeyEvent {
    /// Discriminator for this input event variant.
    kind: "key";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Key payload.
    payload: InputKeyEventPayload;
}

/// Pointer-motion input event.
export struct InputPointerMotionEvent {
    /// Discriminator for this input event variant.
    kind: "pointerMotion";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Pointer-motion payload.
    payload: InputPointerMotionEventPayload;
}

/// Pointer-button input event.
export struct InputPointerButtonEvent {
    /// Discriminator for this input event variant.
    kind: "pointerButton";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Pointer-button payload.
    payload: InputPointerButtonEventPayload;
}

/// Scroll input event.
export struct InputScrollEvent {
    /// Discriminator for this input event variant.
    kind: "scroll";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Scroll payload.
    payload: InputScrollEventPayload;
}

/// Touch input event.
export struct InputTouchEvent {
    /// Discriminator for this input event variant.
    kind: "touch";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Touch payload.
    payload: InputTouchEventPayload;
}

/// Gamepad input event.
export struct InputGamepadEvent {
    /// Discriminator for this input event variant.
    kind: "gamepad";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Gamepad payload.
    payload: InputGamepadEventPayload;
}

/// Text input event.
export struct InputTextEvent {
    /// Discriminator for this input event variant.
    kind: "text";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Text payload.
    payload: InputTextEventPayload;
}

/// Device input event.
export struct InputDeviceEvent {
    /// Discriminator for this input event variant.
    kind: "device";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Device payload.
    payload: InputDeviceEventPayload;
}

/// Sensor input event.
export struct InputSensorEvent {
    /// Discriminator for this input event variant.
    kind: "sensor";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Sensor payload.
    payload: InputSensorEventPayload;
}

/// Composition input event.
export struct InputCompositionEvent {
    /// Discriminator for this input event variant.
    kind: "composition";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Composition payload.
    payload: InputCompositionEventPayload;
}

/// Input event payload.
export newtype InputEvent =
    | InputKeyEvent
    | InputPointerMotionEvent
    | InputPointerButtonEvent
    | InputScrollEvent
    | InputTouchEvent
    | InputGamepadEvent
    | InputTextEvent
    | InputDeviceEvent
    | InputSensorEvent
    | InputCompositionEvent;

/// Shared metadata for all monitor events.
export struct InputMonitorEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the monitor stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Stable source instance identifier when available.
    instanceId: string | void;
    /// Device kind when available.
    deviceKind: InputDeviceKind;
    /// Whether the device is connected after this event.
    connected: boolean;
}

/// Device-connected monitor event.
export struct InputMonitorConnectEvent {
    /// Discriminator for this input monitor event variant.
    kind: "connect";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device-disconnected monitor event.
export struct InputMonitorDisconnectEvent {
    /// Discriminator for this input monitor event variant.
    kind: "disconnect";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device-changed monitor event.
export struct InputMonitorChangeEvent {
    /// Discriminator for this input monitor event variant.
    kind: "change";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device monitor event payload.
export newtype InputMonitorEvent =
    | InputMonitorConnectEvent
    | InputMonitorDisconnectEvent
    | InputMonitorChangeEvent;

/// Open one global input event monitor.
@binding("destack.input.event.monitorOpen", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function monitorOpen(): Result<InputMonitorHandle, PlatformError>;

/// Close one global input event monitor.
@binding("destack.input.event.monitorClose", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function monitorClose(handle: InputMonitorHandle): Result<void, PlatformError>;

/// Read one global input monitor event.
@binding("destack.input.event.monitorRead", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function monitorRead(
    handle: InputMonitorHandle,
): Result<InputMonitorEvent, PlatformError>;

/// Poll one global input monitor event without blocking.
@binding("destack.input.event.monitorTryRead", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function monitorTryRead(
    handle: InputMonitorHandle,
): Result<InputMonitorEvent, PlatformError>;

/// Read one input event.
@binding("destack.input.event.read", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function read(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

/// Poll one input event without blocking.
@binding("destack.input.event.tryRead", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function tryRead(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

/// Read one batch of input events.
@binding("destack.input.event.readBatch", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readBatch(
    handle: InputDeviceHandle,
    maxEvents: uint32,
): Result<Array<InputEvent>, PlatformError>;

/// Enable or disable exclusive device grab.
@binding("destack.input.event.setExclusiveGrab", {
    effect: "external",
    requires: ["input.grab"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setExclusiveGrab(
    handle: InputDeviceHandle,
    enable: boolean,
): Result<void, PlatformError>;

/// Select event decoding mode for one input stream.
@binding("destack.input.event.setReadMode", {
    effect: "external",
    requires: ["input.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setReadMode(
    handle: InputDeviceHandle,
    mode: InputReadMode,
): Result<void, PlatformError>;
