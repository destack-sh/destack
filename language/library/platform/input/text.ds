import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { DisplayDragTransfer } from "destack:platform/display";
import { ClipboardItemDescriptor } from "./clipboard.ds";
import { InputCompositionEvent, InputEventMetadata } from "./event.ds";
import { InputTextSessionHandle } from "destack:platform/resource";
import { InputWindowTarget } from "./target.ds";

/// Text input type hint.
export enum InputTextInputType {
    /// General free-form text.
    Text = 0,
    /// Numeric text input.
    Number = 1,
    /// Email text input.
    Email = 2,
    /// URL text input.
    Url = 3,
    /// Password text input.
    Password = 4,
    /// Phone number text input.
    Phone = 5,
    /// Search text input.
    Search = 6,
}

/// Text offset range in UTF-16 code units.
export struct InputTextRange {
    /// Inclusive start offset.
    startOffset: uint32;
    /// Exclusive end offset.
    endOffset: uint32;
}

/// Text input rectangle in local logical units.
export struct InputTextRectangle {
    /// Rectangle left coordinate.
    x: float64;
    /// Rectangle top coordinate.
    y: float64;
    /// Rectangle width.
    width: float64;
    /// Rectangle height.
    height: float64;
}

/// Text input affine transform into target-local coordinates.
export struct InputTextTransform2D {
    /// Matrix first-row X coefficient.
    xx: float64;
    /// Matrix first-row Y coefficient.
    xy: float64;
    /// Matrix second-row X coefficient.
    yx: float64;
    /// Matrix second-row Y coefficient.
    yy: float64;
    /// Translation X component.
    tx: float64;
    /// Translation Y component.
    ty: float64;
}

/// Text input geometry hints.
export struct InputTextGeometry {
    /// Transform from local editor geometry into target-local coordinates.
    localToTargetTransform: InputTextTransform2D;
    /// Full editor rectangle in local logical units.
    editorRectangle: InputTextRectangle;
    /// Caret rectangle in local logical units when one focused insertion point is known.
    caretRectangle: InputTextRectangle | void;
    /// Composing rectangle in local logical units when one active composition span is known.
    composingRectangle: InputTextRectangle | void;
}

/// Text input session configuration.
export struct InputTextSessionConfig {
    /// Window target when one explicit host window scope is required.
    target: InputWindowTarget;
    /// Text input type hint.
    inputType: InputTextInputType;
    /// Whether the session is multiline.
    isMultiline: boolean;
    /// Whether the session is secure or password-like.
    isSecure: boolean;
}

/// Text input session state.
export struct InputTextSessionState {
    /// Full text state.
    text: string;
    /// Current selection range in UTF-16 code units.
    selection: InputTextRange;
    /// Current composing range in UTF-16 code units when one composition is active.
    composing: InputTextRange | void;
}

/// Edit intent kind aligned with web `beforeinput` input types.
export enum InputEditIntentType {
    /// `insertText`.
    InsertText = 1,
    /// `insertReplacementText`.
    InsertReplacementText = 2,
    /// `insertLineBreak`.
    InsertLineBreak = 3,
    /// `insertParagraph`.
    InsertParagraph = 4,
    /// `insertOrderedList`.
    InsertOrderedList = 5,
    /// `insertUnorderedList`.
    InsertUnorderedList = 6,
    /// `insertHorizontalRule`.
    InsertHorizontalRule = 7,
    /// `insertLink`.
    InsertLink = 8,
    /// `insertFromYank`.
    InsertFromYank = 9,
    /// `insertFromDrop`.
    InsertFromDrop = 10,
    /// `insertFromPaste`.
    InsertFromPaste = 11,
    /// `insertFromPasteAsQuotation`.
    InsertFromPasteAsQuotation = 12,
    /// `insertTranspose`.
    InsertTranspose = 13,
    /// `insertCompositionText`.
    InsertCompositionText = 14,
    /// `deleteWordBackward`.
    DeleteWordBackward = 15,
    /// `deleteWordForward`.
    DeleteWordForward = 16,
    /// `deleteSoftLineBackward`.
    DeleteSoftLineBackward = 17,
    /// `deleteSoftLineForward`.
    DeleteSoftLineForward = 18,
    /// `deleteEntireSoftLine`.
    DeleteEntireSoftLine = 19,
    /// `deleteHardLineBackward`.
    DeleteHardLineBackward = 20,
    /// `deleteHardLineForward`.
    DeleteHardLineForward = 21,
    /// `deleteByDrag`.
    DeleteByDrag = 22,
    /// `deleteByCut`.
    DeleteByCut = 23,
    /// `deleteContent`.
    DeleteContent = 24,
    /// `deleteContentBackward`.
    DeleteContentBackward = 25,
    /// `deleteContentForward`.
    DeleteContentForward = 26,
    /// `historyUndo`.
    HistoryUndo = 27,
    /// `historyRedo`.
    HistoryRedo = 28,
    /// `formatBold`.
    FormatBold = 29,
    /// `formatItalic`.
    FormatItalic = 30,
    /// `formatUnderline`.
    FormatUnderline = 31,
    /// `formatStrikeThrough`.
    FormatStrikeThrough = 32,
    /// `formatSuperscript`.
    FormatSuperscript = 33,
    /// `formatSubscript`.
    FormatSubscript = 34,
    /// `formatJustifyCenter`.
    FormatJustifyCenter = 35,
    /// `formatJustifyFull`.
    FormatJustifyFull = 36,
    /// `formatJustifyLeft`.
    FormatJustifyLeft = 37,
    /// `formatJustifyRight`.
    FormatJustifyRight = 38,
    /// `formatIndent`.
    FormatIndent = 39,
    /// `formatOutdent`.
    FormatOutdent = 40,
    /// `formatRemove`.
    FormatRemove = 41,
    /// `formatSetBlockTextDirection`.
    FormatSetBlockTextDirection = 42,
    /// `formatSetInlineTextDirection`.
    FormatSetInlineTextDirection = 43,
    /// `formatBackColor`.
    FormatBackColor = 44,
    /// `formatFontColor`.
    FormatFontColor = 45,
    /// `formatFontName`.
    FormatFontName = 46,
}

/// One edit intent event.
export struct InputEditIntentEvent {
    /// Discriminator for this text event variant.
    kind: "editIntent";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Edit intent kind.
    inputType: InputEditIntentType;
    /// Text payload when the edit intent carries one direct string.
    data: string | void;
    /// Target text ranges in source order when the backend exposes them.
    targetRanges: Slice<InputTextRange>;
    /// Clipboard item descriptors when this edit intent originated from paste or yank.
    clipboardItems: Slice<ClipboardItemDescriptor> | void;
    /// Drag transfer metadata when this edit intent originated from a drop session.
    drag: DisplayDragTransfer | void;
    /// Whether this edit intent belongs to one active composition session.
    isComposing: boolean;
}

/// Clipboard command kind aligned with web clipboard and editing events.
export enum InputClipboardCommandType {
    /// Copy the current selection.
    Copy = 1,
    /// Cut the current selection.
    Cut = 2,
    /// Paste from the clipboard.
    Paste = 3,
}

/// One clipboard command event.
export struct InputClipboardCommandEvent {
    /// Discriminator for this text event variant.
    kind: "clipboardCommand";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Clipboard command kind.
    command: InputClipboardCommandType;
    /// Clipboard item descriptors when the command carries readable clipboard data.
    clipboardItems: Slice<ClipboardItemDescriptor> | void;
    /// Whether this command belongs to one active composition session.
    isComposing: boolean;
}

/// One text-session state event.
export struct InputTextSessionStateEvent {
    /// Discriminator for this text event variant.
    kind: "stateChanged";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// The current host text state.
    state: InputTextSessionState;
}

/// One text-session event.
export newtype InputTextSessionEvent =
    | InputTextSessionStateEvent
    | InputCompositionEvent
    | InputEditIntentEvent
    | InputClipboardCommandEvent;

/// Open one text input session.
@binding("destack.input.text.open", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textOpen(
    config: InputTextSessionConfig,
    state: InputTextSessionState,
): Result<InputTextSessionHandle, PlatformError>;

/// Close one text input session.
@binding("destack.input.text.close", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textClose(session: InputTextSessionHandle): Result<void, PlatformError>;

/// Set text input geometry.
@binding("destack.input.text.setGeometry", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textSetGeometry(
    session: InputTextSessionHandle,
    geometry: InputTextGeometry,
): Result<void, PlatformError>;

/// Get text input geometry.
@binding("destack.input.text.getGeometry", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textGetGeometry(
    session: InputTextSessionHandle,
): Result<InputTextGeometry, PlatformError>;

/// Set text input state.
@binding("destack.input.text.setState", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textSetState(
    session: InputTextSessionHandle,
    state: InputTextSessionState,
): Result<void, PlatformError>;

/// Read one text-session event.
@binding("destack.input.text.readEvent", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textReadEvent(
    session: InputTextSessionHandle,
): Result<InputTextSessionEvent, PlatformError>;

/// Poll one text-session event without blocking.
@binding("destack.input.text.tryReadEvent", {
    effect: "external",
    requires: ["host.input.text"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textTryReadEvent(
    session: InputTextSessionHandle,
): Result<InputTextSessionEvent, PlatformError>;
