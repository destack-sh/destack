import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";

/// Raw-hid report payload.
export struct InputRawHidReport {
    /// Monotonic report timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Report identifier, zero when the backend report format omits explicit report ids.
    reportId: uint8;
    /// Raw report bytes.
    data: Slice<uint8>;
}

/// Read one raw-hid report.
@binding("destack.input.rawhid.read", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawHidRead(
    handle: InputDeviceHandle,
    maxBytes: uint32,
    timeoutNs: uint64,
): Result<InputRawHidReport, PlatformError>;

/// Poll one raw-hid report without blocking.
@binding("destack.input.rawhid.tryRead", {
    effect: "external",
    requires: ["input.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawHidTryRead(
    handle: InputDeviceHandle,
    maxBytes: uint32,
): Result<InputRawHidReport, PlatformError>;

/// Write one raw-hid output report.
@binding("destack.input.rawhid.write", {
    effect: "external",
    requires: ["input.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawHidWrite(
    handle: InputDeviceHandle,
    reportId: uint8,
    data: Slice<uint8>,
): Result<uint32, PlatformError>;

/// Read one raw-hid feature report.
@binding("destack.input.rawhid.getFeature", {
    effect: "external",
    requires: ["input.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawHidGetFeature(
    handle: InputDeviceHandle,
    reportId: uint8,
    maxBytes: uint32,
): Result<Slice<uint8>, PlatformError>;

/// Write one raw-hid feature report.
@binding("destack.input.rawhid.setFeature", {
    effect: "external",
    requires: ["input.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function rawHidSetFeature(
    handle: InputDeviceHandle,
    reportId: uint8,
    data: Slice<uint8>,
): Result<void, PlatformError>;
