import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import {
    GpuBindGroupHandle,
    GpuBindGroupLayoutHandle,
    GpuBufferHandle,
    GpuDeviceHandle,
    GpuExternalTextureHandle,
    GpuPipelineLayoutHandle,
    GpuSamplerHandle,
    GpuTextureViewHandle,
} from "../resource/index.ds";
import { GpuTextureFormat, GpuTextureViewDimension } from "./resource.ds";

/// Shader stage visibility bitset.
export newtype GpuShaderVisibilityMask = uint32;

/// Shader stage visibility flags.
export enum GpuShaderVisibilityFlag {
    /// No shader visibility.
    None = 0,
    /// Vertex shader visibility.
    Vertex = 1,
    /// Fragment shader visibility.
    Fragment = 2,
    /// Compute shader visibility.
    Compute = 4,
}

/// Buffer binding layout selector.
export enum GpuBufferBindingType {
    /// Uniform buffer binding.
    Uniform = 1,
    /// Storage buffer binding.
    Storage = 2,
    /// Read-only storage buffer binding.
    ReadOnlyStorage = 3,
}

/// Sampler binding layout selector.
export enum GpuSamplerBindingType {
    /// Filtering sampler binding.
    Filtering = 1,
    /// Non-filtering sampler binding.
    NonFiltering = 2,
    /// Comparison sampler binding.
    Comparison = 3,
}

/// Texture sample-type selector.
export enum GpuTextureSampleType {
    /// Filterable floating-point sample type.
    Float = 1,
    /// Non-filterable floating-point sample type.
    UnfilterableFloat = 2,
    /// Depth sample type.
    Depth = 3,
    /// Signed integer sample type.
    Sint = 4,
    /// Unsigned integer sample type.
    Uint = 5,
}

/// Storage-texture access selector.
export enum GpuStorageTextureAccess {
    /// Write-only storage-texture access.
    WriteOnly = 1,
    /// Read-only storage-texture access.
    ReadOnly = 2,
    /// Read-write storage-texture access.
    ReadWrite = 3,
    /// Atomic storage-texture access.
    Atomic = 4,
}

/// Buffer bind group layout resource payload.
export struct GpuBindGroupLayoutBufferResource {
    /// Discriminator for this bind-group-layout resource variant.
    kind: "buffer";
    /// Buffer binding layout selector.
    bindingType: GpuBufferBindingType;
    /// Whether this binding uses dynamic offsets.
    hasDynamicOffset: boolean;
    /// Minimum binding size in bytes when applicable.
    minBindingSize: uint64;
}

/// Sampled-texture bind group layout resource payload.
export struct GpuBindGroupLayoutSampledTextureResource {
    /// Discriminator for this bind-group-layout resource variant.
    kind: "sampledTexture";
    /// Texture sample type selector.
    textureSampleType: GpuTextureSampleType;
    /// Texture view dimension selector.
    textureViewDimension: GpuTextureViewDimension;
    /// Whether multisampled textures are required.
    multisampled: boolean;
}

/// Storage-texture bind group layout resource payload.
export struct GpuBindGroupLayoutStorageTextureResource {
    /// Discriminator for this bind-group-layout resource variant.
    kind: "storageTexture";
    /// Storage-texture access selector.
    storageTextureAccess: GpuStorageTextureAccess;
    /// Storage-texture format identifier.
    storageTextureFormat: GpuTextureFormat;
    /// Texture view dimension selector.
    textureViewDimension: GpuTextureViewDimension;
}

/// Sampler bind group layout resource payload.
export struct GpuBindGroupLayoutSamplerResource {
    /// Discriminator for this bind-group-layout resource variant.
    kind: "sampler";
    /// Sampler binding layout selector.
    samplerBindingType: GpuSamplerBindingType;
}

/// External-texture bind group layout resource payload.
export struct GpuBindGroupLayoutExternalTextureResource {
    /// Discriminator for this bind-group-layout resource variant.
    kind: "externalTexture";
}

/// Bind group layout resource payload.
export newtype GpuBindGroupLayoutResource =
    | GpuBindGroupLayoutBufferResource
    | GpuBindGroupLayoutSampledTextureResource
    | GpuBindGroupLayoutStorageTextureResource
    | GpuBindGroupLayoutSamplerResource
    | GpuBindGroupLayoutExternalTextureResource;

/// Bind group layout entry.
export struct GpuBindGroupLayoutEntry {
    /// Binding index.
    binding: uint32;
    /// Shader stage visibility mask.
    visibility: GpuShaderVisibilityMask;
    /// Binding array length when this entry is array-backed.
    bindingArrayCount: uint32 | void;
    /// Typed resource payload.
    resource: GpuBindGroupLayoutResource;
}

/// Buffer bind group resource payload.
export struct GpuBindGroupBufferResource {
    /// Discriminator for this bind-group resource variant.
    kind: "buffer";
    /// Buffer handle.
    buffer: GpuBufferHandle;
    /// Buffer byte offset.
    offset: uint64;
    /// Buffer byte length.
    size: uint64;
}

/// Texture bind group resource payload.
export struct GpuBindGroupTextureResource {
    /// Discriminator for this bind-group resource variant.
    kind: "texture";
    /// Texture-view handle.
    texture: GpuTextureViewHandle;
}

/// Sampler bind group resource payload.
export struct GpuBindGroupSamplerResource {
    /// Discriminator for this bind-group resource variant.
    kind: "sampler";
    /// Sampler handle.
    sampler: GpuSamplerHandle;
}

/// External-texture bind group resource payload.
export struct GpuBindGroupExternalTextureResource {
    /// Discriminator for this bind-group resource variant.
    kind: "externalTexture";
    /// External-texture handle.
    externalTexture: GpuExternalTextureHandle;
}

/// Bind group resource payload.
export newtype GpuBindGroupResource =
    | GpuBindGroupBufferResource
    | GpuBindGroupTextureResource
    | GpuBindGroupSamplerResource
    | GpuBindGroupExternalTextureResource;

/// Bind group resource entry.
export struct GpuBindGroupEntry {
    /// Binding index.
    binding: uint32;
    /// Binding array element index when this entry targets one array element.
    bindingArrayElement: uint32 | void;
    /// Typed resource payload.
    resource: GpuBindGroupResource;
}

/// Bind-group-layout creation options.
export struct GpuBindGroupLayoutOptions {
    /// Debug label.
    label: string;
    /// Bind-group-layout option flags.
    flags: uint32;
}

/// Pipeline layout options.
export struct GpuPipelineLayoutOptions {
    /// Debug label.
    label: string;
    /// Ordered bind group layouts for this pipeline layout.
    bindGroupLayouts: Slice<GpuBindGroupLayoutHandle>;
    /// Immediate-data byte size when supported.
    immediateSize: uint32;
    /// Pipeline layout option flags.
    flags: uint32;
}

/// Bind-group creation options.
export struct GpuBindGroupOptions {
    /// Debug label.
    label: string;
    /// Bind-group option flags.
    flags: uint32;
}

/// GPU bind bindings.
/// Create a bind group layout.
///
/// Create a bind group layout from ordered binding entries.
/// Validation rules follow backend pipeline-layout contracts.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style bind-group or descriptor-set layout creation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.groupLayoutCreate", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function bindGroupLayoutCreate(
    device: GpuDeviceHandle,
    entries: Slice<GpuBindGroupLayoutEntry>,
    options: GpuBindGroupLayoutOptions,
): Result<GpuBindGroupLayoutHandle, PlatformError>;

/// Destroy a bind group layout.
///
/// Destroy a bind group layout and release backend descriptor-layout resources.
/// The layout handle becomes invalid after destroy.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style layout destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.groupLayoutDestroy", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function bindGroupLayoutDestroy(
    handle: GpuBindGroupLayoutHandle,
): Result<void, PlatformError>;

/// Create a pipeline layout.
///
/// Create a pipeline layout from ordered bind group layouts.
/// Backend layout compatibility checks occur during creation.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style pipeline-layout creation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.pipelineLayoutCreate", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function pipelineLayoutCreate(
    device: GpuDeviceHandle,
    options: GpuPipelineLayoutOptions,
): Result<GpuPipelineLayoutHandle, PlatformError>;

/// Destroy a pipeline layout.
///
/// Destroy a pipeline layout and release backend layout resources.
/// The layout handle becomes invalid after destroy.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style pipeline-layout destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.pipelineLayoutDestroy", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function pipelineLayoutDestroy(
    handle: GpuPipelineLayoutHandle,
): Result<void, PlatformError>;

/// Create a bind group.
///
/// Create a bind group from a layout and explicit resource entries.
/// Resource compatibility is validated against the target layout.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style bind-group or descriptor-set allocation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.groupCreate", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function bindGroupCreate(
    device: GpuDeviceHandle,
    layout: GpuBindGroupLayoutHandle,
    entries: Slice<GpuBindGroupEntry>,
    options: GpuBindGroupOptions,
): Result<GpuBindGroupHandle, PlatformError>;

/// Destroy a bind group.
///
/// Destroy a bind group and release backend descriptor allocation resources.
/// The bind group handle becomes invalid after destroy.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style bind-group destroy or free operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `gpu.bind`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.bind.groupDestroy", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.bind"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function bindGroupDestroy(handle: GpuBindGroupHandle): Result<void, PlatformError>;
