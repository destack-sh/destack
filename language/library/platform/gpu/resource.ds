import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import {
    GpuBufferHandle,
    GpuDeviceHandle,
    GpuExternalTextureHandle,
    GpuSamplerHandle,
    GpuTextureHandle,
    GpuTextureViewHandle,
} from "destack:platform/resource";

/// GPU buffer usage bitset.
export newtype GpuBufferUsageMask = uint32;

/// Buffer usage bit for read mapping.
export const GPU_BUFFER_USAGE_MAP_READ: GpuBufferUsageMask = GpuBufferUsageMask(0x1);
/// Buffer usage bit for write mapping.
export const GPU_BUFFER_USAGE_MAP_WRITE: GpuBufferUsageMask = GpuBufferUsageMask(0x2);
/// Buffer usage bit for copy source.
export const GPU_BUFFER_USAGE_COPY_SRC: GpuBufferUsageMask = GpuBufferUsageMask(0x4);
/// Buffer usage bit for copy destination.
export const GPU_BUFFER_USAGE_COPY_DST: GpuBufferUsageMask = GpuBufferUsageMask(0x8);
/// Buffer usage bit for index input.
export const GPU_BUFFER_USAGE_INDEX: GpuBufferUsageMask = GpuBufferUsageMask(0x10);
/// Buffer usage bit for vertex input.
export const GPU_BUFFER_USAGE_VERTEX: GpuBufferUsageMask = GpuBufferUsageMask(0x20);
/// Buffer usage bit for uniform binding.
export const GPU_BUFFER_USAGE_UNIFORM: GpuBufferUsageMask = GpuBufferUsageMask(0x40);
/// Buffer usage bit for storage binding.
export const GPU_BUFFER_USAGE_STORAGE: GpuBufferUsageMask = GpuBufferUsageMask(0x80);
/// Buffer usage bit for indirect input.
export const GPU_BUFFER_USAGE_INDIRECT: GpuBufferUsageMask = GpuBufferUsageMask(0x100);
/// Buffer usage bit for query resolve.
export const GPU_BUFFER_USAGE_QUERY_RESOLVE: GpuBufferUsageMask = GpuBufferUsageMask(0x200);
/// Buffer usage bit for bottom-level acceleration-structure input.
export const GPU_BUFFER_USAGE_BLAS_INPUT: GpuBufferUsageMask = GpuBufferUsageMask(0x400);
/// Buffer usage bit for top-level acceleration-structure input.
export const GPU_BUFFER_USAGE_TLAS_INPUT: GpuBufferUsageMask = GpuBufferUsageMask(0x800);

/// GPU texture usage bitset.
export newtype GpuTextureUsageMask = uint32;

/// Texture usage bit for copy source.
export const GPU_TEXTURE_USAGE_COPY_SRC: GpuTextureUsageMask = GpuTextureUsageMask(0x1);
/// Texture usage bit for copy destination.
export const GPU_TEXTURE_USAGE_COPY_DST: GpuTextureUsageMask = GpuTextureUsageMask(0x2);
/// Texture usage bit for sampled-texture binding.
export const GPU_TEXTURE_USAGE_TEXTURE_BINDING: GpuTextureUsageMask = GpuTextureUsageMask(0x4);
/// Texture usage bit for storage-texture binding.
export const GPU_TEXTURE_USAGE_STORAGE_BINDING: GpuTextureUsageMask = GpuTextureUsageMask(0x8);
/// Texture usage bit for render attachment.
export const GPU_TEXTURE_USAGE_RENDER_ATTACHMENT: GpuTextureUsageMask = GpuTextureUsageMask(0x10);
/// Texture usage bit for storage atomics.
export const GPU_TEXTURE_USAGE_STORAGE_ATOMIC: GpuTextureUsageMask = GpuTextureUsageMask(0x10000);
/// Texture usage bit for transient attachments.
export const GPU_TEXTURE_USAGE_TRANSIENT: GpuTextureUsageMask = GpuTextureUsageMask(0x20000);

/// Typed GPU texture-format identifier.
export newtype GpuTextureFormat = uint32;

