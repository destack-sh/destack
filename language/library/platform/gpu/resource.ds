/// Read a texture metadata snapshot.
@binding("destack.gpu.resource.textureInfo", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textureInfo(handle: GpuTextureHandle): Result<GpuTextureInfo, PlatformError>;

/// Create a texture view.
@binding("destack.gpu.resource.textureViewCreate", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function textureViewCreate(
    texture: GpuTextureHandle,
