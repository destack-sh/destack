export declare function samplerDestroy(handle: GpuSamplerHandle): Result<void, PlatformError>;

/// Create an external texture resource.
@binding("destack.gpu.resource.externalTextureCreate", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function externalTextureCreate(
    device: GpuDeviceHandle,
    planeViews: Slice<GpuTextureViewHandle>,
