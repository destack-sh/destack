export declare function textureViewDestroy(handle: GpuTextureViewHandle): Result<void, PlatformError>;

/// Create a sampler resource.
@binding("destack.gpu.resource.samplerCreate", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function samplerCreate(
    device: GpuDeviceHandle,
