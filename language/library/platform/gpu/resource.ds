/// Depth or stencil compare selector.
export enum GpuCompareFunction {
    /// Comparison always fails.
    Never = 1,
    /// Pass when source is less than destination.
    Less = 2,
    /// Pass when source equals destination.
    Equal = 3,
    /// Pass when source is less than or equal to destination.
    LessEqual = 4,
    /// Pass when source is greater than destination.
    Greater = 5,
    /// Pass when source does not equal destination.
    NotEqual = 6,
    /// Pass when source is greater than or equal to destination.
    GreaterEqual = 7,
    /// Comparison always passes.
    Always = 8,
}

/// GPU buffer creation options.
export struct GpuBufferOptions {
    /// Debug label.
    label: string;
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: GpuBufferUsageMask;
    /// Whether the buffer starts mapped for host access.
    mappedAtCreation: boolean;
    /// Buffer option flags.
    flags: uint32;
}

/// GPU texture creation options.
export struct GpuTextureOptions {
    /// Debug label.
    label: string;
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: GpuTextureFormat;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
    /// Texture usage bitset.
    usage: GpuTextureUsageMask;
    /// Additional compatible texture-view format identifiers.
    viewFormats: Slice<GpuTextureFormat>;
    /// Texture option flags.
    flags: uint32;
}

/// GPU texture-view creation options.
export struct GpuTextureViewOptions {
    /// Debug label.
    label: string;
    /// View format identifier when one compatible view format is selected.
    format: GpuTextureFormat | void;
    /// View usage bitset, or `void` to inherit the full texture usage set.
    usage: GpuTextureUsageMask | void;
    /// View dimension selector.
    dimension: GpuTextureViewDimension | void;
    /// Base mip-level index.
    baseMipLevel: uint32;
    /// Mip-level count when the view does not cover the remaining mip range.
    mipLevelCount: uint32 | void;
    /// Base array-layer index.
    baseArrayLayer: uint32;
    /// Array-layer count when the view does not cover the remaining layer range.
    arrayLayerCount: uint32 | void;
    /// Texture aspect selector.
    aspect: GpuTextureAspect;
    /// Texture-view option flags.
    flags: uint32;
}

/// GPU sampler creation options.
export struct GpuSamplerOptions {
    /// Debug label.
    label: string;
    /// Minification filter selector.
    minFilter: GpuFilterMode;
    /// Magnification filter selector.
    magFilter: GpuFilterMode;
    /// Mipmap filter selector.
    mipFilter: GpuMipmapFilterMode;
    /// Address mode u selector.
    addressU: GpuAddressMode;
    /// Address mode v selector.
    addressV: GpuAddressMode;
    /// Address mode w selector.
    addressW: GpuAddressMode;
    /// Sampler LOD minimum clamp.
    lodMinClamp: float64;
    /// Sampler LOD maximum clamp.
    lodMaxClamp: float64;
    /// Compare-function selector when comparison is enabled.
    compare: GpuCompareFunction | void;
    /// Maximum anisotropy level.
    maxAnisotropy: uint16;
    /// Border color when one address mode clamps to border.
    borderColor: GpuSamplerBorderColor | void;
    /// Sampler option flags.
    flags: uint32;
}

/// Buffer mapping mode.
export enum GpuMapMode {
    /// Read-only map mode.
    Read = 1,
    /// Write-only map mode.
    Write = 2,
}

/// Buffer map-state selector.
export enum GpuBufferMapState {
    /// Buffer is not currently mapped.
    Unmapped = 1,
    /// Buffer map request is pending.
    Pending = 2,
    /// Buffer is currently mapped.
    Mapped = 3,
}

/// Texture dimension selector.
export enum GpuTextureDimension {
    /// One-dimensional texture.
    D1 = 1,
    /// Two-dimensional texture.
    D2 = 2,
    /// Three-dimensional texture.
    D3 = 3,
}

/// Texture view-dimension selector.
export enum GpuTextureViewDimension {
    /// One-dimensional texture view.
    D1 = 1,
    /// Two-dimensional texture view.
    D2 = 2,
    /// Two-dimensional texture-array view.
    D2Array = 3,
    /// Cube texture view.
    Cube = 4,
    /// Cube texture-array view.
    CubeArray = 5,
    /// Three-dimensional texture view.
    D3 = 6,
}

/// Texture aspect selector.
export enum GpuTextureAspect {
    /// Select all color or depth-stencil aspects.
    All = 1,
    /// Select only the stencil aspect.
    StencilOnly = 2,
    /// Select only the depth aspect.
    DepthOnly = 3,
    /// Select only plane 0.
    Plane0 = 4,
    /// Select only plane 1.
    Plane1 = 5,
    /// Select only plane 2.
    Plane2 = 6,
}

/// Texture address mode selector.
export enum GpuAddressMode {
    /// Clamp coordinates to the texture edge.
    ClampToEdge = 1,
    /// Repeat coordinates in a tiling pattern.
    Repeat = 2,
    /// Repeat coordinates with alternating mirroring.
    MirrorRepeat = 3,
    /// Clamp coordinates to the configured border color.
    ClampToBorder = 4,
}

/// Texture filter mode selector.
export enum GpuFilterMode {
    /// Use nearest-neighbor filtering.
    Nearest = 1,
    /// Use linear interpolation.
    Linear = 2,
}

/// Texture mipmap filter mode selector.
export enum GpuMipmapFilterMode {
    /// Use nearest-neighbor mip selection.
    Nearest = 1,
    /// Use linear interpolation between mip levels.
    Linear = 2,
}

/// Sampler border color selector.
export enum GpuSamplerBorderColor {
    /// Transparent black border color.
    TransparentBlack = 1,
    /// Opaque black border color.
    OpaqueBlack = 2,
    /// Opaque white border color.
    OpaqueWhite = 3,
    /// Zero border color for all components when supported.
    Zero = 4,
}

/// Buffer transition state bitset.
export newtype GpuBufferUseMask = uint32;

/// Texture transition state bitset.
export newtype GpuTextureUseMask = uint32;

/// Buffer use bit for read mapping.
export const GPU_BUFFER_USE_MAP_READ: GpuBufferUseMask = GpuBufferUseMask(0x1);
/// Buffer use bit for write mapping.
export const GPU_BUFFER_USE_MAP_WRITE: GpuBufferUseMask = GpuBufferUseMask(0x2);
/// Buffer use bit for copy source.
export const GPU_BUFFER_USE_COPY_SRC: GpuBufferUseMask = GpuBufferUseMask(0x4);
/// Buffer use bit for copy destination.
export const GPU_BUFFER_USE_COPY_DST: GpuBufferUseMask = GpuBufferUseMask(0x8);
/// Buffer use bit for index input.
export const GPU_BUFFER_USE_INDEX: GpuBufferUseMask = GpuBufferUseMask(0x10);
/// Buffer use bit for vertex input.
export const GPU_BUFFER_USE_VERTEX: GpuBufferUseMask = GpuBufferUseMask(0x20);
/// Buffer use bit for uniform binding.
export const GPU_BUFFER_USE_UNIFORM: GpuBufferUseMask = GpuBufferUseMask(0x40);
/// Buffer use bit for read-only storage binding.
export const GPU_BUFFER_USE_STORAGE_READ_ONLY: GpuBufferUseMask = GpuBufferUseMask(0x80);
/// Buffer use bit for read-write storage binding.
export const GPU_BUFFER_USE_STORAGE_READ_WRITE: GpuBufferUseMask = GpuBufferUseMask(0x100);
/// Buffer use bit for indirect input.
export const GPU_BUFFER_USE_INDIRECT: GpuBufferUseMask = GpuBufferUseMask(0x200);
/// Buffer use bit for query resolve.
export const GPU_BUFFER_USE_QUERY_RESOLVE: GpuBufferUseMask = GpuBufferUseMask(0x400);

/// Texture use bit for uninitialized state.
export const GPU_TEXTURE_USE_UNINITIALIZED: GpuTextureUseMask = GpuTextureUseMask(0x1);
/// Texture use bit for presentable state.
export const GPU_TEXTURE_USE_PRESENT: GpuTextureUseMask = GpuTextureUseMask(0x2);
/// Texture use bit for copy source.
export const GPU_TEXTURE_USE_COPY_SRC: GpuTextureUseMask = GpuTextureUseMask(0x4);
/// Texture use bit for copy destination.
export const GPU_TEXTURE_USE_COPY_DST: GpuTextureUseMask = GpuTextureUseMask(0x8);
/// Texture use bit for sampled or fetched resource access.
export const GPU_TEXTURE_USE_RESOURCE: GpuTextureUseMask = GpuTextureUseMask(0x10);
/// Texture use bit for color render targets.
export const GPU_TEXTURE_USE_COLOR_TARGET: GpuTextureUseMask = GpuTextureUseMask(0x20);
/// Texture use bit for read-only depth-stencil access.
export const GPU_TEXTURE_USE_DEPTH_STENCIL_READ: GpuTextureUseMask = GpuTextureUseMask(0x40);
/// Texture use bit for writable depth-stencil access.
export const GPU_TEXTURE_USE_DEPTH_STENCIL_WRITE: GpuTextureUseMask = GpuTextureUseMask(0x80);
/// Texture use bit for read-only storage access.
export const GPU_TEXTURE_USE_STORAGE_READ_ONLY: GpuTextureUseMask = GpuTextureUseMask(0x100);
/// Texture use bit for write-only storage access.
export const GPU_TEXTURE_USE_STORAGE_WRITE_ONLY: GpuTextureUseMask = GpuTextureUseMask(0x200);
/// Texture use bit for read-write storage access.
export const GPU_TEXTURE_USE_STORAGE_READ_WRITE: GpuTextureUseMask = GpuTextureUseMask(0x400);
/// Texture use bit for atomic storage access.
export const GPU_TEXTURE_USE_STORAGE_ATOMIC: GpuTextureUseMask = GpuTextureUseMask(0x800);
/// Texture use bit for transient render-attachment allocation.
export const GPU_TEXTURE_USE_TRANSIENT: GpuTextureUseMask = GpuTextureUseMask(0x1000);

/// Texture subresource selector for one transition.
export struct GpuTextureSubresourceRange {
    /// Starting mip-level index.
    baseMipLevel: uint32;
    /// Number of mip levels.
    mipLevelCount: uint32;
    /// Starting array-layer index.
    baseArrayLayer: uint32;
    /// Number of array layers.
    arrayLayerCount: uint32;
}

/// Buffer transition descriptor.
export struct GpuBufferTransition {
    /// Buffer handle.
    buffer: GpuBufferHandle;
    /// Target buffer use state.
    state: GpuBufferUseMask;
}

/// Texture transition descriptor.
export struct GpuTextureTransition {
    /// Texture handle.
    texture: GpuTextureHandle;
    /// Optional subresource selector.
    subresources: GpuTextureSubresourceRange | void;
    /// Target texture use state.
    state: GpuTextureUseMask;
}

/// External-texture format selector.
export enum GpuExternalTextureFormat {
    /// Single RGBA plane.
    Rgba = 1,
    /// One luma plane and one interleaved chroma plane.
    Nv12 = 2,
    /// Separate luma, Cb, and Cr planes.
    Yu12 = 3,
}

/// External-texture transfer-function parameters.
export struct GpuExternalTextureTransferFunction {
    /// Transfer-function coefficient a.
    a: float32;
    /// Transfer-function breakpoint b.
    b: float32;
    /// Transfer-function exponent g.
    g: float32;
    /// Transfer-function coefficient k.
    k: float32;
}

/// External-texture creation options.
export struct GpuExternalTextureOptions {
    /// Debug label.
    label: string;
    /// External-texture width visible to shaders.
    width: uint32;
    /// External-texture height visible to shaders.
    height: uint32;
    /// External-texture format selector.
    format: GpuExternalTextureFormat;
    /// YUV-to-RGBA conversion matrix in column-major order.
    yuvConversionMatrix: float32[16 as comptime];
    /// Gamut-conversion matrix in column-major order.
    gamutConversionMatrix: float32[9 as comptime];
    /// Source transfer-function parameters.
    sourceTransferFunction: GpuExternalTextureTransferFunction;
    /// Destination transfer-function parameters.
    destinationTransferFunction: GpuExternalTextureTransferFunction;
    /// Sample-coordinate transform in column-major order.
    sampleTransform: float32[6 as comptime];
    /// Load-coordinate transform in column-major order.
    loadTransform: float32[6 as comptime];
    /// External-texture option flags.
    flags: uint32;
}

/// GPU mapped buffer range.
export struct GpuMappedBufferRange {
    /// Host-visible pointer address represented as integer.
    address: uint64;
    /// Mapped byte length.
    length: uint64;
    /// Whether cache coherence is guaranteed for this mapping.
    coherent: boolean;
}

/// Buffer metadata snapshot.
export struct GpuBufferInfo {
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: GpuBufferUsageMask;
    /// Current map-state selector.
    mapState: GpuBufferMapState;
}

/// Texture metadata snapshot.
export struct GpuTextureInfo {
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip-level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: GpuTextureFormat;
    /// Texture usage bitset.
    usage: GpuTextureUsageMask;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
}

/// Create a GPU buffer.
@binding("destack.gpu.resource.bufferCreate", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferCreate(
    device: GpuDeviceHandle,
    options: GpuBufferOptions,
): Result<GpuBufferHandle, PlatformError>;

/// Destroy a GPU buffer.
@binding("destack.gpu.resource.bufferDestroy", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferDestroy(handle: GpuBufferHandle): Result<void, PlatformError>;

/// Write a byte range to a GPU buffer.
@binding("destack.gpu.resource.bufferWrite", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferWrite(
    handle: GpuBufferHandle,
    offset: uint64,
    bytes: Slice<uint8>,
): Result<void, PlatformError>;

/// Read a byte range from a GPU buffer.
@binding("destack.gpu.resource.bufferRead", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferRead(
    handle: GpuBufferHandle,
    offset: uint64,
    length: uint64,
): Result<Slice<uint8>, PlatformError>;

/// Map a buffer range.
@binding("destack.gpu.resource.bufferMap", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferMap(
    handle: GpuBufferHandle,
    offset: uint64,
    length: uint64,
    mode: GpuMapMode,
): Result<GpuMappedBufferRange, PlatformError>;

/// Unmap a mapped buffer.
@binding("destack.gpu.resource.bufferUnmap", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferUnmap(handle: GpuBufferHandle): Result<void, PlatformError>;

/// Read a buffer metadata snapshot.
@binding("destack.gpu.resource.bufferInfo", {
    effect: "external",
    requires: ["gpu.memory"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bufferInfo(handle: GpuBufferHandle): Result<GpuBufferInfo, PlatformError>;

/// Create a texture resource.
@binding("destack.gpu.resource.textureCreate", {
    effect: "external",
