@binding("destack.gpu.device.limits", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.device"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
