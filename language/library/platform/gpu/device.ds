@binding("destack.gpu.device.queue", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.queue"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function deviceQueue(device: GpuDeviceHandle): Result<GpuQueueHandle, PlatformError>;

/// Poll a logical device for completion progress.
///
/// Poll a device and optionally wait for work completion until the timeout expires.
/// Returned value is a backend-defined count of completed submission units.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style device poll or fence polling operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.queue`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.device.poll", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.queue"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function devicePoll(
    device: GpuDeviceHandle,
    wait: boolean,
    timeoutNs: uint64,
): Result<uint32, PlatformError>;

/// Push one device error scope.
///
/// Push an error scope to capture asynchronous validation and runtime errors.
/// Scopes are popped in last-in-first-out order.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style device error-scope push operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.device`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.device.pushErrorScope", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.device"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function devicePushErrorScope(
    device: GpuDeviceHandle,
    filter: GpuErrorFilter,
): Result<void, PlatformError>;

/// Pop one device error scope.
///
/// Pop a previously pushed error scope and return captured error details.
/// Pop fails when no scope exists on the device scope stack.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style device error-scope pop operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.device`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.device.popErrorScope", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.device"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function devicePopErrorScope(
    device: GpuDeviceHandle,
    timeoutNs: uint64,
): Result<GpuCapturedError, PlatformError>;

/// Close a logical GPU device.
///
/// Close a logical device and release backend device resources.
/// Outstanding queue work behavior follows host backend teardown guarantees.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style device destroy or release operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.device`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.device.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.device"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function deviceClose(handle: GpuDeviceHandle): Result<void, PlatformError>;
