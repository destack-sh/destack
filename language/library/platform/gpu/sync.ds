    replay: "recordable",
    capabilities: ["gpu.sync"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function queueTimestampPeriod(queue: GpuQueueHandle): Result<float64, PlatformError>;

