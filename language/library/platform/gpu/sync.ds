import type { PlatformError } from "../error/index.ds";
import {
    GpuBufferHandle,
    GpuCommandEncoderHandle,
    GpuComputePassHandle,
    GpuDeviceHandle,
    GpuFenceHandle,
    GpuQuerySetHandle,
    GpuQueueHandle,
    GpuRenderPassHandle,
} from "../resource/index.ds";

/// Fence mode selector.
export enum GpuFenceMode {
    /// Binary fence mode.
    Binary = 1,
    /// Timeline fence mode.
    Timeline = 2,
}

/// Pipeline-statistics query bitset.
export newtype GpuPipelineStatisticsMask = uint64;

/// Pipeline-statistics query flags.
export enum GpuPipelineStatisticsFlag {
    /// Count vertex-shader invocations.
    VertexShaderInvocations = 1,
    /// Count clipper invocations.
    ClipperInvocations = 2,
    /// Count unclipped primitives.
    ClipperPrimitivesOut = 4,
    /// Count fragment-shader invocations.
    FragmentShaderInvocations = 8,
    /// Count compute-shader invocations.
    ComputeShaderInvocations = 16,
}

/// Fence creation options.
export struct GpuFenceOptions {
    /// Fence mode selector.
    mode: GpuFenceMode;
    /// Initial timeline value in timeline mode.
    initialValue: uint64;
    /// Fence option flags.
    flags: uint32;
}

/// Timestamp query-set type.
export struct GpuTimestampQueryType {
    /// Discriminator for this query-set type variant.
    kind: "timestamp";
}

/// Occlusion query-set type.
export struct GpuOcclusionQueryType {
    /// Discriminator for this query-set type variant.
    kind: "occlusion";
}

/// Pipeline-statistics query-set type.
export struct GpuPipelineStatisticsQueryType {
    /// Discriminator for this query-set type variant.
    kind: "pipelineStatistics";
    /// Enabled statistics in resolve order.
    pipelineStatisticsMask: GpuPipelineStatisticsMask;
}

/// Query-set type payload.
export newtype GpuQuerySetType =
    | GpuTimestampQueryType
    | GpuOcclusionQueryType
    | GpuPipelineStatisticsQueryType;

/// Query set creation options.
export struct GpuQuerySetOptions {
    /// Debug label.
    label: string;
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
    /// Query set option flags.
    flags: uint32;
}

/// Query-set metadata snapshot.
export struct GpuQuerySetInfo {
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
}

/// Create a synchronization fence.
@binding("destack.gpu.sync.fenceCreate", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function fenceCreate(
    device: GpuDeviceHandle,
    options: GpuFenceOptions,
): Result<GpuFenceHandle, PlatformError>;

/// Destroy a synchronization fence.
@binding("destack.gpu.sync.fenceDestroy", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function fenceDestroy(handle: GpuFenceHandle): Result<void, PlatformError>;

/// Signal a fence value from a queue.
@binding("destack.gpu.sync.queueSignal", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function queueSignal(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
): Result<void, PlatformError>;

/// Wait for a fence value.
@binding("destack.gpu.sync.queueWait", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function queueWait(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Wait for all previously submitted queue work.
@binding("destack.gpu.sync.queueWorkDone", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function queueWorkDone(
    queue: GpuQueueHandle,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Read a queue timestamp period.
@binding("destack.gpu.sync.queueTimestampPeriod", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function queueTimestampPeriod(queue: GpuQueueHandle): Result<float64, PlatformError>;

/// Create a query set.
@binding("destack.gpu.sync.querySetCreate", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function querySetCreate(
    device: GpuDeviceHandle,
    options: GpuQuerySetOptions,
): Result<GpuQuerySetHandle, PlatformError>;

/// Destroy a query set.
@binding("destack.gpu.sync.querySetDestroy", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function querySetDestroy(handle: GpuQuerySetHandle): Result<void, PlatformError>;

/// Read a query-set metadata snapshot.
@binding("destack.gpu.sync.querySetInfo", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function querySetInfo(handle: GpuQuerySetHandle): Result<GpuQuerySetInfo, PlatformError>;

/// Write a timestamp query from a command encoder.
@binding("destack.gpu.sync.commandWriteTimestamp", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandWriteTimestamp(
    commandEncoder: GpuCommandEncoderHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// Begin an occlusion query.
@binding("destack.gpu.sync.commandBeginOcclusionQuery", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandBeginOcclusionQuery(
    renderPass: GpuRenderPassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End an occlusion query.
@binding("destack.gpu.sync.commandEndOcclusionQuery", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandEndOcclusionQuery(
    renderPass: GpuRenderPassHandle,
): Result<void, PlatformError>;

/// Begin a pipeline-statistics query in a render pass.
@binding("destack.gpu.sync.commandBeginRenderPipelineStatisticsQuery", {
    effect: "external",
    requires: ["gpu.sync.pipeline.statistics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandBeginRenderPipelineStatisticsQuery(
    renderPass: GpuRenderPassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End a pipeline-statistics query in a render pass.
@binding("destack.gpu.sync.commandEndRenderPipelineStatisticsQuery", {
    effect: "external",
    requires: ["gpu.sync.pipeline.statistics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandEndRenderPipelineStatisticsQuery(
    renderPass: GpuRenderPassHandle,
): Result<void, PlatformError>;

/// Begin a pipeline-statistics query in a compute pass.
@binding("destack.gpu.sync.commandBeginComputePipelineStatisticsQuery", {
    effect: "external",
    requires: ["gpu.sync.pipeline.statistics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandBeginComputePipelineStatisticsQuery(
    computePass: GpuComputePassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End a pipeline-statistics query in a compute pass.
@binding("destack.gpu.sync.commandEndComputePipelineStatisticsQuery", {
    effect: "external",
    requires: ["gpu.sync.pipeline.statistics"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandEndComputePipelineStatisticsQuery(
    computePass: GpuComputePassHandle,
): Result<void, PlatformError>;

/// Resolve one query range into one destination buffer.
@binding("destack.gpu.sync.commandResolveQueries", {
    effect: "external",
    requires: ["gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commandResolveQueries(
    commandEncoder: GpuCommandEncoderHandle,
    querySet: GpuQuerySetHandle,
    firstQuery: uint32,
    queryCount: uint32,
    destination: GpuBufferHandle,
    destinationOffset: uint64,
): Result<void, PlatformError>;
