import { PlatformError } from "destack:platform/error";
import {
    GpuBufferHandle,
    GpuCommandEncoderHandle,
    GpuComputePassHandle,
    GpuDeviceHandle,
    GpuFenceHandle,
    GpuQuerySetHandle,
    GpuQueueHandle,
    GpuRenderPassHandle,
} from "destack:platform/resource";

/// Fence mode selector.
export enum GpuFenceMode {
    /// Binary fence mode.
    Binary = 1,
    /// Timeline fence mode.
    Timeline = 2,
}

/// Pipeline-statistics query bitset.
export newtype GpuPipelineStatisticsMask = uint64;

/// Pipeline-statistics bit for vertex-shader invocations.
export const GPU_PIPELINE_STATISTICS_VERTEX_SHADER_INVOCATIONS: GpuPipelineStatisticsMask =
    GpuPipelineStatisticsMask(0x1);
/// Pipeline-statistics bit for clipper invocations.
export const GPU_PIPELINE_STATISTICS_CLIPPER_INVOCATIONS: GpuPipelineStatisticsMask =
    GpuPipelineStatisticsMask(0x2);
/// Pipeline-statistics bit for unclipped primitives.
export const GPU_PIPELINE_STATISTICS_CLIPPER_PRIMITIVES_OUT: GpuPipelineStatisticsMask =
    GpuPipelineStatisticsMask(0x4);
/// Pipeline-statistics bit for fragment-shader invocations.
export const GPU_PIPELINE_STATISTICS_FRAGMENT_SHADER_INVOCATIONS: GpuPipelineStatisticsMask =
    GpuPipelineStatisticsMask(0x8);
/// Pipeline-statistics bit for compute-shader invocations.
export const GPU_PIPELINE_STATISTICS_COMPUTE_SHADER_INVOCATIONS: GpuPipelineStatisticsMask =
    GpuPipelineStatisticsMask(0x10);

/// Fence descriptor.
export struct GpuFenceDescriptor {
    /// Fence mode selector.
    mode: GpuFenceMode;
    /// Initial timeline value in timeline mode.
    initialValue: uint64;
}

/// Timestamp query-set type.
export struct GpuTimestampQueryType {
    /// Discriminator for this query-set type variant.
    kind: "timestamp";
}

/// Occlusion query-set type.
export struct GpuOcclusionQueryType {
    /// Discriminator for this query-set type variant.
    kind: "occlusion";
}

/// Pipeline-statistics query-set type.
export struct GpuPipelineStatisticsQueryType {
    /// Discriminator for this query-set type variant.
    kind: "pipelineStatistics";
    /// Enabled statistics in resolve order.
    pipelineStatisticsMask: GpuPipelineStatisticsMask;
}

/// Query-set type payload.
export newtype GpuQuerySetType =
    | GpuTimestampQueryType
    | GpuOcclusionQueryType
    | GpuPipelineStatisticsQueryType;

/// Query set descriptor.
export struct GpuQuerySetDescriptor {
    /// Debug label.
    label: string;
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
}

/// Query set state.
export struct GpuQuerySetState {
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
}

/// Create a synchronization fence.
@binding("destack.gpu.sync.fence.create", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function createFence(
    device: GpuDeviceHandle,
    descriptor: &readonly GpuFenceDescriptor,
): Result<GpuFenceHandle, PlatformError>;

/// Destroy a synchronization fence.
@binding("destack.gpu.sync.fence.destroy", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function destroyFence(fence: GpuFenceHandle): Result<void, PlatformError>;

/// Signal a fence value from a queue.
@binding("destack.gpu.sync.queue.signal", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalQueue(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
): Result<void, PlatformError>;

/// Wait for a fence value.
@binding("destack.gpu.sync.queue.wait", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitQueue(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Wait for all previously submitted queue work.
@binding("destack.gpu.sync.queue.done.wait", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitQueueDone(
    queue: GpuQueueHandle,
    timeoutNs: uint64,
): Result<void, PlatformError>;

/// Read a queue timestamp period.
@binding("destack.gpu.sync.queue.timestamp.period", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readQueueTimestampPeriod(queue: GpuQueueHandle): Result<float64, PlatformError>;

/// Create a query set.
@binding("destack.gpu.sync.query.set.create", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function createQuerySet(
    device: GpuDeviceHandle,
    descriptor: &readonly GpuQuerySetDescriptor,
): Result<GpuQuerySetHandle, PlatformError>;

/// Destroy a query set.
@binding("destack.gpu.sync.query.set.destroy", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function destroyQuerySet(querySet: GpuQuerySetHandle): Result<void, PlatformError>;

/// Read a query-set metadata snapshot.
@binding("destack.gpu.sync.query.set.state.read", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readQuerySet(querySet: GpuQuerySetHandle): Result<GpuQuerySetState, PlatformError>;

/// Write a timestamp query from a command encoder.
@binding("destack.gpu.sync.command.timestamp.write", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeCommandTimestamp(
    encoder: GpuCommandEncoderHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// Begin an occlusion query.
@binding("destack.gpu.sync.command.occlusion.begin", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function beginOcclusionQuery(
    renderPass: GpuRenderPassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End an occlusion query.
@binding("destack.gpu.sync.command.occlusion.end", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function endOcclusionQuery(
    renderPass: GpuRenderPassHandle,
): Result<void, PlatformError>;

/// Begin a pipeline-statistics query in a render pass.
@binding("destack.gpu.sync.command.render.statistics.begin", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function beginRenderStatisticsQuery(
    renderPass: GpuRenderPassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End a pipeline-statistics query in a render pass.
@binding("destack.gpu.sync.command.render.statistics.end", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function endRenderStatisticsQuery(
    renderPass: GpuRenderPassHandle,
): Result<void, PlatformError>;

/// Begin a pipeline-statistics query in a compute pass.
@binding("destack.gpu.sync.command.compute.statistics.begin", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function beginComputeStatisticsQuery(
    computePass: GpuComputePassHandle,
    querySet: GpuQuerySetHandle,
    queryIndex: uint32,
): Result<void, PlatformError>;

/// End a pipeline-statistics query in a compute pass.
@binding("destack.gpu.sync.command.compute.statistics.end", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function endComputeStatisticsQuery(
    computePass: GpuComputePassHandle,
): Result<void, PlatformError>;

/// Resolve one query range into one destination buffer.
@binding("destack.gpu.sync.command.queries.resolve", {
    effect: "external",
    requires: ["host.gpu.sync"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function resolveQueries(
    encoder: GpuCommandEncoderHandle,
    querySet: GpuQuerySetHandle,
    firstQuery: uint32,
    queryCount: uint32,
    destination: GpuBufferHandle,
    destinationOffset: uint64,
): Result<void, PlatformError>;
