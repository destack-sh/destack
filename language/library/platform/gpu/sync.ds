import type { PlatformError } from "../error/index.ds";
import {
    GpuBufferHandle,
    GpuCommandEncoderHandle,
    GpuComputePassHandle,
    GpuDeviceHandle,
    GpuFenceHandle,
    GpuQuerySetHandle,
    GpuQueueHandle,
    GpuRenderPassHandle,
} from "../resource/index.ds";

/// Fence mode selector.
export enum GpuFenceMode {
    /// Binary fence mode.
    Binary = 1,
    /// Timeline fence mode.
    Timeline = 2,
}

/// Pipeline-statistics query bitset.
export newtype GpuPipelineStatisticsMask = uint64;

/// Pipeline-statistics query flags.
export enum GpuPipelineStatisticsFlag {
    /// Count vertex-shader invocations.
    VertexShaderInvocations = 1,
    /// Count clipper invocations.
    ClipperInvocations = 2,
    /// Count unclipped primitives.
    ClipperPrimitivesOut = 4,
    /// Count fragment-shader invocations.
    FragmentShaderInvocations = 8,
    /// Count compute-shader invocations.
    ComputeShaderInvocations = 16,
}

/// Fence creation options.
export struct GpuFenceOptions {
    /// Fence mode selector.
    mode: GpuFenceMode;
    /// Initial timeline value in timeline mode.
    initialValue: uint64;
    /// Fence option flags.
    flags: uint32;
}

/// Timestamp query-set type.
export struct GpuTimestampQueryType {
    /// Discriminator for this query-set type variant.
    kind: "timestamp";
}

/// Occlusion query-set type.
export struct GpuOcclusionQueryType {
    /// Discriminator for this query-set type variant.
    kind: "occlusion";
}

/// Pipeline-statistics query-set type.
export struct GpuPipelineStatisticsQueryType {
    /// Discriminator for this query-set type variant.
    kind: "pipelineStatistics";
    /// Enabled statistics in resolve order.
    pipelineStatisticsMask: GpuPipelineStatisticsMask;
}

/// Query-set type payload.
export newtype GpuQuerySetType =
    | GpuTimestampQueryType
    | GpuOcclusionQueryType
    | GpuPipelineStatisticsQueryType;

/// Query set creation options.
export struct GpuQuerySetOptions {
    /// Debug label.
    label: string;
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
    /// Query set option flags.
    flags: uint32;
}

/// Query-set metadata snapshot.
export struct GpuQuerySetInfo {
    /// Query-set type payload.
    queryType: GpuQuerySetType;
    /// Query count.
    count: uint32;
}

/// GPU synchronization bindings.
/// Create a synchronization fence.
///
/// Create a fence object for queue wait and signal coordination.
/// Timeline mode availability depends on backend feature support.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style fence or timeline semaphore creation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.sync`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.sync.fenceCreate", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.sync"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function fenceCreate(
    device: GpuDeviceHandle,
    options: GpuFenceOptions,
): Result<GpuFenceHandle, PlatformError>;

/// Destroy a synchronization fence.
///
/// Destroy a fence object and release backend synchronization resources.
/// The fence handle becomes invalid after destroy.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style fence destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `gpu.sync`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.sync.fenceDestroy", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.sync"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function fenceDestroy(handle: GpuFenceHandle): Result<void, PlatformError>;

/// Signal a fence value from a queue.
///
/// Signal a fence from a queue after prior submissions complete.
/// Value handling follows backend binary or timeline semantics.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style queue signal operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
///
/// # Security
/// Requires `gpu.sync`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.sync.queueSignal", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.sync"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function queueSignal(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
): Result<void, PlatformError>;

/// Wait for a fence value.
///
/// Wait for a fence to reach or exceed a requested value.
/// Timeout uses nanoseconds in the runtime monotonic domain.
///
/// # Platform
/// Unix and Windows.
/// Uses WebGPU-style fence wait operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `gpu.sync`.
///
/// # Replay
/// External, recordable.
@binding("destack.gpu.sync.queueWait", {
    effect: "external",
    replay: "recordable",
    capabilities: ["gpu.sync"],
    platforms: ["windows", "unix"],
    simulation: "stub",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function queueWait(
    queue: GpuQueueHandle,
    fence: GpuFenceHandle,
    value: uint64,
    timeoutNs: uint64,
