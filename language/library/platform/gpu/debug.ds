import type { PlatformError } from "../error/index.ds";
import { ResourceId } from "../resource/index.ds";

/// Set a debug label on a GPU resource object.
@binding("destack.gpu.debug.setLabel", {
    effect: "external",
    requires: ["gpu.debug"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setLabel(handle: ResourceId, label: string): Result<void, PlatformError>;
