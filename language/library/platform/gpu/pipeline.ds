import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import {
    GpuBindGroupLayoutHandle,
    GpuDeviceHandle,
    GpuPipelineHandle,
    GpuPipelineLayoutHandle,
    GpuShaderHandle,
} from "../resource/index.ds";
import { GpuCompareFunction, GpuTextureFormat } from "./resource.ds";

/// GPU shader module options.
export struct GpuShaderOptions {
    /// Shader binary format selector.
    format: GpuShaderFormat;
    /// Shader option flags.
    flags: uint32;
    /// Debug label.
    label: string;
    /// Native workgroup counts for passthrough shader formats when required.
    numWorkgroups: uint32[3 as comptime] | void;
    /// Shader runtime-check policy when one nondefault policy is requested.
    runtimeChecks: GpuShaderRuntimeChecks | void;
}

/// Shader binary format selector.
export enum GpuShaderFormat {
    /// WGSL shader source text.
    Wgsl = 1,
    /// SPIR-V shader binary.
    SpirV = 2,
    /// Metal shading language source text.
    Msl = 3,
    /// HLSL or DXIL shader payload.
    HlslOrDxil = 4,
    /// GLSL shader source text.
    Glsl = 5,
}

/// Shader-compilation message kind.
export enum GpuCompilationMessageKind {
    /// Informational message.
    Info = 1,
    /// Warning message.
    Warning = 2,
    /// Error message.
    Error = 3,
}

/// Shader-compilation message descriptor.
export struct GpuCompilationMessage {
    /// Message kind.
    kind: GpuCompilationMessageKind;
    /// Human-readable message text.
    message: string;
    /// One-indexed source line number when available.
    line: uint32;
    /// One-indexed source column number when available.
    column: uint32;
    /// Zero-based source byte offset when available.
    offset: uint32;
    /// Source span length in bytes when available.
    length: uint32;
}

/// Shader-compilation information snapshot.
export struct GpuCompilationInfo {
    /// Compilation diagnostics emitted by backend validation or translation.
    messages: Slice<GpuCompilationMessage>;
}

/// Shader runtime-check policy.
export struct GpuShaderRuntimeChecks {
    /// Whether shader buffer bounds checks are enforced.
    boundsChecks: boolean;
    /// Whether loop bounding is enforced.
    forceLoopBounding: boolean;
    /// Whether ray-query initialization tracking is enforced.
    rayQueryInitializationTracking: boolean;
    /// Whether task-shader dispatch tracking is enforced.
    taskShaderDispatchTracking: boolean;
    /// Whether mesh-shader primitive indices are clamped.
    meshShaderPrimitiveIndicesClamp: boolean;
}

/// Typed GPU vertex-format identifier.
export newtype GpuVertexFormat = uint32;

/// Unsigned 8-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_UINT8X2: GpuVertexFormat = GpuVertexFormat(1);
/// Unsigned 8-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_UINT8X4: GpuVertexFormat = GpuVertexFormat(2);
/// Signed 8-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_SINT8X2: GpuVertexFormat = GpuVertexFormat(3);
/// Signed 8-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_SINT8X4: GpuVertexFormat = GpuVertexFormat(4);
/// Unsigned normalized 8-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_UNORM8X2: GpuVertexFormat = GpuVertexFormat(5);
/// Unsigned normalized 8-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_UNORM8X4: GpuVertexFormat = GpuVertexFormat(6);
/// Signed normalized 8-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_SNORM8X2: GpuVertexFormat = GpuVertexFormat(7);
/// Signed normalized 8-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_SNORM8X4: GpuVertexFormat = GpuVertexFormat(8);
/// Unsigned 16-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_UINT16X2: GpuVertexFormat = GpuVertexFormat(9);
/// Unsigned 16-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_UINT16X4: GpuVertexFormat = GpuVertexFormat(10);
/// Signed 16-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_SINT16X2: GpuVertexFormat = GpuVertexFormat(11);
/// Signed 16-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_SINT16X4: GpuVertexFormat = GpuVertexFormat(12);
/// Unsigned normalized 16-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_UNORM16X2: GpuVertexFormat = GpuVertexFormat(13);
/// Unsigned normalized 16-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_UNORM16X4: GpuVertexFormat = GpuVertexFormat(14);
/// Signed normalized 16-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_SNORM16X2: GpuVertexFormat = GpuVertexFormat(15);
/// Signed normalized 16-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_SNORM16X4: GpuVertexFormat = GpuVertexFormat(16);
/// 16-bit float x2 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT16X2: GpuVertexFormat = GpuVertexFormat(17);
/// 16-bit float x4 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT16X4: GpuVertexFormat = GpuVertexFormat(18);
/// 32-bit float vertex format.
export const GPU_VERTEX_FORMAT_FLOAT32: GpuVertexFormat = GpuVertexFormat(19);
/// 32-bit float x2 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT32X2: GpuVertexFormat = GpuVertexFormat(20);
/// 32-bit float x3 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT32X3: GpuVertexFormat = GpuVertexFormat(21);
/// 32-bit float x4 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT32X4: GpuVertexFormat = GpuVertexFormat(22);
/// Unsigned 32-bit vertex format.
export const GPU_VERTEX_FORMAT_UINT32: GpuVertexFormat = GpuVertexFormat(23);
/// Unsigned 32-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_UINT32X2: GpuVertexFormat = GpuVertexFormat(24);
/// Unsigned 32-bit x3 vertex format.
export const GPU_VERTEX_FORMAT_UINT32X3: GpuVertexFormat = GpuVertexFormat(25);
/// Unsigned 32-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_UINT32X4: GpuVertexFormat = GpuVertexFormat(26);
/// Signed 32-bit vertex format.
export const GPU_VERTEX_FORMAT_SINT32: GpuVertexFormat = GpuVertexFormat(27);
/// Signed 32-bit x2 vertex format.
export const GPU_VERTEX_FORMAT_SINT32X2: GpuVertexFormat = GpuVertexFormat(28);
/// Signed 32-bit x3 vertex format.
export const GPU_VERTEX_FORMAT_SINT32X3: GpuVertexFormat = GpuVertexFormat(29);
/// Signed 32-bit x4 vertex format.
export const GPU_VERTEX_FORMAT_SINT32X4: GpuVertexFormat = GpuVertexFormat(30);
/// Packed normalized 10:10:10:2 vertex format.
export const GPU_VERTEX_FORMAT_UNORM10_10_10_2: GpuVertexFormat = GpuVertexFormat(31);
/// 8-bit BGRA normalized vertex format.
export const GPU_VERTEX_FORMAT_UNORM8X4_BGRA: GpuVertexFormat = GpuVertexFormat(32);
/// Unsigned 8-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_UINT8: GpuVertexFormat = GpuVertexFormat(33);
/// Signed 8-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_SINT8: GpuVertexFormat = GpuVertexFormat(34);
/// Unsigned normalized 8-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_UNORM8: GpuVertexFormat = GpuVertexFormat(35);
/// Signed normalized 8-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_SNORM8: GpuVertexFormat = GpuVertexFormat(36);
/// Unsigned 16-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_UINT16: GpuVertexFormat = GpuVertexFormat(37);
/// Signed 16-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_SINT16: GpuVertexFormat = GpuVertexFormat(38);
/// Unsigned normalized 16-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_UNORM16: GpuVertexFormat = GpuVertexFormat(39);
/// Signed normalized 16-bit scalar vertex format.
export const GPU_VERTEX_FORMAT_SNORM16: GpuVertexFormat = GpuVertexFormat(40);
/// 16-bit float scalar vertex format.
export const GPU_VERTEX_FORMAT_FLOAT16: GpuVertexFormat = GpuVertexFormat(41);
/// 64-bit float scalar vertex format.
export const GPU_VERTEX_FORMAT_FLOAT64: GpuVertexFormat = GpuVertexFormat(42);
/// 64-bit float x2 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT64X2: GpuVertexFormat = GpuVertexFormat(43);
/// 64-bit float x3 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT64X3: GpuVertexFormat = GpuVertexFormat(44);
/// 64-bit float x4 vertex format.
export const GPU_VERTEX_FORMAT_FLOAT64X4: GpuVertexFormat = GpuVertexFormat(45);

/// Vertex attribute descriptor.
export struct GpuVertexAttribute {
    /// Vertex attribute format selector.
    format: GpuVertexFormat;
    /// Byte offset for this attribute within one vertex element.
    offset: uint64;
    /// Shader location index.
    shaderLocation: uint32;
}

/// Vertex buffer layout descriptor.
export struct GpuVertexBufferLayout {
    /// Vertex buffer slot index.
    slot: uint32;
    /// Vertex buffer stride in bytes.
    arrayStride: uint64;
    /// Vertex layout step mode selector.
    stepMode: GpuVertexStepMode;
    /// Vertex attributes consumed from this buffer.
    attributes: Slice<GpuVertexAttribute>;
}

/// Vertex layout step mode selector.
export enum GpuVertexStepMode {
    /// Advance attributes per vertex.
    Vertex = 1,
    /// Advance attributes per instance.
    Instance = 2,
}

/// Primitive topology selector.
export enum GpuPrimitiveTopology {
    /// Point-list topology.
    PointList = 0,
    /// Line-list topology.
    LineList = 1,
    /// Line-strip topology.
    LineStrip = 2,
    /// Triangle-list topology.
    TriangleList = 3,
    /// Triangle-strip topology.
    TriangleStrip = 4,
}

/// Front-face winding selector.
export enum GpuFrontFace {
    /// Counter-clockwise front-face winding.
    Ccw = 0,
    /// Clockwise front-face winding.
    Cw = 1,
}

/// Face-culling selector.
export enum GpuCullMode {
    /// Disable face culling.
    None = 0,
    /// Cull front faces.
    Front = 1,
    /// Cull back faces.
    Back = 2,
}

/// Polygon rasterization selector.
export enum GpuPolygonMode {
    /// Rasterize filled polygons.
    Fill = 0,
    /// Rasterize polygon edges as lines.
    Line = 1,
    /// Rasterize polygon vertices as points.
    Point = 2,
}

/// Blend factor selector.
export enum GpuBlendFactor {
    /// Zero factor.
    Zero = 0,
    /// One factor.
    One = 1,
    /// Source color factor.
    Src = 2,
    /// One-minus source color factor.
    OneMinusSrc = 3,
    /// Source alpha factor.
    SrcAlpha = 4,
    /// One-minus source alpha factor.
    OneMinusSrcAlpha = 5,
    /// Destination color factor.
    Dst = 6,
    /// One-minus destination color factor.
    OneMinusDst = 7,
    /// Destination alpha factor.
    DstAlpha = 8,
    /// One-minus destination alpha factor.
    OneMinusDstAlpha = 9,
    /// Source-alpha-saturated factor.
    SrcAlphaSaturated = 10,
    /// Constant-blend-color factor.
    Constant = 11,
    /// One-minus constant-blend-color factor.
    OneMinusConstant = 12,
    /// Secondary source color factor.
    Src1 = 13,
    /// One-minus secondary source color factor.
    OneMinusSrc1 = 14,
    /// Secondary source alpha factor.
    Src1Alpha = 15,
    /// One-minus secondary source alpha factor.
    OneMinusSrc1Alpha = 16,
}

/// Blend operation selector.
export enum GpuBlendOperation {
    /// Additive blend operation.
    Add = 0,
    /// Source minus destination operation.
    Subtract = 1,
    /// Destination minus source operation.
    ReverseSubtract = 2,
    /// Minimum operation.
    Min = 3,
    /// Maximum operation.
    Max = 4,
}

/// Blend component descriptor.
export struct GpuBlendComponent {
    /// Source factor selector.
    srcFactor: GpuBlendFactor;
    /// Destination factor selector.
    dstFactor: GpuBlendFactor;
    /// Blend operation selector.
    operation: GpuBlendOperation;
}

/// Blend-state descriptor.
export struct GpuBlendState {
    /// Color blend component.
    color: GpuBlendComponent;
    /// Alpha blend component.
    alpha: GpuBlendComponent;
}

/// Color-write channel mask.
export newtype GpuColorWriteMask = uint32;

/// Color-write bit for red.
export const GPU_COLOR_WRITE_RED: GpuColorWriteMask = GpuColorWriteMask(0x1);
/// Color-write bit for green.
export const GPU_COLOR_WRITE_GREEN: GpuColorWriteMask = GpuColorWriteMask(0x2);
/// Color-write bit for blue.
export const GPU_COLOR_WRITE_BLUE: GpuColorWriteMask = GpuColorWriteMask(0x4);
/// Color-write bit for alpha.
export const GPU_COLOR_WRITE_ALPHA: GpuColorWriteMask = GpuColorWriteMask(0x8);
/// Color-write bits for RGB.
export const GPU_COLOR_WRITE_COLOR: GpuColorWriteMask = GpuColorWriteMask(0x7);
/// Color-write bits for RGBA.
export const GPU_COLOR_WRITE_ALL: GpuColorWriteMask = GpuColorWriteMask(0xf);

/// Color-target descriptor.
export struct GpuColorTargetState {
    /// Render-target texture format identifier.
    format: GpuTextureFormat;
    /// Blend-state descriptor when provided.
    blend: GpuBlendState | void;
    /// Color-write channel mask.
    writeMask: GpuColorWriteMask;
}

/// Primitive-state descriptor.
export struct GpuPrimitiveState {
    /// Primitive topology selector.
    topology: GpuPrimitiveTopology;
    /// Strip index format selector when one strip topology uses indices.
    stripIndexFormat: GpuIndexFormat | void;
    /// Front-face winding selector.
    frontFace: GpuFrontFace;
    /// Face-culling selector.
    cullMode: GpuCullMode;
    /// Whether unclipped depth is enabled.
    unclippedDepth: boolean;
    /// Polygon rasterization selector.
    polygonMode: GpuPolygonMode;
    /// Whether conservative rasterization is enabled.
    conservative: boolean;
}

/// Stencil operation selector.
export enum GpuStencilOperation {
    /// Keep the current stencil value.
    Keep = 0,
    /// Set stencil to zero.
    Zero = 1,
    /// Replace stencil with the reference value.
    Replace = 2,
    /// Bitwise invert the current stencil value.
    Invert = 3,
    /// Increment and clamp stencil.
    IncrementClamp = 4,
    /// Decrement and clamp stencil.
    DecrementClamp = 5,
    /// Increment and wrap stencil.
    IncrementWrap = 6,
    /// Decrement and wrap stencil.
    DecrementWrap = 7,
}

/// Index element format selector.
export enum GpuIndexFormat {
    /// Unsigned 16-bit indices.
    Uint16 = 0,
    /// Unsigned 32-bit indices.
    Uint32 = 1,
}

/// Stencil-face-state descriptor.
export struct GpuStencilFaceState {
    /// Compare selector for this face.
    compare: GpuCompareFunction;
    /// Operation when stencil test fails.
    failOp: GpuStencilOperation;
    /// Operation when depth test fails.
    depthFailOp: GpuStencilOperation;
    /// Operation when both tests pass.
    passOp: GpuStencilOperation;
}

/// Depth-stencil-state descriptor.
export struct GpuDepthStencilState {
    /// Depth-stencil texture format identifier.
    format: GpuTextureFormat;
    /// Whether depth writes are enabled.
    depthWriteEnabled: boolean;
    /// Depth compare selector.
    depthCompare: GpuCompareFunction;
    /// Front-face stencil-state descriptor.
    stencilFront: GpuStencilFaceState;
    /// Back-face stencil-state descriptor.
    stencilBack: GpuStencilFaceState;
    /// Stencil read mask.
    stencilReadMask: uint32;
    /// Stencil write mask.
    stencilWriteMask: uint32;
    /// Constant depth-bias value.
    depthBias: int32;
    /// Depth-bias slope scale.
    depthBiasSlopeScale: float64;
    /// Depth-bias clamp value.
    depthBiasClamp: float64;
}

/// Multisample-state descriptor.
export struct GpuMultisampleState {
    /// Sample count.
    count: uint32;
    /// Active sample mask.
    mask: uint64;
    /// Whether alpha-to-coverage is enabled.
    alphaToCoverageEnabled: boolean;
}

/// Pipeline constants descriptor.
export struct GpuPipelineConstant {
    /// Constant identifier key.
    key: string;
    /// Constant value as float64.
    value: float64;
}

/// Fragment-state descriptor.
export struct GpuFragmentState {
    /// Fragment shader-module handle.
    module: GpuShaderHandle;
    /// Fragment entry point when provided.
    entry: string | void;
    /// Fragment-stage specialization constants.
    constants: Slice<GpuPipelineConstant>;
    /// Color-target states.
    targets: Slice<GpuColorTargetState>;
}

/// Vertex-state descriptor.
export struct GpuVertexState {
    /// Vertex shader-module handle.
    module: GpuShaderHandle;
    /// Vertex entry point when provided.
    entry: string | void;
    /// Vertex-stage specialization constants.
    constants: Slice<GpuPipelineConstant>;
    /// Vertex buffer layouts.
    buffers: Slice<GpuVertexBufferLayout>;
}

/// Compute-state descriptor.
export struct GpuComputeState {
    /// Compute shader-module handle.
    module: GpuShaderHandle;
    /// Compute entry point when provided.
    entry: string | void;
    /// Compute-stage specialization constants.
    constants: Slice<GpuPipelineConstant>;
}

/// Render-state descriptor.
export struct GpuRenderState {
    /// Primitive-state descriptor.
    primitive: GpuPrimitiveState;
    /// Depth-stencil-state descriptor when enabled.
    depthStencil: GpuDepthStencilState | void;
    /// Multisample-state descriptor.
    multisample: GpuMultisampleState;
}

/// Compute pipeline creation options.
export struct GpuComputePipelineOptions {
    /// Debug label.
    label: string;
    /// Explicit pipeline layout handle when provided.
    layout: GpuPipelineLayoutHandle | void;
    /// Compute stage descriptor.
    compute: GpuComputeState;
    /// Pipeline option flags.
    flags: uint32;
}

/// Render pipeline creation options.
export struct GpuRenderPipelineOptions {
    /// Debug label.
    label: string;
    /// Explicit pipeline layout handle when provided.
    layout: GpuPipelineLayoutHandle | void;
    /// Vertex stage descriptor.
    vertex: GpuVertexState;
    /// Fragment stage descriptor when configured.
    fragment: GpuFragmentState | void;
    /// Render-state descriptor.
    render: GpuRenderState;
    /// Multiview mask when configured.
    multiviewMask: uint32 | void;
    /// Pipeline option flags.
    flags: uint32;
}

/// Create a shader module.
@binding("destack.gpu.pipeline.shaderCreate", {
    effect: "external",
    requires: ["gpu.shader"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function shaderCreate(
    device: GpuDeviceHandle,
    options: GpuShaderOptions,
    bytes: Slice<uint8>,
): Result<GpuShaderHandle, PlatformError>;

/// Destroy a shader module.
@binding("destack.gpu.pipeline.shaderDestroy", {
    effect: "external",
    requires: ["gpu.shader"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function shaderDestroy(handle: GpuShaderHandle): Result<void, PlatformError>;

/// Read a shader-compilation diagnostics snapshot.
@binding("destack.gpu.pipeline.shaderCompilationInfo", {
    effect: "external",
    requires: ["gpu.shader"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function shaderCompilationInfo(
    handle: GpuShaderHandle,
    timeoutNs: uint64,
): Result<GpuCompilationInfo, PlatformError>;

/// Create a compute pipeline.
@binding("destack.gpu.pipeline.computeCreate", {
    effect: "external",
    requires: ["gpu.compute"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function computePipelineCreate(
    device: GpuDeviceHandle,
    options: GpuComputePipelineOptions,
): Result<GpuPipelineHandle, PlatformError>;

/// Create a render pipeline.
@binding("destack.gpu.pipeline.renderCreate", {
    effect: "external",
    requires: ["gpu.render"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function renderPipelineCreate(
    device: GpuDeviceHandle,
    options: GpuRenderPipelineOptions,
): Result<GpuPipelineHandle, PlatformError>;

/// Resolve one bind-group layout from one pipeline.
@binding("destack.gpu.pipeline.bindGroupLayout", {
    effect: "external",
    requires: ["gpu.bind"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipelineBindGroupLayout(
    pipeline: GpuPipelineHandle,
    groupIndex: uint32,
): Result<GpuBindGroupLayoutHandle, PlatformError>;

/// Destroy a pipeline object.
@binding("destack.gpu.pipeline.destroy", {
    effect: "external",
    requires: ["gpu.compute", "gpu.render"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pipelineDestroy(handle: GpuPipelineHandle): Result<void, PlatformError>;
