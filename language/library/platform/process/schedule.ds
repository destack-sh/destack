import type { PlatformError } from "../error/index.ds";
import { ThreadCpuSet } from "../thread/sched.ds";
import { ProcessId } from "./identity.ds";

/// Process scheduler policy.
export enum ProcessSchedulerPolicy {
    /// Default timesharing policy.
    Other = 1,
    /// First-in-first-out real-time policy.
    Fifo = 2,
    /// Round-robin real-time policy.
    RoundRobin = 3,
    /// Batch scheduling policy.
    Batch = 4,
    /// Idle scheduling policy.
    Idle = 5,
    /// Deadline scheduling policy.
    Deadline = 6,
}

/// Scheduler configuration for one process.
export struct ProcessSchedulerConfig {
    /// Scheduler policy.
    policy: ProcessSchedulerPolicy;
    /// Scheduler priority within the selected policy.
    priority: int32;
    /// Scheduler flags forwarded to host APIs.
    flags: uint32;
}

/// Read process priority.
@binding("destack.process.schedule.priority", {
    effect: "external",
    requires: ["process.priority"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getProcessPriority(pid: ProcessId): Result<int32, PlatformError>;

/// Set process priority.
@binding("destack.process.schedule.setPriority", {
    effect: "external",
    requires: ["process.priority"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setProcessPriority(
    pid: ProcessId,
    priority: int32,
): Result<void, PlatformError>;

/// Read process CPU affinity.
@binding("destack.process.schedule.affinity", {
    effect: "external",
    requires: ["process.affinity"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getProcessAffinity(pid: ProcessId): Result<ThreadCpuSet, PlatformError>;

/// Set process CPU affinity.
@binding("destack.process.schedule.setAffinity", {
    effect: "external",
    requires: ["process.affinity"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setProcessAffinity(
    pid: ProcessId,
    cpus: &readonly ThreadCpuSet,
): Result<void, PlatformError>;

/// Read scheduler policy and priority for a process.
@binding("destack.process.schedule.scheduler", {
    effect: "external",
    requires: ["process.scheduler"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getProcessScheduler(
    pid: ProcessId,
): Result<ProcessSchedulerConfig, PlatformError>;

/// Set scheduler policy and priority for a process.
@binding("destack.process.schedule.setScheduler", {
    effect: "external",
    requires: ["process.scheduler"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setProcessScheduler(
    pid: ProcessId,
    config: ProcessSchedulerConfig,
): Result<void, PlatformError>;
