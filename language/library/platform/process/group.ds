import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { ProcessId } from "./ids.ds";
import { ProcessLimit, ProcessLimitResource } from "./limits.ds";

/// Join one control group.
@binding("destack.process.group.cgroupJoin", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.cgroup"],
    platforms: ["linux"],
    simulation: true,
})
export declare function cgroupJoin(path: string): Result<void, PlatformError>;

/// Read one control-group resource limit.
@binding("destack.process.group.cgroupGetLimit", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.cgroup"],
    platforms: ["linux"],
    simulation: true,
})
export declare function cgroupGetLimit(
    path: string,
    resource: ProcessLimitResource,
): Result<ProcessLimit, PlatformError>;

/// Write one control-group resource limit.
@binding("destack.process.group.cgroupSetLimit", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.cgroup"],
    platforms: ["linux"],
    simulation: true,
})
export declare function cgroupSetLimit(
    path: string,
    resource: ProcessLimitResource,
    limit: ProcessLimit,
): Result<void, PlatformError>;

/// Assign processes to one Windows job object.
@binding("destack.process.group.jobAssign", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.cgroup"],
    platforms: ["windows"],
    simulation: true,
})
export declare function jobAssign(name: string, pids: Slice<ProcessId>): Result<void, PlatformError>;

/// Set one Windows job object resource limit.
@binding("destack.process.group.jobSetLimit", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.cgroup"],
    platforms: ["windows"],
    simulation: true,
})
export declare function jobSetLimit(
    name: string,
    resource: ProcessLimitResource,
    limit: ProcessLimit,
): Result<void, PlatformError>;
