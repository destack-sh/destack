import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { SignalHandle } from "../resource/index.ds";
import { ProcessId } from "./ids.ds";

/// Signal number for process control.
export newtype Signal = uint32;

/// Signal mask operation selector.
export enum SignalMaskHow {
    /// Replace the active mask with the provided set.
    Set = 0,
    /// Add signals to the active mask.
    Block = 1,
    /// Remove signals from the active mask.
    Unblock = 2,
}

/// Signal event payload delivered by a subscription.
export struct SignalEvent {
    /// Signal number observed by the runtime.
    signal: Signal;
    /// Process id associated with the signal when provided by the platform.
    pid: ProcessId;
}

/// Send a signal to a target process.
@binding("destack.process.signals.kill", {
    effect: "external",
    requires: ["process.signal.send"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function kill(pid: ProcessId, signal: Signal): Result<void, PlatformError>;

/// Subscribe to one signal value.
@binding("destack.process.signals.signalSubscribe", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalSubscribe(signal: Signal): Result<SignalHandle, PlatformError>;

/// Remove a signal subscription handle.
@binding("destack.process.signals.signalUnsubscribe", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalUnsubscribe(handle: SignalHandle): Result<void, PlatformError>;

/// Receive the next signal event from a subscription.
@binding("destack.process.signals.signalReceive", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalReceive(handle: SignalHandle): Result<SignalEvent, PlatformError>;

/// Poll one signal event without blocking.
@binding("destack.process.signals.signalTryReceive", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalTryReceive(handle: SignalHandle): Result<SignalEvent, PlatformError>;

/// Read the current thread signal mask.
@binding("destack.process.signals.signalMaskRead", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalMaskRead(): Result<Signal[], PlatformError>;

/// Update the current thread signal mask.
@binding("destack.process.signals.signalMaskUpdate", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalMaskUpdate(
    how: SignalMaskHow,
    signals: Slice<Signal>,
): Result<void, PlatformError>;

/// Wait for one signal from a requested set.
@binding("destack.process.signals.signalWait", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalWait(signals: Slice<Signal>): Result<SignalEvent, PlatformError>;

/// Poll one signal from a requested set without blocking.
@binding("destack.process.signals.signalTryWait", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalTryWait(signals: Slice<Signal>): Result<SignalEvent, PlatformError>;
