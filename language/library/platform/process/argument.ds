import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";

/// Return the process argument vector.
@binding("destack.process.argument.list", {
    effect: "external",
    requires: ["process.arguments"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listArguments(): Result<^Array<^string>, PlatformError>;
