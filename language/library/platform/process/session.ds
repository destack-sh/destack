import { PlatformError } from "destack:platform/error";
import { ProcessId } from "./identity.ds";

/// Create a new Unix session and return the session leader id.
@binding("destack.process.session.create", {
    effect: "external",
    requires: ["process.session"],
    families: ["unix"],
    simulation: true,
})
export declare function createSession(): Result<ProcessId, PlatformError>;

/// Set the process group id for one Unix process.
@binding("destack.process.session.setGroup", {
    effect: "external",
    requires: ["process.session"],
    families: ["unix"],
    simulation: true,
})
export declare function setProcessGroup(
    pid: ProcessId,
    group: ProcessId,
): Result<void, PlatformError>;

/// Read the process group id for one Unix process.
@binding("destack.process.session.group", {
    effect: "external",
    requires: ["process.session"],
    families: ["unix"],
    simulation: true,
})
export declare function getProcessGroup(pid: ProcessId): Result<ProcessId, PlatformError>;
