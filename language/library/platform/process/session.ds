import type { PlatformError } from "../error/index.ds";
import { ProcessId } from "./ids.ds";

/// Create a new session and return the new session leader id.
@binding("destack.process.session.setsid", {
    effect: "external",
    requires: ["process.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setsid(): Result<ProcessId, PlatformError>;

/// Set a process group id for a process.
@binding("destack.process.session.setpgid", {
    effect: "external",
    requires: ["process.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setpgid(pid: ProcessId, pgid: ProcessId): Result<void, PlatformError>;

/// Read a process group id.
@binding("destack.process.session.getpgid", {
    effect: "external",
    requires: ["process.session"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getpgid(pid: ProcessId): Result<ProcessId, PlatformError>;
