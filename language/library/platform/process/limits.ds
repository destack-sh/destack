import type { PlatformError } from "../error/index.ds";

/// Process resource limit selector.
export newtype ProcessLimitResource = uint32;

/// Process resource limit payload.
export struct ProcessLimit {
    /// Soft limit value.
    soft: uint64;
    /// Hard limit value.
    hard: uint64;
}

/// Read a process resource limit.
@binding("destack.process.limits.getLimit", {
    effect: "external",
    requires: ["process.run"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getLimit(resource: ProcessLimitResource): Result<ProcessLimit, PlatformError>;

/// Set a process resource limit.
@binding("destack.process.limits.setLimit", {
    effect: "external",
    requires: ["process.run"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setLimit(
    resource: ProcessLimitResource,
    limit: ProcessLimit,
): Result<void, PlatformError>;
