import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Read an environment variable by UTF-8 name.
@binding("destack.process.env.get", {
    effect: "external",
    requires: ["env.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envGet(name: string): Result<string, PlatformError>;

/// Set an environment variable by UTF-8 name and value.
@binding("destack.process.env.set", {
    effect: "external",
    requires: ["env.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envSet(name: string, value: string): Result<void, PlatformError>;

/// Delete an environment variable by UTF-8 name.
@binding("destack.process.env.delete", {
    effect: "external",
    requires: ["env.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envDelete(name: string): Result<void, PlatformError>;

/// Read an environment variable by raw byte name.
@binding("destack.process.env.getBytes", {
    effect: "external",
    requires: ["env.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envGetBytes(name: Slice<uint8>): Result<uint8[], PlatformError>;

/// Set an environment variable by raw byte name and value.
@binding("destack.process.env.setBytes", {
    effect: "external",
    requires: ["env.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envSetBytes(
    name: Slice<uint8>,
    value: Slice<uint8>,
): Result<void, PlatformError>;

/// Delete an environment variable by raw byte name.
@binding("destack.process.env.deleteBytes", {
    effect: "external",
    requires: ["env.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function envDeleteBytes(name: Slice<uint8>): Result<void, PlatformError>;
