import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Return the process argument vector.
@binding("destack.process.args.list", {
    effect: "external",
    requires: ["process.run"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function args(): Result<Slice<string>, PlatformError>;
