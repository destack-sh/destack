import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { DirectoryHandle, FileHandle } from "../resource/index.ds";
import { Path } from "../fs/path.ds";

/// Flags for `execat` operations.
export newtype ExecAtFlags = uint32;

/// Replace the current process image with a command path.
@binding("destack.process.exec.path", {
    effect: "external",
    requires: ["process.exec"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function exec(
    command: Path,
    arguments: Slice<string>,
    environment: Slice<string>,
): Result<void, PlatformError>;

/// Replace the current process image using a directory-relative path.
@binding("destack.process.exec.pathat", {
    effect: "external",
    requires: ["process.exec"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function execat(
    directory: DirectoryHandle,
    path: Path,
    arguments: Slice<string>,
    environment: Slice<string>,
    flags: ExecAtFlags,
): Result<void, PlatformError>;

/// Replace the current process image using an executable file handle.
@binding("destack.process.exec.fexec", {
    effect: "external",
    requires: ["process.exec"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function fexec(
    executable: FileHandle,
    arguments: Slice<string>,
    environment: Slice<string>,
): Result<void, PlatformError>;
