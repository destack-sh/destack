import { PlatformError } from "destack:platform/error";
import { ProcessHandle, SignalHandle } from "destack:platform/resource";
import { ProcessId } from "./identity.ds";

/// Signal number for process control.
export newtype Signal = uint32;

/// Signal event payload delivered by a subscription.
export struct SignalEvent {
    /// Signal number observed by the runtime.
    signal: Signal;
    /// Process id associated with the signal.
    pid?: ProcessId;
}

/// Send a signal to a target process.
@binding("destack.process.signal.send", {
    effect: "external",
    requires: ["process.signal.send"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function sendSignal(pid: ProcessId, signal: Signal): Result<void, PlatformError>;

/// Send a signal to a target process handle.
@binding("destack.process.signal.handle", {
    effect: "external",
    requires: ["process.signal.send"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function signalProcess(
    process: ProcessHandle,
    signal: Signal,
): Result<void, PlatformError>;

/// Subscribe to one signal value.
@binding("destack.process.signal.subscribe", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function subscribeSignal(signal: Signal): Result<SignalHandle, PlatformError>;

/// Remove a signal subscription handle.
@binding("destack.process.signal.unsubscribe", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unsubscribeSignal(handle: SignalHandle): Result<void, PlatformError>;

/// Receive the next signal event from a subscription.
@binding("destack.process.signal.receive", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function receiveSignal(handle: SignalHandle): Result<SignalEvent, PlatformError>;

/// Poll one signal event without blocking.
@binding("destack.process.signal.tryReceive", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function tryReceiveSignal(handle: SignalHandle): Result<SignalEvent, PlatformError>;

/// Wait for one signal from a requested set.
@binding("destack.process.signal.wait", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitSignal(
    signals: &readonly [Signal],
): Result<SignalEvent, PlatformError>;

/// Poll one signal from a requested set without blocking.
@binding("destack.process.signal.tryWait", {
    effect: "external",
    requires: ["process.signal.receive"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function tryWaitSignal(
    signals: &readonly [Signal],
): Result<SignalEvent, PlatformError>;
