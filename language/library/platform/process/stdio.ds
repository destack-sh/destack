import { PlatformError } from "destack:platform/error";
import { FileHandle } from "destack:platform/resource";

/// Open the current process standard input stream.
@binding("destack.process.stdio.input", {
    effect: "external",
    requires: ["process.stdio"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openStandardInput(): Result<FileHandle, PlatformError>;

/// Open the current process standard output stream.
@binding("destack.process.stdio.output", {
    effect: "external",
    requires: ["process.stdio"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openStandardOutput(): Result<FileHandle, PlatformError>;

/// Open the current process standard error stream.
@binding("destack.process.stdio.error", {
    effect: "external",
    requires: ["process.stdio"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openStandardError(): Result<FileHandle, PlatformError>;
