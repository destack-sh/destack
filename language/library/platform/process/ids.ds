import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Process identifier.
export newtype ProcessId = uint32;

/// User identifier.
export newtype UserId = uint32;

/// Group identifier.
export newtype GroupId = uint32;

/// Real, effective, and saved-set user identifiers.
export struct ProcessUserIds {
    /// Real user identifier.
    real: UserId;
    /// Effective user identifier.
    effective: UserId;
    /// Saved-set user identifier.
    saved: UserId;
}

/// Real, effective, and saved-set group identifiers.
export struct ProcessGroupIds {
    /// Real group identifier.
    real: GroupId;
    /// Effective group identifier.
    effective: GroupId;
    /// Saved-set group identifier.
    saved: GroupId;
}

/// Return the current process identifier.
@binding("destack.process.ids.pid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pid(): Result<ProcessId, PlatformError>;

/// Return the parent process identifier.
@binding("destack.process.ids.ppid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function ppid(): Result<ProcessId, PlatformError>;

/// Return the current user identifier.
@binding("destack.process.ids.uid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function uid(): Result<UserId, PlatformError>;

/// Return the current group identifier.
@binding("destack.process.ids.gid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function gid(): Result<GroupId, PlatformError>;

/// Return the effective user identifier.
@binding("destack.process.ids.euid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function euid(): Result<UserId, PlatformError>;

/// Return the effective group identifier.
@binding("destack.process.ids.egid", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function egid(): Result<GroupId, PlatformError>;

/// Return real, effective, and saved-set user identifiers.
@binding("destack.process.ids.userIds", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function userIds(): Result<ProcessUserIds, PlatformError>;

/// Return real, effective, and saved-set group identifiers.
@binding("destack.process.ids.groupIds", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function groupIds(): Result<ProcessGroupIds, PlatformError>;

/// Set the effective user identifier.
@binding("destack.process.ids.setUid", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setUid(userId: UserId): Result<void, PlatformError>;

/// Set the effective user identifier only.
@binding("destack.process.ids.setEuid", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setEuid(userId: UserId): Result<void, PlatformError>;

/// Set the effective group identifier.
@binding("destack.process.ids.setGid", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setGid(groupId: GroupId): Result<void, PlatformError>;

/// Set the effective group identifier only.
@binding("destack.process.ids.setEgid", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setEgid(groupId: GroupId): Result<void, PlatformError>;

/// Set real, effective, and saved-set user identifiers together.
@binding("destack.process.ids.setUserIds", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setUserIds(ids: ProcessUserIds): Result<void, PlatformError>;

/// Set real, effective, and saved-set group identifiers together.
@binding("destack.process.ids.setGroupIds", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setGroupIds(ids: ProcessGroupIds): Result<void, PlatformError>;

/// Return supplementary group identifiers.
@binding("destack.process.ids.groups", {
    effect: "external",
    requires: ["process.identity.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function groups(): Result<Slice<GroupId>, PlatformError>;

/// Set supplementary group identifiers.
@binding("destack.process.ids.setGroups", {
    effect: "external",
    requires: ["process.identity.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setGroups(groups: Slice<GroupId>): Result<void, PlatformError>;
