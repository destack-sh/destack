import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { FileHandle, PipeHandle, ProcessHandle } from "../resource/index.ds";
import { FileMode, OpenFlags } from "../fs/flags.ds";
import { OsPath } from "../fs/path.ds";

/// Inherit stdio from the parent process.
export struct ProcessStdioInherit {
    /// Discriminator for this stdio variant.
    kind: "inherit";
}

/// Connect stdio to one null sink.
export struct ProcessStdioNull {
    /// Discriminator for this stdio variant.
    kind: "null";
}

/// Connect stdio to one pipe endpoint.
export struct ProcessStdioPipe {
    /// Discriminator for this stdio variant.
    kind: "pipe";
    /// Pipe handle used for this stdio lane.
    pipe: PipeHandle;
}

/// Connect stdio to one existing file handle.
export struct ProcessStdioFile {
    /// Discriminator for this stdio variant.
    kind: "file";
    /// File handle used for this stdio lane.
    file: FileHandle;
}

/// Connect stdio to one existing numeric descriptor.
export struct ProcessStdioDescriptor {
    /// Discriminator for this stdio variant.
    kind: "descriptor";
    /// Numeric descriptor used for this stdio lane.
    descriptor: int32;
}

/// Stdio entry for process spawning.
export newtype ProcessStdio =
    | ProcessStdioInherit
    | ProcessStdioNull
    | ProcessStdioPipe
    | ProcessStdioFile
    | ProcessStdioDescriptor;

/// Close one descriptor before exec.
export struct ProcessFdActionClose {
    /// Discriminator for this fd action variant.
    kind: "close";
    /// Descriptor to close.
    descriptor: int32;
}

/// Duplicate one descriptor onto another.
export struct ProcessFdActionDup2 {
    /// Discriminator for this fd action variant.
    kind: "dup2";
    /// Source descriptor.
    source: int32;
    /// Target descriptor.
    target: int32;
}

/// Open one path and bind it to one descriptor.
export struct ProcessFdActionOpen {
    /// Discriminator for this fd action variant.
    kind: "open";
    /// Target descriptor.
    target: int32;
    /// Path used by open action.
    path: OsPath;
    /// Open flags for open action.
    flags: OpenFlags;
    /// Open mode for open action.
    mode: FileMode;
}

/// File descriptor action for process spawning.
export newtype ProcessFdAction = ProcessFdActionClose | ProcessFdActionDup2 | ProcessFdActionOpen;

/// Process spawn options.
export struct ProcessSpawnOptions {
    /// Current directory for the child process.
    cwd: OsPath;
    /// Whether to create a detached child process.
    detached: boolean;
    /// Whether to reset signal dispositions in the child.
    resetSignals: boolean;
    /// Whether to create a new process group.
    newProcessGroup: boolean;
}

/// Spawn a child process with default stdio inheritance.
///
/// Spawn one child process using the provided command, argv, envp, and spawn options.
/// Descriptor inheritance and process-group behavior follow host process-launch semantics.
///
/// # Platform
/// Unix and Windows.
/// Uses posix_spawn or fork-plus-exec on Unix and CreateProcessW on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, processSpawnFailed, notSupported.
///
/// # Security
/// Requires `process.spawn`.
///
/// # Replay
/// External, recordable.
@binding("destack.process.spawn.start", {
    effect: "external",
    replay: "recordable",
    capabilities: ["process.spawn"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function spawn(
    command: OsPath,
    arguments: Slice<string>,
    environment: Slice<string>,
    options: ProcessSpawnOptions,
): Result<ProcessHandle, PlatformError>;

/// Spawn a child process with explicit stdio and descriptor actions.
///
/// Spawn one child process and apply explicit stdio wiring and descriptor action scripts.
/// File-action ordering and inheritance behavior follow host spawn primitives.
///
/// # Platform
/// Unix and Windows.
/// Uses posix_spawn_file_actions on Unix and handle-inheritance setup on Windows.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, processSpawnFailed, notSupported.
///
/// # Security
/// Requires `process.spawn`.
///
/// # Replay
/// External, recordable.
@binding("destack.process.spawn.withActions", {
    effect: "external",
    replay: "recordable",
    capabilities: ["process.spawn", "process.spawn.actions"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function spawnWithActions(
    command: OsPath,
    arguments: Slice<string>,
    environment: Slice<string>,
    options: ProcessSpawnOptions,
    stdio: Slice<ProcessStdio>,
    actions: Slice<ProcessFdAction>,
): Result<ProcessHandle, PlatformError>;
