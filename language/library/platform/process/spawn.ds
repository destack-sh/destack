import type { PlatformError } from "../error/index.ds";
import { FileOpenFlags } from "../fs/file.ds";
import { Path } from "../fs/path.ds";
import { FileMode } from "../fs/status.ds";
import { FileHandle, PipeHandle, ProcessHandle } from "../resource/index.ds";
import { EnvironmentVariable } from "./environment.ds";

/// Process spawn flags.
export newtype ProcessSpawnFlags = uint32;

/// Spawn the child detached from the parent lifetime.
export const PROCESS_DETACHED: ProcessSpawnFlags = ProcessSpawnFlags(0x1);

/// Spawn the child in a new process group.
export const PROCESS_NEW_GROUP: ProcessSpawnFlags = ProcessSpawnFlags(0x2);

/// Reset inherited signal dispositions before exec where supported.
export const PROCESS_RESET_SIGNALS: ProcessSpawnFlags = ProcessSpawnFlags(0x4);

/// Inherit the parent environment and apply explicit variables.
export const PROCESS_INHERIT_ENVIRONMENT: ProcessSpawnFlags = ProcessSpawnFlags(0x8);

/// Inherit a standard stream from the parent process.
export struct ProcessStdioInherit {
    /// Discriminator for this stdio variant.
    kind: "inherit";
}

/// Connect a standard stream to the host null device.
export struct ProcessStdioNull {
    /// Discriminator for this stdio variant.
    kind: "null";
}

/// Connect a standard stream to one pipe endpoint.
export struct ProcessStdioPipe {
    /// Discriminator for this stdio variant.
    kind: "pipe";
    /// Pipe endpoint used by the child.
    pipe: PipeHandle;
}

/// Connect a standard stream to one file handle.
export struct ProcessStdioFile {
    /// Discriminator for this stdio variant.
    kind: "file";
    /// File handle used by the child.
    file: FileHandle;
}

/// Connect a standard stream to one numeric descriptor.
export struct ProcessStdioDescriptor {
    /// Discriminator for this stdio variant.
    kind: "descriptor";
    /// Numeric descriptor used by the child.
    descriptor: int32;
}

/// Standard stream binding for process spawning.
export newtype ProcessStdio =
    | ProcessStdioInherit
    | ProcessStdioNull
    | ProcessStdioPipe
    | ProcessStdioFile
    | ProcessStdioDescriptor;

/// Close one descriptor in the child before exec.
export struct ProcessDescriptorClose {
    /// Discriminator for this descriptor action.
    kind: "close";
    /// Descriptor to close.
    descriptor: int32;
}

/// Duplicate one descriptor in the child before exec.
export struct ProcessDescriptorDuplicate {
    /// Discriminator for this descriptor action.
    kind: "duplicate";
    /// Source descriptor.
    source: int32;
    /// Target descriptor.
    target: int32;
}

/// Open one path onto one child descriptor before exec.
export struct ProcessDescriptorOpen {
    /// Discriminator for this descriptor action.
    kind: "open";
    /// Target descriptor.
    target: int32;
    /// Path opened by the descriptor action.
    path: Path;
    /// Open flags.
    flags: FileOpenFlags;
    /// Open mode.
    mode: FileMode;
}

/// Descriptor action for process spawning.
export newtype ProcessDescriptorAction =
    | ProcessDescriptorClose
    | ProcessDescriptorDuplicate
    | ProcessDescriptorOpen;

/// Process spawn options.
export struct ProcessSpawnOptions {
    /// Command path.
    command: Path;
    /// Argument zero override.
    argument0?: string;
    /// Argument vector excluding the command path.
    arguments: [string];
    /// Environment variables applied to the child.
    environment: [EnvironmentVariable];
    /// Child current directory.
    workingDirectory?: Path;
    /// Standard stream bindings in stdin, stdout, stderr order.
    stdio: [ProcessStdio];
    /// Descriptor actions applied before exec.
    descriptors: [ProcessDescriptorAction];
    /// Spawn behavior flags.
    flags: ProcessSpawnFlags;
}

/// Spawn a child process.
@binding("destack.process.spawn", {
    effect: "external",
    requires: ["process.spawn"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function spawn(
    options: &readonly ProcessSpawnOptions,
): Result<ProcessHandle, PlatformError>;
