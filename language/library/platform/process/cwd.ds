import type { PlatformError } from "../error/index.ds";
import { Path } from "../fs/path.ds";

/// Return the current working directory.
@binding("destack.process.cwd.get", {
    effect: "external",
    requires: ["process.workdir.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cwd(): Result<Path, PlatformError>;

/// Change the current working directory.
@binding("destack.process.cwd.chdir", {
    effect: "external",
    requires: ["process.workdir.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function chdir(path: Path): Result<void, PlatformError>;
