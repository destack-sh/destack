import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { ProcessId } from "./ids.ds";
import { Path } from "../fs/path.ds";

/// Flags for `unshare` operations.
export newtype ProcessUnshareFlags = uint64;

/// Flags for syscall-filter installation.
export newtype SyscallFilterFlags = uint32;

/// Process namespace kind.
export enum ProcessNamespaceKind {
    /// Mount namespace.
    Mount = 1,
    /// User namespace.
    User = 2,
    /// PID namespace.
    Pid = 3,
    /// Network namespace.
    Network = 4,
    /// IPC namespace.
    Ipc = 5,
    /// UTS namespace.
    Uts = 6,
    /// Cgroup namespace.
    Cgroup = 7,
    /// Time namespace.
    Time = 8,
}

/// Enter one namespace owned by another process.
@binding("destack.process.isolation.setns", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setns(
    pid: ProcessId,
    namespace: ProcessNamespaceKind,
): Result<void, PlatformError>;

/// Unshare one or more namespaces.
@binding("destack.process.isolation.unshare", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function unshare(flags: ProcessUnshareFlags): Result<void, PlatformError>;

/// Change the root directory for path resolution.
@binding("destack.process.isolation.chroot", {
    effect: "external",
    replay: "forbidden",
    requires: ["security.restrict"],
    families: ["unix"],
    simulation: true,
})
export declare function chroot(path: Path): Result<void, PlatformError>;

/// Install one syscall filter program.
@binding("destack.process.isolation.installSyscallFilter", {
    effect: "external",
    replay: "forbidden",
    requires: ["security.filter"],
    platforms: ["linux"],
    simulation: true,
})
export declare function installSyscallFilter(
    program: Array<uint8>,
    flags: SyscallFilterFlags,
): Result<void, PlatformError>;

/// Set process host name inside the active UTS namespace.
@binding("destack.process.isolation.setHostName", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.namespace"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setHostName(name: string): Result<void, PlatformError>;

/// Set network namespace context for subsequent network operations.
@binding("destack.process.isolation.setNetworkNamespace", {
    effect: "external",
    replay: "forbidden",
    requires: ["process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setNetworkNamespace(path: Path): Result<void, PlatformError>;
