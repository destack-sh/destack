import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Opaque identifier for a deterministic random stream.
export newtype RandomStream = uint64;

/// Deterministic random stream domain.
export enum RandomStreamDomain {
    /// The stream is process-local.
    Process = 1,
    /// The stream is task-local.
    Task = 2,
}

/// Encoded deterministic random stream state.
export struct RandomStreamState {
    /// Stream state version for compatibility checks.
    version: uint32;
    /// Encoded state payload bytes.
    bytes: Array<uint8>;
}

/// Allocate a deterministic random stream identifier.
@binding("destack.random.stream.create", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function stream(): Result<RandomStream, PlatformError>;

/// Allocate a deterministic random stream in one domain.
@binding("destack.random.stream.in", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function streamIn(domain: RandomStreamDomain): Result<RandomStream, PlatformError>;

/// Split a deterministic stream into one child stream.
@binding("destack.random.stream.split", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function streamSplit(parent: RandomStream): Result<RandomStream, PlatformError>;

/// Advance a deterministic stream by one jump count.
@binding("destack.random.stream.jump", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function streamJump(stream: RandomStream, jump: uint64): Result<void, PlatformError>;

/// Export deterministic stream state.
@binding("destack.random.stream.export", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function streamExport(stream: RandomStream): Result<RandomStreamState, PlatformError>;

/// Import deterministic stream state.
@binding("destack.random.stream.import", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function streamImport(
    stream: RandomStream,
    state: RandomStreamState,
): Result<void, PlatformError>;

/// Return a deterministic random uint64 from the default stream.
@binding("destack.random.stream.nextU64", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function nextU64(): Result<uint64, PlatformError>;

/// Return a deterministic random uint64 from a specific stream.
@binding("destack.random.stream.nextU64From", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function nextU64From(stream: RandomStream): Result<uint64, PlatformError>;

/// Fill a slice with deterministic random bytes from the default stream.
@binding("destack.random.stream.fillBytes", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function fillBytes(buffer: Slice<uint8>): Result<void, PlatformError>;

/// Fill a slice with deterministic random bytes from a specific stream.
@binding("destack.random.stream.fillBytesFrom", {
    effect: "external",
    requires: ["random.deterministic"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function fillBytesFrom(
    stream: RandomStream,
    buffer: Slice<uint8>,
): Result<void, PlatformError>;
