import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Host secure randomness source kind.
export enum SecureRandomSource {
    /// Host kernel random device or syscall.
    Kernel = 1,
    /// Host cryptographic provider service.
    SystemCryptoProvider = 2,
    /// Host hardware entropy source.
    Hardware = 3,
    /// Runtime virtualized entropy source.
    Virtualized = 4,
    /// Host source cannot be identified.
    Unknown = 5,
}

/// Host secure randomness source metadata.
export struct SecureRandomMetadata {
    /// Source kind for secure randomness.
    source: SecureRandomSource;
    /// Source backend label.
    backendName: string;
    /// Whether calls may block waiting for entropy.
    mayBlock: boolean;
    /// Whether the source is considered cryptographic.
    isCryptographic: boolean;
    /// Whether the source is currently seeded.
    isSeeded: boolean;
    /// Whether the source is validated for FIPS mode.
    isFipsApproved: boolean;
    /// Estimated entropy bits per output byte.
    entropyBitsPerByte: float64;
}

/// Fill a slice with cryptographically secure random bytes.
///
/// Read entropy from host cryptographic RNG facilities.
/// Entropy quality and blocking behavior follow host kernel guarantees.
///
/// # Platform
/// Unix and Windows where host entropy APIs are available.
/// Uses getrandom(2) or getentropy on Unix and BCryptGenRandom on Windows.
///
/// # Errors
/// Returns randomUnavailable, notSupported.
///
/// # Security
/// Requires `random.secure`.
///
/// # Replay
/// External, recordable.
@binding("destack.random.secure.bytes", {
    effect: "external",
    replay: "recordable",
    capabilities: ["random.secure"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "sometimes",
    affinity: "any",
})
export declare function secureBytes(buffer: Slice<uint8>): Result<void, PlatformError>;

/// Fill a slice with secure random bytes without blocking.
///
/// Try to read secure entropy without blocking the current execution context.
/// Fails with `ioWouldBlock` when the host source requires blocking.
///
/// # Platform
/// Unix and Windows where host entropy APIs are available.
/// Uses nonblocking host entropy APIs when available and runtime fallbacks otherwise.
///
/// # Errors
/// Returns randomUnavailable, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `random.secure`.
///
/// # Replay
/// External, recordable.
@binding("destack.random.secure.bytesTry", {
    effect: "external",
    replay: "recordable",
    capabilities: ["random.secure"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function secureBytesTry(buffer: Slice<uint8>): Result<void, PlatformError>;

/// Query secure randomness source metadata.
///
/// Return source metadata for the secure random backend selected by the runtime.
/// Metadata values are normalized across host operating systems.
///
/// # Platform
/// Unix and Windows where host entropy APIs are available.
/// Uses runtime source selection metadata.
///
/// # Errors
/// Returns randomUnavailable, notSupported.
///
/// # Security
/// Requires `random.secure`.
///
/// # Replay
/// External, recordable.
@binding("destack.random.secure.metadata", {
    effect: "external",
    replay: "recordable",
    capabilities: ["random.secure"],
    platforms: ["windows", "unix"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function secureMetadata(): Result<SecureRandomMetadata, PlatformError>;
