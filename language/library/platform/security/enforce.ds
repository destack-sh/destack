import { PlatformError } from "destack:platform/error";
import { HostAction } from "./action.ds";
import { SandboxHandle } from "destack:platform/resource";

/// Seal one sandbox policy.
@binding("destack.security.enforce.sandboxSeal", {
    effect: "deterministic",
    requires: ["security.restrict"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sandboxSeal(handle: SandboxHandle): Result<void, PlatformError>;

/// Apply an explicit action set to one sandbox scope.
@binding("destack.security.enforce.sandboxSetActions", {
    effect: "deterministic",
    requires: ["security.restrict"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sandboxSetActions(
    handle: SandboxHandle,
    requires: Slice<HostAction>,
): Result<void, PlatformError>;

/// Set runtime W^X policy.
@binding("destack.security.enforce.setWriteXorExecute", {
    effect: "deterministic",
    requires: ["security.restrict"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function setWriteXorExecute(enabled: boolean): Result<void, PlatformError>;
