import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { PermissionRequestHandle } from "destack:platform/resource";

/// Permission state.
export enum PermissionState {
    /// Access is granted.
    Granted = 1,
    /// Access is denied.
    Denied = 2,
    /// Access can be requested.
    Prompt = 3,
    /// Access is restricted by host policy.
    Restricted = 4,
    /// Access is granted with limited scope.
    Limited = 5,
}

/// Permission selector.
export enum Permission {
    /// Foreground location access.
    Location = 1,
    /// Background location access.
    LocationBackground = 2,
    /// Camera access.
    Camera = 3,
    /// Microphone access.
    Microphone = 4,
    /// Bluetooth access.
    Bluetooth = 5,
    /// Notification delivery permission.
    Notifications = 6,
    /// Contacts read access.
    ContactsRead = 7,
    /// Contacts write access.
    ContactsWrite = 8,
    /// Media-library read access.
    MediaRead = 9,
    /// Media-library write access.
    MediaWrite = 10,
    /// Motion or activity sensor access.
    Motion = 11,
    /// Clipboard read access.
    ClipboardRead = 12,
    /// Calendar read access.
    CalendarRead = 13,
    /// Calendar write access.
    CalendarWrite = 14,
}

/// Permission-state entry.
export struct PermissionEntry {
    /// Permission selector.
    permission: Permission;
    /// Permission state for this selector.
    state: PermissionState;
}

/// Read one permission state.
@binding("destack.security.permission.read", {
    effect: "external",
    requires: ["runtime.security.permission.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readPermission(
    permission: Permission,
): Result<PermissionState, PlatformError>;

/// Read permission states.
@binding("destack.security.permission.readMany", {
    effect: "external",
    requires: ["runtime.security.permission.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readPermissions(
    permissions: Array<Permission>,
): Result<Array<PermissionEntry>, PlatformError>;

/// Open one permission-request transaction.
@binding("destack.security.permission.request.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openPermissionRequest(
    permission: Permission,
): Result<PermissionRequestHandle, PlatformError>;

/// Open one multi-permission request transaction.
@binding("destack.security.permission.request.openMany", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openPermissionRequestMany(
    permissions: Array<Permission>,
): Result<PermissionRequestHandle, PlatformError>;

/// Close one permission-request transaction.
@binding("destack.security.permission.request.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closePermissionRequest(
    request: PermissionRequestHandle,
): Result<void, PlatformError>;

/// Wait for one permission-request result.
@binding("destack.security.permission.request.read", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readPermissionRequest(
    request: PermissionRequestHandle,
    timeoutNs: uint64,
): Result<Array<PermissionEntry>, PlatformError>;

/// Poll one permission-request result without blocking.
@binding("destack.security.permission.request.tryRead", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function tryReadPermissionRequest(
    request: PermissionRequestHandle,
): Result<Array<PermissionEntry>, PlatformError>;

/// Open host settings for runtime permissions.
@binding("destack.security.permission.settings.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.security.permission.request"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openPermissionSettings(): Result<void, PlatformError>;
