import { PlatformError } from "destack:platform/error";
import { SandboxHandle } from "destack:platform/resource";

/// Enter a sandbox scope.
@binding("destack.security.sandbox.enter", {
    effect: "external",
    requires: ["security.sandbox"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sandboxEnter(name: string): Result<SandboxHandle, PlatformError>;

/// Leave a sandbox scope.
@binding("destack.security.sandbox.exit", {
    effect: "external",
    requires: ["security.sandbox"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function sandboxExit(handle: SandboxHandle): Result<void, PlatformError>;
