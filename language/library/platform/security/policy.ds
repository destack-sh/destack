import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { Action } from "./action.ds";

/// Policy decision mode for one action entry.
export enum SecurityPolicyMode {
    /// Explicitly allow the action.
    Allow = 1,
    /// Explicitly deny the action.
    Deny = 2,
    /// Allow but emit diagnostics or audit records.
    Audit = 3,
}

/// Structured policy rule for one action.
export struct SecurityPolicyRule {
    /// Action selector for the rule.
    action: Action;
    /// Decision mode for the action.
    mode: SecurityPolicyMode;
}

/// Read policy actions for one named scope.
@binding("destack.security.policy.get", {
    effect: "deterministic",
    requires: ["runtime.security.policy.read"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function policyGet(provider: string): Result<Slice<Action>, PlatformError>;

/// Read structured policy rules for one named scope.
@binding("destack.security.policy.getRules", {
    effect: "deterministic",
    requires: ["runtime.security.policy.read"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function policyGetRules(provider: string): Result<Slice<SecurityPolicyRule>, PlatformError>;

/// Replace policy actions for one named scope.
@binding("destack.security.policy.set", {
    effect: "deterministic",
    requires: ["runtime.security.policy.write"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function policySet(
    provider: string,
    requires: Slice<Action>,
): Result<void, PlatformError>;

/// Replace structured policy rules for one named scope.
@binding("destack.security.policy.setRules", {
    effect: "deterministic",
    requires: ["runtime.security.policy.write"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function policySetRules(
    provider: string,
    rules: Slice<SecurityPolicyRule>,
): Result<void, PlatformError>;
