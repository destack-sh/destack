import { Slice } from "destack:collections";
import { Action } from "destack:platform/core";
import { PlatformError } from "destack:platform/error";

export { Action } from "destack:platform/core";

/// List active actions.
@binding("destack.security.action.list", {
    effect: "deterministic",
    requires: ["runtime.security.policy.read"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function actionList(): Result<Slice<Action>, PlatformError>;

/// Check one action.
@binding("destack.security.action.has", {
    effect: "deterministic",
    requires: ["runtime.security.policy.read"],
    families: ["windows", "unix"],
    provider: "runtime",
})
export declare function actionHas(action: Action): Result<boolean, PlatformError>;
