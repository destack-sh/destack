import { PlatformError } from "destack:platform/error";
import { FileHandle } from "destack:platform/resource";
import {
    MappedMemoryFlags,
    MappedMemorySyncFlags,
    MappedMemoryVisibility,
    MemoryProtection,
    VirtualMemoryRange,
} from "./types.ds";

/// Map a file backed memory range.
@binding("destack.memory.map.file", {
    effect: "external",
    requires: ["memory.map"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mapFileMemory(
    handle: FileHandle,
    offset: uint64,
    length: uint64,
    protection: MemoryProtection,
    visibility: MappedMemoryVisibility,
    flags: MappedMemoryFlags,
    addressHint?: uint64,
): Result<VirtualMemoryRange, PlatformError>;

/// Map an anonymous memory range.
@binding("destack.memory.map.anonymous", {
    effect: "external",
    requires: ["memory.map"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mapAnonymousMemory(
    length: uint64,
    protection: MemoryProtection,
    visibility: MappedMemoryVisibility,
    flags: MappedMemoryFlags,
    addressHint?: uint64,
): Result<VirtualMemoryRange, PlatformError>;

/// Unmap a mapped memory range.
@binding("destack.memory.map.unmap", {
    effect: "external",
    requires: ["memory.map"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unmapMemory(range: VirtualMemoryRange): Result<void, PlatformError>;

/// Flush mapped memory to backing storage.
@binding("destack.memory.map.sync", {
    effect: "external",
    requires: ["memory.map"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function syncMappedMemory(
    range: VirtualMemoryRange,
    flags: MappedMemorySyncFlags,
): Result<void, PlatformError>;
