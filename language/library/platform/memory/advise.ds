import type { PlatformError } from "../error/index.ds";
import { MemoryAdvice } from "./types.ds";

/// Apply memory access advice.
@binding("destack.memory.advise.adviseRange", {
    effect: "external",
    requires: ["memory.advise"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function advise(
    address: uint64,
    length: uint64,
    advice: MemoryAdvice,
): Result<void, PlatformError>;

/// Discard memory contents.
@binding("destack.memory.advise.discard", {
    effect: "external",
    requires: ["memory.advise"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function discard(address: uint64, length: uint64): Result<void, PlatformError>;
