import { PlatformError } from "destack:platform/error";
import { VirtualMemoryRange } from "./virtual.ds";

/// Memory access pattern advice selector.
export enum MemoryAdvice {
    /// No special access pattern.
    Normal = 0,
    /// Expect mostly sequential access.
    Sequential = 1,
    /// Expect mostly random access.
    Random = 2,
    /// Pages will be needed soon.
    WillNeed = 3,
    /// Pages will not be needed soon.
    DontNeed = 4,
}

/// Apply memory access advice.
@binding("destack.memory.advise", {
    effect: "external",
    requires: ["memory.advise"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function adviseMemory(
    range: VirtualMemoryRange,
    advice: MemoryAdvice,
): Result<void, PlatformError>;

/// Discard memory contents.
@binding("destack.memory.discard", {
    effect: "external",
    requires: ["memory.discard"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function discardMemory(range: VirtualMemoryRange): Result<void, PlatformError>;
