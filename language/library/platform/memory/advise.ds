import type { PlatformError } from "../error/index.ds";
import { MemoryAdvice, VirtualMemoryRange } from "./types.ds";

/// Apply memory access advice.
@binding("destack.memory.advise", {
    effect: "external",
    requires: ["memory.advise"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function adviseMemory(
    range: VirtualMemoryRange,
    advice: MemoryAdvice,
): Result<void, PlatformError>;

/// Discard memory contents.
@binding("destack.memory.discard", {
    effect: "external",
    requires: ["memory.discard"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function discardMemory(range: VirtualMemoryRange): Result<void, PlatformError>;
