import { PlatformError } from "destack:platform/error";
import {
    MemoryProtection,
    VirtualMemoryRange,
    VirtualMemoryReserveFlags,
} from "./types.ds";

/// Reserve one virtual memory range.
@binding("destack.memory.virtual.reserve", {
    effect: "external",
    requires: ["memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function reserveVirtualMemory(
    length: uint64,
    flags: VirtualMemoryReserveFlags,
    addressHint?: uint64,
): Result<VirtualMemoryRange, PlatformError>;

/// Commit physical backing for one reserved virtual memory range.
@binding("destack.memory.virtual.commit", {
    effect: "external",
    requires: ["memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commitVirtualMemory(
    range: VirtualMemoryRange,
    protection: MemoryProtection,
): Result<void, PlatformError>;

/// Decommit physical backing from one virtual memory range.
@binding("destack.memory.virtual.decommit", {
    effect: "external",
    requires: ["memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function decommitVirtualMemory(range: VirtualMemoryRange): Result<void, PlatformError>;

/// Release one reserved virtual memory range.
@binding("destack.memory.virtual.release", {
    effect: "external",
    requires: ["memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function releaseVirtualMemory(range: VirtualMemoryRange): Result<void, PlatformError>;

/// Change virtual memory protection for one range.
@binding("destack.memory.virtual.protect", {
    effect: "external",
    requires: ["memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function protectVirtualMemory(
    range: VirtualMemoryRange,
    protection: MemoryProtection,
): Result<void, PlatformError>;

/// Flush instruction cache for one executable memory range.
@binding("destack.memory.virtual.instructionCache.flush", {
    effect: "external",
    requires: ["memory.execute"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function flushInstructionCache(range: VirtualMemoryRange): Result<void, PlatformError>;
