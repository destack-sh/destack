/// Bitmask of virtual-memory protection permissions.
export newtype MemoryProtection = uint32;

/// Flags for virtual-memory reserve and allocate operations.
export newtype MemoryReserveFlags = uint32;

/// Flags for file and anonymous memory mappings.
export newtype MemoryMapFlags = uint32;

/// Flags for virtual-memory remap operations.
export newtype MemoryRemapFlags = uint32;

/// Flags for flushing mapped memory.
export newtype MemorySyncFlags = uint32;

/// Memory access-pattern advice selector.
export enum MemoryAdvice {
    /// No special access pattern.
    Normal = 0,
    /// Expect mostly sequential access.
    Sequential = 1,
    /// Expect mostly random access.
    Random = 2,
    /// Pages will be needed soon.
    WillNeed = 3,
    /// Pages will not be needed soon.
    DontNeed = 4,
}

/// No protection bits.
export const MEMORY_PROTECTION_NONE: MemoryProtection = MemoryProtection(0x0);
/// Allow reads from mapped pages.
export const MEMORY_PROTECTION_READ: MemoryProtection = MemoryProtection(0x1);
/// Allow writes to mapped pages.
export const MEMORY_PROTECTION_WRITE: MemoryProtection = MemoryProtection(0x2);
/// Allow instruction fetch from mapped pages.
export const MEMORY_PROTECTION_EXECUTE: MemoryProtection = MemoryProtection(0x4);

/// No reserve flags.
export const MEMORY_RESERVE_NONE: MemoryReserveFlags = MemoryReserveFlags(0x0);
/// Prefer high virtual addresses where supported.
export const MEMORY_RESERVE_TOP_DOWN: MemoryReserveFlags = MemoryReserveFlags(0x1);
/// Request large-page backing for allocation-time mappings where supported.
export const MEMORY_RESERVE_LARGE_PAGES: MemoryReserveFlags = MemoryReserveFlags(0x2);
/// Reserve address space without guaranteed swap reservation where supported.
export const MEMORY_RESERVE_NO_RESERVE: MemoryReserveFlags = MemoryReserveFlags(0x4);

/// Share mapping writes with the underlying object.
export const MEMORY_MAP_SHARED: MemoryMapFlags = MemoryMapFlags(0x1);
/// Keep mapping writes private to the process.
export const MEMORY_MAP_PRIVATE: MemoryMapFlags = MemoryMapFlags(0x2);
/// Request a fixed virtual address when the host supports it.
export const MEMORY_MAP_FIXED: MemoryMapFlags = MemoryMapFlags(0x10);
/// Create an anonymous mapping with no file backing.
export const MEMORY_MAP_ANONYMOUS: MemoryMapFlags = MemoryMapFlags(0x20);

/// No remap flags.
export const MEMORY_REMAP_NONE: MemoryRemapFlags = MemoryRemapFlags(0x0);
/// Allow remap operation to move mapping base address.
export const MEMORY_REMAP_MAY_MOVE: MemoryRemapFlags = MemoryRemapFlags(0x1);

/// Schedule asynchronous writeback for dirty mapping pages.
export const MEMORY_SYNC_ASYNC: MemorySyncFlags = MemorySyncFlags(0x1);
/// Invalidate cached mapping pages after synchronization.
export const MEMORY_SYNC_INVALIDATE: MemorySyncFlags = MemorySyncFlags(0x2);
/// Wait for dirty mapping pages to be written back.
export const MEMORY_SYNC_WAIT: MemorySyncFlags = MemorySyncFlags(0x4);
