/// Virtual memory address range.
export struct VirtualMemoryRange {
    /// Base virtual address.
    address: uint64;
    /// Range length in bytes.
    length: uint64;
}

/// Bitmask of virtual memory protection permissions.
export newtype MemoryProtection = uint32;

/// Flags for virtual memory reservation operations.
export newtype VirtualMemoryReserveFlags = uint32;

/// File mapping visibility.
export enum MappedMemoryVisibility {
    /// Share writes with the backing object.
    Shared = 1,
    /// Keep writes private to this process.
    Private = 2,
}

/// Flags for file and anonymous memory mappings.
export newtype MappedMemoryFlags = uint32;

/// Flags for flushing mapped memory.
export newtype MappedMemorySyncFlags = uint32;

/// Memory access pattern advice selector.
export enum MemoryAdvice {
    /// No special access pattern.
    Normal = 0,
    /// Expect mostly sequential access.
    Sequential = 1,
    /// Expect mostly random access.
    Random = 2,
    /// Pages will be needed soon.
    WillNeed = 3,
    /// Pages will not be needed soon.
    DontNeed = 4,
}

/// No protection bits.
export const MEMORY_PROTECTION_NONE: MemoryProtection = MemoryProtection(0x0);
/// Allow reads from mapped pages.
export const MEMORY_PROTECTION_READ: MemoryProtection = MemoryProtection(0x1);
/// Allow writes to mapped pages.
export const MEMORY_PROTECTION_WRITE: MemoryProtection = MemoryProtection(0x2);
/// Allow instruction fetch from mapped pages.
export const MEMORY_PROTECTION_EXECUTE: MemoryProtection = MemoryProtection(0x4);

/// No reserve flags.
export const VIRTUAL_MEMORY_RESERVE_NONE: VirtualMemoryReserveFlags = VirtualMemoryReserveFlags(0x0);

/// Prefer high virtual addresses where supported.
export const VIRTUAL_MEMORY_RESERVE_TOP_DOWN: VirtualMemoryReserveFlags = VirtualMemoryReserveFlags(0x1);

/// Reserve address space without guaranteed swap reservation where supported.
export const VIRTUAL_MEMORY_RESERVE_NO_RESERVE: VirtualMemoryReserveFlags = VirtualMemoryReserveFlags(0x2);

/// No mapped memory flags.
export const MAPPED_MEMORY_NONE: MappedMemoryFlags = MappedMemoryFlags(0x0);

/// Request a fixed virtual address when the host supports it.
export const MAPPED_MEMORY_FIXED: MappedMemoryFlags = MappedMemoryFlags(0x10);

/// Request large page backing where supported.
export const MAPPED_MEMORY_LARGE_PAGES: MappedMemoryFlags = MappedMemoryFlags(0x20);

/// No mapped memory synchronization flags.
export const MAPPED_MEMORY_SYNC_NONE: MappedMemorySyncFlags = MappedMemorySyncFlags(0x0);

/// Schedule asynchronous writeback for dirty mapping pages.
export const MAPPED_MEMORY_SYNC_ASYNC: MappedMemorySyncFlags = MappedMemorySyncFlags(0x1);

/// Invalidate cached mapping pages after synchronization.
export const MAPPED_MEMORY_SYNC_INVALIDATE: MappedMemorySyncFlags =
    MappedMemorySyncFlags(0x2);

/// Wait for dirty mapping pages to be written back.
export const MAPPED_MEMORY_SYNC_WAIT: MappedMemorySyncFlags = MappedMemorySyncFlags(0x4);
