import type { PlatformError } from "../error/index.ds";
import { VirtualMemoryRange } from "./types.ds";

/// Lock one memory range into physical memory.
@binding("destack.memory.lock", {
    effect: "external",
    requires: ["memory.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function lockMemory(range: VirtualMemoryRange): Result<void, PlatformError>;

/// Unlock one memory range.
@binding("destack.memory.unlock", {
    effect: "external",
    requires: ["memory.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unlockMemory(range: VirtualMemoryRange): Result<void, PlatformError>;
