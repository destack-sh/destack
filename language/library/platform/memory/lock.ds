import type { PlatformError } from "../error/index.ds";

/// Lock one memory range into physical memory.
@binding("destack.memory.lock.lockRange", {
    effect: "external",
    requires: ["memory.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function lock(address: uint64, length: uint64): Result<void, PlatformError>;

/// Unlock one memory range.
@binding("destack.memory.lock.unlock", {
    effect: "external",
    requires: ["memory.lock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unlock(address: uint64, length: uint64): Result<void, PlatformError>;
