import type { PlatformError } from "../error/index.ds";

/// Host identity descriptor.
export struct HostIdentity {
    /// Hostname string.
    hostname: string;
    /// Kernel or operating-system name.
    kernel: string;
    /// Kernel or operating-system release string.
    release: string;
    /// Machine architecture string.
    architecture: string;
}

/// Read host identity.
@binding("destack.os.host.identity", {
    effect: "external",
    requires: ["os.hostname", "os.sysinfo"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function hostIdentity(): Result<HostIdentity, PlatformError>;
