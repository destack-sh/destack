import type { PlatformError } from "../error/index.ds";

/// Host power state.
export enum PowerState {
    /// Host is on AC line power.
    AC = 1,
    /// Host is on battery power.
    Battery = 2,
    /// Host power source is unknown.
    Unknown = 3,
}

/// Read current host power state.
@binding("destack.os.power.state", {
    effect: "external",
    requires: ["os.power"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function powerState(): Result<PowerState, PlatformError>;

/// Request host suspend.
@binding("destack.os.power.suspend", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.power"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function suspend(): Result<void, PlatformError>;
