import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Credential accessibility class.
export enum CredentialAccessibility {
    /// Accessible when the device is unlocked.
    WhenUnlocked = 1,
    /// Accessible after first unlock until restart.
    AfterFirstUnlock = 2,
    /// Accessible with host default policy.
    HostDefault = 3,
}

/// Credential authentication policy.
export enum CredentialAuthenticationPolicy {
    /// No additional user authentication requirement.
    None = 1,
    /// Any user-presence signal requirement.
    UserPresence = 2,
    /// Biometric authentication requirement.
    Biometric = 3,
    /// Device credential authentication requirement.
    /// This includes passcode, PIN, or platform-equivalent device unlock credential.
    DeviceCredential = 4,
}

/// Credential authentication mechanism.
export enum CredentialAuthenticationMechanism {
    /// Unknown or backend-defined mechanism.
    Unknown = 1,
    /// Biometric authentication mechanism.
    Biometric = 2,
    /// Device credential authentication mechanism.
    /// This includes passcode, PIN, or platform-equivalent device unlock credential.
    DeviceCredential = 3,
}

/// Credential authentication requirement.
export enum CredentialAuthenticationRequirement {
    /// Allow biometric or device credential challenge.
    BiometricOrDeviceCredential = 1,
    /// Require biometric-only authentication.
    Biometric = 2,
    /// Require device credential authentication.
    /// This includes passcode, PIN, or platform-equivalent device unlock credential.
    DeviceCredential = 3,
}

/// Credential write options.
export struct CredentialWriteOptions {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Optional access-group namespace when supported by host keychain APIs.
    accessGroup?: string;
    /// Binary credential payload.
    bytes: Slice<uint8>;
    /// Accessibility policy.
    accessibility: CredentialAccessibility;
    /// Authentication policy.
    authentication: CredentialAuthenticationPolicy;
    /// Whether replacement is allowed when one credential already exists.
    replaceExisting: boolean;
}

/// Credential query options.
export struct CredentialQuery {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Optional access-group namespace when supported by host keychain APIs.
    accessGroup?: string;
    /// Whether host authentication should be requested before returning payload bytes.
    requireAuthentication: boolean;
}

/// Credential payload.
export struct CredentialRecord {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Binary credential payload.
    bytes: Slice<uint8>;
    /// Credential creation timestamp in UTC nanoseconds when available.
    createdUnixNs: uint64;
    /// Credential modification timestamp in UTC nanoseconds when available.
    modifiedUnixNs: uint64;
}

/// Credential authentication options.
export struct CredentialAuthenticationOptions {
    /// Authentication prompt title.
    title: string;
    /// Authentication prompt subtitle.
    subtitle: string;
    /// Authentication prompt detail message.
    message: string;
    /// Required host authentication policy.
    requirement: CredentialAuthenticationRequirement;
}

/// Credential authentication result payload.
export struct CredentialAuthenticationResult {
    /// Whether authentication was successful.
    authenticated: boolean;
    /// Used authentication mechanism.
    mechanism: CredentialAuthenticationMechanism;
}

/// Read one credential record.
@binding("destack.os.credentials.read", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.credentials.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function credentialsRead(
    query: CredentialQuery,
): Result<CredentialRecord, PlatformError>;

/// Write one credential record.
@binding("destack.os.credentials.write", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.credentials.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function credentialsWrite(options: CredentialWriteOptions): Result<void, PlatformError>;

/// Delete one credential record.
@binding("destack.os.credentials.delete", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.credentials.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function credentialsDelete(
    service: string,
    account: string,
    accessGroup?: string,
): Result<void, PlatformError>;

/// Query credential presence.
@binding("destack.os.credentials.contains", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.credentials.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function credentialsContains(
    service: string,
    account: string,
    accessGroup?: string,
): Result<boolean, PlatformError>;

/// Request one host credential authentication challenge.
@binding("destack.os.credentials.authenticate", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.credentials.auth"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function credentialsAuthenticate(
    options: CredentialAuthenticationOptions,
): Result<CredentialAuthenticationResult, PlatformError>;
