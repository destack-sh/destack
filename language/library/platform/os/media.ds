import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { Path } from "../fs/path.ds";

/// Media asset class.
export enum MediaAssetKind {
    /// Image asset.
    Image = 1,
    /// Video asset.
    Video = 2,
    /// Audio asset.
    Audio = 3,
    /// Other asset class.
    Other = 4,
}

/// Media query options.
export struct MediaQuery {
    /// Opaque page cursor from one prior mediaList call.
    cursor?: string;
    /// Maximum returned assets for this page.
    limit?: uint32;
    /// Included asset classes, empty means all classes.
    kinds: Array<MediaAssetKind>;
    /// Whether hidden assets should be included.
    includeHidden: boolean;
}

/// Media asset descriptor.
export struct MediaAssetDescriptor {
    /// Stable asset identifier.
    id: string;
    /// Host URI for this asset.
    uri: string;
    /// Asset filename payload.
    filename: string;
    /// Asset MIME type payload when available.
    mimeType: string;
    /// Asset class.
    kind: MediaAssetKind;
    /// Asset width in pixels when available.
    width: uint32;
    /// Asset height in pixels when available.
    height: uint32;
    /// Asset duration in milliseconds for time-based assets.
    durationMs: uint64;
    /// Asset size in bytes when available.
    sizeBytes: uint64;
    /// Asset creation timestamp in UTC nanoseconds when available.
    createdUnixNs: uint64;
    /// Asset modification timestamp in UTC nanoseconds when available.
    modifiedUnixNs: uint64;
}

/// Paged media result payload.
export struct MediaPage {
    /// Asset items for this page.
    assets: Array<MediaAssetDescriptor>;
    /// Opaque cursor for the next page, empty when unavailable.
    nextCursor: string;
    /// Whether more assets are available.
    hasMore: boolean;
}

/// List media assets.
@binding("destack.os.media.list", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.media.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mediaList(query: MediaQuery): Result<MediaPage, PlatformError>;

/// Read one media asset descriptor.
@binding("destack.os.media.read", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.media.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mediaRead(id: string): Result<MediaAssetDescriptor, PlatformError>;

/// Import one file path into host media library.
@binding("destack.os.media.importPath", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.media.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mediaImportPath(
    path: Path,
    kind: MediaAssetKind,
): Result<string, PlatformError>;

/// Delete media assets by identifier.
@binding("destack.os.media.delete", {
    effect: "external",
    replay: "forbidden",
    requires: ["os.media.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function mediaDelete(ids: Array<string>): Result<uint32, PlatformError>;
