import type { PlatformError } from "../error/index.ds";

/// System topology and capacity snapshot.
export struct SystemSnapshot {
    /// Logical CPU count.
    cpuCount: uint32;
    /// Total physical memory bytes.
    memoryTotal: uint64;
    /// Available memory bytes.
    memoryAvailable: uint64;
    /// Virtual-memory page size bytes.
    pageSize: uint64;
}

/// Host load-average tuple.
export struct LoadAverage {
    /// One-minute load average.
    one: float64;
    /// Five-minute load average.
    five: float64;
    /// Fifteen-minute load average.
    fifteen: float64;
}

/// Read host system information.
@binding("destack.os.info.systemSnapshot", {
    effect: "external",
    requires: ["os.sysinfo"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function systemSnapshot(): Result<SystemSnapshot, PlatformError>;

/// Read host uptime.
@binding("destack.os.info.uptimeNs", {
    effect: "external",
    requires: ["os.sysinfo"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function uptimeNs(): Result<uint64, PlatformError>;

/// Read host load averages.
@binding("destack.os.info.loadAverage", {
    effect: "external",
    requires: ["os.sysinfo"],
    families: ["unix"],
    simulation: true,
})
export declare function loadAverage(): Result<LoadAverage, PlatformError>;

/// Read host boot time.
@binding("destack.os.info.bootTimeUnixNs", {
    effect: "external",
    requires: ["os.sysinfo"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bootTimeUnixNs(): Result<uint64, PlatformError>;
