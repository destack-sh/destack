import { Array } from "core";
import type { PlatformError } from "../error/index.ds";
import { Path } from "../fs/path.ds";
import { IntentHandle } from "../resource/index.ds";

/// Open-url intent payload.
export struct IntentOpenUrlPayload {
    /// URL payload.
    url: string;
}

/// Open-file intent payload.
export struct IntentOpenFilePayload {
    /// File target payload.
    path: Path;
    /// MIME type when provided by host.
    mimeType: string | void;
}

/// Share-text intent payload.
export struct IntentShareTextPayload {
    /// Shared text payload.
    text: string;
    /// MIME type when provided by host.
    mimeType: string | void;
}

/// Share-files intent payload.
export struct IntentShareFilesPayload {
    /// Shared file payloads.
    paths: Array<Path>;
    /// MIME type when provided by host.
    mimeType: string | void;
}

/// Custom-action intent payload.
export struct IntentCustomActionPayload {
    /// Action identifier.
    action: string;
    /// URL payload when provided by host.
    url: string | void;
    /// File payloads when provided by host.
    paths: Array<Path>;
    /// Text payload when provided by host.
    text: string | void;
    /// MIME type when provided by host.
    mimeType: string | void;
}

/// Shared metadata for all inbound intent events.
export struct IntentEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Host source package or process identifier when available.
    source: string | void;
}

/// Open-url intent event.
export struct IntentOpenUrlEvent {
    /// Discriminator for this intent event variant.
    kind: "openUrl";
    /// Shared event metadata.
    metadata: IntentEventMetadata;
    /// Open-url payload.
    payload: IntentOpenUrlPayload;
}

/// Open-file intent event.
export struct IntentOpenFileEvent {
    /// Discriminator for this intent event variant.
    kind: "openFile";
    /// Shared event metadata.
    metadata: IntentEventMetadata;
    /// Open-file payload.
    payload: IntentOpenFilePayload;
}

/// Share-text intent event.
export struct IntentShareTextEvent {
    /// Discriminator for this intent event variant.
    kind: "shareText";
    /// Shared event metadata.
    metadata: IntentEventMetadata;
    /// Share-text payload.
    payload: IntentShareTextPayload;
}

/// Share-files intent event.
export struct IntentShareFilesEvent {
    /// Discriminator for this intent event variant.
    kind: "shareFiles";
    /// Shared event metadata.
    metadata: IntentEventMetadata;
    /// Share-files payload.
    payload: IntentShareFilesPayload;
}

/// Custom-action intent event.
export struct IntentCustomActionEvent {
    /// Discriminator for this intent event variant.
    kind: "customAction";
    /// Shared event metadata.
    metadata: IntentEventMetadata;
    /// Custom-action payload.
    payload: IntentCustomActionPayload;
}

/// Inbound intent event.
export newtype IntentEvent =
    | IntentOpenUrlEvent
    | IntentOpenFileEvent
    | IntentShareTextEvent
    | IntentShareFilesEvent
    | IntentCustomActionEvent;

/// Intent stream open options.
export struct IntentOpenOptions {
    /// Whether to include URL activation events.
    includeOpenUrl: boolean;
    /// Whether to include file activation events.
    includeOpenFile: boolean;
    /// Whether to include share events.
    includeShare: boolean;
    /// Whether to include custom action events.
    includeCustomAction: boolean;
}

/// Host intent bindings.
/// Open one host intent stream.
///
/// Open one inbound host intent stream for activation and share payload events.
///
/// # Platform
/// Unix and Windows.
/// Uses runtime host intent bridges where the active host integrates activation or share ingress.
///
/// # Errors
/// Returns ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.intent.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentOpen(options: IntentOpenOptions): Result<IntentHandle, PlatformError>;

/// Close one host intent stream.
///
/// Close one opened host intent stream and release host callback routing resources.
///
/// # Platform
/// Unix and Windows.
/// Uses runtime host intent bridge unregistration where the active host exposes one inbound stream.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.intent.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.intent.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentClose(handle: IntentHandle): Result<void, PlatformError>;

/// Wait for one inbound intent event.
///
/// Wait for one queued inbound intent event from one opened intent stream.
///
/// # Platform
/// Unix and Windows.
/// Uses runtime host intent queues where the active host delivers activation or share ingress.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
///
/// # Security
/// Requires `os.intent.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.intent.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.intent.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentRead(
    handle: IntentHandle,
    timeoutNs: uint64,
): Result<IntentEvent, PlatformError>;

/// Poll one inbound intent event without blocking.
///
/// Poll one queued inbound intent event from one opened intent stream.
///
/// # Platform
/// Unix and Windows.
/// Uses runtime host intent queues where the active host delivers activation or share ingress.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.intent.tryRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.intent.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function intentTryRead(handle: IntentHandle): Result<IntentEvent, PlatformError>;

/// Query whether host can route one URL target.
///
/// Ask host routing policy whether one URL target can be opened.
///
/// # Platform
/// Unix and Windows.
/// Uses host routing queries where the current target exposes them and launcher discovery elsewhere.
///
/// # Errors
/// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.intent.canOpenUrl", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentCanOpenUrl(url: string): Result<boolean, PlatformError>;

/// Request host to open one URL target.
///
/// Ask host shell or app framework to open one URL with default routing.
///
/// # Platform
/// Unix and Windows.
/// Uses host default URL routing where the current target exposes it.
///
/// # Errors
/// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.os.intent.openUrl", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentOpenUrl(url: string): Result<void, PlatformError>;

/// Request host to open one file path target.
///
/// Ask host shell or app framework to open one file path with default routing.
///
/// # Platform
/// Unix and Windows.
/// Uses host default path routing where the current target exposes it.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.os.intent.openPath", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentOpenPath(path: Path): Result<void, PlatformError>;

/// Share one text payload through host share routing.
///
/// Ask host share infrastructure to present one text payload to target applications.
///
/// # Platform
/// Unix and Windows.
/// Uses host share routing where the current target exposes it.
///
/// # Errors
/// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.os.intent.shareText", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentShareText(
    text: string,
    mimeType: string | void,
): Result<void, PlatformError>;

/// Share file paths through host share routing.
///
/// Ask host share infrastructure to present one file list to target applications.
///
/// # Platform
/// Unix and Windows.
/// Uses host share routing where the current target exposes it.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.intent.write`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.os.intent.sharePaths", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["os.intent.write"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function intentSharePaths(
    paths: Array<Path>,
    mimeType: string | void,
): Result<void, PlatformError>;
