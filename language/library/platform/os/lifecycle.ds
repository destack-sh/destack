import type { PlatformError } from "../error/index.ds";
import { LifecycleEventHandle } from "../resource/index.ds";

/// Runtime lifecycle state.
export enum LifecycleState {
    /// Runtime is inactive and not rendering or processing foreground input.
    Inactive = 1,
    /// Runtime is active in the foreground.
    Active = 2,
    /// Runtime is in background execution.
    Background = 3,
    /// Runtime is terminating.
    Terminating = 4,
}

/// Low-memory event payload.
export struct LifecycleLowMemoryPayload {
    /// Backend-defined severity level.
    severity: uint32;
}

/// Low-power-mode event payload.
export struct LifecycleLowPowerPayload {
    /// Whether low-power mode is enabled.
    enabled: boolean;
}

/// Shared metadata for all lifecycle events.
export struct LifecycleEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this lifecycle stream.
    sequence: uint64;
}

/// Launch lifecycle event.
export struct LifecycleLaunchEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "launch";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Resume lifecycle event.
export struct LifecycleResumeEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "resume";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Pause lifecycle event.
export struct LifecyclePauseEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "pause";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Background lifecycle event.
export struct LifecycleBackgroundEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "background";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Foreground lifecycle event.
export struct LifecycleForegroundEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "foreground";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Low-memory lifecycle event.
export struct LifecycleLowMemoryEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "lowMemory";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
    /// Low-memory payload.
    payload: LifecycleLowMemoryPayload;
}

/// Low-power-mode-changed lifecycle event.
export struct LifecycleLowPowerModeChangedEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "lowPowerModeChanged";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
    /// Low-power payload.
    payload: LifecycleLowPowerPayload;
}

/// Terminate lifecycle event.
export struct LifecycleTerminateEvent {
    /// Discriminator for this lifecycle event variant.
    kind: "terminate";
    /// Shared event metadata.
    metadata: LifecycleEventMetadata;
}

/// Runtime lifecycle event payload.
export newtype LifecycleEvent =
    | LifecycleLaunchEvent
    | LifecycleResumeEvent
    | LifecyclePauseEvent
    | LifecycleBackgroundEvent
    | LifecycleForegroundEvent
    | LifecycleLowMemoryEvent
    | LifecycleLowPowerModeChangedEvent
    | LifecycleTerminateEvent;

/// Lifecycle bindings.
/// Read current lifecycle state.
///
/// Return the current runtime lifecycle state from the host integration layer.
///
/// # Platform
/// Unix and Windows.
/// Uses host application lifecycle bridges on desktop and mobile platforms.
///
/// # Errors
/// Returns ioNotFound, ioInvalidData, notSupported.
///
/// # Security
/// Requires `os.lifecycle.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.lifecycle.state", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.lifecycle.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function lifecycleState(): Result<LifecycleState, PlatformError>;

/// Open lifecycle event stream.
///
/// Open one lifecycle event stream for runtime lifecycle transitions.
///
/// # Platform
/// Unix and Windows.
/// Uses host application lifecycle callback bridges.
///
/// # Errors
/// Returns ioPermissionDenied, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.lifecycle.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.lifecycle.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.lifecycle.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function lifecycleOpen(): Result<LifecycleEventHandle, PlatformError>;

/// Close lifecycle event stream.
///
/// Close one lifecycle event stream and release host callback routing resources.
///
/// # Platform
/// Unix and Windows.
/// Uses host callback unregistration APIs.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.lifecycle.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.lifecycle.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.lifecycle.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function lifecycleClose(handle: LifecycleEventHandle): Result<void, PlatformError>;

/// Wait for one lifecycle event.
///
/// Wait for one lifecycle event from one opened stream.
///
/// # Platform
/// Unix and Windows.
/// Uses host lifecycle event queues.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
///
/// # Security
/// Requires `os.lifecycle.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.lifecycle.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.lifecycle.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function lifecycleRead(
    handle: LifecycleEventHandle,
    timeoutNs: uint64,
): Result<LifecycleEvent, PlatformError>;

/// Poll one lifecycle event without blocking.
///
/// Poll one lifecycle event from one opened stream without waiting.
///
/// # Platform
/// Unix and Windows.
/// Uses nonblocking host lifecycle event queue reads.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `os.lifecycle.read`.
///
/// # Replay
/// External, recordable.
@binding("destack.os.lifecycle.tryRead", {
    effect: "external",
    replay: "recordable",
    capabilities: ["os.lifecycle.read"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "never",
    affinity: "any",
})
export declare function lifecycleTryRead(
    handle: LifecycleEventHandle,
): Result<LifecycleEvent, PlatformError>;
