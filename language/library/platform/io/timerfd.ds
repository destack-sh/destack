import type { PlatformError } from "../error/index.ds";
import { TimerFdHandle } from "../resource/index.ds";

/// Clock selector for timerfd descriptors.
export enum TimerFdClock {
    /// Realtime clock domain.
    Realtime = 1,
    /// Monotonic clock domain.
    Monotonic = 2,
    /// Boottime clock domain.
    Boottime = 3,
}

/// Flags for opening timerfd descriptors.
export newtype TimerFdFlags = uint32;

/// Flags for setting timerfd schedules.
export newtype TimerFdSetFlags = uint32;

/// Timerfd schedule specification in nanoseconds.
export struct TimerFdSpec {
    /// Initial expiration offset or absolute deadline.
    initialNs: uint64;
    /// Repeating interval, zero for one-shot timers.
    intervalNs: uint64;
}

/// Timerfd bindings for host descriptor-backed timers.
@binding("destack.io.timerfd.open", {
    effect: "external",
    requires: ["io.timerfd"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function timerFdOpen(
    clock: TimerFdClock,
    flags: TimerFdFlags,
): Result<TimerFdHandle, PlatformError>;

/// Update one timerfd schedule.
@binding("destack.io.timerfd.set", {
    effect: "external",
    requires: ["io.timerfd"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function timerFdSet(
    handle: TimerFdHandle,
    spec: TimerFdSpec,
    flags: TimerFdSetFlags,
): Result<void, PlatformError>;

/// Read the active timerfd schedule.
@binding("destack.io.timerfd.get", {
    effect: "external",
    requires: ["io.timerfd"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function timerFdGet(handle: TimerFdHandle): Result<TimerFdSpec, PlatformError>;

/// Read one timerfd expiration counter.
@binding("destack.io.timerfd.read", {
    effect: "external",
    requires: ["io.timerfd"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function timerFdRead(handle: TimerFdHandle): Result<uint64, PlatformError>;

/// Close one timerfd descriptor.
@binding("destack.io.timerfd.close", {
    effect: "external",
    requires: ["io.timerfd"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function timerFdClose(handle: TimerFdHandle): Result<void, PlatformError>;
