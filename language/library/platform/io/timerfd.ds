import type { PlatformError } from "../error/index.ds";
import { TimerFdHandle } from "../resource/index.ds";

/// Clock selector for timerfd descriptors.
export enum TimerFdClock {
    /// Realtime clock domain.
    Realtime = 1,
    /// Monotonic clock domain.
    Monotonic = 2,
    /// Boottime clock domain.
    Boottime = 3,
}

/// Flags for opening timerfd descriptors.
export newtype TimerFdFlags = uint32;

/// Flags for setting timerfd schedules.
export newtype TimerFdSetFlags = uint32;

/// Timerfd schedule specification in nanoseconds.
export struct TimerFdSpec {
    /// Initial expiration offset or absolute deadline.
    initialNs: uint64;
    /// Repeating interval, zero for one-shot timers.
    intervalNs: uint64;
}

/// Timerfd bindings for host descriptor-backed timers.
/// Open one timerfd style descriptor.
///
/// Create one descriptor-backed timer queue in the requested clock domain.
/// Timerfd behavior and descriptor flags follow host kernel semantics.
///
/// # Platform
/// Unix and Windows.
/// Uses timerfd_create(2) on Linux and returns `notSupported` where timerfd is unavailable.
///
/// # Errors
/// Returns timeUnavailable, invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `io.timerfd`.
///
/// # Replay
/// External, recordable.
@binding("destack.io.timerfd.open", {
    effect: "external",
    replay: "recordable",
    capabilities: ["io.timerfd"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function timerFdOpen(
    clock: TimerFdClock,
    flags: TimerFdFlags,
): Result<TimerFdHandle, PlatformError>;

/// Update one timerfd schedule.
///
/// Replace the timer schedule with one initial deadline and one interval period.
/// Absolute or relative interpretation is controlled by the provided set flags.
///
/// # Platform
/// Unix and Windows.
/// Uses timerfd_settime(2) on Linux and returns `notSupported` where timerfd is unavailable.
///
/// # Errors
/// Returns timeUnavailable, invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `io.timerfd`.
///
/// # Replay
/// External, recordable.
@binding("destack.io.timerfd.set", {
    effect: "external",
    replay: "recordable",
    capabilities: ["io.timerfd"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function timerFdSet(
    handle: TimerFdHandle,
    spec: TimerFdSpec,
    flags: TimerFdSetFlags,
): Result<void, PlatformError>;

/// Read the active timerfd schedule.
///
/// Return one normalized schedule snapshot for the descriptor.
/// Returned values are measured in nanoseconds using host timerfd conversion rules.
///
/// # Platform
/// Unix and Windows.
/// Uses timerfd_gettime(2) on Linux and returns `notSupported` where timerfd is unavailable.
///
/// # Errors
/// Returns timeUnavailable, invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `io.timerfd`.
///
/// # Replay
/// External, recordable.
@binding("destack.io.timerfd.get", {
    effect: "external",
    replay: "recordable",
    capabilities: ["io.timerfd"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function timerFdGet(handle: TimerFdHandle): Result<TimerFdSpec, PlatformError>;

/// Read one timerfd expiration counter.
///
/// Consume one pending expiration counter value from the descriptor.
/// Counter semantics follow host timerfd read behavior.
///
/// # Platform
/// Unix and Windows.
/// Uses read(2) on timerfd descriptors on Linux and returns `notSupported` where timerfd is unavailable.
///
/// # Errors
/// Returns timeUnavailable, invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `io.timerfd`.
///
/// # Replay
/// External, recordable.
@binding("destack.io.timerfd.read", {
    effect: "external",
    replay: "recordable",
    capabilities: ["io.timerfd"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function timerFdRead(handle: TimerFdHandle): Result<uint64, PlatformError>;

/// Close one timerfd descriptor.
///
/// Close one descriptor and release host timer queue resources.
/// Pending expirations are discarded according to host close semantics.
///
/// # Platform
/// Unix and Windows.
/// Uses close(2) on Linux and returns `notSupported` where timerfd is unavailable.
///
/// # Errors
/// Returns timeUnavailable, invalidArgument, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `io.timerfd`.
///
/// # Replay
/// External, recordable.
@binding("destack.io.timerfd.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["io.timerfd"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function timerFdClose(handle: TimerFdHandle): Result<void, PlatformError>;
