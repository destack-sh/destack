import { PlatformError } from "destack:platform/error";
import { ResourceId, UringHandle } from "destack:platform/resource";

/// io_uring setup parameters.
export struct UringParameters {
    /// Submission queue entries.
    entries: uint32;
    /// Setup flags.
    flags: uint32;
    /// Submission-poll idle timeout in milliseconds.
    submitPollIdleMilliseconds: uint32;
}

/// io_uring feature set.
export struct UringFeatures {
    /// Whether submission polling is available.
    hasSubmissionPolling: boolean;
    /// Whether kernel-side thread polling is available.
    hasKernelPolling: boolean;
    /// Whether fixed-file registration is available.
    hasFixedFiles: boolean;
    /// Whether fixed-buffer registration is available.
    hasFixedBuffers: boolean;
    /// Maximum submission queue entries reported by the kernel.
    maxEntries: uint32;
}

/// Fixed buffer registration entry.
export struct UringBuffer {
    /// Buffer address.
    address: uint64;
    /// Buffer byte length.
    byteCount: uint32;
}

/// Open an io_uring ring.
@binding("destack.io.uring.open", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function openUring(
    parameters: &readonly UringParameters,
): Result<UringHandle, PlatformError>;

/// Close an io_uring ring.
@binding("destack.io.uring.close", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function closeUring(ring: UringHandle): Result<void, PlatformError>;

/// Read io_uring feature support.
@binding("destack.io.uring.features", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function getUringFeatures(ring: UringHandle): Result<UringFeatures, PlatformError>;

/// Register fixed files with an io_uring ring.
@binding("destack.io.uring.registerFiles", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function registerUringFiles(
    ring: UringHandle,
    files: &readonly [ResourceId],
): Result<void, PlatformError>;

/// Unregister fixed files from an io_uring ring.
@binding("destack.io.uring.unregisterFiles", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function unregisterUringFiles(ring: UringHandle): Result<void, PlatformError>;

/// Register fixed buffers with an io_uring ring.
@binding("destack.io.uring.registerBuffers", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function registerUringBuffers(
    ring: UringHandle,
    buffers: &readonly [UringBuffer],
): Result<void, PlatformError>;

/// Unregister fixed buffers from an io_uring ring.
@binding("destack.io.uring.unregisterBuffers", {
    effect: "external",
    requires: ["host.io.uring"],
    platforms: ["linux"],
    simulation: true,
})
export declare function unregisterUringBuffers(ring: UringHandle): Result<void, PlatformError>;
