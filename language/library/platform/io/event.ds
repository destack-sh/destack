import type { PlatformError } from "../error/index.ds";
import { ResourceId } from "../resource/index.ds";

/// Event token handle.
export newtype EventToken = uint64;

/// Create a user-event token.
@binding("destack.io.event.open", {
    effect: "external",
    requires: ["io.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventOpen(initial: uint64): Result<EventToken, PlatformError>;

/// Close a user-event token.
@binding("destack.io.event.close", {
    effect: "external",
    requires: ["io.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventClose(token: EventToken): Result<void, PlatformError>;

/// Signal a user-event token.
@binding("destack.io.event.signal", {
    effect: "external",
    requires: ["io.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventSignal(token: EventToken, value: uint64): Result<void, PlatformError>;

/// Attach an event token to a poll target key.
@binding("destack.io.event.attach", {
    effect: "external",
    requires: ["io.event"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function eventAttach(
    token: EventToken,
    target: ResourceId,
    key: uint64,
): Result<void, PlatformError>;
