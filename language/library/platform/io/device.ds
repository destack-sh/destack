import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { Path } from "../fs/path.ds";
import { DeviceHandle } from "../resource/index.ds";
import { DescriptorRequest, DescriptorResult } from "./control.ds";

/// Open one raw device endpoint.
@binding("destack.io.device.open", {
    effect: "external",
    requires: ["io.device.read", "io.device.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function deviceOpen(
    path: Path,
    flags: uint32,
    mode: uint32,
): Result<DeviceHandle, PlatformError>;

/// Close one raw device endpoint.
@binding("destack.io.device.close", {
    effect: "external",
    requires: ["io.device.read", "io.device.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function deviceClose(handle: DeviceHandle): Result<void, PlatformError>;

/// Read bytes from one raw device endpoint.
@binding("destack.io.device.read", {
    effect: "external",
    requires: ["io.device.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function deviceRead(
    handle: DeviceHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Write bytes to one raw device endpoint.
@binding("destack.io.device.write", {
    effect: "external",
    requires: ["io.device.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function deviceWrite(
    handle: DeviceHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError>;

/// Run one device-specific control request.
@binding("destack.io.device.control", {
    effect: "external",
    requires: ["io.device.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function deviceControl(
    handle: DeviceHandle,
    request: DescriptorRequest,
): Result<DescriptorResult, PlatformError>;
