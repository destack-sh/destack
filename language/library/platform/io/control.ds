import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { ResourceId } from "../resource/index.ds";

/// Generic descriptor control command selector.
export newtype DescriptorControlCommand = uint32;

/// Generic descriptor control flag mask.
export newtype DescriptorControlFlags = uint32;

/// Generic descriptor request payload.
export struct DescriptorRequest {
    /// Request code.
    code: uint64;
    /// Opaque input payload forwarded to the host.
    input: Slice<uint8>;
    /// Maximum output payload size requested from the host.
    outputSize: uint32;
    /// Request flags.
    flags: uint32;
}

/// Generic descriptor response payload.
export struct DescriptorResult {
    /// Host return value for the request.
    returnValue: int64;
    /// Opaque output payload returned by the host.
    output: Slice<uint8>;
}

/// Execute one fcntl-style descriptor command.
@binding("destack.io.control.fcntl", {
    effect: "external",
    requires: ["io.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function controlFcntl(
    handle: ResourceId,
    command: DescriptorControlCommand,
    argument: uint64,
    flags: DescriptorControlFlags,
): Result<int64, PlatformError>;

/// Execute one ioctl-style descriptor request.
@binding("destack.io.control.ioctl", {
    effect: "external",
    requires: ["io.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function controlIoctl(
    handle: ResourceId,
    request: DescriptorRequest,
): Result<DescriptorResult, PlatformError>;
