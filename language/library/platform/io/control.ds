import type { PlatformError } from "../error/index.ds";
import { ResourceId } from "../resource/index.ds";

/// Resource control flags.
export newtype ControlFlags = uint32;

/// Resource control request.
export struct ControlRequest {
    /// Host request code.
    code: uint64;
    /// Scalar argument value.
    argument: uint64;
    /// Request flags.
    flags: ControlFlags;
}

/// Resource control result.
export struct ControlResult {
    /// Host return value.
    value: int64;
    /// Output bytes written.
    bytes: uint32;
}

/// Execute one resource control request.
@binding("destack.io.control", {
    effect: "external",
    requires: ["io.control"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function control(
    resource: ResourceId,
    request: ControlRequest,
    input: &readonly [uint8],
    output: &[uint8],
): Result<ControlResult, PlatformError>;
