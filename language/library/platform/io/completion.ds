import type { PlatformError } from "../error/index.ds";
import { CompletionHandle, ResourceId } from "../resource/index.ds";
import { Array, Slice } from "core";

/// Completion queue event.
export struct CompletionEvent {
    /// User-assigned completion key.
    key: uint64;
    /// Operation result payload.
    result: int64;
    /// Completion flags.
    flags: uint32;
}

/// Completion operation kind.
export enum CompletionOperationKind {
    /// Read operation.
    Read = 1,
    /// Write operation.
    Write = 2,
    /// Accept operation.
    Accept = 3,
    /// Connect operation.
    Connect = 4,
    /// Timeout operation.
    Timeout = 5,
    /// Fsync operation.
    Fsync = 6,
    /// Send operation.
    Send = 7,
    /// Receive operation.
    Receive = 8,
}

/// Completion operation descriptor.
export struct CompletionOperation {
    /// Operation kind.
    kind: CompletionOperationKind;
    /// Operation target resource identifier.
    target: ResourceId;
    /// User-assigned completion key.
    key: uint64;
    /// Primary operation offset or position.
    offset: uint64;
    /// Primary operation length.
    length: uint32;
    /// Operation flags.
    flags: uint32;
    /// Opaque argument lane 0.
    argument0: uint64;
    /// Opaque argument lane 1.
    argument1: uint64;
}

/// Open a completion queue.
@binding("destack.io.completion.open", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionOpen(entries: uint32): Result<CompletionHandle, PlatformError>;

/// Close a completion queue.
@binding("destack.io.completion.close", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionClose(handle: CompletionHandle): Result<void, PlatformError>;

/// Wait for completion events.
@binding("destack.io.completion.wait", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionWait(
    handle: CompletionHandle,
    timeoutNs: uint64,
    maxEvents: uint32,
): Result<Array<CompletionEvent>, PlatformError>;

/// Cancel queued operations for one target.
@binding("destack.io.completion.cancel", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionCancel(
    handle: CompletionHandle,
    target: ResourceId,
): Result<uint32, PlatformError>;

/// Submit one completion operation.
@binding("destack.io.completion.submit", {
    effect: "external",
    requires: ["io.submit"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionSubmit(
    handle: CompletionHandle,
    operation: CompletionOperation,
): Result<void, PlatformError>;

/// Submit a batch of completion operations.
@binding("destack.io.completion.submitBatch", {
    effect: "external",
    requires: ["io.submit"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionSubmitBatch(
    handle: CompletionHandle,
    operationWords: Slice<uint64>,
    operationCount: uint32,
    operationWordStride: uint32,
): Result<uint32, PlatformError>;

/// Enter the completion backend with submit and wait hints.
@binding("destack.io.completion.enter", {
    effect: "external",
    requires: ["io.submit"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function completionEnter(
    handle: CompletionHandle,
    minComplete: uint32,
    timeoutNs: uint64,
    flags: uint32,
): Result<uint32, PlatformError>;
