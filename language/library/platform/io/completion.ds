import type { PlatformError } from "../error/index.ds";
import { CompletionHandle, ResourceId } from "../resource/index.ds";

/// Completion event flags.
export newtype CompletionFlags = uint32;

/// Completion event.
export struct CompletionEvent {
    /// User-assigned completion key.
    key: uint64;
    /// Host result value.
    result: int64;
    /// Completion flags.
    flags: CompletionFlags;
}

/// Open a completion queue.
@binding("destack.io.completion.open", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openCompletion(entries: uint32): Result<CompletionHandle, PlatformError>;

/// Close a completion queue.
@binding("destack.io.completion.close", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeCompletion(completion: CompletionHandle): Result<void, PlatformError>;

/// Bind one resource to a completion queue.
@binding("destack.io.completion.bind", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function bindCompletion(
    completion: CompletionHandle,
    resource: ResourceId,
    key: uint64,
): Result<void, PlatformError>;

/// Unbind one resource from a completion queue.
@binding("destack.io.completion.unbind", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function unbindCompletion(
    completion: CompletionHandle,
    resource: ResourceId,
): Result<void, PlatformError>;

/// Post one synthetic completion event.
@binding("destack.io.completion.post", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function postCompletion(
    completion: CompletionHandle,
    event: CompletionEvent,
): Result<void, PlatformError>;

/// Wait for completion events.
@binding("destack.io.completion.wait", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitCompletion(
    completion: CompletionHandle,
    events: &[CompletionEvent],
    timeoutNs?: uint64,
): Result<uint32, PlatformError>;

/// Cancel queued completions for one resource.
@binding("destack.io.completion.cancel", {
    effect: "external",
    requires: ["io.completion"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cancelCompletion(
    completion: CompletionHandle,
    resource: ResourceId,
): Result<uint32, PlatformError>;
