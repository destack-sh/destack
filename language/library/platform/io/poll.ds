import type { PlatformError } from "../error/index.ds";
import { PollHandle, ResourceId } from "../resource/index.ds";

/// Readiness backend selector.
export enum PollBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Use the Linux epoll backend.
    Epoll = 1,
    /// Use the BSD kqueue backend.
    Kqueue = 2,
    /// Use the POSIX poll backend.
    PosixPoll = 3,
}

/// Readiness interest mask.
export newtype PollInterest = uint32;

/// Notify when reads can make progress.
export const POLL_READ: PollInterest = PollInterest(0x01);

/// Notify when writes can make progress.
export const POLL_WRITE: PollInterest = PollInterest(0x02);

/// Notify when priority data can be read.
export const POLL_PRIORITY: PollInterest = PollInterest(0x04);

/// Notify when the target reports an error.
export const POLL_ERROR: PollInterest = PollInterest(0x08);

/// Notify when the peer has closed or disconnected.
export const POLL_HANGUP: PollInterest = PollInterest(0x10);

/// Readiness event.
export struct PollEvent {
    /// User-assigned key for the registered target.
    key: uint64;
    /// Ready interest mask.
    ready: PollInterest;
    /// Backend-specific payload when the host exposes one.
    value: int32;
}

/// Open a readiness poller.
@binding("destack.io.poll.open", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openPoll(backend: PollBackend): Result<PollHandle, PlatformError>;

/// Close a readiness poller.
@binding("destack.io.poll.close", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closePoll(poll: PollHandle): Result<void, PlatformError>;

/// Add one resource to a readiness poller.
@binding("destack.io.poll.add", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function addPoll(
    poll: PollHandle,
    resource: ResourceId,
    key: uint64,
    interest: PollInterest,
): Result<void, PlatformError>;

/// Update one resource in a readiness poller.
@binding("destack.io.poll.update", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function updatePoll(
    poll: PollHandle,
    resource: ResourceId,
    key: uint64,
    interest: PollInterest,
): Result<void, PlatformError>;

/// Remove one resource from a readiness poller.
@binding("destack.io.poll.remove", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function removePoll(
    poll: PollHandle,
    resource: ResourceId,
): Result<void, PlatformError>;

/// Wait for readiness events.
@binding("destack.io.poll.wait", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitPoll(
    poll: PollHandle,
    events: &[PollEvent],
    timeoutNs?: uint64,
): Result<uint32, PlatformError>;
