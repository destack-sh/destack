import type { PlatformError } from "../error/index.ds";
import { PollHandle, ResourceId } from "../resource/index.ds";

/// Poll backend selector.
export enum PollBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Force epoll backend.
    Epoll = 1,
    /// Force kqueue backend.
    Kqueue = 2,
    /// Force poll backend.
    Poll = 3,
}

/// Poll interest bitmask.
export newtype PollInterest = uint32;

/// Poll event result.
export struct PollEvent {
    /// User-assigned event key.
    key: uint64;
    /// Ready interest mask.
    ready: PollInterest;
    /// Backend event payload value for this event.
    data: int32;
}

/// Open a poll instance.
@binding("destack.io.poll.open", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollOpen(backend: PollBackend): Result<PollHandle, PlatformError>;

/// Close a poll instance.
@binding("destack.io.poll.close", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollClose(handle: PollHandle): Result<void, PlatformError>;

/// Register one target with a poll instance.
@binding("destack.io.poll.register", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollRegister(
    handle: PollHandle,
    target: ResourceId,
    key: uint64,
    interest: PollInterest,
): Result<void, PlatformError>;

/// Update one target in a poll instance.
@binding("destack.io.poll.update", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollUpdate(
    handle: PollHandle,
    target: ResourceId,
    key: uint64,
    interest: PollInterest,
): Result<void, PlatformError>;

/// Remove one target from a poll instance.
@binding("destack.io.poll.deregister", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollDeregister(
    handle: PollHandle,
    target: ResourceId,
): Result<void, PlatformError>;

/// Wait for poll events.
@binding("destack.io.poll.wait", {
    effect: "external",
    requires: ["io.poll"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollWait(
    handle: PollHandle,
    timeoutNs: uint64,
    maxEvents: uint32,
): Result<Array<PollEvent>, PlatformError>;
