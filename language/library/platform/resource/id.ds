import type { PlatformError } from "../error/index.ds";

/// Opaque identifier for a runtime-managed resource.
export newtype ResourceId = uint64;

/// Resource ownership mode.
export enum ResourceOwnership {
    /// The caller keeps ownership.
    Borrowed = 1,
    /// Ownership is moved to the receiver.
    Owned = 2,
}

/// Resource kind used for diagnostics and policy.
export newtype ResourceKind = string;

/// Runtime resource table bindings.
/// Remove a resource from the table.
///
/// Remove one resource identifier from the runtime table.
/// Owned resources are closed by runtime policy before removal.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime resource-table state only.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `resource.manage`.
///
/// # Replay
/// Deterministic.
@binding("destack.resource.id.remove", {
    effect: "deterministic",
    replay: "nonrecordable",
    capabilities: ["resource.manage"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function remove(id: ResourceId): Result<void, PlatformError>;

/// Describe a resource kind.
///
/// Return the declared kind label for one resource identifier.
/// Kind labels are stable runtime strings for diagnostics and policy checks.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime resource-table state only.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, notSupported.
///
/// # Security
/// Requires `resource.read`.
///
/// # Replay
/// Deterministic.
@binding("destack.resource.id.kind", {
    effect: "deterministic",
    replay: "nonrecordable",
    capabilities: ["resource.read"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function kind(id: ResourceId): Result<ResourceKind, PlatformError>;

/// Transfer resource ownership.
///
/// Move one resource identifier into the requested ownership mode.
/// Ownership transitions are validated against runtime boundary policy.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime resource ownership metadata only.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
///
/// # Security
/// Requires `resource.transfer`.
///
/// # Replay
/// Deterministic.
@binding("destack.resource.id.transfer", {
    effect: "deterministic",
    replay: "nonrecordable",
    capabilities: ["resource.transfer"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "never",
    affinity: "any",
})
export declare function transfer(
    id: ResourceId,
    ownership: ResourceOwnership,
): Result<void, PlatformError>;

/// Close a resource by identifier.
///
/// Close one resource endpoint while keeping table semantics explicit.
/// Close behavior is delegated to the owning runtime subsystem for the resource kind.
///
/// # Platform
/// Runtime-managed on all targets.
/// Uses runtime resource-dispatch close logic.
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
///
/// # Security
/// Requires `resource.close`.
///
/// # Replay
/// External, recordable.
@binding("destack.resource.id.close", {
    effect: "external",
    replay: "recordable",
    capabilities: ["resource.close"],
    platforms: ["windows", "unix", "wasi"],
    simulation: "unsupported",
    scope: "runtime",
    blocking: "sometimes",
    affinity: "any",
})
export declare function close(id: ResourceId): Result<void, PlatformError>;
