import type { PlatformError } from "../error/index.ds";
import { TtyHandle } from "../resource/index.ds";

/// TTY mode snapshot.
export struct TtyMode {
    /// Input-mode bit flags.
    inputFlags: uint64;
    /// Output-mode bit flags.
    outputFlags: uint64;
    /// Control-mode bit flags.
    controlFlags: uint64;
    /// Local-mode bit flags.
    localFlags: uint64;
}

/// Read terminal mode flags.
@binding("destack.tty.mode.getMode", {
    effect: "external",
    requires: ["tty.mode"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getMode(handle: TtyHandle): Result<TtyMode, PlatformError>;

/// Apply terminal mode flags.
@binding("destack.tty.mode.setMode", {
    effect: "external",
    requires: ["tty.mode"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setMode(handle: TtyHandle, mode: TtyMode): Result<void, PlatformError>;

/// Enable or disable raw terminal mode.
@binding("destack.tty.mode.setRawMode", {
    effect: "external",
    requires: ["tty.mode"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setRawMode(handle: TtyHandle, enabled: boolean): Result<void, PlatformError>;
