import type { PlatformError } from "../error/index.ds";
import { FileHandle, TtyHandle } from "../resource/index.ds";

/// Open one standard input terminal handle.
@binding("destack.tty.handle.stdioStdin", {
    effect: "external",
    requires: ["tty.handle"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function stdioStdin(): Result<TtyHandle, PlatformError>;

/// Open one standard output terminal handle.
@binding("destack.tty.handle.stdioStdout", {
    effect: "external",
    requires: ["tty.handle"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function stdioStdout(): Result<TtyHandle, PlatformError>;

/// Open one standard error terminal handle.
@binding("destack.tty.handle.stdioStderr", {
    effect: "external",
    requires: ["tty.handle"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function stdioStderr(): Result<TtyHandle, PlatformError>;

/// Close one terminal handle.
@binding("destack.tty.handle.close", {
    effect: "external",
    requires: ["tty.handle"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function close(handle: TtyHandle): Result<void, PlatformError>;

/// Return whether one file handle is attached to a terminal.
@binding("destack.tty.handle.isTerminalFile", {
    effect: "external",
    requires: ["tty.handle"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function isTerminalFile(handle: FileHandle): Result<boolean, PlatformError>;
