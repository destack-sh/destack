import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { ProcessId } from "../process/ids.ds";
import { TtyHandle } from "../resource/index.ds";

/// Termios set-attributes timing selector.
export enum TtyTermiosSetAction {
    /// Apply changes immediately.
    Now = 1,
    /// Apply changes after queued output drains.
    Drain = 2,
    /// Apply changes after queued output drains and discard pending input.
    Flush = 3,
}

/// Termios flush queue selector.
export enum TtyTermiosQueue {
    /// Flush pending input bytes.
    Input = 1,
    /// Flush pending output bytes.
    Output = 2,
    /// Flush pending input and output bytes.
    InputAndOutput = 3,
}

/// Termios flow-control action.
export enum TtyTermiosFlowAction {
    /// Suspend output transmission.
    SuspendOutput = 1,
    /// Resume output transmission.
    ResumeOutput = 2,
    /// Send stop control character to pause remote transmission.
    SuspendInput = 3,
    /// Send start control character to resume remote transmission.
    ResumeInput = 4,
}

/// Full POSIX termios attributes payload.
export struct TtyTermiosAttributes {
    /// Input-mode bit flags.
    inputFlags: uint64;
    /// Output-mode bit flags.
    outputFlags: uint64;
    /// Control-mode bit flags.
    controlFlags: uint64;
    /// Local-mode bit flags.
    localFlags: uint64;
    /// Control-character table bytes in host order.
    controlCharacters: Slice<uint8>;
    /// Input speed code from host termios representation.
    inputSpeedCode: uint64;
    /// Output speed code from host termios representation.
    outputSpeedCode: uint64;
}

/// POSIX termios bindings for tty handles.
/// Read full termios attributes for one terminal handle.
///
/// Read one complete termios snapshot including flag groups, control characters, and speed codes.
/// Control-character ordering follows host `c_cc` layout for the active target.
///
/// # Platform
/// Unix.
/// Uses tcgetattr(3), cfgetispeed(3), and cfgetospeed(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.getAttributes", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosGetAttributes(
    handle: TtyHandle,
): Result<TtyTermiosAttributes, PlatformError>;

/// Apply full termios attributes to one terminal handle.
///
/// Apply one complete termios snapshot with caller-selected update timing semantics.
/// Unsupported flag bits and control-character lanes follow host kernel behavior.
///
/// # Platform
/// Unix.
/// Uses tcsetattr(3), cfsetispeed(3), and cfsetospeed(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.setAttributes", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosSetAttributes(
    handle: TtyHandle,
    attributes: TtyTermiosAttributes,
    action: TtyTermiosSetAction,
): Result<void, PlatformError>;

/// Wait for pending output to drain on one terminal handle.
///
/// Block until queued terminal output bytes are transmitted according to host device behavior.
/// This does not flush input data or modify mode flags.
///
/// # Platform
/// Unix.
/// Uses tcdrain(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInterrupted, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.drain", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosDrain(handle: TtyHandle): Result<void, PlatformError>;

/// Flush one terminal queue.
///
/// Discard buffered input, output, or both queues as selected by the queue parameter.
/// Queue semantics follow host terminal driver behavior.
///
/// # Platform
/// Unix.
/// Uses tcflush(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.flush", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosFlush(
    handle: TtyHandle,
    queue: TtyTermiosQueue,
): Result<void, PlatformError>;

/// Apply terminal flow-control action.
///
/// Pause or resume output transmission, or send start and stop flow-control characters.
/// Remote and local behavior follows host line-discipline configuration.
///
/// # Platform
/// Unix.
/// Uses tcflow(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.flow", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosFlow(
    handle: TtyHandle,
    action: TtyTermiosFlowAction,
): Result<void, PlatformError>;

/// Send one terminal break condition.
///
/// Transmit one break condition on the terminal line with one host-defined duration unit.
/// A duration value of zero requests the host default break behavior.
///
/// # Platform
/// Unix.
/// Uses tcsendbreak(3).
///
/// # Errors
/// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.sendBreak", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosSendBreak(
    handle: TtyHandle,
    duration: uint32,
): Result<void, PlatformError>;

/// Read controlling-terminal process-group id.
///
/// Read the foreground process-group id currently associated with this terminal.
/// Foreground group semantics follow host session and job-control rules.
///
/// # Platform
/// Unix.
/// Uses tcgetpgrp(3).
///
/// # Errors
/// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.getProcessGroup", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosGetProcessGroup(handle: TtyHandle): Result<ProcessId, PlatformError>;

/// Set controlling-terminal process-group id.
///
/// Set the foreground process-group id for this terminal to one existing process group.
/// Permission and session checks follow host kernel job-control rules.
///
/// # Platform
/// Unix.
/// Uses tcsetpgrp(3).
///
/// # Errors
/// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
///
/// # Security
/// Requires `tty.termios`.
///
/// # Replay
/// External, recordable.
@binding("destack.tty.termios.setProcessGroup", {
    effect: "external",
    replay: "recordable",
    capabilities: ["tty.termios"],
    platforms: ["unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function termiosSetProcessGroup(
    handle: TtyHandle,
    processGroupId: ProcessId,
): Result<void, PlatformError>;
