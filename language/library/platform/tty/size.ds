import type { PlatformError } from "../error/index.ds";
import { TtyHandle } from "../resource/index.ds";

/// Terminal size descriptor.
export struct TtySize {
    /// Character rows.
    rows: uint32;
    /// Character columns.
    columns: uint32;
    /// Horizontal pixel size.
    xPixels: uint32;
    /// Vertical pixel size.
    yPixels: uint32;
}

/// Read terminal size.
@binding("destack.tty.size.getSize", {
    effect: "external",
    requires: ["tty.size"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getSize(handle: TtyHandle): Result<TtySize, PlatformError>;

/// Apply terminal size.
@binding("destack.tty.size.setSize", {
    effect: "external",
    requires: ["tty.size"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setSize(handle: TtyHandle, size: TtySize): Result<void, PlatformError>;
