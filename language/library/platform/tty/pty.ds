import type { PlatformError } from "../error/index.ds";
import { PtyHandle, TtyHandle } from "../resource/index.ds";

/// Open pseudo-terminal pair.
export struct PtyPair {
    /// Controller endpoint.
    controller: PtyHandle;
    /// Worker terminal endpoint.
    worker: TtyHandle;
}

/// Open one pseudo-terminal pair.
@binding("destack.tty.pty.open", {
    effect: "external",
    requires: ["tty.pty"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function ptyOpen(
    rows: uint32,
    columns: uint32,
    flags: uint32,
): Result<PtyPair, PlatformError>;

/// Close one pseudo-terminal controller.
@binding("destack.tty.pty.close", {
    effect: "external",
    requires: ["tty.pty"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function ptyClose(handle: PtyHandle): Result<void, PlatformError>;
