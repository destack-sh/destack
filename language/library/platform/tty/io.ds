import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { TtyHandle } from "../resource/index.ds";

/// Read bytes from a terminal.
@binding("destack.tty.io.read", {
    effect: "external",
    requires: ["tty.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function read(handle: TtyHandle, buffer: Slice<uint8>): Result<uint64, PlatformError>;

/// Write bytes to a terminal.
@binding("destack.tty.io.write", {
    effect: "external",
    requires: ["tty.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function write(handle: TtyHandle, buffer: Slice<uint8>): Result<uint64, PlatformError>;
