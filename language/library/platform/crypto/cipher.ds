import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { CryptoCipherHandle, CryptoKeyHandle } from "../resource/index.ds";
import { CryptoCipherAlgorithm } from "./algorithm.ds";

/// Cipher direction selector.
export enum CryptoCipherDirection {
    /// Encrypt payload bytes.
    Encrypt = 1,
    /// Decrypt payload bytes.
    Decrypt = 2,
}

/// Cipher parameters.
export struct CryptoCipherParameters {
    /// Symmetric cipher algorithm.
    algorithm: CryptoCipherAlgorithm;
    /// Nonce or IV bytes.
    nonce: Slice<uint8>;
    /// Additional authenticated data bytes.
    additionalData: Slice<uint8>;
    /// Authentication tag bytes for decryption.
    ///
    /// Use one empty slice when no authentication tag is required.
    tag: Slice<uint8>;
    /// Authentication tag length in bytes for encryption.
    ///
    /// Set to zero to use provider default tag length.
    tagLengthBytes?: uint32;
}

/// Cipher output.
export struct CryptoCipherOutput {
    /// Cipher output bytes.
    bytes: Slice<uint8>;
    /// Authentication tag for AEAD encryption.
    ///
    /// Use one empty slice when no authentication tag is produced.
    tag: Slice<uint8>;
}

/// Symmetric cipher bindings.
/// Encrypt one payload in one shot.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
/// Uses OpenSSL EVP symmetric-cipher primitives for software keys, and host key APIs for host-managed secret keys when available.
///
/// # Errors
/// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
///
/// # Security
/// Requires `crypto.cipher`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.crypto.cipher.encrypt", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.cipher"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function cipherEncrypt(
    key: CryptoKeyHandle,
    parameters: CryptoCipherParameters,
    payload: Slice<uint8>,
): Result<CryptoCipherOutput, PlatformError>;

/// Decrypt one payload in one shot.
///
