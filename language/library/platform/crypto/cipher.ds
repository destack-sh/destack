import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoCipherHandle, CryptoKeyHandle } from "destack:platform/resource";
import { CryptoCipherAlgorithm } from "./algorithm.ds";

/// Cipher direction selector.
export enum CryptoCipherDirection {
    /// Encrypt payload bytes.
    Encrypt = 1,
    /// Decrypt payload bytes.
    Decrypt = 2,
}

/// Cipher parameters.
export struct CryptoCipherParameters {
    /// Symmetric cipher algorithm.
    algorithm: CryptoCipherAlgorithm;
    /// Nonce or IV bytes.
    nonce: Slice<uint8>;
    /// Additional authenticated data bytes.
    additionalData: Slice<uint8>;
    /// Authentication tag bytes for decryption.
    ///
    /// Use one empty slice when no authentication tag is required.
    tag: Slice<uint8>;
    /// Authentication tag length in bytes for encryption.
    ///
    /// Set to zero to use provider default tag length.
    tagLengthBytes?: uint32;
}

/// Cipher output.
export struct CryptoCipherOutput {
    /// Cipher output bytes.
    bytes: Slice<uint8>;
    /// Authentication tag for AEAD encryption.
    ///
    /// Use one empty slice when no authentication tag is produced.
    tag: Slice<uint8>;
}

/// Encrypt one payload in one shot.
@binding("destack.crypto.cipher.encrypt", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherEncrypt(
    key: CryptoKeyHandle,
    parameters: CryptoCipherParameters,
    payload: Slice<uint8>,
): Result<CryptoCipherOutput, PlatformError>;

/// Decrypt one payload in one shot.
@binding("destack.crypto.cipher.decrypt", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherDecrypt(
    key: CryptoKeyHandle,
    parameters: CryptoCipherParameters,
    payload: Slice<uint8>,
): Result<Slice<uint8>, PlatformError>;

/// Open one streaming cipher context.
@binding("destack.crypto.cipher.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherOpen(
    key: CryptoKeyHandle,
    direction: CryptoCipherDirection,
    parameters: CryptoCipherParameters,
): Result<CryptoCipherHandle, PlatformError>;

/// Update additional authenticated data for one streaming cipher context.
@binding("destack.crypto.cipher.updateAdditionalData", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherUpdateAdditionalData(
    handle: CryptoCipherHandle,
    additionalData: Slice<uint8>,
): Result<void, PlatformError>;

/// Update one streaming cipher context with one payload chunk.
@binding("destack.crypto.cipher.update", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherUpdate(
    handle: CryptoCipherHandle,
    payload: Slice<uint8>,
): Result<Slice<uint8>, PlatformError>;

/// Finalize one streaming cipher context.
@binding("destack.crypto.cipher.finish", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherFinish(
    handle: CryptoCipherHandle,
    finalPayload: Slice<uint8>,
): Result<CryptoCipherOutput, PlatformError>;

/// Reset one streaming cipher context with new parameters.
@binding("destack.crypto.cipher.reset", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherReset(
    handle: CryptoCipherHandle,
    parameters: CryptoCipherParameters,
): Result<void, PlatformError>;

/// Close one streaming cipher context.
@binding("destack.crypto.cipher.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.cipher"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cipherClose(handle: CryptoCipherHandle): Result<void, PlatformError>;
