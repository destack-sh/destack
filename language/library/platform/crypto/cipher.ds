@binding("destack.crypto.cipher.decrypt", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.cipher"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function cipherDecrypt(
    key: CryptoKeyHandle,
    parameters: CryptoCipherParameters,
    payload: Slice<uint8>,
