@binding("destack.crypto.kdf.pbkdf2", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.kdf"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function kdfPbkdf2(request: CryptoPbkdf2Request): Result<Slice<uint8>, PlatformError>;

