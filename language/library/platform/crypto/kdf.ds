import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoDigestAlgorithm } from "./algorithm.ds";

/// HKDF request.
export struct CryptoHkdfRequest {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Input keying material.
    inputKeyMaterial: Slice<uint8>;
    /// Optional salt bytes.
    salt: Slice<uint8>;
    /// Context and application info bytes.
    info: Slice<uint8>;
    /// Output length in bytes.
    length: uint32;
}

/// PBKDF2 request.
export struct CryptoPbkdf2Request {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// Iteration count.
    iterations: uint32;
    /// Output length in bytes.
    length: uint32;
}

/// scrypt request.
export struct CryptoScryptRequest {
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// CPU and memory cost parameter.
    cost: uint32;
    /// Block size parameter.
    blockSize: uint32;
    /// Parallelization parameter.
    parallelization: uint32;
    /// Maximum memory in bytes.
    maxMemoryBytes: uint64;
    /// Output length in bytes.
    length: uint32;
}

/// Argon2id request.
export struct CryptoArgon2idRequest {
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// Optional associated data bytes.
    associatedData: Slice<uint8>;
    /// Optional secret bytes.
    secret: Slice<uint8>;
    /// Iteration count.
    iterations: uint32;
    /// Memory size in kibibytes.
    memoryKiB: uint32;
    /// Parallel workers.
    parallelism: uint32;
    /// Output length in bytes.
    length: uint32;
}

/// Derive one key with HKDF.
@binding("destack.crypto.kdf.hkdf", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.kdf"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function kdfHkdf(request: CryptoHkdfRequest): Result<Slice<uint8>, PlatformError>;

/// Derive one key with PBKDF2.
@binding("destack.crypto.kdf.pbkdf2", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.kdf"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function kdfPbkdf2(request: CryptoPbkdf2Request): Result<Slice<uint8>, PlatformError>;

/// Derive one key with scrypt.
@binding("destack.crypto.kdf.scrypt", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.kdf"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function kdfScrypt(request: CryptoScryptRequest): Result<Slice<uint8>, PlatformError>;

/// Derive one key with Argon2id.
@binding("destack.crypto.kdf.argon2id", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.kdf"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function kdfArgon2id(
    request: CryptoArgon2idRequest,
): Result<Slice<uint8>, PlatformError>;
