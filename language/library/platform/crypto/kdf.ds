import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { CryptoDigestAlgorithm } from "./algorithm.ds";

/// HKDF request.
export struct CryptoHkdfRequest {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Input keying material.
    inputKeyMaterial: Slice<uint8>;
    /// Optional salt bytes.
    salt: Slice<uint8>;
    /// Context and application info bytes.
    info: Slice<uint8>;
    /// Output length in bytes.
    length: uint32;
}

/// PBKDF2 request.
export struct CryptoPbkdf2Request {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// Iteration count.
    iterations: uint32;
    /// Output length in bytes.
    length: uint32;
}

/// scrypt request.
export struct CryptoScryptRequest {
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// CPU and memory cost parameter.
    cost: uint32;
    /// Block size parameter.
    blockSize: uint32;
    /// Parallelization parameter.
    parallelization: uint32;
    /// Maximum memory in bytes.
    maxMemoryBytes: uint64;
    /// Output length in bytes.
    length: uint32;
}

/// Argon2id request.
export struct CryptoArgon2idRequest {
    /// Password bytes.
    password: Slice<uint8>;
    /// Salt bytes.
    salt: Slice<uint8>;
    /// Optional associated data bytes.
    associatedData: Slice<uint8>;
    /// Optional secret bytes.
    secret: Slice<uint8>;
    /// Iteration count.
    iterations: uint32;
    /// Memory size in kibibytes.
    memoryKiB: uint32;
    /// Parallel workers.
    parallelism: uint32;
    /// Output length in bytes.
    length: uint32;
}

/// Key-derivation bindings.
/// Derive one key with HKDF.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
/// Uses OpenSSL KDF primitives on Unix and Windows.
///
/// # Errors
/// Returns invalidArgument, ioInvalidData, notSupported.
///
/// # Security
/// Requires `crypto.kdf`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.crypto.kdf.hkdf", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.kdf"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function kdfHkdf(request: CryptoHkdfRequest): Result<Slice<uint8>, PlatformError>;

