import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import {
    CryptoCipherAlgorithm,
    CryptoDigestAlgorithm,
    CryptoKdfAlgorithm,
    CryptoKeyAgreementAlgorithm,
    CryptoKeyAlgorithm,
    CryptoKeyFormat,
    CryptoKeyResidency,
    CryptoKeyWrapAlgorithm,
    CryptoMacAlgorithm,
    CryptoNamedCurve,
    CryptoSignatureAlgorithm,
} from "./algorithm.ds";

/// List supported key algorithm families.
@binding("destack.crypto.probe.keyAlgorithms", {
    effect: "external",
    requires: ["crypto.probe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function probeKeyAlgorithms(): Result<Slice<CryptoKeyAlgorithm>, PlatformError>;

/// List supported key formats.
@binding("destack.crypto.probe.keyFormats", {
    effect: "external",
    requires: ["crypto.probe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function probeKeyFormats(): Result<Slice<CryptoKeyFormat>, PlatformError>;

/// List supported key residencies.
@binding("destack.crypto.probe.keyResidencies", {
    effect: "external",
    requires: ["crypto.probe"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function probeKeyResidencies(): Result<Slice<CryptoKeyResidency>, PlatformError>;

