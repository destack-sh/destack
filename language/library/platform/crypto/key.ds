import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { CryptoKeyHandle, CryptoStoreHandle } from "../resource/index.ds";
import {
    CryptoAsymmetricEncryptionAlgorithm,
    CryptoDigestAlgorithm,
    CryptoKeyFormat,
    CryptoKeyKind,
    CryptoKeyResidency,
    CryptoKeyUsageMask,
    CryptoKeyWrapAlgorithm,
    CryptoNamedCurve,
    CryptoSignatureAlgorithm,
} from "./algorithm.ds";
import { CryptoStoreProvenance } from "./store.ds";

/// RSA key-generation request.
export struct CryptoKeyGenerationRequestRsa {
    /// Discriminator for this key-generation request variant.
    algorithm: "rsa";
    /// RSA modulus size in bits.
    modulusBits: uint32;
    /// RSA public exponent.
    publicExponent: uint32;
    /// Digest algorithm for RSA-PSS and RSA-OAEP defaults.
    digest?: CryptoDigestAlgorithm;
    /// Key usage mask.
    /// Use zero for no allowed key operations.
    usageMask: CryptoKeyUsageMask;
    /// User-visible key label.
    label: string;
    /// Whether key material is exportable.
    extractable: boolean;
    /// Requested key residency policy.
    residency?: CryptoKeyResidency;
    /// Whether host hardware-backed storage is required.
    hardwareBacked: boolean;
    /// Whether key material should persist beyond process lifetime.
    persistent: boolean;
}

/// EC key-generation request.
export struct CryptoKeyGenerationRequestEc {
    /// Discriminator for this key-generation request variant.
    algorithm: "ec";
    /// Named curve.
    namedCurve: CryptoNamedCurve;
    /// Key usage mask.
    /// Use zero for no allowed key operations.
    usageMask: CryptoKeyUsageMask;
    /// User-visible key label.
    label: string;
    /// Whether key material is exportable.
    extractable: boolean;
    /// Requested key residency policy.
    residency?: CryptoKeyResidency;
    /// Whether host hardware-backed storage is required.
    hardwareBacked: boolean;
    /// Whether key material should persist beyond process lifetime.
    persistent: boolean;
}

