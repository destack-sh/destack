/// Signature parameters.
export struct CryptoSignatureParameters {
    /// Signature algorithm.
    algorithm: CryptoSignatureAlgorithm;
    /// Digest algorithm.
    digest?: CryptoDigestAlgorithm;
    /// RSA-PSS salt length in bytes.
    ///
    /// Set to zero to use backend default salt behavior.
    saltLengthBytes?: uint32;
}

/// Asymmetric encryption parameters.
export struct CryptoAsymmetricEncryptionParameters {
    /// Asymmetric encryption algorithm.
    algorithm: CryptoAsymmetricEncryptionAlgorithm;
    /// Digest algorithm.
    digest?: CryptoDigestAlgorithm;
    /// OAEP label bytes.
    ///
    /// Use one empty slice for no label.
    label: Slice<uint8>;
}

/// Private-key export request.
export struct CryptoPrivateKeyExportRequest {
    /// Requested output format.
    format: CryptoKeyFormat;
    /// Passphrase bytes for encrypted private-key formats.
    ///
    /// Provide one non-empty passphrase for `Pkcs8EncryptedPem` and `Pkcs8EncryptedDer`.
    /// Use one empty slice for unencrypted private-key formats.
    passphrase: Slice<uint8>;
}

/// Key-wrap parameters.
export struct CryptoKeyWrapParameters {
    /// Key-wrap algorithm.
    algorithm: CryptoKeyWrapAlgorithm;
    /// Digest algorithm for RSA-OAEP wrapping.
    digest?: CryptoDigestAlgorithm;
    /// OAEP label for RSA-OAEP wrapping.
    ///
    /// Use one empty slice for no label.
    label: Slice<uint8>;
}

/// Key bindings for runtime store key objects.
@binding("destack.crypto.key.generateSecret", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.key.generate"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyGenerateSecret(
    store: CryptoStoreHandle,
    request: CryptoKeyGenerationRequest,
): Result<CryptoKeyHandle, PlatformError>;

/// Generate one asymmetric key pair.
@binding("destack.crypto.key.generatePair", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.key.generate"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyGeneratePair(
    store: CryptoStoreHandle,
    request: CryptoKeyGenerationRequest,
): Result<CryptoKeyPair, PlatformError>;

/// Import one key object.
@binding("destack.crypto.key.import", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.store.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyImport(
    store: CryptoStoreHandle,
    request: CryptoKeyImportRequest,
): Result<CryptoKeyHandle, PlatformError>;

/// Export one public key.
@binding("destack.crypto.key.exportPublic", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.store.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyExportPublic(
    handle: CryptoKeyHandle,
    format: CryptoKeyFormat,
): Result<Slice<uint8>, PlatformError>;

/// Export one private key.
@binding("destack.crypto.key.exportPrivate", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.store.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyExportPrivate(
    handle: CryptoKeyHandle,
    request: CryptoPrivateKeyExportRequest,
): Result<Slice<uint8>, PlatformError>;

/// Export one secret key.
@binding("destack.crypto.key.exportSecret", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.store.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function keyExportSecret(
    handle: CryptoKeyHandle,
    format: CryptoKeyFormat,
): Result<Slice<uint8>, PlatformError>;

/// Return one key descriptor.
@binding("destack.crypto.key.descriptor", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.store.read"],
