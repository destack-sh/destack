import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoKeyHandle, CryptoMacHandle } from "destack:platform/resource";
import { CryptoDigestAlgorithm, CryptoMacAlgorithm } from "./algorithm.ds";

/// MAC parameters.
export struct CryptoMacParameters {
    /// Message authentication algorithm.
    algorithm: CryptoMacAlgorithm;
    /// Digest algorithm for HMAC.
    digest: CryptoDigestAlgorithm;
    /// Output tag length in bytes.
    ///
    /// Set to zero to use provider default tag length.
    tagLengthBytes?: uint32;
}

/// Compute one message authentication code in one shot.
@binding("destack.crypto.mac.compute", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macCompute(
    key: CryptoKeyHandle,
    parameters: CryptoMacParameters,
    payload: Slice<uint8>,
): Result<Slice<uint8>, PlatformError>;

/// Verify one message authentication code in one shot.
@binding("destack.crypto.mac.verify", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macVerify(
    key: CryptoKeyHandle,
    parameters: CryptoMacParameters,
    payload: Slice<uint8>,
    tag: Slice<uint8>,
): Result<boolean, PlatformError>;

/// Open one streaming MAC context.
@binding("destack.crypto.mac.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macOpen(
    key: CryptoKeyHandle,
    parameters: CryptoMacParameters,
): Result<CryptoMacHandle, PlatformError>;

/// Update one streaming MAC context.
@binding("destack.crypto.mac.update", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macUpdate(
    handle: CryptoMacHandle,
    payload: Slice<uint8>,
): Result<void, PlatformError>;

/// Finalize one streaming MAC context and return one tag.
@binding("destack.crypto.mac.finish", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macFinish(handle: CryptoMacHandle): Result<Slice<uint8>, PlatformError>;

/// Reset one streaming MAC context to its initial state.
@binding("destack.crypto.mac.reset", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macReset(handle: CryptoMacHandle): Result<void, PlatformError>;

/// Close one streaming MAC context.
@binding("destack.crypto.mac.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function macClose(handle: CryptoMacHandle): Result<void, PlatformError>;
