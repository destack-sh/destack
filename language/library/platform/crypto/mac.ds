import { Array } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoKeyHandle, CryptoMacHandle } from "destack:platform/resource";
import { CryptoDigestAlgorithm, CryptoMacAlgorithm } from "./algorithm.ds";

/// MAC parameters.
export struct CryptoMacParameters {
    /// Message authentication algorithm.
    algorithm: CryptoMacAlgorithm;
    /// Digest algorithm for HMAC.
    digest: CryptoDigestAlgorithm;
    /// Output tag length in bytes.
    tagLength?: uint32;
}

/// Compute one message authentication code in one shot.
@binding("destack.crypto.mac.compute", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function computeMac(
    key: CryptoKeyHandle,
    parameters: &readonly CryptoMacParameters,
    payload: &readonly [uint8],
): Result<^Array<uint8>, PlatformError>;

/// Verify one message authentication code in one shot.
@binding("destack.crypto.mac.verify", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function verifyMac(
    key: CryptoKeyHandle,
    parameters: &readonly CryptoMacParameters,
    payload: &readonly [uint8],
    tag: &readonly [uint8],
): Result<boolean, PlatformError>;

/// Open one streaming MAC context.
@binding("destack.crypto.mac.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openMac(
    key: CryptoKeyHandle,
    parameters: &readonly CryptoMacParameters,
): Result<CryptoMacHandle, PlatformError>;

/// Update one streaming MAC context.
@binding("destack.crypto.mac.update", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function updateMac(
    mac: CryptoMacHandle,
    payload: &readonly [uint8],
): Result<void, PlatformError>;

/// Finalize one streaming MAC context and return one tag.
@binding("destack.crypto.mac.finish", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function finishMac(mac: CryptoMacHandle): Result<^Array<uint8>, PlatformError>;

/// Close one streaming MAC context.
@binding("destack.crypto.mac.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.crypto.mac"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeMac(mac: CryptoMacHandle): Result<void, PlatformError>;
