    capabilities: ["crypto.digest"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function digestFinish(handle: CryptoDigestHandle): Result<Slice<uint8>, PlatformError>;

