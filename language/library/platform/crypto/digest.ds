import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";
import { CryptoDigestHandle } from "../resource/index.ds";
import { CryptoDigestAlgorithm } from "./algorithm.ds";

/// Digest bindings.
/// Compute one digest in one shot.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
/// Uses OpenSSL EVP digest primitives on Unix and Windows.
///
/// # Errors
/// Returns invalidArgument, ioInvalidData, notSupported.
///
/// # Security
/// Requires `crypto.digest`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.crypto.digest.compute", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.digest"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function digestCompute(
    algorithm: CryptoDigestAlgorithm,
    payload: Slice<uint8>,
): Result<Slice<uint8>, PlatformError>;

/// Open one streaming digest context.
///
/// # Platform
/// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
/// Uses OpenSSL EVP digest primitives on Unix and Windows.
///
/// # Errors
/// Returns invalidArgument, ioInvalidData, notSupported.
///
/// # Security
/// Requires `crypto.digest`.
///
/// # Replay
/// External, nonrecordable.
@binding("destack.crypto.digest.open", {
    effect: "external",
    replay: "nonrecordable",
    capabilities: ["crypto.digest"],
    platforms: ["windows", "unix"],
    simulation: "model",
    scope: "host",
    blocking: "sometimes",
    affinity: "any",
})
export declare function digestOpen(
    algorithm: CryptoDigestAlgorithm,
): Result<CryptoDigestHandle, PlatformError>;

