import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoDigestHandle } from "destack:platform/resource";
import { CryptoDigestAlgorithm } from "./algorithm.ds";

/// Compute one digest in one shot.
@binding("destack.crypto.digest.compute", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestCompute(
    algorithm: CryptoDigestAlgorithm,
    payload: Slice<uint8>,
): Result<Slice<uint8>, PlatformError>;

/// Open one streaming digest context.
@binding("destack.crypto.digest.open", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestOpen(
    algorithm: CryptoDigestAlgorithm,
): Result<CryptoDigestHandle, PlatformError>;

/// Update one streaming digest context.
@binding("destack.crypto.digest.update", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestUpdate(
    handle: CryptoDigestHandle,
    payload: Slice<uint8>,
): Result<void, PlatformError>;

/// Finalize one streaming digest context and return one digest output.
@binding("destack.crypto.digest.finish", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestFinish(handle: CryptoDigestHandle): Result<Slice<uint8>, PlatformError>;

/// Reset one streaming digest context to its initial state.
@binding("destack.crypto.digest.reset", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestReset(handle: CryptoDigestHandle): Result<void, PlatformError>;

/// Close one streaming digest context.
@binding("destack.crypto.digest.close", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.digest"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function digestClose(handle: CryptoDigestHandle): Result<void, PlatformError>;
