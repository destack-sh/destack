import { Slice } from "core";
import type { PlatformError } from "../error/index.ds";

/// Fill one mutable byte slice with cryptographically secure random bytes.
@binding("destack.crypto.random.fill", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.random"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function randomFill(buffer: Slice<uint8>): Result<void, PlatformError>;

/// Allocate one random byte vector with the requested length.
@binding("destack.crypto.random.bytes", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.random"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function randomBytes(length: uint32): Result<Slice<uint8>, PlatformError>;
