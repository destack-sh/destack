import { Slice } from "destack:collections";
import { PlatformError } from "destack:platform/error";
import { CryptoKeyHandle } from "destack:platform/resource";
import { CryptoDigestAlgorithm, CryptoKeyAgreementAlgorithm } from "./algorithm.ds";

/// Key-agreement key-derivation request.
export struct CryptoAgreementDeriveKeyRequest {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm used by the KDF stage.
    digest: CryptoDigestAlgorithm;
    /// KDF salt bytes.
    salt: Slice<uint8>;
    /// KDF context info bytes.
    info: Slice<uint8>;
    /// Derived key length in bytes.
    outputLength: uint32;
}

/// Derive one shared secret from one local private key and one peer public key.
@binding("destack.crypto.agreement.deriveSharedSecret", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.key.agree"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function agreementDeriveSharedSecret(
    privateKey: CryptoKeyHandle,
    peerPublicKey: CryptoKeyHandle,
    algorithm: CryptoKeyAgreementAlgorithm,
): Result<Slice<uint8>, PlatformError>;

/// Derive one symmetric key from one local private key and one peer public key.
@binding("destack.crypto.agreement.deriveKey", {
    effect: "external",
    replay: "forbidden",
    requires: ["crypto.key.agree", "crypto.kdf"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function agreementDeriveKey(
    privateKey: CryptoKeyHandle,
    peerPublicKey: CryptoKeyHandle,
    request: CryptoAgreementDeriveKeyRequest,
): Result<Slice<uint8>, PlatformError>;
