import type { HostAction } from "./action.ds";

/// Platform tags accepted by runtime bindings.
export type PlatformTag =
    | "windows"
    | "macos"
    | "linux"
    | "freebsd"
    | "openbsd"
    | "netbsd"
    | "dragonfly"
    | "solaris"
    | "illumos"
    | "haiku"
    | "fuchsia"
    | "redox"
    | "hermit"
    | "ios"
    | "android";

/// Platform family selectors accepted by runtime bindings.
export type PlatformFamilyTag = "windows" | "unix";

/// Host tags accepted by runtime bindings.
export type HostTag = "native" | "browser" | "wasi" | "emscripten" | "freestanding";

/// Options for runtime bindings.
export type BindingOptions = {
    /// Effect kind for the binding.
    effect: "pure" | "deterministic" | "external";
    /// Host actions required by this binding.
    requires: HostAction[];
    /// Platforms that support this binding.
    platforms?: PlatformTag[];
    /// Platform families that support this binding.
    families?: PlatformFamilyTag[];
    /// Hosts that support this binding.
    hosts?: HostTag[];
    /// Marks bindings implemented by runtime state instead of the host.
    provider?: "runtime";
    /// Replay override for external effects.
    replay?: "forbidden";
    /// Execution context required by this binding.
    affinity?: "worker" | "main";
    /// Whether this binding can execute against a simulated world.
    simulation?: boolean;
};

/// Marks something as a runtime binding.
///
/// ```
/// @binding("destack.fs.open", {
///   effect: "external",
///   requires: ["fs.open"],
///   families: ["windows", "unix"],
///   simulation: true,
/// })
/// function open() { }
/// ```
export newtype binding = (string, BindingOptions,);
