import type { PlatformCapability } from "./capability.ds";

/// Platform selector tags for runtime binding availability.
export type PlatformTag = "windows" | "unix" | "wasi" | "linux" | "macos" | "bsd";

/// Options for runtime bindings.
export type BindingOptions = {
    /// Effect classification for the binding.
    effect: "pure" | "deterministic" | "external" | "io";
    /// Replay policy for external effects.
    replay?: "recordable" | "nonrecordable";
    /// Replay payload policy for the binding.
    payload?: "results" | "argumentsAndResults";
    /// Capability requirements for this binding.
    capabilities?: PlatformCapability[];
    /// Platform availability tags for this binding.
    platforms?: PlatformTag[];
    /// Platform scope for this binding.
    scope?: "host" | "runtime";
    /// Blocking behavior classification for this binding.
    blocking?: "always" | "never" | "sometimes";
};

/// Marks something as a runtime binding.
///
/// ```
/// @binding("destack.fs.open", {
///   effect: "external",
///   replay: "recordable",
///   payload: "results",
/// })
/// function open() { }
/// ```
export newtype binding = (string, BindingOptions,);
