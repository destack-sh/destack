import { todo } from "destack:error";
import { Iterator } from "destack:iter";

/// Immutable byte sequence.
export type Bytes = readonly [uint8];

/// Byte order for numeric encoding.
export type ByteOrder = "bigEndian" | "littleEndian";

/// Read one unsigned 16-bit integer.
export function readUint16(
    bytes: &readonly [uint8],
    offset: usize,
    order: ByteOrder = "bigEndian",
): uint16 {
    todo("bytes.readUint16")
}

/// Read one unsigned 32-bit integer.
export function readUint32(
    bytes: &readonly [uint8],
    offset: usize,
    order: ByteOrder = "bigEndian",
): uint32 {
    todo("bytes.readUint32")
}

