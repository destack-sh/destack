/// Immutable byte sequence.
export type Bytes = readonly [uint8];

/// Compare two byte sequences lexicographically.
export function compare(left: &readonly [uint8], right: &readonly [uint8]): int32 {
    todo("bytes.compare")
}

/// Return whether two byte sequences are equal.
export function equal(left: &readonly [uint8], right: &readonly [uint8]): boolean {
    todo("bytes.equal")
}

/// Return whether `bytes` contains `needle`.
export function contains(bytes: &readonly [uint8], needle: &readonly [uint8]): boolean {
    todo("bytes.contains")
}

/// Return whether `bytes` starts with `prefix`.
export function startsWith(bytes: &readonly [uint8], prefix: &readonly [uint8]): boolean {
    todo("bytes.startsWith")
}

/// Return whether `bytes` ends with `suffix`.
export function endsWith(bytes: &readonly [uint8], suffix: &readonly [uint8]): boolean {
    todo("bytes.endsWith")
