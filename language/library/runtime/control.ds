import { HostError } from "destack:error/host";
import { RevisionId } from "./lineage.ds";
import { WorldHandle } from "./world.ds";

/// Runtime control event kind.
export enum ControlEventKind {
    /// The runtime paused execution.
    Paused = 1,
    /// The runtime resumed execution.
    Resumed = 2,
    /// The runtime completed one step.
    Stepped = 3,
    /// The runtime reached a breakpoint.
    Breakpoint = 4,
}

/// Runtime control event.
export struct ControlEvent {
    /// Event kind.
    kind: ControlEventKind;
    /// Event revision.
    revision: RevisionId;
}

/// Pause one world.
@binding("destack.runtime.control.pause", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function pauseWorld(world: WorldHandle): Result<void, HostError>;

/// Resume one world.
@binding("destack.runtime.control.resume", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function resumeWorld(world: WorldHandle): Result<void, HostError>;

/// Advance one world by one debugger step.
@binding("destack.runtime.control.step", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function stepWorld(world: WorldHandle): Result<ControlEvent, HostError>;

/// Request a debugger break in one world.
@binding("destack.runtime.control.break", {
    effect: "deterministic",
    requires: ["runtime.world.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function breakWorld(world: WorldHandle): Result<void, HostError>;
