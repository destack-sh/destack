import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { ResourceId } from "./resource.ds";
import { WorldViewHandle, WorkerId } from "./world.ds";

/// Heap summary for one worker.
export struct HeapSummary {
    /// Total heap bytes.
    heapBytes: uint64;
    /// Total captured page count.
    pageCount: uint32;
    /// Completed GC cycle count.
    gcCycles: uint64;
}

/// Runtime heap object identifier.
export newtype HeapObjectId = uint64;

/// Runtime heap object.
export struct HeapObject {
    /// Object identifier.
    id: HeapObjectId;
    /// Object byte size.
    sizeBytes: uint64;
    /// Resource represented by this object when present.
    resource?: ResourceId;
}

/// Runtime heap object edge.
export struct HeapEdge {
    /// Source object.
    from: HeapObjectId;
    /// Target object.
    to: HeapObjectId;
    /// Edge byte offset.
    offsetBytes: uint64;
}

/// Heap object list page.
export struct HeapObjectPage {
    /// Heap object records in this page.
    objects: Array<HeapObject>;
    /// Next object cursor when more records exist.
    next?: HeapObjectId;
}

/// Heap edge list page.
export struct HeapEdgePage {
    /// Heap edge records in this page.
    edges: Array<HeapEdge>;
    /// Next edge byte offset when more records exist.
    nextOffset?: uint64;
}

/// Read one worker heap summary.
@binding("destack.runtime.heap.summary", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function readHeap(
    view: WorldViewHandle,
    worker: WorkerId,
): Result<HeapSummary, HostError>;

/// List heap objects for one worker.
@binding("destack.runtime.heap.objects", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function listHeapObjects(
    view: WorldViewHandle,
    worker: WorkerId,
    limit: uint32,
    after?: HeapObjectId,
): Result<HeapObjectPage, HostError>;

/// List outgoing heap edges from one object.
@binding("destack.runtime.heap.edges", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function listHeapEdges(
    view: WorldViewHandle,
    object: HeapObjectId,
    limit: uint32,
    afterOffset?: uint64,
): Result<HeapEdgePage, HostError>;
