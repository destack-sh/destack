/// Remove one scenario rule.
@binding("destack.runtime.scenario.ruleRemove", {
    effect: "deterministic",
    requires: ["runtime.scenario.write"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function scenarioRuleRemove(
    scenario: ScenarioHandle,
