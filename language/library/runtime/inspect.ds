import { HostError } from "destack:error/host";
import {
    Edge,
    EdgeFilter,
    EdgeId,
    EdgePage,
    Entity,
    EntityFilter,
    EntityId,
    EntityPage,
    LabelSelector,
} from "./entity.ds";
import { Image } from "./lineage.ds";
import { Resource, ResourceId, ResourceKind, ResourcePage } from "./resource.ds";
import { Revision } from "./lineage.ds";
import { Trace } from "./trace.ds";
import {
    RuntimeFilter,
    Runtime,
    RuntimeId,
    RuntimePage,
    Worker,
    WorkerFilter,
    WorkerId,
    WorkerPage,
    World,
    WorldHandle,
    WorldViewHandle,
    WorldViewOptions,
} from "./world.ds";

/// Filter for runtime resources.
export struct ResourceFilter {
    /// Optional owning runtime selector.
    runtime?: RuntimeId;
    /// Optional owning worker selector.
    worker?: WorkerId;
    /// Optional resource kind selector.
    kind?: ResourceKind;
    /// Optional label selector clauses.
    labels?: [LabelSelector];
}

/// Event loop state for one worker.
export struct EventLoop {
    /// Ready task count.
    taskCount: uint32;
    /// Pending microtask count.
    microtaskCount: uint32;
    /// Timer count.
    timerCount: uint32;
    /// Watch count.
    watchCount: uint32;
    /// Whether pending work exists.
    hasPendingWork: boolean;
}

/// Engine view kind for one worker.
export enum EngineViewKind {
    /// VM isolate-backed execution.
    Isolate = 1,
    /// Native engine-backed execution.
    Native = 2,
}

/// Engine state for one worker.
export struct EngineView {
    /// Engine implementation kind.
    kind: EngineViewKind;
    /// Call stack depth.
    callStackDepth?: uint32;
    /// Value stack length.
    valueStackDepth?: uint32;
    /// Local stack length.
    localStackDepth?: uint32;
    /// Image backing size in bytes.
    imageBytes?: uint64;
}

/// Open one pinned world view.
@binding("destack.runtime.inspect.worldViewOpen", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldViewOpen(
    world: WorldHandle,
    options?: WorldViewOptions,
): Result<WorldViewHandle, HostError>;

/// Close one pinned world view.
@binding("destack.runtime.inspect.worldViewClose", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldViewClose(view: WorldViewHandle): Result<void, HostError>;

