import {
    type Declaration,
    type Member,
    type Scope,
    type Symbol,
} from "destack:reflect/dir";

/// What caused one macro invocation.
export type MacroTrigger = "decorator" | "autoDerive";

/// Shared context passed to macro providers.
@languageItem("macro.MacroContext")
export interface MacroContext {
    /// What caused this macro invocation.
    readonly trigger: MacroTrigger;

    /// The decorated target symbol when one exists.
    readonly symbol?: Symbol;

    /// The containing scope.
    readonly scope: Scope;

    /// The local name of the decorated target when one exists.
    readonly name?: string;

    /// Resolve a visible symbol in the current scope.
    resolve(name: string): Symbol | undefined;

    /// Ensure an import used by generated code.
    ensureImport(source: string, name: string, alias?: string): Symbol;
}

/// Context for declaration expansion.
///
/// Expansion runs to a fixed point, so generated declarations may contain more macros.
@languageItem("macro.ExpansionContext")
export interface ExpansionContext extends MacroContext {
    /// Add a generated declaration to the current scope.
    add(declaration: Declaration): void;

    /// Ensure a generated declaration exists in the current scope.
    ensureDeclaration(name: string, declaration: () => Declaration): Symbol;

    /// Add a generated child to the decorated declaration.
    addChild(child: Member): void;

    /// Replace the decorated target with a generated declaration.
    replaceTarget(declaration: Declaration): void;

    /// Rename the decorated target.
    renameTarget(name: string): void;

    /// Remove the decorated target from the visible declaration set.
    removeTarget(): void;
}

/// Context for checked implementation materialization.
///
/// Materialization cannot introduce new visible declarations or new macro invocations.
@languageItem("macro.MaterializationContext")
export interface MaterializationContext extends MacroContext {
    /// Replace the decorated target with a checked generated declaration.
    replaceTarget(declaration: Declaration): void;
}

/// Protocol for decorator values that provide macro behavior.
///
/// `State` is serializable static data carried from expansion to materialization.
/// Each expansion invocation runs once for its target node, trigger, implementation, and config.
@languageItem("macro.Macro")
export newtype interface Macro<Target, State = void> {
    /// Expand declarations for the decorated target.
    static expand?(target: Target, context: ExpansionContext, config: this): State;

    /// Materialize checked implementation details for the decorated target.
    static materialize?(
        target: Target,
        context: MaterializationContext,
        config: this,
        state: State,
    ): void;
}
