import { type Result } from "destack:error";
import { type Space, type WithSpace } from "./form.ds";

/// Layout requested from an allocator.
export struct AllocationLayout {
    /// The requested size in bytes.
    size: usize;
    /// The required alignment in bytes.
    align: usize;
}

/// Failure kind returned by an allocator.
export type AllocationErrorKind =
    | "outOfMemory"
    | "invalidLayout"
    | "unsupported";

/// Allocation failure.
export struct AllocationError {
    /// The failure kind.
    kind: AllocationErrorKind;
    /// Human-readable detail when available.
    message?: string;
}

/// Raw allocation in space `S`, viewed as elements of `T`.
export newtype Allocation<T = uint8, S: Space = "local"> = {
    /// The allocated pointer.
    pointer: WithSpace<*T, S>;
    /// The allocated layout.
    layout: AllocationLayout;
};

/// Low-level allocator for raw memory in space `S`.
export newtype interface Allocator<S: Space = "local"> {
    /// Allocate raw memory.
    allocate<T = uint8>(layout: AllocationLayout): Result<Allocation<T, S>, AllocationError>;

    /// Free raw memory.
    deallocate<T>(allocation: Allocation<T, S>): void;

    /// Resize raw memory.
    resize<T>(allocation: Allocation<T, S>, layout: AllocationLayout): Result<Allocation<T, S>, AllocationError>;
}

/// Return the default allocator for space `S`.
@intrinsic("memory.allocator.default")
export declare function defaultAllocator<S: Space = "local">(): Allocator<S>;
