import { Error, Result, todo } from "destack:error";
import { alignOf, sizeOf } from "destack:reflect";
import { Space, WithSpace } from "./form.ds";

/// Layout requested from an allocator.
export struct AllocationLayout {
    /// The requested size in bytes.
    size: usize;
    /// The required alignment in bytes.
    alignment: usize;
}

/// Failure kind returned by an allocator.
export enum AllocationErrorKind {
    /// The allocator could not reserve enough memory.
    OutOfMemory,
    /// The requested layout is invalid.
    InvalidLayout,
    /// The allocator does not support the requested layout.
    UnsupportedLayout,
}

/// Allocation failure.
export struct AllocationError {
    /// The failure kind.
    kind: AllocationErrorKind;
    /// Human-readable detail when available.
    message?: string;
}

extension of AllocationError implements Error {
    /// Format this error for users.
    display(): string {
        this.message ?? "allocation failed"
    }
}

export extension of AllocationLayout {
    /// Create an allocation layout.
    static new(size: usize, alignment: usize): AllocationLayout {
        AllocationLayout { size, alignment }
    }

    /// Try to create an allocation layout.
    static tryNew(size: usize, alignment: usize): Result<AllocationLayout, AllocationError> {
        todo("AllocationLayout.tryNew")
    }

    /// Return the layout of one `T`.
    static fromType<T>(): AllocationLayout {
        AllocationLayout {
            size: sizeOf<T>(),
            alignment: alignOf<T>(),
        }
    }

    /// Return the layout of `length` contiguous `T` values.
    static array<T>(length: usize): AllocationLayout {
        AllocationLayout {
            size: sizeOf<T>() * length,
            alignment: alignOf<T>(),
        }
    }

    /// Try to return the layout of `length` contiguous `T` values.
    static tryArray<T>(length: usize): Result<AllocationLayout, AllocationError> {
        todo("AllocationLayout.tryArray")
    }

    /// Return the size rounded up to this layout's alignment.
    paddedSize(): usize {
        const mask = this.alignment - 1;
        (this.size + mask) & ~mask
    }
}

/// Raw allocation in space `S`, viewed as elements of `T`.
export newtype Allocation<T = uint8, S: Space = "local"> = {
    /// The allocated pointer.
    pointer: WithSpace<*T, S>;
    /// The allocated layout.
    layout: AllocationLayout;
};

/// Low-level allocator for raw memory in space `S`.
export newtype interface Allocator<S: Space = "local"> {
    /// Allocate raw memory.
    allocate<T = uint8>(layout: AllocationLayout): Result<Allocation<T, S>, AllocationError>;

    /// Allocate zero-filled raw memory.
    allocateZeroed<T = uint8>(layout: AllocationLayout): Result<Allocation<T, S>, AllocationError>;

    /// Free raw memory.
    @unsafe
    deallocate<T>(allocation: Allocation<T, S>): void;

    /// Grow raw memory to a larger layout.
    @unsafe
    grow<T>(
        allocation: Allocation<T, S>,
        layout: AllocationLayout,
    ): Result<Allocation<T, S>, AllocationError>;

    /// Shrink raw memory to a smaller layout.
    @unsafe
    shrink<T>(
        allocation: Allocation<T, S>,
        layout: AllocationLayout,
    ): Result<Allocation<T, S>, AllocationError>;
}

/// Return the default allocator for space `S`.
@intrinsic("memory.allocator.default")
export declare function defaultAllocator<S: Space = "local">(): Allocator<S>;
