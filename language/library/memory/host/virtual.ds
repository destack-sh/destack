import { HostError } from "destack:error/host";

/// Virtual memory address range.
export struct VirtualMemoryRange {
    /// Base virtual address.
    address: uint64;
    /// Range length in bytes.
    length: uint64;
}

/// Bitmask of virtual memory protection permissions.
export newtype MemoryProtection = uint32;

/// Flags for virtual memory reservation operations.
export newtype VirtualMemoryReserveFlags = uint32;

/// No protection bits.
export const MEMORY_PROTECTION_NONE: MemoryProtection = MemoryProtection(0x0);

/// Allow reads from mapped pages.
export const MEMORY_PROTECTION_READ: MemoryProtection = MemoryProtection(0x1);

/// Allow writes to mapped pages.
export const MEMORY_PROTECTION_WRITE: MemoryProtection = MemoryProtection(0x2);

/// Allow instruction fetch from mapped pages.
export const MEMORY_PROTECTION_EXECUTE: MemoryProtection = MemoryProtection(0x4);

/// No reserve flags.
export const VIRTUAL_MEMORY_RESERVE_NONE: VirtualMemoryReserveFlags =
    VirtualMemoryReserveFlags(0x0);

/// Prefer high virtual addresses where supported.
export const VIRTUAL_MEMORY_RESERVE_TOP_DOWN: VirtualMemoryReserveFlags =
    VirtualMemoryReserveFlags(0x1);

/// Reserve address space without guaranteed swap reservation where supported.
export const VIRTUAL_MEMORY_RESERVE_NO_RESERVE: VirtualMemoryReserveFlags =
    VirtualMemoryReserveFlags(0x2);

/// Reserve one virtual memory range.
@binding("destack.memory.virtual.reserve", {
    effect: "external",
    requires: ["host.memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function reserveVirtualMemory(
    length: uint64,
    flags: VirtualMemoryReserveFlags,
    addressHint?: uint64,
): Result<VirtualMemoryRange, HostError>;

/// Commit physical backing for one reserved virtual memory range.
@binding("destack.memory.virtual.commit", {
    effect: "external",
    requires: ["host.memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function commitVirtualMemory(
    range: VirtualMemoryRange,
    protection: MemoryProtection,
): Result<void, HostError>;

/// Decommit physical backing from one virtual memory range.
@binding("destack.memory.virtual.decommit", {
    effect: "external",
    requires: ["host.memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function decommitVirtualMemory(range: VirtualMemoryRange): Result<void, HostError>;

/// Release one reserved virtual memory range.
@binding("destack.memory.virtual.release", {
    effect: "external",
    requires: ["host.memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function releaseVirtualMemory(range: VirtualMemoryRange): Result<void, HostError>;

/// Change virtual memory protection for one range.
@binding("destack.memory.virtual.protect", {
    effect: "external",
    requires: ["host.memory.virtual"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function protectVirtualMemory(
    range: VirtualMemoryRange,
    protection: MemoryProtection,
): Result<void, HostError>;

/// Flush instruction cache for one executable memory range.
@binding("destack.memory.virtual.instructionCache.flush", {
    effect: "external",
    requires: ["host.memory.execute"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function flushInstructionCache(range: VirtualMemoryRange): Result<void, HostError>;
