import { todo, Result } from "destack:error";
import { As, Borrow } from "destack:convert";
import { Dereference } from "destack:ops";
import { AllocationError } from "../allocator.ds";
import { Clone, Default, Unpin, Zeroable } from "../capability.ds";
import { Owned } from "../form.ds";
import { MaybeUninit } from "../init.ds";
import { Pin } from "../pin.ds";
import { Weak } from "./weak.ds";

/// Reference-counted heap block for one worker.
@languageItem("memory.rc.RcInner")
export struct RcInner<T> {
    /// The strong reference count.
    strong: usize;

    /// The weak reference count.
    weak: usize;

    /// The stored value.
    value: MaybeUninit<T>;
}

extension<T> of Rc<T> implements Unpin {}

/// Local reference-counted ownership.
@languageItem("memory.rc.Rc")
export struct Rc<T> {
    /// The inner block.
    inner: *RcInner<Owned<T>>;
}

extension<T> of Rc<T> implements Clone, Dereference, As<T>, Borrow<T> {
    /// The projected result form.
    type Output = &readonly T;

    /// Allocate a new reference-counted value.
    static new(value: ^T): Rc<T> {
        todo("Rc.new")
    }

    /// Try to allocate a new reference-counted value.
    static tryNew(value: ^T): Result<Rc<T>, AllocationError> {
        todo("Rc.tryNew")
    }

    /// Allocate a new reference-counted value that can refer to its weak handle.
    static newCyclic(makeValue: (weak: Weak<T>) => ^T): Rc<T> {
        todo("Rc.newCyclic")
    }

    /// Allocate uninitialized storage.
    static newUninit(): Rc<MaybeUninit<T>> {
        todo("Rc.newUninit")
    }

    /// Try to allocate uninitialized storage.
    static tryNewUninit(): Result<Rc<MaybeUninit<T>>, AllocationError> {
        todo("Rc.tryNewUninit")
    }

    /// Allocate zeroed storage.
    static newZeroed(): Rc<MaybeUninit<T>>
    where T implements Zeroable {
        todo("Rc.newZeroed")
    }

    /// Try to allocate zeroed storage.
    static tryNewZeroed(): Result<Rc<MaybeUninit<T>>, AllocationError>
    where T implements Zeroable {
        todo("Rc.tryNewZeroed")
    }

    /// Create a reference-counted handle from a raw value pointer.
    @unsafe
    static fromRaw(pointer: *T): Rc<T> {
        todo("Rc.fromRaw")
    }

    /// Allocate a new pinned reference-counted value.
    static pin(value: ^T): Pin<Rc<T>> {
        todo("Rc.pin")
    }

    /// Try to allocate a new pinned reference-counted value.
    static tryPin(value: ^T): Result<Pin<Rc<T>>, AllocationError> {
        todo("Rc.tryPin")
    }

    /// Clone this strong handle.
    clone(): Rc<T> {
        todo("Rc.clone")
    }

    /// Create a weak handle to the same block.
    downgrade(): Weak<T> {
        todo("Rc.downgrade")
    }

    /// Return whether this handle is the only strong handle.
    isUnique(): boolean {
        todo("Rc.isUnique")
    }

    /// Return whether this handle points to the same allocation as `other`.
    pointerEquals(other: Rc<T>): boolean {
        todo("Rc.pointerEquals")
    }

    /// Return the strong reference count.
    strongCount(): usize {
        todo("Rc.strongCount")
    }

    /// Return the weak reference count.
    weakCount(): usize {
        todo("Rc.weakCount")
    }

    /// Move the value out when this is the only strong handle.
    intoInner(this: ^Rc<T>): ^T | undefined {
        todo("Rc.intoInner")
    }

    /// Move the value out when this is the only strong handle.
    tryUnwrap(this: ^Rc<T>): Result<^T, Rc<T>> {
        todo("Rc.tryUnwrap")
    }

    /// Move the value out or clone it when shared.
    unwrapOrClone(this: ^Rc<T>): ^T
    where T implements Clone {
        todo("Rc.unwrapOrClone")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(): *T {
        todo("Rc.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this: ^Rc<T>): *T {
        todo("Rc.intoRaw")
    }

    /// Borrow the value exclusively when this is the only strong handle.
    getExclusive(this: &exclusive Rc<T>): &exclusive T | undefined {
        todo("Rc.getExclusive")
    }

    /// Borrow the value exclusively, cloning first if needed.
    makeExclusive(this: &exclusive Rc<T>): &exclusive T
    where T implements Clone {
        todo("Rc.makeExclusive")
    }

    /// Borrow the referenced value.
    dereference(): this.Output {
        todo("Rc.dereference")
    }

    /// Borrow the referenced value.
    as(this: &readonly Rc<T>): &readonly T {
        this.dereference()
    }

    /// Borrow the referenced value.
    borrow(this: &readonly Rc<T>): &readonly T {
        this.dereference()
    }
}

extension<T> of Rc<T> implements Default
where T implements Default {
    /// Create a reference-counted handle with the default value.
    static default(): Rc<T> {
        Rc.new(T.default())
    }
}
