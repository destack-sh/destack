import { todo } from "destack:error";
import { Owned } from "../form.ds";
import { Rc, RcInner } from "./rc.ds";

/// Weak local reference-counted handle.
@languageItem("memory.rc.Weak")
export struct Weak<T> {
    /// The inner block.
    inner?: *RcInner<Owned<T>>;
}

extension<T> of Weak<T> {
    /// Create an empty weak handle.
    static new(): Weak<T> {
        Weak { inner: undefined }
    }

    /// Create a weak handle from a raw value pointer.
    @unsafe
    static fromRaw(pointer: *T): Weak<T> {
        todo("Weak.fromRaw")
    }

    /// Try to upgrade this weak handle.
    upgrade(): Rc<T> | undefined {
        todo("Weak.upgrade")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(): *T | undefined {
        todo("Weak.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this: ^Weak<T>): *T | undefined {
        todo("Weak.intoRaw")
    }

    /// Return whether this weak handle points to the same block as `other`.
    ptrEq(other: Weak<T>): boolean {
        todo("Weak.ptrEq")
    }

    /// Return the strong reference count.
    strongCount(): usize {
        todo("Weak.strongCount")
    }

    /// Return the weak reference count.
    weakCount(): usize {
        todo("Weak.weakCount")
    }
}
