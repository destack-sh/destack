import { todo } from "destack:error";
import { type NonNull } from "../raw.ds";
import { type Rc } from "./rc.ds";
import { type RcAllocation } from "./rc.ds";

/// Weak local reference-counted handle.
export struct Weak<T> {
    /// The allocation.
    allocation?: NonNull<RcAllocation<T>>;
}

extension<T> of Weak<T> {
    /// Create a weak handle without an allocation.
    static new(): Weak<T> {
        Weak { allocation: undefined }
    }

    /// Create a weak handle from a raw value pointer.
    static fromRaw(pointer: NonNull<T>): Weak<T> {
        todo("Weak.fromRaw")
    }

    /// Try to upgrade this weak handle.
    upgrade(): Rc<T> | undefined {
        todo("Weak.upgrade")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(): NonNull<T> | undefined {
        todo("Weak.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this: ^Weak<T>): NonNull<T> | undefined {
        todo("Weak.intoRaw")
    }

    /// Return whether this weak handle points to the same allocation as `other`.
    ptrEq(other: Weak<T>): boolean {
        todo("Weak.ptrEq")
    }

    /// Return the strong reference count.
    strongCount(): usize {
        todo("Weak.strongCount")
    }

    /// Return the weak reference count.
    weakCount(): usize {
        todo("Weak.weakCount")
    }
}
