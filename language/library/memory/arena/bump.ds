import { todo, type Result } from "destack:error";
import {
    type Allocation,
    type AllocationError,
    type AllocationLayout,
    type Allocator,
} from "../allocator.ds";
import { type Space } from "../form.ds";

/// Bump allocator in space `S`.
export struct Bump<S: Space = "local"> {
    /// The reserved storage.
    storage: Allocation<uint8, S>;

    /// The next free byte offset.
    offset: usize = 0;
}

export extension<S: Space = "local"> of Bump<S> implements Allocator<S> {
    /// Create a bump allocator over `storage`.
    static new(storage: Allocation<uint8, S>): Bump<S> {
        Bump {
            storage,
            offset: 0,
        }
    }

    /// Allocate raw memory.
    allocate<T = uint8>(layout: AllocationLayout): Result<Allocation<T, S>, AllocationError> {
        todo("Bump.allocate")
    }

    /// Allocate zero-filled raw memory.
    allocateZeroed<T = uint8>(layout: AllocationLayout): Result<Allocation<T, S>, AllocationError> {
        todo("Bump.allocateZeroed")
    }

    /// Free raw memory.
    deallocate<T>(allocation: Allocation<T, S>): void {
        todo("Bump.deallocate")
    }

    /// Grow raw memory to a larger layout.
    grow<T>(
        allocation: Allocation<T, S>,
        layout: AllocationLayout,
    ): Result<Allocation<T, S>, AllocationError> {
        todo("Bump.grow")
    }

    /// Shrink raw memory to a smaller layout.
    shrink<T>(
        allocation: Allocation<T, S>,
        layout: AllocationLayout,
    ): Result<Allocation<T, S>, AllocationError> {
        todo("Bump.shrink")
    }

    /// Release all bump allocations.
    reset(this: &exclusive Bump<S>): void {
        todo("Bump.reset")
    }

    /// Return the allocated byte count.
    get used(): usize {
        this.offset
    }
}
