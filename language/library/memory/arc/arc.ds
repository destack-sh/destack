import { todo, Result } from "destack:error";
import { As, Borrow } from "destack:convert";
import { Dereference } from "destack:ops";
import { Atomic } from "destack:sync";
import { AllocationError } from "../allocator.ds";
import { Clone, Default, Unpin, Zeroable } from "../capability.ds";
import { Owned } from "../form.ds";
import { MaybeUninit } from "../init.ds";
import { Pin } from "../pin.ds";
import { Weak } from "./weak.ds";

/// Reference-counted heap block for shared storage.
@languageItem("memory.arc.ArcInner")
export struct ArcInner<T> {
    /// The strong reference count.
    strong: Atomic<usize>;

    /// The weak reference count.
    weak: Atomic<usize>;

    /// The stored value.
    value: MaybeUninit<T>;
}

extension<T> of Arc<T> implements Unpin {}

/// Shared reference-counted ownership.
@languageItem("memory.arc.Arc")
export struct Arc<T> {
    /// The inner block.
    inner: *ArcInner<Owned<T>>;
}

extension<T> of Arc<T> implements Clone, Dereference, As<T>, Borrow<T> {
    /// The projected result form.
    type Output = &readonly T;

    /// Allocate a new shared reference-counted value.
    static new(value: ^T): Arc<T> {
        todo("Arc.new")
    }

    /// Try to allocate a new shared reference-counted value.
    static tryNew(value: ^T): Result<Arc<T>, AllocationError> {
        todo("Arc.tryNew")
    }

    /// Allocate a new shared reference-counted value that can refer to its weak handle.
    static newCyclic(makeValue: (weak: Weak<T>) => ^T): Arc<T> {
        todo("Arc.newCyclic")
    }

    /// Allocate uninitialized storage.
    static newUninit(): Arc<MaybeUninit<T>> {
        todo("Arc.newUninit")
    }

    /// Try to allocate uninitialized storage.
    static tryNewUninit(): Result<Arc<MaybeUninit<T>>, AllocationError> {
        todo("Arc.tryNewUninit")
    }

    /// Allocate zeroed storage.
    static newZeroed(): Arc<MaybeUninit<T>>
    where T implements Zeroable {
        todo("Arc.newZeroed")
    }

    /// Try to allocate zeroed storage.
    static tryNewZeroed(): Result<Arc<MaybeUninit<T>>, AllocationError>
    where T implements Zeroable {
        todo("Arc.tryNewZeroed")
    }

    /// Create a shared reference-counted handle from a raw value pointer.
    @unsafe
    static fromRaw(pointer: *T): Arc<T> {
        todo("Arc.fromRaw")
    }

    /// Allocate a new pinned shared reference-counted value.
    static pin(value: ^T): Pin<Arc<T>> {
        todo("Arc.pin")
    }

    /// Try to allocate a new pinned shared reference-counted value.
    static tryPin(value: ^T): Result<Pin<Arc<T>>, AllocationError> {
        todo("Arc.tryPin")
    }

    /// Clone this strong handle.
    clone(): Arc<T> {
        todo("Arc.clone")
    }

    /// Create a weak handle to the same block.
    downgrade(): Weak<T> {
        todo("Arc.downgrade")
    }

    /// Return whether this handle is the only strong handle.
    isUnique(): boolean {
        todo("Arc.isUnique")
    }

    /// Return whether this handle points to the same block as `other`.
    ptrEq(other: Arc<T>): boolean {
        todo("Arc.ptrEq")
    }

    /// Return the strong reference count.
    strongCount(): usize {
        todo("Arc.strongCount")
    }

    /// Return the weak reference count.
    weakCount(): usize {
        todo("Arc.weakCount")
    }

    /// Move the value out when this is the only strong handle.
    intoInner(this: ^Arc<T>): ^T | undefined {
        todo("Arc.intoInner")
    }

    /// Move the value out when this is the only strong handle.
    tryUnwrap(this: ^Arc<T>): Result<^T, Arc<T>> {
        todo("Arc.tryUnwrap")
    }

    /// Move the value out or clone it when shared.
    unwrapOrClone(this: ^Arc<T>): ^T
    where T implements Clone {
        todo("Arc.unwrapOrClone")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(): *T {
        todo("Arc.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this: ^Arc<T>): *T {
        todo("Arc.intoRaw")
    }

    /// Borrow the value exclusively when this is the only strong handle.
    getExclusive(this: &exclusive Arc<T>): &exclusive T | undefined {
        todo("Arc.getExclusive")
    }

    /// Borrow the value exclusively, cloning first if needed.
    makeExclusive(this: &exclusive Arc<T>): &exclusive T
    where T implements Clone {
        todo("Arc.makeExclusive")
    }

    /// Borrow the referenced value.
    dereference(): this.Output {
        todo("Arc.dereference")
    }

    /// Borrow the referenced value.
    as(this: &readonly Arc<T>): &readonly T {
        this.dereference()
    }

    /// Borrow the referenced value.
    borrow(this: &readonly Arc<T>): &readonly T {
        this.dereference()
    }
}

extension<T> of Arc<T> implements Default
where T implements Default {
    /// Create a shared reference-counted handle with the default value.
    static default(): Arc<T> {
        Arc.new(T.default())
    }
}
