import { todo } from "destack:error";
import { type Dereference } from "destack:ops";
import { type Access, type Unique, type WithAccess } from "./form.ds";

/// A uniquely owned heap allocation.
export newtype Box<T> = Unique<T>;

extension<T, A: Access = "readonly"> of Box<T> implements Dereference<A> {
    /// The projected result form.
    type Output = WithAccess<&T, A>;

    /// Allocate `value` on the heap.
    static new(value: ^T): Box<T> {
        todo("Box.new")
    }

    /// Move the value out of this box.
    into(this: ^Box<T>): ^T {
        todo("Box.into")
    }

    /// Borrow the boxed value.
    dereference(): this.Output {
        todo("Box.dereference")
    }
}
