/// Builtin lifetime root for static storage.
export type StaticLifetime = "static";

/// Lifetime marker for borrowed validity.
export type Lifetime = StaticLifetime | intrinsic;

/// Concrete memory space tag kind.
export type Space = intrinsic;

/// Placement tag kind for qualified storage.
export type Place = "ambient" | Space;

/// Ownership kind for qualified storage.
export type Ownership = "managed" | "owned" | "borrowed" | "raw";

/// Access mode for qualified storage.
export type Access = "readonly" | "mutable" | "exclusive";

/// Canonical qualified storage form.
export newtype Form<
    T,
    O: Ownership = "managed",
    P: Place = "ambient",
    L: Lifetime = never,
    A: Access = "mutable",
> = intrinsic;
