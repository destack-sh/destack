/// Builtin lifetime root for static storage.
export type StaticLifetime = "static";

/// Builtin lifetime root for managed heap storage.
export type ManagedLifetime = "managed";

/// Lifetime marker for borrowed validity.
export type Lifetime = StaticLifetime | ManagedLifetime | intrinsic;

/// Concrete memory space tag kind.
export type Space = intrinsic;

/// Placement tag kind for qualified storage.
export type Place = "ambient" | Space;

/// Ownership kind for qualified storage.
export type Ownership = "managed" | "owned" | "borrowed" | "raw";

/// Access mode for qualified storage.
export type Access = "readonly" | "mutable" | "exclusive";

/// Canonical qualified storage form.
export newtype Form<
    T,
    O: Ownership = "managed",
    P: Place = "ambient",
    L: Lifetime = never,
    A: Access = "mutable",
> = intrinsic;

/// Unique typed heap storage for `T`.
export newtype Unique<T> = intrinsic;

/// Managed/default value form for `T` in the ambient place.
export type Managed<T> = Form<BaseOf<T>, "managed", PlaceOr<T, "ambient">>;

/// Borrowed access to `T` within lifetime `L`.
export type Borrowed<T, L: Lifetime> = Form<BaseOf<T>, "borrowed", PlaceOr<T, "ambient">, L>;

/// Readonly borrowed access to `T` within lifetime `L`.
export type ReadonlyBorrowed<T, L: Lifetime> =
    Form<BaseOf<T>, "borrowed", PlaceOr<T, "ambient">, L, "readonly">;

/// Exclusive borrowed access to `T` within lifetime `L`.
export type ExclusiveBorrowed<T, L: Lifetime> =
    Form<BaseOf<T>, "borrowed", PlaceOr<T, "ambient">, L, "exclusive">;

/// Unsafe raw pointer to `T`.
export type Raw<T> = Form<BaseOf<T>, "raw", PlaceOr<T, "ambient">>;

/// Owned value form for `T`.
export type Owned<T> = Form<BaseOf<T>, "owned", PlaceOr<T, "ambient">>;

/// Rebase `T` into the shared space.
export type Shared<T> = WithPlace<T, "shared">;

/// Rebase `T` into the local space.
export type Local<T> = WithPlace<T, "local">;

/// Rebase `T` into the ambient space.
export type Ambient<T> = WithPlace<T, "ambient">;

/// Extract the unqualified base type of `T`.
export type BaseOf<T> =
    T extends Form<infer U, infer O, infer P, infer L, infer A> ? U :
    T;

/// Extract the explicit ownership of `T`.
export type OwnershipOf<T> =
    T extends Form<infer U, infer O, infer P, infer L, infer A> ? O :
    never;

/// Extract the placement of `T`.
export type PlaceOf<T> =
    T extends Form<infer U, infer O, infer P, infer L, infer A> ? P :
    "ambient";

/// Extract the explicit concrete space of `T`.
export type SpaceOf<T> =
    PlaceOf<T> extends infer P ?
        P extends Space ? P : never :
    never;

/// Extract the borrow lifetime of `T`.
export type LifetimeOf<T> =
    T extends Form<infer U, infer O, infer P, infer L, infer A> ?
        O extends "borrowed" ? L : never :
    never;

/// Extract the access mode of `T`.
export type AccessOf<T> =
    T extends Form<infer U, infer O, infer P, infer L, infer A> ?
        A :
    "mutable";

/// Extract the ownership of `T`, or fall back to `D`.
export type OwnershipOr<T, D: Ownership> =
    OwnershipOf<T> extends never ? D :
    OwnershipOf<T>;

/// Extract the placement of `T`, or fall back to `D`.
export type PlaceOr<T, D: Place> =
    PlaceOf<T> extends never ? D :
    PlaceOf<T>;

/// Extract the explicit concrete space of `T`, or fall back to `D`.
export type SpaceOr<T, D: Space> =
    SpaceOf<T> extends never ? D :
    SpaceOf<T>;

/// Resolve ambient placement in concrete space `S`.
export type PlaceIn<T, S: Space> =
    PlaceOf<T> extends infer P ?
        P extends "ambient" ? S :
        P extends Space ? P :
        never :
    never;

/// Return whether `T` is managed.
export type IsManaged<T> =
    OwnershipOr<T, "managed"> extends "managed" ? true :
    false;

/// Return whether `T` is owned.
export type IsOwned<T> =
    OwnershipOr<T, "managed"> extends "owned" ? true :
    false;

/// Return whether `T` is borrowed.
export type IsBorrowed<T> =
    OwnershipOr<T, "managed"> extends "borrowed" ? true :
    false;

/// Return whether `T` is raw.
export type IsRaw<T> =
    OwnershipOr<T, "managed"> extends "raw" ? true :
    false;

/// Return whether `T` is explicitly placed in shared space.
export type IsShared<T> =
    SpaceOf<T> extends "shared" ? true :
    false;

/// Return whether `T` resolves to shared space in concrete space `S`.
export type IsSharedIn<T, S: Space> =
    PlaceIn<T, S> extends "shared" ? true :
    false;

/// Reformulate `Q` with base type `T`.
export type WithBase<Q, T> =
    Form<
        T,
        OwnershipOr<Q, "managed">,
        PlaceOr<Q, "ambient">,
        LifetimeOf<Q>,
        AccessOf<Q>
    >;

/// Reformulate `Q` with ownership `O`.
export type WithOwnership<Q, O: Ownership, L = LifetimeOf<Q>> =
    O extends "borrowed" ?
        Form<BaseOf<Q>, O, PlaceOr<Q, "ambient">, L, AccessOf<Q>> :
        Form<BaseOf<Q>, O, PlaceOr<Q, "ambient">, never, AccessOf<Q>>;

/// Reformulate `Q` with placement `P`.
export type WithPlace<Q, P: Place> =
    Form<
        BaseOf<Q>,
        OwnershipOr<Q, "managed">,
        P,
        LifetimeOf<Q>,
        AccessOf<Q>
    >;

/// Reformulate `Q` in space `S`.
export type WithSpace<Q, S: Space> =
    WithPlace<Q, S>;

/// Reformulate borrowed `Q` with lifetime `L`.
export type WithLifetime<Q, L: Lifetime> =
    OwnershipOr<Q, "managed"> extends "borrowed" ?
        Form<BaseOf<Q>, "borrowed", PlaceOr<Q, "ambient">, L, AccessOf<Q>> :
    never;

/// Reformulate `Q` with access mode `A`.
export type WithAccess<Q, A: Access> =
    Form<BaseOf<Q>, OwnershipOr<Q, "managed">, PlaceOr<Q, "ambient">, LifetimeOf<Q>, A>;

/// Convert `T` to the managed value form while preserving place.
export type AsManaged<T> = Managed<T>;

/// Convert `T` to the owned value form while preserving place.
export type AsOwned<T> = Owned<T>;

/// Convert `T` to the borrowed form within lifetime `L` while preserving place.
export type AsBorrowed<T, L: Lifetime> = Borrowed<T, L>;

/// Convert `T` to the readonly borrowed form within lifetime `L` while preserving place.
export type AsReadonlyBorrowed<T, L: Lifetime> = ReadonlyBorrowed<T, L>;

/// Convert `T` to the exclusive borrowed form within lifetime `L` while preserving place.
export type AsExclusiveBorrowed<T, L: Lifetime> = ExclusiveBorrowed<T, L>;

/// Convert `T` to the raw pointer form while preserving place.
export type AsRaw<T> = Raw<T>;
