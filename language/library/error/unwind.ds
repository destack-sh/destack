import { Result } from "./result.ds";
import { Panic, UnwindSafe } from "./panic.ds";

/// Catch an unwinding panic and return its panic value.
@languageItem("error.catchUnwind")
@intrinsic("error.catchUnwind")
export declare function catchUnwind<T>(callback: (() => T) & UnwindSafe): Result<T, Panic>;

/// Resume unwinding with an existing panic value.
@languageItem("error.resumePanic")
@intrinsic("error.resumePanic")
export declare function resumePanic(panic: Panic): never;
