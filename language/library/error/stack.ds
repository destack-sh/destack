/// Opaque identity for a runtime stack frame.
export newtype StackFrameId = uint64;

/// Source location for a stack frame.
export type SourceLocation = {
    /// Source file or URL.
    file?: string;

    /// One-based source line.
    line?: uint32;

    /// One-based source column.
    column?: uint32;
};

/// One frame in a stack trace.
export type StackFrame = {
    /// Runtime frame identity, when debug metadata is available.
    id?: StackFrameId;

    /// Function or callable display name.
    function?: string;

    /// Module display name or specifier.
    module?: string;

    /// Source location after symbolication.
    location?: SourceLocation;

    /// Whether this frame crosses an async suspension boundary.
    async?: boolean;

    /// Whether this frame was inlined into its caller.
    inlined?: boolean;

    /// Whether this frame is native or host runtime code.
    native?: boolean;
};

/// Structured stack trace.
export type StackTrace = readonly StackFrame[];

/// Stack trace capture options.
export type StackTraceOptions = {
    /// Maximum number of frames to capture.
    limit?: uint32;
};

/// Capture a structured stack trace for the current Worker.
@intrinsic("error.stack.capture")
export declare function captureStackTrace(options?: StackTraceOptions): StackTrace;

/// Format a structured stack trace as diagnostic text.
@intrinsic("error.stack.format")
export declare function formatStackTrace(trace: StackTrace): string;
