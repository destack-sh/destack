import { type Type } from "./type.ds";

/// The category of one retained annotation.
export type AnnotationKind = "metadata" | "derive" | "compiler";

/// Normalized documentation comment for a reflected node.
export struct DocumentationDescriptor {
    /// The documentation body text.
    text: string;

    /// Structured documentation tags.
    tags: readonly DocumentationTagDescriptor[];
}

/// Structured tag in one documentation comment.
export struct DocumentationTagDescriptor {
    /// The tag name.
    name: string;

    /// The tag text.
    text: string;
}

/// Descriptor for one resolved and retained annotation.
export struct AnnotationDescriptor {
    /// The resolved annotation name.
    name: string;

    /// The annotation category.
    kind: AnnotationKind;

    /// The annotation value type.
    type: Type<unknown>;

    /// The static annotation value when retained.
    value?: unknown;
}
