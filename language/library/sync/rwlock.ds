import { todo } from "destack:error";
import { Default, Dispose } from "destack:memory";
import { Dereference } from "destack:ops";

import { Atomic } from "./atomic.ds";

/// Reader-writer lock.
export class RwLock<T> {
    /// The lock state.
    state: Atomic<uint32>;

    /// The protected value.
    value: T;

    /// Create a reader-writer lock protecting `value`.
    constructor(value: T) {
        this.value = value;
    }

    /// Lock this value for shared reading.
    read(): RwLockReadGuard<T> {
        todo("RwLock.read")
    }

    /// Try to lock this value for shared reading.
    tryRead(): RwLockReadGuard<T> | undefined {
        todo("RwLock.tryRead")
    }

    /// Lock this value for exclusive writing.
    write(): RwLockWriteGuard<T> {
        todo("RwLock.write")
    }

    /// Try to lock this value for exclusive writing.
    tryWrite(): RwLockWriteGuard<T> | undefined {
        todo("RwLock.tryWrite")
    }

    /// Borrow the protected value without locking.
    getExclusive(this: &exclusive RwLock<T>): &exclusive T {
        todo("RwLock.getExclusive")
    }

    /// Consume this lock and return the protected value.
    intoInner(this: ^RwLock<T>): T {
        todo("RwLock.intoInner")
    }
}

extension<T: Default> of RwLock<T> implements Default {
    /// Create the default reader-writer lock.
    static default(): RwLock<T> {
        new RwLock(T.default())
    }
}

/// Active readonly lock guard.
export struct RwLockReadGuard<T> {
    /// The locked value.
    lock: *RwLock<T>;
}

extension<T> of RwLockReadGuard<T> implements Dispose, Dereference<"readonly"> {
    /// The projected result form.
    type Output = &readonly T;

    /// Release this guard.
    dispose(): void {
        todo("RwLockReadGuard.dispose");
    }

    /// Borrow the protected value.
    dereference(): this.Output {
        todo("RwLockReadGuard.dereference")
    }
}

/// Active exclusive lock guard.
export struct RwLockWriteGuard<T> {
    /// The locked value.
    lock: *RwLock<T>;
}

extension<T> of RwLockWriteGuard<T> implements Dispose, Dereference<"exclusive"> {
    /// The projected result form.
    type Output = &exclusive T;

    /// Release this guard.
    dispose(): void {
        todo("RwLockWriteGuard.dispose");
    }

    /// Borrow the protected value.
    dereference(): this.Output {
        todo("RwLockWriteGuard.dereference")
    }

    /// Downgrade this write guard to a read guard.
    downgrade(this: RwLockWriteGuard<T>): RwLockReadGuard<T> {
        todo("RwLockWriteGuard.downgrade")
    }
}
