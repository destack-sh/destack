import {
    AtomicScope,
    MemoryOrdering,
    MemoryRegionSet,
    MemoryScope,
    atomicCas,
    atomicCasWeak,
    atomicExchange,
    atomicFence,
    atomicFetchAdd,
    atomicFetchAnd,
    atomicFetchFadd,
    atomicFetchFmax,
    atomicFetchFmin,
    atomicFetchMax,
    atomicFetchMin,
    atomicFetchOr,
    atomicFetchSub,
    atomicFetchUmax,
    atomicFetchUmin,
    atomicFetchXor,
    atomicLoad,
    atomicStore,
} from "core";
import * as platform from "library/platform/index.ds";
import type { PlatformError } from "../platform/error/index.ds";

export {
    AtomicScope,
    MemoryOrdering,
    MemoryRegionSet,
    MemoryScope,
    atomicCas,
    atomicCasWeak,
    atomicExchange,
    atomicFence,
    atomicFetchAdd,
    atomicFetchAnd,
    atomicFetchFadd,
    atomicFetchFmax,
    atomicFetchFmin,
    atomicFetchMax,
    atomicFetchMin,
    atomicFetchOr,
    atomicFetchSub,
    atomicFetchUmax,
    atomicFetchUmin,
    atomicFetchXor,
    atomicLoad,
    atomicStore,
