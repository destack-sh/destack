    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-max (unsigned).
///
/// Atomically stores the unsigned maximum of the current value and `value`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.umax")
export declare function atomicFetchUmax<T: int>(
    ptr: *T,
