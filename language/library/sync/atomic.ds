/// Memory fence.
///
/// Establishes a memory ordering constraint without an associated atomic operation.
/// Prevents reordering of memory accesses across the fence.
@intrinsic("atomic.fence")
export declare function atomicFence(
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): void;
