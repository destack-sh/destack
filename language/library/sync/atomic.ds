/// Atomic fetch-and-add (float).
///
/// Atomically adds `value` to the value at `ptr`.
/// Returns the previous value before the addition.
@intrinsic("atomic.fetch.fadd")
export declare function atomicFetchFadd<T: float>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-min (float).
///
/// Atomically stores the minimum of the current value and `value`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.fmin")
export declare function atomicFetchFmin<T: float>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
