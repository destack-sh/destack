import { intrinsic } from "../core/decorator/intrinsic.ds";

/// Memory ordering for atomic operations.
///
/// Specifies how memory accesses around atomic operations can be reordered.
export enum MemoryOrdering {
    /// No ordering constraints. Fastest but provides no synchronization.
    Relaxed,
    /// Acquire ordering for loads. Prevents reordering of subsequent reads and writes.
    Acquire,
    /// Release ordering for stores. Prevents reordering of prior reads and writes.
    Release,
    /// Acquire-release ordering. Combines Acquire and Release.
    AcquireRelease,
    /// Sequentially consistent ordering. Strongest guarantee.
    SequentiallyConsistent,
}

/// Execution scope for atomic operations.
export enum AtomicScope {
    /// Single invocation or thread scope.
    Invocation,
    /// Subgroup or warp scope.
    Subgroup,
    /// Workgroup scope.
    Workgroup,
    /// Device scope.
    Device,
    /// Cross device scope.
    CrossDevice,
    /// Queue family scope.
    QueueFamily,
    /// Shader call group scope.
    ShaderCallGroup,
    /// System wide scope.
    System,
}

/// Memory scope for atomic operations.
export enum MemoryScope {
    /// Single invocation or thread scope.
    Invocation,
    /// Subgroup or warp scope.
    Subgroup,
    /// Workgroup scope.
    Workgroup,
    /// Device scope.
    Device,
    /// Cross device scope.
    CrossDevice,
    /// Queue family scope.
    QueueFamily,
    /// Shader call group scope.
    ShaderCallGroup,
    /// System wide scope.
    System,
}

/// Effect regions participating in an atomic operation.
export enum MemoryRegionSet {
    /// No memory locations.
    None = 0,
    /// Memory reachable from pointer arguments.
    Arguments = 1,
    /// Heap allocated memory.
    Heap = 2,
    /// Stack memory.
    Stack = 4,
    /// Global or static memory.
    Global = 8,
    /// Shared or workgroup memory.
    Shared = 16,
    /// Target local or thread local memory.
    Local = 32,
    /// Target constant or read only memory.
    Constant = 64,
    /// Inaccessible memory that cannot be aliased.
    Inaccessible = 128,
    /// Memory mapped IO or other side channel memory.
    Io = 256,
    /// All memory locations.
    Any = 511,
}

/// Atomic load.
///
/// Atomically reads the value at `ptr` with the specified memory ordering.
@intrinsic("atomic.load")
export declare function atomicLoad<T>(
    ptr: *T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic store.
///
/// Atomically writes `value` to `ptr` with the specified memory ordering.
@intrinsic("atomic.store")
export declare function atomicStore<T>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): void;

/// Atomic compare-and-swap.
///
/// Atomically compares the value at `ptr` with `expected`.
/// If equal, stores `desired` and returns `[oldValue, true]`.
/// If not equal, returns `[currentValue, false]`.
@intrinsic("atomic.cas")
export declare function atomicCas<T>(
    ptr: *T,
    expected: T,
    desired: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): [T, boolean];

/// Atomic compare-and-swap (weak).
///
/// Like `atomicCas`, but may fail spuriously even if the comparison succeeds.
@intrinsic("atomic.cas.weak")
export declare function atomicCasWeak<T>(
    ptr: *T,
    expected: T,
    desired: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): [T, boolean];

/// Atomic exchange.
///
/// Atomically replaces the value at `ptr` with `value`.
/// Returns the previous value.
@intrinsic("atomic.xchg")
export declare function atomicExchange<T>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-add.
///
/// Atomically adds `value` to the value at `ptr`.
/// Returns the previous value before the addition.
@intrinsic("atomic.fetch.add")
export declare function atomicFetchAdd<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-subtract.
///
/// Atomically subtracts `value` from the value at `ptr`.
/// Returns the previous value before the subtraction.
@intrinsic("atomic.fetch.sub")
export declare function atomicFetchSub<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-bitwise-and.
///
/// Atomically performs bitwise AND of `value` with the value at `ptr`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.and")
export declare function atomicFetchAnd<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-bitwise-or.
///
/// Atomically performs bitwise OR of `value` with the value at `ptr`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.or")
export declare function atomicFetchOr<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-bitwise-xor.
///
/// Atomically performs bitwise XOR of `value` with the value at `ptr`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.xor")
export declare function atomicFetchXor<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-min.
///
/// Atomically stores the minimum of the current value and `value`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.min")
export declare function atomicFetchMin<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-max.
///
/// Atomically stores the maximum of the current value and `value`.
/// Returns the previous value before the operation.
@intrinsic("atomic.fetch.max")
export declare function atomicFetchMax<T: int>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-min (unsigned).
///
/// Atomically stores the unsigned minimum of the current value and `value`.
