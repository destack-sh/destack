import { todo } from "destack:error";
import { type TestOptions } from "./options.ds";
import { type TestBody } from "./result.ds";

/// Test registration argument after the test name.
export type TestArgument = TestBody | TestOptions | number;

/// Register one test.
export function test(name: string, argument?: TestArgument, body?: TestBody): void {
    todo("test")
}

/// Register one test.
export function it(name: string, argument?: TestArgument, body?: TestBody): void {
    test(name, argument, body)
}

/// Register one skipped test.
export function testSkip(name: string, body?: TestBody): void {
    test(name, { skip: true }, body)
}

/// Register one focused test.
export function testOnly(name: string, body?: TestBody): void {
    test(name, { only: true }, body)
}
