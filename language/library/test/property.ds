import { todo } from "destack:error";
import { type Json } from "destack:json";

/// Structured context attached to one property evaluation.
export type PropertyDetails = { readonly [key: string]: Json };

/// Assert that `condition` holds every time this property is reached.
export function always(condition: boolean, message: string, details?: PropertyDetails): void {
    todo("test.always")
}

/// Assert that `condition` holds whenever this property is reached.
export function alwaysOrUnreachable(
    condition: boolean,
    message: string,
    details?: PropertyDetails,
): void {
    todo("test.alwaysOrUnreachable")
}

/// Assert that `condition` holds at least once during the test session.
export function sometimes(condition: boolean, message: string, details?: PropertyDetails): void {
    todo("test.sometimes")
}

/// Assert that this point is reached at least once during the test session.
export function reachable(message: string, details?: PropertyDetails): void {
    todo("test.reachable")
}

/// Assert that this point is never reached during the test session.
export function unreachable(message: string, details?: PropertyDetails): void {
    todo("test.unreachable")
}
