import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default, MaybeUninit, Unique } from "destack:memory";
import { Equal, Hash, Index, IndexSet } from "destack:ops";
import { Array } from "./array.ds";
import { PackedMap } from "./packed-map.ds";

/// One stable map entry.
export struct MapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one map entry.
export struct MapEntryHandle<K, V> {
    /// The borrowed map.
    private map: &exclusive Map<K, V>;

    /// The queried key.
    private entryKey: K;
}

/// One stable map slot.
struct MapSlot<K, V> {
    /// The cached key hash.
    hash: uint64;

    /// The slot entry.
    entry: MapEntry<K, V>;
}

/// One stable map entry segment.
struct MapSlotSegment<K, V> {
    /// The entry storage.
    slots: Unique<[MaybeUninit<MapSlot<K, V>>]>;

    /// The number of initialized entries.
    length: usize = 0;

    /// The allocated entry count.
    capacity: usize = 0;
}

/// A borrow-stable hash map.
@languageItem("collections.Map")
export class Map<K, V> {
    /// The entry segments.
    segments: Array<MapSlotSegment<K, V>>;

    /// The hash index.
    index: Unique<[uint32]>;

    /// The number of live entries.
    entryCount: usize = 0;
}

extension<K: Hash, V> of MapEntryHandle<K, V>
where K implements Equal<K> {
    /// Borrow the queried key.
    get key(): &readonly K {
        todo("MapEntryHandle.key")
    }

    /// Return whether this handle points at an occupied entry.
    get isOccupied(): boolean {
        todo("MapEntryHandle.isOccupied")
    }

    /// Borrow the current value.
    get(this: &MapEntryHandle<K, V>): &V | undefined {
        todo("MapEntryHandle.get")
    }

    /// Insert `value` when this handle is vacant.
    orInsert(this: &exclusive MapEntryHandle<K, V>, value: V): &V {
        todo("MapEntryHandle.orInsert")
    }

    /// Insert a value produced by `makeValue` when this handle is vacant.
    orInsertWith(this: &exclusive MapEntryHandle<K, V>, makeValue: () => V): &V {
        todo("MapEntryHandle.orInsertWith")
    }

    /// Insert or replace the value.
    set(this: &exclusive MapEntryHandle<K, V>, value: V): &V {
        todo("MapEntryHandle.set")
    }

    /// Remove the entry.
    remove(this: &exclusive MapEntryHandle<K, V>): V | undefined {
        todo("MapEntryHandle.remove")
    }
}

extension<K, V> of Map<K, V> implements Default {
    /// Create an empty map.
    static new(): Map<K, V> {
        todo("Map.new")
    }

    /// Create a map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): Map<K, V> {
        todo("Map.withCapacity")
    }

    /// Create the default map.
    static default(): Map<K, V> {
        Map.new()
    }
}

extension<K: Hash, V> of Map<K, V> implements
    Index<K>,
    IndexSet<K, V>,
    Iterable<(K, V)>,
    Iterable<MapEntry<&readonly K, &V>>,
    Iterable<MapEntry<&readonly K, &readonly V>>,
    Iterable<MapEntry<&readonly K, &exclusive V>>,
    From<Iterable<(K, V)>>,
    FromIterator<(K, V)>,
    Extend<(K, V)>,
    From<PackedMap<K, V>>
where K implements Equal<K> {
    /// The indexed output type.
    type Output = V | undefined;

    /// Create a map from entries.
    static from(entries: Iterable<(K, V)>): Map<K, V> {
        todo("Map.from")
    }

    /// Group `values` by a computed key.
    static groupBy<T>(values: Iterable<T>, key: (value: T, index: number) => K): Map<K, Array<T>> {
        todo("Map.groupBy")
    }

    /// Create a map from entries.
    static fromIterator(entries: Iterator<(K, V)>): Map<K, V> {
        todo("Map.fromIterator")
    }

    /// Create a map from a packed map.
    static from(value: PackedMap<K, V>): Map<K, V> {
        todo("Map.fromPackedMap")
    }

    /// Return the number of entries.
    get size(): number {
        this.entryCount as number
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.entryCount == 0
    }

    /// Return a value by key.
    get<Q: Hash>(key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.get")
    }

    /// Borrow a value by key.
    get<Q: Hash>(this: &Map<K, V>, key: &readonly Q): &V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.get")
    }

    /// Borrow a value by key with readonly access.
    get<Q: Hash>(this: &readonly Map<K, V>, key: &readonly Q): &readonly V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.get")
    }

    /// Borrow a value by key with exclusive access.
    get<Q: Hash>(this: &exclusive Map<K, V>, key: &readonly Q): &exclusive V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.get")
    }

    /// Return a borrowed entry by key.
    getEntry<Q: Hash>(this: &Map<K, V>, key: &readonly Q): MapEntry<&readonly K, &V> | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.getEntry")
    }

    /// Return a borrowed entry by key with readonly access.
    getEntry<Q: Hash>(this: &readonly Map<K, V>, key: &readonly Q): MapEntry<&readonly K, &readonly V> | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.getEntry")
    }

    /// Return a borrowed entry by key with exclusive value access.
    getEntry<Q: Hash>(this: &exclusive Map<K, V>, key: &readonly Q): MapEntry<&readonly K, &exclusive V> | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.getEntry")
    }

    /// Return mutating access to the entry for `key`.
    entry(this: &exclusive Map<K, V>, key: K): MapEntryHandle<K, V> {
        todo("Map.entry")
    }

    /// Return a value by key through the index operator.
    index(key: K): V | undefined {
        todo("Map.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(this: &exclusive Map<K, V>, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Hash>(key: &readonly Q): boolean
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.has")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(this: &Map<K, V>, key: K, value: V): boolean {
        todo("Map.insert")
    }

    /// Return the existing value or insert a new value.
    getOrInsert(this: &Map<K, V>, key: K, value: V): &V {
        todo("Map.getOrInsert")
    }

    /// Return the existing value or insert a value produced by `makeValue`.
    getOrInsertWith(this: &Map<K, V>, key: K, makeValue: () => V): &V {
        todo("Map.getOrInsertWith")
    }

    /// Insert or replace a key-value pair.
    set(this: &exclusive Map<K, V>, key: K, value: V): this {
        todo("Map.set")
    }

    /// Insert or replace all entries.
    extend(this: &exclusive Map<K, V>, entries: Iterable<(K, V)>): void {
        todo("Map.extend")
    }

    /// Remove a key-value pair.
    remove<Q: Hash>(this: &exclusive Map<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("Map.remove")
    }

    /// Remove all entries.
    clear(this: &exclusive Map<K, V>): void {
        todo("Map.clear")
    }

    /// Retain only entries accepted by `predicate`.
    retain(this: &exclusive Map<K, V>, predicate: (key: &readonly K, value: &exclusive V) => boolean): void {
        todo("Map.retain")
    }

    /// Remove all entries and return them.
    drain(this: &exclusive Map<K, V>): Iterator<(K, V)> {
        todo("Map.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        this: &exclusive Map<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): Iterator<(K, V)> {
        todo("Map.extractIf")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(this: &Map<K, V>, additional: usize): void {
        todo("Map.reserve")
    }

    /// Release tombstones.
    compact(this: &exclusive Map<K, V>): void {
        todo("Map.compact")
    }

    /// Return all keys.
    keys(this: &readonly Map<K, V>): Iterator<&readonly K> {
        todo("Map.keys")
    }

    /// Return copied keys.
    keys(): Iterator<K> {
        todo("Map.keys")
    }

    /// Return all values.
    values(this: &Map<K, V>): Iterator<&V> {
        todo("Map.values")
    }

    /// Return copied values.
    values(): Iterator<V> {
        todo("Map.values")
    }

    /// Return all values with readonly access.
    values(this: &readonly Map<K, V>): Iterator<&readonly V> {
        todo("Map.values")
    }

    /// Return all values with exclusive access.
    values(this: &exclusive Map<K, V>): Iterator<&exclusive V> {
        todo("Map.values")
    }

    /// Return all entries.
    entries(this: &Map<K, V>): Iterator<MapEntry<&readonly K, &V>> {
        todo("Map.entries")
    }

    /// Return copied entries.
    entries(): Iterator<(K, V)> {
        todo("Map.entries")
    }

    /// Return all entries with readonly access.
    entries(this: &readonly Map<K, V>): Iterator<MapEntry<&readonly K, &readonly V>> {
        todo("Map.entries")
    }

    /// Return all entries with exclusive value access.
    entries(this: &exclusive Map<K, V>): Iterator<MapEntry<&readonly K, &exclusive V>> {
        todo("Map.entries")
    }

    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("Map.iterator")
    }

    /// Return an iterator over borrowed entries.
    iterator(this: &Map<K, V>): Iterator<MapEntry<&readonly K, &V>> {
        todo("Map.iterator")
    }

    /// Return an iterator over readonly borrowed entries.
    iterator(this: &readonly Map<K, V>): Iterator<MapEntry<&readonly K, &readonly V>> {
        todo("Map.iterator")
    }

    /// Return an iterator over entries with exclusive value access.
    iterator(this: &exclusive Map<K, V>): Iterator<MapEntry<&readonly K, &exclusive V>> {
        todo("Map.iterator")
    }

    /// Consume this map into owned entries.
    iterator(this: ^Map<K, V>): Iterator<(K, V)> {
        todo("Map.iterator")
    }

    /// Call `f` for each entry.
    forEach(f: (value: V, key: K, map: Map<K, V>) => void): void {
        todo("Map.forEach")
    }
}
