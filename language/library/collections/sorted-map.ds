import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Default, MaybeUninit, WithAccess } from "destack:memory";
import { Compare, Index, IndexSet } from "destack:ops";
import { RangeBounds } from "destack:range";
import { Array } from "./array.ds";

/// Key for one sorted map node.
newtype SortedMapNodeKey = uint32;

/// One sorted map entry.
export struct SortedMapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one sorted map entry.
export struct SortedMapEntryHandle<K, V> {
    /// The borrowed map.
    private map: &exclusive SortedMap<K, V>;

    /// The queried key.
    private entryKey: K;
}

/// One sorted map tree node.
struct SortedMapNode<K, V> {
    /// The node entry storage.
    entry: MaybeUninit<SortedMapEntry<K, V>>;

    /// The left child key.
    left: SortedMapNodeKey | undefined = undefined;

    /// The right child key.
    right: SortedMapNodeKey | undefined = undefined;

    /// The parent node key.
    parent: SortedMapNodeKey | undefined = undefined;

    /// The next free node key.
    nextFree: SortedMapNodeKey | undefined = undefined;

    /// The node balance factor.
    balance: int8 = 0;

    /// True when this node currently holds an entry.
    isOccupied: boolean = true;
}

/// A compact sorted map.
export class SortedMap<K, V> {
    /// The root node key.
    root: SortedMapNodeKey | undefined = undefined;

    /// The node storage.
    nodes: Array<SortedMapNode<K, V>>;

    /// The first free node key.
    firstFree: SortedMapNodeKey | undefined = undefined;

    /// The number of live entries.
    count: usize = 0;
}

extension<K: Compare<K>, V> of SortedMapEntryHandle<K, V> {
    /// Borrow the queried key.
    get key(): &readonly K {
        todo("SortedMapEntryHandle.key")
    }

    /// Return whether this handle points at an occupied entry.
    get isOccupied(): boolean {
        todo("SortedMapEntryHandle.isOccupied")
    }

    /// Borrow the current value.
    get(this: &SortedMapEntryHandle<K, V>): &V | undefined {
        todo("SortedMapEntryHandle.get")
    }

    /// Insert `value` when this handle is vacant.
    orInsert(this: &exclusive SortedMapEntryHandle<K, V>, value: V): &V {
        todo("SortedMapEntryHandle.orInsert")
    }

    /// Insert a value produced by `makeValue` when this handle is vacant.
    orInsertWith(this: &exclusive SortedMapEntryHandle<K, V>, makeValue: () => V): &V {
        todo("SortedMapEntryHandle.orInsertWith")
    }

    /// Insert or replace the value.
    set(this: &exclusive SortedMapEntryHandle<K, V>, value: V): &V {
        todo("SortedMapEntryHandle.set")
    }

    /// Remove the entry.
    remove(this: &exclusive SortedMapEntryHandle<K, V>): V | undefined {
        todo("SortedMapEntryHandle.remove")
    }
}

extension<K, V> of SortedMap<K, V> {
    /// Create an empty sorted map.
    static new(): ^SortedMap<K, V> {
        todo("SortedMap.new")
    }

    /// Create a sorted map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): ^SortedMap<K, V> {
        todo("SortedMap.withCapacity")
    }

    /// Create the default sorted map.
    static default(): ^SortedMap<K, V> {
        SortedMap.new()
    }
}

extension<K, V> of ^SortedMap<K, V> implements Default {
    /// Create the default owned sorted map.
    static default(): ^SortedMap<K, V> {
        SortedMap.default()
    }
}

extension<K: Compare<K>, V> of SortedMap<K, V> implements
    Index<K>,
    IndexSet<K, V>,
    Iterable<(K, V)>,
    Iterable<SortedMapEntry<&readonly K, &V>>,
    Iterable<SortedMapEntry<&readonly K, &readonly V>>,
    Iterable<SortedMapEntry<&readonly K, &exclusive V>>,
    Extend<(K, V), "exclusive">
{
    /// The indexed output type.
    type Output = V | undefined;

    /// Create a sorted map from entries.
    static from(entries: Iterable<(K, V)>): ^SortedMap<K, V> {
        todo("SortedMap.from")
    }

    /// Create a sorted map from entries.
    static fromIterator(entries: Iterator<(K, V)>): ^SortedMap<K, V> {
        todo("SortedMap.fromIterator")
    }

    /// Return the number of entries.
    get size(): number {
        this.count as number
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Return a value by key.
    get<Q: Compare<Q>>(key: &readonly Q): V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Borrow a value by key.
    get<Q: Compare<Q>, A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
        key: &readonly Q,
    ): WithAccess<&V, A> | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Return a value by key through the index operator.
    index(key: K): V | undefined {
        todo("SortedMap.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(this: &exclusive SortedMap<K, V>, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Compare<Q>>(key: &readonly Q): boolean
    where K implements Borrow<Q> {
        todo("SortedMap.has")
    }

    /// Return mutating access to the entry for `key`.
    entry(this: &exclusive SortedMap<K, V>, key: K): SortedMapEntryHandle<K, V> {
        todo("SortedMap.entry")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(this: &exclusive SortedMap<K, V>, key: K, value: V): boolean {
        todo("SortedMap.insert")
    }

    /// Insert or replace a key-value pair.
    set(this: &exclusive SortedMap<K, V>, key: K, value: V): this {
        todo("SortedMap.set")
    }

    /// Insert or replace all entries.
    extend(this: &exclusive SortedMap<K, V>, entries: Iterable<(K, V)>): void {
        todo("SortedMap.extend")
    }

    /// Remove a key-value pair.
    remove<Q: Compare<Q>>(this: &exclusive SortedMap<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.remove")
    }

    /// Remove all entries.
    clear(this: &exclusive SortedMap<K, V>): void {
        todo("SortedMap.clear")
    }

    /// Retain only entries accepted by `predicate`.
    retain(
        this: &exclusive SortedMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): void {
        todo("SortedMap.retain")
    }

    /// Remove all entries and return them.
    drain(this: &exclusive SortedMap<K, V>): Iterator<(K, V)> {
        todo("SortedMap.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        this: &exclusive SortedMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): Iterator<(K, V)> {
        todo("SortedMap.extractIf")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(this: &exclusive SortedMap<K, V>, additional: usize): void {
        todo("SortedMap.reserve")
    }

    /// Shrink node storage to fit the current entries.
    shrinkToFit(this: &exclusive SortedMap<K, V>): void {
        todo("SortedMap.shrinkToFit")
    }

    /// Return all keys in key order.
    keys(this: &readonly SortedMap<K, V>): Iterator<&readonly K> {
        todo("SortedMap.keys")
    }

    /// Return all borrowed values in key order.
    values<A: Access = "readonly">(this: WithAccess<&SortedMap<K, V>, A>): Iterator<WithAccess<&V, A>> {
        todo("SortedMap.values")
    }

    /// Return the first entry.
    firstEntry<A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
    ): SortedMapEntry<&readonly K, WithAccess<&V, A>> | undefined {
        todo("SortedMap.firstEntry")
    }

    /// Return the last entry.
    lastEntry<A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
    ): SortedMapEntry<&readonly K, WithAccess<&V, A>> | undefined {
        todo("SortedMap.lastEntry")
    }

    /// Return entries in key order.
    entries<A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
    ): Iterator<SortedMapEntry<&readonly K, WithAccess<&V, A>>> {
        todo("SortedMap.entries")
    }

    /// Return entries in `range`.
    range<Q: Compare<Q>, R: RangeBounds<Q>, A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
        range: R,
    ): Iterator<SortedMapEntry<&readonly K, WithAccess<&V, A>>>
    where K implements Borrow<Q> {
        todo("SortedMap.range")
    }

    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }

    /// Return an iterator over borrowed entries.
    iterator<A: Access = "readonly">(
        this: WithAccess<&SortedMap<K, V>, A>,
    ): Iterator<SortedMapEntry<&readonly K, WithAccess<&V, A>>> {
        todo("SortedMap.iterator")
    }

    /// Consume this map into owned entries.
    iterator(this: ^SortedMap<K, V>): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }
}

extension<K: Compare<K>, V> of ^SortedMap<K, V> implements From<Iterable<(K, V)>>, FromIterator<(K, V)> {
    /// Create an owned sorted map from entries.
    static from(entries: Iterable<(K, V)>): ^SortedMap<K, V> {
        SortedMap.from(entries)
    }

    /// Create an owned sorted map from entries.
    static fromIterator(entries: Iterator<(K, V)>): ^SortedMap<K, V> {
        SortedMap.fromIterator(entries)
    }
}
