import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default, MaybeUninit } from "destack:memory";
import { Compare, Index, IndexSet } from "destack:ops";
import { RangeBounds } from "destack:range";
import { Array } from "./array.ds";

/// Key for one sorted map node.
newtype SortedMapNodeKey = uint32;

/// One sorted map entry.
export struct SortedMapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// One sorted map tree node.
struct SortedMapNode<K, V> {
    /// The node entry storage.
    entry: MaybeUninit<SortedMapEntry<K, V>>;

    /// The left child key.
    left: SortedMapNodeKey | undefined = undefined;

    /// The right child key.
    right: SortedMapNodeKey | undefined = undefined;

    /// The parent node key.
    parent: SortedMapNodeKey | undefined = undefined;

    /// The next free node key.
    nextFree: SortedMapNodeKey | undefined = undefined;

    /// The node balance factor.
    balance: int8 = 0;

    /// True when this node currently holds an entry.
    isOccupied: boolean = true;
}

/// A borrow-stable sorted map.
export class SortedMap<K, V> {
    /// The root node key.
    root: SortedMapNodeKey | undefined = undefined;

    /// The node storage.
    nodes: Array<SortedMapNode<K, V>>;

    /// The first free node key.
    firstFree: SortedMapNodeKey | undefined = undefined;

    /// The number of live entries.
    entryCount: usize = 0;
}

extension<K, V> of SortedMap<K, V> implements Default {
    /// Create an empty sorted map.
    static new(): SortedMap<K, V> {
        todo("SortedMap.new")
    }

    /// Create a sorted map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): SortedMap<K, V> {
        todo("SortedMap.withCapacity")
    }

    /// Create the default sorted map.
    static default(): SortedMap<K, V> {
        SortedMap.new()
    }
}

extension<K: Compare<K>, V> of SortedMap<K, V> implements
    Index<K>,
    IndexSet<K, V>,
    Iterable<(K, V)>,
    Iterable<SortedMapEntry<&readonly K, &V>>,
    Iterable<SortedMapEntry<&readonly K, &readonly V>>,
    Iterable<SortedMapEntry<&readonly K, &exclusive V>>,
    From<Iterable<(K, V)>>,
    FromIterator<(K, V)>,
    Extend<(K, V)>
{
    /// The indexed output type.
    type Output = V | undefined;

    /// Create a sorted map from entries.
    static from(entries: Iterable<(K, V)>): SortedMap<K, V> {
        todo("SortedMap.from")
    }

    /// Create a sorted map from entries.
    static fromIterator(entries: Iterator<(K, V)>): SortedMap<K, V> {
        todo("SortedMap.fromIterator")
    }

    /// Return the number of entries.
    get size(): number {
        this.entryCount as number
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.entryCount == 0
    }

    /// Return a value by key.
    get<Q: Compare<Q>>(key: &readonly Q): V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Borrow a value by key.
    get<Q: Compare<Q>>(this: &SortedMap<K, V>, key: &readonly Q): &V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Borrow a value by key with readonly access.
    get<Q: Compare<Q>>(this: &readonly SortedMap<K, V>, key: &readonly Q): &readonly V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Borrow a value by key with exclusive access.
    get<Q: Compare<Q>>(this: &exclusive SortedMap<K, V>, key: &readonly Q): &exclusive V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Return a value by key through the index operator.
    index(key: K): V | undefined {
        todo("SortedMap.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(this: &SortedMap<K, V>, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Compare<Q>>(key: &readonly Q): boolean
    where K implements Borrow<Q> {
        todo("SortedMap.has")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(this: &SortedMap<K, V>, key: K, value: V): boolean {
        todo("SortedMap.insert")
    }

    /// Insert or replace a key-value pair.
    set(this: &SortedMap<K, V>, key: K, value: V): this {
        todo("SortedMap.set")
    }

    /// Insert or replace all entries.
    extend(this: &SortedMap<K, V>, entries: Iterable<(K, V)>): void {
        todo("SortedMap.extend")
    }

    /// Remove a key-value pair.
    remove<Q: Compare<Q>>(this: &exclusive SortedMap<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q> {
        todo("SortedMap.remove")
    }

    /// Remove all entries.
    clear(this: &exclusive SortedMap<K, V>): void {
        todo("SortedMap.clear")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(this: &SortedMap<K, V>, additional: usize): void {
        todo("SortedMap.reserve")
    }

    /// Release tombstone nodes.
    compact(this: &exclusive SortedMap<K, V>): void {
        todo("SortedMap.compact")
    }

    /// Return all keys in key order.
    keys(this: &readonly SortedMap<K, V>): Iterator<&readonly K> {
        todo("SortedMap.keys")
    }

    /// Return all values in key order.
    values(this: &SortedMap<K, V>): Iterator<&V> {
        todo("SortedMap.values")
    }

    /// Return all values in key order with readonly access.
    values(this: &readonly SortedMap<K, V>): Iterator<&readonly V> {
        todo("SortedMap.values")
    }

    /// Return all values in key order with exclusive access.
    values(this: &exclusive SortedMap<K, V>): Iterator<&exclusive V> {
        todo("SortedMap.values")
    }

    /// Return the first entry.
    firstEntry(this: &SortedMap<K, V>): SortedMapEntry<&readonly K, &V> | undefined {
        todo("SortedMap.firstEntry")
    }

    /// Return the first entry with readonly access.
    firstEntry(this: &readonly SortedMap<K, V>): SortedMapEntry<&readonly K, &readonly V> | undefined {
        todo("SortedMap.firstEntry")
    }

    /// Return the first entry with exclusive value access.
    firstEntry(this: &exclusive SortedMap<K, V>): SortedMapEntry<&readonly K, &exclusive V> | undefined {
        todo("SortedMap.firstEntry")
    }

    /// Return the last entry.
    lastEntry(this: &SortedMap<K, V>): SortedMapEntry<&readonly K, &V> | undefined {
        todo("SortedMap.lastEntry")
    }

    /// Return the last entry with readonly access.
    lastEntry(this: &readonly SortedMap<K, V>): SortedMapEntry<&readonly K, &readonly V> | undefined {
        todo("SortedMap.lastEntry")
    }

    /// Return the last entry with exclusive value access.
    lastEntry(this: &exclusive SortedMap<K, V>): SortedMapEntry<&readonly K, &exclusive V> | undefined {
        todo("SortedMap.lastEntry")
    }

    /// Return entries in key order.
    entries(this: &SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &V>> {
        todo("SortedMap.entries")
    }

    /// Return entries in key order with readonly access.
    entries(this: &readonly SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &readonly V>> {
        todo("SortedMap.entries")
    }

    /// Return entries in key order with exclusive value access.
    entries(this: &exclusive SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &exclusive V>> {
        todo("SortedMap.entries")
    }

    /// Return entries in `range`.
    range<Q: Compare<Q>, R: RangeBounds<Q>>(this: &SortedMap<K, V>, range: R): Iterator<SortedMapEntry<&readonly K, &V>>
    where K implements Borrow<Q> {
        todo("SortedMap.range")
    }

    /// Return entries in `range` with readonly access.
    range<Q: Compare<Q>, R: RangeBounds<Q>>(this: &readonly SortedMap<K, V>, range: R): Iterator<SortedMapEntry<&readonly K, &readonly V>>
    where K implements Borrow<Q> {
        todo("SortedMap.range")
    }

    /// Return entries in `range` with exclusive value access.
    range<Q: Compare<Q>, R: RangeBounds<Q>>(this: &exclusive SortedMap<K, V>, range: R): Iterator<SortedMapEntry<&readonly K, &exclusive V>>
    where K implements Borrow<Q> {
        todo("SortedMap.range")
    }

    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }

    /// Return an iterator over borrowed entries.
    iterator(this: &SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &V>> {
        todo("SortedMap.iterator")
    }

    /// Return an iterator over readonly borrowed entries.
    iterator(this: &readonly SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &readonly V>> {
        todo("SortedMap.iterator")
    }

    /// Return an iterator over entries with exclusive value access.
    iterator(this: &exclusive SortedMap<K, V>): Iterator<SortedMapEntry<&readonly K, &exclusive V>> {
        todo("SortedMap.iterator")
    }

    /// Consume this map into owned entries.
    iterator(this: ^SortedMap<K, V>): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }
}
