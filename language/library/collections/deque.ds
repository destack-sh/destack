import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Default, MaybeUninit, Unique, WithAccess } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

/// A compact double-ended queue.
export class Deque<T> {
    /// The ring storage.
    storage: Unique<[MaybeUninit<T>]>;

    /// The first initialized slot.
    start: usize = 0;

    /// The allocated element count.
    capacity: usize = 0;

    /// The number of elements.
    count: usize = 0;
}

extension<T> of Deque<T> implements
    Index<number>,
    IndexSet<number, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    Extend<T, "exclusive"> {
    /// The indexed output type.
    type Output = T;

    /// Create an empty deque.
    static new(): ^Deque<T> {
        todo("Deque.new")
    }

    /// Create a deque with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Deque<T> {
        todo("Deque.withCapacity")
    }

    /// Create a deque from values.
    static from(values: Iterable<T>): ^Deque<T> {
        todo("Deque.from")
    }

    /// Create a deque from `values`.
    static fromIterator(values: Iterator<T>): ^Deque<T> {
        todo("Deque.fromIterator")
    }

    /// Create the default deque.
    static default(): ^Deque<T> {
        Deque.new()
    }

    /// Return the number of elements.
    get length(): number {
        this.count as number
    }

    /// Return the number of elements.
    get size(): usize {
        this.count
    }

    /// Return whether this deque has no elements.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Return the element at `index` by value.
    index(index: number): T {
        todo("Deque.index")
    }

    /// Borrow the element at `index`.
    index<A: Access = "readonly">(
        this: WithAccess<&Deque<T>, A>,
        index: number,
    ): WithAccess<&T, A> {
        todo("Deque.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive Deque<T>, index: number, value: T): void {
        todo("Deque.indexSet");
    }

    /// Push `value` to the back.
    pushBack(this: &exclusive Deque<T>, value: T): void {
        todo("Deque.pushBack");
    }

    /// Push `value` to the front.
    pushFront(this: &exclusive Deque<T>, value: T): void {
        todo("Deque.pushFront");
    }

    /// Append all `values` to the back.
    extend(this: &exclusive Deque<T>, values: Iterable<T>): void {
        todo("Deque.extend");
    }

    /// Remove and return the back element.
    popBack(this: &exclusive Deque<T>): T | undefined {
        todo("Deque.popBack")
    }

    /// Remove and return the front element.
    popFront(this: &exclusive Deque<T>): T | undefined {
        todo("Deque.popFront")
    }

    /// Borrow the front element.
    front<A: Access = "readonly">(this: WithAccess<&Deque<T>, A>): WithAccess<&T, A> | undefined {
        todo("Deque.front")
    }

    /// Borrow the back element.
    back<A: Access = "readonly">(this: WithAccess<&Deque<T>, A>): WithAccess<&T, A> | undefined {
        todo("Deque.back")
    }

    /// Remove all elements.
    clear(this: &exclusive Deque<T>): void {
        todo("Deque.clear");
    }

    /// Retain only elements accepted by `predicate`.
    retain(this: &exclusive Deque<T>, predicate: (value: &T, index: usize) => boolean): void {
        todo("Deque.retain");
    }

    /// Remove all elements and return them.
    drain(this: &exclusive Deque<T>): Iterator<T> {
        todo("Deque.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(
        this: &exclusive Deque<T>,
        predicate: (value: &T, index: usize) => boolean,
    ): Iterator<T> {
        todo("Deque.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(this: &exclusive Deque<T>, additional: usize): void {
        todo("Deque.reserve");
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(this: &exclusive Deque<T>): void {
        todo("Deque.shrinkToFit");
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Deque.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator<A: Access = "readonly">(this: WithAccess<&Deque<T>, A>): Iterator<WithAccess<&T, A>> {
        todo("Deque.iterator")
    }

    /// Consume this deque into owned values.
    iterator(this: ^Deque<T>): Iterator<T> {
        todo("Deque.iterator")
    }
}

extension<T> of ^Deque<T> implements Default, From<Iterable<T>>, FromIterator<T> {
    /// Create the default owned deque.
    static default(): ^Deque<T> {
        Deque.default()
    }

    /// Create an owned deque from values.
    static from(values: Iterable<T>): ^Deque<T> {
        Deque.from(values)
    }

    /// Create an owned deque from values.
    static fromIterator(values: Iterator<T>): ^Deque<T> {
        Deque.fromIterator(values)
    }
}
