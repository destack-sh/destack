import { todo } from "destack:error";
import { From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default, MaybeUninit, Unique } from "destack:memory";
import { Index, IndexSet } from "destack:ops";
import { PackedArray } from "./packed-array.ds";

/// Readonly view of a dynamic array.
@languageItem("collections.ReadonlyArray")
export type ReadonlyArray<T> = readonly T[];

/// Fixed-size array alias.
@languageItem("collections.FixedArray")
export type FixedArray<T, comptime N: number> = [T; N];

/// One stable array segment.
struct ArraySegment<T> {
    /// The segment storage.
    storage: Unique<[MaybeUninit<T>]>;

    /// The number of initialized elements.
    length: usize = 0;

    /// The allocated element count.
    capacity: usize = 0;
}

/// A growable borrow-stable array.
@languageItem("collections.Array")
export class Array<T> {
    /// The segment table.
    segments: Unique<[MaybeUninit<ArraySegment<T>>]>;

    /// The number of initialized segments.
    segmentCount: usize = 0;

    /// The number of initialized elements.
    elementCount: usize = 0;
}

extension<T> of Array<T> implements
    Index<number>,
    IndexSet<number, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    From<Iterable<T>>,
    FromIterator<T>,
    Extend<T>,
    Default,
    From<PackedArray<T>>
{
    /// The indexed output type.
    type Output = T;

    /// Create an empty array.
    static new(): Array<T> {
        todo("Array.new")
    }

    /// Create an array with room for at least `capacity` elements.
    static withCapacity(capacity: usize): Array<T> {
        todo("Array.withCapacity")
    }

    /// Create an array from `values`.
    static from(values: Iterable<T>): Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values` and map each value.
    static from<U>(values: Iterable<U>, map: (value: U, index: number) => T): Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values`.
    static fromIterator(values: Iterator<T>): Array<T> {
        todo("Array.fromIterator")
    }

    /// Create an array from `items`.
    static of(...items: T[]): Array<T> {
        todo("Array.of")
    }

    /// Create the default array.
    static default(): Array<T> {
        Array.new()
    }

    /// Create an array from a packed array.
    static from(value: PackedArray<T>): Array<T> {
        todo("Array.fromPackedArray")
    }

    /// Return the number of elements.
    get length(): number {
        this.elementCount as number
    }

    /// Return the number of elements.
    get size(): usize {
        this.elementCount
    }

    /// Return whether this array has no elements.
    get isEmpty(): boolean {
        this.elementCount == 0
    }

    /// Return the element at `index` by value.
    index(index: number): T {
        todo("Array.index")
    }

    /// Return the element at `index`, counting from the end when negative.
    at(index: number): T | undefined {
        todo("Array.at")
    }

    /// Borrow the element at `index`.
    index(this: &Array<T>, index: number): &T {
        todo("Array.index")
    }

    /// Borrow the element at `index` with readonly access.
    index(this: &readonly Array<T>, index: number): &readonly T {
        todo("Array.index")
    }

    /// Borrow the element at `index` with exclusive access.
    index(this: &exclusive Array<T>, index: number): &exclusive T {
        todo("Array.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive Array<T>, index: number, value: T): void {
        todo("Array.indexSet")
    }

    /// Return the first element by value.
    first(): T | undefined {
        todo("Array.first")
    }

    /// Borrow the first element.
    first(this: &Array<T>): &T | undefined {
        todo("Array.first")
    }

    /// Borrow the first element with readonly access.
    first(this: &readonly Array<T>): &readonly T | undefined {
        todo("Array.first")
    }

    /// Borrow the first element with exclusive access.
    first(this: &exclusive Array<T>): &exclusive T | undefined {
        todo("Array.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        todo("Array.last")
    }

    /// Borrow the last element.
    last(this: &Array<T>): &T | undefined {
        todo("Array.last")
    }

    /// Borrow the last element with readonly access.
    last(this: &readonly Array<T>): &readonly T | undefined {
        todo("Array.last")
    }

    /// Borrow the last element with exclusive access.
    last(this: &exclusive Array<T>): &exclusive T | undefined {
        todo("Array.last")
    }

    /// Append `value`.
    push(this: &Array<T>, value: T): void {
        todo("Array.push")
    }

    /// Append `values`.
    push(this: &Array<T>, ...values: T[]): number {
        todo("Array.push")
    }

    /// Append all `values`.
    extend(this: &Array<T>, values: Iterable<T>): void {
        todo("Array.extend")
    }

    /// Remove and return the last element.
    pop(this: &exclusive Array<T>): T | undefined {
        todo("Array.pop")
    }

    /// Remove and return the first element.
    shift(this: &exclusive Array<T>): T | undefined {
        todo("Array.shift")
    }

    /// Prepend `values`.
    unshift(this: &exclusive Array<T>, ...values: T[]): number {
        todo("Array.unshift")
    }

    /// Insert `value` at `index`.
    insert(this: &exclusive Array<T>, index: usize, value: T): void {
        todo("Array.insert")
    }

    /// Remove and return the element at `index`.
    removeAt(this: &exclusive Array<T>, index: usize): T {
        todo("Array.removeAt")
    }

    /// Remove all elements.
    clear(this: &exclusive Array<T>): void {
        todo("Array.clear")
    }

    /// Overwrite a range with `value`.
    fill(this: &exclusive Array<T>, value: T, start?: number, end?: number): this {
        todo("Array.fill")
    }

    /// Copy a range within this array.
    copyWithin(this: &exclusive Array<T>, target: number, start: number, end?: number): this {
        todo("Array.copyWithin")
    }

    /// Retain only elements accepted by `predicate`.
    retain(this: &exclusive Array<T>, predicate: (value: &T, index: usize) => boolean): void {
        todo("Array.retain")
    }

    /// Remove all elements and return them.
    drain(this: &exclusive Array<T>): Iterator<T> {
        todo("Array.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(this: &exclusive Array<T>, predicate: (value: &T, index: usize) => boolean): Iterator<T> {
        todo("Array.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(this: &Array<T>, additional: usize): void {
        todo("Array.reserve")
    }

    /// Release unused segments.
    compact(this: &exclusive Array<T>): void {
        todo("Array.compact")
    }

    /// Return a copy of the selected range.
    slice(start?: number, end?: number): Array<T> {
        todo("Array.slice")
    }

    /// Concatenate arrays.
    concat(...items: Array<T>[]): Array<T> {
        todo("Array.concat")
    }

    /// Map each element to a new array.
    map<U>(f: (value: T, index: number) => U): Array<U> {
        todo("Array.map")
    }

    /// Filter elements into a new array.
    filter(predicate: (value: T, index: number) => boolean): Array<T> {
        todo("Array.filter")
    }

    /// Reduce this array to one value.
    reduce<U>(f: (accumulator: U, value: T, index: number) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Return the first element accepted by `predicate`.
    find(predicate: (value: T, index: number) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Return the index of the first element accepted by `predicate`.
    findIndex(predicate: (value: T, index: number) => boolean): number {
        todo("Array.findIndex")
    }

    /// Return the last element accepted by `predicate`.
    findLast(predicate: (value: T, index: number) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last element accepted by `predicate`.
    findLastIndex(predicate: (value: T, index: number) => boolean): number {
        todo("Array.findLastIndex")
    }

    /// Return whether any element is accepted by `predicate`.
    some(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every element is accepted by `predicate`.
    every(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.every")
    }

    /// Call `f` for each element.
    forEach(f: (value: T, index: number) => void): void {
        todo("Array.forEach")
    }

    /// Return whether this array includes `value`.
    includes(value: T, fromIndex?: number): boolean {
        todo("Array.includes")
    }

    /// Return the first index of `value`.
    indexOf(value: T, fromIndex?: number): number {
        todo("Array.indexOf")
    }

    /// Return the last index of `value`.
    lastIndexOf(value: T, fromIndex?: number): number {
        todo("Array.lastIndexOf")
    }

    /// Join all elements into a string.
    join(separator?: string): string {
        todo("Array.join")
    }

    /// Reverse this array in place.
    reverse(this: &exclusive Array<T>): this {
        todo("Array.reverse")
    }

    /// Return a reversed copy.
    toReversed(): Array<T> {
        todo("Array.toReversed")
    }

    /// Sort this array in place.
    sort(this: &exclusive Array<T>, compare?: (a: &readonly T, b: &readonly T) => number): this {
        todo("Array.sort")
    }

    /// Return a sorted copy.
    toSorted(compare?: (a: &readonly T, b: &readonly T) => number): Array<T> {
        todo("Array.toSorted")
    }

    /// Splice this array.
    splice(
        this: &exclusive Array<T>,
        start: number,
        deleteCount?: number,
        ...items: T[]
    ): Array<T> {
        todo("Array.splice")
    }

    /// Return a spliced copy.
    toSpliced(start: number, deleteCount?: number, ...items: T[]): Array<T> {
        todo("Array.toSpliced")
    }

    /// Return a copy with `value` at `index`.
    with(index: number, value: T): Array<T> {
        todo("Array.with")
    }

    /// Flatten nested arrays.
    flat<U>(this: Array<ReadonlyArray<U>>, depth?: number): Array<U> {
        todo("Array.flat")
    }

    /// Map and flatten nested arrays.
    flatMap<U>(f: (value: T, index: number) => U | ReadonlyArray<U>): Array<U> {
        todo("Array.flatMap")
    }

    /// Return an iterator over numeric indices.
    keys(): Iterator<number> {
        todo("Array.keys")
    }

    /// Return an iterator over copied values.
    values(): Iterator<T> {
        todo("Array.values")
    }

    /// Return an iterator over copied index-value entries.
    entries(): Iterator<(number, T)> {
        todo("Array.entries")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator(this: &Array<T>): Iterator<&T> {
        todo("Array.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly Array<T>): Iterator<&readonly T> {
        todo("Array.iterator")
    }

    /// Return an iterator over exclusive borrowed values.
    iterator(this: &exclusive Array<T>): Iterator<&exclusive T> {
        todo("Array.iterator")
    }

    /// Consume this array into owned values.
    iterator(this: ^Array<T>): Iterator<T> {
        todo("Array.iterator")
    }
}
