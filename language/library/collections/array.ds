import { todo } from "destack:error";
import { type Iterable, type Iterator } from "destack:iter";
import { type Index, type IndexSet } from "destack:ops";
import { type MaybeUninit, type Unique } from "destack:memory";

/// A growable contiguous array.
export class Array<T> {
    /// The backing storage.
    storage: Unique<[MaybeUninit<T>]>;

    /// The number of initialized elements.
    initializedLength: usize = 0;

    /// The allocated element count.
    capacity: usize = 0;
}

/// Readonly view of a dynamic array.
export type ReadonlyArray<T> = readonly T[];

/// Fixed-size array alias.
export type FixedArray<T, comptime N: number> = [T; N];

extension<T> of Array<T> implements Index<number>, IndexSet<number, T>, Iterable<T> {
    /// The indexed output type.
    type Output = T;

    /// Get the length of the array.
    get length(): number {
        this.initializedLength as number
    }

    /// Check if the array is empty.
    get isEmpty(): boolean {
        this.initializedLength == 0
    }

    /// Get the element at the index with bounds checks.
    index(i: number): T {
        todo("Array.index")
    }

    /// Borrow the element at the index with bounds checks.
    index(this: &Array<T>, i: number): &T {
        todo("Array.index")
    }

    /// Borrow the element at the index with readonly access.
    index(this: &readonly Array<T>, i: number): &readonly T {
        todo("Array.index")
    }

    /// Borrow the element at the index with exclusive access.
    index(this: &exclusive Array<T>, i: number): &exclusive T {
        todo("Array.index")
    }

    /// Set the element at the index with bounds checks.
    indexSet(i: number, value: T): void {
        todo("Array.indexSet")
    }

    /// Get element at index without bounds checks.
    unsafeGet(i: usize): T {
        todo("Array.unsafeGet")
    }

    /// Set element at index without bounds checks.
    unsafeSet(i: usize, value: T): void {
        todo("Array.unsafeSet")
    }

    /// Return the initialized mutable slice.
    asSlice(this: &Array<T>): &[T] {
        todo("Array.asSlice")
    }

    /// Return the initialized readonly slice.
    asReadonlySlice(this: &readonly Array<T>): &readonly [T] {
        todo("Array.asReadonlySlice")
    }

    /// Push an element to the end.
    push(this: &exclusive Array<T>, value: T): void {
        todo("Array.push")
    }

    /// Pop an element from the end.
    pop(this: &exclusive Array<T>): T | undefined {
        todo("Array.pop")
    }

    /// Get the first element.
    first(): T | undefined {
        todo("Array.first")
    }

    /// Get the last element.
    last(): T | undefined {
        todo("Array.last")
    }

    /// Clear all elements.
    clear(this: &exclusive Array<T>): void {
        todo("Array.clear")
    }

    /// Reserve capacity for at least `additional` more elements.
    reserve(this: &exclusive Array<T>, additional: usize): void {
        todo("Array.reserve")
    }

    /// Shrink capacity to fit current length.
    shrinkToFit(this: &exclusive Array<T>): void {
        todo("Array.shrinkToFit")
    }

    /// Create an iterator over the array.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Map each element to a new value.
    map<U>(f: (value: T, index: number) => U): Array<U> {
        todo("Array.map")
    }

    /// Filter elements by predicate.
    filter(predicate: (value: T, index: number) => boolean): Array<T> {
        todo("Array.filter")
    }

    /// Reduce array to single value.
    reduce<U>(f: (acc: U, value: T, index: number) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Find first element matching predicate.
    find(predicate: (value: T, index: number) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Find index of first element matching predicate.
    findIndex(predicate: (value: T, index: number) => boolean): number {
        todo("Array.findIndex")
    }

    /// Check if any element matches predicate.
    some(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.some")
    }

    /// Check if all elements match predicate.
    every(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.every")
    }

    /// Execute function for each element.
    forEach(f: (value: T, index: number) => void): void {
        todo("Array.forEach")
    }

    /// Check if array includes a value.
    includes(value: T, fromIndex?: number): boolean {
        todo("Array.includes")
    }

    /// Find the index of a value.
    indexOf(value: T, fromIndex?: number): number {
        todo("Array.indexOf")
    }

    /// Join elements into a string.
    join(separator?: string): string {
        todo("Array.join")
    }

    /// Reverse the array in place.
    reverse(this: &exclusive Array<T>): this {
        todo("Array.reverse")
    }

    /// Sort the array in place.
    sort(this: &exclusive Array<T>, compareFn?: (a: T, b: T) => number): this {
        todo("Array.sort")
    }

    /// Get a slice of the array.
    slice(start?: number, end?: number): Array<T> {
        todo("Array.slice")
    }

    /// Splice elements.
    splice(
        this: &exclusive Array<T>,
        start: number,
        deleteCount?: number,
        ...items: T[]
    ): Array<T> {
        todo("Array.splice")
    }

    /// Concatenate arrays.
    concat(...items: Array<T>[]): Array<T> {
        todo("Array.concat")
    }

    /// Flatten nested arrays.
    flat<D extends number = 1>(depth?: D): Array<unknown> {
        todo("Array.flat")
    }

    /// Map and flatten.
    flatMap<U>(f: (value: T, index: number) => Array<U>): Array<U> {
        todo("Array.flatMap")
    }

    /// Create an array from an iterable.
    static from<T>(values: Iterable<T>): Array<T> {
        todo("Array.from")
    }

    /// Create an array from a fixed-size array.
    static fromSized<T>(values: readonly T[]): Array<T> {
        todo("Array.fromSized")
    }
}

/// Create an array with the given elements.
export function arrayOf<T>(...elements: T[]): Array<T> {
    todo("arrayOf")
}

/// Create an array with the given length, filled with a value.
export function arrayFill<T>(length: usize, value: T): Array<T> {
    todo("arrayFill")
}
