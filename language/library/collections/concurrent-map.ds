import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Clone, Default, Dispose } from "destack:memory";
import { Dereference, Equal, Hash } from "destack:ops";
import { Atomic, RwLock, RwLockReadGuard, RwLockWriteGuard } from "destack:sync";
import { Array } from "./array.ds";
import { Map } from "./map.ds";

/// Read guard for one concurrent map entry.
export struct ConcurrentMapRead<K, V> {
    /// The shard read guard.
    private guard: RwLockReadGuard<Map<K, V>>;

    /// The queried key.
    private entryKey: K;
}

/// Write guard for one concurrent map entry.
export struct ConcurrentMapWrite<K, V> {
    /// The shard write guard.
    private guard: RwLockWriteGuard<Map<K, V>>;

    /// The queried key.
    private entryKey: K;
}

/// Entry guard for one concurrent map key.
export struct ConcurrentMapEntry<K, V> {
    /// The shard write guard.
    private guard: RwLockWriteGuard<Map<K, V>>;

    /// The queried key.
    private entryKey: K;
}

/// A sharded concurrent hash map.
export class ConcurrentMap<K, V> {
    /// The map shards.
    shards: Array<RwLock<Map<K, V>>>;

    /// The number of live entries.
    entryCount: Atomic<usize>;
}

extension<K: Hash, V> of ConcurrentMapRead<K, V>
    implements Dispose, Dereference<"readonly"> {
    /// The projected result form.
    type Output = &readonly V;

    /// Borrow the entry key.
    get key(): &readonly K {
        todo("ConcurrentMapRead.key")
    }

    /// Borrow the entry value.
    get value(): &readonly V {
        todo("ConcurrentMapRead.value")
    }

    /// Release this guard.
    dispose(): void {
        todo("ConcurrentMapRead.dispose")
    }

    /// Borrow the entry value.
    dereference(): this.Output {
        todo("ConcurrentMapRead.dereference")
    }
}

extension<K: Hash, V> of ConcurrentMapWrite<K, V>
    implements Dispose, Dereference<"exclusive"> {
    /// The projected result form.
    type Output = &exclusive V;

    /// Borrow the entry key.
    get key(): &readonly K {
        todo("ConcurrentMapWrite.key")
    }

    /// Borrow the entry value with exclusive access.
    get value(): &exclusive V {
        todo("ConcurrentMapWrite.value")
    }

    /// Remove this entry.
    remove(this: ^ConcurrentMapWrite<K, V>): V {
        todo("ConcurrentMapWrite.remove")
    }

    /// Release this guard.
    dispose(): void {
        todo("ConcurrentMapWrite.dispose")
    }

    /// Borrow the entry value.
    dereference(): this.Output {
        todo("ConcurrentMapWrite.dereference")
    }
}

extension<K: Hash, V> of ConcurrentMapEntry<K, V>
    implements Dispose {
    /// Borrow the queried key.
    get key(): &readonly K {
        todo("ConcurrentMapEntry.key")
    }

    /// Return whether this guard points at an occupied entry.
    get isOccupied(): boolean {
        todo("ConcurrentMapEntry.isOccupied")
    }

    /// Borrow the current value.
    get(this: &ConcurrentMapEntry<K, V>): &readonly V | undefined {
        todo("ConcurrentMapEntry.get")
    }

    /// Borrow the current value with exclusive access.
    get(this: &exclusive ConcurrentMapEntry<K, V>): &exclusive V | undefined {
        todo("ConcurrentMapEntry.get")
    }

    /// Insert `value` when this entry is vacant.
    orInsert(this: &exclusive ConcurrentMapEntry<K, V>, value: V): &exclusive V {
        todo("ConcurrentMapEntry.orInsert")
    }

    /// Insert a value produced by `makeValue` when this entry is vacant.
    orInsertWith(this: &exclusive ConcurrentMapEntry<K, V>, makeValue: () => V): &exclusive V {
        todo("ConcurrentMapEntry.orInsertWith")
    }

    /// Insert or replace the value.
    set(this: &exclusive ConcurrentMapEntry<K, V>, value: V): &exclusive V {
        todo("ConcurrentMapEntry.set")
    }

    /// Remove this entry.
    remove(this: ^ConcurrentMapEntry<K, V>): V | undefined {
        todo("ConcurrentMapEntry.remove")
    }

    /// Release this guard.
    dispose(): void {
        todo("ConcurrentMapEntry.dispose")
    }
}

extension<K, V> of ConcurrentMap<K, V> implements Default {
    /// Create an empty concurrent map.
    static new(): ConcurrentMap<K, V> {
        todo("ConcurrentMap.new")
    }

    /// Create a concurrent map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): ConcurrentMap<K, V> {
        todo("ConcurrentMap.withCapacity")
    }

    /// Create the default concurrent map.
    static default(): ConcurrentMap<K, V> {
        ConcurrentMap.new()
    }
}

extension<K: Hash, V> of ConcurrentMap<K, V> implements
    From<Iterable<(K, V)>>,
    FromIterator<(K, V)>,
    Extend<(K, V)>
{
    /// Create a concurrent map from entries.
    static from(entries: Iterable<(K, V)>): ConcurrentMap<K, V> {
        todo("ConcurrentMap.from")
    }

    /// Create a concurrent map from `entries`.
    static fromIterator(entries: Iterator<(K, V)>): ConcurrentMap<K, V> {
        todo("ConcurrentMap.fromIterator")
    }

    /// Return the number of entries.
    get size(): number {
        this.entryCount.load() as number
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.entryCount.load() == 0
    }

    /// Clone and return a value by key.
    get<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q>, V implements Clone {
        todo("ConcurrentMap.get")
    }

    /// Return whether `key` exists.
    has<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): boolean
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.has")
    }

    /// Return a read guard for one entry.
    read<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): ConcurrentMapRead<K, V> | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.read")
    }

    /// Return a write guard for one entry.
    write<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): ConcurrentMapWrite<K, V> | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.write")
    }

    /// Return an entry guard for `key`.
    entry(this: &ConcurrentMap<K, V>, key: K): ConcurrentMapEntry<K, V> {
        todo("ConcurrentMap.entry")
    }

    /// Return a write guard, inserting `value` when `key` is absent.
    getOrInsert(this: &ConcurrentMap<K, V>, key: K, value: V): ConcurrentMapWrite<K, V> {
        todo("ConcurrentMap.getOrInsert")
    }

    /// Return a write guard, inserting a produced value when `key` is absent.
    getOrInsertWith(this: &ConcurrentMap<K, V>, key: K, makeValue: () => V): ConcurrentMapWrite<K, V> {
        todo("ConcurrentMap.getOrInsertWith")
    }

    /// Call `body` with readonly access to one value.
    with<Q: Hash, R>(
        this: &ConcurrentMap<K, V>,
        key: &readonly Q,
        body: (value: &readonly V) => R,
    ): R | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.with")
    }

    /// Call `body` with exclusive access to one value.
    update<Q: Hash, R>(
        this: &ConcurrentMap<K, V>,
        key: &readonly Q,
        body: (value: &exclusive V) => R,
    ): R | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.update")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(this: &ConcurrentMap<K, V>, key: K, value: V): boolean {
        todo("ConcurrentMap.insert")
    }

    /// Insert or replace a key-value pair.
    set(this: &ConcurrentMap<K, V>, key: K, value: V): V | undefined {
        todo("ConcurrentMap.set")
    }

    /// Insert or replace all entries.
    extend(this: &ConcurrentMap<K, V>, entries: Iterable<(K, V)>): void {
        todo("ConcurrentMap.extend")
    }

    /// Retain only entries accepted by `predicate`.
    retain(
        this: &ConcurrentMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): void {
        todo("ConcurrentMap.retain")
    }

    /// Remove all entries and return them.
    drain(this: &ConcurrentMap<K, V>): Iterator<(K, V)> {
        todo("ConcurrentMap.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        this: &ConcurrentMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): Iterator<(K, V)> {
        todo("ConcurrentMap.extractIf")
    }

    /// Remove a key-value pair.
    remove<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.remove")
    }

    /// Remove a key-value pair and return the stored key.
    removeEntry<Q: Hash>(this: &ConcurrentMap<K, V>, key: &readonly Q): (K, V) | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("ConcurrentMap.removeEntry")
    }

    /// Remove all entries.
    clear(this: &ConcurrentMap<K, V>): void {
        todo("ConcurrentMap.clear")
    }
}
