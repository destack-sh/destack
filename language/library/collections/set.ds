import { todo } from "destack:error";
import { type Iterable, type Iterator } from "destack:iter";
import { type HashTable } from "./map.ds";

/// Ordered hash set backed by map storage.
export class Set<T> {
    /// The hash table storage.
    table: HashTable<T, void>;
}

extension<T> of Set<T> implements Iterable<T> {
    /// Create an empty set.
    static new(): Set<T> {
        todo("Set.new")
    }

    /// Get the number of elements.
    get size(): number {
        this.table.length as number
    }

    /// Check if the set is empty.
    get isEmpty(): boolean {
        this.table.length == 0
    }

    /// Add an element.
    add(value: T): this {
        todo("Set.add")
    }

    /// Check if an element exists.
    has(value: T): boolean {
        todo("Set.has")
    }

    /// Delete an element.
    delete(value: T): boolean {
        todo("Set.delete")
    }

    /// Clear all elements.
    clear(): void {
        todo("Set.clear")
    }

    /// Get all values.
    values(): Iterator<T> {
        todo("Set.values")
    }

    /// Iterate over elements.
    iterator(): Iterator<T> {
        this.values()
    }

    /// Execute function for each element.
    forEach(f: (value: T, value2: T, set: Set<T>) => void): void {
        todo("Set.forEach")
    }

    /// Return the union of two sets.
    union(other: Set<T>): Set<T> {
        todo("Set.union")
    }

    /// Return the intersection of two sets.
    intersection(other: Set<T>): Set<T> {
        todo("Set.intersection")
    }

    /// Return the difference of this set and `other`.
    difference(other: Set<T>): Set<T> {
        todo("Set.difference")
    }

    /// Return the symmetric difference of two sets.
    symmetricDifference(other: Set<T>): Set<T> {
        todo("Set.symmetricDifference")
    }

    /// Check if this is a subset of `other`.
    isSubsetOf(other: Set<T>): boolean {
        todo("Set.isSubsetOf")
    }

    /// Check if this is a superset of `other`.
    isSupersetOf(other: Set<T>): boolean {
        todo("Set.isSupersetOf")
    }

    /// Check if this set has no overlap with `other`.
    isDisjointFrom(other: Set<T>): boolean {
        todo("Set.isDisjointFrom")
    }

    /// Create a new set from values.
    static from<T>(values: Iterable<T>): Set<T> {
        todo("Set.from")
    }

    /// Create a set with pre-allocated capacity.
    static withCapacity<T>(capacity: uint32): Set<T> {
        todo("Set.withCapacity")
    }
}
