import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default } from "destack:memory";
import { Equal, Hash } from "destack:ops";
import { Map } from "./map.ds";
import { PackedSet } from "./packed-set.ds";

/// A borrow-stable hash set.
@languageItem("collections.Set")
export class Set<T> {
    /// The backing map.
    map: Map<T, void>;
}

extension<T> of Set<T> implements Default {
    /// Create an empty set.
    static new(): Set<T> {
        todo("Set.new")
    }

    /// Create a set with room for at least `capacity` elements.
    static withCapacity(capacity: usize): Set<T> {
        todo("Set.withCapacity")
    }

    /// Create the default set.
    static default(): Set<T> {
        Set.new()
    }
}

extension<T: Hash> of Set<T> implements
    Iterable<T>,
    Iterable<&readonly T>,
    From<Iterable<T>>,
    FromIterator<T>,
    Extend<T>,
    From<PackedSet<T>>
where T implements Equal<T> {
    /// Create a set from values.
    static from(values: Iterable<T>): Set<T> {
        todo("Set.from")
    }

    /// Create a set from `values`.
    static fromIterator(values: Iterator<T>): Set<T> {
        todo("Set.fromIterator")
    }

    /// Create a set from a packed set.
    static from(value: PackedSet<T>): Set<T> {
        todo("Set.fromPackedSet")
    }

    /// Return the number of elements.
    get size(): number {
        this.map.size
    }

    /// Return whether this set has no elements.
    get isEmpty(): boolean {
        this.map.isEmpty
    }

    /// Return whether `value` is present.
    has<Q: Hash>(value: &readonly Q): boolean
    where T implements Borrow<Q>, Q implements Equal<Q> {
        todo("Set.has")
    }

    /// Borrow the stored value equal to `value` with readonly access.
    get<Q: Hash>(this: &readonly Set<T>, value: &readonly Q): &readonly T | undefined
    where T implements Borrow<Q>, Q implements Equal<Q> {
        todo("Set.get")
    }

    /// Add `value` when absent.
    add(this: &Set<T>, value: T): boolean {
        todo("Set.add")
    }

    /// Add all `values`.
    extend(this: &Set<T>, values: Iterable<T>): void {
        todo("Set.extend")
    }

    /// Remove `value`.
    remove<Q: Hash>(this: &exclusive Set<T>, value: &readonly Q): T | undefined
    where T implements Borrow<Q>, Q implements Equal<Q> {
        todo("Set.remove")
    }

    /// Remove all elements.
    clear(this: &exclusive Set<T>): void {
        todo("Set.clear")
    }

    /// Retain only values accepted by `predicate`.
    retain(this: &exclusive Set<T>, predicate: (value: &readonly T) => boolean): void {
        todo("Set.retain")
    }

    /// Remove all values and return them.
    drain(this: &exclusive Set<T>): Iterator<T> {
        todo("Set.drain")
    }

    /// Remove values accepted by `predicate` and return them.
    extractIf(this: &exclusive Set<T>, predicate: (value: &readonly T) => boolean): Iterator<T> {
        todo("Set.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(this: &Set<T>, additional: usize): void {
        todo("Set.reserve")
    }

    /// Release tombstones.
    compact(this: &exclusive Set<T>): void {
        todo("Set.compact")
    }

    /// Return the union of two sets.
    union(other: &readonly Set<T>): Set<T> {
        todo("Set.union")
    }

    /// Return the intersection with `other`.
    intersection(other: &readonly Set<T>): Set<T> {
        todo("Set.intersection")
    }

    /// Return this set without values in `other`.
    difference(other: &readonly Set<T>): Set<T> {
        todo("Set.difference")
    }

    /// Return values present in exactly one set.
    symmetricDifference(other: &readonly Set<T>): Set<T> {
        todo("Set.symmetricDifference")
    }

    /// Return whether this set is a subset of `other`.
    isSubsetOf(other: &readonly Set<T>): boolean {
        todo("Set.isSubsetOf")
    }

    /// Return whether this set is a superset of `other`.
    isSupersetOf(other: &readonly Set<T>): boolean {
        todo("Set.isSupersetOf")
    }

    /// Return whether this set has no overlap with `other`.
    isDisjointFrom(other: &readonly Set<T>): boolean {
        todo("Set.isDisjointFrom")
    }

    /// Return copied values as keys.
    keys(): Iterator<T> {
        todo("Set.keys")
    }

    /// Return copied values.
    values(): Iterator<T> {
        todo("Set.values")
    }

    /// Return copied value-value entries.
    entries(): Iterator<(T, T)> {
        todo("Set.entries")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Set.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly Set<T>): Iterator<&readonly T> {
        todo("Set.iterator")
    }

    /// Consume this set into owned values.
    iterator(this: ^Set<T>): Iterator<T> {
        todo("Set.iterator")
    }

    /// Call `f` for each value.
    forEach(f: (value: T, set: Set<T>) => void): void {
        todo("Set.forEach")
    }
}
