import { panic, todo } from "destack:error";
import { type Iterable } from "destack:iter";
import { type Index, type IndexSet } from "destack:ops";
import { type Array } from "./array.ds";

/// A contiguous view into storage.
export newtype Slice<T> = [T];

/// Build a slice from raw storage.
@intrinsic("slice.fromRaw")
export declare function sliceFromRaw<T>(data: *T, length: usize): Slice<T>;

/// Return the slice length.
@intrinsic("slice.length")
declare function sliceLength<T>(slice: Slice<T>): usize;

/// Load one element without bounds checks.
@intrinsic("slice.get")
declare function sliceUnsafeGet<T>(slice: Slice<T>, index: usize): T;

/// Store one element without bounds checks.
@intrinsic("slice.set")
declare function sliceUnsafeSet<T>(slice: &Slice<T>, index: usize, value: T): void;

extension<T> of Slice<T> implements Index<number>, IndexSet<number, T>, Iterable<T> {
    /// The indexed output type.
    type Output = T;

    /// Get the length of the slice.
    get length(): number {
        sliceLength(this) as number
    }

    /// Check if the slice is empty.
    get isEmpty(): boolean {
        sliceLength(this) == 0
    }

    /// Get the element at the index with bounds checks.
    index(i: number): T {
        let length = sliceLength(this) as number;

        if (i < 0 || i >= length) {
            panic("slice index out of bounds")
        }

        this.unsafeGet(i as usize)
    }

    /// Borrow the element at the index with bounds checks.
    index(this: &Slice<T>, i: number): &T {
        todo("Slice.index")
    }

    /// Borrow the element at the index with readonly access.
    index(this: &readonly Slice<T>, i: number): &readonly T {
        todo("Slice.index")
    }

    /// Borrow the element at the index with exclusive access.
    index(this: &exclusive Slice<T>, i: number): &exclusive T {
        todo("Slice.index")
    }

    /// Get element at index (unchecked).
    unsafeGet(i: usize): T {
        sliceUnsafeGet(this, i)
    }

    /// Get a sub-slice.
    slice(start?: number, end?: number): Slice<T> {
        todo("Slice.slice")
    }

    /// Get the first element.
    first(): T | undefined {
        if (sliceLength(this) == 0) {
            return undefined;
        }

        this.index(0)
    }

    /// Get the last element.
    last(): T | undefined {
        let length = sliceLength(this);

        if (length == 0) {
            return undefined;
        }

        this.index(length as number - 1)
    }

    /// Split at index into two slices.
    splitAt(index: number): (Slice<T>, Slice<T>) {
        todo("Slice.splitAt")
    }

    /// Copy slice contents to an owned array.
    toArray(): Array<T> {
        todo("Slice.toArray")
    }

    /// Set the element at the index with bounds checks.
    indexSet(this: &Slice<T>, i: number, value: T): void {
        let length = sliceLength(this) as number;

        if (i < 0 || i >= length) {
            panic("slice index out of bounds")
        }

        sliceUnsafeSet(this, i as usize, value);
    }

    /// Fill the slice with a value.
    fill(this: &Slice<T>, value: T): void {
        todo("Slice.fill")
    }

    /// Copy from another slice.
    copyFrom(this: &Slice<T>, src: Slice<T>): void {
        todo("Slice.copyFrom")
    }

    /// Swap two elements.
    swap(this: &Slice<T>, i: number, j: number): void {
        todo("Slice.swap")
    }

    /// Reverse in place.
    reverse(this: &Slice<T>): void {
        todo("Slice.reverse")
    }
}
