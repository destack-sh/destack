import { todo } from "destack:error";
import { Iterable, Iterator } from "destack:iter";
import { Index, IndexSet } from "destack:ops";

/// A contiguous view into storage.
export newtype Slice<T> = [T];

/// Build a slice from raw storage.
@unsafe
@intrinsic("slice.fromRaw")
export declare function sliceFromRaw<T>(data: *T, length: usize): Slice<T>;

/// Return the slice length.
@intrinsic("slice.length")
declare function sliceLength<T>(slice: Slice<T>): usize;

/// Load one element unchecked.
@unsafe
@intrinsic("slice.get")
declare function sliceUnsafeGet<T>(slice: Slice<T>, index: usize): T;

/// Store one element unchecked.
@unsafe
@intrinsic("slice.set")
declare function sliceUnsafeSet<T>(slice: &exclusive Slice<T>, index: usize, value: T): void;

extension<T> of Slice<T> implements
    Index<number>,
    IndexSet<number, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>
{
    /// The indexed output type.
    type Output = T;

    /// Return the number of elements.
    get length(): number {
        sliceLength(this) as number
    }

    /// Return the number of elements.
    get size(): usize {
        sliceLength(this)
    }

    /// Return whether this slice has no elements.
    get isEmpty(): boolean {
        sliceLength(this) == 0
    }

    /// Return the element at `index` by value.
    index(index: number): T {
        todo("Slice.index")
    }

    /// Borrow the element at `index`.
    index(this: &Slice<T>, index: number): &T {
        todo("Slice.index")
    }

    /// Borrow the element at `index` with readonly access.
    index(this: &readonly Slice<T>, index: number): &readonly T {
        todo("Slice.index")
    }

    /// Borrow the element at `index` with exclusive access.
    index(this: &exclusive Slice<T>, index: number): &exclusive T {
        todo("Slice.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive Slice<T>, index: number, value: T): void {
        todo("Slice.indexSet")
    }

    /// Return the first element by value.
    first(): T | undefined {
        if (sliceLength(this) == 0) {
            return undefined;
        }

        this.index(0)
    }

    /// Borrow the first element.
    first(this: &Slice<T>): &T | undefined {
        todo("Slice.first")
    }

    /// Borrow the first element with readonly access.
    first(this: &readonly Slice<T>): &readonly T | undefined {
        todo("Slice.first")
    }

    /// Borrow the first element with exclusive access.
    first(this: &exclusive Slice<T>): &exclusive T | undefined {
        todo("Slice.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        let length = sliceLength(this);

        if (length == 0) {
            return undefined;
        }

        this.index(length as number - 1)
    }

    /// Borrow the last element.
    last(this: &Slice<T>): &T | undefined {
        todo("Slice.last")
    }

    /// Borrow the last element with readonly access.
    last(this: &readonly Slice<T>): &readonly T | undefined {
        todo("Slice.last")
    }

    /// Borrow the last element with exclusive access.
    last(this: &exclusive Slice<T>): &exclusive T | undefined {
        todo("Slice.last")
    }

    /// Return a sub-slice.
    slice(start?: number, end?: number): Slice<T> {
        todo("Slice.slice")
    }

    /// Split this slice at `index`.
    splitAt(index: number): (Slice<T>, Slice<T>) {
        todo("Slice.splitAt")
    }

    /// Fill this slice with `value`.
    fill(this: &exclusive Slice<T>, value: T): void {
        todo("Slice.fill")
    }

    /// Copy from another slice.
    copyFrom(this: &exclusive Slice<T>, source: &readonly Slice<T>): void {
        todo("Slice.copyFrom")
    }

    /// Swap two elements.
    swap(this: &exclusive Slice<T>, a: number, b: number): void {
        todo("Slice.swap")
    }

    /// Reverse this slice in place.
    reverse(this: &exclusive Slice<T>): void {
        todo("Slice.reverse")
    }

    /// Sort this slice in place.
    sort(this: &exclusive Slice<T>, compare?: (a: &readonly T, b: &readonly T) => number): void {
        todo("Slice.sort")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator(this: &Slice<T>): Iterator<&T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly Slice<T>): Iterator<&readonly T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over exclusive borrowed values.
    iterator(this: &exclusive Slice<T>): Iterator<&exclusive T> {
        todo("Slice.iterator")
    }
}
