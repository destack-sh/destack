import { todo } from "destack:error";
import { Iterable, Iterator } from "destack:iter";
import { Raw } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

/// Well-known library type for the builtin slice form `[T]`.
@languageItem("Slice")
export newtype Slice<T> = [T];

extension<T> of Slice<T> implements
    Index<number>,
    IndexSet<number, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>
{
    /// The indexed output type.
    type Output = T;

    /// Build a raw slice from raw storage.
    @unsafe
    @intrinsic("slice.fromRaw")
    static fromRaw(data: *T, length: usize): Raw<Slice<T>>;

    /// Return the number of elements.
    get length(): number {
        this.size as number
    }

    /// Return the number of elements.
    @intrinsic("slice.length")
    get size(): usize;

    /// Return whether this slice has no elements.
    get isEmpty(): boolean {
        this.size == 0
    }

    /// Load one element without bounds checks.
    @unsafe
    @intrinsic("slice.get")
    unsafeGet(this: &readonly Slice<T>, index: usize): T;

    /// Store one element without bounds checks.
    @unsafe
    @intrinsic("slice.set")
    unsafeSet(this: &exclusive Slice<T>, index: usize, value: T): void;

    /// Return the element at `index` by value.
    index(index: number): T {
        todo("Slice.index")
    }

    /// Borrow the element at `index`.
    index(this: &Slice<T>, index: number): &T {
        todo("Slice.index")
    }

    /// Borrow the element at `index` with readonly access.
    index(this: &readonly Slice<T>, index: number): &readonly T {
        todo("Slice.index")
    }

    /// Borrow the element at `index` with exclusive access.
    index(this: &exclusive Slice<T>, index: number): &exclusive T {
        todo("Slice.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive Slice<T>, index: number, value: T): void {
        todo("Slice.indexSet")
    }

    /// Return the first element by value.
    first(): T | undefined {
        if (this.size == 0) {
            return undefined;
        }

        this.index(0)
    }

    /// Borrow the first element.
    first(this: &Slice<T>): &T | undefined {
        todo("Slice.first")
    }

    /// Borrow the first element with readonly access.
    first(this: &readonly Slice<T>): &readonly T | undefined {
        todo("Slice.first")
    }

    /// Borrow the first element with exclusive access.
    first(this: &exclusive Slice<T>): &exclusive T | undefined {
        todo("Slice.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        let length = this.size;

        if (length == 0) {
            return undefined;
        }

        this.index(length as number - 1)
    }

    /// Borrow the last element.
    last(this: &Slice<T>): &T | undefined {
        todo("Slice.last")
    }

    /// Borrow the last element with readonly access.
    last(this: &readonly Slice<T>): &readonly T | undefined {
        todo("Slice.last")
    }

    /// Borrow the last element with exclusive access.
    last(this: &exclusive Slice<T>): &exclusive T | undefined {
        todo("Slice.last")
    }

    /// Borrow a contiguous range.
    @intrinsic("slice.subslice")
    subslice(this: &Slice<T>, start: usize, length: usize): &Slice<T>;

    /// Borrow a readonly contiguous range.
    @intrinsic("slice.subslice")
    subslice(this: &readonly Slice<T>, start: usize, length: usize): &readonly Slice<T>;

    /// Borrow an exclusive contiguous range.
    @intrinsic("slice.subslice")
    subslice(this: &exclusive Slice<T>, start: usize, length: usize): &exclusive Slice<T>;

    /// Borrow a selected range.
    slice(this: &Slice<T>, start?: number, end?: number): &Slice<T> {
        todo("Slice.slice")
    }

    /// Borrow a readonly selected range.
    slice(this: &readonly Slice<T>, start?: number, end?: number): &readonly Slice<T> {
        todo("Slice.slice")
    }

    /// Borrow an exclusive selected range.
    slice(this: &exclusive Slice<T>, start?: number, end?: number): &exclusive Slice<T> {
        todo("Slice.slice")
    }

    /// Split this slice into two borrowed ranges.
    splitAt(this: &Slice<T>, index: number): (&Slice<T>, &Slice<T>) {
        todo("Slice.splitAt")
    }

    /// Split this slice into two readonly borrowed ranges.
    splitAt(this: &readonly Slice<T>, index: number): (&readonly Slice<T>, &readonly Slice<T>) {
        todo("Slice.splitAt")
    }

    /// Split this slice into two exclusive borrowed ranges.
    splitAt(this: &exclusive Slice<T>, index: number): (&exclusive Slice<T>, &exclusive Slice<T>) {
        todo("Slice.splitAt")
    }

    /// Fill this slice with `value`.
    fill(this: &exclusive Slice<T>, value: T): void {
        todo("Slice.fill")
    }

    /// Copy from another slice.
    copyFrom(this: &exclusive Slice<T>, source: &readonly Slice<T>): void {
        todo("Slice.copyFrom")
    }

    /// Swap two elements.
    swap(this: &exclusive Slice<T>, a: number, b: number): void {
        todo("Slice.swap")
    }

    /// Reverse this slice in place.
    reverse(this: &exclusive Slice<T>): void {
        todo("Slice.reverse")
    }

    /// Sort this slice in place.
    sort(this: &exclusive Slice<T>, compare?: (a: &readonly T, b: &readonly T) => number): void {
        todo("Slice.sort")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator(this: &Slice<T>): Iterator<&T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly Slice<T>): Iterator<&readonly T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over exclusive borrowed values.
    iterator(this: &exclusive Slice<T>): Iterator<&exclusive T> {
        todo("Slice.iterator")
    }
}
