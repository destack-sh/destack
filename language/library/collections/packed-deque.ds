import { todo } from "destack:error";
import { From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default, MaybeUninit, Unique } from "destack:memory";
import { Index, IndexSet } from "destack:ops";
import { Deque } from "./deque.ds";

/// A packed ring-buffer double-ended queue.
export struct PackedDeque<T> {
    /// The ring storage.
    storage: Unique<[MaybeUninit<T>]>;

    /// The first initialized slot.
    head: usize = 0;

    /// The number of initialized elements.
    elementCount: usize = 0;

    /// The allocated element count.
    elementCapacity: usize = 0;
}

extension<T> of PackedDeque<T> implements
    Index<number>,
    IndexSet<number, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    From<Iterable<T>>,
    FromIterator<T>,
    Extend<T, "exclusive">,
    Default,
    From<Deque<T>>
{
    /// The indexed output type.
    type Output = T;

    /// Create an empty packed deque.
    static new(): PackedDeque<T> {
        todo("PackedDeque.new")
    }

    /// Create a packed deque with room for at least `capacity` elements.
    static withCapacity(capacity: usize): PackedDeque<T> {
        todo("PackedDeque.withCapacity")
    }

    /// Create a packed deque from values.
    static from(values: Iterable<T>): PackedDeque<T> {
        todo("PackedDeque.from")
    }

    /// Create a packed deque from `values`.
    static fromIterator(values: Iterator<T>): PackedDeque<T> {
        todo("PackedDeque.fromIterator")
    }

    /// Create the default packed deque.
    static default(): PackedDeque<T> {
        PackedDeque.new()
    }

    /// Create a packed deque from a stable deque.
    static from(value: Deque<T>): PackedDeque<T> {
        todo("PackedDeque.fromDeque")
    }

    /// Return the number of elements.
    get length(): number {
        this.elementCount as number
    }

    /// Return the number of elements.
    get size(): usize {
        this.elementCount
    }

    /// Return the allocated element count.
    get capacity(): usize {
        this.elementCapacity
    }

    /// Return whether this deque has no elements.
    get isEmpty(): boolean {
        this.elementCount == 0
    }

    /// Return the element at `index` by value.
    index(index: number): T {
        todo("PackedDeque.index")
    }

    /// Borrow the element at `index`.
    index(this: &PackedDeque<T>, index: number): &T {
        todo("PackedDeque.index")
    }

    /// Borrow the element at `index` with readonly access.
    index(this: &readonly PackedDeque<T>, index: number): &readonly T {
        todo("PackedDeque.index")
    }

    /// Borrow the element at `index` with exclusive access.
    index(this: &exclusive PackedDeque<T>, index: number): &exclusive T {
        todo("PackedDeque.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive PackedDeque<T>, index: number, value: T): void {
        todo("PackedDeque.indexSet")
    }

    /// Push `value` to the back.
    pushBack(this: &exclusive PackedDeque<T>, value: T): void {
        todo("PackedDeque.pushBack")
    }

    /// Push `value` to the front.
    pushFront(this: &exclusive PackedDeque<T>, value: T): void {
        todo("PackedDeque.pushFront")
    }

    /// Append all `values` to the back.
    extend(this: &exclusive PackedDeque<T>, values: Iterable<T>): void {
        todo("PackedDeque.extend")
    }

    /// Remove and return the back element.
    popBack(this: &exclusive PackedDeque<T>): T | undefined {
        todo("PackedDeque.popBack")
    }

    /// Remove and return the front element.
    popFront(this: &exclusive PackedDeque<T>): T | undefined {
        todo("PackedDeque.popFront")
    }

    /// Borrow the front element.
    front(this: &PackedDeque<T>): &T | undefined {
        todo("PackedDeque.front")
    }

    /// Borrow the front element with readonly access.
    front(this: &readonly PackedDeque<T>): &readonly T | undefined {
        todo("PackedDeque.front")
    }

    /// Borrow the front element with exclusive access.
    front(this: &exclusive PackedDeque<T>): &exclusive T | undefined {
        todo("PackedDeque.front")
    }

    /// Borrow the back element.
    back(this: &PackedDeque<T>): &T | undefined {
        todo("PackedDeque.back")
    }

    /// Borrow the back element with readonly access.
    back(this: &readonly PackedDeque<T>): &readonly T | undefined {
        todo("PackedDeque.back")
    }

    /// Borrow the back element with exclusive access.
    back(this: &exclusive PackedDeque<T>): &exclusive T | undefined {
        todo("PackedDeque.back")
    }

    /// Remove all elements.
    clear(this: &exclusive PackedDeque<T>): void {
        todo("PackedDeque.clear")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(this: &exclusive PackedDeque<T>, additional: usize): void {
        todo("PackedDeque.reserve")
    }

    /// Shrink capacity to fit current elements.
    shrinkToFit(this: &exclusive PackedDeque<T>): void {
        todo("PackedDeque.shrinkToFit")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("PackedDeque.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator(this: &PackedDeque<T>): Iterator<&T> {
        todo("PackedDeque.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly PackedDeque<T>): Iterator<&readonly T> {
        todo("PackedDeque.iterator")
    }

    /// Return an iterator over exclusive borrowed values.
    iterator(this: &exclusive PackedDeque<T>): Iterator<&exclusive T> {
        todo("PackedDeque.iterator")
    }

    /// Consume this deque into owned values.
    iterator(this: ^PackedDeque<T>): Iterator<T> {
        todo("PackedDeque.iterator")
    }
}
