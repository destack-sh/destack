import { todo } from "destack:error";
import { Borrow, From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default, MaybeUninit, Unique } from "destack:memory";
import { Equal, Hash, Index, IndexSet } from "destack:ops";
import { Map } from "./map.ds";

/// One packed hash table entry.
export struct PackedMapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one packed map entry.
export struct PackedMapEntryHandle<K, V> {
    /// The borrowed map.
    private map: &exclusive PackedMap<K, V>;

    /// The queried key.
    private entryKey: K;
}

/// One packed hash table slot.
struct PackedMapSlot<K, V> {
    /// The cached key hash.
    hash: uint64;

    /// The slot entry.
    entry: PackedMapEntry<K, V>;
}

/// A packed open-addressing hash map.
export struct PackedMap<K, V> {
    /// The control-byte storage.
    control: Unique<[uint8]>;

    /// The entry storage.
    entries: Unique<[MaybeUninit<PackedMapSlot<K, V>>]>;

    /// The number of live entries.
    entryCount: usize = 0;

    /// The allocated entry count.
    entryCapacity: usize = 0;
}

extension<K: Hash, V> of PackedMapEntryHandle<K, V>
where K implements Equal<K> {
    /// Borrow the queried key.
    get key(): &readonly K {
        todo("PackedMapEntryHandle.key")
    }

    /// Return whether this handle points at an occupied entry.
    get isOccupied(): boolean {
        todo("PackedMapEntryHandle.isOccupied")
    }

    /// Borrow the current value.
    get(this: &PackedMapEntryHandle<K, V>): &V | undefined {
        todo("PackedMapEntryHandle.get")
    }

    /// Insert `value` when this handle is vacant.
    orInsert(this: &exclusive PackedMapEntryHandle<K, V>, value: V): &V {
        todo("PackedMapEntryHandle.orInsert")
    }

    /// Insert a value produced by `makeValue` when this handle is vacant.
    orInsertWith(this: &exclusive PackedMapEntryHandle<K, V>, makeValue: () => V): &V {
        todo("PackedMapEntryHandle.orInsertWith")
    }

    /// Insert or replace the value.
    set(this: &exclusive PackedMapEntryHandle<K, V>, value: V): &V {
        todo("PackedMapEntryHandle.set")
    }

    /// Remove the entry.
    remove(this: &exclusive PackedMapEntryHandle<K, V>): V | undefined {
        todo("PackedMapEntryHandle.remove")
    }
}

extension<K, V> of PackedMap<K, V> implements Default {
    /// Create an empty packed map.
    static new(): PackedMap<K, V> {
        todo("PackedMap.new")
    }

    /// Create a packed map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): PackedMap<K, V> {
        todo("PackedMap.withCapacity")
    }

    /// Create the default packed map.
    static default(): PackedMap<K, V> {
        PackedMap.new()
    }
}

extension<K: Hash, V> of PackedMap<K, V> implements
    Index<K>,
    IndexSet<K, V>,
    Iterable<(K, V)>,
    Iterable<PackedMapEntry<&readonly K, &V>>,
    Iterable<PackedMapEntry<&readonly K, &readonly V>>,
    Iterable<PackedMapEntry<&readonly K, &exclusive V>>,
    From<Iterable<(K, V)>>,
    FromIterator<(K, V)>,
    Extend<(K, V), "exclusive">,
    From<Map<K, V>>
where K implements Equal<K> {
    /// The indexed output type.
    type Output = V | undefined;

    /// Create a packed map from entries.
    static from(entries: Iterable<(K, V)>): PackedMap<K, V> {
        todo("PackedMap.from")
    }

    /// Create a packed map from entries.
    static fromIterator(entries: Iterator<(K, V)>): PackedMap<K, V> {
        todo("PackedMap.fromIterator")
    }

    /// Create a packed map from a stable map.
    static from(value: Map<K, V>): PackedMap<K, V> {
        todo("PackedMap.fromMap")
    }

    /// Return the number of entries.
    get size(): number {
        this.entryCount as number
    }

    /// Return the allocated entry count.
    get capacity(): usize {
        this.entryCapacity
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.entryCount == 0
    }

    /// Return a value by key.
    get<Q: Hash>(key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.get")
    }

    /// Borrow a value by key.
    get<Q: Hash>(this: &PackedMap<K, V>, key: &readonly Q): &V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.get")
    }

    /// Borrow a value by key with readonly access.
    get<Q: Hash>(this: &readonly PackedMap<K, V>, key: &readonly Q): &readonly V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.get")
    }

    /// Borrow a value by key with exclusive access.
    get<Q: Hash>(this: &exclusive PackedMap<K, V>, key: &readonly Q): &exclusive V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.get")
    }

    /// Return a value by key through the index operator.
    index(key: K): V | undefined {
        todo("PackedMap.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(this: &exclusive PackedMap<K, V>, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Hash>(key: &readonly Q): boolean
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.has")
    }

    /// Return mutating access to the entry for `key`.
    entry(this: &exclusive PackedMap<K, V>, key: K): PackedMapEntryHandle<K, V> {
        todo("PackedMap.entry")
    }

    /// Insert a key-value pair.
    insert(this: &exclusive PackedMap<K, V>, key: K, value: V): boolean {
        todo("PackedMap.insert")
    }

    /// Insert or replace a key-value pair.
    set(this: &exclusive PackedMap<K, V>, key: K, value: V): this {
        todo("PackedMap.set")
    }

    /// Insert or replace all entries.
    extend(this: &exclusive PackedMap<K, V>, entries: Iterable<(K, V)>): void {
        todo("PackedMap.extend")
    }

    /// Remove a key-value pair.
    remove<Q: Hash>(this: &exclusive PackedMap<K, V>, key: &readonly Q): V | undefined
    where K implements Borrow<Q>, Q implements Equal<Q> {
        todo("PackedMap.remove")
    }

    /// Remove all entries.
    clear(this: &exclusive PackedMap<K, V>): void {
        todo("PackedMap.clear")
    }

    /// Retain only entries accepted by `predicate`.
    retain(
        this: &exclusive PackedMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): void {
        todo("PackedMap.retain")
    }

    /// Remove all entries and return them.
    drain(this: &exclusive PackedMap<K, V>): Iterator<(K, V)> {
        todo("PackedMap.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        this: &exclusive PackedMap<K, V>,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): Iterator<(K, V)> {
        todo("PackedMap.extractIf")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(this: &exclusive PackedMap<K, V>, additional: usize): void {
        todo("PackedMap.reserve")
    }

    /// Shrink capacity to fit current entries.
    shrinkToFit(this: &exclusive PackedMap<K, V>): void {
        todo("PackedMap.shrinkToFit")
    }

    /// Return all keys.
    keys(this: &readonly PackedMap<K, V>): Iterator<&readonly K> {
        todo("PackedMap.keys")
    }

    /// Return all values.
    values(this: &PackedMap<K, V>): Iterator<&V> {
        todo("PackedMap.values")
    }

    /// Return all values with readonly access.
    values(this: &readonly PackedMap<K, V>): Iterator<&readonly V> {
        todo("PackedMap.values")
    }

    /// Return all values with exclusive access.
    values(this: &exclusive PackedMap<K, V>): Iterator<&exclusive V> {
        todo("PackedMap.values")
    }

    /// Return all entries.
    entries(this: &PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &V>> {
        todo("PackedMap.entries")
    }

    /// Return all entries with readonly access.
    entries(this: &readonly PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &readonly V>> {
        todo("PackedMap.entries")
    }

    /// Return all entries with exclusive value access.
    entries(this: &exclusive PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &exclusive V>> {
        todo("PackedMap.entries")
    }

    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("PackedMap.iterator")
    }

    /// Return an iterator over borrowed entries.
    iterator(this: &PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &V>> {
        todo("PackedMap.iterator")
    }

    /// Return an iterator over readonly borrowed entries.
    iterator(this: &readonly PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &readonly V>> {
        todo("PackedMap.iterator")
    }

    /// Return an iterator over entries with exclusive value access.
    iterator(this: &exclusive PackedMap<K, V>): Iterator<PackedMapEntry<&readonly K, &exclusive V>> {
        todo("PackedMap.iterator")
    }

    /// Consume this map into owned entries.
    iterator(this: ^PackedMap<K, V>): Iterator<(K, V)> {
        todo("PackedMap.iterator")
    }
}
