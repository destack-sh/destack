import { todo } from "destack:error";
import { From } from "destack:convert";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default } from "destack:memory";
import { Compare } from "destack:ops";
import { PackedArray } from "./packed-array.ds";

/// A packed binary max-heap.
export struct BinaryHeap<T> {
    /// The heap storage.
    storage: PackedArray<T>;
}

extension<T> of BinaryHeap<T> implements Default {
    /// Create an empty binary heap.
    static new(): BinaryHeap<T> {
        todo("BinaryHeap.new")
    }

    /// Create a binary heap with room for at least `capacity` elements.
    static withCapacity(capacity: usize): BinaryHeap<T> {
        todo("BinaryHeap.withCapacity")
    }

    /// Create the default binary heap.
    static default(): BinaryHeap<T> {
        BinaryHeap.new()
    }
}

extension<T: Compare<T>> of BinaryHeap<T> implements
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    From<Iterable<T>>,
    FromIterator<T>,
    Extend<T, "exclusive">
{
    /// Create a binary heap from values.
    static from(values: Iterable<T>): BinaryHeap<T> {
        todo("BinaryHeap.from")
    }

    /// Create a binary heap from `values`.
    static fromIterator(values: Iterator<T>): BinaryHeap<T> {
        todo("BinaryHeap.fromIterator")
    }

    /// Return the number of elements.
    get size(): number {
        this.storage.length
    }

    /// Return the allocated element count.
    get capacity(): usize {
        this.storage.capacity
    }

    /// Return whether this heap has no elements.
    get isEmpty(): boolean {
        this.storage.isEmpty
    }

    /// Borrow the greatest element.
    peek(this: &BinaryHeap<T>): &T | undefined {
        todo("BinaryHeap.peek")
    }

    /// Borrow the greatest element with readonly access.
    peek(this: &readonly BinaryHeap<T>): &readonly T | undefined {
        todo("BinaryHeap.peek")
    }

    /// Borrow the greatest element with exclusive access.
    peek(this: &exclusive BinaryHeap<T>): &exclusive T | undefined {
        todo("BinaryHeap.peek")
    }

    /// Push `value`.
    push(this: &exclusive BinaryHeap<T>, value: T): void {
        todo("BinaryHeap.push")
    }

    /// Push all `values`.
    extend(this: &exclusive BinaryHeap<T>, values: Iterable<T>): void {
        todo("BinaryHeap.extend")
    }

    /// Remove and return the greatest element.
    pop(this: &exclusive BinaryHeap<T>): T | undefined {
        todo("BinaryHeap.pop")
    }

    /// Remove all elements.
    clear(this: &exclusive BinaryHeap<T>): void {
        todo("BinaryHeap.clear")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(this: &exclusive BinaryHeap<T>, additional: usize): void {
        todo("BinaryHeap.reserve")
    }

    /// Shrink capacity to fit current elements.
    shrinkToFit(this: &exclusive BinaryHeap<T>): void {
        todo("BinaryHeap.shrinkToFit")
    }

    /// Convert this heap into a sorted packed array.
    intoSortedArray(this: ^BinaryHeap<T>): PackedArray<T> {
        todo("BinaryHeap.intoSortedArray")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("BinaryHeap.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator(this: &BinaryHeap<T>): Iterator<&T> {
        todo("BinaryHeap.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(this: &readonly BinaryHeap<T>): Iterator<&readonly T> {
        todo("BinaryHeap.iterator")
    }

    /// Return an iterator over exclusive borrowed values.
    iterator(this: &exclusive BinaryHeap<T>): Iterator<&exclusive T> {
        todo("BinaryHeap.iterator")
    }

    /// Consume this heap into owned values.
    iterator(this: ^BinaryHeap<T>): Iterator<T> {
        todo("BinaryHeap.iterator")
    }
}
