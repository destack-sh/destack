import { Array, PackedArray } from "destack:collections";
import { HostError } from "destack:error/host";

/// Return the process argument vector.
@binding("destack.process.argument.list", {
    effect: "external",
    requires: ["host.process.arguments"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listArguments(): Result<PackedArray<^string>, HostError>;
