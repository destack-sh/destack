import { HostError } from "destack:error/host";
import { ProcessId } from "./identity.ds";
import { Signal } from "./signal.ds";
import { ProcessHandle } from "destack:process/host";

/// Wait flags for process waits.
export newtype ProcessWaitFlags = uint32;

/// Return immediately if no status is available.
export const PROCESS_WAIT_NO_HANG: ProcessWaitFlags = ProcessWaitFlags(0x1);

/// Report stopped children.
export const PROCESS_WAIT_STOPPED: ProcessWaitFlags = ProcessWaitFlags(0x2);

/// Report continued children.
export const PROCESS_WAIT_CONTINUED: ProcessWaitFlags = ProcessWaitFlags(0x4);

/// Child process running status payload.
export struct ProcessWaitRunningStatus {
    /// Discriminator for this wait-status variant.
    kind: "running";
    /// Child process identifier.
    pid: ProcessId;
}

/// Child process exited status payload.
export struct ProcessWaitExitedStatus {
    /// Discriminator for this wait-status variant.
    kind: "exited";
    /// Child process identifier.
    pid: ProcessId;
    /// Exit code.
    exitCode: int32;
}

/// Child process signaled status payload.
export struct ProcessWaitSignaledStatus {
    /// Discriminator for this wait-status variant.
    kind: "signaled";
    /// Child process identifier.
    pid: ProcessId;
    /// Signal number.
    signal: Signal;
    /// Whether a core file was produced.
    coreDumped: boolean;
}

/// Child process stopped status payload.
export struct ProcessWaitStoppedStatus {
    /// Discriminator for this wait-status variant.
    kind: "stopped";
    /// Child process identifier.
    pid: ProcessId;
    /// Signal number.
    signal: Signal;
}

/// Child process continued status payload.
export struct ProcessWaitContinuedStatus {
    /// Discriminator for this wait-status variant.
    kind: "continued";
    /// Child process identifier.
    pid: ProcessId;
}

/// Child process status payload.
export newtype ProcessWaitStatus =
    | ProcessWaitRunningStatus
    | ProcessWaitExitedStatus
    | ProcessWaitSignaledStatus
    | ProcessWaitStoppedStatus
    | ProcessWaitContinuedStatus;

/// Wait for a child process handle.
@binding("destack.process.wait.handle", {
    effect: "external",
    requires: ["host.process.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitProcess(
    handle: ProcessHandle,
    flags: ProcessWaitFlags,
): Result<ProcessWaitStatus, HostError>;

/// Poll a child process handle without blocking.
@binding("destack.process.wait.poll", {
    effect: "external",
    requires: ["host.process.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pollProcess(
    handle: ProcessHandle,
): Result<ProcessWaitStatus, HostError>;

/// Wait for a process identifier.
@binding("destack.process.wait.pid", {
    effect: "external",
    requires: ["host.process.wait"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function waitProcessId(
    pid: ProcessId,
    flags: ProcessWaitFlags,
): Result<ProcessWaitStatus, HostError>;
