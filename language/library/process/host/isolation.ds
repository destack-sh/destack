import { HostError } from "destack:error/host";
import { Path } from "destack:fs/host";
import { ProcessId } from "./identity.ds";

/// Flags for `unshare` operations.
export newtype ProcessUnshareFlags = uint64;

/// Flags for syscall-filter installation.
export newtype SyscallFilterFlags = uint32;

/// Process namespace kind.
export enum ProcessNamespaceKind {
    /// Mount namespace.
    Mount = 1,
    /// User namespace.
    User = 2,
    /// PID namespace.
    Pid = 3,
    /// Network namespace.
    Network = 4,
    /// IPC namespace.
    Ipc = 5,
    /// UTS namespace.
    Uts = 6,
    /// Cgroup namespace.
    Cgroup = 7,
    /// Time namespace.
    Time = 8,
}

/// Enter one namespace owned by another process.
@binding("destack.process.isolation.enterNamespace", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function enterNamespace(
    pid: ProcessId,
    namespace: ProcessNamespaceKind,
): Result<void, HostError>;

/// Unshare one or more namespaces.
@binding("destack.process.isolation.unshare", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function unshare(flags: ProcessUnshareFlags): Result<void, HostError>;

/// Change the root directory for path resolution.
@binding("destack.process.isolation.chroot", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.policy.write"],
    families: ["unix"],
    simulation: true,
})
export declare function chroot(path: &readonly Path): Result<void, HostError>;

/// Install one syscall filter program.
@binding("destack.process.isolation.syscallFilter", {
    effect: "external",
    replay: "forbidden",
    requires: ["runtime.policy.write"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setSyscallFilter(
    program: &readonly [uint8],
    flags: SyscallFilterFlags,
): Result<void, HostError>;

/// Set process host name inside the active UTS namespace.
@binding("destack.process.isolation.hostname", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setHostname(name: &readonly string): Result<void, HostError>;

/// Set network namespace context for subsequent network operations.
@binding("destack.process.isolation.networkNamespace", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.process.namespace"],
    platforms: ["linux"],
    simulation: true,
})
export declare function setNetworkNamespace(path: &readonly Path): Result<void, HostError>;
