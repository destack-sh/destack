import { HostError } from "destack:error/host";
import { DirectoryHandle, FileHandle, Path } from "destack:fs/host";

import { EnvironmentVariable } from "./environment.ds";

/// Exec flags.
export newtype ExecFlags = uint32;

/// Allow an empty path when the host supports handle-relative exec.
export const EXEC_EMPTY_PATH: ExecFlags = ExecFlags(0x1);

/// Replace the current process image with a command path.
@binding("destack.process.exec.path", {
    effect: "external",
    requires: ["host.process.exec"],
    families: ["unix"],
    simulation: true,
})
export declare function exec(
    command: &readonly Path,
    arguments: &readonly [string],
    environment: &readonly [EnvironmentVariable],
): Result<void, HostError>;

/// Replace the current process image using a directory-relative path.
@binding("destack.process.exec.at", {
    effect: "external",
    requires: ["host.process.exec"],
    families: ["unix"],
    simulation: true,
})
export declare function execAt(
    directory: DirectoryHandle,
    path: &readonly Path,
    arguments: &readonly [string],
    environment: &readonly [EnvironmentVariable],
    flags: ExecFlags,
): Result<void, HostError>;

/// Replace the current process image using an executable file handle.
@binding("destack.process.exec.file", {
    effect: "external",
    requires: ["host.process.exec"],
    families: ["unix"],
    simulation: true,
})
export declare function execFile(
    executable: FileHandle,
    arguments: &readonly [string],
    environment: &readonly [EnvironmentVariable],
): Result<void, HostError>;
