import { todo } from "destack:error";
import { Array, Slice } from "destack:collections";
import { As, Borrow, From } from "destack:convert";
import { Iterator } from "destack:iter";
import { Default, Unique } from "destack:memory";
import { RegExp, RegExpMatch } from "destack:regexp";
import { StringSlice } from "./slice.ds";
import { StringBuilder } from "./builder.ds";

/// Raw template string parts.
export type StringRawParts = {
    /// The raw template segments.
    readonly raw: readonly string[];
};

/// Match result from `String.match`.
export type StringMatch = RegExpMatch | readonly string[];

/// Replacement value used by `String.replace` and `String.replaceAll`.
export type StringReplacement = string | ((match: string, ...captures: (string | undefined)[]) => string);

/// Immutable UTF-8 string.
@languageItem("string.String")
export class String {
    /// The owned UTF-8 bytes.
    bytes: Unique<[uint8]>;
}

extension of String {
    /// Create an empty string.
    static new(): ^string {
        todo("String.new")
    }

    /// Create the default string.
    static default(): ^string {
        String.new()
    }

    /// Create a string from UTF-16 code units.
    static fromCharCode(...codes: number[]): ^string {
        todo("String.fromCharCode")
    }

    /// Create a string from Unicode code points.
    static fromCodePoint(...codePoints: number[]): ^string {
        todo("String.fromCodePoint")
    }

    /// Create a string from raw template parts.
    static raw(parts: StringRawParts, ...substitutions: unknown[]): ^string {
        todo("String.raw")
    }

    /// Copy a string slice into owned storage.
    static from(value: &readonly StringSlice): ^string {
        todo("String.from")
    }

    /// Consume a string builder into owned storage.
    static from(value: ^StringBuilder): ^string {
        value.intoString()
    }

    /// The length in UTF-16 code units.
    get length(): number {
        todo("String.length")
    }

    /// Get the byte length of the UTF-8 representation.
    get byteLength(): usize {
        todo("String.byteLength")
    }

    /// Check if the string is empty.
    get isEmpty(): boolean {
        todo("String.isEmpty")
    }

    /// Get a character at the given UTF-16 index.
    /// Returns undefined if index is out of bounds.
    charAt(this: &readonly string, index: number): ^string | undefined {
        todo("String.charAt")
    }

    /// Get the character at `index`, counting from the end when negative.
    at(this: &readonly string, index: number): ^string | undefined {
        todo("String.at")
    }

    /// Get the UTF-16 code unit at the given index.
    charCodeAt(this: &readonly string, index: number): number | undefined {
        todo("String.charCodeAt")
    }

    /// Get the Unicode code point at the given index.
    codePointAt(this: &readonly string, index: number): number | undefined {
        todo("String.codePointAt")
    }

    /// Concatenate two strings.
    concat(this: &readonly string, ...values: string[]): ^string {
        todo("String.concat")
    }

    /// Check if string includes a substring.
    includes(this: &readonly string, search: string, position?: number): boolean {
        todo("String.includes")
    }

    /// Find the first index of a substring.
    indexOf(this: &readonly string, search: string, position?: number): number {
        todo("String.indexOf")
    }

    /// Find the last index of a substring.
    lastIndexOf(this: &readonly string, search: string, position?: number): number {
        todo("String.lastIndexOf")
    }

    /// Compare with `other` using locale ordering.
    localeCompare(this: &readonly string, other: string, locales?: string | string[]): number {
        todo("String.localeCompare")
    }

    /// Match this string against `pattern`.
    match(this: &readonly string, pattern: string | RegExp): StringMatch | null {
        todo("String.match")
    }

    /// Match every occurrence of `pattern`.
    matchAll(this: &readonly string, pattern: RegExp): Iterator<RegExpMatch> {
        todo("String.matchAll")
    }

    /// Replace the first matching text.
    replace(this: &readonly string, pattern: string | RegExp, replacement: StringReplacement): ^string {
        todo("String.replace")
    }

    /// Replace every matching text.
    replaceAll(this: &readonly string, pattern: string | RegExp, replacement: StringReplacement): ^string {
        todo("String.replaceAll")
    }

    /// Find the first match of `pattern`.
    search(this: &readonly string, pattern: string | RegExp): number {
        todo("String.search")
    }

    /// Split this string by `separator`.
    split(this: &readonly string, separator?: string | RegExp, limit?: number): ^Array<^string> {
        todo("String.split")
    }

    /// Check if string starts with a prefix.
    startsWith(this: &readonly string, search: string, position?: number): boolean {
        todo("String.startsWith")
    }

    /// Check if string ends with a suffix.
    endsWith(this: &readonly string, search: string, position?: number): boolean {
        todo("String.endsWith")
    }

    /// Extract a substring.
    substring(this: &readonly string, start: number, end?: number): ^string {
        todo("String.substring")
    }

    /// Extract a slice of the string.
    slice(this: &readonly string, start?: number, end?: number): ^string {
        todo("String.slice")
    }

    /// Convert to lowercase.
    toLowerCase(this: &readonly string): ^string {
        todo("String.toLowerCase")
    }

    /// Convert to lowercase using locale rules.
    toLocaleLowerCase(this: &readonly string, locales?: string | string[]): ^string {
        todo("String.toLocaleLowerCase")
    }

    /// Convert to uppercase.
    toUpperCase(this: &readonly string): ^string {
        todo("String.toUpperCase")
    }

    /// Convert to uppercase using locale rules.
    toLocaleUpperCase(this: &readonly string, locales?: string | string[]): ^string {
        todo("String.toLocaleUpperCase")
    }

    /// Normalize this string.
    normalize(this: &readonly string, form?: "NFC" | "NFD" | "NFKC" | "NFKD"): ^string {
        todo("String.normalize")
    }

    /// Remove leading and trailing whitespace.
    trim(this: &readonly string): ^string {
        todo("String.trim")
    }

    /// Remove leading whitespace.
    trimStart(this: &readonly string): ^string {
        todo("String.trimStart")
    }

    /// Remove trailing whitespace.
    trimEnd(this: &readonly string): ^string {
        todo("String.trimEnd")
    }

    /// Repeat the string n times.
    repeat(this: &readonly string, count: number): ^string {
        todo("String.repeat")
    }

    /// Pad the start of the string.
    padStart(this: &readonly string, targetLength: number, padString?: string): ^string {
        todo("String.padStart")
    }

    /// Pad the end of the string.
    padEnd(this: &readonly string, targetLength: number, padString?: string): ^string {
        todo("String.padEnd")
    }

    /// Return whether this string is well-formed Unicode.
    isWellFormed(this: &readonly string): boolean {
        todo("String.isWellFormed")
    }

    /// Return this string with invalid Unicode replaced.
    toWellFormed(this: &readonly string): ^string {
        todo("String.toWellFormed")
    }

    /// Return the primitive string value.
    valueOf(this: &readonly string): string {
        todo("String.valueOf")
    }

    /// Return the primitive string value.
    toString(this: &readonly string): &readonly string {
        todo("String.toString")
    }

    /// Equality comparison.
    equal(this: &readonly string, other: string): boolean {
        todo("String.equal")
    }

    /// String concatenation via + operator.
    add(this: &readonly string, other: string): ^string {
        todo("String.add")
    }
}

extension of ^string implements Default, From<&readonly StringSlice>, From<^StringBuilder> {
    /// Create the default owned string.
    static default(): ^string {
        String.default()
    }

    /// Create an owned string from borrowed text.
    static from(value: &readonly StringSlice): ^string {
        String.from(value)
    }

    /// Create an owned string from a string builder.
    static from(value: ^StringBuilder): ^string {
        String.from(value)
    }
}

extension of String implements As<StringSlice>, Borrow<StringSlice> {
    /// Borrow this string as UTF-8 text.
    as(this: &readonly string): &readonly StringSlice {
        todo("String.as")
    }

    /// Borrow this string as UTF-8 text.
    borrow(this: &readonly string): &readonly StringSlice {
        this.as()
    }

    /// Borrow this string as readonly bytes.
    asBytes(this: &readonly string): &readonly Slice<uint8> {
        todo("String.asBytes")
    }
}
