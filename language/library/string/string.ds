import { todo } from "destack:error";
import { Borrow, ToOwned } from "destack:convert";
import { Slice } from "destack:collections";
import { Default, MaybeUninit, Unique } from "destack:memory";

/// Borrowed UTF-8 string view.
@languageItem("string.StringView")
export newtype StringView = Slice<uint8>;

/// Immutable UTF-8 string.
@languageItem("string.String")
export class String {
    /// The owned UTF-8 bytes.
    bytes: Unique<[uint8]>;
}

/// Mutable UTF-8 string builder with growable backing storage.
export class StringBuilder {
    /// The owned UTF-8 bytes.
    bytes: Unique<[MaybeUninit<uint8>]>;

    /// The initialized byte count.
    initializedLength: usize = 0;

    /// The allocated byte capacity.
    capacity: usize = 0;
}

extension of String implements Default {
    /// Create an empty string.
    static new(): String {
        todo("String.new")
    }

    /// Create the default string.
    static default(): String {
        String.new()
    }

    /// The length in UTF-16 code units.
    get length(): number {
        todo("String.length")
    }

    /// Get the byte length of the UTF-8 representation.
    get byteLength(): uint32 {
        todo("String.byteLength")
    }

    /// Check if the string is empty.
    get isEmpty(): boolean {
        todo("String.isEmpty")
    }

    /// Get a character at the given UTF-16 index.
    /// Returns undefined if index is out of bounds.
    charAt(index: number): String | undefined {
        todo("String.charAt")
    }

    /// Get the UTF-16 code unit at the given index.
    charCodeAt(index: number): number | undefined {
        todo("String.charCodeAt")
    }

    /// Concatenate two strings.
    concat(other: String): String {
        todo("String.concat")
    }

    /// Check if string includes a substring.
    includes(search: String, position?: number): boolean {
        todo("String.includes")
    }

    /// Find the first index of a substring.
    indexOf(search: String, position?: number): number {
        todo("String.indexOf")
    }

    /// Find the last index of a substring.
    lastIndexOf(search: String, position?: number): number {
        todo("String.lastIndexOf")
    }

    /// Check if string starts with a prefix.
    startsWith(search: String, position?: number): boolean {
        todo("String.startsWith")
    }

    /// Check if string ends with a suffix.
    endsWith(search: String, position?: number): boolean {
        todo("String.endsWith")
    }

    /// Extract a substring.
    substring(start: number, end?: number): String {
        todo("String.substring")
    }

    /// Extract a slice of the string.
    slice(start?: number, end?: number): String {
        todo("String.slice")
    }

    /// Convert to lowercase.
    toLowerCase(): String {
        todo("String.toLowerCase")
    }

    /// Convert to uppercase.
    toUpperCase(): String {
        todo("String.toUpperCase")
    }

    /// Remove leading and trailing whitespace.
    trim(): String {
        todo("String.trim")
    }

    /// Remove leading whitespace.
    trimStart(): String {
        todo("String.trimStart")
    }

    /// Remove trailing whitespace.
    trimEnd(): String {
        todo("String.trimEnd")
    }

    /// Repeat the string n times.
    repeat(count: number): String {
        todo("String.repeat")
    }

    /// Pad the start of the string.
    padStart(targetLength: number, padString?: String): String {
        todo("String.padStart")
    }

    /// Pad the end of the string.
    padEnd(targetLength: number, padString?: String): String {
        todo("String.padEnd")
    }

    /// Equality comparison.
    equal(other: String): boolean {
        todo("String.equal")
    }

    /// String concatenation via + operator.
    add(other: String): String {
        todo("String.add")
    }
}

extension of StringBuilder implements Default {
    /// Create an empty string builder.
    static new(): StringBuilder {
        todo("StringBuilder.new")
    }

    /// Create the default string builder.
    static default(): StringBuilder {
        StringBuilder.new()
    }
}

extension of String implements Borrow<StringView> {
    /// Borrow this string as UTF-8 text.
    borrow(this: &readonly String): &readonly StringView {
        todo("String.borrow")
    }
}

extension of StringView implements ToOwned {
    /// The owned value type.
    type Owned = String;

    /// Copy this view into an owned string.
    toOwned(this: &readonly StringView): String {
        todo("StringView.toOwned")
    }
}
