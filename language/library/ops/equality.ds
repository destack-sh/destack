/// Interface for partial equality.
///
/// `a == b` becomes `a.equal(b)`.
/// `a != b` becomes `!a.equal(b)`.
///
/// Some values, like floating-point NaN, do not have total equality.
@languageItem("ops.PartialEqual")
export newtype interface PartialEqual<T = this> {
    equal(other: T): boolean;
}

/// Marker interface for total equality.
@languageItem("ops.Equal")
export newtype interface Equal<T = this> extends PartialEqual<T> {}
