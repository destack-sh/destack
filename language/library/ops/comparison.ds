/// Result of a comparison operation.
///
/// Used by the `Compare` interface.
@languageItem("Ordering")
export const enum Ordering {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

/// Interface for comparison operators (`<`, `<=`, `>`, `>=`) and ordering.
///
/// `a < b` becomes `a.compare(b) == Ordering.Less`.
/// `a <= b` becomes `a.compare(b) != Ordering.Greater`.
/// `a > b` becomes `a.compare(b) == Ordering.Greater`.
/// `a >= b` becomes `a.compare(b) != Ordering.Less`.
///
/// Types that implement `Compare` should also implement `Equal` for consistency.
@languageItem("Compare")
export newtype interface Compare<T = this> {
    compare(other: T): Ordering;
}

/// Interface for partial comparison (when comparison might fail).
///
/// Some types (like floats with NaN) cannot always be compared.
/// `partialCompare` returns `null` when comparison is undefined.
///
/// `a < b` for PartialCompare types:
/// - If `a.partialCompare(b)` is `null`, result is `false`
/// - Otherwise, checks if result is `Ordering.Less`
@languageItem("PartialCompare")
export newtype interface PartialCompare<T = this> {
    partialCompare(other: T): Ordering | null;
}
