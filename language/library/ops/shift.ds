/// Interface for the `<<` operator.
///
/// `a << b` becomes `a.shiftLeft(b)`.
@languageItem("ops.ShiftLeft")
export newtype interface ShiftLeft<T = this> {
    /// The result type.
    type Output;

    /// Shift this value left by `other`.
    shiftLeft(other: T): this.Output;
}

/// Interface for the `>>` operator.
///
/// `a >> b` becomes `a.shiftRight(b)`.
@languageItem("ops.ShiftRight")
export newtype interface ShiftRight<T = this> {
    /// The result type.
    type Output;

    /// Shift this value right by `other`.
    shiftRight(other: T): this.Output;
}

/// Interface for the `>>>` operator.
///
/// `a >>> b` becomes `a.shiftRightUnsigned(b)`.
@languageItem("ops.ShiftRightUnsigned")
export newtype interface ShiftRightUnsigned<T = this> {
    /// The result type.
    type Output;

    /// Shift this value right by `other`, shifting zeros in from the left.
    shiftRightUnsigned(other: T): this.Output;
}
