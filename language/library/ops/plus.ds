/// Interface for the `+` operator.
///
/// `a + b` becomes `a.add(b)`.
@languageItem("Add")
export newtype interface Add<T = this> {
    /// The result type.
    type Output;

    /// Add `other` to this value.
    add(other: T): this.Output;
}

/// Interface for unary `+`.
///
/// `+a` becomes `a.plus()`.
@languageItem("Plus")
export newtype interface Plus {
    /// The result type.
    type Output;

    /// Return this value through unary plus.
    plus(): this.Output;
}
