import { type Iterable } from "../iterator/index.ds";
import { queueMicrotask } from "./continuation.ds";

/// Function that resolves a promise.
export type PromiseResolve<T> = (value: T | Promise<T>) => void;

/// Function that rejects a promise.
export type PromiseReject = (reason?: unknown) => void;

/// Function that starts a promise.
export type PromiseExecutor<T> = (resolve: PromiseResolve<T>, reject: PromiseReject) => void;

/// Pending promise state.
export interface PromisePending<T> {
    kind: "pending";
    reactions: PromiseReaction<T>[];
}

/// Fulfilled promise state.
export interface PromiseFulfilled<T> {
    kind: "fulfilled";
    value: T;
}

/// Rejected promise state.
export interface PromiseRejected {
    kind: "rejected";
    reason: unknown;
}

/// Current promise state.
export type PromiseState<T> = PromisePending<T> | PromiseFulfilled<T> | PromiseRejected;

/// Promise continuation callbacks.
export interface PromiseReaction<T> {
    onFulfilled: (value: T) => void;
    onRejected: (error: unknown) => void;
}

/// Fulfilled `Promise.allSettled` result.
export interface PromiseFulfilledResult<T> {
    status: "fulfilled";
    value: T;
}

/// Rejected `Promise.allSettled` result.
export interface PromiseRejectedResult {
    status: "rejected";
    reason: unknown;
}

/// Settled promise result.
export type PromiseSettledResult<T> = PromiseFulfilledResult<T> | PromiseRejectedResult;

/// Worker-local async result object.
export class Promise<T> {
    private state: PromiseState<T> = { kind: "pending", reactions: [] };

    /// Create a promise from an executor.
    constructor(executor: PromiseExecutor<T>) {
        try {
            executor(
                (value) => this.fulfill(value),
                (reason) => this.reject(reason),
            )
        } catch (error) {
            this.reject(error)
        }
    }

    /// Continue when the promise fulfills.
    then<U, F = never>(
        onFulfilled: (value: T) => U | Promise<U>,
        onRejected?: (error: unknown) => F | Promise<F>,
    ): Promise<U | F> {
        new Promise<U | F>((resolve, reject) => {
            this.react({
                onFulfilled: (value) => {
                    try {
                        resolve(onFulfilled(value))
                    } catch (error) {
                        reject(error)
                    }
                },
                onRejected: (error) => {
                    if (onRejected == undefined) {
                        reject(error)
                    } else {
                        try {
                            resolve(onRejected(error))
                        } catch (error) {
                            reject(error)
                        }
                    }
                },
            })
        })
    }

    /// Continue when the promise rejects.
    catch<U>(onRejected: (error: unknown) => U | Promise<U>): Promise<T | U> {
        this.then((value) => value, onRejected)
    }

    /// Continue when the promise settles.
    finally(onFinally: () => void | Promise<void>): Promise<T> {
        this.then(
            (value) => Promise.resolve(onFinally()).then(() => value),
            (error) => Promise.resolve(onFinally()).then(() => Promise.reject(error)),
        )
    }

    /// Create a fulfilled promise.
    static resolve<T>(value: T | Promise<T>): Promise<T> {
        new Promise<T>((resolve) => resolve(value))
    }

    /// Create a rejected promise.
    static reject<T = never>(reason?: unknown): Promise<T> {
        new Promise<T>((_, reject) => reject(reason))
    }

    /// Wait for all promises.
    static all<T>(values: Iterable<T | Promise<T>>): Promise<T[]> {
        new Promise<T[]>((resolve, reject) => {
            const results: T[] = [];
            let remaining = 0;
            let index = 0;

            for (const value of values) {
                const current = index;
                index += 1;
                remaining += 1;

                Promise.resolve(value).then(
                    (item) => {
                        results[current] = item;
                        remaining -= 1;
                        if (remaining == 0) {
                            resolve(results)
                        }
                    },
                    reject,
                )
            }

            if (remaining == 0) {
                resolve(results)
            }
        })
    }

    /// Wait for the first settled promise.
    static race<T>(values: Iterable<T | Promise<T>>): Promise<T> {
        new Promise<T>((resolve, reject) => {
            for (const value of values) {
                Promise.resolve(value).then(resolve, reject)
            }
        })
    }

    /// Wait for all promises and keep fulfillment or rejection.
    static allSettled<T>(values: Iterable<T | Promise<T>>): Promise<PromiseSettledResult<T>[]> {
        new Promise<PromiseSettledResult<T>[]>((resolve) => {
            const results: PromiseSettledResult<T>[] = [];
            let remaining = 0;
            let index = 0;

            for (const value of values) {
                const current = index;
                index += 1;
                remaining += 1;

                Promise.resolve(value).then(
                    (item) => {
                        results[current] = { status: "fulfilled", value: item };
                        remaining -= 1;
                        if (remaining == 0) {
                            resolve(results)
                        }
                    },
                    (reason) => {
                        results[current] = { status: "rejected", reason };
                        remaining -= 1;
                        if (remaining == 0) {
                            resolve(results)
                        }
                    },
                )
            }

            if (remaining == 0) {
                resolve(results)
            }
        })
    }

    /// Resolve this promise.
    private fulfill(value: T | Promise<T>): void {
        if (value is Promise<T>) {
            value.then(
                (inner) => this.fulfillValue(inner),
                (error) => this.reject(error),
            )
        } else {
            this.fulfillValue(value as T)
        }
    }

    /// Resolve this promise with a plain value.
    private fulfillValue(value: T): void {
        if (this.state.kind != "pending") {
            return
        }

        const reactions = this.state.reactions;
        this.state = { kind: "fulfilled", value };

        for (const reaction of reactions) {
            queueMicrotask(() => reaction.onFulfilled(value))
        }
    }

    /// Reject this promise.
    private reject(reason?: unknown): void {
        if (this.state.kind != "pending") {
            return
        }

        const reactions = this.state.reactions;
        this.state = { kind: "rejected", reason };

        for (const reaction of reactions) {
            queueMicrotask(() => reaction.onRejected(reason))
        }
    }

    /// Attach one reaction.
    private react(reaction: PromiseReaction<T>): void {
        match (this.state) {
            { kind: "pending", reactions } => reactions.push(reaction)
            { kind: "fulfilled", value } => queueMicrotask(() => reaction.onFulfilled(value))
            { kind: "rejected", reason } => queueMicrotask(() => reaction.onRejected(reason))
        }
    }
}

/// Constructor and static helpers for promises.
export type PromiseConstructor = typeof Promise;
