/// Marks something as an external symbol.
///
/// ```
/// @extern("C")
/// function oldAPI() { }
/// ```
export newtype extern = (string,) | ();

/// Marks something as deprecated.
///
/// Emits a compile-time warning when the declaration is used.
/// The message is included in the warning and accessible at runtime.
///
/// ```
/// @deprecated("use newAPI instead")
/// function oldAPI() { }
/// ```
export newtype deprecated = (string,) | ();

/// Marks something as experimental or unstable.
///
/// ```
/// @experimental
/// function newFeature() { }
/// ```
export newtype experimental = (string,) | ();

/// Tag a value or expression.
///
/// Tags are used for general purpose metadata when more specific decorators are not available.
///
/// ```
/// @tag("user")
/// function oldAPI() { }
/// ```
export newtype tag = (string,) | ();
