import {
    type Declaration,
    type Expression,
    type Node,
    type Scope,
    type Symbol,
} from "../../reflect/dir/index.ds";

/// Context passed to patch providers.
export struct PatchContext {
    /// The decorated target symbol.
    symbol: Symbol;

    /// The containing scope.
    scope: Scope;

    /// The local name of the decorated target when one exists.
    name?: string;
}

/// Patch that adds a generated declaration.
export newtype PatchAdd = {
    kind: "add";
    scope: Scope;
    declaration: Declaration;
};

/// Patch that replaces one symbol with a generated declaration.
export newtype PatchReplace = {
    kind: "replace";
    symbol: Symbol;
    declaration: Declaration;
};

/// Patch that renames one symbol.
export newtype PatchRename = {
    kind: "rename";
    symbol: Symbol;
    name: string;
};

/// Patch that removes one symbol.
export newtype PatchRemove = {
    kind: "remove";
    symbol: Symbol;
};

/// Patch that replaces a function or method body.
export newtype PatchBody = {
    kind: "body";
    symbol: Symbol;
    body: Expression;
};

/// Patch that replaces one expression.
export newtype PatchExpression = {
    kind: "expression";
    target: Expression;
    value: Expression;
};

/// Patch that removes an already declared node from a checked shape.
export newtype PatchRemoveNode = {
    kind: "remove-node";
    target: Node;
};

/// One declaration expansion patch operation.
export newtype ExpandPatch =
    | PatchAdd
    | PatchReplace
    | PatchRename
    | PatchRemove;

extension of Patch {
    /// Create an expansion add patch.
    static add(input: { scope: Scope; declaration: Declaration }): ExpandPatch {
        ExpandPatch(PatchAdd({
            kind: "add",
            scope: input.scope,
            declaration: input.declaration,
        }))
    }

    /// Create an expansion replace patch.
    static replace(input: { symbol: Symbol; declaration: Declaration }): ExpandPatch {
        ExpandPatch(PatchReplace({
            kind: "replace",
            symbol: input.symbol,
            declaration: input.declaration,
        }))
    }

    /// Create an expansion rename patch.
    static rename(input: { symbol: Symbol; name: string }): ExpandPatch {
        ExpandPatch(PatchRename({
            kind: "rename",
            symbol: input.symbol,
            name: input.name,
        }))
    }

    /// Create an expansion remove patch.
    static remove(input: { symbol: Symbol }): ExpandPatch {
        ExpandPatch(PatchRemove({
            kind: "remove",
            symbol: input.symbol,
        }))
    }
}

/// Protocol for decorator values that provide static patches.
export newtype interface Patcher<Target> {
    /// Return declaration expansion patches for the decorated target.
    static expand(target: Target, context: PatchContext, config: this): Patch[];

    /// Return checked materialization patches for the decorated target.
    static materialize(target: Target, context: PatchContext, config: this): Patch[];
}
