import {
    type Declaration,
    type Member,
    type Scope,
    type Symbol,
} from "../../reflect/dir/index.ds";

/// Shared context passed to macro providers.
export interface PatchContext {
    /// The decorated target symbol.
    readonly symbol: Symbol;

    /// The containing scope.
    readonly scope: Scope;

    /// The local name of the decorated target when one exists.
    readonly name?: string;
}

/// Context for declaration expansion.
export interface ExpansionContext extends PatchContext {
    /// Add a generated declaration to the current scope.
    add(declaration: Declaration): void;

    /// Add a generated child to the decorated declaration.
    addChild(child: Member): void;

    /// Replace the decorated symbol with a generated declaration.
    replace(declaration: Declaration): void;

    /// Rename the decorated symbol.
    rename(name: string): void;

    /// Remove the decorated symbol from the visible declaration set.
    remove(): void;
}

/// Context for checked implementation materialization.
export interface MaterializationContext extends PatchContext {
    /// Replace the decorated declaration with a checked generated declaration.
    replace(declaration: Declaration): void;
}

/// Protocol for decorator values that provide macro behavior.
export newtype interface Patcher<Target> {
    /// Expand declarations for the decorated target.
    static expand(target: Target, context: ExpansionContext, config: this): void;

    /// Materialize checked implementation details for the decorated target.
    static materialize(target: Target, context: MaterializationContext, config: this): void;
}
