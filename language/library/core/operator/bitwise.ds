/// Interface for the `&` operator.
///
/// `a & b` becomes `a.and(b)`.
export newtype interface And<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise AND.
    and(other: T): this.Output;
}

/// Interface for the `|` operator.
///
/// `a | b` becomes `a.or(b)`.
export newtype interface Or<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise OR.
    or(other: T): this.Output;
}

/// Interface for the `^` operator.
///
/// `a ^ b` becomes `a.xor(b)`.
export newtype interface Xor<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise XOR.
    xor(other: T): this.Output;
}

/// Interface for the `~` operator.
///
/// `~a` becomes `a.not()`.
export newtype interface Not {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise NOT.
    not(): this.Output;
}
