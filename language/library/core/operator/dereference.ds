import { type Access, type WithAccess } from "../../memory/index.ds";

/// Interface for dereference projection `*a`.
///
/// `A` selects the access form required by the operator use.
export newtype interface Dereference<A: Access = "readonly"> {
    /// The projected target form.
    type Output;

    /// Project the receiver into the requested access form.
    dereference(): WithAccess<this.Output, A>;
}
