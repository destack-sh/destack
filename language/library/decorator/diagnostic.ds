/// Diagnostic selector string.
export type DiagnosticSelector = string;

/// Diagnostic control fallback.
export type DiagnosticFallback = "allow" | "warn" | "deny" | "forbid";

/// Options for scoped diagnostic controls.
export type DiagnosticControlOptions = {
    /// Reason shown next to the diagnostic control.
    reason?: string;
    /// Static condition that enables the control.
    if?: boolean;
    /// Control applied when `if` is false.
    otherwise?: DiagnosticFallback;
};

/// Allow a diagnostic.
///
/// ```
/// @allow("no-floating-promises", { if: import.meta.dev, otherwise: "deny" })
/// function oldAPI() { }
/// ```
@languageItem("decorator.allow")
export newtype allow = (DiagnosticSelector,) | (DiagnosticSelector, DiagnosticControlOptions);

/// Warn on a diagnostic.
///
/// ```
/// @warn("no-floating-promises")
/// function oldAPI() { }
/// ```
@languageItem("decorator.warn")
export newtype warn = (DiagnosticSelector,) | (DiagnosticSelector, DiagnosticControlOptions);

/// Deny a diagnostic with an error.
///
/// ```
/// @deny("no-floating-promises")
/// function oldAPI() { }
/// ```
@languageItem("decorator.deny")
export newtype deny = (DiagnosticSelector,) | (DiagnosticSelector, DiagnosticControlOptions);

/// Forbid some diagnostic.
///
/// ```
/// @forbid("unsafe-code")
/// function oldAPI() { }
/// ```
@languageItem("decorator.forbid")
export newtype forbid = (DiagnosticSelector,) | (DiagnosticSelector, DiagnosticControlOptions);

/// Expect a diagnostic.
///
/// ```
/// @expect("no-floating-promises", { reason: "intentional fire-and-forget" })
/// function oldAPI() { }
/// ```
@languageItem("decorator.expect")
export newtype expect = (DiagnosticSelector,) | (DiagnosticSelector, DiagnosticControlOptions);
