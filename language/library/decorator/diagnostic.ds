/// Allow some diagnostic.
///
/// ```
/// @allow(E001)
/// function oldAPI() { }
/// ```
@languageItem("decorator.allow")
export newtype allow = (string,) | ();

/// Warn on some diagnostic.
///
/// ```
/// @warn(E001)
/// function oldAPI() { }
/// ```
@languageItem("decorator.warn")
export newtype warn = (string,) | ();

/// Deny some diagnostic with an error.
///
/// ```
/// @deny(E001)
/// function oldAPI() { }
/// ```
@languageItem("decorator.deny")
export newtype deny = (string,) | ();

/// Forbid some diagnostic.
///
/// ```
/// @forbid(E001)
/// function oldAPI() { }
/// ```
@languageItem("decorator.forbid")
export newtype forbid = (string,) | ();

/// Expect some diagnostic.
///
/// ```
/// @expect(E001)
/// function oldAPI() { }
/// ```
@languageItem("decorator.expect")
export newtype expect = (string,) | ();
