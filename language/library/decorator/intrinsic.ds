/// Compiler intrinsic marker.
///
/// Marks a declaration as implemented by the compiler.
/// The declaration body, if any, is ignored.
///
/// ```
/// @intrinsic
/// declare function typeOf<T>(value: T): Type<T>;
/// ```
@languageItem("decorator.intrinsic")
export newtype intrinsic = (string,) | ();

/// Compiler language item marker.
///
/// Marks a declaration as a compiler-known language item.
/// `@intrinsic` controls implementation, while `@languageItem` gives the toolchain a stable symbol identity.
/// A declaration may use either marker or both.
/// Language item keys use the exported stdlib module name and the declaration name.
///
/// ```
/// @languageItem("memory.Unique")
/// export newtype Unique<T> = intrinsic;
/// ```
@languageItem("decorator.languageItem")
export newtype languageItem = (string,) | ();
