/// Taint label carried by a value.
export type TaintTag = string;

/// Boundary domain where tainted data enters or leaves.
export type TaintDomain = string;

/// Options for source boundaries.
export type SourceOptions = {
    /// Taints created by the source.
    taints: TaintTag[];
};

/// Options for untaint boundaries.
export type UntaintOptions = {
    /// Taints removed for the boundary domain.
    removes: TaintTag[];
};

/// Options for sink boundaries.
export type SinkOptions = {
    /// Taints rejected by the sink.
    rejects: TaintTag[];
};

/// Marks data as carrying one taint.
///
/// ```ds
/// function input(): @taint("untrusted") string;
/// ```
@languageItem("decorator.taint")
export newtype taint = (TaintTag,) | ();

/// Marks a declaration as removing taints for one boundary domain.
///
/// ```ds
/// @untaint("html", { removes: ["untrusted"] })
/// function escapeHtml(value: string): string;
/// ```
@languageItem("decorator.untaint")
export newtype untaint = (TaintDomain, UntaintOptions) | (TaintDomain,) | ();

/// Marks a declaration as a boundary where tainted data enters.
///
/// ```ds
/// @source("http.request", { taints: ["untrusted"] })
/// function body(request: Request): string;
/// ```
@languageItem("decorator.source")
export newtype source = (TaintDomain, SourceOptions) | (TaintDomain,) | ();

/// Marks a declaration as a boundary where tainted data leaves.
///
/// ```ds
/// @sink("html", { rejects: ["untrusted"] })
/// function setInnerHtml(value: string): void;
/// ```
@languageItem("decorator.sink")
export newtype sink = (TaintDomain, SinkOptions) | (TaintDomain,) | ();

/// Marks an API, expression, or block as crossing an unsafe boundary.
///
/// ```ds
/// @unsafe
/// declare function read<T>(pointer: *T): ^T;
/// ```
@languageItem("decorator.unsafe")
export newtype unsafe = (string,) | ();

/// Marks a declaration as containing unsafe implementation details behind a safe API.
///
/// ```ds
/// @safe
/// function get<T>(items: Slice<T>, index: usize): T;
/// ```
@languageItem("decorator.safe")
export newtype safe = (string,) | ();
