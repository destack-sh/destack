/// Marks data as belonging to a taint domain.
///
/// ```ds
/// @taint("url")
/// const target = input;
/// ```
@languageItem("Taint")
export newtype taint = (string,) | ();

/// Marks a declaration as consuming tainted data.
///
/// ```ds
/// @sink("url")
/// function redirect(value: string): void;
/// ```
@languageItem("Sink")
export newtype sink = (string,) | ();

/// Marks a declaration as sanitizing tainted data.
///
/// ```ds
/// @sanitizer("url")
/// function sanitizeUrl(value: string): string;
/// ```
@languageItem("Sanitizer")
export newtype sanitizer = (string,) | ();

/// Marks a declaration or expression as requiring unsafe authority.
@languageItem("Unsafe")
export newtype unsafe = (string,) | ();

/// Allows unsafe operations inside the annotated scope.
export newtype allowUnsafe = (string,) | ();

/// Marks a declaration as safely encapsulating unsafe implementation details.
export newtype trusted = (string,) | ();
