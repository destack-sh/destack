import { AsyncResult } from "destack:error";
import { HostError } from "destack:error/host";
import { AddressLookupQuery, AddressLookupResult, SocketAddress, SocketFamily, SocketHandle, SocketMessageFlags, SocketReceiveFromResult } from "destack:net/host";

/// Owned stream socket.
export struct Connection {
    /// Host socket handle.
    handle: SocketHandle;
}

/// Owned stream listener.
export struct Listener {
    /// Host listener socket handle.
    handle: SocketHandle;
}

/// Owned datagram socket.
export struct DatagramSocket {
    /// Host socket handle.
    handle: SocketHandle;
}

/// Stream listen options.
export struct ListenOptions {
    /// Local address.
    address: SocketAddress;
    /// Pending connection backlog.
    backlog: uint32;
}

/// Stream connect options.
export struct ConnectOptions {
    /// Remote address.
    address: SocketAddress;
}

/// Datagram socket options.
export struct DatagramOptions {
    /// Socket address family.
    family: SocketFamily;
    /// Local address to bind when present.
    address?: SocketAddress;
}

/// Open one stream connection.
export declare function connect(options: ConnectOptions): AsyncResult<Connection, HostError>;

/// Listen for stream connections.
export declare function listen(options: ListenOptions): AsyncResult<Listener, HostError>;

/// Open one datagram socket.
export declare function openDatagram(
    options: DatagramOptions,
): AsyncResult<DatagramSocket, HostError>;

/// Accept one stream connection.
export declare function accept(listener: &Listener): AsyncResult<Connection, HostError>;

/// Close one stream connection.
export declare function close(connection: ^Connection): AsyncResult<void, HostError>;

/// Close one stream listener.
export declare function closeListener(listener: ^Listener): AsyncResult<void, HostError>;

/// Close one datagram socket.
export declare function closeDatagram(socket: ^DatagramSocket): AsyncResult<void, HostError>;

/// Read from one stream connection.
export declare function read(
    connection: &Connection,
    buffer: &[uint8],
): AsyncResult<uint64, HostError>;

/// Write to one stream connection.
export declare function write(
    connection: &Connection,
    buffer: &readonly [uint8],
): AsyncResult<uint64, HostError>;

/// Receive one datagram from a socket.
export declare function receiveFrom(
    socket: &DatagramSocket,
    buffer: &[uint8],
    flags: SocketMessageFlags,
): AsyncResult<SocketReceiveFromResult, HostError>;

/// Send one datagram to a remote endpoint.
export declare function sendTo(
    socket: &DatagramSocket,
    address: SocketAddress,
    buffer: &readonly [uint8],
    flags: SocketMessageFlags,
): AsyncResult<uint64, HostError>;

/// Resolve a host and service.
export declare function lookup(
    query: AddressLookupQuery,
): AsyncResult<^Array<AddressLookupResult>, HostError>;
