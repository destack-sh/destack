import { Slice } from "core";
import * as platform from "library/platform/index.ds";
import type { PlatformError } from "../error/index.ds";
import { ListenerHandle, SocketHandle } from "../resource/index.ds";

/// Connect to a remote host and return a socket handle.
export function connect(host: string, port: uint16): Result<SocketHandle, PlatformError> {
    platform.net.connect(host, port);
}

/// Start listening on the given address.
export function listen(
    host: string,
    port: uint16,
    backlog: uint32,
): Result<ListenerHandle, PlatformError> {
    platform.net.listen(host, port, backlog);
}

/// Accept a new connection from a listener.
export function accept(listener: ListenerHandle): Result<SocketHandle, PlatformError> {
    platform.net.accept(listener);
}

/// Close a socket handle.
export function close(handle: SocketHandle): Result<void, PlatformError> {
    platform.net.close(handle);
}

/// Read from a socket into the provided slice.
export function read(
    handle: SocketHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError> {
    platform.net.read(handle, buffer);
}

/// Write to a socket from the provided slice.
export function write(
    handle: SocketHandle,
    buffer: Slice<uint8>,
): Result<uint64, PlatformError> {
    platform.net.write(handle, buffer);
}
