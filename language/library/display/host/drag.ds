import { ResourceId } from "destack:runtime/resource";
import { Array, PackedArray } from "destack:collections";
import { HostError } from "destack:error/host";
import { Path } from "destack:fs/host";
import { WindowPoint } from "./window.ds";
import { WindowHandle } from "destack:display/host";

/// Handle for one display drag-transfer session.
export newtype DisplayDragSessionHandle = ResourceId;

/// Drag operation.
export enum DisplayDragOperation {
    /// No accepted operation.
    None = 1,
    /// Copy the dragged payload.
    Copy = 2,
    /// Move the dragged payload.
    Move = 3,
    /// Link to the dragged payload.
    Link = 4,
}

/// Drag operation flags.
export newtype DisplayDragOperationFlags = uint32;

/// No drag operations.
export const DISPLAY_DRAG_NONE: DisplayDragOperationFlags = DisplayDragOperationFlags(0x0);

/// Copy drag operation.
export const DISPLAY_DRAG_COPY: DisplayDragOperationFlags = DisplayDragOperationFlags(0x1);

/// Move drag operation.
export const DISPLAY_DRAG_MOVE: DisplayDragOperationFlags = DisplayDragOperationFlags(0x2);

/// Link drag operation.
export const DISPLAY_DRAG_LINK: DisplayDragOperationFlags = DisplayDragOperationFlags(0x4);

/// Drag item kind.
export enum DisplayDragItemKind {
    /// Text payload.
    Text = 1,
    /// Filesystem payload.
    File = 2,
    /// Binary payload.
    Binary = 3,
}

/// Drag item descriptor.
export struct DisplayDragItem {
    /// Item kind.
    kind: DisplayDragItemKind;
    /// MIME type or platform-native type.
    itemType?: string;
    /// Suggested display name.
    name?: string;
    /// Whether a file item refers to one directory.
    isDirectory: boolean;
    /// Payload length in bytes.
    byteLength?: uint64;
}

/// Inbound drag transfer.
export struct DisplayDragTransfer {
    /// Drag session handle.
    session: DisplayDragSessionHandle;
    /// Whether the transfer originated outside the runtime.
    isExternal: boolean;
    /// Offered operations.
    operations: DisplayDragOperationFlags;
    /// Host-proposed operation.
    proposedOperation?: DisplayDragOperation;
    /// Position inside the window.
    position?: WindowPoint;
    /// Offered items.
    items: Array<DisplayDragItem>;
}

/// Source side drag preview.
export struct DisplayDragPreview {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
    /// RGBA8 pixel bytes.
    rgba: Array<uint8>;
    /// Cursor hotspot x coordinate in pixels.
    hotspotX: int32;
    /// Cursor hotspot y coordinate in pixels.
    hotspotY: int32;
}

/// Source side drag text item.
export struct DisplayDragSourceItemText {
    /// Item discriminator.
    kind: "text";
    /// MIME type or host-native item type.
    itemType?: string;
    /// Suggested display name.
    name?: string;
    /// Text payload.
    text: string;
}

/// Source side drag file item.
export struct DisplayDragSourceItemFile {
    /// Item discriminator.
    kind: "file";
    /// Suggested display name.
    name?: string;
    /// Filesystem payload.
    path: Path;
}

/// Source side drag binary item.
export struct DisplayDragSourceItemBinary {
    /// Item discriminator.
    kind: "binary";
    /// MIME type or host-native item type.
    itemType: string;
    /// Suggested display name.
    name?: string;
    /// Byte payload.
    bytes: Array<uint8>;
}

/// Source side drag item.
export newtype DisplayDragSourceItem =
    | DisplayDragSourceItemText
    | DisplayDragSourceItemFile
    | DisplayDragSourceItemBinary;

/// Source side drag request.
export struct DisplayDragRequest {
    /// Source window.
    window?: WindowHandle;
    /// Offered operations.
    operations: DisplayDragOperationFlags;
    /// Drag items.
    items: Array<DisplayDragSourceItem>;
    /// Starting position inside the window.
    position?: WindowPoint;
    /// Optional preview image.
    preview?: DisplayDragPreview;
}

/// Read one drag text item.
@binding("destack.display.drag.text.read", {
    effect: "external",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readDragText(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<^string, HostError>;

/// Read one drag binary item.
@binding("destack.display.drag.bytes.read", {
    effect: "external",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readDragBytes(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<PackedArray<uint8>, HostError>;

/// Read one drag filesystem item.
@binding("destack.display.drag.path.read", {
    effect: "external",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readDragPath(
    session: DisplayDragSessionHandle,
    itemIndex: uint32,
): Result<Path, HostError>;

/// Accept one drag operation.
@binding("destack.display.drag.accept", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function acceptDrag(
    session: DisplayDragSessionHandle,
    operation: DisplayDragOperation,
): Result<void, HostError>;

/// Close one drag session.
@binding("destack.display.drag.close", {
    effect: "external",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function closeDrag(session: DisplayDragSessionHandle): Result<void, HostError>;

/// Begin one source side drag session.
@binding("destack.display.drag.begin", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.display.drag"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function beginDrag(
    request: &readonly DisplayDragRequest,
): Result<DisplayDragOperation, HostError>;
