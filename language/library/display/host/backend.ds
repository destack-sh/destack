import { Array } from "destack:collections";
import { HostBackendStatus } from "destack:runtime/binding";
import { HostError } from "destack:error/host";

/// Host display backend kind.
export enum DisplayBackendKind {
    /// Use the host-preferred backend.
    Auto = 0,
    /// Wayland compositor backend.
    Wayland = 1,
    /// X11 window system backend.
    X11 = 2,
    /// Win32 window system backend.
    Win32 = 3,
    /// Apple AppKit backend.
    AppKit = 4,
    /// Deterministic runtime simulation backend.
    Simulation = 250,
    /// Silent test backend.
    Null = 255,
}

/// Display backend selection policy.
export enum DisplayBackendSelectionPolicy {
    /// Use another backend when the requested backend is unavailable.
    Fallback = 1,
    /// Fail unless the requested backend is available.
    Exact = 2,
}

/// Display backend selection.
export struct DisplayBackendSelection {
    /// Requested backend.
    backend: DisplayBackendKind;
    /// Selection behavior.
    policy: DisplayBackendSelectionPolicy;
}

/// Display backend capability flags.
export newtype DisplayBackendFlags = uint64;

/// Backend can enumerate monitors.
export const DISPLAY_BACKEND_MONITOR: DisplayBackendFlags = DisplayBackendFlags(0x01);

/// Backend can report monitor change events.
export const DISPLAY_BACKEND_MONITOR_EVENTS: DisplayBackendFlags = DisplayBackendFlags(0x02);

/// Backend can create windows.
export const DISPLAY_BACKEND_WINDOW: DisplayBackendFlags = DisplayBackendFlags(0x04);

/// Backend can report window events.
export const DISPLAY_BACKEND_WINDOW_EVENTS: DisplayBackendFlags = DisplayBackendFlags(0x08);

/// Backend can drive frame timing streams.
export const DISPLAY_BACKEND_FRAME_TIMING: DisplayBackendFlags = DisplayBackendFlags(0x10);

/// Backend can start host drag sessions.
export const DISPLAY_BACKEND_DRAG: DisplayBackendFlags = DisplayBackendFlags(0x20);

/// Backend can enter exclusive fullscreen modes.
export const DISPLAY_BACKEND_EXCLUSIVE_FULLSCREEN: DisplayBackendFlags =
    DisplayBackendFlags(0x40);

/// Backend can report or set HDR output policy.
export const DISPLAY_BACKEND_HDR: DisplayBackendFlags = DisplayBackendFlags(0x80);

/// Backend can set monitor gamma ramps.
export const DISPLAY_BACKEND_GAMMA: DisplayBackendFlags = DisplayBackendFlags(0x100);

/// Backend can constrain or lock the pointer.
export const DISPLAY_BACKEND_POINTER_GRAB: DisplayBackendFlags = DisplayBackendFlags(0x200);

/// Display backend.
export struct DisplayBackend {
    /// Backend kind.
    backend: DisplayBackendKind;
    /// Host availability status.
    status: HostBackendStatus;
    /// Display name.
    name: string;
    /// Selection priority for `DisplayBackendKind.Auto`.
    priority: uint16;
    /// Backend capability flags.
    flags: DisplayBackendFlags;
}

/// List host display backends.
@binding("destack.display.backend.list", {
    effect: "external",
    requires: ["host.display.backend"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function listDisplayBackends(): Result<Array<DisplayBackend>, HostError>;
