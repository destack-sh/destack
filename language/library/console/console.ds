import { Result } from "destack:error";
import { todo } from "destack:error";
import { Writer } from "destack:sync";
import { HostError } from "destack:error/host";

/// Console output options.
export interface ConsoleOptions {
    /// Stream used for regular output.
    stdout?: Writer;

    /// Stream used for diagnostic output.
    stderr?: Writer;

    /// Whether values should be formatted with color when supported.
    color?: boolean | "auto";
}

/// Debugging console.
export class Console {
    /// Create a console from output streams.
    constructor(options?: ConsoleOptions) {
        todo("Console.constructor")
    }

    /// Write a line to stdout.
    log(...values: unknown[]): Result<void, HostError> {
        todo("Console.log")
    }

    /// Write an info line to stdout.
    info(...values: unknown[]): Result<void, HostError> {
        todo("Console.info")
    }

    /// Write a debug line to stdout.
    debug(...values: unknown[]): Result<void, HostError> {
        todo("Console.debug")
    }

    /// Write a warning line to stderr.
    warn(...values: unknown[]): Result<void, HostError> {
        todo("Console.warn")
    }

    /// Write an error line to stderr.
    error(...values: unknown[]): Result<void, HostError> {
        todo("Console.error")
    }

    /// Write the current stack trace to stderr.
    trace(...values: unknown[]): Result<void, HostError> {
        todo("Console.trace")
    }

    /// Write an assertion failure when `condition` is false.
    assert(condition: boolean, ...values: unknown[]): Result<void, HostError> {
        todo("Console.assert")
    }

    /// Start a named timer.
    time(label?: string): Result<void, HostError> {
        todo("Console.time")
    }

    /// Write and stop a named timer.
    timeEnd(label?: string): Result<void, HostError> {
        todo("Console.timeEnd")
    }

    /// Write a named timer without stopping it.
    timeLog(label?: string, ...values: unknown[]): Result<void, HostError> {
        todo("Console.timeLog")
    }

    /// Increase output indentation.
    group(...values: unknown[]): Result<void, HostError> {
        todo("Console.group")
    }

    /// Increase output indentation for a collapsed group.
    groupCollapsed(...values: unknown[]): Result<void, HostError> {
        todo("Console.groupCollapsed")
    }

    /// Decrease output indentation.
    groupEnd(): Result<void, HostError> {
        todo("Console.groupEnd")
    }

    /// Write tabular data.
    table(value: unknown): Result<void, HostError> {
        todo("Console.table")
    }
}

/// Return the default process console.
export function defaultConsole(): Console {
    todo("console.default")
}

/// Write a line to stdout.
export function log(...values: unknown[]): Result<void, HostError> {
    defaultConsole().log(...values)
}

/// Write an info line to stdout.
export function info(...values: unknown[]): Result<void, HostError> {
    defaultConsole().info(...values)
}

/// Write a debug line to stdout.
export function debug(...values: unknown[]): Result<void, HostError> {
    defaultConsole().debug(...values)
}

/// Write a warning line to stderr.
export function warn(...values: unknown[]): Result<void, HostError> {
    defaultConsole().warn(...values)
}

/// Write an error line to stderr.
export function error(...values: unknown[]): Result<void, HostError> {
    defaultConsole().error(...values)
}

/// Write the current stack trace to stderr.
export function trace(...values: unknown[]): Result<void, HostError> {
    defaultConsole().trace(...values)
}

/// Write an assertion failure when `condition` is false.
export function assert(condition: boolean, ...values: unknown[]): Result<void, HostError> {
    defaultConsole().assert(condition, ...values)
}

/// Start a named timer.
export function time(label?: string): Result<void, HostError> {
    defaultConsole().time(label)
}

/// Write and stop a named timer.
export function timeEnd(label?: string): Result<void, HostError> {
    defaultConsole().timeEnd(label)
}

/// Write a named timer without stopping it.
export function timeLog(label?: string, ...values: unknown[]): Result<void, HostError> {
    defaultConsole().timeLog(label, ...values)
}

/// Increase output indentation.
export function group(...values: unknown[]): Result<void, HostError> {
    defaultConsole().group(...values)
}

/// Increase output indentation for a collapsed group.
export function groupCollapsed(...values: unknown[]): Result<void, HostError> {
    defaultConsole().groupCollapsed(...values)
}

/// Decrease output indentation.
export function groupEnd(): Result<void, HostError> {
    defaultConsole().groupEnd()
}

/// Write tabular data.
export function table(value: unknown): Result<void, HostError> {
    defaultConsole().table(value)
}
