import { todo } from "destack:error";

/// Debug formatting options.
export struct FormatOptions {
    /// Maximum depth for recursive formatting.
    depth?: uint32 | null;

    /// Enable ANSI color output.
    colors?: boolean;

    /// Maximum array length before truncation.
    maxArrayLength?: usize;

    /// Maximum string length before truncation.
    maxStringLength?: usize;
}

/// Inspect one value for developer output.
export function inspect(value: unknown, options?: FormatOptions): string {
    todo("debug.inspect")
}

/// Format a list of values for developer output.
export function format(...values: unknown[]): string {
    formatWithOptions(null, ...values)
}

/// Format a list of values with explicit options.
export function formatWithOptions(options: FormatOptions | null, ...values: unknown[]): string {
    todo("debug.formatWithOptions")
}
