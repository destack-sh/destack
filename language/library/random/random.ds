import { Slice } from "core";
import type { PlatformError } from "../platform/error/index.ds";
import * as platform from "library/platform/index.ds";

/// Opaque identifier for a deterministic random stream.
export type RandomStream = platform.random.RandomStream;

/// Allocate a deterministic random stream identifier.
export function stream(): Result<RandomStream, PlatformError> {
    platform.random.stream();
}

/// Return a deterministic random uint64 from the current stream.
export function nextU64(): Result<uint64, PlatformError> {
    platform.random.nextU64();
}

/// Return a deterministic random uint64 from a stream.
export function nextU64From(stream: RandomStream): Result<uint64, PlatformError> {
    platform.random.nextU64From(stream);
}

/// Fill a slice with random bytes.
export function fillBytes(buffer: Slice<uint8>): Result<void, PlatformError> {
    platform.random.fillBytes(buffer);
}

/// Fill a slice with random bytes from a stream.
export function fillBytesFrom(
    stream: RandomStream,
    buffer: Slice<uint8>,
): Result<void, PlatformError> {
    platform.random.fillBytesFrom(stream, buffer);
}

/// Fill a slice with cryptographically secure random bytes.
export function secureBytes(buffer: Slice<uint8>): Result<void, PlatformError> {
    platform.random.secureBytes(buffer);
}
