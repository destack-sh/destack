    reduceMin,
    reduceMax,
    reduceAnd,
    reduceOr,
    reduceXor,
} from "./core/primitive/vector.ds";

// annotation and decorator markers
export {
    deprecated,
    experimental,
    allow,
    warn,
    deny,
    forbid,
    expect,
    extern,
    intrinsic,
    languageItem,
    noManaged,
    stackOnly,
    capture,
    Tagged,
    Clone,
    Debug,
    type CaptureKind,
    type CapturePolicy,
    type CaptureDirective,
    type InlineHint,
    type TaggedCase,
    type TaggedNames,
    type PatchContext,
    type PatchAdd,
    type PatchReplace,
    type PatchRename,
    type PatchRemove,
    type Patch,
    type Patcher,
    inline,
    noinline,
    unroll,
    hot,
    cold,
    likely,
    unlikely,
    mustUse,
    pure,
    tailcall,
    unsafe,
    transmute,
    taint,
    sink,
    sanitizer,
    tag,
    lifetime,
} from "./core/primitive/decorator.ds";

// binding annotations
