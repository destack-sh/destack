    type Place,
    type Ownership,
    type Form,
    type Managed,
    type Borrowed,
    type Raw,
    type Owned,
    type Shared,
    type BaseOf,
    type OwnershipOf,
    type PlaceOf,
    type SpaceOf,
    type RegionOf,
    type OwnershipOr,
    type PlaceOr,
    type SpaceOr,
    type PlaceIn,
    type IsManaged,
    type IsOwned,
    type IsBorrowed,
    type IsRaw,
    type IsShared,
    type IsSharedIn,
    type WithBase,
    type WithOwnership,
    type WithPlace,
    type WithSpace,
    type WithRegion,
    type AsManaged,
    type AsOwned,
    type AsBorrowed,
    type AsRaw,
    type Bytes,
    type Buffer,
    type Copy,
    type Clone,
    type Drop,
    type Dispose,
    type AsyncDispose,
