import { Duration } from "destack:time";
import { todo } from "destack:error";
import { Body, SuiteBody } from "./context.ds";
import { Options } from "./options.ds";

/// Benchmark registration argument after the name.
export type Argument = Body | Options | Duration;

/// Benchmark suite argument after the name.
export type SuiteArgument = SuiteBody | Options;

/// Registered benchmark case.
export struct Case {
    /// Case name.
    name: string;

    /// Case options.
    options?: Options;
}

/// Registered benchmark suite.
export struct Suite {
    /// Suite name.
    name: string;

    /// Suite options.
    options?: Options;
}

/// Register one benchmark case.
export function registerCase(name: string, argument?: Argument, body?: Body): void {
    todo("bench.registerCase")
}

/// Register one benchmark suite.
export function suite(name: string, argument?: SuiteArgument, body?: SuiteBody): void {
    todo("bench.registerSuite")
}

/// Register one skipped benchmark case.
export function caseSkip(name: string, body?: Body): void {
    registerCase(name, { skip: true }, body)
}

/// Register one focused benchmark case.
export function caseOnly(name: string, body?: Body): void {
    registerCase(name, { only: true }, body)
}

/// Register one skipped benchmark suite.
export function suiteSkip(name: string, body?: SuiteBody): void {
    suite(name, { skip: true }, body)
}

/// Register one focused benchmark suite.
export function suiteOnly(name: string, body?: SuiteBody): void {
    suite(name, { only: true }, body)
}

export { registerCase as case };
