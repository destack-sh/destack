import { type Drop } from "destack:memory";

/// Worker-local handle to a suspended execution frame.
export newtype ContinuationHandle = uint64;

extension of ContinuationHandle implements Drop {
    /// Resume this suspended execution frame.
    @intrinsic("continuation.resume")
    resume<TInput, TYield, TReturn>(value: TInput): ContinuationResult<TYield, TReturn>;

    /// Throw into this suspended execution frame.
    @intrinsic("continuation.throw")
    throw<TYield, TReturn>(error: unknown): ContinuationResult<TYield, TReturn>;

    /// Drop this suspended execution frame.
    @intrinsic("continuation.drop")
    drop(): void;
}

/// Suspended continuation produced by `yield`.
export struct ContinuationYield<T> {
    kind: "yield" = "yield";
    value: T;
    continuation: ContinuationHandle;
}

/// Completed continuation.
export struct ContinuationReturn<T> {
    kind: "return" = "return";
    value: T;
}

/// Failed continuation.
export struct ContinuationThrow {
    kind: "throw" = "throw";
    error: unknown;
}

/// Result of resuming a continuation.
@derive(Tagged)
export type ContinuationResult<TYield, TReturn> =
    | ContinuationYield<TYield>
    | ContinuationReturn<TReturn>
    | ContinuationThrow;

/// Suspend the current continuation and register its handle.
@intrinsic("continuation.suspend")
export declare function suspendContinuation<T>(
    register: (handle: ContinuationHandle) => void,
): T;

/// Queue one Worker-local microtask.
@intrinsic("microtask.queue")
export declare function queueMicrotask(task: () => void): void;
