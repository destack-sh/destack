import { typeOf } from "reflect/type.ds";

// NOTE #Incomplete: inspect parity with bun util inspect is still evolving

/// Options for inspect formatting.
export struct InspectOptions {
    /// Include non enumerable properties.
    showHidden?: boolean;
    /// Maximum depth for recursive inspection.
    depth?: int | null;
    /// Enable ANSI color output.
    colors?: boolean;
    /// Allow custom inspect hooks.
    customInspect?: boolean;
    /// Maximum array length before truncation.
    maxArrayLength?: number;
    /// Maximum string length before truncation.
    maxStringLength?: number;
    /// Preferred line break length.
    breakLength?: number;
    /// Compact formatting level.
    compact?: boolean | number;
    /// Sort keys when formatting objects.
    sorted?: boolean | ((a: string, b: string) => number);
    /// Control getter formatting.
    getters?: boolean | "get" | "set";
    /// Insert numeric separators.
    numericSeparator?: boolean;
}

/// Format a list of values like node util format.
export function formatWithOptions(options: InspectOptions | null, ...values: unknown[]): string {
    // normalize inspect options
    const inspectOptions = normalizeOptions(options);

    // handle empty input
    if (values.length == 0) {
        return "";
    }

    // treat the first argument as a format string when possible
    const first = values[0];
    if (typeof first != "string") {
        return joinValues(values, inspectOptions);
    }

    // format using the specifiers and append remaining values
    const formatted = formatString(first as string, values.slice(1), inspectOptions);

    // return the formatted string when there is nothing else to append
    if (formatted.remaining.length == 0) {
        return formatted.text;
    }

    return formatted.text + " " + joinValues(formatted.remaining, inspectOptions);
}

/// Format values using the default inspect options.
export function format(...values: unknown[]): string {
    formatWithOptions(null, ...values);
}

/// Inspect a single value for debugging.
export function inspect(value: unknown, options?: InspectOptions): string {
    // build the inspection context
    const ctx = createContext(options);

    // format the value with depth control
    formatValue(value, ctx, ctx.depth, 0);
}

/// Inspect namespace properties.
/// Custom inspection symbol.
export const custom = Symbol.for("nodejs.util.inspect.custom");

/// Color escape sequences by style name.
export const colors = {
    bold: [1, 22],
    italic: [3, 23],
    underline: [4, 24],
    inverse: [7, 27],
    white: [37, 39],
    grey: [90, 39],
    black: [30, 39],
    blue: [34, 39],
    cyan: [36, 39],
    green: [32, 39],
    magenta: [35, 39],
    red: [31, 39],
    yellow: [33, 39],
};

/// Mapping from logical style to color name.
export const styles = {
    special: "cyan",
    number: "yellow",
    bigint: "yellow",
    boolean: "yellow",
    undefined: "grey",
    null: "bold",
    string: "green",
    symbol: "green",
    date: "magenta",
    regexp: "red",
    name: "cyan",
};

/// Default inspect options.
export const defaultOptions: InspectOptions = {
    showHidden: false,
    depth: 2,
    colors: false,
    customInspect: true,
    maxArrayLength: 100,
    maxStringLength: 10000,
    breakLength: 80,
    compact: 3,
    sorted: false,
    getters: false,
    numericSeparator: false,
};

/// Internal inspection context.
struct InspectContext {
    /// User supplied options.
    options: InspectOptions;
    /// Seen objects for circular detection.
    seen: unknown[];
    /// Remaining depth for recursion.
    depth: int;
    /// Stylize function based on color mode.
    stylize: (text: string, style: string) => string;
}

/// Result of format parsing.
struct FormattedString {
    /// Formatted output.
    text: string;
    /// Remaining values that were not consumed by format specifiers.
    remaining: unknown[];
}

/// Build an inspection context from options.
function createContext(options?: InspectOptions): InspectContext {
    // normalize options and depth
    const resolved = normalizeOptions(options ?? inspect.defaultOptions);
    const depth = resolveDepth(resolved.depth);

    // select stylize function based on color mode
    const stylize = resolved.colors ? stylizeWithColor : stylizeNoColor;

    (InspectContext {
        options: resolved,
        seen: [],
        depth,
        stylize,
    });
}

/// Normalize options by filling defaults.
function normalizeOptions(options: InspectOptions | null | undefined): InspectOptions {
    // handle null options
    if (options == null) {
        return inspect.defaultOptions;
    }

    // merge with defaults
    const defaults = inspect.defaultOptions;
    (InspectOptions {
        showHidden: options.showHidden ?? defaults.showHidden,
        depth: options.depth ?? defaults.depth,
        colors: options.colors ?? defaults.colors,
        customInspect: options.customInspect ?? defaults.customInspect,
        maxArrayLength: options.maxArrayLength ?? defaults.maxArrayLength,
        maxStringLength: options.maxStringLength ?? defaults.maxStringLength,
        breakLength: options.breakLength ?? defaults.breakLength,
        compact: options.compact ?? defaults.compact,
        sorted: options.sorted ?? defaults.sorted,
        getters: options.getters ?? defaults.getters,
        numericSeparator: options.numericSeparator ?? defaults.numericSeparator,
    });
}

/// Resolve depth with null treated as unlimited.
function resolveDepth(depth: int | null | undefined): int {
    // treat null as unlimited
    if (depth == null) {
        return 1_000_000;
    }

    depth;
}

/// Join a list of values for format output.
function joinValues(values: readonly unknown[], options: InspectOptions): string {
    // format each value
    const parts: string[] = [];
    for (const value of values) {
        // append plain strings directly
        if (typeof value == "string") {
            parts.push(value as string);
        }
        // otherwise inspect the value
        else {
            parts.push(inspect(value, options));
        }
    }

    // join with spaces
    parts.join(" ");
}

/// Format a string with util style specifiers.
function formatString(
    format: string,
    values: readonly unknown[],
    options: InspectOptions,
): FormattedString {
    // initialize output state
    let out = "";
    let index = 0;
    let valueIndex = 0;

    // walk the format string
    while (index < format.length) {
        // read the next character
        const ch = format[index];

        // append non specifiers
        if (ch != "%" || index + 1 >= format.length) {
            out = out + ch;
            index += 1;
            continue;
        }

        // read the specifier
        const next = format[index + 1];

        // handle escaped percent
        if (next == "%") {
            out = out + "%";
            index += 2;
            continue;
        }

        // handle missing values
        if (valueIndex >= values.length) {
            out = out + "%" + next;
            index += 2;
            continue;
        }

        // consume the value for this specifier
        const value = values[valueIndex];
        valueIndex += 1;

        // format string values
        if (next == "s") {
            out = out + formatStringValue(value);
        }
        // format integer values
        else if (next == "d" || next == "i") {
            out = out + formatNumberValue(value, options);
        }
        // format floating values
        else if (next == "f") {
            out = out + formatFloatValue(value, options);
        }
        // format json values
        else if (next == "j") {
            out = out + formatJsonValue(value);
        }
        // format inspected objects
        else if (next == "o" || next == "O") {
            out = out + inspect(value, options);
        }
        // fall back to literal output
        else {
            out = out + "%" + next;
        }

        index += 2;
    }

    (FormattedString {
        text: out,
        remaining: values.slice(valueIndex),
    });
}

/// Format a value for the %s placeholder.
function formatStringValue(value: unknown): string {
    // handle string values
    if (typeof value == "string") {
        return value as string;
    }

    // handle numeric values
    if (typeof value == "number") {
        return (value as number).toString();
    }
    if (typeof value == "bigint") {
        return (value as bigint).toString();
    }

    // handle boolean values
    if (typeof value == "boolean") {
        return (value as boolean) ? "true" : "false";
    }

    // handle null values
    if (value == null) {
        return "null";
    }

    // handle undefined values
    if (value == undefined) {
        return "undefined";
    }

    "[object]";
}

/// Format a value for the %d or %i placeholders.
function formatNumberValue(value: unknown, options: InspectOptions): string {
    // handle numeric values
    if (typeof value == "number") {
        return formatNumber(value as number, options.numericSeparator ?? false);
    }
    if (typeof value == "bigint") {
        return (value as bigint).toString();
    }

    formatStringValue(value);
}

/// Format a value for the %f placeholder.
function formatFloatValue(value: unknown, options: InspectOptions): string {
    // handle numeric values
    if (typeof value == "number") {
        return formatNumber(value as number, options.numericSeparator ?? false);
    }

    formatStringValue(value);
}

/// Format a value for the %j placeholder.
function formatJsonValue(value: unknown): string {
    // serialize with json and handle failures
    try {
        const text = JSON.stringify(value);
        if (text == undefined) {
            return "undefined";
        }
        return text;
    } catch {
        return "[Circular]";
    }
}

/// Format any value with inspection semantics.
function formatValue(value: unknown, ctx: InspectContext, depth: int, level: int): string {
    // handle null values
    if (value == null) {
        return ctx.stylize("null", "null");
    }

    // handle undefined values
    if (value == undefined) {
        return ctx.stylize("undefined", "undefined");
    }

    // handle string values
    const valueType = typeof value;
    if (valueType == "string") {
        return formatStringLiteral(value as string, ctx);
    }

    // handle numeric values
    if (valueType == "number") {
        return ctx.stylize(
            formatNumber(value as number, ctx.options.numericSeparator ?? false),
            "number",
        );
    }
    if (valueType == "bigint") {
        return ctx.stylize((value as bigint).toString() + "n", "bigint");
    }

    // handle boolean values
    if (valueType == "boolean") {
        return ctx.stylize((value as boolean) ? "true" : "false", "boolean");
    }

    // handle symbol values
    if (valueType == "symbol") {
        return ctx.stylize((value as symbol).toString(), "symbol");
    }

    // handle function values
    if (valueType == "function") {
        return formatFunction(value as Function, ctx);
    }

    formatObject(value, ctx, depth, level);
}

/// Format non primitive values.
function formatObject(value: unknown, ctx: InspectContext, depth: int, level: int): string {
    // handle depth limit
    if (depth < 0) {
        return ctx.stylize("[Object]", "special");
    }

    // guard circular references
    if (ctx.seen.includes(value)) {
        return ctx.stylize("[Circular]", "special");
    }

    // track the current object
    ctx.seen.push(value);

    // handle date values
    if (value instanceof Date) {
        const rendered = ctx.stylize((value as Date).toString(), "date");
        ctx.seen.pop();
        return rendered;
    }

    // handle regex values
    if (value instanceof RegExp) {
        const rendered = ctx.stylize((value as RegExp).toString(), "regexp");
        ctx.seen.pop();
        return rendered;
    }

    // handle error values
    if (value instanceof Error) {
        const rendered = (value as Error).stack ?? (value as Error).toString();
        ctx.seen.pop();
        return rendered;
    }

    // handle map values
    if (value instanceof Map) {
        const rendered = formatMap(value as Map<unknown, unknown>, ctx, depth, level);
        ctx.seen.pop();
        return rendered;
    }

    // handle set values
    if (value instanceof Set) {
        const rendered = formatSet(value as Set<unknown>, ctx, depth, level);
        ctx.seen.pop();
        return rendered;
    }

    // handle tuple values
    const tupleType = readTupleType(value);
    if (tupleType != null && Array.isArray(value)) {
        const rendered = formatTuple(value as unknown[], ctx, depth, level);
        ctx.seen.pop();
        return rendered;
    }

    // handle array values
    if (Array.isArray(value)) {
        const rendered = formatArray(value as unknown[], ctx, depth, level);
        ctx.seen.pop();
        return rendered;
    }

    // handle custom inspection hooks
    const customInspect = ctx.options.customInspect ?? true;
    if (customInspect) {
        const maybeCustom = (value as any)[inspect.custom];
        if (typeof maybeCustom == "function") {
            try {
                const result = maybeCustom.call(value, depth, ctx.options, inspect);
                if (typeof result == "string") {
                    ctx.seen.pop();
                    return result;
                }
            } catch {}
        }
    }

    // handle debug style hooks
    if (customInspect) {
        const debugMethod = (value as any).debug;
        if (typeof debugMethod == "function") {
            try {
                const result = debugMethod.call(value);
                if (typeof result == "string") {
                    ctx.seen.pop();
                    return result;
                }
            } catch {}
        }
    }

    // handle display style hooks
    if (customInspect) {
        const displayMethod = (value as any).display;
        if (typeof displayMethod == "function") {
            try {
                const result = displayMethod.call(value);
                if (typeof result == "string") {
                    ctx.seen.pop();
                    return result;
                }
            } catch {}
        }
    }

    // fall back to record formatting
    const rendered = formatRecord(value, ctx, depth, level);
    ctx.seen.pop();
    rendered;
}

/// Format tuples.
function formatTuple(values: unknown[], ctx: InspectContext, depth: int, level: int): string {
    // format entries
    const entries = formatArrayEntries(values, ctx, depth, level);

    // handle single element tuples
    if (entries.length == 1) {
        entries[0] = entries[0] + ",";
    }

    formatCollection(entries, "(", ")", ctx, level);
}

/// Format arrays.
function formatArray(values: unknown[], ctx: InspectContext, depth: int, level: int): string {
    // format entries
    const entries = formatArrayEntries(values, ctx, depth, level);

    formatCollection(entries, "[", "]", ctx, level);
}

/// Format array entries.
function formatArrayEntries(
    values: unknown[],
    ctx: InspectContext,
    depth: int,
    level: int,
): string[] {
    // determine output bounds
    const maxLen = ctx.options.maxArrayLength ?? 100;
    const length = values.length;
    const limit = length < maxLen ? length : maxLen;

    // format entries
    const entries: string[] = [];
    for (let i = 0; i < limit; i += 1) {
        // format defined entries
        if (i in values) {
            entries.push(formatValue(values[i], ctx, depth - 1, level + 1));
        }
        // format holes
        else {
            entries.push(ctx.stylize("<empty>", "special"));
        }
    }

    // append truncation info
    if (length > limit) {
        entries.push(ctx.stylize(`... ${length - limit} more items`, "special"));
    }

    entries;
}

/// Format maps.
function formatMap(
    values: Map<unknown, unknown>,
    ctx: InspectContext,
    depth: int,
    level: int,
): string {
    // prepare iteration state
    const entries: string[] = [];
    let count = 0;
    const maxLen = ctx.options.maxArrayLength ?? 100;

    // format entries
    for (const [key, value] of values) {
        // append truncation info
        if (count >= maxLen) {
            entries.push(ctx.stylize(`... ${values.size - maxLen} more items`, "special"));
            break;
        }

        entries.push(
            formatValue(key, ctx, depth - 1, level + 1) +
                " => " +
                formatValue(value, ctx, depth - 1, level + 1),
        );
        count += 1;
    }

    const label = `Map(${values.size})`;
    formatCollection(entries, `${label} {`, "}", ctx, level);
}

/// Format sets.
function formatSet(values: Set<unknown>, ctx: InspectContext, depth: int, level: int): string {
    // prepare iteration state
    const entries: string[] = [];
    let count = 0;
    const maxLen = ctx.options.maxArrayLength ?? 100;

    // format entries
    for (const value of values) {
        // append truncation info
        if (count >= maxLen) {
            entries.push(ctx.stylize(`... ${values.size - maxLen} more items`, "special"));
            break;
        }

        entries.push(formatValue(value, ctx, depth - 1, level + 1));
        count += 1;
    }

    const label = `Set(${values.size})`;
    formatCollection(entries, `${label} {`, "}", ctx, level);
}

/// Format object records.
function formatRecord(value: unknown, ctx: InspectContext, depth: int, level: int): string {
    // collect keys and symbols
    const objectValue = value as object;
    const showHidden = ctx.options.showHidden ?? false;
    const keys = showHidden ? Object.getOwnPropertyNames(objectValue) : Object.keys(objectValue);
    const symbols = Object.getOwnPropertySymbols(objectValue);

    // combine keys and symbols
    const allKeys: (string | symbol)[] = [];
    for (const key of keys) {
        allKeys.push(key);
    }
    for (const symbol of symbols) {
        allKeys.push(symbol);
    }

    // sort keys when requested
    const sorted = ctx.options.sorted ?? false;
    if (typeof sorted == "function") {
        allKeys.sort((a, b) => {
            if (typeof a == "symbol" || typeof b == "symbol") {
                return 0;
            }
            return sorted(a as string, b as string);
        });
    }
    // otherwise use default sorting
    else if (sorted) {
        allKeys.sort((a, b) => {
            if (typeof a == "symbol" || typeof b == "symbol") {
                return 0;
            }
            if (a < b) return -1;
            if (a > b) return 1;
            0;
        });
    }

    // prepare property descriptors when requested
    const descriptors = ctx.options.getters ? Object.getOwnPropertyDescriptors(objectValue) : null;

    // format entries
    const entries: string[] = [];
    for (const key of allKeys) {
        // format the key name
        const keyText = typeof key == "symbol" ? (key as symbol).toString() : (key as string);

        // format the value based on getter options
        let valueText = "";
        if (descriptors != null) {
            const descriptor = descriptors[keyText as string] ?? (descriptors as any)[key];
            if (descriptor != null) {
                valueText = formatDescriptorValue(objectValue, descriptor, ctx, depth, level);
            } else {
                valueText = formatValue((objectValue as any)[key], ctx, depth - 1, level + 1);
            }
        } else {
            valueText = formatValue((objectValue as any)[key], ctx, depth - 1, level + 1);
        }

        entries.push(keyText + ": " + valueText);
    }

    // handle empty objects
    if (entries.length == 0) {
        const typeName = readTypeName(value);
        return typeName == "Object" ? "{}" : `${typeName} {}`;
    }

    // render the record with a type label
    const typeName = readTypeName(value);
    const prefix = typeName == "Object" ? "{" : `${typeName} {`;
    formatCollection(entries, prefix, "}", ctx, level);
}

/// Format a property descriptor value.
function formatDescriptorValue(
    owner: object,
    descriptor: any,
    ctx: InspectContext,
    depth: int,
    level: int,
): string {
    // handle value descriptors
    if ("value" in descriptor) {
        return formatValue(descriptor.value, ctx, depth - 1, level + 1);
    }

    // resolve getter options
    const getters = ctx.options.getters ?? false;
    const hasGetter = typeof descriptor.get == "function";
    const hasSetter = typeof descriptor.set == "function";

    // handle getter inspection
    if (getters == true || getters == "get") {
        if (hasGetter) {
            try {
                return formatValue(descriptor.get.call(owner), ctx, depth - 1, level + 1);
            } catch {
                return ctx.stylize("[Getter]", "special");
            }
        }
        if (hasSetter) {
            return ctx.stylize("[Setter]", "special");
        }
    }

    // handle setter only inspection
    if (getters == "set") {
        if (hasSetter) {
            return ctx.stylize("[Setter]", "special");
        }
        if (hasGetter) {
            return ctx.stylize("[Getter]", "special");
        }
    }

    ctx.stylize("[Getter/Setter]", "special");
}

/// Format functions.
function formatFunction(value: Function, ctx: InspectContext): string {
    // include function name when available
    const name = value.name;
    if (name != "") {
        return ctx.stylize(`[Function: ${name}]`, "special");
    }

    ctx.stylize("[Function]", "special");
}

/// Format string literals.
function formatStringLiteral(value: string, ctx: InspectContext): string {
    // truncate long strings
    const maxLength = ctx.options.maxStringLength ?? 10000;
    let text = value;
    if (maxLength >= 0 && value.length > maxLength) {
        text = value.slice(0, maxLength) + "...";
    }

    // escape for display
    const escaped = escapeString(text);
    ctx.stylize("'" + escaped + "'", "string");
}

/// Escape a string for display.
function escapeString(value: string): string {
    // escape common control characters
    let out = "";
    for (const ch of value) {
        if (ch == "\\") {
            out = out + "\\\\";
        }
        // escape single quotes
        else if (ch == "'") {
            out = out + "\\'";
        }
        // escape newlines
        else if (ch == "\n") {
            out = out + "\\n";
        }
        // escape carriage returns
        else if (ch == "\r") {
            out = out + "\\r";
        }
        // escape tabs
        else if (ch == "\t") {
            out = out + "\\t";
        }
        // keep printable characters
        else {
            out = out + ch;
        }
    }

    out;
}

/// Format a number with optional separators.
function formatNumber(value: number, numericSeparator: boolean): string {
    // handle simple formatting
    if (!numericSeparator) {
        return value.toString();
    }

    // insert separators in the integer part
    const text = value.toString();
    const parts = text.split(".");
    const integer = insertNumericSeparator(parts[0]);

    // return when there is no fractional part
    if (parts.length == 1) {
        return integer;
    }

    return integer + "." + parts[1];
}

/// Insert numeric separators into an integer string.
function insertNumericSeparator(text: string): string {
    // scan from the end to insert separators
    let out = "";
    let count = 0;
    for (let i = text.length - 1; i >= 0; i -= 1) {
        const ch = text[i];

        // preserve sign
        if (ch == "-") {
            out = ch + out;
            continue;
        }

        // insert separator after each group
        if (count > 0 && count % 3 == 0) {
            out = "_" + out;
        }

        out = ch + out;
        count += 1;
    }

    out;
}

/// Render a collection as either single or multi line text.
function formatCollection(
    entries: string[],
    open: string,
    close: string,
    ctx: InspectContext,
    level: int,
): string {
    // handle empty collections
    if (entries.length == 0) {
        return open + close;
    }

    // build the single line form
    const single = open + " " + entries.join(", ") + " " + close;

    // decide if multiline output is needed
    const compact = ctx.options.compact ?? 3;
    const breakLength = ctx.options.breakLength ?? 80;
    const forceMultiline = compact == false || compact == 0;
    if (!forceMultiline && single.length <= breakLength) {
        return single;
    }

    // render multiline output
    const indent = "  ".repeat(level + 1);
    const closingIndent = "  ".repeat(level);
    return open + "\n" + indent + entries.join(",\n" + indent) + "\n" + closingIndent + close;
}

/// Return the string unchanged.
function stylizeNoColor(text: string, _style: string): string {
    text;
}

/// Apply an ANSI style to a string.
function stylizeWithColor(text: string, style: string): string {
    // resolve the color name
    const color = (inspect.styles as any)[style];
    if (color == null) {
        return text;
    }

    // resolve escape codes
    const codes = (inspect.colors as any)[color];
    if (codes == null) {
        return text;
    }

    "\u001b[" + codes[0].toString() + "m" + text + "\u001b[" + codes[1].toString() + "m";
}

/// Read the tuple descriptor when available.
function readTupleType(value: unknown): any | null {
    // consult type metadata
    const valueType = typeOf(value);
    if (valueType != null && (valueType as any).kind == "tuple") {
        return valueType as any;
    }

    null;
}

/// Read the friendly type name for a value.
function readTypeName(value: unknown): string {
    // use typeOf for structured names
    const type = typeOf(value);
    if (type == null) {
        return "Object";
    }

    type.name;
}
