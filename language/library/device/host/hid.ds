import { ResourceId } from "destack:runtime/resource";
import { Array, PackedArray } from "destack:collections";
import { HostError } from "destack:error/host";
import { Path } from "destack:fs/host";

/// Handle for one HID device endpoint.
export newtype HidDeviceHandle = ResourceId;

/// HID device list flags.
export newtype HidDeviceListFlags = uint32;

/// Include disconnected devices when the host reports them.
export const HID_DEVICE_LIST_DISCONNECTED: HidDeviceListFlags = HidDeviceListFlags(0x01);

/// Include virtual and emulated devices.
export const HID_DEVICE_LIST_VIRTUAL: HidDeviceListFlags = HidDeviceListFlags(0x02);

/// HID device bus kind.
export enum HidBus {
    /// Host did not classify the bus.
    Unknown = 0,
    /// USB HID transport.
    Usb = 1,
    /// Bluetooth HID transport.
    Bluetooth = 2,
    /// I2C HID transport.
    I2c = 3,
    /// SPI HID transport.
    Spi = 4,
    /// Virtual or emulated HID transport.
    Virtual = 5,
}

/// HID device query.
export struct HidDeviceQuery {
    /// USB or Bluetooth vendor identifier filter when present.
    vendorId?: uint16;
    /// USB or Bluetooth product identifier filter when present.
    productId?: uint16;
    /// HID usage-page filter when present.
    usagePage?: uint16;
    /// HID usage filter when present.
    usage?: uint16;
    /// List behavior flags.
    flags: HidDeviceListFlags;
}

/// HID device descriptor.
export struct HidDevice {
    /// Stable HID device identifier.
    id: string;
    /// Host device path when available.
    path?: Path;
    /// Host-visible device name.
    name: string;
    /// Host bus kind.
    bus: HidBus;
    /// Vendor identifier when available.
    vendorId?: uint16;
    /// Product identifier when available.
    productId?: uint16;
    /// Manufacturer string when available.
    manufacturer?: string;
    /// Product string when available.
    product?: string;
    /// Serial number when available.
    serialNumber?: string;
    /// Primary HID usage page when available.
    usagePage?: uint16;
    /// Primary HID usage when available.
    usage?: uint16;
    /// Maximum input report length in bytes when known.
    maxInputReportBytes?: uint32;
    /// Maximum output report length in bytes when known.
    maxOutputReportBytes?: uint32;
    /// Maximum feature report length in bytes when known.
    maxFeatureReportBytes?: uint32;
    /// Whether this device is currently connected.
    isConnected: boolean;
    /// Whether this device is virtual or emulated.
    isVirtual: boolean;
    /// Whether this device is provided by the system stack.
    isSystem: boolean;
}

/// HID report payload.
export struct HidReport {
    /// Monotonic report timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the host stream.
    sequence: uint64;
    /// Report identifier, or zero when the format omits explicit report identifiers.
    reportId: uint8;
    /// Raw report bytes.
    bytes: Array<uint8>;
}

/// List HID devices.
@binding("destack.device.hid.list", {
    effect: "external",
    requires: ["host.device.hid.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listHidDevices(
    query: &readonly HidDeviceQuery,
): Result<PackedArray<HidDevice>, HostError>;

/// Open one HID device.
@binding("destack.device.hid.open", {
    effect: "external",
    requires: ["host.device.hid.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openHidDevice(id: &readonly string): Result<HidDeviceHandle, HostError>;

/// Close one HID device.
@binding("destack.device.hid.close", {
    effect: "external",
    requires: ["host.device.hid.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeHidDevice(device: HidDeviceHandle): Result<void, HostError>;

/// Read the HID report descriptor.
@binding("destack.device.hid.descriptor.read", {
    effect: "external",
    requires: ["host.device.hid.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readHidDescriptor(
    device: HidDeviceHandle,
): Result<PackedArray<uint8>, HostError>;

/// Read one HID input report.
@binding("destack.device.hid.report.read", {
    effect: "external",
    requires: ["host.device.hid.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readHidReport(
    device: HidDeviceHandle,
    maxBytes: uint32,
    timeoutNs?: uint64,
): Result<HidReport, HostError>;

/// Write one HID output report.
@binding("destack.device.hid.report.write", {
    effect: "external",
    requires: ["host.device.hid.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeHidReport(
    device: HidDeviceHandle,
    reportId: uint8,
    bytes: &readonly [uint8],
): Result<uint32, HostError>;

/// Read one HID feature report.
@binding("destack.device.hid.feature.read", {
    effect: "external",
    requires: ["host.device.hid.feature"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readHidFeature(
    device: HidDeviceHandle,
    reportId: uint8,
    maxBytes: uint32,
): Result<PackedArray<uint8>, HostError>;

/// Write one HID feature report.
@binding("destack.device.hid.feature.write", {
    effect: "external",
    requires: ["host.device.hid.feature"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeHidFeature(
    device: HidDeviceHandle,
    reportId: uint8,
    bytes: &readonly [uint8],
): Result<void, HostError>;
