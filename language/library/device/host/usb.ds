/// Write bytes to a USB bulk endpoint.
@binding("destack.device.usb.bulk.write", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeUsbBulk(
    device: UsbDeviceHandle,
    endpoint: uint8,
    bytes: &readonly [uint8],
    timeoutNs?: uint64,
