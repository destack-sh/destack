/// Release a USB interface.
@binding("destack.device.usb.interface.release", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function releaseUsbInterface(
    device: UsbDeviceHandle,
    interfaceNumber: uint8,
): Result<void, HostError>;

/// Select one USB interface alternate setting.
@binding("destack.device.usb.interface.alternate.set", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setUsbAlternateInterface(
    device: UsbDeviceHandle,
    interfaceNumber: uint8,
    alternateSetting: uint8,
): Result<void, HostError>;

/// List USB endpoints.
@binding("destack.device.usb.endpoint.list", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listUsbEndpoints(
    device: UsbDeviceHandle,
    interfaceNumber: uint8,
    alternateSetting: uint8,
): Result<Array<UsbEndpoint>, HostError>;

/// Clear one halted USB endpoint.
@binding("destack.device.usb.endpoint.clearHalt", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clearUsbHalt(
    device: UsbDeviceHandle,
    endpoint: UsbEndpointSelector,
): Result<void, HostError>;

/// Reset one USB device.
@binding("destack.device.usb.reset", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function resetUsbDevice(device: UsbDeviceHandle): Result<void, HostError>;

/// Read one raw USB descriptor.
@binding("destack.device.usb.descriptor.read", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readUsbDescriptor(
    device: UsbDeviceHandle,
    descriptorType: uint8,
    descriptorIndex: uint8,
    languageId: uint16,
    buffer: &[uint8],
): Result<uint64, HostError>;

/// Read bytes with a USB control transfer.
@binding("destack.device.usb.control.read", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readUsbControl(
    device: UsbDeviceHandle,
    setup: UsbControlSetup,
    buffer: &[uint8],
    timeoutNs?: uint64,
): Result<UsbTransferResult, HostError>;

/// Write bytes with a USB control transfer.
@binding("destack.device.usb.control.write", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeUsbControl(
    device: UsbDeviceHandle,
    setup: UsbControlSetup,
    bytes: &readonly [uint8],
    timeoutNs?: uint64,
): Result<UsbTransferResult, HostError>;

/// Read bytes from a USB bulk endpoint.
@binding("destack.device.usb.bulk.read", {
    effect: "external",
