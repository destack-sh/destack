import { Array } from "destack:collections";
import { ResourceId } from "destack:runtime/resource";
import { HostError } from "destack:error/host";

/// Handle for one USB device endpoint.
export newtype UsbDeviceHandle = ResourceId;

/// Handle for one USB watch.
export newtype UsbWatchHandle = ResourceId;

/// USB device speed.
export enum UsbSpeed {
    /// Host did not report the negotiated speed.
    Unknown = 0,
    /// Low-speed USB.
    Low = 1,
    /// Full-speed USB.
    Full = 2,
    /// High-speed USB.
    High = 3,
    /// SuperSpeed USB.
    Super = 4,
    /// SuperSpeedPlus USB.
    SuperPlus = 5,
}

/// USB endpoint direction.
export enum UsbDirection {
    /// Host-to-device transfer direction.
    Out = 0,
    /// Device-to-host transfer direction.
    In = 1,
}

/// USB endpoint transfer type.
export enum UsbTransferType {
    /// Control transfer endpoint.
    Control = 0,
    /// Isochronous transfer endpoint.
    Isochronous = 1,
    /// Bulk transfer endpoint.
    Bulk = 2,
    /// Interrupt transfer endpoint.
    Interrupt = 3,
}

/// USB control request type.
export enum UsbRequestType {
    /// Standard USB request.
    Standard = 0,
    /// USB class request.
    Class = 1,
    /// Vendor-specific request.
    Vendor = 2,
}

/// USB control recipient.
export enum UsbRecipient {
    /// Device recipient.
    Device = 0,
    /// Interface recipient.
    Interface = 1,
    /// Endpoint recipient.
    Endpoint = 2,
    /// Other recipient.
    Other = 3,
}

/// USB transfer status.
export enum UsbTransferStatus {
    /// Transfer completed successfully.
    Completed = 1,
    /// Transfer ended with a stall condition.
    Stalled = 2,
    /// Transfer timed out.
    TimedOut = 3,
    /// Transfer was cancelled.
    Cancelled = 4,
    /// Transfer failed for a host-specific reason.
    Failed = 5,
    /// Transfer completed with fewer bytes than requested.
    Short = 6,
}

/// USB device descriptor.
export struct UsbDevice {
    /// Stable host identifier.
    id: string;
    /// USB vendor identifier.
    vendorId: uint16;
    /// USB product identifier.
    productId: uint16;
    /// Device class code.
    classCode: uint8;
    /// Device subclass code.
    subclassCode: uint8;
    /// Device protocol code.
    protocolCode: uint8;
    /// USB version in binary-coded decimal form.
    usbVersionBcd: uint16;
    /// Device version in binary-coded decimal form.
    deviceVersionBcd: uint16;
    /// Negotiated device speed when available.
    speed?: UsbSpeed;
    /// Host-visible manufacturer string when available.
    manufacturer?: string;
    /// Host-visible product string when available.
    product?: string;
    /// Host-visible serial number when available.
    serialNumber?: string;
}

/// USB configuration descriptor.
export struct UsbConfiguration {
    /// Configuration value.
    value: uint8;
    /// Configuration string when available.
    name?: string;
    /// Configuration attribute bits.
    attributes: uint8;
    /// Maximum bus power in milliamps.
    maxPowerMilliamps: uint16;
}

/// USB interface descriptor.
export struct UsbInterface {
    /// Configuration value containing this interface.
    configuration: uint8;
    /// Interface number.
    number: uint8;
    /// Alternate setting number.
    alternateSetting: uint8;
    /// Interface class code.
    classCode: uint8;
    /// Interface subclass code.
    subclassCode: uint8;
    /// Interface protocol code.
    protocolCode: uint8;
    /// Interface string when available.
    name?: string;
}

/// USB endpoint descriptor.
export struct UsbEndpoint {
    /// Configuration value containing this endpoint.
    configuration: uint8;
    /// Interface number containing this endpoint.
    interfaceNumber: uint8;
    /// Alternate setting number containing this endpoint.
    alternateSetting: uint8;
    /// Endpoint number.
    number: uint8;
    /// Endpoint direction.
    direction: UsbDirection;
    /// Endpoint transfer type.
    transferType: UsbTransferType;
    /// Maximum packet size in bytes.
    maxPacketSize: uint16;
    /// Polling interval.
    interval: uint8;
}

/// USB endpoint selector.
export struct UsbEndpointSelector {
    /// Endpoint number.
    number: uint8;
    /// Endpoint direction.
    direction: UsbDirection;
}

/// USB control transfer setup packet.
export struct UsbControlSetup {
    /// Request type.
    requestType: UsbRequestType;
    /// Request recipient.
    recipient: UsbRecipient;
    /// Request number.
    request: uint8;
    /// Request value field.
    value: uint16;
    /// Request index field.
    index: uint16;
}

/// USB transfer result.
export struct UsbTransferResult {
    /// Transfer status.
    status: UsbTransferStatus;
    /// Payload bytes transferred.
    bytes: uint64;
    /// Packet entries completed when packetized.
    packets?: uint32;
}

/// USB isochronous packet result.
export struct UsbIsochronousPacket {
    /// Packet status.
    status: UsbTransferStatus;
    /// Packet bytes transferred.
    bytes: uint32;
}

/// USB attached watch event.
export struct UsbWatchEventAttached {
    /// Event discriminator.
    kind: "attached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// USB device.
    device: UsbDevice;
}

/// USB detached watch event.
export struct UsbWatchEventDetached {
    /// Event discriminator.
    kind: "detached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// USB device.
    device: UsbDevice;
}

/// USB overflow watch event.
export struct UsbWatchEventOverflow {
    /// Event discriminator.
    kind: "overflow";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Number of dropped events.
    droppedCount: uint64;
}

/// USB topology event.
@derive(Tagged)
export newtype UsbWatchEvent =
    | UsbWatchEventAttached
    | UsbWatchEventDetached
    | UsbWatchEventOverflow;

/// List USB devices.
@binding("destack.device.usb.list", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listUsbDevices(): Result<Array<UsbDevice>, HostError>;

/// Open a USB topology watch.
@binding("destack.device.usb.watch.open", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openUsbWatch(): Result<UsbWatchHandle, HostError>;

/// Close a USB topology watch.
@binding("destack.device.usb.watch.close", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeUsbWatch(watch: UsbWatchHandle): Result<void, HostError>;

/// Read one USB topology event.
@binding("destack.device.usb.watch.read", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readUsbWatch(
    watch: UsbWatchHandle,
    timeoutNs?: uint64,
): Result<UsbWatchEvent, HostError>;

/// Open a USB device.
@binding("destack.device.usb.open", {
    effect: "external",
    requires: ["host.device.usb.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openUsbDevice(
    id: &readonly string,
): Result<UsbDeviceHandle, HostError>;

/// Close a USB device.
@binding("destack.device.usb.close", {
    effect: "external",
    requires: ["host.device.usb.open"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeUsbDevice(device: UsbDeviceHandle): Result<void, HostError>;

/// Describe an open USB device.
@binding("destack.device.usb.describe", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeUsbDevice(
    device: UsbDeviceHandle,
): Result<UsbDevice, HostError>;

/// List USB configurations.
@binding("destack.device.usb.configuration.list", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listUsbConfigurations(
    device: UsbDeviceHandle,
): Result<Array<UsbConfiguration>, HostError>;

/// Read the active USB configuration.
@binding("destack.device.usb.configuration.get", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function getUsbConfiguration(
    device: UsbDeviceHandle,
): Result<uint8, HostError>;

/// Select the active USB configuration.
@binding("destack.device.usb.configuration.set", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setUsbConfiguration(
    device: UsbDeviceHandle,
    configuration: uint8,
): Result<void, HostError>;

/// List USB interfaces.
@binding("destack.device.usb.interface.list", {
    effect: "external",
    requires: ["host.device.usb.list"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listUsbInterfaces(
    device: UsbDeviceHandle,
    configuration: uint8,
): Result<Array<UsbInterface>, HostError>;

/// Claim a USB interface.
@binding("destack.device.usb.interface.claim", {
    effect: "external",
    requires: ["host.device.usb.configure"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function claimUsbInterface(
    device: UsbDeviceHandle,
    interfaceNumber: uint8,
