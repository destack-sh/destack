/// Read USB isochronous packets.
@binding("destack.device.usb.isochronous.read", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readUsbIsochronous(
    device: UsbDeviceHandle,
    endpoint: uint8,
    buffer: &[uint8],
    packetByteCounts: &readonly [uint32],
    packets: &[UsbIsochronousPacket],
    timeoutNs?: uint64,
): Result<UsbTransferResult, HostError>;

/// Write USB isochronous packets.
@binding("destack.device.usb.isochronous.write", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeUsbIsochronous(
    device: UsbDeviceHandle,
    endpoint: uint8,
    bytes: &readonly [uint8],
    packetByteCounts: &readonly [uint32],
    packets: &[UsbIsochronousPacket],
    timeoutNs?: uint64,
): Result<UsbTransferResult, HostError>;

/// Cancel pending USB transfers.
@binding("destack.device.usb.transfer.cancel", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function cancelUsbTransfers(
    device: UsbDeviceHandle,
    endpoint?: UsbEndpointSelector,
): Result<void, HostError>;
