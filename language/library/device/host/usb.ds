    families: ["windows", "unix"],
    simulation: true,
})
export declare function readUsbInterrupt(
    device: UsbDeviceHandle,
    endpoint: uint8,
    buffer: &[uint8],
    timeoutNs?: uint64,
): Result<UsbTransferResult, HostError>;

/// Write bytes to a USB interrupt endpoint.
@binding("destack.device.usb.interrupt.write", {
    effect: "external",
    requires: ["host.device.usb.transfer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeUsbInterrupt(
    device: UsbDeviceHandle,
    endpoint: uint8,
