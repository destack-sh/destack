/// A point on the timeline.
export class Instant {
    /// Create an instant from epoch milliseconds.
    static fromEpochMilliseconds(milliseconds: int64): Instant;

    /// Return epoch milliseconds.
    epochMilliseconds(): int64;

    /// Return an ISO string.
    toString(): string;
}

/// A calendar date without a time zone.
export class PlainDate {
    /// The ISO year.
    readonly year: int32;

    /// The ISO month.
    readonly month: int32;

    /// The ISO day.
    readonly day: int32;

    /// Return an ISO string.
    toString(): string;
}

/// A clock time without a date or time zone.
export class PlainTime {
    /// The hour.
    readonly hour: int32;

    /// The minute.
    readonly minute: int32;

    /// The second.
    readonly second: int32;

    /// Return an ISO string.
    toString(): string;
}

/// A date and time with a time zone.
export class ZonedDateTime {
    /// Return the instant represented by this date time.
    toInstant(): Instant;

    /// Return an ISO string.
    toString(): string;
}
