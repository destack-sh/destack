import * as platform from "destack:platform";
import { type TimerHandle } from "destack:resource";
import { PlatformError } from "destack:platform/error";

/// Return wall clock time in nanoseconds since the runtime epoch.
export function wallNs(): Result<uint64, PlatformError> {
    platform.time.wallNs();
}

/// Return monotonic time in nanoseconds since process start.
export function monoNs(): Result<uint64, PlatformError> {
    platform.time.monoNs();
}

/// Sleep for at least the given duration in nanoseconds.
export function sleepNs(duration: uint64): Result<void, PlatformError> {
    platform.time.sleepNs(duration);
}

/// Schedule a one-shot timer.
export function once(delayNs: uint64): Result<TimerHandle, PlatformError> {
    platform.time.timerOnce(delayNs, {
        clock: platform.time.TimerClock.Monotonic,
        flags: platform.time.TimerFlags(0),
    });
}

/// Schedule a repeating timer.
export function interval(periodNs: uint64): Result<TimerHandle, PlatformError> {
    platform.time.timerInterval(periodNs, {
        clock: platform.time.TimerClock.Monotonic,
        flags: platform.time.TimerFlags(0),
    });
}

/// Cancel a scheduled timer.
export function cancel(handle: TimerHandle): Result<void, PlatformError> {
    platform.time.timerCancel(handle);
}
