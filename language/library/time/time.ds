import { HostError } from "destack:error/host";
import * as host from "./host";

/// Read realtime clock time.
export function realtime(): Result<host.Timestamp, HostError> {
    host.readClock(host.Clock.Realtime);
}

/// Read monotonic clock time.
export function monotonic(): Result<host.Timestamp, HostError> {
    host.readClock(host.Clock.Monotonic);
}

/// Read one clock resolution.
export function resolution(clock: host.Clock): Result<host.Duration, HostError> {
    host.readClockResolution(clock);
}

/// Open one timer.
export function timer(
    schedule: &readonly host.TimerSchedule,
): Result<host.TimerHandle, HostError> {
    host.openTimer(schedule);
}

/// Arm one timer.
export function arm(
    handle: host.TimerHandle,
    schedule: &readonly host.TimerSchedule,
): Result<void, HostError> {
    host.armTimer(handle, schedule);
}

/// Read elapsed timer firings.
export function read(handle: host.TimerHandle): Result<uint64, HostError> {
    host.readTimer(handle);
}

/// Close one timer.
export function close(handle: host.TimerHandle): Result<void, HostError> {
    host.closeTimer(handle);
}
