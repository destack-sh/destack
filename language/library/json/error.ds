import { Error } from "destack:error";

/// JSON error category.
export enum JsonErrorKind {
    /// The input is not valid JSON.
    Syntax,
    /// The input exceeds the configured nesting depth.
    Depth,
    /// A number cannot be represented.
    Number,
    /// The value is unsupported by JSON.
    Unsupported,
    /// Encoding failed.
    Encode,
    /// Decoding failed.
    Decode,
}

/// JSON object key or array index.
export type JsonPathSegment = string | usize;

/// JSON parse, stringify, encode, or decode error.
export struct JsonError {
    /// The error category.
    kind: JsonErrorKind;

    /// The error message.
    message: string;

    /// The byte offset when known.
    offset?: usize;

    /// The decoded value path when known.
    path?: readonly JsonPathSegment[];
}

extension of JsonError implements Error {
    /// Format this error for users.
    display(): string {
        this.message
    }
}
