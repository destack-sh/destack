import { Borrow, From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Borrowed, Copy, Default, ImmutableOf, ValueOf, WithAccess } from "destack:memory";
import { Compare } from "destack:ops";
import { RangeBounds } from "destack:range";

import { SortedMap } from "./sorted-map.ds";

/// A compact sorted set.
@languageItem("collections.SortedSet")
export class SortedSet<T> {
    /// The backing sorted map.
    private map: ^SortedMap<T, void> = SortedMap.new();
}

export extension<T> of ^SortedSet<T> implements Iterable<T> {
    /// Consume this set into owned values.
    iterator(this): Iterator<T> {
        todo("SortedSet.iterator")
    }

    /// Consume two sets into their union.
    union(this, other: ^SortedSet<T>): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.union")
    }

    /// Consume two sets into their intersection.
    intersection(this, other: ^SortedSet<T>): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.intersection")
    }

    /// Consume two sets into their difference.
    difference(this, other: ^SortedSet<T>): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.difference")
    }

    /// Consume two sets into their symmetric difference.
    symmetricDifference(this, other: ^SortedSet<T>): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.symmetricDifference")
    }
}

export extension<T> of SortedSet<T> implements Iterable<T> where T: Copy {
    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("SortedSet.iterator")
    }

    /// Return the copied stored value equal to `value`.
    get<Q, const A: "readonly" | "immutable">(
        this: WithAccess<&readonly this, A>,
        value: ImmutableOf<Q>,
    ): T | undefined
        where T: Compare<Q>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never) {
        todo("SortedSet.get")
    }

    /// Return the copied first value.
    first(&readonly this): T | undefined {
        todo("SortedSet.first")
    }

    /// Return the copied last value.
    last(&readonly this): T | undefined {
        todo("SortedSet.last")
    }

    /// Return copied values in `range`.
    range<Q, R: RangeBounds<Q>>(range: R): Iterator<T> where T: Compare<Q> {
        todo("SortedSet.range")
    }
}

export extension<T, 'a> of Borrowed<SortedSet<T>, 'a, "immutable">
    implements Iterable<Borrowed<ValueOf<T>, 'a, "immutable">>
{
    /// Return an iterator over borrowed values.
    iterator(this): Iterator<Borrowed<ValueOf<T>, 'a, "immutable">> {
        todo("SortedSet.iterator")
    }

    /// Borrow the stored value equal to `value`.
    get<Q>(this, value: ImmutableOf<Q>): Borrowed<ValueOf<T>, 'a, "immutable"> | undefined
        where T: Compare<Q> {
        todo("SortedSet.get")
    }

    /// Return whether `value` is present.
    has<Q>(this, value: ImmutableOf<Q>): boolean where T: Compare<Q> {
        todo("SortedSet.has")
    }

    /// Borrow the first value.
    first(this): Borrowed<ValueOf<T>, 'a, "immutable"> | undefined {
        todo("SortedSet.first")
    }

    /// Borrow the last value.
    last(this): Borrowed<ValueOf<T>, 'a, "immutable"> | undefined {
        todo("SortedSet.last")
    }

    /// Return borrowed values in `range`.
    range<Q, R: RangeBounds<Q>>(this, range: R): Iterator<Borrowed<ValueOf<T>, 'a, "immutable">>
        where T: Compare<Q> {
        todo("SortedSet.range")
    }
}

export extension<T> of SortedSet<T> implements Default {
    /// Create an empty sorted set.
    static new(): ^SortedSet<T> {
        todo("SortedSet.new")
    }

    /// Create a sorted set with room for at least `capacity` values.
    static withCapacity(capacity: usize): ^SortedSet<T> {
        todo("SortedSet.withCapacity")
    }

    /// Create the default sorted set.
    static default(): ^SortedSet<T> {
        SortedSet.new()
    }
}

export extension<T> of SortedSet<T> {
    /// Create a sorted set from values.
    static from(values: Iterable<T>): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.from")
    }

    /// Create a sorted set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): ^SortedSet<T> where T: Compare<T> {
        todo("SortedSet.fromIterator")
    }

    /// Return the number of elements.
    get size(&readonly this): usize {
        this.map.size
    }

    /// Return whether this set has no elements.
    get isEmpty(&readonly this): boolean {
        this.map.isEmpty
    }

    /// Return whether `value` is present.
    has<Q, const A: "readonly" | "immutable">(
        this: WithAccess<&readonly this, A>,
        value: ImmutableOf<Q>,
    ): boolean where T: Compare<Q>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never) {
        todo("SortedSet.has")
    }

    /// Add `value` when absent.
    add<const A: "mutable" | "exclusive">(this: WithAccess<&this, A>, value: T): boolean
        where T: Compare<T>, A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never) {
        todo("SortedSet.add")
    }

    /// Remove `value`.
    remove<Q, const A: "mutable" | "exclusive">(
        this: WithAccess<&this, A>,
        value: ImmutableOf<Q>,
    ): T | undefined
        where T: Compare<Q>, A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never) {
        todo("SortedSet.remove")
    }

    /// Remove all values.
    clear(&this): void {
        todo("SortedSet.clear");
    }

    /// Retain only values accepted by `predicate`.
    retain(&exclusive this, predicate: (value: ImmutableOf<T>) => boolean): void {
        todo("SortedSet.retain");
    }

    /// Remove all values and return them.
    drain(&this): Iterator<T> {
        todo("SortedSet.drain")
    }

    /// Remove values accepted by `predicate` and return them.
    extractIf(&exclusive this, predicate: (value: ImmutableOf<T>) => boolean): Iterator<T> {
        todo("SortedSet.extractIf")
    }

    /// Reserve room for at least `additional` more values.
    reserve(&this, additional: usize): void {
        todo("SortedSet.reserve");
    }

    /// Shrink node storage to fit the current values.
    shrinkToFit(&this): void {
        todo("SortedSet.shrinkToFit");
    }

    /// Return the union of two sets.
    union(&readonly this, other: &readonly SortedSet<T>): ^SortedSet<T>
        where T: Compare<T>, T: Copy {
        todo("SortedSet.union")
    }

    /// Return the intersection with `other`.
    intersection(&readonly this, other: &readonly SortedSet<T>): ^SortedSet<T>
        where T: Compare<T>, T: Copy {
        todo("SortedSet.intersection")
    }

    /// Return this set without values in `other`.
    difference(&readonly this, other: &readonly SortedSet<T>): ^SortedSet<T>
        where T: Compare<T>, T: Copy {
        todo("SortedSet.difference")
    }

    /// Return values present in exactly one set.
    symmetricDifference(&readonly this, other: &readonly SortedSet<T>): ^SortedSet<T>
        where T: Compare<T>, T: Copy {
        todo("SortedSet.symmetricDifference")
    }

    /// Return whether this set is a subset of `other`.
    isSubsetOf<const A: "readonly" | "immutable">(
        this: WithAccess<&this, A>,
        other: WithAccess<&SortedSet<T>, A>,
    ): boolean where T: Compare<T>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never) {
        todo("SortedSet.isSubsetOf")
    }

    /// Return whether this set is a superset of `other`.
    isSupersetOf<const A: "readonly" | "immutable">(
        this: WithAccess<&this, A>,
        other: WithAccess<&SortedSet<T>, A>,
    ): boolean where T: Compare<T>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never) {
        todo("SortedSet.isSupersetOf")
    }

    /// Return whether this set has no overlap with `other`.
    isDisjointFrom<const A: "readonly" | "immutable">(
        this: WithAccess<&this, A>,
        other: WithAccess<&SortedSet<T>, A>,
    ): boolean where T: Compare<T>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never) {
        todo("SortedSet.isDisjointFrom")
    }
}

export extension<T: Compare<T>> of SortedSet<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create a managed sorted set from `values`.
    static from(values: Iterable<T>): SortedSet<T> {
        SortedSet.from(values)
    }

    /// Create a managed sorted set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): SortedSet<T> {
        SortedSet.fromIterator(values)
    }
}

export extension<T: Compare<T>> of ^SortedSet<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned sorted set from values.
    static from(values: Iterable<T>): ^SortedSet<T> {
        SortedSet.from(values)
    }

    /// Create an owned sorted set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): ^SortedSet<T> {
        SortedSet.fromIterator(values)
    }
}

export extension<T, const A: "mutable" | "exclusive"> of SortedSet<T>
    implements Extend<T, A>
    where T: Compare<T>, A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never)
{
    /// Add all `values`.
    extend<I: Iterable<T>>(this: WithAccess<&this, A>, values: I): void {
        todo("SortedSet.extend");
    }
}
