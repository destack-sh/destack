import { Borrow, From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Default } from "destack:memory";
import { Compare } from "destack:ops";
import { RangeBounds } from "destack:range";

import { SortedMap } from "./sorted-map.ds";

/// A compact sorted set.
export class SortedSet<T> {
    /// The backing sorted map.
    map: SortedMap<T, void>;
}

extension<T> of SortedSet<T> {
    /// Create an empty sorted set.
    static new(): ^SortedSet<T> {
        todo("SortedSet.new")
    }

    /// Create a sorted set with room for at least `capacity` values.
    static withCapacity(capacity: usize): ^SortedSet<T> {
        todo("SortedSet.withCapacity")
    }

    /// Create the default sorted set.
    static default(): ^SortedSet<T> {
        SortedSet.new()
    }
}

extension<T> of ^SortedSet<T> implements Default {
    /// Create the default owned sorted set.
    static default(): ^SortedSet<T> {
        SortedSet.default()
    }
}

extension<T: Compare<T>> of SortedSet<T> implements
    Iterable<T>,
    Iterable<&readonly T>,
    Extend<T, "exclusive"> {
    /// Create a sorted set from values.
    static from(values: Iterable<T>): ^SortedSet<T> {
        todo("SortedSet.from")
    }

    /// Create a sorted set from `values`.
    static fromIterator(values: Iterator<T>): ^SortedSet<T> {
        todo("SortedSet.fromIterator")
    }

    /// Return the number of elements.
    get size(): number {
        this.map.size
    }

    /// Return whether this set has no elements.
    get isEmpty(): boolean {
        this.map.isEmpty
    }

    /// Return whether `value` is present.
    has<Q: Compare<Q>>(value: &readonly Q): boolean where T: Borrow<Q> {
        todo("SortedSet.has")
    }

    /// Borrow the stored value equal to `value` with readonly access.
    get<Q: Compare<Q>>(&readonly this, value: &readonly Q): &readonly T | undefined
    where T: Borrow<Q> {
        todo("SortedSet.get")
    }

    /// Add `value` when absent.
    add(&exclusive this, value: T): boolean {
        todo("SortedSet.add")
    }

    /// Add all `values`.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("SortedSet.extend");
    }

    /// Remove `value`.
    remove<Q: Compare<Q>>(&exclusive this, value: &readonly Q): T | undefined where T: Borrow<Q> {
        todo("SortedSet.remove")
    }

    /// Remove all values.
    clear(&exclusive this): void {
        todo("SortedSet.clear");
    }

    /// Retain only values accepted by `predicate`.
    retain(&exclusive this, predicate: (value: &readonly T) => boolean): void {
        todo("SortedSet.retain");
    }

    /// Remove all values and return them.
    drain(&exclusive this): Iterator<T> {
        todo("SortedSet.drain")
    }

    /// Remove values accepted by `predicate` and return them.
    extractIf(&exclusive this, predicate: (value: &readonly T) => boolean): Iterator<T> {
        todo("SortedSet.extractIf")
    }

    /// Reserve room for at least `additional` more values.
    reserve(&exclusive this, additional: usize): void {
        todo("SortedSet.reserve");
    }

    /// Shrink node storage to fit the current values.
    shrinkToFit(&exclusive this): void {
        todo("SortedSet.shrinkToFit");
    }

    /// Return the union of two sets.
    union(other: &readonly SortedSet<T>): ^SortedSet<T> {
        todo("SortedSet.union")
    }

    /// Return the intersection with `other`.
    intersection(other: &readonly SortedSet<T>): ^SortedSet<T> {
        todo("SortedSet.intersection")
    }

    /// Return this set without values in `other`.
    difference(other: &readonly SortedSet<T>): ^SortedSet<T> {
        todo("SortedSet.difference")
    }

    /// Return values present in exactly one set.
    symmetricDifference(other: &readonly SortedSet<T>): ^SortedSet<T> {
        todo("SortedSet.symmetricDifference")
    }

    /// Return whether this set is a subset of `other`.
    isSubsetOf(other: &readonly SortedSet<T>): boolean {
        todo("SortedSet.isSubsetOf")
    }

    /// Return whether this set is a superset of `other`.
    isSupersetOf(other: &readonly SortedSet<T>): boolean {
        todo("SortedSet.isSupersetOf")
    }

    /// Return whether this set has no overlap with `other`.
    isDisjointFrom(other: &readonly SortedSet<T>): boolean {
        todo("SortedSet.isDisjointFrom")
    }

    /// Return the first value.
    first(&readonly this): &readonly T | undefined {
        todo("SortedSet.first")
    }

    /// Return the last value.
    last(&readonly this): &readonly T | undefined {
        todo("SortedSet.last")
    }

    /// Return values in `range` with readonly access.
    range<Q: Compare<Q>, R: RangeBounds<Q>>(&readonly this, range: R): Iterator<&readonly T>
    where T: Borrow<Q> {
        todo("SortedSet.range")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("SortedSet.iterator")
    }

    /// Return an iterator over readonly borrowed values.
    iterator(&readonly this): Iterator<&readonly T> {
        todo("SortedSet.iterator")
    }

    /// Consume this set into owned values.
    iterator(^this): Iterator<T> {
        todo("SortedSet.iterator")
    }
}

extension<T: Compare<T>> of ^SortedSet<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned sorted set from values.
    static from(values: Iterable<T>): ^SortedSet<T> {
        SortedSet.from(values)
    }

    /// Create an owned sorted set from `values`.
    static fromIterator(values: Iterator<T>): ^SortedSet<T> {
        SortedSet.fromIterator(values)
    }
}
