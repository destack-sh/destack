export extension<T, E: SharedSafe> of ConcurrentSet<T, E>
    implements From<Iterable<T>>, FromIterator<T>
    where E: Default, E: Equate<T>
{
    /// Create a managed concurrent set from `values`.
    static from(values: Iterable<T>): ConcurrentSet<T, E> {
        ConcurrentSet.from(values, E.default())
    }

    /// Create a managed concurrent set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): ConcurrentSet<T, E> {
        ConcurrentSet.fromIterator(values, E.default())
    }
}

export extension<T, E: SharedSafe> of ^ConcurrentSet<T, E>
    implements From<Iterable<T>>, FromIterator<T>
    where E: Default, E: Equate<T>
{
    /// Create an owned concurrent set from values.
    static from(values: Iterable<T>): ^ConcurrentSet<T, E> {
        ConcurrentSet.from(values, E.default())
    }

    /// Create an owned concurrent set from values.
    static fromIterator<I: Iterable<T>>(values: I): ^ConcurrentSet<T, E> {
        ConcurrentSet.fromIterator(values, E.default())
    }
}

export extension<T, E: SharedSafe> of ConcurrentSet<T, E> {
    /// Return the number of values.
    get size(&readonly this): usize {
        this.map.size
    }

    /// Return whether this set has no values.
    get isEmpty(&readonly this): boolean {
        this.map.isEmpty
    }

    /// Remove all values and return them.
    drain(&readonly this): Iterator<T> {
        todo("ConcurrentSet.drain")
    }

    /// Remove all values.
    clear(&readonly this): void {
        todo("ConcurrentSet.clear");
    }
}
