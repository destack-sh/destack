import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, Dispose, Region, SharedSafe } from "destack:memory";
import { Dereference, Equality, Equate } from "destack:ops";

import { ConcurrentMap, ConcurrentMapRead } from "./concurrent-map.ds";

/// Read guard for one concurrent set value.
export struct ConcurrentSetRead<'a, T, E = Equality<T>> implements !SharedSafe {
    /// The backing map read guard.
    private guard: ConcurrentMapRead<'a, T, void, E>;
}

/// A sharded concurrent hash set.
@languageItem("collections.ConcurrentSet")
export shared class ConcurrentSet<T, E: SharedSafe = Equality<T>> {
    /// The backing concurrent map.
    private map: ConcurrentMap<T, void, E>;

    /// Create a collection from values using its default comparer.
    constructor(values?: Iterable<T> | null) where E: Default, E: Equate<T> {
        todo("ConcurrentSet.constructor");
    }

    /// Create a collection from values using comparer.
    constructor(values: Iterable<T> | null | undefined, options: { comparer: E })
        where E: Equate<T> {
        todo("ConcurrentSet.constructor");
    }
}

export extension<'a, T, E> of ConcurrentSetRead<'a, T, E>
    implements Dispose, !Copy, Dereference<"readonly">
{
    /// The pointee type.
    type Target = T;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the stored value.
    get value(&readonly this): &immutable T {
        todo("ConcurrentSetRead.value")
    }

    /// Release this guard.
    dispose(this): void {
        todo("ConcurrentSetRead.dispose");
    }

    /// Borrow the stored value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("ConcurrentSetRead.dereference")
    }
}

export extension<T, E: SharedSafe> of ConcurrentSet<T, E> {
    /// Create an empty concurrent set.
    static new(comparer: E): ^ConcurrentSet<T, E> {
        todo("ConcurrentSet.new")
    }

    /// Create a concurrent set with room for at least `capacity` values.
    static withCapacity(capacity: usize, comparer: E): ^ConcurrentSet<T, E> {
        todo("ConcurrentSet.withCapacity")
    }

    /// Create an empty collection with its default comparer.
    static new(): ^ConcurrentSet<T, E> where E: Default {
        ConcurrentSet.new(E.default())
    }

    /// Create a collection with its default comparer and room for capacity entries.
    static withCapacity(capacity: usize): ^ConcurrentSet<T, E> where E: Default {
        ConcurrentSet.withCapacity(capacity, E.default())
    }
}

export extension<T, E: SharedSafe> of ConcurrentSet<T, E> implements Default where E: Default {
    /// Create the default concurrent set.
    static default(): ^ConcurrentSet<T, E> {
        ConcurrentSet.new(E.default())
    }
}

export extension<T, E: SharedSafe> of ConcurrentSet<T, E>
    implements Extend<T, "readonly">
