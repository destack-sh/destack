{
    /// Create a concurrent set from values.
    static from(values: Iterable<T>, comparer: E): ^ConcurrentSet<T, E> where E: Equate<T> {
        todo("ConcurrentSet.from")
    }

    /// Create a concurrent set from `values`.
    static fromIterator<I: Iterable<T>>(values: I, comparer: E): ^ConcurrentSet<T, E>
        where E: Equate<T> {
        todo("ConcurrentSet.fromIterator")
    }

    /// Return whether `value` is present.
    has<Q>(&readonly this, value: Q): boolean where E: Equate<T, Q>, Q: Copy {
        todo("ConcurrentSet.has")
    }

    /// Look up a borrowed value using the stored comparer.
    has<Q>(&readonly this, value: &immutable Q): boolean where E: Equate<T, Q> {
        todo("ConcurrentSet.has")
    }

    /// Copy and return the stored value equal to `value`.
    get<Q>(&readonly this, value: Q): T | undefined where E: Equate<T, Q>, T: Copy, Q: Copy {
        todo("ConcurrentSet.get")
    }

    /// Look up a borrowed value using the stored comparer.
    get<Q>(&readonly this, value: &immutable Q): T | undefined where E: Equate<T, Q>, T: Copy {
        todo("ConcurrentSet.get")
    }

    /// Return a read guard for one stored value.
    read<'a, Q>(&'a readonly this, value: Q): ConcurrentSetRead<'a, T, E> | undefined
        where E: Equate<T, Q>, Q: Copy {
        todo("ConcurrentSet.read")
    }

    /// Look up a borrowed value using the stored comparer.
    read<'a, Q>(&'a readonly this, value: &immutable Q): ConcurrentSetRead<'a, T, E> | undefined
        where E: Equate<T, Q> {
        todo("ConcurrentSet.read")
    }

    /// Call `body` with readonly access to one stored value.
    with<Q, R>(&readonly this, value: Q, body: (value: &immutable T) => R): R | undefined
        where E: Equate<T, Q>, Q: Copy {
        todo("ConcurrentSet.with")
    }

    /// Look up a borrowed value using the stored comparer.
    with<Q, R>(&readonly this, value: &immutable Q, body: (value: &immutable T) => R): R | undefined
        where E: Equate<T, Q> {
        todo("ConcurrentSet.with")
    }

