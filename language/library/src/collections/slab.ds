import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, MaybeUninit, WithAccess } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

import { Array } from "./array.ds";

/// Key for one live slab entry.
export newtype SlabKey = {
    /// The slot index.
    index: uint32;

    /// The slot generation.
    generation: uint32;
};

/// One slab storage slot.
struct SlabSlot<T> {
    /// The current slot generation.
    generation: uint32 = 0;

    /// The next free slot index.
    nextFree: uint32 | undefined = undefined;

    /// True when this slot currently holds a value.
    isOccupied: boolean = false;

    /// The slot value storage.
    value: MaybeUninit<T>;
}

/// A generational slab with stable keys and reusable slots.
export struct Slab<T> {
    /// The slot storage.
    private slots: Array<SlabSlot<T>>;

    /// The first free slot index.
    private firstFree: uint32 | undefined = undefined;

    /// The number of live entries.
    private count: usize = 0;
}

export extension<T: Copy> of Slab<T> {
    /// Return the copied value for `key`.
    get(&readonly this, key: SlabKey): T | undefined {
        todo("Slab.get")
    }

    /// Return copied live values.
    values(&readonly this): Iterator<T> {
        todo("Slab.values")
    }

    /// Return copied live entries.
    entries(&readonly this): Iterator<(SlabKey, T)> {
        todo("Slab.entries")
    }
}

export extension<T> of Slab<T> implements Iterable<(SlabKey, T)> {
    /// Consume this slab into owned entries.
    iterator(this): Iterator<(SlabKey, T)> {
        todo("Slab.iterator")
    }
}

export extension<T, 'a, comptime A: Access> of Borrowed<Slab<T>, 'a, A>
    implements
        Iterable<(SlabKey, Borrowed<T, 'a, A>)> {
    /// Borrow the value for `key`.
    get(key: SlabKey): Borrowed<T, 'a, A> | undefined {
        todo("Slab.get")
    }

    /// Return borrowed live values.
    values(): Iterator<Borrowed<T, 'a, A>> {
        todo("Slab.values")
    }

    /// Return borrowed live entries.
    entries(): Iterator<(SlabKey, Borrowed<T, 'a, A>)> {
        todo("Slab.entries")
    }

    /// Return an iterator over borrowed live entries.
    iterator(): Iterator<(SlabKey, Borrowed<T, 'a, A>)> {
        todo("Slab.iterator")
    }
}

export extension<T> of Slab<T>
    implements
        Index<SlabKey>,
        IndexSet<SlabKey, T>,
        From<Iterable<T>>,
        FromIterator<T>,
        Extend<T, "exclusive">,
        Default {
    /// The indexed output type.
    type Output = T;

    /// The missing index result.
    type Missing = undefined;

    /// Create an empty slab.
    static new(): Slab<T> {
        todo("Slab.new")
    }

    /// Create a slab with room for at least `capacity` entries.
    static withCapacity(capacity: usize): Slab<T> {
        todo("Slab.withCapacity")
    }

    /// Create a slab from values.
    static from(values: Iterable<T>): Slab<T> {
        todo("Slab.from")
    }

    /// Create a slab from `values`.
    static fromIterator<R>(values: Iterator<T, R>): Slab<T> {
        todo("Slab.fromIterator")
    }

    /// Create the default slab.
    static default(): Slab<T> {
        Slab.new()
    }

    /// Return the number of live entries.
    get size(): usize {
        this.count
    }

    /// Return the allocated slot count.
    get capacity(): usize {
        this.slots.capacity
    }

    /// Return whether this slab has no live entries.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Insert `value` and return its key.
    insert(&exclusive this, value: T): SlabKey {
        todo("Slab.insert")
    }

    /// Insert all `values`.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("Slab.extend");
    }

    /// Remove and return the value for `key`.
    remove(&exclusive this, key: SlabKey): T | undefined {
        todo("Slab.remove")
    }

    /// Return whether `key` identifies a live entry.
    has(key: &readonly SlabKey): boolean {
        todo("Slab.has")
    }

    /// Borrow the value for `key` through the index operator.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&Slab<T>, A>,
        key: SlabKey,
    ): WithAccess<&T, A> | undefined {
        this.get(key)
    }

    /// Replace the value for `key` through the index operator.
    indexSet(&exclusive this, key: SlabKey, value: T): void {
        this.set(key, value);
    }

    /// Insert or replace the value for `key`.
    set(&exclusive this, key: SlabKey, value: T): boolean {
        todo("Slab.set")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(&exclusive this, additional: usize): void {
        todo("Slab.reserve");
    }

    /// Remove all entries.
    clear(&exclusive this): void {
        todo("Slab.clear");
    }

    /// Retain only entries accepted by `predicate`.
    retain(&exclusive this, predicate: (key: SlabKey, value: &exclusive T) => boolean): void {
        todo("Slab.retain");
    }

    /// Remove all entries and return them.
    drain(&exclusive this): Iterator<(SlabKey, T)> {
        todo("Slab.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        &exclusive this,
        predicate: (key: SlabKey, value: &exclusive T) => boolean,
    ): Iterator<(SlabKey, T)> {
        todo("Slab.extractIf")
    }

    /// Shrink storage to fit live and reusable slots.
    shrinkToFit(&exclusive this): void {
        todo("Slab.shrinkToFit");
    }

    /// Return all live keys.
    keys(&readonly this): Iterator<SlabKey> {
        todo("Slab.keys")
    }
}
