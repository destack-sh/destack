import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Clone, Default } from "destack:memory";
import { Atomic } from "destack:sync";

/// A concurrent multi-producer multi-consumer queue.
export shared class ConcurrentQueue<in out T> {
    /// The queue state.
    state: Atomic<uint64> = Atomic.new(0);
}

export extension<T> of ConcurrentQueue<T> implements Default, Extend<T> {
    /// Create an empty concurrent queue.
    static new(): ^ConcurrentQueue<T> {
        todo("ConcurrentQueue.new")
    }

    /// Create a concurrent queue from values.
    static from(values: Iterable<T>): ^ConcurrentQueue<T> {
        todo("ConcurrentQueue.from")
    }

    /// Create a concurrent queue from `values`.
    static fromIterator<R>(values: Iterator<T, R>): ^ConcurrentQueue<T> {
        todo("ConcurrentQueue.fromIterator")
    }

    /// Create the default concurrent queue.
    static default(): ^ConcurrentQueue<T> {
        ConcurrentQueue.new()
    }

    /// Return whether this queue is currently empty.
    get isEmpty(): boolean {
        todo("ConcurrentQueue.isEmpty")
    }

    /// Push `value` to the back of the queue.
    push(&this, value: T): void {
        todo("ConcurrentQueue.push");
    }

    /// Append all `values` to the back of the queue.
    extend(&this, values: Iterable<T>): void {
        todo("ConcurrentQueue.extend");
    }

    /// Clone and return the front value without removing it.
    peek(&this): T | undefined where T: Clone {
        todo("ConcurrentQueue.peek")
    }

    /// Remove and return the front value.
    pop(&this): T | undefined {
        todo("ConcurrentQueue.pop")
    }
}

export extension<T> of ^ConcurrentQueue<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned concurrent queue from values.
    static from(values: Iterable<T>): ^ConcurrentQueue<T> {
        ConcurrentQueue.from(values)
    }

    /// Create an owned concurrent queue from values.
    static fromIterator<R>(values: Iterator<T, R>): ^ConcurrentQueue<T> {
        ConcurrentQueue.fromIterator(values)
    }
}
