import { Borrow, From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, MaybeUninit, WithAccess } from "destack:memory";
import { Compare, Index, IndexSet } from "destack:ops";
import { RangeBounds } from "destack:range";

import { Array } from "./array.ds";

/// Key for one sorted map node.
newtype SortedMapNodeKey = uint32;

/// One sorted map entry.
export struct SortedMapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one sorted map entry.
export struct SortedMapEntryHandle<'a, K, V> {
    /// The borrowed map.
    private map: &'a SortedMap<K, V>;

    /// The queried key.
    private entryKey: K;
}

/// One sorted map tree node.
struct SortedMapNode<K, V> {
    /// The node entry storage.
    entry: MaybeUninit<SortedMapEntry<K, V>>;

    /// The left child key.
    left: SortedMapNodeKey | undefined = undefined;

    /// The right child key.
    right: SortedMapNodeKey | undefined = undefined;

    /// The parent node key.
    parent: SortedMapNodeKey | undefined = undefined;

    /// The next free node key.
    nextFree: SortedMapNodeKey | undefined = undefined;

    /// The node balance factor.
    balance: int8 = 0;

    /// True when this node currently holds an entry.
    isOccupied: boolean = true;
}

/// A compact sorted map.
@languageItem("collections.SortedMap")
export class SortedMap<K, V> {
    /// The root node key.
    private root: SortedMapNodeKey | undefined = undefined;

    /// The node storage.
    private nodes: Array<SortedMapNode<K, V>> = [];

    /// The first free node key.
    private firstFree: SortedMapNodeKey | undefined = undefined;

    /// The number of live entries.
    private count: usize = 0;
}

export extension<K: Compare<K>, V> of ^SortedMap<K, V> implements Iterable<(K, V)> {
    /// Consume this map into owned entries.
    iterator(): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }
}

export extension<K: Compare<K>, V> of SortedMap<K, V>
    implements Iterable<(K, V)>
    where K: Copy, V: Copy
{
    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("SortedMap.iterator")
    }

    /// Return copied entries in key order.
    entries(): Iterator<(K, V)> {
        todo("SortedMap.entries")
    }
}

export extension<K: Compare<K>, V> of SortedMap<K, V> where K: Copy {
    /// Return copied keys in key order.
    keys(): Iterator<K> {
        todo("SortedMap.keys")
    }
}

export extension<K: Compare<K>, V> of SortedMap<K, V> where V: Copy {
    /// Return copied values in key order.
    values(): Iterator<V> {
        todo("SortedMap.values")
    }

    /// Return a copied value by key.
    get<Q: Compare<Q>>(key: &readonly Q): V | undefined where K: Borrow<Q> {
        todo("SortedMap.get")
    }
}

