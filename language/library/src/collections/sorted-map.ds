    implements Iterable<SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>>
{
    /// Return an iterator over borrowed entries.
    iterator(): Iterator<SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>> {
        todo("SortedMap.iterator")
    }

    /// Return borrowed keys in key order.
    keys(): Iterator<Borrowed<K, 'a, "readonly">> {
        todo("SortedMap.keys")
    }

    /// Return borrowed values in key order.
    values(): Iterator<Borrowed<V, 'a, A>> {
        todo("SortedMap.values")
    }

    /// Borrow a value by key.
    get<Q: Compare<Q>>(key: &readonly Q): Borrowed<V, 'a, A> | undefined where K: Borrow<Q> {
        todo("SortedMap.get")
    }

    /// Return whether `key` exists.
    has<Q: Compare<Q>>(key: &readonly Q): boolean where K: Borrow<Q> {
        todo("SortedMap.has")
    }

    /// Borrow the first entry.
    firstEntry(): SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>> | undefined {
        todo("SortedMap.firstEntry")
    }

    /// Borrow the last entry.
    lastEntry(): SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>> | undefined {
        todo("SortedMap.lastEntry")
    }

    /// Return borrowed entries in key order.
    entries(): Iterator<SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>> {
        todo("SortedMap.entries")
    }

    /// Return borrowed entries in `range`.
    range<Q: Compare<Q>, R: RangeBounds<Q>>(
        range: R,
    ): Iterator<SortedMapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>>
        where K: Borrow<Q> {
        todo("SortedMap.range")
    }
}

