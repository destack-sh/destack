import { Access, WithAccess } from "destack:memory";

/// Finite ordered indexed collection.
@languageItem("collections.Sequence")
export newtype interface Sequence<T> {
    /// The contiguous range view type.
    type View;

    /// Return the number of elements.
    get length(): usize;

    /// Return the element at `index` by value.
    index(index: usize): T;

    /// Borrow a view over `start..end`.
    view<comptime A: Access = "readonly">(
        this: WithAccess<&this, A>,
        start: usize,
        end?: usize,
    ): WithAccess<&this.View, A>;

    /// Return the elements from `start..end` as an owned array.
    rest(start: usize, end?: usize): T[];
}
