/// Finite ordered collection destructured by sequence patterns.
@languageItem("collections.Sequence")
export newtype interface Sequence {
    /// The sequence produced by a rest pattern.
    type Rest;

    /// Return the number of elements.
    get length(): isize;

    /// Return the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): this.Rest;
}
