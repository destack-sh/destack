import { As, Borrow, From } from "destack:convert";
import { panic, todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, MaybeUninit, WithAccess } from "destack:memory";
import { Compare, Index, IndexSet, Ordering } from "destack:ops";
import { Bound, RangeBounds } from "destack:range";

import { Array } from "./array.ds";
import { FixedArray } from "./fixed-array.ds";
import { Sequence } from "./sequence.ds";
import { Slice } from "./slice.ds";

/// A growable contiguous array with inline storage.
@languageItem("collections.SmallArray")
export struct SmallArray<T, const N: usize> {
    /// The inline storage.
    private inlineStorage: FixedArray<MaybeUninit<T>, N>;

    /// The heap storage used after spilling past inline capacity.
    private spillStorage: ^[MaybeUninit<T>] | undefined = undefined;

    /// The number of initialized elements.
    private count: isize = 0;

    /// The allocated spill element count.
    private spillCapacity: usize = 0;
}

export extension<T, const N: usize> of SmallArray<T, N> implements Iterable<T>, Sequence {
    /// The owned sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Move the elements from `start..end` for a rest pattern.
    rest(this, start: isize, end?: isize): ^Array<T> {
        todo("SmallArray.rest")
    }

    /// Consume this small array into owned values.
    iterator(this): Iterator<T> {
        todo("SmallArray.iterator")
    }
}

export extension<T, const N: usize, 'a, const A: Access> of Borrowed<SmallArray<T, N>, 'a, A>
    implements Iterable<Borrowed<T, 'a, A>>, Sequence
{
    /// The borrowed sequence produced by a rest pattern.
    type Rest = ^Array<Borrowed<T, 'a, A>>;

    /// Borrow the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Array<Borrowed<T, 'a, A>> {
        todo("SmallArray.rest")
    }

    /// Return an iterator over borrowed values.
    iterator(): Iterator<Borrowed<T, 'a, A>> {
        todo("SmallArray.iterator")
    }

    /// Borrow the first element.
    first(): Borrowed<T, 'a, A> | undefined {
        todo("SmallArray.first")
    }

    /// Borrow the last element.
    last(): Borrowed<T, 'a, A> | undefined {
        todo("SmallArray.last")
    }
}

export extension<T, const N: usize> of SmallArray<T, N>
    implements
        Index<isize>,
        IndexSet<isize, T>,
        From<Iterable<T>>,
        FromIterator<T>,
        Extend<T, "exclusive">,
        Default,
        From<T[]>,
        From<[T; N]>
{
    /// The indexed output type.
    type Output = T;

    /// Create an empty small array.
    static new(): SmallArray<T, N> {
        todo("SmallArray.new")
    }

    /// Create a small array with room for at least `capacity` elements.
    static withCapacity(capacity: usize): SmallArray<T, N> {
        todo("SmallArray.withCapacity")
    }

    /// Create a small array from `values`.
    static from(values: Iterable<T>): SmallArray<T, N> {
        todo("SmallArray.from")
    }

    /// Create a small array from `values`.
    static fromIterator(values: Iterator<T>): SmallArray<T, N> {
        todo("SmallArray.fromIterator")
    }

    /// Create the default small array.
    static default(): SmallArray<T, N> {
        SmallArray.new()
    }

    /// Create a small array from an array.
    static from(value: T[]): SmallArray<T, N> {
        todo("SmallArray.fromArray")
    }

    /// Create a small array from a fixed array.
    static from(value: [T; N]): SmallArray<T, N> {
        todo("SmallArray.fromFixedArray")
    }

    /// Move this small array into owned array storage.
    toArray(&readonly this): ^Array<T> {
        todo("SmallArray.toArray")
    }

    /// Return the number of elements.
    get length(&readonly this): isize {
        this.count
    }

    /// Return the number of elements.
    get size(&readonly this): isize {
        this.count
    }

    /// Return the allocated element count.
    get capacity(&readonly this): usize {
        this.spillStorage == undefined ? N : this.spillCapacity
    }

    /// Return the inline element count.
    get inlineCapacity(&readonly this): usize {
        N
    }

    /// Return whether this array currently uses inline storage.
    get isInline(&readonly this): boolean {
        this.spillStorage == undefined
    }

    /// Return whether this array has no elements.
    get isEmpty(&readonly this): boolean {
        this.count == 0
    }

    /// Borrow a view over `start..end`.
    view<const A: Access = "readonly">(
        this: WithAccess<&SmallArray<T, N>, A>,
        start: isize,
        end?: isize,
    ): WithAccess<&[T], A> {
        todo("SmallArray.view")
    }

    /// Borrow the element at `index`.
    index<const A: Access = "readonly">(
        this: WithAccess<&SmallArray<T, N>, A>,
        index: isize,
    ): WithAccess<&T, A> {
        todo("SmallArray.index")
    }

    /// Replace the element at `index`.
    indexSet(&exclusive this, index: isize, value: T): void {
        todo("SmallArray.indexSet");
    }

    /// Append `value`.
    push(&exclusive this, value: T): void {
        todo("SmallArray.push");
    }

    /// Append all `values`.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("SmallArray.extend");
    }

    /// Remove and return the last element.
    pop(&exclusive this): T | undefined {
        todo("SmallArray.pop")
    }

    /// Remove and return the last element when `predicate` accepts it.
    popIf(&exclusive this, predicate: (value: &readonly T) => boolean): T | undefined {
        todo("SmallArray.popIf")
    }

    /// Insert `value` at `index`.
    insert(&exclusive this, index: isize, value: T): void {
        todo("SmallArray.insert");
    }

    /// Remove and return the element at `index`.
    removeAt(&exclusive this, index: isize): T {
        todo("SmallArray.removeAt")
    }

    /// Swap-remove the element at `index`.
    swapRemove(&exclusive this, index: isize): T {
        todo("SmallArray.swapRemove")
    }

    /// Remove all elements.
    clear(&exclusive this): void {
        todo("SmallArray.clear");
    }

    /// Retain only elements accepted by `predicate`.
    retain(&exclusive this, predicate: (value: &readonly T, index: isize) => boolean): void {
        todo("SmallArray.retain");
    }

    /// Remove all elements and return them.
    drain(&exclusive this): Iterator<T> {
        todo("SmallArray.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(
        &exclusive this,
        predicate: (value: &readonly T, index: isize) => boolean,
    ): Iterator<T> {
        todo("SmallArray.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&exclusive this, additional: usize): void {
        todo("SmallArray.reserve");
    }

    /// Move elements back inline when they fit.
    shrinkToInline(&exclusive this): void {
        todo("SmallArray.shrinkToInline");
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(&exclusive this): void {
        todo("SmallArray.shrinkToFit");
    }

    /// Move the selected range into a new small array.
    slice(this, start?: isize, end?: isize): SmallArray<T, N> {
        todo("SmallArray.slice")
    }

    /// Reverse this array in place.
    reverse(&exclusive this): this {
        todo("SmallArray.reverse")
    }

    /// Sort this array by its natural order.
    sort(&exclusive this): this where T: Compare<T> {
        todo("SmallArray.sort")
    }

    /// Sort this array with borrowed values.
    sort(&exclusive this, compare: (left: &readonly T, right: &readonly T) => Ordering): this {
        todo("SmallArray.sort")
    }

    /// Sort this array by its natural order without preserving equal-element order.
    sortUnstable(&exclusive this): this where T: Compare<T> {
        todo("SmallArray.sortUnstable")
    }

    /// Sort this array without preserving equal-element order.
    sortUnstable(
        &exclusive this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): this {
        todo("SmallArray.sortUnstable")
    }
}

export extension<T, const N: usize, const A: Access = "readonly"> of SmallArray<T, N>
    implements As<[T], A>, Borrow<[T], A>
{
    /// Borrow the initialized storage as a slice.
    as(this: WithAccess<&SmallArray<T, N>, A>): WithAccess<&[T], A> {
        todo("SmallArray.as")
    }

    /// Borrow the initialized storage as a slice.
    borrow(this: WithAccess<&SmallArray<T, N>, A>): WithAccess<&[T], A> {
        this.as()
    }
}

export extension<T, const N: usize, R: RangeBounds<isize>, const A: Access = "readonly"> of
    SmallArray<T, N>
    implements Index<R, A>
{
    /// The indexed output type.
    type Output = [T];

    /// Return the normalized start and length for `range`.
    rangeSpan(&readonly this, range: &readonly R): (isize, isize) {
        let start = match (range.startBound()) {
            { kind: "included", value } => *value
            { kind: "excluded", value } => *value + 1
            { kind: "unbounded" } => 0
        };

        let end = match (range.endBound()) {
            { kind: "included", value } => *value + 1
            { kind: "excluded", value } => *value
            { kind: "unbounded" } => this.size
        };

        if (start > end || end > this.size) {
            panic("small array range out of bounds")
        }

        (start, end - start)
    }

    /// Borrow the selected range as a view.
    index(this: WithAccess<&SmallArray<T, N>, A>, range: R): WithAccess<&[T], A> {
        todo("SmallArray.indexRange")
    }
}

export extension<T, const N: usize, R: RangeBounds<isize>> of SmallArray<T, N>
    implements IndexSet<R, [T]>
    where T: Copy
{
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: [T]): void {
        todo("SmallArray.indexSetRange");
    }
}

export extension<T, const N: usize, R: RangeBounds<isize>> of SmallArray<T, N>
    implements IndexSet<R, &readonly [T]>
    where T: Copy
{
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: &readonly [T]): void {
        todo("SmallArray.indexSetRange");
    }
}
