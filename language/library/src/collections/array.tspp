export extension<T, const A: Access> of Array<T>
    implements As<[T], A>, Borrow<[T], A>
    where A: "immutable" | "exclusive" | ((T,) extends (Copy,) ? Access : never)
{
    /// Borrow the initialized storage as a slice.
    as<const R: Region>(this: Borrowed<Array<T>, R, A>): Borrowed<[T], R, A> {
        todo("Array.as")
    }

    /// Borrow the initialized storage as a slice.
    borrow<const R: Region>(this: Borrowed<Array<T>, R, A>): Borrowed<[T], R, A> {
        this.as()
