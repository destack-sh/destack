    /// Return the first copied element accepted by `predicate`.
    find(&readonly this, predicate: (value: T, index: isize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Return the first accepted copied element's index, or -1 when absent.
    findIndex(&readonly this, predicate: (value: T, index: isize) => boolean): isize {
        todo("Array.findIndex")
    }

    /// Return the last copied element accepted by `predicate`.
