    ): ^Array<Borrowed<T, 'a, A>> {
        todo("Array.filter")
    }

    /// Map borrowed elements and keep defined values.
    filterMap<U>(
        this,
        map: (value: Borrowed<T, 'a, "immutable">, index: isize) => U | undefined,
    ): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Reduce borrowed elements from left to right.
    reduce<U>(
        this,
        reduce: (accumulator: U, value: Borrowed<T, 'a, "immutable">, index: isize) => U,
        initial: U,
    ): U {
        todo("Array.reduce")
    }

    /// Reduce borrowed elements from right to left.
    reduceRight<U>(
        this,
        reduce: (accumulator: U, value: Borrowed<T, 'a, "immutable">, index: isize) => U,
        initial: U,
    ): U {
        todo("Array.reduceRight")
    }

    /// Borrow the first element accepted by `predicate`.
    find(
        this,
        predicate: (value: &immutable T, index: isize) => boolean,
