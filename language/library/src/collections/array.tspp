import { As, Borrow, From } from "tspp:convert";
import { Result, todo } from "tspp:error";
import { Extend, FromIterator, Iterable, Iterator, IteratorResult } from "tspp:iter";
import {
    Access,
    AllocationError,
    Borrowed,
    Clone,
    Copy,
    Default,
    Drop,
    MaybeUninit,
    Region,
    WithAccess,
} from "tspp:memory";
import { Compare, Display, Index, IndexSet, Ordering, PartialEqual, StrictEqual } from "tspp:ops";
import { RangeBounds } from "tspp:range";

import { Sequence } from "./sequence.tspp";
import { Slice } from "./slice.tspp";

/// Readonly view of a dynamic array.
@languageItem("collections.ReadonlyArray")
export type ReadonlyArray<T> = readonly T[];

/// The element produced by flattening `T` through `Depth` nested arrays.
export type FlattenedElement<T, Depth: usize> = usize extends Depth
    ? unknown
    : Depth extends 0
      ? T
      : T extends ReadonlyArray<infer U>
        ? FlattenedElement<U, Depth - 1>
        : T;

/// A growable compact array.
@languageItem("collections.Array")
export class Array<T> {
    /// The contiguous storage.
    private storage: ^[MaybeUninit<T>] = Slice.new();

    /// The number of initialized elements.
    private count: isize = 0;

    /// The allocated element count.
    private allocated: usize = 0;
}

export extension<T: Clone> of Array<T> implements Clone {
    /// Clone this array and its elements.
    clone(this: &immutable this): ^this {
        todo("Array.clone")
    }
}

export extension<T> of Array<T> implements Drop {
    /// Drop the initialized elements.
    drop(&exclusive this): void {
        todo("Array.drop");
    }
}

export extension<T> of ^Array<T> implements Iterable<T>, Sequence {
    /// The owned sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Move the elements from `start..end` for a rest pattern.
    rest(this, start: isize, end?: isize): ^Array<T> {
        todo("Array.rest")
    }

    /// Consume this array into owned values.
    iterator(this): this.Iterator {
        todo("Array.iterator")
    }

    /// Consume this array and map its elements into a new array.
    map<U>(this, map: (value: T, index: isize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Consume this array and retain elements accepted by `predicate`.
    filter(this, predicate: (value: &immutable T, index: isize) => boolean): ^Array<T> {
        todo("Array.filter")
    }

    /// Consume this array and keep defined mapped values.
    filterMap<U>(this, map: (value: T, index: isize) => U | undefined): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Consume and reduce elements from left to right.
    reduce<U>(this, reduce: (accumulator: U, value: T, index: isize) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Consume and reduce elements from right to left.
    reduceRight<U>(this, reduce: (accumulator: U, value: T, index: isize) => U, initial: U): U {
        todo("Array.reduceRight")
    }

    /// Consume this array and return the first accepted element.
    find(this, predicate: (value: &immutable T, index: isize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Consume this array and return the last accepted element.
    findLast(this, predicate: (value: &immutable T, index: isize) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Consume and map elements, then flatten the results.
    flatMap<U>(this, map: (value: T, index: isize) => U | ^Array<U>): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Consume this array into an iterator over values.
    values(this): Iterator<T> {
        todo("Array.values")
    }

    /// Consume this array into an iterator over index-value entries.
    entries(this): Iterator<(isize, T)> {
        todo("Array.entries")
    }
}

