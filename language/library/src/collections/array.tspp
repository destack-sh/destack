    /// Return whether every copied element is accepted by `predicate`.
    every(&readonly this, predicate: (value: T, index: isize) => boolean): boolean {
        todo("Array.every")
    }

    /// Fill this array and return its managed reference.
    fill(value: T, start?: isize, end?: isize): this {
        todo("Array.fill")
    }

    /// Copy a range and return this array's managed reference.
    copyWithin(target: isize, start: isize, end?: isize): this {
        todo("Array.copyWithin")
    }

    /// Reverse this array and return its managed reference.
    reverse(): this {
        todo("Array.reverse")
    }

    /// Sort this array by ascending string conversion, placing undefined last.
    sort(): this {
        todo("Array.sort")
    }

    /// Sort this array with copied values.
    sort(compare: (left: T, right: T) => number): this {
