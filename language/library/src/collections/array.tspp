        todo("Array.find")
    }

    /// Return the first accepted borrowed element's index, or -1 when absent.
    findIndex(this, predicate: (value: &immutable T, index: isize) => boolean): isize {
        todo("Array.findIndex")
    }

    /// Borrow the last element accepted by `predicate`.
    findLast(
        this,
        predicate: (value: &immutable T, index: isize) => boolean,
    ): Borrowed<T, 'a, A> | undefined {
        todo("Array.findLast")
    }

    /// Return the last accepted borrowed element's index, or -1 when absent.
    findLastIndex(this, predicate: (value: &immutable T, index: isize) => boolean): isize {
        todo("Array.findLastIndex")
    }

    /// Return whether any borrowed element is accepted by `predicate`.
    some(this, predicate: (value: &immutable T, index: isize) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every borrowed element is accepted by `predicate`.
    every(this, predicate: (value: &immutable T, index: isize) => boolean): boolean {
