import { From } from "destack:convert";
import { panic, todo } from "destack:error";
import { FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Copy, Default, Raw, WithAccess } from "destack:memory";
import { Index, IndexSet } from "destack:ops";
import { Bound, RangeBounds } from "destack:range";

/// Well-known library type for the builtin slice form `[T]`.
@languageItem("collections.Slice")
export newtype Slice<T> = [T];

extension<T> of Slice<T> implements
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    From<Iterable<T>>,
    FromIterator<T>,
    Default {
    /// Create an empty slice.
    static new(): Slice<T> {
        todo("Slice.new")
    }

    /// Create a slice from `values`.
    static from(values: Iterable<T>): Slice<T> {
        todo("Slice.from")
    }

    /// Create a slice from `values`.
    static fromIterator(values: Iterator<T>): Slice<T> {
        todo("Slice.fromIterator")
    }

    /// Create the default slice.
    static default(): Slice<T> {
        Slice.new()
    }

    /// Build a raw slice from raw storage.
    @unsafe
    @intrinsic("collections.slice.fromRaw")
    static fromRaw(data: *T, length: usize): Raw<Slice<T>>;

    /// Return the number of elements.
    get length(): number {
        this.size as number
    }

    /// Return the number of elements.
    @intrinsic("collections.slice.length")
    get size(): usize;

    /// Return whether this slice has no elements.
    get isEmpty(): boolean {
        this.size == 0
    }

    /// Load one element without bounds checks.
    @unsafe
    @intrinsic("collections.slice.get")
    unsafeGet(this: &readonly Slice<T>, index: usize): T;

    /// Store one element without bounds checks.
    @unsafe
    @intrinsic("collections.slice.set")
    unsafeSet(this: &exclusive Slice<T>, index: usize, value: T): void;

    /// Return the first element by value.
    first(): T | undefined {
        if (this.size == 0) {
            return undefined;
        }

        this.index(0)
    }

    /// Borrow the first element.
    first<A: Access = "readonly">(this: WithAccess<&Slice<T>, A>): WithAccess<&T, A> | undefined {
        todo("Slice.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        let length = this.size;

        if (length == 0) {
            return undefined;
        }

        this.index((length as number) - 1)
    }

    /// Borrow the last element.
    last<A: Access = "readonly">(this: WithAccess<&Slice<T>, A>): WithAccess<&T, A> | undefined {
        todo("Slice.last")
    }

    /// Borrow a contiguous range.
    @intrinsic("collections.slice.subslice")
    subslice<A: Access = "readonly">(
        this: WithAccess<&Slice<T>, A>,
        start: usize,
        length: usize,
    ): WithAccess<&Slice<T>, A>;

    /// Borrow a selected range.
    slice<A: Access = "readonly">(
        this: WithAccess<&Slice<T>, A>,
        start?: number,
        end?: number,
    ): WithAccess<&Slice<T>, A> {
        todo("Slice.slice")
    }

    /// Split this slice into two borrowed ranges.
    splitAt<A: Access = "readonly">(
        this: WithAccess<&Slice<T>, A>,
        index: number,
    ): (WithAccess<&Slice<T>, A>, WithAccess<&Slice<T>, A>) {
        todo("Slice.splitAt")
    }

    /// Fill this slice with `value`.
    fill(this: &exclusive Slice<T>, value: T): void {
        todo("Slice.fill");
    }

    /// Copy elements from `source` into this slice.
    copyFrom(this: &exclusive Slice<T>, source: &readonly Slice<T>): void where T: Copy {
        if (source.size != this.size) {
            panic("slice copy length mismatch")
        }

        for (let index: usize = 0; index < this.size; index += 1) {
            this.unsafeSet(index, source.unsafeGet(index));
        }
    }

    /// Swap two elements.
    swap(this: &exclusive Slice<T>, a: number, b: number): void {
        todo("Slice.swap");
    }

    /// Reverse this slice in place.
    reverse(this: &exclusive Slice<T>): void {
        todo("Slice.reverse");
    }

    /// Sort this slice in place.
    sort(this: &exclusive Slice<T>, compare?: (a: &readonly T, b: &readonly T) => number): void {
        todo("Slice.sort");
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Slice.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator<A: Access = "readonly">(this: WithAccess<&Slice<T>, A>): Iterator<WithAccess<&T, A>> {
        todo("Slice.iterator")
    }
}

extension<T> of Slice<T> implements Index<usize>, IndexSet<usize, T> {
    /// The indexed output type.
    type Output = T;

    /// Return the element at `index` by value.
    index(index: usize): T {
        todo("Slice.index")
    }

    /// Borrow the element at `index`.
    index<A: Access = "readonly">(this: WithAccess<&Slice<T>, A>, index: usize): WithAccess<&T, A> {
        todo("Slice.index")
    }

    /// Replace the element at `index`.
    indexSet(this: &exclusive Slice<T>, index: usize, value: T): void {
        todo("Slice.indexSet");
    }
}

extension<T, R: RangeBounds<usize>> of Slice<T> implements Index<R> {
    /// The indexed output type.
    type Output = Slice<T>;

    /// Return the normalized start and length for `range`.
    rangeSpan(this: &readonly Slice<T>, range: R): (usize, usize) {
        let start = match (range.startBound()) {
            Bound { kind: "included", value } => value
            Bound { kind: "excluded", value } => value + 1
            Bound { kind: "unbounded" } => 0
        };

        let end = match (range.endBound()) {
            Bound { kind: "included", value } => value + 1
            Bound { kind: "excluded", value } => value
            Bound { kind: "unbounded" } => this.size
        };

        if (start > end || end > this.size) {
            panic("slice range out of bounds")
        }

        (start, end - start)
    }

    /// Return the selected range by value.
    index(range: R): Slice<T> {
        todo("Slice.indexRange")
    }

    /// Borrow the selected range.
    index<A: Access = "readonly">(
        this: WithAccess<&Slice<T>, A>,
        range: R,
    ): WithAccess<&Slice<T>, A> {
        let (start, length) = this.rangeSpan(range);

        this.subslice(start, length)
    }
}

extension<T, R: RangeBounds<usize>> of Slice<T> implements IndexSet<R, Slice<T>> where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(this: &exclusive Slice<T>, range: R, source: Slice<T>): void {
        let target = this.index(range);

        target.copyFrom(&readonly source);
    }
}

extension<T, R: RangeBounds<usize>> of Slice<T> implements IndexSet<R, &readonly Slice<T>>
where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(this: &exclusive Slice<T>, range: R, source: &readonly Slice<T>): void {
        let target = this.index(range);

        target.copyFrom(source);
    }
}
