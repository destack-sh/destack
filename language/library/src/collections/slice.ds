import { From, ToOwned } from "destack:convert";
import { panic, todo } from "destack:error";
import { FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Clone, Copy, Default, Raw, WithAccess } from "destack:memory";
import { Index, IndexSet, Ordering } from "destack:ops";
import { Bound, RangeBounds } from "destack:range";

import { Array } from "./array.ds";
import { Sequence } from "./sequence.ds";

/// Well-known library type for the builtin slice descriptor form `[T]`.
@languageItem("collections.Slice")
export newtype Slice<T> = [T];

export extension<T> of Slice<T> implements Default {
    /// Create an empty slice.
    static new(): ^[T] {
        todo("Slice.new")
    }

    /// Create a slice from `values`.
    static from(values: Iterable<T>): ^[T] {
        todo("Slice.from")
    }

    /// Create a slice from `values`.
    static fromIterator(values: Iterator<T>): ^[T] {
        todo("Slice.fromIterator")
    }

    /// Create the default slice.
    static default(): ^[T] {
        Slice.new()
    }

    /// Build a raw slice descriptor from raw storage.
    @unsafe
    static fromRaw(data: *T, length: usize): Raw<[T]> {
        return sliceFromRaw<T>(data, length);
    }

    /// Return the number of elements.
    get size(): isize {
        return sliceLength<T>(this) as isize;
    }

    /// Return the number of elements.
    get length(): isize {
        return this.size;
    }

    /// Return whether this slice has no elements.
    get isEmpty(): boolean {
        this.size == 0
    }

    /// Load one element without bounds checks.
    @unsafe
    unsafeGet(&readonly this, index: usize): T where T: Copy {
        return sliceGet<T>(this, index);
    }

    /// Store one element without bounds checks.
    @unsafe
    unsafeSet(&exclusive this, index: usize, value: T): void {
        sliceSet<T>(this, index, value);
    }

    /// Borrow a contiguous range as a view.
    subslice<const A: Access = "readonly">(
        this: WithAccess<&[T], A>,
        start: usize,
        length: usize,
    ): WithAccess<&[T], A> {
        return sliceView<T, A>(this, start, length);
    }

    /// Borrow a selected range as a view.
    slice<const A: Access = "readonly">(
        this: WithAccess<&[T], A>,
        start?: isize,
        end?: isize,
    ): WithAccess<&[T], A> {
        todo("Slice.slice")
    }

    /// Split this slice into two borrowed views.
    splitAt<const A: Access = "readonly">(
        this: WithAccess<&[T], A>,
        index: isize,
    ): (WithAccess<&[T], A>, WithAccess<&[T], A>) {
        todo("Slice.splitAt")
    }

    /// Fill this slice with `value`.
    fill(&exclusive this, value: T): void where T: Clone {
        todo("Slice.fill");
    }

    /// Copy elements from `source` into this slice.
    copyFrom(&exclusive this, source: &readonly [T]): void where T: Copy {
        if (source.size != this.size) {
            panic("slice copy length mismatch")
        }

        for (let index: usize = 0; index < sliceLength<T>(this); index += 1) {
            this.unsafeSet(index, source.unsafeGet(index));
        }
    }

    /// Swap two elements.
    swap(&exclusive this, left: usize, right: usize): void {
        todo("Slice.swap");
    }

    /// Reverse this slice in place.
    reverse(&exclusive this): void {
        todo("Slice.reverse");
    }

    /// Sort this slice in place.
    sort(&exclusive this, compare?: (left: &readonly T, right: &readonly T) => Ordering): void {
        todo("Slice.sort");
    }

    /// Sort this slice without preserving the order of equal elements.
    sortUnstable(
        &exclusive this,
        compare?: (left: &readonly T, right: &readonly T) => Ordering,
    ): void {
        todo("Slice.sortUnstable");
    }
}

export extension<T: Copy> of Slice<T> implements Iterable<T>, Sequence {
    /// The copied sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Return the number of elements.
    get length(): isize {
        this.size
    }

    /// Copy the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Array<T> {
        todo("Slice.rest")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Slice.iterator")
    }

    /// Return the first element by value.
    first(&readonly this): T | undefined {
        if (this.isEmpty) {
            return undefined;
        }

        this[0]
    }

    /// Return the last element by value.
    last(&readonly this): T | undefined {
        let length = this.length;

        if (length == 0) {
            return undefined;
        }

        this[length - 1]
    }
}

export extension<T> of ^Slice<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create a slice from `values`.
    static from(values: Iterable<T>): ^[T] {
        Slice.from(values)
    }

    /// Create a slice from `values`.
    static fromIterator(values: Iterator<T>): ^[T] {
        Slice.fromIterator(values)
    }
}

export extension<T, 'a, const A: Access> of Borrowed<Slice<T>, 'a, A>
    implements
        Iterable<Borrowed<T, 'a, A>>,
        Sequence {
    /// The borrowed sequence produced by a rest pattern.
    type Rest = ^Array<Borrowed<T, 'a, A>>;

    /// Return the number of elements.
    get length(): isize {
        this.size
    }

    /// Borrow the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Array<Borrowed<T, 'a, A>> {
        todo("Slice.rest")
    }

    /// Return an iterator over borrowed values.
    iterator(): Iterator<Borrowed<T, 'a, A>> {
        todo("Slice.iterator")
    }

    /// Borrow the first element.
    first(): Borrowed<T, 'a, A> | undefined {
        todo("Slice.first")
    }

    /// Borrow the last element.
    last(): Borrowed<T, 'a, A> | undefined {
        todo("Slice.last")
    }
}

export extension<T> of Slice<T> implements Index<isize>, IndexSet<isize, T> {
    /// The indexed output type.
    type Output = T;

    /// Borrow a view over `start..end`.
    view<const A: Access = "readonly">(
        this: WithAccess<&[T], A>,
        start: isize,
        end?: isize,
    ): WithAccess<&[T], A> {
        this.slice(start, end)
    }

    /// Borrow the element at `index`.
    index<const A: Access = "readonly">(
        this: WithAccess<&[T], A>,
        index: isize,
    ): WithAccess<&T, A> {
        todo("Slice.index")
    }

    /// Replace the element at `index`.
    indexSet(&exclusive this, index: isize, value: T): void {
        todo("Slice.indexSet");
    }
}

export extension<T, R: RangeBounds<isize>, const A: Access = "readonly"> of Slice<T>
    implements
        Index<R, A> {
    /// The indexed output type.
    type Output = [T];

    /// Return the normalized start and length for `range`.
    rangeSpan(&readonly this, range: &readonly R): (isize, isize) {
        let start = match (range.startBound()) {
            { kind: "included", value } => *value
            { kind: "excluded", value } => *value + 1
            { kind: "unbounded" } => 0
        };

        let end = match (range.endBound()) {
            { kind: "included", value } => *value + 1
            { kind: "excluded", value } => *value
            { kind: "unbounded" } => this.size
        };

        if (start > end || end > this.size) {
            panic("slice range out of bounds")
        }

        (start, end - start)
    }

    /// Borrow the selected range as a view.
    index(this: WithAccess<&[T], A>, range: R): WithAccess<&[T], A> {
        let (start, length) = this.rangeSpan(&readonly range);

        this.subslice(start as usize, length as usize)
    }
}

export extension<T, R: RangeBounds<isize>> of Slice<T> implements IndexSet<R, [T]> where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: [T]): void {
        let target = this.index(range);

        target.copyFrom(&readonly source);
    }
}

export extension<T, R: RangeBounds<isize>> of Slice<T> implements IndexSet<R, &readonly [T]>
    where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: &readonly [T]): void {
        let target = this.index(range);

        target.copyFrom(source);
    }
}

export extension<T> of Slice<T> implements ToOwned where T: Clone {
    /// The owned value type.
    type Owned = ^Array<T>;

    /// Copy this slice into owned array storage.
    toOwned(&readonly this): ^Array<T> {
        todo("Slice.toOwned")
    }
}

/// Build a raw slice descriptor from raw parts.
@unsafe
@intrinsic("collections.slice.fromRaw")
export declare function sliceFromRaw<T>(data: *T, length: usize): Raw<[T]>;

/// Return the element count of one slice view.
@intrinsic("collections.slice.length")
export declare function sliceLength<T>(slice: &readonly [T]): usize;

/// Load one element without bounds checks.
@unsafe
@intrinsic("collections.slice.get")
export declare function sliceGet<T: Copy>(slice: &readonly [T], index: usize): T;

/// Store one element without bounds checks.
@unsafe
@intrinsic("collections.slice.set")
export declare function sliceSet<T>(slice: &exclusive [T], index: usize, value: T): void;

/// Borrow a contiguous range of one slice as a view.
@unsafe
@intrinsic("collections.slice.subslice")
export declare function sliceView<T, const A: Access = "readonly">(
    slice: WithAccess<&[T], A>,
    start: usize,
    length: usize,
): WithAccess<&[T], A>;
