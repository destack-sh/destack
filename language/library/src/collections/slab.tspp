import { From } from "tspp:convert";
import { todo } from "tspp:error";
import { Extend, FromIterator, Iterable, Iterator } from "tspp:iter";
import { Borrowed, Copy, Default, MaybeUninit, Region } from "tspp:memory";
import { Index, IndexSet } from "tspp:ops";

import { Array } from "./array.tspp";

/// Key for one live slab entry.
@languageItem("collections.SlabKey")
export newtype SlabKey = {
    /// The slot index.
    index: uint32;

    /// The slot generation.
    generation: uint32;
};

/// One slab storage slot.
struct SlabSlot<T> {
    /// The current slot generation.
    generation: uint32 = 0;

    /// The next free slot index.
    nextFree: uint32 | undefined = undefined;

    /// True when this slot currently holds a value.
    isOccupied: boolean = false;

    /// The slot value storage.
    value: MaybeUninit<T>;
}

/// A generational slab with stable keys and reusable slots.
@languageItem("collections.Slab")
export struct Slab<T> {
    /// The slot storage.
    private slots: ^Array<SlabSlot<T>>;

    /// The first free slot index.
    private firstFree: uint32 | undefined = undefined;

    /// The number of live entries.
    private count: usize = 0;
}

export extension<T> of Slab<T> implements Iterable<(SlabKey, T)> {
    /// Consume this slab into owned entries.
    iterator(this): this.Iterator {
        todo("Slab.iterator")
    }
}

export extension<T, 'a, const A: "immutable" | "exclusive"> of Borrowed<Slab<T>, 'a, A>
    implements Iterable<(SlabKey, Borrowed<T, 'a, A>)>
{
    /// Borrow the value for `key`.
    get(this, key: SlabKey): Borrowed<T, 'a, A> | undefined {
        todo("Slab.get")
    }

    /// Return borrowed live values.
    values(this): Iterator<Borrowed<T, 'a, A>> {
        todo("Slab.values")
    }

    /// Return borrowed live entries.
    entries(this): Iterator<(SlabKey, Borrowed<T, 'a, A>)> {
        todo("Slab.entries")
    }

    /// Return an iterator over borrowed live entries.
    iterator(this): this.Iterator {
        todo("Slab.iterator")
    }
}

export extension<T> of Slab<T>
    implements
        IndexSet<SlabKey, T>,
        From<Iterable<T>>,
        FromIterator<T>,
        Extend<T, "mutable">,
        Default
{
    /// Create an empty slab.
    static new(): Slab<T> {
        todo("Slab.new")
    }

    /// Create a slab with room for at least `capacity` entries.
    static withCapacity(capacity: usize): Slab<T> {
        todo("Slab.withCapacity")
    }

    /// Create a slab from values.
    static from(values: Iterable<T>): Slab<T> {
        todo("Slab.from")
    }

    /// Create a slab from `values`.
    static fromIterator<I: Iterable<T>>(values: I): Slab<T> {
        todo("Slab.fromIterator")
    }

    /// Create the default slab.
    static default(): Slab<T> {
        Slab.new()
    }

    /// Return the number of live entries.
    get size(&readonly this): usize {
        this.count
    }

    /// Return the allocated slot count.
    get capacity(&readonly this): usize {
        this.slots.capacity
    }

    /// Return whether this slab has no live entries.
    get isEmpty(&readonly this): boolean {
        this.count == 0
    }

    /// Insert `value` and return its key.
    insert(&this, value: T): SlabKey {
        todo("Slab.insert")
    }

    /// Insert all `values`.
    extend<I: Iterable<T>>(&this, values: I): void {
        todo("Slab.extend");
    }

    /// Remove and return the value for `key`.
    remove(&this, key: SlabKey): T | undefined {
        todo("Slab.remove")
    }

    /// Return whether `key` identifies a live entry.
    has(&readonly this, key: &readonly SlabKey): boolean {
        todo("Slab.has")
    }

    /// Replace the value for `key` through the index operator.
    indexSet(&this, key: SlabKey, value: T): void {
        this.set(key, value);
    }

    /// Insert or replace the value for `key`.
    set(&this, key: SlabKey, value: T): boolean {
        todo("Slab.set")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(&this, additional: usize): void {
        todo("Slab.reserve");
    }

    /// Remove all entries.
    clear(&this): void {
        todo("Slab.clear");
    }

    /// Retain only entries accepted by `predicate`.
    retain(&exclusive this, predicate: (key: SlabKey, value: &exclusive T) => boolean): void {
        todo("Slab.retain");
    }

    /// Remove all entries and return them.
    drain(&this): Iterator<(SlabKey, T)> {
        todo("Slab.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        &exclusive this,
        predicate: (key: SlabKey, value: &exclusive T) => boolean,
    ): Iterator<(SlabKey, T)> {
        todo("Slab.extractIf")
    }

    /// Shrink storage to fit live and reusable slots.
    shrinkToFit(&this): void {
        todo("Slab.shrinkToFit");
    }

    /// Return all live keys.
    keys(&readonly this): Iterator<SlabKey> {
        todo("Slab.keys")
    }
}

export extension<T> of Slab<T> implements Index<SlabKey> where T: Copy {
    /// The copied indexed value.
    type Output<const R: Region> = T;

    /// The missing index result.
    type Missing = undefined;

    /// Copy the indexed value.
    index<const R: Region>(this: Borrowed<Slab<T>, R, "readonly">, key: SlabKey): T | undefined {
        todo("Slab.index")
    }
}

export extension<T, const A: "immutable" | "exclusive"> of Slab<T> implements Index<SlabKey, A> {
    /// The protected element storage.
    type Output<const R: Region> = Borrowed<T, R, A>;

    /// The missing index result.
    type Missing = undefined;

    /// Borrow the indexed storage.
    index<const R: Region>(
        this: Borrowed<Slab<T>, R, A>,
        key: SlabKey,
    ): Borrowed<T, R, A> | undefined {
        todo("Slab.index")
    }
}
