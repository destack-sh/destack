import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, MaybeUninit, WithAccess } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

import { Sequence } from "./sequence.ds";
import { Slice } from "./slice.ds";

/// A compact double-ended queue.
@languageItem("collections.Deque")
export class Deque<T> {
    /// The ring storage.
    private storage: ^[MaybeUninit<T>] = Slice.new();

    /// The first initialized slot.
    private start: usize = 0;

    /// The allocated element count.
    private capacity: usize = 0;

    /// The number of elements.
    private count: isize = 0;
}

export extension<T> of ^Deque<T> implements Iterable<T>, Sequence {
    /// The owned sequence produced by a rest pattern.
    type Rest = ^Deque<T>;

    /// Move the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Deque<T> {
        todo("Deque.rest")
    }

    /// Consume this deque into owned values.
    iterator(): Iterator<T> {
        todo("Deque.iterator")
    }
}

export extension<T: Copy> of Deque<T> implements Iterable<T>, Sequence {
    /// The copied sequence produced by a rest pattern.
    type Rest = ^Deque<T>;

    /// Copy the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Deque<T> {
        todo("Deque.rest")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Deque.iterator")
    }

    /// Return the copied front element.
    front(): T | undefined {
        todo("Deque.front")
    }

    /// Return the copied back element.
    back(): T | undefined {
        todo("Deque.back")
    }
}

export extension<T, 'a, const A: Access> of Borrowed<Deque<T>, 'a, A>
    implements Iterable<Borrowed<T, 'a, A>>, Sequence
{
    /// The borrowed sequence produced by a rest pattern.
    type Rest = ^Deque<Borrowed<T, 'a, A>>;

    /// Borrow the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Deque<Borrowed<T, 'a, A>> {
        todo("Deque.rest")
    }

    /// Return an iterator over borrowed values.
    iterator(): Iterator<Borrowed<T, 'a, A>> {
        todo("Deque.iterator")
    }

    /// Borrow the front element.
    front(): Borrowed<T, 'a, A> | undefined {
        todo("Deque.front")
    }

    /// Borrow the back element.
    back(): Borrowed<T, 'a, A> | undefined {
        todo("Deque.back")
    }
}

export extension<T> of Deque<T>
    implements Default, Index<isize>, IndexSet<isize, T>, Extend<T, "mutable">
{
    /// The indexed output type.
    type Output = T;

    /// Create an empty deque.
    static new(): ^Deque<T> {
        todo("Deque.new")
    }

    /// Create a deque with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Deque<T> {
        todo("Deque.withCapacity")
    }

    /// Create a deque from values.
    static from(values: Iterable<T>): ^Deque<T> {
        todo("Deque.from")
    }

    /// Create a deque from `values`.
    static fromIterator(values: Iterator<T>): ^Deque<T> {
        todo("Deque.fromIterator")
    }

    /// Create the default deque.
    static default(): ^Deque<T> {
        Deque.new()
    }

    /// Return the number of elements.
    get length(&readonly this): isize {
        this.count
    }

    /// Return the number of elements.
    get size(&readonly this): isize {
        this.count
    }

    /// Return whether this deque has no elements.
    get isEmpty(&readonly this): boolean {
        this.count == 0
    }

    /// Borrow the element at `index`.
    index<const A: Access = "readonly">(
        this: WithAccess<&Deque<T>, A>,
        index: isize,
    ): WithAccess<&T, A> {
        todo("Deque.index")
    }

    /// Replace the element at `index`.
    indexSet(&this, index: isize, value: T): void {
        todo("Deque.indexSet");
    }

    /// Push `value` to the back.
    pushBack(&this, value: T): void {
        todo("Deque.pushBack");
    }

    /// Push `value` to the front.
    pushFront(&this, value: T): void {
        todo("Deque.pushFront");
    }

    /// Append all `values` to the back.
    extend(&this, values: Iterable<T>): void {
        todo("Deque.extend");
    }

    /// Remove and return the back element.
    popBack(&this): T | undefined {
        todo("Deque.popBack")
    }

    /// Remove and return the front element.
    popFront(&this): T | undefined {
        todo("Deque.popFront")
    }

    /// Remove all elements.
    clear(&this): void {
        todo("Deque.clear");
    }

    /// Retain only elements accepted by `predicate`.
    retain(&this, predicate: (value: &readonly T, index: isize) => boolean): void {
        todo("Deque.retain");
    }

    /// Remove all elements and return them.
    drain(&this): Iterator<T> {
        todo("Deque.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(
        &this,
        predicate: (value: &readonly T, index: isize) => boolean,
    ): Iterator<T> {
        todo("Deque.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&this, additional: usize): void {
        todo("Deque.reserve");
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(&this): void {
        todo("Deque.shrinkToFit");
    }
}

export extension<T> of Deque<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create a managed deque from `values`.
    static from(values: Iterable<T>): Deque<T> {
        Deque.from(values)
    }

    /// Create a managed deque from `values`.
    static fromIterator(values: Iterator<T>): Deque<T> {
        Deque.fromIterator(values)
    }
}

export extension<T> of ^Deque<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned deque from values.
    static from(values: Iterable<T>): ^Deque<T> {
        Deque.from(values)
    }

    /// Create an owned deque from values.
    static fromIterator(values: Iterator<T>): ^Deque<T> {
        Deque.fromIterator(values)
    }
}
