import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Default, MaybeUninit, WithAccess } from "destack:memory";

import { Array } from "./array.ds";

/// Key for one linked list node.
newtype LinkedListNodeKey = uint32;

/// One linked list node.
struct LinkedListNode<T> {
    /// The previous node key.
    previous: LinkedListNodeKey | undefined = undefined;

    /// The next node key.
    next: LinkedListNodeKey | undefined = undefined;

    /// The next free node key.
    nextFree: LinkedListNodeKey | undefined = undefined;

    /// The node value storage.
    value: MaybeUninit<T>;

    /// True when this node currently holds a value.
    isOccupied: boolean = true;
}

/// A linked list.
export class LinkedList<T> {
    /// The first node key.
    head: LinkedListNodeKey | undefined = undefined;

    /// The last node key.
    tail: LinkedListNodeKey | undefined = undefined;

    /// The node storage.
    nodes: Array<LinkedListNode<T>>;

    /// The first free node key.
    firstFree: LinkedListNodeKey | undefined = undefined;

    /// The number of nodes.
    count: usize = 0;
}

extension<T> of LinkedList<T> implements
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    Extend<T, "exclusive"> {
    /// Create an empty list.
    static new(): ^LinkedList<T> {
        todo("LinkedList.new")
    }

    /// Create a list with room for at least `capacity` nodes.
    static withCapacity(capacity: usize): ^LinkedList<T> {
        todo("LinkedList.withCapacity")
    }

    /// Create a list from values.
    static from(values: Iterable<T>): ^LinkedList<T> {
        todo("LinkedList.from")
    }

    /// Create a linked list from `values`.
    static fromIterator(values: Iterator<T>): ^LinkedList<T> {
        todo("LinkedList.fromIterator")
    }

    /// Create the default linked list.
    static default(): ^LinkedList<T> {
        LinkedList.new()
    }

    /// Return the number of elements.
    get length(): number {
        this.count as number
    }

    /// Return the number of elements.
    get size(): usize {
        this.count
    }

    /// Return whether this list has no elements.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Push `value` to the back.
    pushBack(&exclusive this, value: T): void {
        todo("LinkedList.pushBack");
    }

    /// Push `value` to the front.
    pushFront(&exclusive this, value: T): void {
        todo("LinkedList.pushFront");
    }

    /// Append all `values` to the back.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("LinkedList.extend");
    }

    /// Remove and return the back element.
    popBack(&exclusive this): T | undefined {
        todo("LinkedList.popBack")
    }

    /// Remove and return the front element.
    popFront(&exclusive this): T | undefined {
        todo("LinkedList.popFront")
    }

    /// Borrow the front element.
    front<A: Access = "readonly">(
        this: WithAccess<&LinkedList<T>, A>,
    ): WithAccess<&T, A> | undefined {
        todo("LinkedList.front")
    }

    /// Borrow the back element.
    back<A: Access = "readonly">(
        this: WithAccess<&LinkedList<T>, A>,
    ): WithAccess<&T, A> | undefined {
        todo("LinkedList.back")
    }

    /// Remove all elements.
    clear(&exclusive this): void {
        todo("LinkedList.clear");
    }

    /// Retain only elements accepted by `predicate`.
    retain(&exclusive this, predicate: (value: &T, index: usize) => boolean): void {
        todo("LinkedList.retain");
    }

    /// Remove all elements and return them.
    drain(&exclusive this): Iterator<T> {
        todo("LinkedList.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(&exclusive this, predicate: (value: &T, index: usize) => boolean): Iterator<T> {
        todo("LinkedList.extractIf")
    }

    /// Reserve room for at least `additional` more nodes.
    reserve(&exclusive this, additional: usize): void {
        todo("LinkedList.reserve");
    }

    /// Shrink node storage to fit the current length.
    shrinkToFit(&exclusive this): void {
        todo("LinkedList.shrinkToFit");
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("LinkedList.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator<A: Access = "readonly">(
        this: WithAccess<&LinkedList<T>, A>,
    ): Iterator<WithAccess<&T, A>> {
        todo("LinkedList.iterator")
    }

    /// Consume this list into owned values.
    iterator(^this): Iterator<T> {
        todo("LinkedList.iterator")
    }
}

extension<T> of ^LinkedList<T> implements Default, From<Iterable<T>>, FromIterator<T> {
    /// Create the default owned linked list.
    static default(): ^LinkedList<T> {
        LinkedList.default()
    }

    /// Create an owned linked list from values.
    static from(values: Iterable<T>): ^LinkedList<T> {
        LinkedList.from(values)
    }

    /// Create an owned linked list from values.
    static fromIterator(values: Iterator<T>): ^LinkedList<T> {
        LinkedList.fromIterator(values)
    }
}
