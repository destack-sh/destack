export extension<T, E> of Set<T, E>
    implements From<Iterable<T>>, FromIterator<T>
    where E: Default, E: Equate<T>
{
    /// Create a managed set from `values`.
    static from(values: Iterable<T>): Set<T, E> {
        Set.from(values, E.default())
    }

    /// Create a managed set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): Set<T, E> {
        Set.fromIterator(values, E.default())
    }
}

export extension<T, E> of ^Set<T, E>
    implements From<Iterable<T>>, FromIterator<T>
    where E: Default, E: Equate<T>
{
    /// Create an owned set from values.
    static from(values: Iterable<T>): ^Set<T, E> {
        Set.from(values, E.default())
    }

    /// Create an owned set from `values`.
    static fromIterator<I: Iterable<T>>(values: I): ^Set<T, E> {
        Set.fromIterator(values, E.default())
    }
}

export extension<T, 'a, E> of &'a readonly Set<T, E> implements Iterable<T> where T: Copy {
    /// Iterate over copied values while retaining this borrow.
    iterator(this): Iterator<T> {
        todo("Set.iterator")
    }
}

export extension<T, E> of Set<T, E> {
    /// Return the number of elements.
    get size(&readonly this): usize {
        this.map.size
    }

    /// Return whether this set has no elements.
    get isEmpty(&readonly this): boolean {
        this.map.isEmpty
    }

    /// Remove all elements.
    clear(&this): void {
        todo("Set.clear");
    }

    /// Remove all values and return them.
    drain(&this): Iterator<T> {
        todo("Set.drain")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&this, additional: usize): void {
        todo("Set.reserve");
    }

    /// Shrink storage to fit the current values.
    shrinkToFit(&this): void {
        todo("Set.shrinkToFit");
    }
}

export extension<T, E, const A: "mutable" | "exclusive"> of Set<T, E>
    implements Extend<T, A>
    where E: Equate<T>, A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never)
{
    /// Add all `values`.
    extend<I: Iterable<T>>(this: WithAccess<&this, A>, values: I): void where E: Equate<T> {
        todo("Set.extend");
    }
}
