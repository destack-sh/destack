export extension<T, E> of Set<T, E> {
    /// Create an empty set.
    static new(comparer: E): ^Set<T, E> {
        todo("Set.new")
    }

    /// Create a set with room for at least `capacity` elements.
    static withCapacity(capacity: usize, comparer: E): ^Set<T, E> {
        todo("Set.withCapacity")
    }
}

export extension<T, E> of Set<T, E> implements Default where E: Default {
    /// Create an empty collection with its default comparer.
    static new(): ^Set<T, E> {
        Set.new(E.default())
    }

    /// Create a collection with its default comparer and room for capacity entries.
    static withCapacity(capacity: usize): ^Set<T, E> {
        Set.withCapacity(capacity, E.default())
    }

    /// Create the default set.
    static default(): ^Set<T, E> {
        Set.new(E.default())
    }
}

