import { Borrow, From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Borrowed, Clone, Copy, Default } from "destack:memory";
import { Equal, Hash } from "destack:ops";

import { Map } from "./map.ds";

/// A compact hash set.
@languageItem("collections.Set")
export class Set<T> {
    /// The backing map.
    private map: Map<T, void> = Map.new();
}

export extension<T: Hash> of ^Set<T> implements Iterable<T> where T: Equal<T> {
    /// Consume this set into owned values.
    iterator(): Iterator<T> {
        todo("Set.iterator")
    }

    /// Consume two sets into their union.
    union(other: ^Set<T>): ^Set<T> {
        todo("Set.union")
    }

    /// Consume two sets into their intersection.
    intersection(other: ^Set<T>): ^Set<T> {
        todo("Set.intersection")
    }

    /// Consume two sets into their difference.
    difference(other: ^Set<T>): ^Set<T> {
        todo("Set.difference")
    }

    /// Consume two sets into their symmetric difference.
    symmetricDifference(other: ^Set<T>): ^Set<T> {
        todo("Set.symmetricDifference")
    }
}

export extension<T: Hash> of Set<T> implements Iterable<T> where T: Copy, T: Equal<T> {
    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Set.iterator")
    }

    /// Return the copied stored value equal to `value`.
    get<Q: Hash>(value: &readonly Q): T | undefined where T: Borrow<Q>, Q: Equal<Q> {
        todo("Set.get")
    }

    /// Return copied values as keys.
    keys(): Iterator<T> {
        todo("Set.keys")
    }

    /// Return copied values.
    values(): Iterator<T> {
        todo("Set.values")
    }

    /// Return copied value-value entries.
    entries(): Iterator<(T, T)> {
        todo("Set.entries")
    }

    /// Call `visit` for each copied value and discard its result.
    forEach<R>(visit: (value: T, set: Set<T>) => R): void {
        todo("Set.forEach");
    }
}

export extension<T: Hash, 'a> of Borrowed<Set<T>, 'a, "readonly">
    implements Iterable<Borrowed<T, 'a, "readonly">>
    where T: Equal<T>
{
    /// Return an iterator over borrowed values.
    iterator(): Iterator<Borrowed<T, 'a, "readonly">> {
        todo("Set.iterator")
    }

    /// Borrow the stored value equal to `value`.
    get<Q: Hash>(value: &readonly Q): Borrowed<T, 'a, "readonly"> | undefined
        where T: Borrow<Q>, Q: Equal<Q> {
        todo("Set.get")
    }

    /// Return borrowed values as keys.
    keys(): Iterator<Borrowed<T, 'a, "readonly">> {
        todo("Set.keys")
    }

    /// Return borrowed values.
    values(): Iterator<Borrowed<T, 'a, "readonly">> {
        todo("Set.values")
    }

    /// Return borrowed value-value entries.
    entries(): Iterator<(Borrowed<T, 'a, "readonly">, Borrowed<T, 'a, "readonly">)> {
        todo("Set.entries")
    }

    /// Call `visit` for each borrowed value and discard its result.
    forEach<R>(
        visit: (value: Borrowed<T, 'a, "readonly">, set: Borrowed<Set<T>, 'a, "readonly">) => R,
    ): void {
        todo("Set.forEach");
    }
}

export extension<T> of Set<T> implements Default {
    /// Create an empty set.
    static new(): ^Set<T> {
        todo("Set.new")
    }

    /// Create a set with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Set<T> {
        todo("Set.withCapacity")
    }

    /// Create the default set.
    static default(): ^Set<T> {
        Set.new()
    }
}

export extension<T: Hash> of Set<T> implements Extend<T, "mutable"> where T: Equal<T> {
    /// Create a set from values.
    static from(values: Iterable<T>): ^Set<T> {
        todo("Set.from")
    }

    /// Create a set from `values`.
    static fromIterator(values: Iterator<T>): ^Set<T> {
        todo("Set.fromIterator")
    }

    /// Return the number of elements.
    get size(&readonly this): usize {
        this.map.size
    }

    /// Return whether this set has no elements.
    get isEmpty(&readonly this): boolean {
        this.map.isEmpty
    }

    /// Return whether `value` is present.
    has<Q: Hash>(&readonly this, value: &readonly Q): boolean where T: Borrow<Q>, Q: Equal<Q> {
        todo("Set.has")
    }

    /// Add `value` when absent.
    add(&this, value: T): boolean {
        todo("Set.add")
    }

    /// Add all `values`.
    extend(&this, values: Iterable<T>): void {
        todo("Set.extend");
    }

    /// Remove `value`.
    remove<Q: Hash>(&this, value: &readonly Q): T | undefined
        where T: Borrow<Q>, Q: Equal<Q> {
        todo("Set.remove")
    }

    /// Remove all elements.
    clear(&this): void {
        todo("Set.clear");
    }

    /// Retain only values accepted by `predicate`.
    retain(&this, predicate: (value: &readonly T) => boolean): void {
        todo("Set.retain");
    }

    /// Remove all values and return them.
    drain(&this): Iterator<T> {
        todo("Set.drain")
    }

    /// Remove values accepted by `predicate` and return them.
    extractIf(&this, predicate: (value: &readonly T) => boolean): Iterator<T> {
        todo("Set.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&this, additional: usize): void {
        todo("Set.reserve");
    }

    /// Shrink storage to fit the current values.
    shrinkToFit(&this): void {
        todo("Set.shrinkToFit");
    }

    /// Return the union of two sets.
    union(&readonly this, other: &readonly Set<T>): ^Set<T> where T: Clone {
        todo("Set.union")
    }

    /// Return the intersection with `other`.
    intersection(&readonly this, other: &readonly Set<T>): ^Set<T> where T: Clone {
        todo("Set.intersection")
    }

    /// Return this set without values in `other`.
    difference(&readonly this, other: &readonly Set<T>): ^Set<T> where T: Clone {
        todo("Set.difference")
    }

    /// Return values present in exactly one set.
    symmetricDifference(&readonly this, other: &readonly Set<T>): ^Set<T> where T: Clone {
        todo("Set.symmetricDifference")
    }

    /// Return whether this set is a subset of `other`.
    isSubsetOf(&readonly this, other: &readonly Set<T>): boolean {
        todo("Set.isSubsetOf")
    }

    /// Return whether this set is a superset of `other`.
    isSupersetOf(&readonly this, other: &readonly Set<T>): boolean {
        todo("Set.isSupersetOf")
    }

    /// Return whether this set has no overlap with `other`.
    isDisjointFrom(&readonly this, other: &readonly Set<T>): boolean {
        todo("Set.isDisjointFrom")
    }
}

export extension<T: Hash> of Set<T>
    implements From<Iterable<T>>, FromIterator<T>
    where T: Equal<T>
{
    /// Create a managed set from `values`.
    static from(values: Iterable<T>): Set<T> {
        Set.from(values)
    }

    /// Create a managed set from `values`.
    static fromIterator(values: Iterator<T>): Set<T> {
        Set.fromIterator(values)
    }
}

export extension<T: Hash> of ^Set<T>
    implements From<Iterable<T>>, FromIterator<T>
    where T: Equal<T>
{
    /// Create an owned set from values.
    static from(values: Iterable<T>): ^Set<T> {
        Set.from(values)
    }

    /// Create an owned set from `values`.
    static fromIterator(values: Iterator<T>): ^Set<T> {
        Set.fromIterator(values)
    }
}
