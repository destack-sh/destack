/// A compact hash set.
///
/// Use the backing map's key equality and hash.
@languageItem("collections.Set")
export class Set<T, E = Equality<T>> {
    /// The backing map.
    private map: ^Map<T, void, E>;

    /// Create a collection from entries using its default comparer.
    constructor(entries?: Iterable<T> | null) where E: Default, E: Equate<T> {
        todo("Set.constructor");
    }

    /// Create a collection from entries using comparer.
    constructor(entries: Iterable<T> | null | undefined, options: { comparer: E })
        where E: Equate<T> {
        todo("Set.constructor");
    }
}

export extension<T, E> of ^Set<T, E> implements Iterable<T> {
    /// Consume this set into owned values.
    iterator(this): Iterator<T> {
        todo("Set.iterator")
    }

    /// Consume two sets into their union.
    union(this, other: ^Set<T, E>): ^Set<T, E> where E: Equate<T> {
        todo("Set.union")
    }

    /// Consume two sets into their intersection.
    intersection(this, other: ^Set<T, E>): ^Set<T, E> where E: Equate<T> {
        todo("Set.intersection")
    }

    /// Consume two sets into their difference.
    difference(this, other: ^Set<T, E>): ^Set<T, E> where E: Equate<T> {
        todo("Set.difference")
    }

    /// Consume two sets into their symmetric difference.
    symmetricDifference(this, other: ^Set<T, E>): ^Set<T, E> where E: Equate<T> {
        todo("Set.symmetricDifference")
    }
}

