import { Borrow, From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import { Access, Borrowed, Copy, Default, MaybeUninit, Unique, WithAccess } from "destack:memory";
import { Equal, Hash, Index, IndexSet } from "destack:ops";

import { Array } from "./array.ds";

/// One map entry.
export struct MapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one map entry.
export struct MapEntryHandle<'a, K, V> {
    /// The borrowed map.
    private map: &'a exclusive Map<K, V>;

    /// The queried key.
    private entryKey: K;
}

/// One map slot.
struct MapSlot<K, V> {
    /// The cached key hash.
    hash: uint64;

    /// The slot entry.
    entry: MapEntry<K, V>;
}

/// A compact hash map.
@languageItem("collections.Map")
export class Map<K, V> {
    /// The entry storage.
    private entries: Unique<[MaybeUninit<MapSlot<K, V>>]> = Unique.empty();

    /// The hash index.
    private index: Unique<[uint32]> = Unique.empty();

    /// The number of live entries.
    private count: usize = 0;

    /// The allocated entry count.
    private capacity: usize = 0;
}

export extension<K: Hash, V> of ^Map<K, V> implements Iterable<(K, V)> where K: Equal<K> {
    /// Consume this map into owned entries.
    iterator(): Iterator<(K, V)> {
        todo("Map.iterator")
    }
}

export extension<K: Hash, V> of Map<K, V> implements Iterable<(K, V)>
    where K: Copy, K: Equal<K>, V: Copy {
    /// Return an iterator over copied entries.
    iterator(): Iterator<(K, V)> {
        todo("Map.iterator")
    }

    /// Return copied entries.
    entries(): Iterator<(K, V)> {
        todo("Map.entries")
    }

    /// Call `visit` for each copied entry.
    forEach(visit: (value: V, key: K, map: Map<K, V>) => void): void {
        todo("Map.forEach");
    }
}

export extension<K: Hash, V> of Map<K, V> where K: Copy, K: Equal<K> {
    /// Return copied keys.
    keys(): Iterator<K> {
        todo("Map.keys")
    }
}

export extension<K: Hash, V> of Map<K, V> where K: Equal<K>, V: Copy {
    /// Return copied values.
    values(): Iterator<V> {
        todo("Map.values")
    }

    /// Return a copied value by key.
    get<Q: Hash>(key: &readonly Q): V | undefined where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.get")
    }
}

export extension<K: Hash, V, 'a, comptime A: Access> of Borrowed<Map<K, V>, 'a, A>
    implements
        Iterable<MapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>> where K: Equal<K> {
    /// Return an iterator over borrowed entries.
    iterator(): Iterator<MapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>> {
        todo("Map.iterator")
    }

    /// Return borrowed keys.
    keys(): Iterator<Borrowed<K, 'a, "readonly">> {
        todo("Map.keys")
    }

    /// Return borrowed values.
    values(): Iterator<Borrowed<V, 'a, A>> {
        todo("Map.values")
    }

    /// Return borrowed entries.
    entries(): Iterator<MapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>>> {
        todo("Map.entries")
    }

    /// Borrow a value by key.
    get<Q: Hash>(key: &readonly Q): Borrowed<V, 'a, A> | undefined where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.get")
    }

    /// Return whether `key` exists.
    has<Q: Hash>(key: &readonly Q): boolean where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.has")
    }

    /// Borrow an entry by key.
    getEntry<Q: Hash>(
        key: &readonly Q,
    ): MapEntry<Borrowed<K, 'a, "readonly">, Borrowed<V, 'a, A>> | undefined
        where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.getEntry")
    }

    /// Call `visit` for each borrowed entry.
    forEach(
        visit: (
            value: Borrowed<V, 'a, "readonly">,
            key: Borrowed<K, 'a, "readonly">,
            map: Borrowed<Map<K, V>, 'a, "readonly">,
        ) => void,
    ): void {
        todo("Map.forEach");
    }
}

export extension<'a, K: Hash, V> of MapEntryHandle<'a, K, V> where K: Equal<K> {
    /// Borrow the queried key.
    get key(): &readonly K {
        todo("MapEntryHandle.key")
    }

    /// Return whether this handle points at an occupied entry.
    get isOccupied(): boolean {
        todo("MapEntryHandle.isOccupied")
    }

    /// Borrow the current value.
    get(&exclusive this): &exclusive V | undefined {
        todo("MapEntryHandle.get")
    }

    /// Insert `value` when this handle is vacant.
    orInsert(&exclusive this, value: V): &exclusive V {
        todo("MapEntryHandle.orInsert")
    }

    /// Insert a value produced by `makeValue` when this handle is vacant.
    orInsertWith(&exclusive this, makeValue: () => V): &exclusive V {
        todo("MapEntryHandle.orInsertWith")
    }

    /// Insert or replace the value.
    set(&exclusive this, value: V): &exclusive V {
        todo("MapEntryHandle.set")
    }

    /// Remove the entry.
    remove(&exclusive this): V | undefined {
        todo("MapEntryHandle.remove")
    }
}

export extension<K, V> of Map<K, V> implements Default {
    /// Create an empty map.
    static new(): ^Map<K, V> {
        todo("Map.new")
    }

    /// Create a map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): ^Map<K, V> {
        todo("Map.withCapacity")
    }

    /// Create the default map.
    static default(): ^Map<K, V> {
        Map.new()
    }
}

export extension<K: Hash, V> of Map<K, V>
    implements
        Index<K>,
        IndexSet<K, V>,
        Extend<(K, V), "exclusive"> where K: Equal<K> {
    /// The indexed output type.
    type Output = V;

    /// The missing index result.
    type Missing = undefined;

    /// Create a map from entries.
    static from(entries: Iterable<(K, V)>): ^Map<K, V> {
        todo("Map.from")
    }

    /// Group `values` by a computed key.
    static groupBy<T>(values: Iterable<T>, key: (value: T, index: usize) => K): ^Map<K, ^Array<T>> {
        todo("Map.groupBy")
    }

    /// Create a map from entries.
    static fromIterator<R>(entries: Iterator<(K, V), R>): ^Map<K, V> {
        todo("Map.fromIterator")
    }

    /// Return the number of entries.
    get size(): usize {
        this.count
    }

    /// Return whether this map has no entries.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Return mutating access to the entry for `key`.
    entry(&exclusive this, key: K): MapEntryHandle<K, V> {
        todo("Map.entry")
    }

    /// Borrow a value by key through the index operator.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&Map<K, V>, A>,
        key: K,
    ): WithAccess<&V, A> | undefined {
        todo("Map.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(&exclusive this, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Hash>(key: &readonly Q): boolean where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.has")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(&exclusive this, key: K, value: V): boolean {
        todo("Map.insert")
    }

    /// Return the existing value or insert a new value.
    getOrInsert(&exclusive this, key: K, value: V): &exclusive V {
        todo("Map.getOrInsert")
    }

    /// Return the existing value or insert a value produced by `makeValue`.
    getOrInsertWith(&exclusive this, key: K, makeValue: () => V): &exclusive V {
        todo("Map.getOrInsertWith")
    }

    /// Insert or replace a key-value pair.
    set(&exclusive this, key: K, value: V): this {
        todo("Map.set")
    }

    /// Insert or replace all entries.
    extend(&exclusive this, entries: Iterable<(K, V)>): void {
        todo("Map.extend");
    }

    /// Remove a key-value pair.
    remove<Q: Hash>(&exclusive this, key: &readonly Q): V | undefined
        where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.remove")
    }

    /// Remove all entries.
    clear(&exclusive this): void {
        todo("Map.clear");
    }

    /// Retain only entries accepted by `predicate`.
    retain(&exclusive this, predicate: (key: &readonly K, value: &exclusive V) => boolean): void {
        todo("Map.retain");
    }

    /// Remove all entries and return them.
    drain(&exclusive this): Iterator<(K, V)> {
        todo("Map.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        &exclusive this,
        predicate: (key: &readonly K, value: &exclusive V) => boolean,
    ): Iterator<(K, V)> {
        todo("Map.extractIf")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(&exclusive this, additional: usize): void {
        todo("Map.reserve");
    }

    /// Shrink storage to fit the current entries.
    shrinkToFit(&exclusive this): void {
        todo("Map.shrinkToFit");
    }
}

export extension<K: Hash, V> of ^Map<K, V> implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where K: Equal<K> {
    /// Create an owned map from entries.
    static from(entries: Iterable<(K, V)>): ^Map<K, V> {
        Map.from(entries)
    }

    /// Create an owned map from entries.
    static fromIterator<R>(entries: Iterator<(K, V), R>): ^Map<K, V> {
        Map.fromIterator(entries)
    }
}
