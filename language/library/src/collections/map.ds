export extension<K, V, E> of Map<K, V, E> {
    /// Create an empty map.
    static new(comparer: E): ^Map<K, V, E> {
        todo("Map.new")
    }

    /// Create a map with room for at least `capacity` entries.
    static withCapacity(capacity: usize, comparer: E): ^Map<K, V, E> {
        todo("Map.withCapacity")
    }

    /// Create an empty collection with its default comparer.
    static new(): ^Map<K, V, E> where E: Default {
        Map.new(E.default())
    }

    /// Create a collection with its default comparer and room for capacity entries.
    static withCapacity(capacity: usize): ^Map<K, V, E> where E: Default {
        Map.withCapacity(capacity, E.default())
    }
}

export extension<K, V, E> of Map<K, V, E> implements Default where E: Default {
    /// Create the default map.
    static default(): ^Map<K, V, E> {
        Map.new(E.default())
    }
}

