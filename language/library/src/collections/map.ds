export extension<K, V> of Map<K, V> implements Default {
    /// Create an empty map.
    static new(): ^Map<K, V> {
        todo("Map.new")
    }

    /// Create a map with room for at least `capacity` entries.
    static withCapacity(capacity: usize): ^Map<K, V> {
        todo("Map.withCapacity")
    }

    /// Create the default map.
    static default(): ^Map<K, V> {
        Map.new()
    }
}

export extension<K: Hash, V> of Map<K, V>
    implements Index<K>, IndexSet<K, V>, Extend<(K, V), "mutable">
    where K: Equal<K>
{
    /// The indexed output type.
    type Output = V;

    /// The missing index result.
    type Missing = undefined;

    /// Create a map from entries.
    static from(entries: Iterable<(K, V)>): ^Map<K, V> {
        todo("Map.from")
    }

    /// Group `values` by a computed key.
    static groupBy<T>(values: Iterable<T>, key: (value: T, index: isize) => K): ^Map<K, Array<T>> {
        todo("Map.groupBy")
    }

    /// Create a map from entries.
    static fromIterator<I: Iterator<(K, V)>>(entries: I): ^Map<K, V> {
        todo("Map.fromIterator")
    }

    /// Return the number of entries.
    get size(&readonly this): usize {
        this.count
    }

    /// Return whether this map has no entries.
    get isEmpty(&readonly this): boolean {
        this.count == 0
    }

    /// Return mutating access to the entry for `key`.
    entry(&this, key: K): MapEntryHandle<K, V> {
        todo("Map.entry")
    }

    /// Borrow a value by key through the index operator.
    index<const A: Access = "readonly">(
        this: WithAccess<&Map<K, V>, A>,
        key: K,
    ): WithAccess<&V, A> | undefined {
        todo("Map.index")
    }

    /// Replace a key-value pair through the index operator.
    indexSet(&this, key: K, value: V): void {
        this.set(key, value);
    }

    /// Return whether `key` exists.
    has<Q: Hash>(&readonly this, key: &readonly Q): boolean where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.has")
    }

    /// Insert a key-value pair only when `key` is absent.
    insert(&this, key: K, value: V): boolean {
        todo("Map.insert")
    }

    /// Return the existing value or insert a new value.
    getOrInsert(&this, key: K, value: V): &V {
        todo("Map.getOrInsert")
    }

    /// Return the existing value or insert a value produced by `makeValue`.
    getOrInsertWith(&this, key: K, makeValue: () => V): &V {
        todo("Map.getOrInsertWith")
    }

    /// Insert or replace a key-value pair.
    set(&this, key: K, value: V): this {
        todo("Map.set")
    }

    /// Insert or replace all entries.
    extend<I: Iterable<(K, V)>>(&this, entries: I): void {
        todo("Map.extend");
    }

    /// Remove a key-value pair.
    remove<Q: Hash>(&this, key: &readonly Q): V | undefined
        where K: Borrow<Q>, Q: Equal<Q> {
        todo("Map.remove")
    }

    /// Remove all entries.
    clear(&this): void {
        todo("Map.clear");
    }

    /// Retain only entries accepted by `predicate`.
    retain(&this, predicate: (key: &readonly K, value: &V) => boolean): void {
        todo("Map.retain");
    }

    /// Remove all entries and return them.
    drain(&this): Iterator<(K, V)> {
        todo("Map.drain")
    }

    /// Remove entries accepted by `predicate` and return them.
    extractIf(
        &this,
        predicate: (key: &readonly K, value: &V) => boolean,
    ): Iterator<(K, V)> {
        todo("Map.extractIf")
    }

    /// Reserve room for at least `additional` more entries.
    reserve(&this, additional: usize): void {
        todo("Map.reserve");
    }

    /// Shrink storage to fit the current entries.
    shrinkToFit(&this): void {
        todo("Map.shrinkToFit");
    }
}

export extension<K: Hash, V> of Map<K, V>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where K: Equal<K>
{
    /// Create a managed map from `entries`.
    static from(entries: Iterable<(K, V)>): Map<K, V> {
        Map.from(entries)
    }

    /// Create a managed map from `entries`.
    static fromIterator<I: Iterator<(K, V)>>(entries: I): Map<K, V> {
        Map.fromIterator(entries)
    }
}

export extension<K: Hash, V> of ^Map<K, V>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where K: Equal<K>
{
    /// Create an owned map from entries.
    static from(entries: Iterable<(K, V)>): ^Map<K, V> {
        Map.from(entries)
    }

    /// Create an owned map from entries.
    static fromIterator<I: Iterator<(K, V)>>(entries: I): ^Map<K, V> {
        Map.fromIterator(entries)
    }
}
