    /// Borrow the queried key.
    get key(): &readonly K {
        todo("MapEntryHandle.key")
    }

    /// Return whether this handle points at an occupied entry.
    get isOccupied(): boolean {
        todo("MapEntryHandle.isOccupied")
    }

    /// Borrow the current value.
    get(&this): &V | undefined {
        todo("MapEntryHandle.get")
    }

    /// Insert `value` when this handle is vacant.
    orInsert(&this, value: V): &V {
        todo("MapEntryHandle.orInsert")
    }

    /// Insert a value produced by `makeValue` when this handle is vacant.
    orInsertWith(&this, makeValue: () => V): &V {
        todo("MapEntryHandle.orInsertWith")
    }

    /// Insert or replace the value.
    set(&this, value: V): &V {
        todo("MapEntryHandle.set")
    }

    /// Remove the entry.
    remove(&this): V | undefined {
        todo("MapEntryHandle.remove")
