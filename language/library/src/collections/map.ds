export extension<K, V, E> of Map<K, V, E>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where E: Default, E: Equate<K>
{
    /// Create a managed map from `entries`.
    static from(entries: Iterable<(K, V)>): Map<K, V, E> {
        Map.from(entries, E.default())
    }

    /// Create a managed map from `entries`.
    static fromIterator<I: Iterable<(K, V)>>(entries: I): Map<K, V, E> {
        Map.fromIterator(entries, E.default())
    }
}

export extension<K, V, E> of ^Map<K, V, E>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where E: Default, E: Equate<K>
{
    /// Create an owned map from entries.
    static from(entries: Iterable<(K, V)>): ^Map<K, V, E> {
        Map.from(entries, E.default())
    }

    /// Create an owned map from entries.
    static fromIterator<I: Iterable<(K, V)>>(entries: I): ^Map<K, V, E> {
        Map.fromIterator(entries, E.default())
    }
}

