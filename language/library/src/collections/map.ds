        where E: Equate<K, Q>, Q: Copy {
        todo("Map.getEntry")
    }

    /// Look up a borrowed value using the stored comparer.
    getEntry<Q>(
        this,
        key: &immutable Q,
    ): MapEntry<Borrowed<K, 'a, "immutable">, Borrowed<V, 'a, A>> | undefined
        where E: Equate<K, Q> {
        todo("Map.getEntry")
    }

    /// Call `visit` for each borrowed entry and discard its result.
