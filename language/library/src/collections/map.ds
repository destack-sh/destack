        todo("Map.entries")
    }

    /// Borrow a value by key.
    get<Q>(this, key: Q): Borrowed<V, 'a, A> | undefined where E: Equate<K, Q>, Q: Copy {
        todo("Map.get")
    }

    /// Look up a borrowed value using the stored comparer.
    get<Q>(this, key: &immutable Q): Borrowed<V, 'a, A> | undefined
        where E: Equate<K, Q> {
        todo("Map.get")
    }

    /// Borrow an entry by key.
    getEntry<Q>(
        this,
        key: Q,
