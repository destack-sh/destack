import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import {
    Borrowed,
    Copy,
    Default,
    MaybeUninit,
    Region,
    WithAccess,
} from "destack:memory";
import { Equality, Equate, Index, IndexSet } from "destack:ops";

import { Array } from "./array.ds";
import { Slice } from "./slice.ds";

/// One map entry.
export struct MapEntry<K, V> {
    /// The entry key.
    key: K;

    /// The entry value.
    value: V;
}

/// Mutating access to one map entry.
export struct MapEntryHandle<'a, K, V, E = Equality<K>> {
    /// The borrowed map.
    private map: &'a exclusive Map<K, V, E>;

    /// The queried key.
    private entryKey: K;
}

/// One map slot.
struct MapSlot<K, V> {
    /// The cached key hash.
    hash: uint64;

    /// The slot entry.
    entry: MapEntry<K, V>;
}

/// A compact hash map.
///
/// Use the stored comparer for every key comparison and hash.
/// Keys must preserve their equality and hash while stored.
@languageItem("collections.Map")
export class Map<K, V, E = Equality<K>> {
    /// The key comparer.
    private comparer: E;

    /// The slot storage.
    private slots: ^[MaybeUninit<MapSlot<K, V>>] = Slice.new();

    /// The hash index.
    private index: ^[uint32] = Slice.new();

    /// The number of live entries.
    private count: usize = 0;

    /// The allocated entry count.
    private capacity: usize = 0;

    /// Create a collection from entries using its default comparer.
    constructor(entries?: Iterable<(K, V)> | null) where E: Default, E: Equate<K> {
        todo("Map.constructor");
    }

    /// Create a collection from entries using comparer.
    constructor(entries: Iterable<(K, V)> | null | undefined, options: { comparer: E })
        where E: Equate<K> {
        todo("Map.constructor");
    }
}

export extension<K, V, E> of ^Map<K, V, E> implements Iterable<(K, V)> {
    /// Consume this map into owned entries.
    iterator(this): this.Iterator {
        todo("Map.iterator")
    }
}

