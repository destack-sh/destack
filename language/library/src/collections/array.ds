    }

    /// Return the first copied element accepted by `predicate`.
    find(predicate: (value: T, index: isize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Return the index of the first copied element accepted by `predicate`.
    findIndex(predicate: (value: T, index: isize) => boolean): isize | undefined {
        todo("Array.findIndex")
    }

    /// Return the last copied element accepted by `predicate`.
    findLast(predicate: (value: T, index: isize) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last copied element accepted by `predicate`.
    findLastIndex(predicate: (value: T, index: isize) => boolean): isize | undefined {
        todo("Array.findLastIndex")
    }

    /// Return whether any copied element is accepted by `predicate`.
    some(predicate: (value: T, index: isize) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every copied element is accepted by `predicate`.
    every(predicate: (value: T, index: isize) => boolean): boolean {
        todo("Array.every")
    }

    /// Sort this array by its natural order.
    sort(): this where T: Compare<T> {
        todo("Array.sort")
    }

    /// Sort this array with copied values.
    sort(compare: (left: T, right: T) => Ordering): this {
        todo("Array.sort")
    }

    /// Return a naturally sorted clone.
    toSorted(): ^Array<T> where T: Compare<T> {
        todo("Array.toSorted")
    }

    /// Return a clone sorted with copied values.
    toSorted(compare: (left: T, right: T) => Ordering): ^Array<T> {
        todo("Array.toSorted")
    }

    /// Return an iterator over copied values.
