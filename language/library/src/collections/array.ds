import { As, Borrow, From } from "destack:convert";
import { Result, todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import {
    Access,
    AllocationError,
    Borrowed,
    Clone,
    Copy,
    Default,
    MaybeUninit,
    Unique,
    WithAccess,
} from "destack:memory";
import { Compare, Index, IndexSet, Ordering, PartialEqual } from "destack:ops";
import { RangeBounds } from "destack:range";

import { Sequence } from "./sequence.ds";

/// Readonly view of a dynamic array.
@languageItem("collections.ReadonlyArray")
export type ReadonlyArray<T> = readonly T[];

/// A growable compact array.
@languageItem("collections.Array")
export class Array<T> {
    /// The contiguous storage.
    private storage: Unique<[MaybeUninit<T>]> = Unique.empty();

    /// The number of initialized elements.
    private count: usize = 0;

    /// The allocated element count.
    private allocated: usize = 0;
}

export extension<T> of ^Array<T> implements Iterable<T>, Sequence {
    /// The owned sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Return the number of elements.
    get length(): usize {
        this.count
    }

    /// Move the elements from `start..end` for a rest pattern.
    rest(start: usize, end?: usize): ^Array<T> {
        todo("Array.rest")
    }

    /// Consume this array into owned values.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Consume this array and map its elements into a new array.
    map<U>(map: (value: T, index: usize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Consume this array and retain elements accepted by `predicate`.
    filter(predicate: (value: &readonly T, index: usize) => boolean): ^Array<T> {
        todo("Array.filter")
    }

    /// Consume this array and keep defined mapped values.
    filterMap<U>(map: (value: T, index: usize) => U | undefined): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Consume and reduce elements from left to right.
    reduce<U>(reduce: (accumulator: U, value: T, index: usize) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Consume and reduce elements from right to left.
    reduceRight<U>(reduce: (accumulator: U, value: T, index: usize) => U, initial: U): U {
        todo("Array.reduceRight")
    }

    /// Consume this array and return the first accepted element.
    find(predicate: (value: &readonly T, index: usize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Consume this array and return the last accepted element.
    findLast(predicate: (value: &readonly T, index: usize) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Consume and map elements, then flatten the results.
    flatMap<U>(map: (value: T, index: usize) => U | ^Array<U>): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Consume this array into an iterator over values.
    values(): Iterator<T> {
        todo("Array.values")
    }

    /// Consume this array into an iterator over index-value entries.
    entries(): Iterator<(usize, T)> {
        todo("Array.entries")
    }
}

export extension<T: Copy> of Array<T> implements Iterable<T>, Sequence {
    /// The copied sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Return the number of elements.
    get length(): usize {
        this.count
    }

    /// Copy the elements from `start..end` for a rest pattern.
    rest(start: usize, end?: usize): ^Array<T> {
        todo("Array.rest")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Return the copied element at `offset`.
    at(offset: isize): T | undefined {
        todo("Array.at")
    }

    /// Return the first element by value.
    first(): T | undefined {
        todo("Array.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        todo("Array.last")
    }

    /// Map copied elements into a new array.
    map<U>(map: (value: T, index: usize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Filter copied elements into a new array.
    filter(predicate: (value: T, index: usize) => boolean): ^Array<T> {
        todo("Array.filter")
    }

    /// Map copied elements and keep defined values.
    filterMap<U>(map: (value: T, index: usize) => U | undefined): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Reduce copied elements from left to right.
    reduce<U>(reduce: (accumulator: U, value: T, index: usize) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Reduce copied elements from right to left.
    reduceRight<U>(reduce: (accumulator: U, value: T, index: usize) => U, initial: U): U {
        todo("Array.reduceRight")
    }

    /// Return the first copied element accepted by `predicate`.
    find(predicate: (value: T, index: usize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Return the index of the first copied element accepted by `predicate`.
    findIndex(predicate: (value: T, index: usize) => boolean): usize | undefined {
        todo("Array.findIndex")
    }

    /// Return the last copied element accepted by `predicate`.
    findLast(predicate: (value: T, index: usize) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last copied element accepted by `predicate`.
    findLastIndex(predicate: (value: T, index: usize) => boolean): usize | undefined {
        todo("Array.findLastIndex")
    }

    /// Return whether any copied element is accepted by `predicate`.
    some(predicate: (value: T, index: usize) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every copied element is accepted by `predicate`.
    every(predicate: (value: T, index: usize) => boolean): boolean {
        todo("Array.every")
    }

    /// Sort this array with copied values.
    sort(compare: (left: T, right: T) => Ordering): this {
        todo("Array.sort")
    }

    /// Return a clone sorted with copied values.
    toSorted(compare: (left: T, right: T) => Ordering): ^Array<T> {
        todo("Array.toSorted")
    }

    /// Map copied elements and flatten the results.
    flatMap<U: Clone>(map: (value: T, index: usize) => U | ReadonlyArray<U>): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Return an iterator over copied values.
    values(): Iterator<T> {
        todo("Array.values")
    }

    /// Return an iterator over copied index-value entries.
    entries(): Iterator<(usize, T)> {
        todo("Array.entries")
    }

    /// Call `visit` for each copied element.
    forEach(visit: (value: T, index: usize) => void): void {
        todo("Array.forEach");
    }
}

export extension<T, 'a, const A: Access> of Borrowed<Array<T>, 'a, A>
    implements
        Iterable<Borrowed<T, 'a, A>>,
        Sequence {
    /// The borrowed sequence produced by a rest pattern.
    type Rest = ^Array<Borrowed<T, 'a, A>>;

    /// Return the number of elements.
    get length(): usize {
        this.count
    }

    /// Borrow the elements from `start..end` for a rest pattern.
    rest(start: usize, end?: usize): ^Array<Borrowed<T, 'a, A>> {
        todo("Array.rest")
    }

    /// Return an iterator over borrowed values.
    iterator(): Iterator<Borrowed<T, 'a, A>> {
        todo("Array.iterator")
    }

    /// Borrow the element at `offset`.
    at(offset: isize): Borrowed<T, 'a, A> | undefined {
        todo("Array.at")
    }

    /// Borrow the first element.
    first(): Borrowed<T, 'a, A> | undefined {
        todo("Array.first")
    }

    /// Borrow the last element.
    last(): Borrowed<T, 'a, A> | undefined {
        todo("Array.last")
    }

    /// Map borrowed elements into a new array.
    map<U>(map: (value: Borrowed<T, 'a, "readonly">, index: usize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Filter borrowed elements into a new array.
    filter(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean,
    ): ^Array<Borrowed<T, 'a, A>> {
        todo("Array.filter")
    }

    /// Map borrowed elements and keep defined values.
    filterMap<U>(
        map: (value: Borrowed<T, 'a, "readonly">, index: usize) => U | undefined,
    ): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Reduce borrowed elements from left to right.
    reduce<U>(
        reduce: (accumulator: U, value: Borrowed<T, 'a, "readonly">, index: usize) => U,
        initial: U,
    ): U {
        todo("Array.reduce")
    }

    /// Reduce borrowed elements from right to left.
    reduceRight<U>(
        reduce: (accumulator: U, value: Borrowed<T, 'a, "readonly">, index: usize) => U,
        initial: U,
    ): U {
        todo("Array.reduceRight")
    }

    /// Borrow the first element accepted by `predicate`.
    find(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean,
    ): Borrowed<T, 'a, A> | undefined {
        todo("Array.find")
    }

    /// Return the index of the first borrowed element accepted by `predicate`.
    findIndex(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean,
    ): usize | undefined {
        todo("Array.findIndex")
    }

    /// Borrow the last element accepted by `predicate`.
    findLast(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean,
    ): Borrowed<T, 'a, A> | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last borrowed element accepted by `predicate`.
    findLastIndex(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean,
    ): usize | undefined {
        todo("Array.findLastIndex")
    }

    /// Return whether any borrowed element is accepted by `predicate`.
    some(predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every borrowed element is accepted by `predicate`.
    every(predicate: (value: Borrowed<T, 'a, "readonly">, index: usize) => boolean): boolean {
        todo("Array.every")
    }

    /// Map borrowed elements and flatten the results.
    flatMap<U: Clone>(
        map: (value: Borrowed<T, 'a, "readonly">, index: usize) => U | ReadonlyArray<U>,
    ): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Return an iterator over borrowed values.
    values(): Iterator<Borrowed<T, 'a, A>> {
        todo("Array.values")
    }

    /// Return an iterator over borrowed index-value entries.
    entries(): Iterator<(usize, Borrowed<T, 'a, A>)> {
        todo("Array.entries")
    }

    /// Call `visit` for each borrowed element.
    forEach(visit: (value: Borrowed<T, 'a, "readonly">, index: usize) => void): void {
        todo("Array.forEach");
    }
}

export extension<T> of Array<T>
    implements
        Default,
        Index<usize>,
        IndexSet<usize, T>,
        Extend<T, "exclusive"> {
    /// The indexed output type.
    type Output = T;

    /// Create an empty array.
    static new(): ^Array<T> {
        todo("Array.new")
    }

    /// Create an array with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Array<T> {
        todo("Array.withCapacity")
    }

    /// Try to create an array with room for at least `capacity` elements.
    static tryWithCapacity(capacity: usize): Result<^Array<T>, AllocationError> {
        todo("Array.tryWithCapacity")
    }

    /// Create an array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values` and map each value.
    static from<U>(values: Iterable<U>, map: (value: U, index: usize) => T): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values`.
    static fromIterator<R>(values: Iterator<T, R>): ^Array<T> {
        todo("Array.fromIterator")
    }

    /// Create an array from `items`.
    static of(...items: T[]): ^Array<T> {
        todo("Array.of")
    }

    /// Create the default array.
    static default(): ^Array<T> {
        []
    }

    /// Return the number of elements.
    get length(): usize {
        this.count
    }

    /// Return the number of elements.
    get size(): usize {
        this.count
    }

    /// Return the allocated element count.
    get capacity(): usize {
        this.allocated
    }

    /// Return whether this array has no elements.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Borrow a view over `start..end`.
    view<const A: Access = "readonly">(
        this: WithAccess<&Array<T>, A>,
        start: usize,
        end?: usize,
    ): WithAccess<&[T], A> {
        let view = this.as();

        view.slice(start, end)
    }

    /// Borrow the element at `index`.
    index<const A: Access = "readonly">(
        this: WithAccess<&Array<T>, A>,
        index: usize,
    ): WithAccess<&T, A> {
        todo("Array.index")
    }

    /// Replace the element at `index`.
    indexSet(&exclusive this, index: usize, value: T): void {
        todo("Array.indexSet");
    }

    /// Append `values` and return the new length.
    push(&exclusive this, ...values: T[]): usize {
        todo("Array.push")
    }

    /// Append all `values`.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("Array.extend");
    }

    /// Move all elements from `other` to the end of this array.
    append(&exclusive this, other: ^Array<T>): void {
        todo("Array.append");
    }

    /// Remove and return the last element.
    pop(&exclusive this): T | undefined {
        todo("Array.pop")
    }

    /// Remove and return the last element when `predicate` accepts it.
    popIf(&exclusive this, predicate: (value: &readonly T) => boolean): T | undefined {
        todo("Array.popIf")
    }

    /// Remove and return the first element.
    shift(&exclusive this): T | undefined {
        todo("Array.shift")
    }

    /// Prepend `values` and return the new length.
    unshift(&exclusive this, ...values: T[]): usize {
        todo("Array.unshift")
    }

    /// Insert `value` at `index`.
    insert(&exclusive this, index: usize, value: T): void {
        todo("Array.insert");
    }

    /// Remove and return the element at `index`.
    removeAt(&exclusive this, index: usize): T {
        todo("Array.removeAt")
    }

    /// Swap-remove the element at `index`.
    swapRemove(&exclusive this, index: usize): T {
        todo("Array.swapRemove")
    }

    /// Remove all elements.
    clear(&exclusive this): void {
        todo("Array.clear");
    }

    /// Remove all elements after `length`.
    truncate(&exclusive this, length: usize): void {
        todo("Array.truncate");
    }

    /// Resize this array, cloning `value` when it grows.
    resize(&exclusive this, length: usize, value: T): void where T: Clone {
        todo("Array.resize");
    }

    /// Resize this array, creating each new element with `makeValue`.
    resizeWith(&exclusive this, length: usize, makeValue: () => T): void {
        todo("Array.resizeWith");
    }

    /// Move the elements after `index` into a new array.
    splitOff(&exclusive this, index: usize): ^Array<T> {
        todo("Array.splitOff")
    }

    /// Overwrite a range with `value`.
    fill(&exclusive this, value: T, start?: isize, end?: isize): this where T: Clone {
        todo("Array.fill")
    }

    /// Copy a range within this array.
    copyWithin(&exclusive this, target: isize, start: isize, end?: isize): this where T: Clone {
        todo("Array.copyWithin")
    }

    /// Retain only elements accepted by `predicate`.
    retain(&exclusive this, predicate: (value: &readonly T, index: usize) => boolean): void {
        todo("Array.retain");
    }

    /// Remove all elements and return them.
    drain(&exclusive this): Iterator<T> {
        todo("Array.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(
        &exclusive this,
        predicate: (value: &readonly T, index: usize) => boolean,
    ): Iterator<T> {
        todo("Array.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&exclusive this, additional: usize): void {
        todo("Array.reserve");
    }

    /// Try to reserve room for at least `additional` more elements.
    tryReserve(&exclusive this, additional: usize): Result<void, AllocationError> {
        todo("Array.tryReserve")
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(&exclusive this): void {
        todo("Array.shrinkToFit");
    }

    /// Clone the selected range.
    slice(&readonly this, start?: isize, end?: isize): ^Array<T> where T: Clone {
        todo("Array.slice")
    }

    /// Clone `items` after this array.
    concat(&readonly this, ...items: (T | ReadonlyArray<T>)[]): ^Array<T> where T: Clone {
        todo("Array.concat")
    }

    /// Return whether `value` exists.
    includes<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): boolean
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.includes")
    }

    /// Return the first index of `value`.
    indexOf<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): usize | undefined
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.indexOf")
    }

    /// Return the last index of `value`.
    lastIndexOf<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): usize | undefined
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.lastIndexOf")
    }

    /// Reverse this array in place.
    reverse(&exclusive this): this {
        todo("Array.reverse")
    }

    /// Return a reversed clone.
    toReversed(&readonly this): ^Array<T> where T: Clone {
        todo("Array.toReversed")
    }

    /// Sort this array by its natural order.
    sort(&exclusive this): this where T: Compare<T> {
        todo("Array.sort")
    }

    /// Sort this array with borrowed values.
    sort(&exclusive this, compare: (left: &readonly T, right: &readonly T) => Ordering): this {
        todo("Array.sort")
    }

    /// Sort this array without preserving the order of equal elements.
    sortUnstable(&exclusive this): this where T: Compare<T> {
        todo("Array.sortUnstable")
    }

    /// Sort this array without preserving the order of equal elements.
    sortUnstable(
        &exclusive this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): this {
        todo("Array.sortUnstable")
    }

    /// Return a naturally sorted clone.
    toSorted(&readonly this): ^Array<T> where T: Clone, T: Compare<T> {
        todo("Array.toSorted")
    }

    /// Return a clone sorted with borrowed values.
    toSorted(
        &readonly this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): ^Array<T> where T: Clone {
        todo("Array.toSorted")
    }

    /// Return a naturally sorted clone without preserving equal-element order.
    toSortedUnstable(&readonly this): ^Array<T> where T: Clone, T: Compare<T> {
        todo("Array.toSortedUnstable")
    }

    /// Return a sorted clone without preserving equal-element order.
    toSortedUnstable(
        &readonly this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): ^Array<T> where T: Clone {
        todo("Array.toSortedUnstable")
    }

    /// Splice this array.
    splice(&exclusive this, start: isize, deleteCount?: usize, ...items: T[]): ^Array<T> {
        todo("Array.splice")
    }

    /// Return a spliced clone.
    toSpliced(&readonly this, start: isize, deleteCount?: usize, ...items: T[]): ^Array<T>
        where T: Clone {
        todo("Array.toSpliced")
    }

    /// Return a clone with `value` at `offset`.
    with(&readonly this, offset: isize, value: T): ^Array<T> where T: Clone {
        todo("Array.with")
    }

    /// Clone one level of nested elements into a flat array.
    flat<U: Clone>(this: &readonly Array<ReadonlyArray<U>>): ^Array<U> {
        todo("Array.flat")
    }

    /// Return an iterator over indices.
    keys(&readonly this): Iterator<usize> {
        todo("Array.keys")
    }
}

export extension<T, const A: Access = "readonly"> of Array<T>
    implements
        As<[T], A>,
        Borrow<[T], A> {
    /// Borrow the initialized storage as a slice.
    as(this: WithAccess<&Array<T>, A>): WithAccess<&[T], A> {
        todo("Array.as")
    }

    /// Borrow the initialized storage as a slice.
    borrow(this: WithAccess<&Array<T>, A>): WithAccess<&[T], A> {
        this.as()
    }
}

export extension<T, R: RangeBounds<usize>, const A: Access = "readonly"> of Array<T>
    implements
        Index<R, A> {
    /// The indexed output type.
    type Output = [T];

    /// Borrow the selected range as a view.
    index(this: WithAccess<&Array<T>, A>, range: R): WithAccess<&[T], A> {
        let view = this.as();

        view.index(range)
    }
}

export extension<T> of ^Array<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        Array.from(values)
    }

    /// Create an owned array from `values`.
    static fromIterator<R>(values: Iterator<T, R>): ^Array<T> {
        Array.fromIterator(values)
    }
}
