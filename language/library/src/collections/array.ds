export extension<T, 'a, const A: Access> of Borrowed<Array<T>, 'a, A>
    implements Iterable<Borrowed<T, 'a, A>>, Sequence
{
    /// The borrowed sequence produced by a rest pattern.
    type Rest = ^Array<Borrowed<T, 'a, A>>;

    /// The iterator over borrowed elements.
    type Iterator = ArrayIterator<T, 'a, A>;

    /// Borrow the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Array<Borrowed<T, 'a, A>> {
        todo("Array.rest")
    }

    /// Return an iterator over borrowed values.
    iterator(): ArrayIterator<T, 'a, A> {
        ArrayIterator { array: this }
    }

    /// Borrow the element at `index`, counting from the end when negative.
    at(index: isize): Borrowed<T, 'a, A> | undefined {
        let count = this.length;
        let position = if (index < 0) { index + count } else { index };

        if (position < 0 || position >= count) {
            undefined
        } else {
            this.index(position)
        }
    }

    /// Borrow the first element.
    first(): Borrowed<T, 'a, A> | undefined {
        this.at(0)
    }

    /// Borrow the last element.
    last(): Borrowed<T, 'a, A> | undefined {
        this.at(-1)
    }

    /// Map borrowed elements into a new array.
    map<U>(map: (value: Borrowed<T, 'a, "readonly">, index: isize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Filter borrowed elements into a new array.
    filter(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean,
    ): ^Array<Borrowed<T, 'a, A>> {
        todo("Array.filter")
    }

    /// Map borrowed elements and keep defined values.
    filterMap<U>(
        map: (value: Borrowed<T, 'a, "readonly">, index: isize) => U | undefined,
    ): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Reduce borrowed elements from left to right.
    reduce<U>(
        reduce: (accumulator: U, value: Borrowed<T, 'a, "readonly">, index: isize) => U,
        initial: U,
    ): U {
        todo("Array.reduce")
    }

    /// Reduce borrowed elements from right to left.
    reduceRight<U>(
        reduce: (accumulator: U, value: Borrowed<T, 'a, "readonly">, index: isize) => U,
        initial: U,
    ): U {
        todo("Array.reduceRight")
    }

    /// Borrow the first element accepted by `predicate`.
    find(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean,
    ): Borrowed<T, 'a, A> | undefined {
        todo("Array.find")
    }

    /// Return the index of the first borrowed element accepted by `predicate`.
    findIndex(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean,
    ): isize | undefined {
        todo("Array.findIndex")
    }

    /// Borrow the last element accepted by `predicate`.
    findLast(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean,
    ): Borrowed<T, 'a, A> | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last borrowed element accepted by `predicate`.
    findLastIndex(
        predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean,
    ): isize | undefined {
        todo("Array.findLastIndex")
    }

    /// Return whether any borrowed element is accepted by `predicate`.
    some(predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every borrowed element is accepted by `predicate`.
    every(predicate: (value: Borrowed<T, 'a, "readonly">, index: isize) => boolean): boolean {
        todo("Array.every")
    }

    /// Map borrowed elements and flatten the results.
    flatMap<U: Copy>(
        map: (value: Borrowed<T, 'a, "readonly">, index: isize) => U | ReadonlyArray<U>,
    ): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Return an iterator over borrowed values.
    values(): Iterator<Borrowed<T, 'a, A>> {
        todo("Array.values")
    }

    /// Return an iterator over borrowed index-value entries.
    entries(): Iterator<(isize, Borrowed<T, 'a, A>)> {
        todo("Array.entries")
    }

    /// Call `visit` for each borrowed element and discard its result.
    forEach<R>(
        visit: (
            value: Borrowed<T, 'a, "readonly">,
            index: isize,
            array: Borrowed<Array<T>, 'a, "readonly">,
        ) => R,
    ): void {
        todo("Array.forEach");
    }
}

export extension<T> of Array<T>
    implements Default, Index<isize>, IndexSet<isize, T>, Extend<T, "mutable">
{
    /// The indexed output type.
    type Output = T;

    /// Create an empty array.
    static new(): ^Array<T> {
        new Array<T>()
    }

    /// Create an array with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Array<T> {
        let array: ^Array<T> = new Array<T>();

        array.reserve(capacity);

        array
    }

    /// Create an array over the owned `values`.
    static fromOwnedSlice(values: ^[T]): ^Array<T> {
        let count = values.size;
        let array: ^Array<T> = new Array<T>();

        array.storage = Slice.intoUninit(values);
        array.count = count;
        array.allocated = count.truncate<usize>();

        array
    }

    /// Try to create an array with room for at least `capacity` elements.
    static tryWithCapacity(capacity: usize): Result<^Array<T>, AllocationError> {
        todo("Array.tryWithCapacity")
    }

    /// Create an array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values` and map each value.
    static from<U>(values: Iterable<U>, map: (value: U, index: isize) => T): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values`.
    static fromIterator(values: Iterator<T>): ^Array<T> {
        todo("Array.fromIterator")
    }

    /// Create an array from `items`.
    static of(...items: T[]): ^Array<T> {
        todo("Array.of")
    }

    /// Create an array copied from `values`.
    static fromSlice(values: &readonly [T]): ^Array<T> where T: Clone {
        todo("Array.fromSlice")
    }

    /// Create the default array.
    static default(): ^Array<T> {
        []
    }

    /// Return the number of elements.
    get length(&readonly this): isize {
        this.count
    }

    /// Return the number of elements.
    get size(&readonly this): isize {
        this.count
    }

    /// Return the allocated element count.
    get capacity(&readonly this): usize {
        this.allocated
    }

    /// Return whether this array has no elements.
    get isEmpty(&readonly this): boolean {
        this.count == 0
    }

    /// Borrow a view over `start..end`.
    view<const A: Access = "readonly">(
        this: WithAccess<&Array<T>, A>,
        start: isize,
        end?: isize,
    ): WithAccess<&[T], A> {
        let view = this.as();

        view.slice(start, end)
    }

    /// Borrow the element at `index`, counting from the end when negative.
    index<const A: Access = "readonly">(
        this: WithAccess<&Array<T>, A>,
        index: isize,
    ): WithAccess<&T, A> {
        let position = elementPosition(this, index);

        assumeInitReference<T, A>(elementSlot<T, A>(this, position))
    }

    /// Replace the element at `index`, counting from the end when negative.
    indexSet(&this, index: isize, value: T): void {
        replace(this.index(index), value);
    }

    /// Append `values` and return the new length.
    push(&this, ...values: T[]): isize {
        this.append(values);

        this.count
    }

    /// Append all `values`.
    extend(&this, values: Iterable<T>): void {
        todo("Array.extend");
    }

    /// Move all elements from `other` to the end of this array.
    append(&this, other: &Array<T>): void {
        let count = other.count;

        this.reserve(count.truncate<usize>());

        for (let index: isize = 0; index < count; index += 1) {
            let value = elementSlot(other, index.truncate<usize>()).assumeInitRead();
            let position = (this.count + index).truncate<usize>();

            elementSlot(this, position).write(value);
        }

        this.count += count;
        other.count = 0;
    }

    /// Remove and return the last element.
    pop(&this): T | undefined {
        if (this.count == 0) {
            return undefined;
        }

        this.count -= 1;

        elementSlot(this, this.count.truncate<usize>()).assumeInitRead()
    }

    /// Remove and return the last element when `predicate` accepts it.
    popIf(&this, predicate: (value: &readonly T) => boolean): T | undefined {
        todo("Array.popIf")
    }

    /// Remove and return the first element.
    shift(&this): T | undefined {
        todo("Array.shift")
    }

    /// Prepend `values` and return the new length.
    unshift(&this, ...values: T[]): isize {
        todo("Array.unshift")
    }

    /// Insert `value` at `index`.
    insert(&this, index: isize, value: T): void {
        todo("Array.insert");
    }

    /// Remove and return the element at `index`.
    removeAt(&this, index: isize): T {
        todo("Array.removeAt")
    }

    /// Swap-remove the element at `index`.
    swapRemove(&this, index: isize): T {
        todo("Array.swapRemove")
    }

    /// Remove all elements.
    clear(&this): void {
        this.truncate(0);
    }

    /// Remove all elements after `length`.
    truncate(&this, length: isize): void {
        let kept = if (length < 0) { 0 } else { length };
        let count = this.count;

        if (kept >= count) {
            return;
        }

        this.count = kept;

        for (let index = kept; index < count; index += 1) {
            elementSlot(this, index.truncate<usize>()).assumeInitDrop();
        }
    }

    /// Resize this array, cloning `value` when it grows.
    resize(&this, length: isize, value: T): void where T: Copy {
        todo("Array.resize");
    }

    /// Resize this array, creating each new element with `makeValue`.
    resizeWith(&this, length: isize, makeValue: () => T): void {
        todo("Array.resizeWith");
    }

    /// Move the elements after `index` into a new array.
    splitOff(&this, index: isize): ^Array<T> {
        todo("Array.splitOff")
    }

    /// Overwrite a range with `value`.
    fill(&this, value: T, start?: isize, end?: isize): this where T: Copy {
        todo("Array.fill")
    }

    /// Copy a range within this array.
    copyWithin(&this, target: isize, start: isize, end?: isize): this where T: Copy {
        todo("Array.copyWithin")
    }

    /// Retain only elements accepted by `predicate`.
    retain(&this, predicate: (value: &readonly T, index: isize) => boolean): void {
        todo("Array.retain");
    }

    /// Remove all elements and return them.
    drain(&this): Iterator<T> {
        todo("Array.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(
        &this,
        predicate: (value: &readonly T, index: isize) => boolean,
    ): Iterator<T> {
        todo("Array.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&this, additional: usize): void {
        let required = this.count.truncate<usize>() + additional;

        if (required <= this.allocated) {
            return;
        }

        let doubled = this.allocated * 2;
        let capacity = if (doubled > required) { doubled } else { required };
        let grown: ^[MaybeUninit<T>] = Slice.uninit(capacity);

        for (let index: isize = 0; index < this.count; index += 1) {
            let value = elementSlot(this, index.truncate<usize>()).assumeInitRead();

            sliceIndex<MaybeUninit<T>, "mutable">(grown, index.truncate<usize>()).write(value);
        }

        this.storage = grown;
        this.allocated = capacity;
    }

    /// Try to reserve room for at least `additional` more elements.
    tryReserve(&this, additional: usize): Result<void, AllocationError> {
        todo("Array.tryReserve")
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(&this): void {
        todo("Array.shrinkToFit");
    }

    /// Clone the selected range.
    slice(&readonly this, start?: isize, end?: isize): ^Array<T> where T: Copy {
        todo("Array.slice")
    }

    /// Clone `items` after this array.
    concat(&readonly this, ...items: (T | ReadonlyArray<T>)[]): ^Array<T> where T: Copy {
        todo("Array.concat")
    }

    /// Flatten nested array elements through `depth` levels.
    flat<const Depth: usize = 1>(&readonly this, depth?: Depth): ^Array<FlattenedElement<T, Depth>>
        where T: Copy {
        todo("Array.flat")
    }

    /// Join the displayed elements with `separator`.
    join(&readonly this, separator?: string): ^string where T: Display {
        todo("Array.join")
    }

    /// Return whether `value` exists.
    includes<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): boolean
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.includes")
    }

    /// Return the first index of `value`.
    indexOf<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): isize | undefined
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.indexOf")
    }

    /// Return the last index of `value`.
    lastIndexOf<Q>(&readonly this, value: &readonly Q, fromIndex?: isize): isize | undefined
        where T: Borrow<Q>, Q: PartialEqual<Q> {
        todo("Array.lastIndexOf")
    }

    /// Reverse this array in place.
    reverse(&this): this {
        todo("Array.reverse")
    }

    /// Return a reversed clone.
    toReversed(&readonly this): ^Array<T> where T: Copy {
        todo("Array.toReversed")
    }

    /// Sort this array by its natural order.
    sort(&this): this where T: Compare<T> {
        todo("Array.sort")
    }

    /// Sort this array with borrowed values.
    sort(&this, compare: (left: &readonly T, right: &readonly T) => Ordering): this {
        todo("Array.sort")
    }

    /// Sort this array without preserving the order of equal elements.
    sortUnstable(&this): this where T: Compare<T> {
        todo("Array.sortUnstable")
    }

    /// Sort this array without preserving the order of equal elements.
    sortUnstable(
        &this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): this {
        todo("Array.sortUnstable")
    }

    /// Return a naturally sorted clone.
    toSorted(&readonly this): ^Array<T> where T: Copy, T: Compare<T> {
        todo("Array.toSorted")
    }

    /// Return a clone sorted with borrowed values.
    toSorted(
        &readonly this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): ^Array<T> where T: Copy {
        todo("Array.toSorted")
    }

    /// Return a naturally sorted clone without preserving equal-element order.
    toSortedUnstable(&readonly this): ^Array<T> where T: Clone, T: Compare<T> {
        todo("Array.toSortedUnstable")
    }

    /// Return a sorted clone without preserving equal-element order.
    toSortedUnstable(
        &readonly this,
        compare: (left: &readonly T, right: &readonly T) => Ordering,
    ): ^Array<T> where T: Clone {
        todo("Array.toSortedUnstable")
    }

    /// Splice this array.
    splice(&this, start: isize, deleteCount?: isize, ...items: T[]): ^Array<T> {
        todo("Array.splice")
    }

    /// Return a spliced clone.
    toSpliced(&readonly this, start: isize, deleteCount?: isize, ...items: T[]): ^Array<T>
        where T: Copy {
        todo("Array.toSpliced")
    }

    /// Return a clone with `value` at `index`.
    with(&readonly this, index: isize, value: T): ^Array<T> where T: Copy {
        todo("Array.with")
    }

    /// Return an iterator over indices.
    keys(&readonly this): Iterator<isize> {
        todo("Array.keys")
    }
}

export extension<T, const A: Access = "readonly"> of Array<T>
    implements As<[T], A>, Borrow<[T], A>
{
    /// Borrow the initialized storage as a slice.
    as(this: WithAccess<&Array<T>, A>): WithAccess<&[T], A> {
        todo("Array.as")
    }

    /// Borrow the initialized storage as a slice.
    borrow(this: WithAccess<&Array<T>, A>): WithAccess<&[T], A> {
        this.as()
    }
}

export extension<T, R: RangeBounds<isize>, const A: Access = "readonly"> of Array<T>
    implements Index<R, A>
{
    /// The indexed output type.
    type Output = [T];

    /// Borrow the selected range as a view.
    index(this: WithAccess<&Array<T>, A>, range: R): WithAccess<&[T], A> {
        let view = this.as();

        view.index(range)
    }
}

export extension<T, R: RangeBounds<isize>> of Array<T>
    implements IndexSet<R, &readonly [T]>
    where T: Copy
{
    /// Copy `source` into the selected range.
    indexSet(&this, range: R, source: &readonly [T]): void {
        let target = this.index(range);

        target.copyFrom(source);
    }
}

export extension<T> of Array<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create a managed array from `values`.
    static from(values: Iterable<T>): Array<T> {
        Array.from(values)
    }

    /// Create a managed array from `values`.
    static fromIterator(values: Iterator<T>): Array<T> {
        Array.fromIterator(values)
    }
}

export extension<T> of ^Array<T> implements From<Iterable<T>>, FromIterator<T> {
    /// Create an owned array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        Array.from(values)
    }

    /// Create an owned array from `values`.
    static fromIterator(values: Iterator<T>): ^Array<T> {
        Array.fromIterator(values)
    }
}

/// Iterator over the borrowed elements of an array.
export struct ArrayIterator<T, 'a, const A: Access> {
    /// The iterated array.
    private array: Borrowed<Array<T>, 'a, A>;

    /// The index of the next element.
    private position: isize = 0;
}

export extension<T, 'a, const A: Access> of ArrayIterator<T, 'a, A>
    implements Iterator<Borrowed<T, 'a, A>>
{
    /// Advance to the next borrowed element.
    next(&this): IteratorResult<Borrowed<T, 'a, A>> {
        let array = this.array;

        if (this.position >= array.length) {
            return IteratorResult(IteratorReturn { value: undefined });
        }

        let value = array.index(this.position);

        this.position += 1;

        IteratorResult(IteratorYield { value })
    }
}

/// Create an array over the owned `values` of a literal or rest pack.
@languageItem("collections.array.fromOwnedSlice")
export function arrayFromOwnedSlice<T>(values: ^[T]): ^Array<T> {
    Array.fromOwnedSlice(values)
}

/// Return the storage position of `index`, counting from the end when negative.
function elementPosition<T>(array: &readonly Array<T>, index: isize): usize {
    let count = array.count;
    let position = if (index < 0) { index + count } else { index };

    if (position < 0 || position >= count) {
        panic("array index out of bounds")
    }

    position.truncate<usize>()
}

/// Borrow the element storage at `position`.
function elementSlot<T, const A: Access = "readonly">(
    array: WithAccess<&Array<T>, A>,
    position: usize,
): WithAccess<&MaybeUninit<T>, A> {
    sliceIndex<MaybeUninit<T>, A>(array.storage, position)
}
