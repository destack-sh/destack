import { As, Borrow, From, ToOwned } from "destack:convert";
import { Result, todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import {
    Access,
    AllocationError,
    Clone,
    Default,
    MaybeUninit,
    Unique,
    WithAccess,
} from "destack:memory";
import { Index, IndexSet } from "destack:ops";
import { RangeBounds } from "destack:range";

import { Slice } from "./slice.ds";

/// Readonly view of a dynamic array.
@languageItem("collections.ReadonlyArray")
export type ReadonlyArray<T> = readonly T[];

/// Fixed-size array alias.
@languageItem("collections.FixedArray")
export type FixedArray<T, comptime N: number> = [T; N];

extension<T, comptime N: number> of FixedArray<T, N> implements
    Index<usize>,
    IndexSet<usize, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T> {
    /// The indexed output type.
    type Output = T;

    /// Return the number of elements.
    get length(): number {
        N
    }

    /// Return the number of elements.
    get size(): usize {
        N as usize
    }

    /// Return whether this fixed array has no elements.
    get isEmpty(): boolean {
        N == 0
    }

    /// Return the element at `index` by value.
    index(index: usize): T {
        todo("FixedArray.index")
    }

    /// Borrow the element at `index`.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&FixedArray<T, N>, A>,
        index: usize,
    ): WithAccess<&T, A> {
        todo("FixedArray.index")
    }

    /// Replace the element at `index`.
    indexSet(&exclusive this, index: usize, value: T): void {
        todo("FixedArray.indexSet");
    }

    /// Return the first element by value.
    first(): T | undefined {
        todo("FixedArray.first")
    }

    /// Borrow the first element.
    first<comptime A: Access = "readonly">(
        this: WithAccess<&FixedArray<T, N>, A>,
    ): WithAccess<&T, A> | undefined {
        todo("FixedArray.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        todo("FixedArray.last")
    }

    /// Borrow the last element.
    last<comptime A: Access = "readonly">(
        this: WithAccess<&FixedArray<T, N>, A>,
    ): WithAccess<&T, A> | undefined {
        todo("FixedArray.last")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("FixedArray.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator<comptime A: Access = "readonly">(
        this: WithAccess<&FixedArray<T, N>, A>,
    ): Iterator<WithAccess<&T, A>> {
        todo("FixedArray.iterator")
    }
}

extension<T, comptime N: number, comptime A: Access = "readonly"> of FixedArray<T, N> implements
    As<Slice<T>, A>,
    Borrow<Slice<T>, A> {
    /// Borrow this fixed array as a slice.
    as(this: WithAccess<&FixedArray<T, N>, A>): WithAccess<&Slice<T>, A> {
        todo("FixedArray.as")
    }

    /// Borrow this fixed array as a slice.
    borrow(this: WithAccess<&FixedArray<T, N>, A>): WithAccess<&Slice<T>, A> {
        this.as()
    }
}

extension<T, comptime N: number, R: RangeBounds<usize>> of FixedArray<T, N> implements Index<R> {
    /// The indexed output type.
    type Output = Slice<T>;

    /// Return the selected range by value.
    index(range: R): Slice<T> {
        todo("FixedArray.indexRange")
    }

    /// Borrow the selected range.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&FixedArray<T, N>, A>,
        range: R,
    ): WithAccess<&Slice<T>, A> {
        todo("FixedArray.indexRange")
    }
}

extension<T, comptime N: number, R: RangeBounds<usize>> of FixedArray<T, N> implements
    IndexSet<R, Slice<T>> where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: Slice<T>): void {
        todo("FixedArray.indexSetRange");
    }
}

extension<T, comptime N: number, R: RangeBounds<usize>> of FixedArray<T, N> implements
    IndexSet<R, &readonly Slice<T>> where T: Copy {
    /// Copy `source` into the selected range.
    indexSet(&exclusive this, range: R, source: &readonly Slice<T>): void {
        todo("FixedArray.indexSetRange");
    }
}

/// A growable compact array.
@languageItem("collections.Array")
export class Array<T> {
    /// The contiguous storage.
    storage: Unique<[MaybeUninit<T>]>;

    /// The number of initialized elements.
    count: usize = 0;

    /// The allocated element count.
    capacity: usize = 0;
}

extension<T> of Array<T> implements
    Index<usize>,
    IndexSet<usize, T>,
    Iterable<T>,
    Iterable<&T>,
    Iterable<&readonly T>,
    Iterable<&exclusive T>,
    Extend<T, "exclusive"> {
    /// The indexed output type.
    type Output = T;

    /// Create an empty array.
    static new(): ^Array<T> {
        todo("Array.new")
    }

    /// Create an array with room for at least `capacity` elements.
    static withCapacity(capacity: usize): ^Array<T> {
        todo("Array.withCapacity")
    }

    /// Try to create an array with room for at least `capacity` elements.
    static tryWithCapacity(capacity: usize): Result<^Array<T>, AllocationError> {
        todo("Array.tryWithCapacity")
    }

    /// Create an array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values` and map each value.
    static from<U>(values: Iterable<U>, map: (value: U, index: number) => T): ^Array<T> {
        todo("Array.from")
    }

    /// Create an array from `values`.
    static fromIterator(values: Iterator<T>): ^Array<T> {
        todo("Array.fromIterator")
    }

    /// Create an array from `items`.
    static of(...items: T[]): ^Array<T> {
        todo("Array.of")
    }

    /// Create the default array.
    static default(): ^Array<T> {
        Array.new()
    }

    /// Return the number of elements.
    get length(): number {
        this.count as number
    }

    /// Return the number of elements.
    get size(): usize {
        this.count
    }

    /// Return whether this array has no elements.
    get isEmpty(): boolean {
        this.count == 0
    }

    /// Return the element at `index` by value.
    index(index: usize): T {
        todo("Array.index")
    }

    /// Return the element at `index`, counting from the end when negative.
    at(index: number): T | undefined {
        todo("Array.at")
    }

    /// Borrow the element at `index`.
    index<comptime A: Access = "readonly">(this: WithAccess<&Array<T>, A>, index: usize): WithAccess<&T, A> {
        todo("Array.index")
    }

    /// Replace the element at `index`.
    indexSet(&exclusive this, index: usize, value: T): void {
        todo("Array.indexSet");
    }

    /// Return the first element by value.
    first(): T | undefined {
        todo("Array.first")
    }

    /// Borrow the first element.
    first<comptime A: Access = "readonly">(this: WithAccess<&Array<T>, A>): WithAccess<&T, A> | undefined {
        todo("Array.first")
    }

    /// Return the last element by value.
    last(): T | undefined {
        todo("Array.last")
    }

    /// Borrow the last element.
    last<comptime A: Access = "readonly">(this: WithAccess<&Array<T>, A>): WithAccess<&T, A> | undefined {
        todo("Array.last")
    }

    /// Append `value`.
    push(&exclusive this, value: T): void {
        todo("Array.push");
    }

    /// Append `values`.
    push(&exclusive this, ...values: T[]): number {
        todo("Array.push")
    }

    /// Append all `values`.
    extend(&exclusive this, values: Iterable<T>): void {
        todo("Array.extend");
    }

    /// Remove and return the last element.
    pop(&exclusive this): T | undefined {
        todo("Array.pop")
    }

    /// Remove and return the first element.
    shift(&exclusive this): T | undefined {
        todo("Array.shift")
    }

    /// Prepend `values`.
    unshift(&exclusive this, ...values: T[]): number {
        todo("Array.unshift")
    }

    /// Insert `value` at `index`.
    insert(&exclusive this, index: usize, value: T): void {
        todo("Array.insert");
    }

    /// Remove and return the element at `index`.
    removeAt(&exclusive this, index: usize): T {
        todo("Array.removeAt")
    }

    /// Swap-remove the element at `index`.
    swapRemove(&exclusive this, index: usize): T {
        todo("Array.swapRemove")
    }

    /// Remove all elements.
    clear(&exclusive this): void {
        todo("Array.clear");
    }

    /// Overwrite a range with `value`.
    fill(&exclusive this, value: T, start?: number, end?: number): this {
        todo("Array.fill")
    }

    /// Copy a range within this array.
    copyWithin(&exclusive this, target: number, start: number, end?: number): this {
        todo("Array.copyWithin")
    }

    /// Retain only elements accepted by `predicate`.
    retain(&exclusive this, predicate: (value: &T, index: usize) => boolean): void {
        todo("Array.retain");
    }

    /// Remove all elements and return them.
    drain(&exclusive this): Iterator<T> {
        todo("Array.drain")
    }

    /// Remove elements accepted by `predicate` and return them.
    extractIf(&exclusive this, predicate: (value: &T, index: usize) => boolean): Iterator<T> {
        todo("Array.extractIf")
    }

    /// Reserve room for at least `additional` more elements.
    reserve(&exclusive this, additional: usize): void {
        todo("Array.reserve");
    }

    /// Try to reserve room for at least `additional` more elements.
    tryReserve(this: &exclusive Array<T>, additional: usize): Result<void, AllocationError> {
        todo("Array.tryReserve")
    }

    /// Shrink capacity to fit the current length.
    shrinkToFit(&exclusive this): void {
        todo("Array.shrinkToFit");
    }

    /// Return a copy of the selected range.
    slice(start?: number, end?: number): ^Array<T> {
        todo("Array.slice")
    }

    /// Concatenate arrays.
    concat(...items: Array<T>[]): ^Array<T> {
        todo("Array.concat")
    }

    /// Map each element to a new array.
    map<U>(f: (value: T, index: number) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Filter elements into a new array.
    filter(predicate: (value: T, index: number) => boolean): ^Array<T> {
        todo("Array.filter")
    }

    /// Reduce this array to one value.
    reduce<U>(f: (accumulator: U, value: T, index: number) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Return the first element accepted by `predicate`.
    find(predicate: (value: T, index: number) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Return the index of the first element accepted by `predicate`.
    findIndex(predicate: (value: T, index: number) => boolean): number {
        todo("Array.findIndex")
    }

    /// Return the last element accepted by `predicate`.
    findLast(predicate: (value: T, index: number) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Return the index of the last element accepted by `predicate`.
    findLastIndex(predicate: (value: T, index: number) => boolean): number {
        todo("Array.findLastIndex")
    }

    /// Return whether any element is accepted by `predicate`.
    some(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.some")
    }

    /// Return whether every element is accepted by `predicate`.
    every(predicate: (value: T, index: number) => boolean): boolean {
        todo("Array.every")
    }

    /// Return whether `value` exists.
    includes(value: T, fromIndex?: number): boolean {
        todo("Array.includes")
    }

    /// Return the first index of `value`.
    indexOf(value: T, fromIndex?: number): number {
        todo("Array.indexOf")
    }

    /// Return the last index of `value`.
    lastIndexOf(value: T, fromIndex?: number): number {
        todo("Array.lastIndexOf")
    }

    /// Join stringified elements with `separator`.
    join(separator?: string): ^string {
        todo("Array.join")
    }

    /// Reverse this array in place.
    reverse(&exclusive this): this {
        todo("Array.reverse")
    }

    /// Return a reversed copy.
    toReversed(): ^Array<T> {
        todo("Array.toReversed")
    }

    /// Sort this array in place.
    sort(&exclusive this, compare?: (a: &readonly T, b: &readonly T) => number): this {
        todo("Array.sort")
    }

    /// Return a sorted copy.
    toSorted(compare?: (a: &readonly T, b: &readonly T) => number): ^Array<T> {
        todo("Array.toSorted")
    }

    /// Splice this array.
    splice(&exclusive this, start: number, deleteCount?: number, ...items: T[]): ^Array<T> {
        todo("Array.splice")
    }

    /// Return a spliced copy.
    toSpliced(start: number, deleteCount?: number, ...items: T[]): ^Array<T> {
        todo("Array.toSpliced")
    }

    /// Return a copy with `value` at `index`.
    with(index: number, value: T): ^Array<T> {
        todo("Array.with")
    }

    /// Flatten nested arrays.
    flat<U>(this: Array<ReadonlyArray<U>>, depth?: number): ^Array<U> {
        todo("Array.flat")
    }

    /// Map and flatten nested arrays.
    flatMap<U>(f: (value: T, index: number) => U | ReadonlyArray<U>): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Return an iterator over indices.
    keys(): Iterator<usize> {
        todo("Array.keys")
    }

    /// Return an iterator over copied values.
    values(): Iterator<T> {
        todo("Array.values")
    }

    /// Return an iterator over copied index-value entries.
    entries(): Iterator<(number, T)> {
        todo("Array.entries")
    }

    /// Return an iterator over copied values.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Return an iterator over borrowed values.
    iterator<comptime A: Access = "readonly">(this: WithAccess<&Array<T>, A>): Iterator<WithAccess<&T, A>> {
        todo("Array.iterator")
    }

    /// Consume this array into owned values.
    iterator(^this): Iterator<T> {
        todo("Array.iterator")
    }

    /// Call `f` for each element.
    forEach(f: (value: T, index: number, array: Array<T>) => void): void {
        todo("Array.forEach");
    }
}

extension<T, comptime A: Access = "readonly"> of Array<T> implements As<Slice<T>, A>, Borrow<Slice<T>, A> {
    /// Borrow the initialized storage as a slice.
    as(this: WithAccess<&Array<T>, A>): WithAccess<&Slice<T>, A> {
        todo("Array.as")
    }

    /// Borrow the initialized storage as a slice.
    borrow(this: WithAccess<&Array<T>, A>): WithAccess<&Slice<T>, A> {
        this.as()
    }
}

extension<T> of Slice<T> implements ToOwned where T: Clone {
    /// The owned value type.
    type Owned = ^Array<T>;

    /// Copy this slice into owned array storage.
    toOwned(&readonly this): ^Array<T> {
        todo("Slice.toOwned")
    }
}

extension<T> of ^Array<T> implements Default, From<Iterable<T>>, FromIterator<T> {
    /// Create the default owned array.
    static default(): ^Array<T> {
        Array.default()
    }

    /// Create an owned array from `values`.
    static from(values: Iterable<T>): ^Array<T> {
        Array.from(values)
    }

    /// Create an owned array from `values`.
    static fromIterator(values: Iterator<T>): ^Array<T> {
        Array.fromIterator(values)
    }
}
