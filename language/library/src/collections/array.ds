import { As, Borrow, From } from "destack:convert";
import { panic, Result, todo } from "destack:error";
import {
    Extend,
    FromIterator,
    Iterable,
    Iterator,
    IteratorResult,
    IteratorReturn,
    IteratorYield,
} from "destack:iter";
import {
    Access,
    AllocationError,
    assumeInitReference,
    Borrowed,
    Clone,
    Copy,
    Default,
    Drop,
    MaybeUninit,
    replace,
    WithAccess,
} from "destack:memory";
import { Compare, Display, Index, IndexSet, Ordering, PartialEqual } from "destack:ops";
import { RangeBounds } from "destack:range";

import { Sequence } from "./sequence.ds";
import { Slice, sliceIndex } from "./slice.ds";

/// Readonly view of a dynamic array.
@languageItem("collections.ReadonlyArray")
export type ReadonlyArray<T> = readonly T[];

/// The element produced by flattening `T` through `Depth` nested arrays.
export type FlattenedElement<T, Depth: usize> = usize extends Depth
    ? unknown
    : Depth extends 0
      ? T
      : T extends ReadonlyArray<infer U>
        ? FlattenedElement<U, Depth - 1>
        : T;

/// A growable compact array.
@languageItem("collections.Array")
export class Array<T> {
    /// The contiguous storage.
    private storage: ^[MaybeUninit<T>] = Slice.new();

    /// The number of initialized elements.
    private count: isize = 0;

    /// The allocated element count.
    private allocated: usize = 0;
}

export extension<T> of Array<T> implements Clone where T: Clone {
    /// Clone this array and its elements.
    clone(&readonly this): ^this {
        todo("Array.clone")
    }
}

export extension<T> of Array<T> implements Drop {
    /// Drop the initialized elements.
    drop(&this): void {
        this.clear();
    }
}

export extension<T> of ^Array<T> implements Iterable<T>, Sequence {
    /// The owned sequence produced by a rest pattern.
    type Rest = ^Array<T>;

    /// Move the elements from `start..end` for a rest pattern.
    rest(start: isize, end?: isize): ^Array<T> {
        todo("Array.rest")
    }

    /// Consume this array into owned values.
    iterator(): Iterator<T> {
        todo("Array.iterator")
    }

    /// Consume this array and map its elements into a new array.
    map<U>(map: (value: T, index: isize) => U): ^Array<U> {
        todo("Array.map")
    }

    /// Consume this array and retain elements accepted by `predicate`.
    filter(predicate: (value: &readonly T, index: isize) => boolean): ^Array<T> {
        todo("Array.filter")
    }

    /// Consume this array and keep defined mapped values.
    filterMap<U>(map: (value: T, index: isize) => U | undefined): ^Array<U> {
        todo("Array.filterMap")
    }

    /// Consume and reduce elements from left to right.
    reduce<U>(reduce: (accumulator: U, value: T, index: isize) => U, initial: U): U {
        todo("Array.reduce")
    }

    /// Consume and reduce elements from right to left.
    reduceRight<U>(reduce: (accumulator: U, value: T, index: isize) => U, initial: U): U {
        todo("Array.reduceRight")
    }

    /// Consume this array and return the first accepted element.
    find(predicate: (value: &readonly T, index: isize) => boolean): T | undefined {
        todo("Array.find")
    }

    /// Consume this array and return the last accepted element.
    findLast(predicate: (value: &readonly T, index: isize) => boolean): T | undefined {
        todo("Array.findLast")
    }

    /// Consume and map elements, then flatten the results.
    flatMap<U>(map: (value: T, index: isize) => U | ^Array<U>): ^Array<U> {
        todo("Array.flatMap")
    }

    /// Consume this array into an iterator over values.
    values(): Iterator<T> {
        todo("Array.values")
    }

    /// Consume this array into an iterator over index-value entries.
    entries(): Iterator<(isize, T)> {
        todo("Array.entries")
    }
}

