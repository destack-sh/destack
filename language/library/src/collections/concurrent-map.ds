        todo("ConcurrentMap.read")
    }

    /// Look up a borrowed value using the stored comparer.
    read<'a, Q>(&'a readonly this, key: &immutable Q): ConcurrentMapRead<'a, K, V, E> | undefined
        where E: Equate<K, Q> {
        todo("ConcurrentMap.read")
    }

    /// Return a write guard for one entry.
