        todo("ConcurrentMapEntry.orInsertWith")
    }

    /// Insert or replace the value.
    set(&exclusive this, value: V): &exclusive shared V where E: Equate<K> {
        todo("ConcurrentMapEntry.set")
    }

    /// Remove this entry.
    remove(this): V | undefined {
        todo("ConcurrentMapEntry.remove")
    }

    /// Release this guard.
    dispose(this): void {
