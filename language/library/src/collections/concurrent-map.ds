export extension<K, V, E: SharedSafe> of ConcurrentMap<K, V, E>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where E: Default, E: Equate<K>
{
    /// Create a managed concurrent map from `entries`.
    static from(entries: Iterable<(K, V)>): ConcurrentMap<K, V, E> {
        ConcurrentMap.from(entries, E.default())
    }

    /// Create a managed concurrent map from `entries`.
    static fromIterator<I: Iterable<(K, V)>>(entries: I): ConcurrentMap<K, V, E> {
        ConcurrentMap.fromIterator(entries, E.default())
    }
}

export extension<K, V, E: SharedSafe> of ^ConcurrentMap<K, V, E>
    implements From<Iterable<(K, V)>>, FromIterator<(K, V)>
    where E: Default, E: Equate<K>
{
    /// Create an owned concurrent map from entries.
    static from(entries: Iterable<(K, V)>): ^ConcurrentMap<K, V, E> {
        ConcurrentMap.from(entries, E.default())
    }

    /// Create an owned concurrent map from entries.
    static fromIterator<I: Iterable<(K, V)>>(entries: I): ^ConcurrentMap<K, V, E> {
        ConcurrentMap.fromIterator(entries, E.default())
    }
}

export extension<'a, K, V, E> of ConcurrentMapWrite<'a, K, V, E>
    implements Dereference<"readonly">
{
    /// The pointee type.
    type Target = shared V;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the protected value with readonly access.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("ConcurrentMapWrite.dereference")
    }
}

export extension<K, V, E: SharedSafe> of ConcurrentMap<K, V, E> {
    /// Return the number of entries.
    get size(&readonly this): usize {
        this.count.load(MemoryOrdering.SequentiallyConsistent)
    }

    /// Return whether this map has no entries.
    get isEmpty(&readonly this): boolean {
        this.count.load(MemoryOrdering.SequentiallyConsistent) == 0
    }

    /// Remove all entries and return them.
    drain(&readonly this): Iterator<(K, V)> {
        todo("ConcurrentMap.drain")
    }

    /// Remove all entries.
    clear(&readonly this): void {
        todo("ConcurrentMap.clear");
    }
}
