import { From } from "destack:convert";
import { todo } from "destack:error";
import { Extend, FromIterator, Iterable, Iterator } from "destack:iter";
import {
    Access,
    Borrowed,
    Copy,
    Default,
    Dispose,
    Managed,
    Region,
    SharedSafe,
} from "destack:memory";

import { Dereference, Equality, Equate } from "destack:ops";
import { Atomic, MemoryOrdering, RwLock, RwLockReadGuard, RwLockWriteGuard } from "destack:sync";

import { Array } from "./array.ds";
import { Map } from "./map.ds";

/// Read guard for one concurrent map entry.
export local struct ConcurrentMapRead<'a, K, V, E = Equality<K>> {
    /// The shard read guard.
    private guard: RwLockReadGuard<'a, ^Map<K, V, Managed<E, "shared">>>;

    /// The entry index in the locked shard.
    private index: usize;
}

/// Write guard for one concurrent map entry.
export local struct ConcurrentMapWrite<'a, K, V, E = Equality<K>> {
    /// The shard write guard.
    private guard: RwLockWriteGuard<'a, ^Map<K, V, Managed<E, "shared">>>;

    /// The entry index in the locked shard.
    private index: usize;
}

/// Entry guard for one concurrent map key.
export local struct ConcurrentMapEntry<'a, K, V, E = Equality<K>> {
    /// The shard write guard.
    private guard: RwLockWriteGuard<'a, ^Map<K, V, Managed<E, "shared">>>;

    /// The queried key.
    private entryKey: K;
}

/// A sharded concurrent hash map.
@languageItem("collections.ConcurrentMap")
export shared class ConcurrentMap<K, V, E: SharedSafe = Equality<K>> {
    /// The key comparer.
    private comparer: Managed<E, "shared">;

    /// Create a collection from entries using its default comparer.
    constructor(entries?: Iterable<(K, V)> | null) where E: Default, E: Equate<K> {
        todo("ConcurrentMap.constructor");
    }

    /// Create a collection from entries using comparer.
    constructor(entries: Iterable<(K, V)> | null | undefined, options: { comparer: E })
        where E: Equate<K> {
        todo("ConcurrentMap.constructor");
    }

    /// The map shards.
    private shards: ^Array<RwLock<^Map<K, V, Managed<E, "shared">>>> = [];

    /// The number of live entries.
    private count: Atomic<usize> = Atomic.new(0);
}

export extension<'a, K, V, E> of ConcurrentMapRead<'a, K, V, E>
    implements Dispose, !Copy, Dereference<"readonly">
{
    /// The pointee type.
    type Target = shared V;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the entry key.
    get key(&readonly this): &immutable shared K {
        todo("ConcurrentMapRead.key")
    }

    /// Borrow the entry value.
    get value(&readonly this): &immutable shared V {
        todo("ConcurrentMapRead.value")
    }

    /// Release this guard.
    dispose(this): void {
        todo("ConcurrentMapRead.dispose");
    }

    /// Borrow the entry value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("ConcurrentMapRead.dereference")
    }
}

export extension<'a, K, V, E> of ConcurrentMapWrite<'a, K, V, E>
    implements Dispose, !Copy, Dereference<"exclusive">
{
    /// The pointee type.
    type Target = shared V;

    /// Borrow the entry key.
    get key(&immutable this): &immutable shared K {
        todo("ConcurrentMapWrite.key")
    }

    /// Borrow the entry value with mutable access.
    get value(&exclusive this): &exclusive shared V {
        todo("ConcurrentMapWrite.value")
    }

    /// Remove this entry.
    remove(this): V {
        todo("ConcurrentMapWrite.remove")
    }

    /// Release this guard.
    dispose(this): void {
        todo("ConcurrentMapWrite.dispose");
    }

    /// Borrow the entry value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "exclusive">,
    ): Borrowed<this.Target, R, "exclusive"> {
        todo("ConcurrentMapWrite.dereference")
    }
}

