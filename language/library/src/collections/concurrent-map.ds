export extension<K, V, E: SharedSafe> of ConcurrentMap<K, V, E> {
    /// Create an empty concurrent map.
    static new(comparer: E): ^ConcurrentMap<K, V, E> {
        todo("ConcurrentMap.new")
    }

    /// Create a concurrent map with room for at least `capacity` entries.
    static withCapacity(capacity: usize, comparer: E): ^ConcurrentMap<K, V, E> {
        todo("ConcurrentMap.withCapacity")
    }

    /// Create an empty collection with its default comparer.
    static new(): ^ConcurrentMap<K, V, E> where E: Default {
        ConcurrentMap.new(E.default())
    }

    /// Create a collection with its default comparer and room for capacity entries.
    static withCapacity(capacity: usize): ^ConcurrentMap<K, V, E> where E: Default {
        ConcurrentMap.withCapacity(capacity, E.default())
    }
}

export extension<K, V, E: SharedSafe> of ConcurrentMap<K, V, E>
    implements Default
    where E: Default
{
    /// Create the default concurrent map.
    static default(): ^ConcurrentMap<K, V, E> {
        ConcurrentMap.new(E.default())
    }
}

