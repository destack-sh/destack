import { HostError } from "destack:error/host";

/// Entropy binding family.
@languageItem("random.binding.RandomEntropyBinding")
export interface RandomEntropyBinding {
    /// Fill one buffer with host-provided random bytes.
    @binding("destack.random.bytes.fill", {
        provider: "host",
        effect: "external",
        requires: ["host.random.bytes"],
        families: ["windows", "unix", "wasm"],
    })
    fillRandomBytes(buffer: &[uint8]): Result<void, HostError>;
}
