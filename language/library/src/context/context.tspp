import { panic } from "tspp:error";
import { Copy } from "tspp:memory";

import { ContextVar } from "./variable.tspp";

/// One immutable dynamically scoped execution context.
@languageItem("context.Context")
export class Context {
    /// Prevent direct construction.
    private constructor() {
        // construction is intentionally unavailable
    }

    /// Return the current execution context.
    static current(): Context {
        return currentContext();
    }

    /// Return the value of `variable` in this context.
    get<T: Copy>(variable: ContextVar<T>): T {
        return getContextValue(this, variable, variable.defaultValue)
            ?? panic("a context variable read outside any binding");
    }

    /// Run `body` with this context.
    run<R>(body: () => R): R {
        const previous = replaceContext(this);

        try {
            return body();
        } finally {
            replaceContext(previous);
        }
    }
}

/// Return the current execution context.
@languageItem("context.current")
@intrinsic("context.current")
export declare function currentContext(): Context;

/// Replace the current execution context and return its previous value.
@languageItem("context.replace")
@intrinsic("context.replace")
export declare function replaceContext(context: Context): Context;

/// Extend one execution context with a variable value.
@languageItem("context.bind")
@intrinsic("context.bind")
export declare function bindContext<T: Copy>(
    context: Context,
    variable: ContextVar<T>,
    value: T,
): Context;

/// Return one variable value from an execution context.
@languageItem("context.get")
@intrinsic("context.get")
export declare function getContextValue<T: Copy>(
    context: Context,
    variable: ContextVar<T>,
    defaultValue: T | undefined,
): T | undefined;
