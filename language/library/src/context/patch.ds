import { AccessibilityBinding } from "destack:accessibility/binding";
import { AudioBinding } from "destack:audio/binding";
import { ComputeBinding } from "destack:compute/binding";
import { CryptoBinding } from "destack:crypto/binding";
import { DeviceBinding } from "destack:device/binding";
import { DisplayBinding } from "destack:display/binding";
import { FsBinding } from "destack:fs/binding";
import { GpuBinding } from "destack:gpu/binding";
import { InputBinding } from "destack:input/binding";
import { IoBinding } from "destack:io/binding";
import { IpcBinding } from "destack:ipc/binding";
import { Dynamic } from "destack:memory";
import { MemoryBinding } from "destack:memory/binding";
import { NetBinding } from "destack:net/binding";
import { OsBinding } from "destack:os/binding";
import { ProcessBinding } from "destack:process/binding";
import { RandomBinding } from "destack:random/binding";
import { TelemetryBinding } from "destack:telemetry/binding";
import { TimeBinding } from "destack:time/binding";
import { TlsBinding } from "destack:tls/binding";
import { TopologyBinding } from "destack:topology/binding";
import { TtyBinding } from "destack:tty/binding";

import { ContextEntry } from "./entry.ds";

/// Scoped context override payload.
@languageItem("context.ContextPatch")
export struct ContextPatch {
    /// Accessibility binding family override.
    accessibility?: Dynamic<AccessibilityBinding>;
    /// Audio binding family override.
    audio?: Dynamic<AudioBinding>;
    /// Compute binding family override.
    compute?: Dynamic<ComputeBinding>;
    /// Crypto binding family override.
    crypto?: Dynamic<CryptoBinding>;
    /// Device binding family override.
    device?: Dynamic<DeviceBinding>;
    /// Display binding family override.
    display?: Dynamic<DisplayBinding>;
    /// Filesystem binding family override.
    fs?: Dynamic<FsBinding>;
    /// GPU binding family override.
    gpu?: Dynamic<GpuBinding>;
    /// Input binding family override.
    input?: Dynamic<InputBinding>;
    /// IO binding family override.
    io?: Dynamic<IoBinding>;
    /// IPC binding family override.
    ipc?: Dynamic<IpcBinding>;
    /// Memory binding family override.
    memory?: Dynamic<MemoryBinding>;
    /// Network binding family override.
    net?: Dynamic<NetBinding>;
    /// Operating system binding family override.
    os?: Dynamic<OsBinding>;
    /// Process binding family override.
    process?: Dynamic<ProcessBinding>;
    /// Random binding family override.
    random?: Dynamic<RandomBinding>;
    /// Telemetry binding family override.
    telemetry?: Dynamic<TelemetryBinding>;
    /// Time binding family override.
    time?: Dynamic<TimeBinding>;
    /// Topology binding family override.
    topology?: Dynamic<TopologyBinding>;
    /// TLS binding family override.
    tls?: Dynamic<TlsBinding>;
    /// TTY binding family override.
    tty?: Dynamic<TtyBinding>;
    /// Userland context entries.
    entries?: [ContextEntry<unknown>];
}
