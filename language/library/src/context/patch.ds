import { Accessibility } from "destack:accessibility/host";
import { Audio } from "destack:audio/host";
import { Crypto } from "destack:crypto/host";
import { Device } from "destack:device/host";
import { Display } from "destack:display/host";
import { Fs } from "destack:fs/host";
import { Gpu } from "destack:gpu/host";
import { Input } from "destack:input/host";
import { Io } from "destack:io/host";
import { Ipc } from "destack:ipc/host";
import { Dynamic } from "destack:memory";
import { Memory } from "destack:memory/host";
import { Net } from "destack:net/host";
import { Os } from "destack:os/host";
import { Process } from "destack:process/host";
import { Random } from "destack:random/host";
import { Time } from "destack:time/host";
import { Tls } from "destack:tls/host";
import { Tty } from "destack:tty/host";

import { ContextEntry } from "./entry.ds";

/// Scoped context override payload.
@languageItem("context.ContextPatch")
export struct ContextPatch {
    /// Accessibility binding family override.
    accessibility?: Dynamic<Accessibility>;
    /// Audio binding family override.
    audio?: Dynamic<Audio>;
    /// Crypto binding family override.
    crypto?: Dynamic<Crypto>;
    /// Device binding family override.
    device?: Dynamic<Device>;
    /// Display binding family override.
    display?: Dynamic<Display>;
    /// Filesystem binding family override.
    fs?: Dynamic<Fs>;
    /// GPU binding family override.
    gpu?: Dynamic<Gpu>;
    /// Input binding family override.
    input?: Dynamic<Input>;
    /// IO binding family override.
    io?: Dynamic<Io>;
    /// IPC binding family override.
    ipc?: Dynamic<Ipc>;
    /// Memory binding family override.
    memory?: Dynamic<Memory>;
    /// Network binding family override.
    net?: Dynamic<Net>;
    /// Operating system binding family override.
    os?: Dynamic<Os>;
    /// Process binding family override.
    process?: Dynamic<Process>;
    /// Random binding family override.
    random?: Dynamic<Random>;
    /// Time binding family override.
    time?: Dynamic<Time>;
    /// TLS binding family override.
    tls?: Dynamic<Tls>;
    /// TTY binding family override.
    tty?: Dynamic<Tty>;
    /// Userland context entries.
    entries?: [ContextEntry<unknown>];
}
