import { panic } from "destack:error";
import { Debug, PartialEqual } from "destack:ops";

/// Require `condition` to hold.
@languageItem("assert.assert")
export function assert(condition: boolean, message?: string): void {
    // stop on the failed invariant
    if (!condition) {
        panic(message ?? "assertion failed")
    }
}

/// Require `actual` and `expected` to compare equal.
export function assertEqual<T, U>(
    actual: &readonly T,
    expected: &readonly U,
    message?: string,
): void where T: Debug, T: PartialEqual<U>, U: Debug {
    // return without formatting successful operands
    if (actual.equal(expected)) {
        return;
    }

    // render both unequal operands
    const actual = actual.debug().intoOwned();
    const expected = expected.debug().intoOwned();
    const message = message ?? "expected values to be equal";

    panic(`${message}\nactual: ${actual}\nexpected: ${expected}`)
}

/// Require `actual` and `expected` to compare unequal.
export function assertNotEqual<T, U>(
    actual: &readonly T,
    expected: &readonly U,
    message?: string,
): void where T: Debug, T: PartialEqual<U>, U: Debug {
    // return without formatting successful operands
    if (!actual.equal(expected)) {
        return;
    }

    // render both unexpectedly equal operands
    const actual = actual.debug().intoOwned();
    const expected = expected.debug().intoOwned();
    const message = message ?? "expected values to be different";

    panic(`${message}\nactual: ${actual}\nexpected: ${expected}`)
}
