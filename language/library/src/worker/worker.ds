import { AsyncResult, Promise, Task } from "destack:async";
import { todo } from "destack:error";
import { Panic } from "destack:error";
import { SharedSafe } from "destack:memory";
import { WorkerHandle, WorkerId } from "destack:runtime/world";

/// Isolated worker.
export class Worker<T, R> {
    /// Opaque runtime worker handle.
    private handle: WorkerHandle;

    /// Create a worker over its runtime handle.
    private constructor(handle: WorkerHandle) {
        this.handle = handle;
    }

    /// Send one message and wait for a reply.
    request(message: T): AsyncResult<R, WorkerError> {
        todo("Worker.request")
    }

    /// Send one message without waiting for a reply.
    post(message: T): void {
        todo("Worker.post");
    }

    /// Observe this worker's exit.
    ///
    /// The worker is the fault boundary: a panic unwinds the worker, and the supervising parent
    /// observes the termination and the panic payload here and decides what to do (restart,
    /// propagate, report).
    exit(): Promise<WorkerExit> {
        todo("Worker.exit")
    }

    /// Request worker shutdown.
    terminate(): Promise<void> {
        todo("Worker.terminate")
    }
}

/// Pool of homogeneous workers.
export local class WorkerPool<T, R> {
    /// The workers in this pool.
    workers: Worker<T, R>[] = Array.new();

    /// Send one request to an available worker.
    request(message: T): AsyncResult<R, WorkerError> {
        todo("WorkerPool.request")
    }

    /// Request shutdown for every worker.
    terminate(): Promise<void> {
        todo("WorkerPool.terminate")
    }
}

/// Worker exit status observed by the supervising parent.
@derive(Tagged)
export newtype WorkerExit =
    | { kind: "completed" }
    | { kind: "terminated" }
    | { kind: "panicked"; panic: Panic };

/// Worker request failure.
@derive(Tagged)
export newtype WorkerError = { kind: "terminated" } | { kind: "panicked"; panic: Panic };

/// Entry function for a worker.
export type WorkerEntry<T, R> = (message: T) => R | Task<R>;

/// Worker spawn options.
export interface WorkerOptions {
    /// Human-readable worker name.
    name?: string;

    /// Initial stack size in bytes.
    stackSize?: usize;
}

/// Spawn one worker.
export function spawn<T: SharedSafe, R: SharedSafe>(
    entry: WorkerEntry<shared T, shared R>,
    options?: WorkerOptions,
): Worker<shared T, shared R> {
    todo("worker.spawn")
}

/// Return the current worker id.
export function current(): WorkerId {
    todo("worker.current")
}
