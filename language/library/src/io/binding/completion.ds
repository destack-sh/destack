import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for a completion queue instance.
export newtype IoCompletionHandle = ResourceId;

/// Completion event flags.
export newtype IoCompletionFlags = uint32;

/// Completion event.
export struct IoCompletionEvent {
    /// User-assigned completion key.
    key: uint64;
    /// Host result value.
    result: int64;
    /// Completion flags.
    flags: IoCompletionFlags;
}

/// Completion binding family.
export interface IoCompletionBinding {
    /// Open a completion queue.
    @binding("destack.io.completion.open", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    openIoCompletion(entries: uint32): Result<IoCompletionHandle, HostError>;

    /// Close a completion queue.
    @binding("destack.io.completion.close", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    closeIoCompletion(completion: IoCompletionHandle): Result<void, HostError>;

    /// Bind one resource to a completion queue.
    @binding("destack.io.completion.bind", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    bindIoCompletion(
        completion: IoCompletionHandle,
        resource: ResourceId,
        key: uint64,
    ): Result<void, HostError>;

    /// Unbind one resource from a completion queue.
    @binding("destack.io.completion.unbind", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    unbindIoCompletion(
        completion: IoCompletionHandle,
        resource: ResourceId,
    ): Result<void, HostError>;

    /// Post one synthetic completion event.
    @binding("destack.io.completion.post", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    postIoCompletion(
        completion: IoCompletionHandle,
        event: IoCompletionEvent,
    ): Result<void, HostError>;

    /// Wait for completion events.
    @binding("destack.io.completion.wait", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    waitIoCompletion(
        completion: IoCompletionHandle,
        events: &[IoCompletionEvent],
        timeoutNs?: uint64,
    ): Result<uint32, HostError>;

    /// Cancel queued completions for one resource.
    @binding("destack.io.completion.cancel", {
        provider: "host",
        effect: "external",
        requires: ["host.io.completion"],
        families: ["windows", "unix"],
    })
    cancelIoCompletion(
        completion: IoCompletionHandle,
        resource: ResourceId,
    ): Result<uint32, HostError>;
}
