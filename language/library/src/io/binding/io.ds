import { Binding } from "destack:binding";

import { IoCompletionBinding } from "./completion.ds";
import { IoControlBinding } from "./control.ds";
import { IoPollBinding } from "./poll.ds";
import { IoUringBinding } from "./uring.ds";

/// IO binding family.
@languageItem("io.IoBinding")
export interface IoBinding {
    /// Completion bindings.
    readonly completion: IoCompletionBinding;
    /// Control bindings.
    readonly control: IoControlBinding;
    /// Poll bindings.
    readonly poll: IoPollBinding;
    /// io_uring bindings.
    readonly uring: IoUringBinding;
}

/// Current IO binding family.
export const io = new Binding<IoBinding>("io");
