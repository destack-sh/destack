import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for a readiness poll instance.
export newtype IoPollHandle = ResourceId;

/// Readiness backend selector.
export enum IoPollBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Use the Linux epoll backend.
    Epoll = 1,
    /// Use the BSD kqueue backend.
    Kqueue = 2,
    /// Use the POSIX poll backend.
    PosixPoll = 3,
}

/// Readiness interest mask.
export newtype IoPollInterest = uint32;

/// Notify when reads can make progress.
export const IO_POLL_READ: IoPollInterest = IoPollInterest(0x01);

/// Notify when writes can make progress.
export const IO_POLL_WRITE: IoPollInterest = IoPollInterest(0x02);

/// Notify when priority data can be read.
export const IO_POLL_PRIORITY: IoPollInterest = IoPollInterest(0x04);

/// Notify when the target reports an error.
export const IO_POLL_ERROR: IoPollInterest = IoPollInterest(0x08);

/// Notify when the peer has closed or disconnected.
export const IO_POLL_HANGUP: IoPollInterest = IoPollInterest(0x10);

/// Readiness event.
export struct IoPollEvent {
    /// User-assigned key for the registered target.
    key: uint64;
    /// Ready interest mask.
    ready: IoPollInterest;
    /// Backend-specific payload when the host exposes one.
    value: int32;
}

/// Poll binding family.
export interface IoPollBinding {
    /// Open a readiness poller.
    @binding("destack.io.poll.open", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    openIoPoll(backend: IoPollBackend): Result<IoPollHandle, HostError>;

    /// Close a readiness poller.
    @binding("destack.io.poll.close", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    closeIoPoll(poll: IoPollHandle): Result<void, HostError>;

    /// Add one resource to a readiness poller.
    @binding("destack.io.poll.add", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    addIoPoll(
        poll: IoPollHandle,
        resource: ResourceId,
        key: uint64,
        interest: IoPollInterest,
    ): Result<void, HostError>;

    /// Update one resource in a readiness poller.
    @binding("destack.io.poll.update", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    updateIoPoll(
        poll: IoPollHandle,
        resource: ResourceId,
        key: uint64,
        interest: IoPollInterest,
    ): Result<void, HostError>;

    /// Remove one resource from a readiness poller.
    @binding("destack.io.poll.remove", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    removeIoPoll(poll: IoPollHandle, resource: ResourceId): Result<void, HostError>;

    /// Wait for readiness events.
    @binding("destack.io.poll.wait", {
        provider: "host",
        effect: "external",
        requires: ["host.io.poll"],
        families: ["windows", "unix"],
    })
    waitIoPoll(
        poll: IoPollHandle,
        events: &[IoPollEvent],
        timeoutNs?: uint64,
    ): Result<uint32, HostError>;
}
