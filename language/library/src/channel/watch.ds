import { Task } from "destack:async";
import { Result, todo } from "destack:error";
import { Dispose, SharedSafe, WithAccess } from "destack:memory";
import { Dereference } from "destack:ops";

import { ReceiveError, SendError } from "./channel.ds";

/// Borrowed snapshot of a watched value.
export local struct WatchRef<T> {
    /// The receiver that owns this snapshot.
    private receiver: *WatchReceiver<T>;
}

export extension<T> of WatchRef<T> implements Dispose, Dereference<"readonly"> {
    /// The projected result form.
    type Output = T;

    /// Release this snapshot.
    dispose(): void {
        todo("WatchRef.dispose");
    }

    /// Borrow the watched value.
    dereference(&readonly this): WithAccess<&this.Output, "readonly"> {
        todo("WatchRef.dereference")
    }
}

/// Sender for the latest watched value.
@languageItem("channel.watch.WatchSender")
export interface WatchSender<T> {
    /// Replace the watched value.
    send(value: ^T): Result<void, SendError<T>>;

    /// Replace the watched value and return the old value.
    sendReplace(value: ^T): T;

    /// Return whether all receivers are closed.
    isClosed(): boolean;

    /// Close this sender.
    close(): void;
}

/// Receiver for the latest watched value.
@languageItem("channel.watch.WatchReceiver")
export interface WatchReceiver<T> {
    /// Borrow the latest value as a stable snapshot.
    borrow(): WatchRef<T>;

    /// Borrow the latest value and mark it as observed.
    borrowAndUpdate(): WatchRef<T>;

    /// Return whether an unobserved value is available.
    hasChanged(): Result<boolean, ReceiveError>;

    /// Wait for a changed value.
    changed(): Task<Result<void, ReceiveError>>;

    /// Close this receiver.
    close(): void;
}

/// Create a local watch channel.
export function channel<T>(value: ^T): (WatchSender<T>, WatchReceiver<T>) {
    todo("watch.channel")
}

/// Create a shared watch channel.
export function sharedChannel<T: SharedSafe>(
    value: ^T,
): (WatchSender<shared T>, WatchReceiver<shared T>) {
    todo("watch.sharedChannel")
}
