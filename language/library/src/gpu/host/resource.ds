import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for one GPU adapter endpoint.
export newtype GpuAdapterHandle = ResourceId;

/// Handle for one GPU device endpoint.
export newtype GpuDeviceHandle = ResourceId;

/// Handle for one GPU queue endpoint.
export newtype GpuQueueHandle = ResourceId;

/// Handle for one GPU surface endpoint.
export newtype GpuSurfaceHandle = ResourceId;

/// Handle for one GPU presentation event subscription.
export newtype GpuPresentationHandle = ResourceId;

/// Handle for one GPU command encoder.
export newtype GpuCommandEncoderHandle = ResourceId;

/// Handle for one finished GPU command buffer.
export newtype GpuCommandBufferHandle = ResourceId;

/// Handle for one active GPU compute-pass endpoint.
export newtype GpuComputePassHandle = ResourceId;

/// Handle for one active GPU render-pass endpoint.
export newtype GpuRenderPassHandle = ResourceId;

/// Handle for one GPU render-bundle endpoint.
export newtype GpuRenderBundleHandle = ResourceId;

/// Handle for one GPU render-bundle-encoder endpoint.
export newtype GpuRenderBundleEncoderHandle = ResourceId;

/// Handle for one GPU pipeline layout endpoint.
export newtype GpuPipelineLayoutHandle = ResourceId;

/// Handle for one GPU bind group layout endpoint.
export newtype GpuBindGroupLayoutHandle = ResourceId;

/// Handle for one GPU bind group endpoint.
export newtype GpuBindGroupHandle = ResourceId;

/// Handle for one GPU synchronization fence endpoint.
export newtype GpuFenceHandle = ResourceId;

/// Handle for one GPU query set endpoint.
export newtype GpuQuerySetHandle = ResourceId;

/// Handle for one GPU buffer endpoint.
export newtype GpuBufferHandle = ResourceId;

/// Handle for one GPU texture endpoint.
export newtype GpuTextureHandle = ResourceId;

/// Handle for one GPU texture-view endpoint.
export newtype GpuTextureViewHandle = ResourceId;

/// Handle for one GPU external-texture endpoint.
export newtype GpuExternalTextureHandle = ResourceId;

/// Handle for one GPU sampler endpoint.
export newtype GpuSamplerHandle = ResourceId;

/// Handle for one GPU shader module endpoint.
export newtype GpuShaderHandle = ResourceId;

/// Handle for one GPU pipeline endpoint.
export newtype GpuPipelineHandle = ResourceId;

/// GPU buffer usage bitset.
export newtype GpuBufferUsage = uint32;

/// Buffer usage bit for read mapping.
export const GPU_BUFFER_USAGE_MAP_READ: GpuBufferUsage = GpuBufferUsage(0x1);
/// Buffer usage bit for write mapping.
export const GPU_BUFFER_USAGE_MAP_WRITE: GpuBufferUsage = GpuBufferUsage(0x2);
/// Buffer usage bit for copy source.
export const GPU_BUFFER_USAGE_COPY_SRC: GpuBufferUsage = GpuBufferUsage(0x4);
/// Buffer usage bit for copy destination.
export const GPU_BUFFER_USAGE_COPY_DST: GpuBufferUsage = GpuBufferUsage(0x8);
/// Buffer usage bit for index input.
export const GPU_BUFFER_USAGE_INDEX: GpuBufferUsage = GpuBufferUsage(0x10);
/// Buffer usage bit for vertex input.
export const GPU_BUFFER_USAGE_VERTEX: GpuBufferUsage = GpuBufferUsage(0x20);
/// Buffer usage bit for uniform binding.
export const GPU_BUFFER_USAGE_UNIFORM: GpuBufferUsage = GpuBufferUsage(0x40);
/// Buffer usage bit for storage binding.
export const GPU_BUFFER_USAGE_STORAGE: GpuBufferUsage = GpuBufferUsage(0x80);
/// Buffer usage bit for indirect input.
export const GPU_BUFFER_USAGE_INDIRECT: GpuBufferUsage = GpuBufferUsage(0x100);
/// Buffer usage bit for query resolve.
export const GPU_BUFFER_USAGE_QUERY_RESOLVE: GpuBufferUsage = GpuBufferUsage(0x200);
/// Buffer usage bit for bottom-level acceleration-structure input.
export const GPU_BUFFER_USAGE_BLAS_INPUT: GpuBufferUsage = GpuBufferUsage(0x400);
/// Buffer usage bit for top-level acceleration-structure input.
export const GPU_BUFFER_USAGE_TLAS_INPUT: GpuBufferUsage = GpuBufferUsage(0x800);

/// GPU texture usage bitset.
export newtype GpuTextureUsage = uint32;

/// Texture usage bit for copy source.
export const GPU_TEXTURE_USAGE_COPY_SRC: GpuTextureUsage = GpuTextureUsage(0x1);
/// Texture usage bit for copy destination.
export const GPU_TEXTURE_USAGE_COPY_DST: GpuTextureUsage = GpuTextureUsage(0x2);
/// Texture usage bit for sampled-texture binding.
export const GPU_TEXTURE_USAGE_TEXTURE_BINDING: GpuTextureUsage = GpuTextureUsage(0x4);
/// Texture usage bit for storage-texture binding.
export const GPU_TEXTURE_USAGE_STORAGE_BINDING: GpuTextureUsage = GpuTextureUsage(0x8);
/// Texture usage bit for render attachment.
export const GPU_TEXTURE_USAGE_RENDER_ATTACHMENT: GpuTextureUsage = GpuTextureUsage(0x10);
/// Texture usage bit for storage atomics.
export const GPU_TEXTURE_USAGE_STORAGE_ATOMIC: GpuTextureUsage = GpuTextureUsage(0x10000);
/// Texture usage bit for transient attachments.
export const GPU_TEXTURE_USAGE_TRANSIENT: GpuTextureUsage = GpuTextureUsage(0x20000);

