/// Depth or stencil compare selector.
export enum GpuCompareFunction {
    /// Comparison always fails.
    Never = 1,
    /// Pass when source is less than destination.
    Less = 2,
    /// Pass when source equals destination.
    Equal = 3,
    /// Pass when source is less than or equal to destination.
    LessEqual = 4,
    /// Pass when source is greater than destination.
    Greater = 5,
    /// Pass when source does not equal destination.
    NotEqual = 6,
    /// Pass when source is greater than or equal to destination.
    GreaterEqual = 7,
    /// Comparison always passes.
    Always = 8,
}

/// GPU buffer descriptor.
export struct GpuBufferDescriptor {
    /// Debug label.
    label: string;
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: GpuBufferUsage;
    /// Whether the buffer starts mapped for host access.
    mappedAtCreation: boolean;
}

/// GPU texture descriptor.
export struct GpuTextureDescriptor {
    /// Debug label.
    label: string;
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: GpuTextureFormat;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
    /// Texture usage bitset.
    usage: GpuTextureUsage;
    /// Additional compatible texture-view format identifiers.
    viewFormats: [GpuTextureFormat];
}

/// GPU texture view descriptor.
export struct GpuTextureViewDescriptor {
    /// Debug label.
    label: string;
    /// View format identifier when one compatible view format is selected.
    format?: GpuTextureFormat;
    /// View usage bitset when the view narrows the texture usage set.
    usage?: GpuTextureUsage;
    /// View dimension selector.
    dimension?: GpuTextureViewDimension;
    /// Base mip-level index.
    baseMipLevel: uint32;
    /// Mip-level count when the view does not cover the remaining mip range.
    mipLevelCount?: uint32;
    /// Base array-layer index.
    baseArrayLayer: uint32;
    /// Array-layer count when the view does not cover the remaining layer range.
    arrayLayerCount?: uint32;
    /// Texture aspect selector.
    aspect: GpuTextureAspect;
}

/// GPU sampler descriptor.
export struct GpuSamplerDescriptor {
    /// Debug label.
    label: string;
    /// Minification filter selector.
    minFilter: GpuFilterMode;
    /// Magnification filter selector.
    magFilter: GpuFilterMode;
    /// Mipmap filter selector.
    mipFilter: GpuMipmapFilterMode;
    /// Address mode u selector.
    addressU: GpuAddressMode;
    /// Address mode v selector.
    addressV: GpuAddressMode;
    /// Address mode w selector.
    addressW: GpuAddressMode;
    /// Sampler LOD minimum clamp.
    lodMinClamp: float64;
    /// Sampler LOD maximum clamp.
    lodMaxClamp: float64;
    /// Compare-function selector when comparison is enabled.
    compare?: GpuCompareFunction;
    /// Maximum anisotropy level.
    maxAnisotropy: uint16;
    /// Border color when one address mode clamps to border.
    borderColor?: GpuSamplerBorderColor;
}

/// Buffer mapping mode.
export enum GpuMapMode {
    /// Read-only map mode.
    Read = 1,
    /// Write-only map mode.
    Write = 2,
}

/// Buffer map-state selector.
export enum GpuBufferMapState {
    /// Buffer is not currently mapped.
    Unmapped = 1,
    /// Buffer map request is pending.
    Pending = 2,
    /// Buffer is currently mapped.
    Mapped = 3,
}

/// Texture dimension selector.
export enum GpuTextureDimension {
    /// One-dimensional texture.
    D1 = 1,
    /// Two-dimensional texture.
    D2 = 2,
    /// Three-dimensional texture.
    D3 = 3,
}

/// Texture view-dimension selector.
export enum GpuTextureViewDimension {
    /// One-dimensional texture view.
    D1 = 1,
    /// Two-dimensional texture view.
    D2 = 2,
    /// Two-dimensional texture-array view.
    D2Array = 3,
    /// Cube texture view.
    Cube = 4,
    /// Cube texture-array view.
    CubeArray = 5,
    /// Three-dimensional texture view.
    D3 = 6,
}

/// Texture aspect selector.
export enum GpuTextureAspect {
    /// Select all color or depth-stencil aspects.
    All = 1,
    /// Select only the stencil aspect.
    StencilOnly = 2,
    /// Select only the depth aspect.
    DepthOnly = 3,
    /// Select only plane 0.
    Plane0 = 4,
    /// Select only plane 1.
    Plane1 = 5,
    /// Select only plane 2.
    Plane2 = 6,
}

/// Texture address mode selector.
export enum GpuAddressMode {
    /// Clamp coordinates to the texture edge.
    ClampToEdge = 1,
    /// Repeat coordinates in a tiling pattern.
    Repeat = 2,
    /// Repeat coordinates with alternating mirroring.
    MirrorRepeat = 3,
    /// Clamp coordinates to the configured border color.
    ClampToBorder = 4,
}

/// Texture filter mode selector.
export enum GpuFilterMode {
    /// Use nearest-neighbor filtering.
    Nearest = 1,
    /// Use linear interpolation.
    Linear = 2,
}

/// Texture mipmap filter mode selector.
export enum GpuMipmapFilterMode {
    /// Use nearest-neighbor mip selection.
    Nearest = 1,
    /// Use linear interpolation between mip levels.
    Linear = 2,
}

/// Sampler border color selector.
export enum GpuSamplerBorderColor {
    /// Transparent black border color.
    TransparentBlack = 1,
    /// Opaque black border color.
    OpaqueBlack = 2,
    /// Opaque white border color.
    OpaqueWhite = 3,
    /// Zero border color for all components when supported.
    Zero = 4,
}

/// Buffer access bitset for explicit resource transitions.
export newtype GpuBufferAccess = uint32;

/// Texture access bitset for explicit resource transitions.
export newtype GpuTextureAccess = uint32;

/// Buffer access bit for read mapping.
export const GPU_BUFFER_ACCESS_MAP_READ: GpuBufferAccess = GpuBufferAccess(0x1);
/// Buffer access bit for write mapping.
export const GPU_BUFFER_ACCESS_MAP_WRITE: GpuBufferAccess = GpuBufferAccess(0x2);
/// Buffer access bit for copy source.
export const GPU_BUFFER_ACCESS_COPY_SRC: GpuBufferAccess = GpuBufferAccess(0x4);
/// Buffer access bit for copy destination.
export const GPU_BUFFER_ACCESS_COPY_DST: GpuBufferAccess = GpuBufferAccess(0x8);
/// Buffer access bit for index input.
export const GPU_BUFFER_ACCESS_INDEX: GpuBufferAccess = GpuBufferAccess(0x10);
/// Buffer access bit for vertex input.
export const GPU_BUFFER_ACCESS_VERTEX: GpuBufferAccess = GpuBufferAccess(0x20);
/// Buffer access bit for uniform binding.
export const GPU_BUFFER_ACCESS_UNIFORM: GpuBufferAccess = GpuBufferAccess(0x40);
/// Buffer access bit for read-only storage binding.
export const GPU_BUFFER_ACCESS_STORAGE_READ_ONLY: GpuBufferAccess = GpuBufferAccess(0x80);
/// Buffer access bit for read-write storage binding.
export const GPU_BUFFER_ACCESS_STORAGE_READ_WRITE: GpuBufferAccess = GpuBufferAccess(0x100);
/// Buffer access bit for indirect input.
export const GPU_BUFFER_ACCESS_INDIRECT: GpuBufferAccess = GpuBufferAccess(0x200);
/// Buffer access bit for query resolve.
export const GPU_BUFFER_ACCESS_QUERY_RESOLVE: GpuBufferAccess = GpuBufferAccess(0x400);

/// Texture access bit for uninitialized state.
export const GPU_TEXTURE_ACCESS_UNINITIALIZED: GpuTextureAccess = GpuTextureAccess(0x1);
/// Texture access bit for presentation.
export const GPU_TEXTURE_ACCESS_PRESENT: GpuTextureAccess = GpuTextureAccess(0x2);
/// Texture access bit for copy source.
export const GPU_TEXTURE_ACCESS_COPY_SRC: GpuTextureAccess = GpuTextureAccess(0x4);
/// Texture access bit for copy destination.
export const GPU_TEXTURE_ACCESS_COPY_DST: GpuTextureAccess = GpuTextureAccess(0x8);
/// Texture access bit for sampled or fetched resources.
export const GPU_TEXTURE_ACCESS_RESOURCE: GpuTextureAccess = GpuTextureAccess(0x10);
/// Texture access bit for color render targets.
export const GPU_TEXTURE_ACCESS_COLOR_TARGET: GpuTextureAccess = GpuTextureAccess(0x20);
/// Texture access bit for read-only depth-stencil use.
export const GPU_TEXTURE_ACCESS_DEPTH_STENCIL_READ: GpuTextureAccess = GpuTextureAccess(0x40);
/// Texture access bit for writable depth-stencil use.
export const GPU_TEXTURE_ACCESS_DEPTH_STENCIL_WRITE: GpuTextureAccess = GpuTextureAccess(0x80);
/// Texture access bit for read-only storage use.
export const GPU_TEXTURE_ACCESS_STORAGE_READ_ONLY: GpuTextureAccess = GpuTextureAccess(0x100);
/// Texture access bit for write-only storage use.
export const GPU_TEXTURE_ACCESS_STORAGE_WRITE_ONLY: GpuTextureAccess = GpuTextureAccess(0x200);
/// Texture access bit for read-write storage use.
export const GPU_TEXTURE_ACCESS_STORAGE_READ_WRITE: GpuTextureAccess = GpuTextureAccess(0x400);
/// Texture access bit for atomic storage use.
export const GPU_TEXTURE_ACCESS_STORAGE_ATOMIC: GpuTextureAccess = GpuTextureAccess(0x800);
/// Texture access bit for transient render-attachment allocation.
export const GPU_TEXTURE_ACCESS_TRANSIENT: GpuTextureAccess = GpuTextureAccess(0x1000);

/// Texture subresource selector for one transition.
export struct GpuTextureSubresourceRange {
    /// Starting mip-level index.
    baseMipLevel: uint32;
    /// Number of mip levels.
    mipLevelCount: uint32;
    /// Starting array-layer index.
    baseArrayLayer: uint32;
    /// Number of array layers.
    arrayLayerCount: uint32;
}

/// Buffer transition descriptor.
export struct GpuBufferTransition {
    /// Buffer handle.
    buffer: GpuBufferHandle;
    /// Target buffer access.
    access: GpuBufferAccess;
}

/// Texture transition descriptor.
export struct GpuTextureTransition {
    /// Texture handle.
    texture: GpuTextureHandle;
    /// Optional subresource selector.
    subresources?: GpuTextureSubresourceRange;
    /// Target texture access.
    access: GpuTextureAccess;
}

/// External-texture format selector.
export enum GpuExternalTextureFormat {
    /// Single RGBA plane.
    Rgba = 1,
    /// One luma plane and one interleaved chroma plane.
    Nv12 = 2,
    /// Separate luma, Cb, and Cr planes.
    Yu12 = 3,
}

/// External-texture transfer-function parameters.
export struct GpuExternalTextureTransferFunction {
    /// Transfer-function coefficient a.
    a: float32;
    /// Transfer-function breakpoint b.
    b: float32;
    /// Transfer-function exponent g.
    g: float32;
    /// Transfer-function coefficient k.
    k: float32;
}

/// External texture descriptor.
export struct GpuExternalTextureDescriptor {
    /// Debug label.
    label: string;
    /// External-texture width visible to shaders.
    width: uint32;
    /// External-texture height visible to shaders.
    height: uint32;
    /// External-texture format selector.
    format: GpuExternalTextureFormat;
    /// YUV-to-RGBA conversion matrix in column-major order.
    yuvConversionMatrix: [float32; 16];
    /// Gamut-conversion matrix in column-major order.
    gamutConversionMatrix: [float32; 9];
    /// Source transfer-function parameters.
    sourceTransferFunction: GpuExternalTextureTransferFunction;
    /// Destination transfer-function parameters.
    destinationTransferFunction: GpuExternalTextureTransferFunction;
    /// Sample-coordinate transform in column-major order.
    sampleTransform: [float32; 6];
    /// Load-coordinate transform in column-major order.
    loadTransform: [float32; 6];
}

/// GPU mapped buffer range.
export struct GpuMappedBufferRange {
    /// Host-visible pointer address represented as integer.
    address: uint64;
    /// Mapped byte length.
    length: uint64;
    /// Whether cache coherence is guaranteed for this mapping.
    coherent: boolean;
}

/// GPU buffer state.
export struct GpuBufferState {
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: GpuBufferUsage;
    /// Current map-state selector.
    mapState: GpuBufferMapState;
}

/// GPU texture state.
export struct GpuTextureState {
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip-level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: GpuTextureFormat;
    /// Texture usage bitset.
    usage: GpuTextureUsage;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
}

/// Resource binding family.
export interface GpuResource {
    /// Create a GPU buffer.
    @binding("destack.gpu.resource.buffer.create", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    createBuffer(
        device: GpuDeviceHandle,
        descriptor: &readonly GpuBufferDescriptor,
    ): Result<GpuBufferHandle, HostError>;

    /// Destroy a GPU buffer.
    @binding("destack.gpu.resource.buffer.destroy", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    destroyBuffer(buffer: GpuBufferHandle): Result<void, HostError>;

    /// Write a byte range to a GPU buffer.
    @binding("destack.gpu.resource.buffer.write", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    writeBuffer(
        buffer: GpuBufferHandle,
        offset: uint64,
        bytes: &readonly [uint8],
    ): Result<void, HostError>;

    /// Read a byte range from a GPU buffer.
    @binding("destack.gpu.resource.buffer.read", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readBuffer(
        buffer: GpuBufferHandle,
        offset: uint64,
        length: uint64,
    ): Result<Array<uint8>, HostError>;

    /// Map a buffer range.
    @binding("destack.gpu.resource.buffer.map", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    mapBuffer(
        buffer: GpuBufferHandle,
        offset: uint64,
        length: uint64,
        mode: GpuMapMode,
    ): Result<GpuMappedBufferRange, HostError>;

    /// Unmap a mapped buffer.
    @binding("destack.gpu.resource.buffer.unmap", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    unmapBuffer(buffer: GpuBufferHandle): Result<void, HostError>;

    /// Read a buffer state snapshot.
    @binding("destack.gpu.resource.buffer.state.read", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readBufferState(buffer: GpuBufferHandle): Result<GpuBufferState, HostError>;

    /// Create a texture resource.
    @binding("destack.gpu.resource.texture.create", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    createTexture(
        device: GpuDeviceHandle,
        descriptor: &readonly GpuTextureDescriptor,
    ): Result<GpuTextureHandle, HostError>;

    /// Destroy a texture resource.
    @binding("destack.gpu.resource.texture.destroy", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    destroyTexture(texture: GpuTextureHandle): Result<void, HostError>;

    /// Read a texture state snapshot.
    @binding("destack.gpu.resource.texture.state.read", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readTextureState(texture: GpuTextureHandle): Result<GpuTextureState, HostError>;

    /// Create a texture view.
    @binding("destack.gpu.resource.texture.view.create", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    createTextureView(
        texture: GpuTextureHandle,
        descriptor: &readonly GpuTextureViewDescriptor,
    ): Result<GpuTextureViewHandle, HostError>;

    /// Destroy a texture view.
    @binding("destack.gpu.resource.texture.view.destroy", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    destroyTextureView(view: GpuTextureViewHandle): Result<void, HostError>;

    /// Create a sampler resource.
    @binding("destack.gpu.resource.sampler.create", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    createSampler(
        device: GpuDeviceHandle,
        descriptor: &readonly GpuSamplerDescriptor,
    ): Result<GpuSamplerHandle, HostError>;

    /// Destroy a sampler resource.
    @binding("destack.gpu.resource.sampler.destroy", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    destroySampler(sampler: GpuSamplerHandle): Result<void, HostError>;

    /// Create an external texture resource.
    @binding("destack.gpu.resource.external.texture.create", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    createExternalTexture(
        device: GpuDeviceHandle,
        descriptor: &readonly GpuExternalTextureDescriptor,
        planeViews: &readonly [GpuTextureViewHandle],
    ): Result<GpuExternalTextureHandle, HostError>;

    /// Destroy an external texture resource.
    @binding("destack.gpu.resource.external.texture.destroy", {
        effect: "external",
        requires: ["host.gpu.resource"],
        families: ["windows", "unix"],
        simulation: true,
    })
    destroyExternalTexture(externalTexture: GpuExternalTextureHandle): Result<void, HostError>;
}
