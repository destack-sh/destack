import { Binding } from "destack:binding";

import { GpuAdapterBinding } from "./adapter.ds";
import { GpuBindBinding } from "./bind.ds";
import { GpuCommandBinding } from "./command.ds";
import { GpuDebugBinding } from "./debug.ds";
import { GpuDeviceBinding } from "./device.ds";
import { GpuPipelineBinding } from "./pipeline.ds";
import { GpuPresentBinding } from "./present.ds";
import { GpuResourceBinding } from "./resource.ds";
import { GpuSyncBinding } from "./sync.ds";

/// GPU binding family.
@languageItem("gpu.GpuBinding")
export interface GpuBinding {
    /// Adapter bindings.
    readonly adapter: GpuAdapterBinding;
    /// Bind group bindings.
    readonly bind: GpuBindBinding;
    /// Command bindings.
    readonly command: GpuCommandBinding;
    /// Debug bindings.
    readonly debug: GpuDebugBinding;
    /// Device bindings.
    readonly device: GpuDeviceBinding;
    /// Pipeline bindings.
    readonly pipeline: GpuPipelineBinding;
    /// Presentation bindings.
    readonly present: GpuPresentBinding;
    /// Resource bindings.
    readonly resource: GpuResourceBinding;
    /// Synchronization bindings.
    readonly sync: GpuSyncBinding;
}

/// Current GPU binding family.
export const gpu: Binding<GpuBinding> = new Binding<GpuBinding>("gpu");
