import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Debug binding family.
export interface GpuDebugBinding {
    /// Set a debug label on a GPU resource object.
    @binding("destack.gpu.debug.label.set", {
        provider: "host",
        effect: "external",
        requires: ["host.gpu.debug"],
        families: ["windows", "unix"],
    })
    setLabel(handle: ResourceId, label: &readonly string): Result<void, HostError>;
}
