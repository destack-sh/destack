import { HostError } from "tspp:error/host";

import { ResourceId } from "./resource.tspp";
import { WorkerId, WorldViewHandle } from "./world.tspp";

/// Heap usage for one worker.
@languageItem("runtime.HeapSummary")
export struct HeapSummary {
    /// Total heap bytes.
    heapBytes: uint64;
    /// Total captured page count.
    pageCount: uint32;
    /// Completed GC cycle count.
    gcCycles: uint64;
}

/// Runtime heap object identifier.
@languageItem("runtime.HeapObjectId")
export newtype HeapObjectId = uint64;

/// Runtime heap object.
@languageItem("runtime.HeapObject")
export struct HeapObject {
    /// Object identifier.
    id: HeapObjectId;
    /// Object byte size.
    sizeBytes: uint64;
    /// Resource represented by this object when present.
    resource?: ResourceId;
}

/// Runtime heap object edge.
@languageItem("runtime.HeapEdge")
export struct HeapEdge {
    /// Source object.
    from: HeapObjectId;
    /// Target object.
    to: HeapObjectId;
    /// Edge byte offset.
    offsetBytes: uint64;
}

/// Heap object list page.
export struct HeapObjectPage {
    /// Heap object records in this page.
    objects: HeapObject[];
    /// Next object cursor when more records exist.
    next?: HeapObjectId;
}

/// Heap edge list page.
export struct HeapEdgePage {
    /// Heap edge records in this page.
    edges: HeapEdge[];
    /// Next edge byte offset when more records exist.
    nextOffset?: uint64;
}

/// Read one worker's heap usage.
@binding("tspp.runtime.heap.summary", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function readHeap(
    view: WorldViewHandle,
    worker: WorkerId,
): Result<HeapSummary, HostError>;

/// List heap objects for one worker.
@binding("tspp.runtime.heap.objects", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function listHeapObjects(
    view: WorldViewHandle,
    worker: WorkerId,
    limit: uint32,
    after?: HeapObjectId,
): Result<HeapObjectPage, HostError>;

/// List outgoing heap edges from one object.
@binding("tspp.runtime.heap.edges", {
    effect: "deterministic",
    requires: ["runtime.entity.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function listHeapEdges(
    view: WorldViewHandle,
    object: HeapObjectId,
    limit: uint32,
    afterOffset?: uint64,
): Result<HeapEdgePage, HostError>;
