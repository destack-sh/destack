/// Actions that touch runtime-owned facilities.
@languageItem("runtime.RuntimeAction")
export type RuntimeAction =
    | "runtime.branch.control"
    | "runtime.branch.read"
    | "runtime.checkpoint.create"
    | "runtime.checkpoint.read"
    | "runtime.control"
    | "runtime.debug.control"
    | "runtime.debug.read"
    | "runtime.entity.read"
    | "runtime.entity.write"
    | "runtime.executor.control"
    | "runtime.executor.read"
    | "runtime.policy.read"
    | "runtime.policy.test"
    | "runtime.policy.write"
    | "runtime.random.control"
    | "runtime.random.read"
    | "runtime.resource.close"
    | "runtime.resource.read"
    | "runtime.resource.transfer"
    | "runtime.resource.write"
    | "runtime.revision.control"
    | "runtime.revision.read"
    | "runtime.runtime.control"
    | "runtime.runtime.create"
    | "runtime.runtime.read"
    | "runtime.snapshot.create"
    | "runtime.snapshot.read"
    | "runtime.snapshot.restore"
    | "runtime.telemetry.control"
    | "runtime.telemetry.export"
    | "runtime.telemetry.read"
    | "runtime.telemetry.write"
    | "runtime.topology.edge.kind.define"
    | "runtime.topology.edge.kind.undefine"
    | "runtime.topology.edge.read"
    | "runtime.topology.edge.remove"
    | "runtime.topology.edge.upsert"
    | "runtime.topology.entity.kind.define"
    | "runtime.topology.entity.kind.undefine"
    | "runtime.topology.entity.read"
    | "runtime.topology.entity.remove"
    | "runtime.topology.entity.upsert"
    | "runtime.trace.control"
    | "runtime.trace.read"
    | "runtime.worker.control"
    | "runtime.worker.create"
    | "runtime.worker.read"
    | "runtime.world.control"
    | "runtime.world.create"
    | "runtime.world.read";
