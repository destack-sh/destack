/// Runtime entity identifier.
@languageItem("runtime.EntityId")
export newtype EntityId = string;

/// Runtime edge identifier.
@languageItem("runtime.EdgeId")
export newtype EdgeId = string;

/// Runtime entity kind.
@languageItem("runtime.EntityKind")
export newtype EntityKind = string;

/// Runtime edge kind.
@languageItem("runtime.EdgeKind")
export newtype EdgeKind = string;

/// Entity or edge label.
@languageItem("runtime.Label")
export struct Label {
    /// Label key.
    key: string;
    /// Label value.
    value: string;
}

/// Label selector clause.
@languageItem("runtime.LabelSelector")
export struct LabelSelector {
    /// Label key to match.
    key: string;
    /// Optional exact value match.
    value?: string;
}

/// Entity selector.
@languageItem("runtime.EntitySelector")
export type EntitySelector =
    | {
          /// Match all entities.
          kind: "any";
      }
    | {
          /// Match one entity by id.
          kind: "id";
          /// Entity id to match.
          id: EntityId;
      }
    | {
          /// Match a fixed set of entities by id.
          kind: "ids";
          /// Entity ids to match.
          ids: [EntityId];
      }
    | {
          /// Match entities by labels.
          kind: "labels";
          /// Label selector clauses.
          labels: [LabelSelector];
      }
    | {
          /// Match one deterministic entity from a selector result.
          kind: "chooseOne";
          /// Source selector.
          selector: Managed<EntitySelector, "local">;
      };

/// Edge selector.
@languageItem("runtime.EdgeSelector")
export type EdgeSelector =
    | {
          /// Match all edges.
          kind: "any";
      }
    | {
          /// Match one edge by id.
          kind: "id";
          /// Edge id to match.
          id: EdgeId;
      }
    | {
          /// Match a fixed set of edges by id.
          kind: "ids";
          /// Edge ids to match.
          ids: [EdgeId];
      }
    | {
          /// Match edges incident to selected entities.
          kind: "incident";
          /// Incident entity selector.
          entity: EntitySelector;
      }
    | {
          /// Match edges between source and destination selectors.
          kind: "between";
          /// Source entity selector.
          from: EntitySelector;
          /// Destination entity selector.
          to: EntitySelector;
      }
    | {
          /// Match edges by labels.
          kind: "labels";
          /// Label selector clauses.
          labels: [LabelSelector];
      };

/// Entity filter.
export struct EntityFilter {
    /// Optional entity kind selector.
    kind?: EntityKind;
    /// Optional label selector clauses.
    labels?: [LabelSelector];
}

/// Edge filter.
export struct EdgeFilter {
    /// Optional edge kind selector.
    kind?: EdgeKind;
    /// Optional source entity selector.
    from?: EntityId;
    /// Optional destination entity selector.
    to?: EntityId;
    /// Optional label selector clauses.
    labels?: [LabelSelector];
}

/// Runtime entity.
@languageItem("runtime.Entity")
export struct Entity {
    /// Entity identifier.
    id: EntityId;
    /// Entity kind.
    kind: EntityKind;
    /// Entity name.
    name: string;
    /// Entity labels.
    labels?: [Label];
}

/// Entity list page.
export struct EntityPage {
    /// Entity records in this page.
    entities: Entity[];
    /// Next entity cursor when more records exist.
    next?: EntityId;
}

/// Runtime edge.
@languageItem("runtime.Edge")
export struct Edge {
    /// Edge identifier.
    id: EdgeId;
    /// Edge kind.
    kind: EdgeKind;
    /// Edge name.
    name: string;
    /// Source entity.
    from: EntityId;
    /// Destination entity.
    to: EntityId;
    /// Edge labels.
    labels?: [Label];
}

/// Edge list page.
export struct EdgePage {
    /// Edge records in this page.
    edges: Edge[];
    /// Next edge cursor when more records exist.
    next?: EdgeId;
}
