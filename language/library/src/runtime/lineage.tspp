import { HostError } from "tspp:error/host";

import { Label, LabelSelector } from "./entity.tspp";
import { WorldHandle } from "./world.tspp";

/// Branch identifier in one world lineage.
@languageItem("runtime.BranchId")
export newtype BranchId = uint64;

/// Revision identifier in one world lineage.
@languageItem("runtime.RevisionId")
export newtype RevisionId = uint64;

/// Checkpoint identifier in one world lineage.
@languageItem("runtime.CheckpointId")
export newtype CheckpointId = uint64;

/// Materialized image identifier.
@languageItem("runtime.ImageId")
export newtype ImageId = uint64;

/// Monotonic trace sequence number.
@languageItem("runtime.TraceSequence")
export newtype TraceSequence = uint64;

/// Precise history coordinate in one world.
@languageItem("runtime.Moment")
export struct Moment {
    /// Branch containing this history coordinate.
    branch: BranchId;
    /// Trace sequence reached at this history coordinate.
    sequence: TraceSequence;
}

/// Branch state.
@languageItem("runtime.Branch")
export struct Branch {
    /// Branch identifier.
    id: BranchId;
    /// Head revision.
    head: RevisionId;
    /// Optional branch name.
    name?: string;
    /// Branch labels.
    labels?: [Label];
}

/// Revision state.
@languageItem("runtime.Revision")
export struct Revision {
    /// Revision identifier.
    id: RevisionId;
    /// Owning branch.
    branch: BranchId;
    /// Parent revision when present.
    parent?: RevisionId;
    /// Trace sequence captured by this revision.
    sequence: TraceSequence;
    /// Materialized image reference.
    image: ImageId;
}

/// Checkpoint state.
@languageItem("runtime.Checkpoint")
export struct Checkpoint {
    /// Checkpoint identifier.
    id: CheckpointId;
    /// Revision anchored by this checkpoint.
    revision: RevisionId;
    /// Optional checkpoint name.
    name?: string;
    /// Checkpoint labels.
    labels?: [Label];
}

/// Image state.
@languageItem("runtime.Image")
export struct Image {
    /// Image identifier.
    id: ImageId;
    /// Revision materialized by this image.
    revision: RevisionId;
    /// Optional shared backing size in bytes.
    sharedBytes?: uint64;
}

/// Branch list page.
export struct BranchPage {
    /// Branch records in this page.
    branches: Branch[];
    /// Next branch cursor when more records exist.
    next?: BranchId;
}

/// Revision list page.
export struct RevisionPage {
    /// Revision records in this page.
    revisions: Revision[];
    /// Next revision cursor when more records exist.
    next?: RevisionId;
}

/// Checkpoint list page.
export struct CheckpointPage {
    /// Checkpoint records in this page.
    checkpoints: Checkpoint[];
    /// Next checkpoint cursor when more records exist.
    next?: CheckpointId;
}

/// Image list page.
export struct ImagePage {
    /// Image records in this page.
    images: Image[];
    /// Next image cursor when more records exist.
    next?: ImageId;
}

/// Filter for branch lists.
export struct BranchFilter {
    /// Optional exact branch name.
    name?: string;
    /// Optional label selector clauses.
    labels?: [LabelSelector];
}

/// Filter for revision lists.
export struct RevisionFilter {
    /// Optional owning branch selector.
    branch?: BranchId;
}

/// Filter for checkpoint lists.
export struct CheckpointFilter {
    /// Optional anchored revision selector.
    revision?: RevisionId;
    /// Optional exact checkpoint name.
    name?: string;
    /// Optional label selector clauses.
    labels?: [LabelSelector];
}

/// Filter for image lists.
export struct ImageFilter {
    /// Optional owning revision selector.
    revision?: RevisionId;
}

/// Return the active branch for one world.
@binding("tspp.runtime.lineage.worldBranch", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldBranch(world: WorldHandle): Result<BranchId, HostError>;

/// Return the active revision for one world.
@binding("tspp.runtime.lineage.worldRevision", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRevision(world: WorldHandle): Result<RevisionId, HostError>;

/// Describe one branch.
@binding("tspp.runtime.lineage.branchDescribe", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function branchDescribe(
    world: WorldHandle,
    branchId: BranchId,
): Result<Branch, HostError>;

/// List branches in one world lineage.
@binding("tspp.runtime.lineage.branchList", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function branchList(
    world: WorldHandle,
    limit: uint32,
    filter?: BranchFilter,
    after?: BranchId,
): Result<BranchPage, HostError>;

/// Describe one revision.
@binding("tspp.runtime.lineage.revisionDescribe", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function revisionDescribe(
    world: WorldHandle,
    revisionId: RevisionId,
): Result<Revision, HostError>;

/// List revisions in one world lineage.
@binding("tspp.runtime.lineage.revisionList", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function revisionList(
    world: WorldHandle,
    limit: uint32,
    filter?: RevisionFilter,
    after?: RevisionId,
): Result<RevisionPage, HostError>;

/// Create one checkpoint on the active branch.
@binding("tspp.runtime.lineage.checkpointCreate", {
    effect: "deterministic",
    requires: ["runtime.branch.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointCreate(
    world: WorldHandle,
    name?: string,
    labels?: [Label],
): Result<CheckpointId, HostError>;

/// Describe one checkpoint.
@binding("tspp.runtime.lineage.checkpointDescribe", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointDescribe(
    world: WorldHandle,
    checkpointId: CheckpointId,
): Result<Checkpoint, HostError>;

/// List checkpoints in one world lineage.
@binding("tspp.runtime.lineage.checkpointList", {
    effect: "deterministic",
    requires: ["runtime.branch.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function checkpointList(
    world: WorldHandle,
    limit: uint32,
    filter?: CheckpointFilter,
    after?: CheckpointId,
): Result<CheckpointPage, HostError>;

/// Rewind one world to one revision.
@binding("tspp.runtime.lineage.worldRewindRevision", {
    effect: "deterministic",
    requires: ["runtime.branch.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRewindRevision(
    world: WorldHandle,
    revisionId: RevisionId,
): Result<void, HostError>;

/// Rewind one world to one checkpoint.
@binding("tspp.runtime.lineage.worldRewindCheckpoint", {
    effect: "deterministic",
    requires: ["runtime.branch.control"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldRewindCheckpoint(
    world: WorldHandle,
    checkpointId: CheckpointId,
): Result<void, HostError>;

/// Fork one child world from one revision.
@binding("tspp.runtime.lineage.worldFork", {
    effect: "deterministic",
    requires: ["runtime.world.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function worldFork(
    world: WorldHandle,
    revisionId: RevisionId,
    name?: string,
    labels?: [Label],
): Result<WorldHandle, HostError>;

/// Capture one image at the active revision.
@binding("tspp.runtime.lineage.imageCapture", {
    effect: "deterministic",
    requires: ["runtime.snapshot.create"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageCapture(world: WorldHandle): Result<ImageId, HostError>;

/// Describe one image.
@binding("tspp.runtime.lineage.imageDescribe", {
    effect: "deterministic",
    requires: ["runtime.snapshot.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageDescribe(
    world: WorldHandle,
    imageId: ImageId,
): Result<Image, HostError>;

/// List images in one world lineage.
@binding("tspp.runtime.lineage.imageList", {
    effect: "deterministic",
    requires: ["runtime.snapshot.read"],
    families: ["windows", "unix"],
    hosts: ["wasi"],
    provider: "runtime",
    affinity: "worker",
})
export declare function imageList(
    world: WorldHandle,
    limit: uint32,
    filter?: ImageFilter,
    after?: ImageId,
): Result<ImagePage, HostError>;
