import { Accessibility } from "destack:accessibility/host";
import { Audio } from "destack:audio/host";
import { Crypto } from "destack:crypto/host";
import { Device } from "destack:device/host";
import { Display } from "destack:display/host";
import { Fs } from "destack:fs/host";
import { Gpu } from "destack:gpu/host";
import { Input } from "destack:input/host";
import { Io } from "destack:io/host";
import { Ipc } from "destack:ipc/host";
import { Dynamic } from "destack:memory";
import { Memory } from "destack:memory/host";
import { Net } from "destack:net/host";
import { Os } from "destack:os/host";
import { Process } from "destack:process/host";
import { Random } from "destack:random/host";
import { Time } from "destack:time/host";
import { Tls } from "destack:tls/host";
import { Tty } from "destack:tty/host";

/// Runtime-provided host binding families.
@languageItem("host.Host")
export interface Host {
    /// Runtime accessibility binding family.
    readonly accessibility: Dynamic<Accessibility>;
    /// Runtime audio binding family.
    readonly audio: Dynamic<Audio>;
    /// Runtime crypto binding family.
    readonly crypto: Dynamic<Crypto>;
    /// Runtime device binding family.
    readonly device: Dynamic<Device>;
    /// Runtime display binding family.
    readonly display: Dynamic<Display>;
    /// Runtime filesystem binding family.
    readonly fs: Dynamic<Fs>;
    /// Runtime GPU binding family.
    readonly gpu: Dynamic<Gpu>;
    /// Runtime input binding family.
    readonly input: Dynamic<Input>;
    /// Runtime IO binding family.
    readonly io: Dynamic<Io>;
    /// Runtime IPC binding family.
    readonly ipc: Dynamic<Ipc>;
    /// Runtime memory binding family.
    readonly memory: Dynamic<Memory>;
    /// Runtime network binding family.
    readonly net: Dynamic<Net>;
    /// Runtime operating system binding family.
    readonly os: Dynamic<Os>;
    /// Runtime process binding family.
    readonly process: Dynamic<Process>;
    /// Runtime random binding family.
    readonly random: Dynamic<Random>;
    /// Runtime time binding family.
    readonly time: Dynamic<Time>;
    /// Runtime TLS binding family.
    readonly tls: Dynamic<Tls>;
    /// Runtime TTY binding family.
    readonly tty: Dynamic<Tty>;
}

/// Runtime-provided host bindings.
@languageItem("host.host")
@intrinsic("host.host")
export declare const host: Host;
