import { todo } from "destack:error";
import { Access, Borrowed, Copy, Default, Dispose, Region, ValueOf } from "destack:memory";
import { Dereference } from "destack:ops";

import { Atomic } from "./atomic.ds";

/// Reader-writer lock.
@languageItem("sync.RwLock")
export shared class RwLock<T> {
    /// The lock state.
    private state: Atomic<uint32> = Atomic.new(0);

    /// The protected value.
    private value: T;

    /// Create a reader-writer lock protecting `value`.
    constructor(value: T) {
        this.value = value;
    }

    /// Lock this value for shared reading.
    read<'a>(&'a readonly this): RwLockReadGuard<'a, T> {
        todo("RwLock.read")
    }

    /// Try to lock this value for shared reading.
    tryRead<'a>(&'a readonly this): RwLockReadGuard<'a, T> | undefined {
        todo("RwLock.tryRead")
    }

    /// Lock this value for exclusive writing.
    write<'a>(&'a readonly this): RwLockWriteGuard<'a, T> {
        todo("RwLock.write")
    }

    /// Try to lock this value for exclusive writing.
    tryWrite<'a>(&'a readonly this): RwLockWriteGuard<'a, T> | undefined {
        todo("RwLock.tryWrite")
    }

    /// Borrow the protected value without locking.
    getExclusive(&exclusive this): &exclusive shared ValueOf<T> {
        todo("RwLock.getExclusive")
    }

    /// Consume this lock and return the protected value.
    intoInner(^this): T {
        todo("RwLock.intoInner")
    }
}

export extension<T: Default> of RwLock<T> implements Default {
    /// Create the default reader-writer lock.
    static default(): ^RwLock<T> {
        new RwLock(T.default())
    }
}

/// Active readonly lock guard.
export local struct RwLockReadGuard<'a, T> {
    /// The locked value.
    private lock: &'a readonly RwLock<T>;
}

export extension<'a, T> of RwLockReadGuard<'a, T>
    implements Dispose, !Copy, Dereference<"readonly">
{
    /// The pointee type.
    type Target = shared ValueOf<T>;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Release this guard.
    dispose(this): void {
        todo("RwLockReadGuard.dispose");
    }

    /// Borrow the protected value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("RwLockReadGuard.dereference")
    }
}

/// Active exclusive lock guard.
export local struct RwLockWriteGuard<'a, T> {
    /// The locked value.
    private lock: &'a readonly RwLock<T>;
}

export extension<'a, T> of RwLockWriteGuard<'a, T>
    implements Dispose, !Copy, Dereference<"exclusive">
{
    /// The pointee type.
    type Target = shared ValueOf<T>;

    /// Release this guard.
    dispose(this): void {
        todo("RwLockWriteGuard.dispose");
    }

    /// Borrow the protected value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "exclusive">,
    ): Borrowed<this.Target, R, "exclusive"> {
        todo("RwLockWriteGuard.dereference")
    }

    /// Downgrade this write guard to a read guard.
    downgrade(this): RwLockReadGuard<'a, T> {
        todo("RwLockWriteGuard.downgrade")
    }
}

export extension<'a, T> of RwLockWriteGuard<'a, T> implements Dereference<"readonly"> {
    /// The pointee type.
    type Target = shared ValueOf<T>;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the protected value with readonly access.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("RwLockWriteGuard.dereference")
    }
}
