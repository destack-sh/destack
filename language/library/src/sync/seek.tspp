import { IoError, Result } from "tspp:error";

/// Seek origin.
@languageItem("sync.SeekFrom")
export newtype SeekFrom =
    | { kind: "start"; offset: uint64 }
    | { kind: "current"; offset: int64 }
    | { kind: "end"; offset: int64 };

/// Seekable byte stream.
@languageItem("sync.Seeker")
export interface Seeker {
    /// Seek to a new stream position.
    seek(&this, from: SeekFrom): Result<uint64, IoError>;
}
