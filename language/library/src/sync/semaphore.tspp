import { todo } from "tspp:error";
import { Copy, Dispose } from "tspp:memory";

import { Atomic } from "./atomic.tspp";

/// Counting semaphore.
@languageItem("sync.Semaphore")
export shared class Semaphore {
    /// The available permit count.
    private state: Atomic<isize>;

    /// Create a semaphore with `permits` available permits.
    constructor(permits: usize) {
        this.state = Atomic.new(permits.truncate<isize>());
    }

    /// Return the number of immediately available permits.
    get availablePermits(&readonly this): usize {
        todo("Semaphore.availablePermits")
    }

    /// Acquire one permit, blocking the current Worker if needed.
    acquire(): SemaphorePermit {
        todo("Semaphore.acquire")
    }

    /// Try to acquire one permit without blocking.
    tryAcquire(): SemaphorePermit | undefined {
        todo("Semaphore.tryAcquire")
    }

    /// Acquire `count` permits, blocking the current Worker if needed.
    acquireMany(count: usize): SemaphorePermit {
        todo("Semaphore.acquireMany")
    }

    /// Try to acquire `count` permits without blocking.
    tryAcquireMany(count: usize): SemaphorePermit | undefined {
        todo("Semaphore.tryAcquireMany")
    }

    /// Release `count` permits.
    release(count: usize = 1): void {
        todo("Semaphore.release");
    }
}

/// Active semaphore permit.
export struct SemaphorePermit implements !SharedSafe {
    /// The semaphore that issued this permit.
    private semaphore: Semaphore;

    /// The number of acquired permits.
    private count: usize;
}

export extension of SemaphorePermit implements Dispose, !Copy {
    /// Release this permit.
    dispose(this): void {
        todo("SemaphorePermit.dispose");
    }

    /// Consume this permit without releasing it.
    forget(this): void {
        todo("SemaphorePermit.forget");
    }
}
