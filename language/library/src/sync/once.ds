import { Result, todo } from "destack:error";
import { MaybeUninit } from "destack:memory";

import { Atomic } from "./atomic.ds";

/// One-time execution state.
@languageItem("sync.Once")
export shared class Once {
    /// The execution state.
    state: Atomic<uint32> = Atomic.new(0);

    /// Run `body` once.
    call(body: () => void): void {
        todo("Once.call");
    }

    /// Return true after the body has completed.
    isCompleted(): boolean {
        todo("Once.isCompleted")
    }
}

/// One-time initialized cell.
@languageItem("sync.OnceCell")
export shared class OnceCell<T> {
    /// The initialization state.
    state: Atomic<uint32> = Atomic.new(0);

    /// The stored value.
    value: MaybeUninit<T> = MaybeUninit.uninit();

    /// Get the initialized value.
    get(): &readonly T | undefined {
        todo("OnceCell.get")
    }

    /// Set the value once.
    set(value: ^T): Result<void, ^T> {
        todo("OnceCell.set")
    }

    /// Get the value or initialize it.
    getOrInit(init: () => T): &readonly T {
        todo("OnceCell.getOrInit")
    }

    /// Move the value out when initialized.
    take(&this): T | undefined {
        todo("OnceCell.take")
    }
}
