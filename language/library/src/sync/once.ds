/// One-time initialized cell.
@languageItem("sync.OnceCell")
export shared class OnceCell<T> {
    /// The initialization state.
    private state: Atomic<uint32> = Atomic.new(0);

    /// The stored value.
    private value: MaybeUninit<T> = MaybeUninit.uninit();

    /// Get the initialized value.
    get<'a>(&'a readonly this): &'a immutable shared ValueOf<T> | undefined {
        todo("OnceCell.get")
    }

    /// Set the value once.
    set(&readonly this, value: T): Result<void, T> {
        todo("OnceCell.set")
    }

    /// Get the value or initialize it.
    getOrInit<'a>(&'a readonly this, init: () => T): &'a immutable shared ValueOf<T> {
        todo("OnceCell.getOrInit")
    }

    /// Move the value out when initialized.
    take(&exclusive this): T | undefined {
        todo("OnceCell.take")
    }
}
