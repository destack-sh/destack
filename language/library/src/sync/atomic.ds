    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Atomic fetch-and-min (unsigned).
///
/// Atomically stores the unsigned minimum of the current value and `value`.
/// Returns the previous value before the operation.
@intrinsic("sync.atomic.fetch.umin")
export declare function atomicFetchUmin<T: Integer>(
