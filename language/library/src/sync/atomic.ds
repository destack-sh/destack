/// Add `value` to floating-point `*ptr` atomically and return the previous value.
@intrinsic("sync.atomic.fetch.fadd")
export declare function atomicFetchFadd<T: Float>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Store the floating-point minimum of `*ptr` and `value` and return the previous value.
@intrinsic("sync.atomic.fetch.fmin")
export declare function atomicFetchFmin<T: Float>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): T;

/// Store the floating-point maximum of `*ptr` and `value` and return the previous value.
@intrinsic("sync.atomic.fetch.fmax")
export declare function atomicFetchFmax<T: Float>(
    ptr: *T,
    value: T,
    order: MemoryOrdering,
