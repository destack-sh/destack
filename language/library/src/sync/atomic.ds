/// Prevent memory accesses from moving across this fence according to `order`.
@intrinsic("sync.atomic.fence")
export declare function atomicFence(
    order:
        | MemoryOrdering.Acquire
        | MemoryOrdering.Release
        | MemoryOrdering.AcquireRelease
        | MemoryOrdering.SequentiallyConsistent,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): void;

/// Block or park the current worker while `*ptr` equals `expected`.
@intrinsic("sync.atomic.wait")
@unsafe
export declare function atomicWait<T: Integer & AtomicSafe>(
    ptr: *T,
    expected: T,
    order: MemoryOrdering.Relaxed | MemoryOrdering.Acquire | MemoryOrdering.SequentiallyConsistent,
    timeoutNanos?: uint64,
): AtomicWaitResult;

/// Wake waiters blocked on an atomic integer location.
@intrinsic("sync.atomic.wake")
@unsafe
export declare function atomicWake<T: Integer & AtomicSafe>(ptr: *T, count?: usize): usize;
