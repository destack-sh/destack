/// Prevent memory accesses from moving across this fence according to `order`.
@intrinsic("sync.atomic.fence")
export declare function atomicFence(
    order: MemoryOrdering,
    scope: AtomicScope,
    memoryScope: MemoryScope,
    regions: MemoryRegionSet,
    isVolatile: boolean,
    isMakeAvailable: boolean,
    isMakeVisible: boolean,
): void;

/// Block or park the current worker while `*ptr` equals `expected`.
@intrinsic("sync.atomic.wait")
export declare function atomicWait<T: Integer>(
    ptr: *T,
    expected: T,
    order: MemoryOrdering,
    timeoutNanos?: uint64,
): AtomicWaitResult;

/// Wake waiters blocked on an atomic integer location.
@intrinsic("sync.atomic.wake")
export declare function atomicWake<T: Integer>(ptr: *T, count?: usize): usize;
