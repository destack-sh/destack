import { Expression } from "./expression.ds";
import { Symbol } from "./symbol.ds";

/// A declaration or property name.
export type Name = IdentifierName | StringName | IndexName;

/// A regular identifier name.
export interface IdentifierName {
    /// The name kind.
    kind: "identifier";
    /// The identifier text.
    value: string;
}

/// A quoted string name.
export interface StringName {
    /// The name kind.
    kind: "string";
    /// The string text.
    value: string;
}

/// A positional index name.
export interface IndexName {
    /// The name kind.
    kind: "index";
    /// The positional index.
    value: usize;
}

/// A value or type property key.
export type Key = NameKey | PrivateKey | ExpressionKey;

/// A named property key.
export interface NameKey {
    /// The key kind.
    kind: "name";
    /// The property name.
    name: Name;
}

/// A private property key.
export interface PrivateKey {
    /// The key kind.
    kind: "private";
    /// The private name without `#`.
    name: string;
}

/// A computed value-space key.
export interface ExpressionKey {
    /// The key kind.
    kind: "expression";
    /// The computed key expression.
    expression: Expression;
}

/// A symbol key.
export type SymbolKey = UniqueSymbolKey | RegistrySymbolKey;

/// A unique symbol key from a declaration.
export interface UniqueSymbolKey {
    /// The key kind.
    kind: "unique";
    /// The symbol declaration.
    symbol: Symbol;
}

/// A `Symbol.for` registry key.
export interface RegistrySymbolKey {
    /// The key kind.
    kind: "registry";
    /// The registry key.
    name: string;
}

/// A static property key.
export type StaticKey = StaticNameKey | StaticIndexKey | StaticSymbolKey;

/// A string-like static key.
export interface StaticNameKey {
    /// The key kind.
    kind: "name";
    /// The key text.
    name: string;
}

/// An index-like static key.
export interface StaticIndexKey {
    /// The key kind.
    kind: "index";
    /// The positional index.
    index: usize;
}

/// A symbol-like static key.
export interface StaticSymbolKey {
    /// The key kind.
    kind: "symbol";
    /// The symbol key.
    symbol: SymbolKey;
}
