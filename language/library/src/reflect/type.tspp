import { Concrete } from "tspp:memory/capability";

/// Type value for `T`.
@languageItem("reflect.Type")
export newtype Type<T = unknown> = intrinsic;

/// Return the target-specific size of `T`.
@languageItem("reflect.sizeOf")
@intrinsic("reflect.sizeOf")
export declare function sizeOf<T: Concrete>(): usize;

/// Return the target-specific alignment of `T`.
@languageItem("reflect.alignOf")
@intrinsic("reflect.alignOf")
export declare function alignOf<T: Concrete>(): usize;

/// Return the target-specific stride of `T`.
@languageItem("reflect.strideOf")
@intrinsic("reflect.strideOf")
export declare function strideOf<T: Concrete>(): usize;
