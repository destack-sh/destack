import { Binding } from "destack:binding";

import { DisplayBackendBinding } from "./backend.ds";
import { DisplayDragBinding } from "./drag.ds";
import { DisplayEventBinding } from "./event.ds";
import { DisplayFrameBinding } from "./frame.ds";
import { DisplayMonitorBinding } from "./monitor.ds";
import { DisplayWindowBinding } from "./window.ds";

/// Display binding family.
@languageItem("display.DisplayBinding")
export interface DisplayBinding {
    /// Backend bindings.
    readonly backend: DisplayBackendBinding;
    /// Drag bindings.
    readonly drag: DisplayDragBinding;
    /// Event bindings.
    readonly event: DisplayEventBinding;
    /// Frame bindings.
    readonly frame: DisplayFrameBinding;
    /// Monitor bindings.
    readonly monitor: DisplayMonitorBinding;
    /// Window bindings.
    readonly window: DisplayWindowBinding;
}

/// Current display binding family.
export const display: Binding<DisplayBinding> = new Binding<DisplayBinding>("display");
