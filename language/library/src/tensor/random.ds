    todo("tensor.uniform")
}

/// Return values sampled uniformly from [`low`, `high`).
export function uniformRange<T: int | float, comptime Rank: int>(
    shape: Shape<Rank>,
    low: T,
    high: T,
    random: Random,
    options?: TensorCreateOptions<Rank>,
): Tensor<T, Rank> {
    todo("tensor.uniformRange")
}

