import { Slice } from "destack:collections";
import { Buffer, Device, Mesh } from "destack:compute";
import { todo } from "destack:error";
import { Numeric } from "destack:math";
import { Access, WithAccess } from "destack:memory";
import {
    Add,
    And,
    Divide,
    Index,
    IndexSet,
    Multiply,
    Negate,
    Not,
    Or,
    Power,
    Remainder,
    Subtract,
    Xor,
} from "destack:ops";

import { Dense, MemoryOrder, TensorFormat } from "./layout.ds";
import { TensorCreateOptions, TensorOutputOptions } from "./options.ds";
import { Coordinate, Shape } from "./shape.ds";
import { Placement, Sharding, ShardingAxis, Unsharded } from "./sharding.ds";
import { TensorView } from "./view.ds";

/// Owning tensor value.
@languageItem("tensor.Tensor")
export newtype Tensor<
    T,
    comptime Rank: int,
    F: TensorFormat = Dense<MemoryOrder.RowMajor>,
    P: Placement = Unsharded,
> = intrinsic;

export extension<T, comptime Rank: int, F: TensorFormat, P: Placement> of Tensor<T, Rank, F, P> {
    /// Return the tensor shape.
    get shape(): Shape<Rank> {
        return tensorShape<T, Rank, F, P>(this);
    }

    /// Return the tensor storage format.
    get format(): F {
        return tensorFormat<T, Rank, F, P>(this);
    }

    /// Return the tensor placement.
    get placement(): P {
        return tensorPlacement<T, Rank, F, P>(this);
    }

    /// Allocate an uninitialized tensor.
    static empty(
        shape: Shape<Rank>,
        options?: TensorCreateOptions<Rank, F, P>,
    ): Tensor<T, Rank, F, P> {
        todo("Tensor.empty")
    }

    /// Allocate a tensor filled with `value`.
    static full(
        shape: Shape<Rank>,
        value: T,
        options?: TensorCreateOptions<Rank, F, P>,
    ): Tensor<T, Rank, F, P> {
        todo("Tensor.full")
    }

    /// Copy a contiguous slice into a tensor.
    static fromSlice(
        slice: &readonly [T],
        shape: Shape<Rank>,
        options?: TensorCreateOptions<Rank, F, P>,
    ): Tensor<T, Rank, F, P> {
        todo("Tensor.fromSlice")
    }

    /// Return the total element count.
    get size(): usize {
        return tensorSize<T, Rank, F, P>(this);
    }

    /// Return the number of axes.
    get rank(): int {
        Rank
    }

    /// Return the byte length of one element.
    get elementByteLength(): usize {
        return tensorElementByteLength<T, Rank, F, P>(this);
    }

    /// Return the tensor byte length.
    get byteLength(): usize {
        return tensorByteLength<T, Rank, F, P>(this);
    }

    /// Return whether this tensor has no elements.
    get isEmpty(): boolean {
        todo("Tensor.isEmpty")
    }
}

export extension<T, comptime Rank: int, F: TensorFormat> of Tensor<T, Rank, F, Unsharded> {
    /// Return the device that owns the tensor storage.
    get device(): Device {
        return tensorDevice<T, Rank, F>(this);
    }

    /// Return the backing compute buffer.
    get buffer(): Buffer<T> {
        return tensorBuffer<T, Rank, F>(this);
    }

    /// Return a tensor copy on `device`.
    to(
        device: Device,
        options?: TensorOutputOptions<T, Rank, F, Unsharded>,
    ): Tensor<T, Rank, F, Unsharded> {
        todo("Tensor.to")
    }
}

export extension<T, comptime Rank: int, F: TensorFormat, comptime ...Axes: ShardingAxis> of
    Tensor<T, Rank, F, Sharding<...Axes>> {
    /// Return the mesh that owns the tensor shards.
    get mesh(): Mesh {
        return tensorMesh<T, Rank, F, ...Axes>(this);
    }
}

export extension<T: Numeric, comptime Rank: int, F: TensorFormat, P: Placement> of
    Tensor<T, Rank, F, P> {
    /// Allocate a tensor filled with zero.
    static zeros(
        shape: Shape<Rank>,
        options?: TensorCreateOptions<Rank, F, P>,
    ): Tensor<T, Rank, F, P> {
        todo("Tensor.zeros")
    }

    /// Allocate a tensor filled with one.
    static ones(
        shape: Shape<Rank>,
        options?: TensorCreateOptions<Rank, F, P>,
    ): Tensor<T, Rank, F, P> {
        todo("Tensor.ones")
    }
}

export extension<T: Numeric, comptime Rank: int, F: TensorFormat, P: Placement> of
    Tensor<T, Rank, F, P>
    implements
        Add<Tensor<T, Rank, F, P>>,
        Subtract<Tensor<T, Rank, F, P>>,
        Multiply<Tensor<T, Rank, F, P>>,
        Divide<Tensor<T, Rank, F, P>>,
        Remainder<Tensor<T, Rank, F, P>>,
        Power<Tensor<T, Rank, F, P>>,
        Negate {
    /// The elementwise tensor result type.
    type Output = Tensor<T, Rank, F, P>;

    /// Add `other` elementwise.
    add(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.add")
    }

    /// Subtract `other` elementwise.
    subtract(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.subtract")
    }

    /// Multiply by `other` elementwise.
    multiply(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.multiply")
    }

    /// Divide by `other` elementwise.
    divide(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.divide")
    }

    /// Return the elementwise remainder after dividing by `other`.
    remainder(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.remainder")
    }

    /// Raise this tensor to `other` elementwise.
    power(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.power")
    }

    /// Negate this tensor elementwise.
    negate(): this.Output {
        todo("Tensor.negate")
    }
}

export extension<T: int | boolean, comptime Rank: int, F: TensorFormat, P: Placement> of
    Tensor<T, Rank, F, P>
    implements
        And<Tensor<T, Rank, F, P>>,
        Or<Tensor<T, Rank, F, P>>,
        Xor<Tensor<T, Rank, F, P>>,
        Not {
    /// The elementwise tensor result type.
    type Output = Tensor<T, Rank, F, P>;

    /// Apply bitwise AND elementwise.
    and(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.and")
    }

    /// Apply bitwise OR elementwise.
    or(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.or")
    }

    /// Apply bitwise XOR elementwise.
    xor(other: Tensor<T, Rank, F, P>): this.Output {
        todo("Tensor.xor")
    }

    /// Apply bitwise NOT elementwise.
    not(): this.Output {
        todo("Tensor.not")
    }
}

export extension<T, comptime Rank: int, F: TensorFormat, P: Placement> of Tensor<T, Rank, F, P>
    implements
        Index<Coordinate<Rank>>,
        IndexSet<Coordinate<Rank>, T> {
    /// The indexed output type.
    type Output = T;

    /// Return a view of this tensor.
    view<comptime A: Access = "readonly">(
        this: WithAccess<&Tensor<T, Rank, F, P>, A>,
    ): TensorView<T, Rank, F, P, A> {
        todo("Tensor.view")
    }

    /// Return a tensor with the same buffer reinterpreted as `shape`.
    reshape<comptime OutRank: int>(shape: Shape<OutRank>): Tensor<T, OutRank, F, P> {
        todo("Tensor.reshape")
    }

    /// Return a contiguous copy.
    contiguous<Out: TensorFormat = Dense<MemoryOrder.RowMajor>>(): Tensor<T, Rank, Out, P> {
        todo("Tensor.contiguous")
    }

    /// Borrow the element at `coordinate`.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&Tensor<T, Rank, F, P>, A>,
        coordinate: Coordinate<Rank>,
    ): WithAccess<&T, A> {
        todo("Tensor.index")
    }

    /// Store `value` at `coordinate`.
    indexSet(&exclusive this, coordinate: Coordinate<Rank>, value: T): void {
        todo("Tensor.indexSet");
    }
}

/// Return one tensor's shape.
@intrinsic("tensor.shape")
export declare function tensorShape<T, comptime Rank: int, F: TensorFormat, P: Placement>(
    tensor: &readonly Tensor<T, Rank, F, P>,
): Shape<Rank>;

/// Return one tensor's format.
@intrinsic("tensor.format")
export declare function tensorFormat<T, comptime Rank: int, F: TensorFormat, P: Placement>(
    tensor: &readonly Tensor<T, Rank, F, P>,
): F;

/// Return one tensor's placement.
@intrinsic("tensor.placement")
export declare function tensorPlacement<T, comptime Rank: int, F: TensorFormat, P: Placement>(
    tensor: &readonly Tensor<T, Rank, F, P>,
): P;

/// Return one tensor's size.
@intrinsic("tensor.size")
export declare function tensorSize<T, comptime Rank: int, F: TensorFormat, P: Placement>(
    tensor: &readonly Tensor<T, Rank, F, P>,
): usize;

/// Return one tensor's elementByteLength.
@intrinsic("tensor.elementByteLength")
export declare function tensorElementByteLength<
    T,
    comptime Rank: int,
    F: TensorFormat,
    P: Placement,
>(tensor: &readonly Tensor<T, Rank, F, P>): usize;

/// Return one tensor's byteLength.
@intrinsic("tensor.byteLength")
export declare function tensorByteLength<T, comptime Rank: int, F: TensorFormat, P: Placement>(
    tensor: &readonly Tensor<T, Rank, F, P>,
): usize;

/// Return the device that owns one tensor's storage.
@intrinsic("tensor.device")
export declare function tensorDevice<T, comptime Rank: int, F: TensorFormat>(
    tensor: &readonly Tensor<T, Rank, F, Unsharded>,
): Device;

/// Return the compute buffer backing one tensor.
@intrinsic("tensor.buffer")
export declare function tensorBuffer<T, comptime Rank: int, F: TensorFormat>(
    tensor: &readonly Tensor<T, Rank, F, Unsharded>,
): Buffer<T>;

/// Return the mesh that owns one sharded tensor's shards.
@intrinsic("tensor.mesh")
export declare function tensorMesh<
    T,
    comptime Rank: int,
    F: TensorFormat,
    comptime ...Axes: ShardingAxis,
>(tensor: &readonly Tensor<T, Rank, F, Sharding<...Axes>>): Mesh;
