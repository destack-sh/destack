import { Slice } from "destack:collections";
import { Device } from "destack:compute";
import { todo } from "destack:error";
import { Access, WithAccess } from "destack:memory";
import {
    Add,
    And,
    Divide,
    Index,
    IndexSet,
    Multiply,
    Negate,
    Not,
    Or,
    Power,
    Remainder,
    Subtract,
    Xor,
} from "destack:ops";

import { TensorBuffer } from "./buffer.ds";
import { Layout } from "./layout.ds";
import { TensorCreateOptions, TensorOutputOptions } from "./options.ds";
import { Coordinate, Shape } from "./shape.ds";
import { TensorView } from "./view.ds";

/// Owning tensor value on a device.
@languageItem("tensor.Tensor")
export class Tensor<T, comptime Rank: int> {
    /// The tensor shape.
    readonly shape: Shape<Rank>;

    /// The tensor layout.
    readonly layout: Layout;

    /// The tensor buffer.
    readonly buffer: TensorBuffer<T>;

    /// The device that owns the buffer.
    readonly device: Device;
}

extension<T, comptime Rank: int> of Tensor<T, Rank> {
    /// Allocate an uninitialized tensor.
    static empty(shape: Shape<Rank>, options?: TensorCreateOptions<Rank>): Tensor<T, Rank> {
        todo("Tensor.empty")
    }

    /// Allocate a tensor filled with `value`.
    static full(
        shape: Shape<Rank>,
        value: T,
        options?: TensorCreateOptions<Rank>,
    ): Tensor<T, Rank> {
        todo("Tensor.full")
    }

    /// Copy a contiguous slice into a tensor.
    static fromSlice(
        slice: &readonly Slice<T>,
        shape: Shape<Rank>,
        options?: TensorCreateOptions<Rank>,
    ): Tensor<T, Rank> {
        todo("Tensor.fromSlice")
    }

    /// Return the total element count.
    @intrinsic("tensor.size")
    get size(): usize;

    /// Return the number of axes.
    get rank(): int {
        Rank
    }

    /// Return the byte length of one element.
    @intrinsic("tensor.elementByteLength")
    get elementByteLength(): usize;

    /// Return the tensor byte length.
    @intrinsic("tensor.byteLength")
    get byteLength(): usize;

    /// Return whether this tensor has no elements.
    get isEmpty(): boolean {
        todo("Tensor.isEmpty")
    }
}

extension<T: int | float, comptime Rank: int> of Tensor<T, Rank> {
    /// Allocate a tensor filled with zero.
    static zeros(shape: Shape<Rank>, options?: TensorCreateOptions<Rank>): Tensor<T, Rank> {
        todo("Tensor.zeros")
    }

    /// Allocate a tensor filled with one.
    static ones(shape: Shape<Rank>, options?: TensorCreateOptions<Rank>): Tensor<T, Rank> {
        todo("Tensor.ones")
    }
}

extension<T: int | float, comptime Rank: int> of Tensor<T, Rank> implements
    Add<Tensor<T, Rank>>,
    Subtract<Tensor<T, Rank>>,
    Multiply<Tensor<T, Rank>>,
    Divide<Tensor<T, Rank>>,
    Remainder<Tensor<T, Rank>>,
    Power<Tensor<T, Rank>>,
    Negate {
    /// The elementwise tensor result type.
    type Output = Tensor<T, Rank>;

    /// Add `other` elementwise.
    add(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.add")
    }

    /// Subtract `other` elementwise.
    subtract(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.subtract")
    }

    /// Multiply by `other` elementwise.
    multiply(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.multiply")
    }

    /// Divide by `other` elementwise.
    divide(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.divide")
    }

    /// Return the elementwise remainder after dividing by `other`.
    remainder(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.remainder")
    }

    /// Raise this tensor to `other` elementwise.
    power(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.power")
    }

    /// Negate this tensor elementwise.
    negate(): this.Output {
        todo("Tensor.negate")
    }
}

extension<T: int | boolean, comptime Rank: int> of Tensor<T, Rank> implements
    And<Tensor<T, Rank>>,
    Or<Tensor<T, Rank>>,
    Xor<Tensor<T, Rank>>,
    Not {
    /// The elementwise tensor result type.
    type Output = Tensor<T, Rank>;

    /// Apply bitwise AND elementwise.
    and(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.and")
    }

    /// Apply bitwise OR elementwise.
    or(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.or")
    }

    /// Apply bitwise XOR elementwise.
    xor(other: Tensor<T, Rank>): this.Output {
        todo("Tensor.xor")
    }

    /// Apply bitwise NOT elementwise.
    not(): this.Output {
        todo("Tensor.not")
    }
}

extension<T, comptime Rank: int> of Tensor<T, Rank> implements
    Index<Coordinate<Rank>>,
    IndexSet<Coordinate<Rank>, T> {
    /// The indexed output type.
    type Output = T;

    /// Return a view of this tensor.
    view<comptime A: Access = "readonly">(this: WithAccess<&Tensor<T, Rank>, A>): TensorView<T, Rank, A> {
        todo("Tensor.view")
    }

    /// Return a tensor copy on `device`.
    to(device: Device, options?: TensorOutputOptions<T, Rank>): Tensor<T, Rank> {
        todo("Tensor.to")
    }

    /// Return a tensor with the same buffer reinterpreted as `shape`.
    reshape<comptime OutRank: int>(shape: Shape<OutRank>): Tensor<T, OutRank> {
        todo("Tensor.reshape")
    }

    /// Return a contiguous copy.
    contiguous(layout: Layout = Layout.rowMajor()): Tensor<T, Rank> {
        todo("Tensor.contiguous")
    }

    /// Return the element at `coordinate` by value.
    index(coordinate: Coordinate<Rank>): T {
        todo("Tensor.index")
    }

    /// Borrow the element at `coordinate`.
    index<comptime A: Access = "readonly">(
        this: WithAccess<&Tensor<T, Rank>, A>,
        coordinate: Coordinate<Rank>,
    ): WithAccess<&T, A> {
        todo("Tensor.index")
    }

    /// Store `value` at `coordinate`.
    indexSet(&exclusive this, coordinate: Coordinate<Rank>, value: T): void {
        todo("Tensor.indexSet");
    }
}
