import { FixedArray } from "destack:collections";

/// Slice window for a tensor with `Rank` axes.
export struct SliceWindow<comptime Rank: usize> {
    /// The starting coordinate for each axis.
    offsets: [usize; Rank];

    /// The result size for each axis.
    sizes: [usize; Rank];

    /// The stride for each axis.
    strides: [usize; Rank];
}

/// Padding for a tensor with `Rank` axes.
export struct Padding<comptime Rank: usize> {
    /// Padding before each axis.
    low: [usize; Rank];

    /// Padding after each axis.
    high: [usize; Rank];

    /// Padding between elements along each axis.
    interior: [usize; Rank];
}

/// Window parameters for tensor convolution.
export struct ConvolutionWindow<comptime SpatialRank: usize> {
    /// Stride for each spatial axis.
    strides: [usize; SpatialRank];

    /// Padding before each spatial axis.
    paddingLow: [usize; SpatialRank];

    /// Padding after each spatial axis.
    paddingHigh: [usize; SpatialRank];

    /// Input dilation for each spatial axis.
    inputDilation: [usize; SpatialRank];

    /// Kernel dilation for each spatial axis.
    kernelDilation: [usize; SpatialRank];

    /// Whether each spatial axis is reversed.
    reversal: [boolean; SpatialRank];
}

/// Grouping parameters for tensor convolution.
export struct ConvolutionGroups {
    /// Feature group count.
    feature: usize = 1;

    /// Batch group count.
    batch: usize = 1;
}

/// Window parameters for pooling.
export struct PoolWindow<comptime Rank: usize> {
    /// Window size for each axis.
    size: [usize; Rank];

    /// Stride for each axis.
    strides: [usize; Rank];

    /// Padding before each axis.
    paddingLow: [usize; Rank];

    /// Padding after each axis.
    paddingHigh: [usize; Rank];
}
