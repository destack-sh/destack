import { FixedArray } from "destack:collections";
import { todo } from "destack:error";

/// Axis index inside a tensor rank.
export newtype Axis = int32;

/// Runtime size along one tensor axis.
export newtype Extent = usize;

/// Tensor element stride.
export newtype Stride = isize;

/// Tensor shape with `Rank` axes.
@languageItem("tensor.Shape")
export struct Shape<comptime Rank: usize> {
    /// The size of each axis.
    extents: [Extent; Rank];
}

export extension<comptime Rank: usize> of Shape<Rank> {
    /// Create a shape from `extents`.
    static new(extents: [Extent; Rank]): Shape<Rank> {
        Shape { extents }
    }

    /// Return the tensor rank.
    get rank(): int {
        Rank
    }

    /// Return the extent of `axis`.
    extent(axis: Axis): Extent {
        todo("Shape.extent")
    }

    /// Return the number of elements.
    elementCount(): usize {
        todo("Shape.elementCount")
    }
}

/// Tensor coordinate with `Rank` indices.
export struct Coordinate<comptime Rank: usize> {
    /// The per-axis indices.
    values: [usize; Rank];
}

export extension<comptime Rank: usize> of Coordinate<Rank> {
    /// Create a coordinate from `values`.
    static new(values: [usize; Rank]): Coordinate<Rank> {
        Coordinate { values }
    }
}

/// Axis permutation with `Rank` entries.
export struct Permutation<comptime Rank: usize> {
    /// The source axis for each result axis.
    axes: [Axis; Rank];
}

export extension<comptime Rank: usize> of Permutation<Rank> {
    /// Create a permutation from `axes`.
    static new(axes: [Axis; Rank]): Permutation<Rank> {
        Permutation { axes }
    }

    /// Return the identity permutation.
    static identity(): Permutation<Rank> {
        todo("Permutation.identity")
    }
}

/// Axis set used by reductions and broadcasts.
export struct AxisSet<comptime Count: usize> {
    /// The axis values.
    values: [Axis; Count];
}

export extension<comptime Count: usize> of AxisSet<Count> {
    /// Create an axis set from `values`.
    static new(values: [Axis; Count]): AxisSet<Count> {
        AxisSet { values }
    }
}
