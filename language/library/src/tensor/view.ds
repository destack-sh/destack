import { FixedArray, Slice } from "destack:collections";
import { Mesh } from "destack:compute";
import { todo } from "destack:error";
import { Access } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

import { Dense, MemoryOrder, Strided, TensorViewFormat } from "./layout.ds";
import { Coordinate, Shape, Stride } from "./shape.ds";
import { Placement, Sharding, ShardingAxis, Unsharded } from "./sharding.ds";

/// Borrowed view over tensor storage.
@languageItem("tensor.TensorView")
export newtype TensorView<
    T,
    comptime Rank: usize,
    F: TensorViewFormat = Dense<MemoryOrder.RowMajor>,
    P: Placement = Unsharded,
    comptime A: Access = "mutable",
> = intrinsic;

export extension<T, comptime Rank: usize, F: TensorViewFormat, P: Placement, comptime A: Access> of
    TensorView<T, Rank, F, P, A>
    implements Index<Coordinate<Rank>> {
    /// The indexed output type.
    type Output = T;

    /// Return the tensor shape.
    get shape(): Shape<Rank> {
        return tensorViewShape<T, Rank, F, P, A>(this);
    }

    /// Return the tensor view format.
    get format(): F {
        return tensorViewFormat<T, Rank, F, P, A>(this);
    }

    /// Return the tensor view placement.
    get placement(): P {
        return tensorViewPlacement<T, Rank, F, P, A>(this);
    }

    /// Return the total element count.
    get size(): usize {
        return tensorViewSize<T, Rank, F, P, A>(this);
    }

    /// Return the number of axes.
    get rank(): int {
        Rank
    }

    /// Return the byte length of one element.
    get elementByteLength(): usize {
        return tensorViewElementByteLength<T, Rank, F, P, A>(this);
    }

    /// Return the tensor view byte length.
    get byteLength(): usize {
        return tensorViewByteLength<T, Rank, F, P, A>(this);
    }

    /// Borrow the element at `coordinate`.
    index(this: &TensorView<T, Rank, F, P, "mutable">, coordinate: Coordinate<Rank>): &T {
        todo("TensorView.index")
    }

    /// Borrow the element at `coordinate` with readonly access.
    index(&readonly this, coordinate: Coordinate<Rank>): &readonly T {
        todo("TensorView.index")
    }
}

export extension<T, comptime Rank: usize, P: Placement, comptime A: Access> of
    TensorView<T, Rank, Strided, P, A> {
    /// Return the element stride for each axis.
    get strides(): [Stride; Rank] {
        return tensorViewStrides<T, Rank, P, A>(this);
    }
}

export extension<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    comptime A: Access,
    comptime ...Axes: ShardingAxis,
> of TensorView<T, Rank, F, Sharding<...Axes>, A> {
    /// Return the mesh that owns the tensor view shards.
    get mesh(): Mesh {
        return tensorViewMesh<T, Rank, F, A, ...Axes>(this);
    }
}

export extension<T, comptime Rank: usize> of TensorView<T, Rank, Strided, Unsharded, "mutable"> {
    /// Build a mutable strided tensor view from a slice.
    @unsafe
    static fromSlice(
        slice: &[T],
        shape: Shape<Rank>,
        strides: [Stride; Rank],
    ): TensorView<T, Rank, Strided, Unsharded, "mutable"> {
        return tensorViewFromStridedSlice<T, Rank, "mutable">(slice, shape, strides);
    }
}

export extension<T, comptime Rank: usize> of TensorView<T, Rank, Strided, Unsharded, "readonly"> {
    /// Build a readonly strided tensor view from a slice.
    @unsafe
    static fromSlice(
        slice: &readonly [T],
        shape: Shape<Rank>,
        strides: [Stride; Rank],
    ): TensorView<T, Rank, Strided, Unsharded, "readonly"> {
        return tensorViewFromStridedSlice<T, Rank, "readonly">(slice, shape, strides);
    }
}

export extension<T, comptime Rank: usize> of TensorView<T, Rank, Strided, Unsharded, "exclusive"> {
    /// Build an exclusive strided tensor view from a slice.
    @unsafe
    static fromSlice(
        slice: &exclusive [T],
        shape: Shape<Rank>,
        strides: [Stride; Rank],
    ): TensorView<T, Rank, Strided, Unsharded, "exclusive"> {
        return tensorViewFromStridedSlice<T, Rank, "exclusive">(slice, shape, strides);
    }
}

export extension<T, comptime Rank: usize, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "mutable"> {
    /// Build a mutable tensor view from a contiguous slice.
    @unsafe
    static fromSlice(
        slice: &[T],
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "mutable"> {
        return tensorViewFromSlice<T, Rank, Order, "mutable">(slice, shape);
    }
}

export extension<T, comptime Rank: usize, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "readonly"> {
    /// Build a readonly tensor view from a contiguous slice.
    @unsafe
    static fromSlice(
        slice: &readonly [T],
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "readonly"> {
        return tensorViewFromSlice<T, Rank, Order, "readonly">(slice, shape);
    }
}

export extension<T, comptime Rank: usize, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "exclusive"> {
    /// Build an exclusive tensor view from a contiguous slice.
    @unsafe
    static fromSlice(
        slice: &exclusive [T],
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "exclusive"> {
        return tensorViewFromSlice<T, Rank, Order, "exclusive">(slice, shape);
    }
}

export extension<T, comptime Rank: usize, F: TensorViewFormat, P: Placement> of
    TensorView<T, Rank, F, P, "exclusive">
    implements IndexSet<Coordinate<Rank>, T> {
    /// Store `value` at `coordinate`.
    indexSet(&exclusive this, coordinate: Coordinate<Rank>, value: T): void {
        todo("TensorView.indexSet");
    }
}

/// Return one tensor view's shape.
@intrinsic("tensor.view.shape")
export declare function tensorViewShape<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): Shape<Rank>;

/// Return one tensor view's format.
@intrinsic("tensor.view.format")
export declare function tensorViewFormat<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): F;

/// Return one tensor view's placement.
@intrinsic("tensor.view.placement")
export declare function tensorViewPlacement<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): P;

/// Return one tensor view's size.
@intrinsic("tensor.view.size")
export declare function tensorViewSize<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): usize;

/// Return one tensor view's elementByteLength.
@intrinsic("tensor.view.elementByteLength")
export declare function tensorViewElementByteLength<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): usize;

/// Return one tensor view's byteLength.
@intrinsic("tensor.view.byteLength")
export declare function tensorViewByteLength<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    P: Placement,
    comptime A: Access,
>(view: &readonly TensorView<T, Rank, F, P, A>): usize;

/// Return the element stride of each axis of one strided tensor view.
@intrinsic("tensor.view.strides")
export declare function tensorViewStrides<T, comptime Rank: usize, P: Placement, comptime A: Access>(
    view: &readonly TensorView<T, Rank, Strided, P, A>,
): [Stride; Rank];

/// Return the mesh that owns one sharded tensor view's shards.
@intrinsic("tensor.view.mesh")
export declare function tensorViewMesh<
    T,
    comptime Rank: usize,
    F: TensorViewFormat,
    comptime A: Access,
    comptime ...Axes: ShardingAxis,
>(view: &readonly TensorView<T, Rank, F, Sharding<...Axes>, A>): Mesh;

/// Build one strided tensor view over a slice.
@intrinsic("tensor.view.fromStridedSlice")
export declare function tensorViewFromStridedSlice<T, comptime Rank: usize, comptime A: Access>(
    slice: WithAccess<&[T], A>,
    shape: Shape<Rank>,
    strides: [Stride; Rank],
): TensorView<T, Rank, Strided, Unsharded, A>;

/// Build one dense tensor view over a contiguous slice.
@intrinsic("tensor.view.fromSlice")
export declare function tensorViewFromSlice<
    T,
    comptime Rank: usize,
    comptime Order: MemoryOrder,
    comptime A: Access,
>(slice: WithAccess<&[T], A>, shape: Shape<Rank>): TensorView<T, Rank, Dense<Order>, Unsharded, A>;
