import { FixedArray, Slice } from "destack:collections";
import { Mesh } from "destack:compute";
import { todo } from "destack:error";
import { Access } from "destack:memory";
import { Index, IndexSet } from "destack:ops";

import { Dense, MemoryOrder, Strided, TensorViewFormat } from "./layout.ds";
import { Coordinate, Shape, Stride } from "./shape.ds";
import { Placement, Sharding, ShardingAxis, Unsharded } from "./sharding.ds";

/// Borrowed view over tensor storage.
@languageItem("tensor.TensorView")
export newtype TensorView<
    T,
    comptime Rank: int,
    F: TensorViewFormat = Dense<MemoryOrder.RowMajor>,
    P: Placement = Unsharded,
    comptime A: Access = "mutable",
> = intrinsic;

extension<T, comptime Rank: int, F: TensorViewFormat, P: Placement, comptime A: Access> of
    TensorView<T, Rank, F, P, A>
    implements Index<Coordinate<Rank>> {
    /// The indexed output type.
    type Output = T;

    /// Return the tensor shape.
    @intrinsic("tensor.view.shape")
    get shape(): Shape<Rank>;

    /// Return the tensor view format.
    @intrinsic("tensor.view.format")
    get format(): F;

    /// Return the tensor view placement.
    @intrinsic("tensor.view.placement")
    get placement(): P;

    /// Return the total element count.
    @intrinsic("tensor.view.size")
    get size(): usize;

    /// Return the number of axes.
    get rank(): int {
        Rank
    }

    /// Return the byte length of one element.
    @intrinsic("tensor.view.elementByteLength")
    get elementByteLength(): usize;

    /// Return the tensor view byte length.
    @intrinsic("tensor.view.byteLength")
    get byteLength(): usize;

    /// Return the element at `coordinate` by value.
    index(coordinate: Coordinate<Rank>): T {
        todo("TensorView.index")
    }

    /// Borrow the element at `coordinate`.
    index(this: &TensorView<T, Rank, F, P, "mutable">, coordinate: Coordinate<Rank>): &T {
        todo("TensorView.index")
    }

    /// Borrow the element at `coordinate` with readonly access.
    index(&readonly this, coordinate: Coordinate<Rank>): &readonly T {
        todo("TensorView.index")
    }
}

extension<T, comptime Rank: int, P: Placement, comptime A: Access> of
    TensorView<T, Rank, Strided, P, A> {
    /// Return the element stride for each axis.
    @intrinsic("tensor.view.strides")
    get strides(): FixedArray<Stride, Rank>;
}

extension<
    T,
    comptime Rank: int,
    F: TensorViewFormat,
    comptime A: Access,
    comptime ...Axes: ShardingAxis,
> of TensorView<T, Rank, F, Sharding<...Axes>, A> {
    /// Return the mesh that owns the tensor view shards.
    @intrinsic("tensor.view.mesh")
    get mesh(): Mesh;
}

extension<T, comptime Rank: int> of TensorView<T, Rank, Strided, Unsharded, "mutable"> {
    /// Build a mutable strided tensor view from a slice.
    @unsafe
    @intrinsic("tensor.view.fromStridedSlice")
    static fromSlice(
        slice: &Slice<T>,
        shape: Shape<Rank>,
        strides: FixedArray<Stride, Rank>,
    ): TensorView<T, Rank, Strided, Unsharded, "mutable">;
}

extension<T, comptime Rank: int> of TensorView<T, Rank, Strided, Unsharded, "readonly"> {
    /// Build a readonly strided tensor view from a slice.
    @unsafe
    @intrinsic("tensor.view.fromStridedSlice")
    static fromSlice(
        slice: &readonly Slice<T>,
        shape: Shape<Rank>,
        strides: FixedArray<Stride, Rank>,
    ): TensorView<T, Rank, Strided, Unsharded, "readonly">;
}

extension<T, comptime Rank: int> of TensorView<T, Rank, Strided, Unsharded, "exclusive"> {
    /// Build an exclusive strided tensor view from a slice.
    @unsafe
    @intrinsic("tensor.view.fromStridedSlice")
    static fromSlice(
        slice: &exclusive Slice<T>,
        shape: Shape<Rank>,
        strides: FixedArray<Stride, Rank>,
    ): TensorView<T, Rank, Strided, Unsharded, "exclusive">;
}

extension<T, comptime Rank: int, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "mutable"> {
    /// Build a mutable tensor view from a contiguous slice.
    @unsafe
    @intrinsic("tensor.view.fromSlice")
    static fromSlice(
        slice: &Slice<T>,
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "mutable">;
}

extension<T, comptime Rank: int, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "readonly"> {
    /// Build a readonly tensor view from a contiguous slice.
    @unsafe
    @intrinsic("tensor.view.fromSlice")
    static fromSlice(
        slice: &readonly Slice<T>,
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "readonly">;
}

extension<T, comptime Rank: int, comptime Order: MemoryOrder> of
    TensorView<T, Rank, Dense<Order>, Unsharded, "exclusive"> {
    /// Build an exclusive tensor view from a contiguous slice.
    @unsafe
    @intrinsic("tensor.view.fromSlice")
    static fromSlice(
        slice: &exclusive Slice<T>,
        shape: Shape<Rank>,
    ): TensorView<T, Rank, Dense<Order>, Unsharded, "exclusive">;
}

extension<T, comptime Rank: int, F: TensorViewFormat, P: Placement> of
    TensorView<T, Rank, F, P, "exclusive">
    implements IndexSet<Coordinate<Rank>, T> {
    /// Store `value` at `coordinate`.
    indexSet(&exclusive this, coordinate: Coordinate<Rank>, value: T): void {
        todo("TensorView.indexSet");
    }
}
