import { FixedArray } from "destack:collections";
import { todo } from "destack:error";

import { Axis, Shape, Stride } from "./shape.ds";

/// Memory order for dense tensor storage.
export enum MemoryOrder {
    /// The last axis is contiguous.
    RowMajor = 1,
    /// The first axis is contiguous.
    ColumnMajor = 2,
}

/// Dense contiguous tensor layout.
export struct DenseLayout {
    /// The layout variant.
    kind: "dense" = "dense";

    /// The dense memory order.
    order: MemoryOrder = MemoryOrder.RowMajor;
}

/// Explicit strided tensor view layout.
export struct StridedLayout<comptime Rank: int> {
    /// The layout variant.
    kind: "strided" = "strided";

    /// The element stride for each axis.
    strides: FixedArray<Stride, Rank>;
}

/// Dense tensor layout descriptor.
@languageItem("tensor.Layout")
export newtype Layout = DenseLayout;

/// Tensor view layout descriptor for `Rank` axes.
@languageItem("tensor.ViewLayout")
@derive(Tagged)
export newtype ViewLayout<comptime Rank: int> = DenseLayout | StridedLayout<Rank>;

extension of Layout {
    /// Return row-major dense layout.
    static rowMajor(): Layout {
        DenseLayout { kind: "dense", order: MemoryOrder.RowMajor } as Layout
    }

    /// Return column-major dense layout.
    static columnMajor(): Layout {
        DenseLayout { kind: "dense", order: MemoryOrder.ColumnMajor } as Layout
    }

    /// Return whether this layout is dense.
    isDense(): boolean {
        true
    }

    /// Return whether this layout stores logical neighbors contiguously.
    isContiguous<comptime Rank: int>(shape: Shape<Rank>): boolean {
        true
    }

    /// Return the linear element offset for `indices`.
    offset<comptime Rank: int>(indices: FixedArray<usize, Rank>, shape: Shape<Rank>): isize {
        todo("Layout.offset")
    }
}

extension<comptime Rank: int> of ViewLayout<Rank> {
    /// Return row-major dense layout.
    static rowMajor(): ViewLayout<Rank> {
        DenseLayout { kind: "dense", order: MemoryOrder.RowMajor } as ViewLayout<Rank>
    }

    /// Return column-major dense layout.
    static columnMajor(): ViewLayout<Rank> {
        DenseLayout { kind: "dense", order: MemoryOrder.ColumnMajor } as ViewLayout<Rank>
    }

    /// Return strided layout.
    static strided(strides: FixedArray<Stride, Rank>): ViewLayout<Rank> {
        StridedLayout<Rank> { kind: "strided", strides } as ViewLayout<Rank>
    }

    /// Return whether this layout is dense.
    isDense(): boolean {
        todo("ViewLayout.isDense")
    }

    /// Return whether this layout stores logical neighbors contiguously.
    isContiguous(shape: Shape<Rank>): boolean {
        todo("ViewLayout.isContiguous")
    }

    /// Return the linear element offset for `indices`.
    offset(indices: FixedArray<usize, Rank>, shape: Shape<Rank>): isize {
        todo("ViewLayout.offset")
    }
}

/// Named axis layout used by frontends and debugging tools.
export struct NamedAxis {
    /// The axis index.
    axis: Axis;

    /// The axis name.
    name: string;
}
