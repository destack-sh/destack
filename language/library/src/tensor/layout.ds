import { FixedArray } from "destack:collections";

import { Axis, Shape, Stride } from "./shape.ds";

/// Memory order for dense tensor storage.
export enum MemoryOrder {
    /// The last axis is contiguous.
    RowMajor = 1,
    /// The first axis is contiguous.
    ColumnMajor = 2,
}

/// Format implemented by borrowed tensor views.
@languageItem("tensor.TensorViewFormat")
export newtype interface TensorViewFormat {}

/// Format implemented by owning tensor storage.
@languageItem("tensor.TensorFormat")
export newtype interface TensorFormat extends TensorViewFormat {}

/// Dense contiguous tensor format.
@languageItem("tensor.Dense")
export newtype Dense<comptime Order: MemoryOrder = MemoryOrder.RowMajor> = intrinsic;

export extension<comptime Order: MemoryOrder> of Dense<Order> implements TensorFormat {}

/// Explicit strided tensor view format.
@languageItem("tensor.Strided")
export newtype Strided = intrinsic;

export extension of Strided implements TensorViewFormat {}

/// Row-major dense tensor format.
export type RowMajorFormat = Dense<MemoryOrder.RowMajor>;

/// Column-major dense tensor format.
export type ColumnMajorFormat = Dense<MemoryOrder.ColumnMajor>;

export extension<comptime Order: MemoryOrder> of Dense<Order> {
    /// Return the dense memory order.
    get order(): MemoryOrder {
        Order
    }

    /// Return whether this format is dense.
    get isDense(): boolean {
        true
    }

    /// Return whether this format stores logical neighbors contiguously.
    isContiguous<comptime Rank: int>(shape: Shape<Rank>): boolean {
        true
    }

    /// Return the linear element offset for `indices`.
    @intrinsic("tensor.format.dense.offset")
    offset<comptime Rank: int>(indices: FixedArray<usize, Rank>, shape: Shape<Rank>): isize;
}

export extension of Strided {
    /// Return whether this format is dense.
    get isDense(): boolean {
        false
    }

    /// Return whether this format stores logical neighbors contiguously.
    @intrinsic("tensor.format.strided.isContiguous")
    isContiguous<comptime Rank: int>(
        shape: Shape<Rank>,
        strides: FixedArray<Stride, Rank>,
    ): boolean;

    /// Return the linear element offset for `indices`.
    @intrinsic("tensor.format.strided.offset")
    offset<comptime Rank: int>(
        indices: FixedArray<usize, Rank>,
        strides: FixedArray<Stride, Rank>,
    ): isize;
}

/// Named axis metadata used by frontends and debugging tools.
export struct NamedAxis {
    /// The axis index.
    axis: Axis;

    /// The axis name.
    name: string;
}
