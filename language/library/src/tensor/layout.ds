import { FixedArray } from "destack:collections";
import { todo } from "destack:error";

import { Axis, Shape, Stride } from "./shape.ds";

/// Memory order for dense tensor storage.
export enum MemoryOrder {
    /// The last axis is contiguous.
    RowMajor = 1,
    /// The first axis is contiguous.
    ColumnMajor = 2,
}

/// Dense contiguous tensor format.
export struct DenseTensorFormat {
    /// The format variant.
    kind: "dense" = "dense";

    /// The dense memory order.
    order: MemoryOrder = MemoryOrder.RowMajor;
}

/// Explicit strided tensor view format.
export struct StridedTensorViewFormat<comptime Rank: int> {
    /// The format variant.
    kind: "strided" = "strided";

    /// The element stride for each axis.
    strides: FixedArray<Stride, Rank>;
}

/// Dense tensor format descriptor.
@languageItem("tensor.TensorFormat")
export newtype TensorFormat = DenseTensorFormat;

/// Tensor view format descriptor for `Rank` axes.
@languageItem("tensor.TensorViewFormat")
@derive(Tagged)
export newtype TensorViewFormat<comptime Rank: int> =
    DenseTensorFormat | StridedTensorViewFormat<Rank>;

extension of TensorFormat {
    /// Return row-major dense format.
    static rowMajor(): TensorFormat {
        DenseTensorFormat { kind: "dense", order: MemoryOrder.RowMajor } as TensorFormat
    }

    /// Return column-major dense format.
    static columnMajor(): TensorFormat {
        DenseTensorFormat { kind: "dense", order: MemoryOrder.ColumnMajor } as TensorFormat
    }

    /// Return whether this format is dense.
    isDense(): boolean {
        true
    }

    /// Return whether this format stores logical neighbors contiguously.
    isContiguous<comptime Rank: int>(shape: Shape<Rank>): boolean {
        true
    }

    /// Return the linear element offset for `indices`.
    offset<comptime Rank: int>(indices: FixedArray<usize, Rank>, shape: Shape<Rank>): isize {
        todo("TensorFormat.offset")
    }
}

extension<comptime Rank: int> of TensorViewFormat<Rank> {
    /// Return row-major dense format.
    static rowMajor(): TensorViewFormat<Rank> {
        DenseTensorFormat { kind: "dense", order: MemoryOrder.RowMajor } as TensorViewFormat<Rank>
    }

    /// Return column-major dense format.
    static columnMajor(): TensorViewFormat<Rank> {
        DenseTensorFormat {
            kind: "dense",
            order: MemoryOrder.ColumnMajor,
        } as TensorViewFormat<Rank>
    }

    /// Return strided format.
    static strided(strides: FixedArray<Stride, Rank>): TensorViewFormat<Rank> {
        StridedTensorViewFormat<Rank> { kind: "strided", strides } as TensorViewFormat<Rank>
    }

    /// Return whether this format is dense.
    isDense(): boolean {
        todo("TensorViewFormat.isDense")
    }

    /// Return whether this format stores logical neighbors contiguously.
    isContiguous(shape: Shape<Rank>): boolean {
        todo("TensorViewFormat.isContiguous")
    }

    /// Return the linear element offset for `indices`.
    offset(indices: FixedArray<usize, Rank>, shape: Shape<Rank>): isize {
        todo("TensorViewFormat.offset")
    }
}

/// Named axis metadata used by frontends and debugging tools.
export struct NamedAxis {
    /// The axis index.
    axis: Axis;

    /// The axis name.
    name: string;
}
