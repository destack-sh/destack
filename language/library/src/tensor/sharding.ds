import { Axis } from "./shape.ds";

/// Reduction used when partial tensor shards are combined.
export enum Reduction {
    /// Add partial values.
    Add = 1,
    /// Multiply partial values.
    Multiply = 2,
    /// Keep the minimum partial value.
    Minimum = 3,
    /// Keep the maximum partial value.
    Maximum = 4,
    /// Combine partial boolean values with AND.
    And = 5,
    /// Combine partial boolean values with OR.
    Or = 6,
}

/// Tensor placement descriptor.
@languageItem("tensor.Placement")
export newtype interface Placement {}

/// Per-axis placement descriptor used by a sharded tensor.
@languageItem("tensor.ShardingAxis")
export newtype interface ShardingAxis {}

/// Tensor storage on one device.
@languageItem("tensor.Unsharded")
export newtype Unsharded = intrinsic;

export extension of Unsharded implements Placement {}

/// Tensor storage partitioned or replicated across a compute mesh.
@languageItem("tensor.Sharding")
export newtype Sharding<const ...Axes: ShardingAxis> = intrinsic;

export extension<const ...Axes: ShardingAxis> of Sharding<...Axes> implements Placement {}

/// Split one tensor axis across one mesh axis.
@languageItem("tensor.Shard")
export newtype Shard<const A: Axis> = intrinsic;

export extension<const A: Axis> of Shard<A> implements ShardingAxis {}

/// Replicate one tensor axis across the mesh.
@languageItem("tensor.Replicate")
export newtype Replicate = intrinsic;

export extension of Replicate implements ShardingAxis {}

/// Store partial results across one mesh axis.
@languageItem("tensor.Partial")
export newtype Partial<const R: Reduction = Reduction.Add> = intrinsic;

export extension<const R: Reduction> of Partial<R> implements ShardingAxis {}
