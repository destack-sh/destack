import { TlsConnectionBinding } from "./connection.ds";
import { TlsContextBinding } from "./context.ds";

/// TLS binding family.
@languageItem("tls.TlsBinding")
export interface TlsBinding {
    /// Connection bindings.
    readonly connection: TlsConnectionBinding;
    /// TLS context bindings.
    readonly context: TlsContextBinding;
}
