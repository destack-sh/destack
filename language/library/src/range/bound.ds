import { PartialCompare } from "destack:ops";

/// One endpoint of a range.
@languageItem("range.Bound")
@derive(Tagged)
export newtype Bound<T> =
    | { kind: "included"; value: T }
    | { kind: "excluded"; value: T }
    | { kind: "unbounded" };

/// Common protocol for range bounds.
@languageItem("range.RangeBounds")
export newtype interface RangeBounds<T> {
    /// Return the start bound.
    startBound(&readonly this): Bound<&readonly T>;

    /// Return the end bound.
    endBound(&readonly this): Bound<&readonly T>;

    /// Return whether this range contains `value`.
    contains<U: PartialCompare<T>>(
        &readonly this,
        value: &readonly U,
    ): boolean where T: PartialCompare<U> {
        let isAfterStart = match (this.startBound()) {
            Bound.Included { value: bound } => *bound <= *value
            Bound.Excluded { value: bound } => *bound < *value
            Bound.Unbounded => true
        };

        // inspect the end only when the start admits the value
        isAfterStart &&
            (match (this.endBound()) {
                Bound.Included { value: bound } => *value <= *bound
                Bound.Excluded { value: bound } => *value < *bound
                Bound.Unbounded => true
            })
    }
}
