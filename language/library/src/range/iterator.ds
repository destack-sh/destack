import { todo } from "destack:error";
import { Iterator } from "destack:iter";
import { Option } from "destack:types";

import { Bound } from "./bound.ds";
import { Step } from "./step.ds";

/// Iterator over a stepped range.
export struct RangeIterator<T: Step<T>> {
    /// The next value to yield.
    current?: T;

    /// The end bound.
    end: Bound<T>;
}

extension<T: Step<T>> of RangeIterator<T> implements Iterator {
    type Item = T;

    /// Advance the iterator.
    next(): Option<T> {
        todo("RangeIterator.next")
    }
}
