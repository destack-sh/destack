import { Integer } from "tspp:math";
import { Compare } from "tspp:ops";

/// Protocol for values that can advance through a range.
@languageItem("range.Step")
export newtype interface Step<T = this> extends Compare<T> {
    /// Return the next value.
    next(this): T | undefined;

    /// Return the previous value.
    previous(this): T | undefined;
}

export extension<T: Integer> of T implements Step<T> where T: Compare<T> {
    /// Return the successor, or `undefined` at the maximum.
    next(this): T | undefined {
        this.checkedAdd(T.one())
    }

    /// Return the predecessor, or `undefined` at the minimum.
    previous(this): T | undefined {
        this.checkedSubtract(T.one())
    }
}
