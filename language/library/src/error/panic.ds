import { SourceLocation, StackTrace } from "./stack.ds";

/// Panic instance observed by hooks and supervisors.
@languageItem("error.Panic")
export struct Panic {
    /// The panic message.
    message: string;

    /// Source location where the panic began.
    location?: SourceLocation;

    /// Captured stack trace when available.
    stack?: StackTrace;
}

/// Runtime hook invoked before a panic starts unwinding.
export type PanicHook = (panic: Panic) => void;

/// Stop execution with a language panic.
@languageItem("error.panic")
@intrinsic("error.panic")
export declare function panic(message: string): never;

/// Install the runtime panic hook.
@languageItem("error.setPanicHook")
@binding("destack.error.panic.hook.set", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function setPanicHook(hook: PanicHook): void;

/// Remove the runtime panic hook and return the previous hook.
@languageItem("error.takePanicHook")
@binding("destack.error.panic.hook.take", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function takePanicHook(): PanicHook;

/// Stop execution with a low-level runtime trap.
@intrinsic("error.trap")
export declare function trap(message?: string): never;

/// Stop execution immediately without unwinding or cleanup.
@languageItem("error.abort")
@intrinsic("error.abort")
export declare function abort(message?: string): never;

/// Stop execution because code is intentionally unfinished.
@languageItem("error.todo")
@intrinsic("error.todo")
export declare function todo(message?: string): never;

/// Mark this code path as unreachable.
@languageItem("error.unreachable")
@intrinsic("error.unreachable")
export declare function unreachable(): never;
