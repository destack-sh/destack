import { Dynamic } from "tspp:memory";

/// Recoverable failure protocol.
@languageItem("error.Error")
export newtype interface Error {
    /// Format this error for users.
    display(this: &immutable this): ^string;

    /// Return the underlying cause.
    source(&readonly this): readonly Dynamic<Error> | undefined {
        undefined
    }
}

/// Runtime range failure used by web-compatible APIs.
@languageItem("error.RangeError")
export newtype RangeError = {
    /// The ECMAScript error name.
    name: "RangeError";

    /// The failure message.
    message: string;
};

export extension of RangeError implements Error {
    /// Format this error for users.
    display(this: &immutable this): ^string {
        this.message.clone()
    }
}

/// Runtime type failure used by web-compatible APIs.
@languageItem("error.TypeError")
export newtype TypeError = {
    /// The ECMAScript error name.
    name: "TypeError";

    /// The failure message.
    message: string;
};

export extension of TypeError implements Error {
    /// Format this error for users.
    display(this: &immutable this): ^string {
        this.message.clone()
    }
}
