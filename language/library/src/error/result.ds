import { Default } from "destack:memory";
import { ControlFlow, Equal, Try } from "destack:ops";

import { panic } from "./panic.ds";

/// Successful result variant.
@languageItem("error.Ok")
export struct Ok<T> {
    kind: "Ok" = "Ok";
    value: T;
}

/// Failed result variant.
@languageItem("error.Err")
export struct Err<E> {
    kind: "Err" = "Err";
    error: E;
}

/// Recoverable success or failure.
@languageItem("error.Result")
@derive(Tagged)
export newtype Result<T, E> = Ok<T> | Err<E>;

export extension<T, E> of Result<T, E> {
    /// Create a successful result.
    static ok(value: T): Result<T, E> {
        Result.Ok({ value })
    }

    /// Create a failed result.
    static err(error: E): Result<T, E> {
        Result.Err({ error })
    }

    /// Return true when this result is successful.
    isOk(): boolean {
        this.kind == "Ok"
    }

    /// Return true when this result is failed.
    isErr(): boolean {
        this.kind == "Err"
    }

    /// Return the success value or panic.
    unwrap(): T {
        match (this) {
            Result.Ok { value } => value
            Result.Err { error: _ } => panic("called Result.unwrap() on Err")
        }
    }

    /// Return the success value or `default`.
    unwrapOr(default: T): T {
        match (this) {
            Result.Ok { value } => value
            Result.Err { error: _ } => default
        }
    }

    /// Return the success value or the default value.
    unwrapOrDefault(): T where T: Default {
        match (this) {
            Result.Ok { value } => value
            Result.Err { error: _ } => T.default()
        }
    }

    /// Return the success value or compute one from the error.
    unwrapOrElse(f: (error: E) => T): T {
        match (this) {
            Result.Ok { value } => value
            Result.Err { error } => f(error)
        }
    }

    /// Return the failure value or panic.
    unwrapErr(): E {
        match (this) {
            Result.Ok { value: _ } => panic("called Result.unwrapErr() on Ok")
            Result.Err { error } => error
        }
    }

    /// Map the success value.
    map<U>(f: (value: T) => U): Result<U, E> {
        match (this) {
            Result.Ok { value } => Result.ok(f(value))
            Result.Err { error } => Result.err(error)
        }
    }

    /// Map the failure value.
    mapErr<F>(f: (error: E) => F): Result<T, F> {
        match (this) {
            Result.Ok { value } => Result.ok(value)
            Result.Err { error } => Result.err(f(error))
        }
    }

    /// Continue with another result-returning operation.
    andThen<U, F>(f: (value: T) => Result<U, F>): Result<U, E | F> {
        match (this) {
            // rebuild the continuation result at the joined error type
            Result.Ok { value } => match (f(value)) {
                Result.Ok { value } => Result.ok(value)
                Result.Err { error } => Result.err(error)
            }
            Result.Err { error } => Result.err(error)
        }
    }

    /// Recover from a failure.
    orElse<F>(f: (error: E) => Result<T, F>): Result<T, F> {
        match (this) {
            Result.Ok { value } => Result.ok(value)
            Result.Err { error } => f(error)
        }
    }

    /// Fold either result variant into one value.
    match<U>(arms: { ok: (value: T) => U; err: (error: E) => U }): U {
        match (this) {
            Result.Ok { value } => arms.ok(value)
            Result.Err { error } => arms.err(error)
        }
    }

    /// Run a side effect on success and keep the original result.
    tap(f: (value: T) => void): Result<T, E> {
        match (this) {
            Result.Ok { value } => {
                f(value);
                this
            }
            Result.Err { error: _ } => this
        }
    }

    /// Run a side effect on failure and keep the original result.
    tapErr(f: (error: E) => void): Result<T, E> {
        match (this) {
            Result.Ok { value: _ } => this
            Result.Err { error } => {
                f(error);
                this
            }
        }
    }
}

export extension<T, E> of Result<T, E> implements Try {
    /// The success value.
    type Output = T;

    /// The failure value.
    type Residual = E;

    /// Create a successful result.
    static fromOutput(output: T): Result<T, E> {
        Result.ok(output)
    }

    /// Create a result from a propagated residual.
    static fromResidual(residual: E): Result<T, E> {
        Result.err(residual)
    }

    /// Branch into success or failure control flow.
    branch(): ControlFlow<E, T> {
        match (this) {
            Result.Ok { value } => ControlFlow.Continue({ value })
            Result.Err { error } => ControlFlow.Break({ residual: error })
        }
    }
}

export extension<T: Equal<T>, E: Equal<E>> of Result<T, E> implements Equal<Result<T, E>> {
    /// Compare two results.
    equal(&readonly this, other: &readonly Result<T, E>): boolean {
        match (this) {
            Result.Ok { value: a } => {
                match (other) {
                    Result.Ok { value: b } => a.equal(b)
                    Result.Err { error: _ } => false
                }
            }
            Result.Err { error: a } => {
                match (other) {
                    Result.Err { error: b } => a.equal(b)
                    Result.Ok { value: _ } => false
                }
            }
        }
    }
}
