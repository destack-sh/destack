/// Inline policy for a function.
export type InlineHint = "hint" | "always" | "never";

/// Inline hint for generated code.
///
/// `@inline` defaults to `@inline("hint")`.
/// `@inline("always")` asks the compiler to inline and report when it cannot.
/// `@inline("never")` prevents inlining.
@languageItem("decorator.inline")
export newtype inline = () | (InlineHint,);

/// No-inline hint for generated code.
///
/// Equivalent to `@inline("never")`.
@languageItem("decorator.noinline")
export newtype noinline = ();

/// Loop unroll hint for generated code.
@languageItem("decorator.unroll")
export newtype unroll = (int,) | ();

/// Hint that a function is on a hot path.
@languageItem("decorator.hot")
export newtype hot = ();

/// Hint that a function is on a cold path.
@languageItem("decorator.cold")
export newtype cold = ();

/// Hint that a branch is likely to be taken.
@languageItem("decorator.likely")
export newtype likely = ();

/// Hint that a branch is unlikely to be taken.
@languageItem("decorator.unlikely")
export newtype unlikely = ();

/// Warn when a return value is ignored.
@languageItem("decorator.mustUse")
export newtype mustUse = ();

/// Mark a function as free of observable side effects.
@languageItem("decorator.pure")
export newtype pure = ();

/// Hint that a function should use a tail call.
@languageItem("decorator.tailcall")
export newtype tailcall = ();
