/// Representation policy for a declaration.
export type Representation =
    | "destack"
    | "C"
    | "transparent"
    | "int"
    | "uint"
    | "isize"
    | "usize"
    | `int${1..=128}`
    | `uint${1..=128}`;

/// Representation options for a declaration.
export type RepresentationOptions = {
    align?: 1 | 2 | 4 | 8 | 16 | 32 | 64 | 128 | 256 | 512 | 1024;
    packed?: boolean | 1 | 2 | 4 | 8 | 16 | 32 | 64 | 128 | 256 | 512 | 1024;
};

/// Specify the representation for a declaration.
///
/// `@repr("destack")` is the default language representation.
///
/// ```
/// @repr("uint8")
/// enum Color {
///     Red = 1,
///     Green = 2,
/// }
///
/// @repr("C")
/// struct Header {
///     tag: uint8;
///     size: uint32;
/// }
///
/// @repr("transparent")
/// newtype UserId = uint64;
///
/// @repr("C", { packed: true })
/// struct WireHeader {
///     tag: uint8;
///     size: uint32;
/// }
///
/// @repr({ align: 64 })
/// struct CacheLine {
///     value: uint64;
/// }
/// ```
@languageItem("decorator.repr")
export newtype repr =
    | (Representation,)
    | (Representation, RepresentationOptions)
    | (RepresentationOptions,);
