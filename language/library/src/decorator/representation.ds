import { type Type } from "destack:reflect/type";

/// Representation policy for a declaration.
export type Representation = "destack" | "C" | "transparent";

/// Representation options for a declaration.
export type RepresentationOptions = {
    align?: int;
    packed?: boolean | int;
};

/// Specify the representation for a declaration.
///
/// `@repr("destack")` is the default language representation.
///
/// ```
/// @repr(uint8)
/// enum Color {
///     Red = 1,
///     Green = 2,
/// }
///
/// @repr("C")
/// struct Header {
///     tag: uint8;
///     size: uint32;
/// }
///
/// @repr("transparent")
/// newtype UserId = uint64;
///
/// @repr("C", { packed: true })
/// struct WireHeader {
///     tag: uint8;
///     size: uint32;
/// }
///
/// @repr({ align: 64 })
/// struct CacheLine { value: uint64 }
/// ```
@languageItem("decorator.repr")
export newtype repr =
    (Representation,)
    | (Representation, RepresentationOptions)
    | (Type,)
    | (Type, RepresentationOptions)
    | (RepresentationOptions,);
