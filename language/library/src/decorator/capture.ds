/// Capture mode for closure bindings.
export type CaptureMode = "manage" | "borrow" | "copy" | "move";

/// Capture directive value for the capture decorator.
export type CaptureDirective =
    | CaptureMode
    | {
          [name: string]: CaptureMode;
      };

/// Configure closure capture modes for a lambda.
///
/// ```
/// const f = () => value;
/// ```
///
/// ```
/// @capture("manage")
/// const f = () => value;
/// ```
///
/// ```
/// @capture("copy")
/// const f = () => value;
/// ```
///
/// ```
/// @capture("move")
/// const f = () => resource.use();
/// ```
@languageItem("decorator.capture")
export newtype capture = (CaptureDirective,) | ();
