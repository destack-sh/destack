import { ExpansionContext, Macro, MaterializationContext } from "destack:macro";

import { intrinsic } from "./intrinsic.ds";

/// Constructor naming policy for tagged newtype unions.
export type TaggedCase =
    | "preserve"
    | "camelCase"
    | "UpperCamelCase"
    | "snake_case"
    | "SCREAMING_SNAKE_CASE";

/// Explicit constructor names keyed by discriminant spelling.
export type TaggedNames = {
    readonly [discriminant: string]: string;
};

/// Derive constructor helpers for tagged newtype unions.
///
/// ```ds
/// @derive(Tagged({ case: "UpperCamelCase" }))
/// newtype Shape =
///     | { kind: "rectangle"; width: int32; height: int32 }
///     | { kind: "circle"; radius: int32 };
/// ```
@languageItem("decorator.Tagged")
export newtype Tagged =
    | ()
    | {
          case?: TaggedCase;
          names?: TaggedNames;
      };

/// Implement `Tagged` as a macro provider.
export extension<Target> of Tagged implements Macro<Target> {
    @intrinsic
    static expand(target: Target, context: ExpansionContext, config: this): void;

    @intrinsic
    static materialize(
        target: Target,
        context: MaterializationContext,
        config: this,
        state: void,
    ): void;
}
