/// A canonical diagnostic id.
export type DiagnosticId = string;

/// Options for scoped diagnostic controls.
export type DiagnosticControlOptions =
    | {
          /// Reason shown next to the diagnostic control.
          reason: string;
          /// No condition in the reason-only form.
          if?: never;
          /// No alternate level in the reason-only form.
          otherwise?: never;
      }
    | {
          /// Reason shown next to the diagnostic control.
          reason?: string;
          /// Static condition that enables the control.
          if: boolean;
          /// Control applied when `if` is false.
          otherwise?: "allow" | "warn" | "deny" | "forbid";
      };

/// Suppress a diagnostic.
@languageItem("decorator.allow")
export newtype allow = (DiagnosticId,) | (DiagnosticId, DiagnosticControlOptions);

/// Report a diagnostic as a warning.
@languageItem("decorator.warn")
export newtype warn = (DiagnosticId,) | (DiagnosticId, DiagnosticControlOptions);

/// Report a diagnostic as an error.
@languageItem("decorator.deny")
export newtype deny = (DiagnosticId,) | (DiagnosticId, DiagnosticControlOptions);

/// Forbid overriding a diagnostic error.
@languageItem("decorator.forbid")
export newtype forbid = (DiagnosticId,) | (DiagnosticId, DiagnosticControlOptions);

/// Expect a diagnostic.
@languageItem("decorator.expect")
export newtype expect = (DiagnosticId,) | (DiagnosticId, DiagnosticControlOptions);
