import { Access } from "destack:memory";

/// Interface for dereference projection `*a`.
///
/// `A` selects the access form required by the operator use.
@languageItem("ops.Dereference")
export newtype interface Dereference<comptime A: Access = "readonly"> {
    /// The projected result form.
    type Output;

    /// Project the receiver into the requested access form.
    dereference(): this.Output;
}
