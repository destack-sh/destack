/// Continuing `Try` branch.
@languageItem("ops.Continue")
export struct Continue<C> {
    kind: "continue" = "continue";
    value: C;
}

/// Breaking `Try` branch.
@languageItem("ops.Break")
export struct Break<B> {
    kind: "break" = "break";
    residual: B;
}

/// Result of branching a `Try` carrier.
@languageItem("ops.ControlFlow")
export newtype ControlFlow<B, C> = Break<B> | Continue<C>;

export extension<B, C> of ControlFlow<B, C> {
    /// Create breaking control flow.
    static break(residual: B): ControlFlow<B, C> {
        ControlFlow(Break { residual })
    }

    /// Create continuing control flow.
    static continue(value: C): ControlFlow<B, C> {
        ControlFlow(Continue { value })
    }
}

/// Target protocol for rebuilding a carrier from a propagated residual.
@languageItem("ops.FromResidual")
export newtype interface FromResidual<R> {
    /// Construct this type from a propagated residual.
    static fromResidual(residual: R): this;
}

/// Protocol for values that work with `?`, `??`, and postfix `!`.
@languageItem("ops.Try")
export newtype interface Try extends FromResidual<this.Residual> {
    /// The output value produced when evaluation continues.
    type Output;

    /// The residual value propagated when evaluation breaks.
    type Residual;

    /// Construct this type from an output value.
    static fromOutput(output: this.Output): this;

    /// Branch into continuing or breaking control flow.
    branch(this): ControlFlow<this.Residual, this.Output>;
}
