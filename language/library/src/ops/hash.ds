/// A stateful hash sink.
@languageItem("ops.Hasher")
export newtype interface Hasher {
    /// Add raw bytes to the hash state.
    write(&this, bytes: &readonly [uint8]): void;

    /// Add one unsigned byte to the hash state.
    writeUint8(&this, value: uint8): void;

    /// Add one unsigned machine word to the hash state.
    writeUsize(&this, value: usize): void;

    /// Finish the hash state.
    finish(&readonly this): uint64;
}

/// A value that can feed itself into a hasher.
///
/// Values equal under `Equal` must produce equal hashes from the same initial hasher state.
@languageItem("ops.Hash")
export newtype interface Hash {
    /// Add this value to `state`.
    hash(this: &immutable this, state: &Hasher): void;
}
