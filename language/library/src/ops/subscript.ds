import { Access, WithAccess } from "destack:memory";

/// Interface for index access `a[i]`.
///
/// `a[i]` becomes `a.index(i)`.
///
/// The index type `I` can be any type (int, string, tuple, range, etc.).
@languageItem("ops.Index")
export newtype interface Index<I, comptime A: Access = "readonly"> {
    /// The indexed output type.
    type Output;

    /// Return the value at `key`.
    index(this: WithAccess<&this, A>, key: I): this.Output;
}

/// Interface for index assignment `a[i] = v`.
///
/// `a[i] = v` becomes `a.indexSet(i, v)` through an exclusive receiver.
///
/// Types that implement `IndexSet` should typically also implement `Index`.
@languageItem("ops.IndexSet")
export newtype interface IndexSet<I, V> {
    /// Store `value` at `key`.
    indexSet(&exclusive this, key: I, value: V): void;
}

/// Interface for membership checks `key in value`.
///
/// `key in value` becomes `value.has(&key)` when the receiver explicitly implements `Has<I>`.
@languageItem("ops.Has")
export newtype interface Has<I> {
    /// Return whether `key` is present.
    has(key: &readonly I): boolean;
}
