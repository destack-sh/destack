import { Access, Borrowed, Lifetime } from "destack:memory";

/// Interface for index access `a[i]`.
///
/// `a[i]` projects the place returned by `a.index(i)`.
@languageItem("ops.Index")
export newtype interface Index<I, const A: Access = "readonly"> {
    /// The indexed output type.
    type Output;

    /// The result when no indexed value exists.
    type Missing = never;

    /// Borrow the value at `key`.
    index<const L: Lifetime>(
        this: Borrowed<this, L, A>,
        key: I,
    ): Borrowed<this.Output, L, A> | this.Missing;
}

/// Interface for index assignment `a[i] = v`.
///
/// `a[i] = v` becomes `a.indexSet(i, v)` through an exclusive receiver.
@languageItem("ops.IndexSet")
export newtype interface IndexSet<I, V> {
    /// Store `value` at `key`.
    indexSet(&exclusive this, key: I, value: V): void;
}
