import { Access, Borrowed, Region } from "tspp:memory";

/// Interface for dereference projection `*a`.
@languageItem("ops.Dereference")
export newtype interface Dereference<const A: Access = "readonly"> {
    /// The pointee type.
    type Target;

    /// The access supplied by the pointer.
    const OutputAccess: Access = A;

    /// Borrow the pointee.
    dereference<const R: Region>(
        this: Borrowed<this, R, A>,
    ): Borrowed<this.Target, R, this.OutputAccess>;
}
