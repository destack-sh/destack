import { todo } from "destack:error";

import { MaybeOwned } from "destack:memory";

/// Interface for user-facing string representation.
///
/// Template interpolation dispatches through this interface: `${value}`
/// requires the value's type to implement it. Conformance is deliberate,
/// so a type without a semantic textual form never prints implicitly.
@languageItem("ops.Display")
export newtype interface Display {
    /// Return a user-facing string representation.
    display(&readonly this): MaybeOwned<string>;
}

/// Interface for developer-facing string representation.
///
/// Diagnostics and structural dumps dispatch through this interface.
/// Template interpolation never reaches it implicitly.
@languageItem("ops.Debug")
export newtype interface Debug {
    /// Return a developer-facing string representation.
    debug(&readonly this): MaybeOwned<string>;
}

export extension<T extends Display> of T {
    /// Return the owned user-facing string representation.
    toString(&readonly this): ^string {
        return todo("Display.toString");
    }
}
