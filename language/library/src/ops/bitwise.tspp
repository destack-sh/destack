/// Interface for the `&` operator.
///
/// `a & b` becomes `a.and(b)`.
@languageItem("ops.And")
export newtype interface And<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise AND.
    and(this, other: T): this.Output;
}

/// Interface for the `|` operator.
///
/// `a | b` becomes `a.or(b)`.
@languageItem("ops.Or")
export newtype interface Or<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise OR.
    or(this, other: T): this.Output;
}

/// Interface for the `^` operator.
///
/// `a ^ b` becomes `a.xor(b)`.
@languageItem("ops.Xor")
export newtype interface Xor<T = this> {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise XOR.
    xor(this, other: T): this.Output;
}

/// Interface for the `~` operator.
///
/// `~a` becomes `a.not()`.
@languageItem("ops.Not")
export newtype interface Not {
    /// The result type.
    type Output;

    /// Apply bitwise or elementwise NOT.
    not(this): this.Output;
}
