import { Equal, PartialEqual } from "./equality.ds";

/// Result of a comparison operation.
///
/// Used by the `Compare` interface.
@languageItem("ops.Ordering")
export const enum Ordering {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

/// Interface for partial comparison.
///
/// `partialCompare` returns `null` when comparison is undefined.
@languageItem("ops.PartialCompare")
export newtype interface PartialCompare<T = this> extends PartialEqual<T> {
    partialCompare(other: T): Ordering | null;
}

/// Interface for total comparison and ordering.
///
/// `a < b` becomes `a.compare(b) == Ordering.Less`.
/// `a <= b` becomes `a.compare(b) != Ordering.Greater`.
/// `a > b` becomes `a.compare(b) == Ordering.Greater`.
/// `a >= b` becomes `a.compare(b) != Ordering.Less`.
@languageItem("ops.Compare")
export newtype interface Compare<T = this> extends Equal<T>, PartialCompare<T> {
    compare(other: T): Ordering;
}
