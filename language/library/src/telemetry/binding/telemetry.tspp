import { Binding } from "tspp:binding";

import { LogEntry, MetricEntry, SpanContext, TraceEntry } from "../record.tspp";

/// Telemetry binding family.
@languageItem("telemetry.TelemetryBinding")
export interface TelemetryBinding {
    /// Emit one metric entry.
    @binding("tspp.telemetry.metric.emit", {
        effect: "deterministic",
        requires: ["runtime.telemetry.write"],
        families: ["windows", "unix", "wasm"],
        provider: "runtime",
        affinity: "worker",
    })
    emitMetric(entry: &readonly MetricEntry): void;

    /// Create trace identity for one span.
    @binding("tspp.telemetry.span.context", {
        effect: "deterministic",
        requires: ["runtime.telemetry.write"],
        families: ["windows", "unix", "wasm"],
        provider: "runtime",
        affinity: "worker",
    })
    createSpanContext(parent?: SpanContext): SpanContext;

    /// Emit one trace entry.
    @binding("tspp.telemetry.trace.emit", {
        effect: "deterministic",
        requires: ["runtime.telemetry.write"],
        families: ["windows", "unix", "wasm"],
        provider: "runtime",
        affinity: "worker",
    })
    emitTrace(entry: &readonly TraceEntry): void;

    /// Emit one log entry.
    @binding("tspp.telemetry.log.emit", {
        effect: "deterministic",
        requires: ["runtime.telemetry.write"],
        families: ["windows", "unix", "wasm"],
        provider: "runtime",
        affinity: "worker",
    })
    emitLog(entry: &readonly LogEntry): void;
}

/// Current telemetry binding family.
export const telemetry: Binding<TelemetryBinding> = new Binding<TelemetryBinding>("telemetry");
