import { Duration } from "destack:time";

import { telemetry } from "./binding/telemetry.ds";
import { Fields } from "./field.ds";
import { InstrumentKind, MetricEntry } from "./record.ds";

/// Metric entry sink.
@languageItem("telemetry.MetricSink")
export newtype interface MetricSink {
    /// Write one metric entry.
    write(&readonly this, entry: &readonly MetricEntry): void;
}

/// Monotonic metric counter.
@languageItem("telemetry.Counter")
export class Counter {
    /// Counter name.
    readonly name: string;

    /// Counter unit.
    readonly unit: string | undefined;

    /// Optional sink for this counter.
    private readonly sink: readonly MetricSink | undefined;

    /// Create a counter.
    constructor(name: string, unit?: string, sink?: readonly MetricSink) {
        this.name = name;
        this.unit = unit;
        this.sink = sink;
    }

    /// Add to this counter.
    add(&readonly this, value: number, fields?: Fields): void {
        const entry = MetricEntry {
            kind: InstrumentKind.Counter,
            name: &readonly this.name,
            value,
            unit: this.unit == undefined ? undefined : &readonly this.unit,
            fields,
        };

        writeMetric(this.sink, &readonly entry);
    }
}

/// Non-monotonic metric counter.
@languageItem("telemetry.UpDownCounter")
export class UpDownCounter {
    /// Counter name.
    readonly name: string;

    /// Counter unit.
    readonly unit: string | undefined;

    /// Optional sink for this counter.
    private readonly sink: readonly MetricSink | undefined;

    /// Create an up-down counter.
    constructor(name: string, unit?: string, sink?: readonly MetricSink) {
        this.name = name;
        this.unit = unit;
        this.sink = sink;
    }

    /// Add to this counter.
    add(&readonly this, value: number, fields?: Fields): void {
        const entry = MetricEntry {
            kind: InstrumentKind.UpDownCounter,
            name: &readonly this.name,
            value,
            unit: this.unit == undefined ? undefined : &readonly this.unit,
            fields,
        };

        writeMetric(this.sink, &readonly entry);
    }
}

/// Instantaneous metric gauge.
@languageItem("telemetry.Gauge")
export class Gauge {
    /// Gauge name.
    readonly name: string;

    /// Gauge unit.
    readonly unit: string | undefined;

    /// Optional sink for this gauge.
    private readonly sink: readonly MetricSink | undefined;

    /// Create a gauge.
    constructor(name: string, unit?: string, sink?: readonly MetricSink) {
        this.name = name;
        this.unit = unit;
        this.sink = sink;
    }

    /// Record this gauge value.
    set(&readonly this, value: number, fields?: Fields): void {
        const entry = MetricEntry {
            kind: InstrumentKind.Gauge,
            name: &readonly this.name,
            value,
            unit: this.unit == undefined ? undefined : &readonly this.unit,
            fields,
        };

        writeMetric(this.sink, &readonly entry);
    }
}

/// Distribution metric histogram.
@languageItem("telemetry.Histogram")
export class Histogram {
    /// Histogram name.
    readonly name: string;

    /// Histogram unit.
    readonly unit: string | undefined;

    /// Optional sink for this histogram.
    private readonly sink: readonly MetricSink | undefined;

    /// Create a histogram.
    constructor(name: string, unit?: string, sink?: readonly MetricSink) {
        this.name = name;
        this.unit = unit;
        this.sink = sink;
    }

    /// Record one histogram sample.
    record(&readonly this, value: number, fields?: Fields): void {
        const entry = MetricEntry {
            kind: InstrumentKind.Histogram,
            name: &readonly this.name,
            value,
            unit: this.unit == undefined ? undefined : &readonly this.unit,
            fields,
        };

        writeMetric(this.sink, &readonly entry);
    }
}

/// Metric meter.
@languageItem("telemetry.Meter")
export class Meter {
    /// Optional sink for these metric instruments.
    private readonly sink: readonly MetricSink | undefined;

    /// Create a meter.
    constructor(sink?: readonly MetricSink) {
        this.sink = sink;
    }

    /// Create one counter.
    counter(&readonly this, name: string, unit?: string): ^Counter {
        new Counter(name, unit, this.sink)
    }

    /// Create one up-down counter.
    upDownCounter(&readonly this, name: string, unit?: string): ^UpDownCounter {
        new UpDownCounter(name, unit, this.sink)
    }

    /// Create one gauge.
    gauge(&readonly this, name: string, unit?: string): ^Gauge {
        new Gauge(name, unit, this.sink)
    }

    /// Create one histogram.
    histogram(&readonly this, name: string, unit?: string): ^Histogram {
        new Histogram(name, unit, this.sink)
    }

    /// Record a duration sample.
    duration(&readonly this, name: string, value: &readonly Duration, fields?: Fields): void {
        this.histogram(name, "duration").record(value.total("nanosecond"), fields);
    }
}

/// Return the default meter.
export function meter(): Meter {
    new Meter()
}

/// Create one counter from the default meter.
export function counter(name: string, unit?: string): Counter {
    meter().counter(name, unit)
}

/// Create one up-down counter from the default meter.
export function upDownCounter(name: string, unit?: string): UpDownCounter {
    meter().upDownCounter(name, unit)
}

/// Create one gauge from the default meter.
export function gauge(name: string, unit?: string): Gauge {
    meter().gauge(name, unit)
}

/// Create one histogram from the default meter.
export function histogram(name: string, unit?: string): Histogram {
    meter().histogram(name, unit)
}

/// Record a duration sample with the default meter.
export function duration(name: string, value: &readonly Duration, fields?: Fields): void {
    meter().duration(name, value, fields);
}

/// Write one metric entry.
function writeMetric(sink: readonly MetricSink | undefined, entry: &readonly MetricEntry): void {
    if (sink == undefined) {
        telemetry.get().emitMetric(entry)
    } else {
        sink.write(entry)
    }
}
