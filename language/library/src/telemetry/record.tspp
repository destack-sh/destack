import { Fields } from "./field.tspp";

/// Metric instrument kind.
@languageItem("telemetry.InstrumentKind")
export enum InstrumentKind {
    /// Monotonic counter.
    Counter = 1,
    /// Non-monotonic counter.
    UpDownCounter = 2,
    /// Instantaneous gauge.
    Gauge = 3,
    /// Distribution histogram.
    Histogram = 4,
}

/// Metric entry.
@languageItem("telemetry.MetricEntry")
export struct MetricEntry<'a> {
    /// Instrument kind.
    kind: InstrumentKind;

    /// Instrument name.
    name: &'a readonly string;

    /// Recorded value.
    value: number;

    /// Unit name when available.
    unit?: &'a readonly string | undefined;

    /// Structured fields attached to this entry.
    fields?: Fields | undefined;
}

/// Distributed trace identifier.
@languageItem("telemetry.TraceId")
export newtype TraceId = uint128;

/// Span identifier inside one trace.
@languageItem("telemetry.SpanId")
export newtype SpanId = uint64;

/// Span relationship and transport kind.
@languageItem("telemetry.SpanKind")
export enum SpanKind {
    /// Internal work inside one runtime.
    Internal = 1,
    /// Server-side request handling.
    Server = 2,
    /// Client-side outbound request.
    Client = 3,
    /// Producer-side message send.
    Producer = 4,
    /// Consumer-side message receive.
    Consumer = 5,
}

/// Span completion status.
@languageItem("telemetry.SpanStatus")
export enum SpanStatus {
    /// No explicit status has been set.
    Unset = 1,
    /// Work completed successfully.
    Ok = 2,
    /// Work completed with an error.
    Error = 3,
}

/// Trace identity for one active span.
@languageItem("telemetry.SpanContext")
export struct SpanContext {
    /// Trace containing this span.
    traceId: TraceId;

    /// Span identifier.
    spanId: SpanId;

    /// Parent span identifier when present.
    parentSpanId?: SpanId | undefined;
}

/// Span start options.
@languageItem("telemetry.SpanOptions")
export struct SpanOptions {
    /// Span kind.
    kind?: SpanKind | undefined;

    /// Parent span context.
    parent?: SpanContext | undefined;

    /// Structured fields attached to the start entry.
    fields?: Fields | undefined;
}

/// Trace event kind.
@languageItem("telemetry.TraceEventKind")
export enum TraceEventKind {
    /// Span start.
    Start = 1,
    /// Span event.
    Event = 2,
    /// Span fields update.
    Fields = 3,
    /// Span failure.
    Error = 4,
    /// Span end.
    End = 5,
}

/// Trace event entry.
@languageItem("telemetry.TraceEntry")
export struct TraceEntry<'a> {
    /// Event kind.
    kind: TraceEventKind;

    /// Trace containing this entry.
    traceId: TraceId;

    /// Span containing this entry.
    spanId: SpanId;

    /// Parent span identifier when present.
    parentSpanId?: SpanId | undefined;

    /// Span kind on start entries.
    spanKind?: SpanKind | undefined;

    /// Span name.
    name: &'a readonly string;

    /// Event name when available.
    event?: &'a readonly string | undefined;

    /// Span status when available.
    status?: SpanStatus | undefined;

    /// Structured fields attached to this entry.
    fields?: Fields | undefined;

    /// Error value when available.
    error?: unknown | undefined;
}

/// Log severity.
@languageItem("telemetry.Level")
export enum Level {
    /// Highly detailed diagnostic event.
    Trace = 1,
    /// Diagnostic detail.
    Debug = 2,
    /// Informational event.
    Info = 3,
    /// Recoverable concern.
    Warn = 4,
    /// Operation failure.
    Error = 5,
    /// Unrecoverable failure.
    Fatal = 6,
}

/// Structured log entry.
@languageItem("telemetry.LogEntry")
export struct LogEntry<'a> {
    /// Log severity.
    level: Level;

    /// Stable event name.
    name: &'a readonly string;

    /// Logger name when available.
    logger?: &'a readonly string | undefined;

    /// Human-readable event message.
    message?: &'a readonly string | undefined;

    /// Structured fields attached to this event.
    fields?: Fields | undefined;

    /// Error value when available.
    error?: unknown | undefined;

    /// Active span when available.
    span?: SpanContext | undefined;
}
