import { Promise, Task } from "destack:async";
import { Copy } from "destack:memory";

import { telemetry } from "./binding/telemetry.ds";
import { Fields } from "./field.ds";
import {
    SpanContext,
    SpanKind,
    SpanOptions,
    SpanStatus,
    TraceEntry,
    TraceEventKind,
} from "./record.ds";

/// Trace event sink.
@languageItem("telemetry.TraceSink")
export newtype interface TraceSink {
    /// Write one trace entry.
    write(&readonly this, entry: &readonly TraceEntry): void;
}

/// Active trace span.
@languageItem("telemetry.Span")
export class Span {
    /// Span name.
    readonly name: string;

    /// Span identity.
    readonly context: SpanContext;

    /// Span kind.
    readonly kind: SpanKind;

    /// Optional sink for this span.
    private readonly sink: readonly TraceSink | undefined;

    /// Completion status.
    private status: SpanStatus = SpanStatus.Unset;

    /// Whether this span has ended.
    private isEnded: boolean = false;

    /// Create a span.
    constructor(
        name: &readonly string,
        context: SpanContext,
        kind?: SpanKind,
        fields?: Fields,
        sink?: readonly TraceSink,
    ) {
        this.name = name.slice();
        this.context = context;
        this.kind = kind ?? SpanKind.Internal;
        this.sink = sink;

        writeTrace(this.sink, TraceEntry {
            kind: TraceEventKind.Start,
            traceId: context.traceId,
            spanId: context.spanId,
            parentSpanId: context.parentSpanId,
            spanKind: this.kind,
            name,
            fields,
        });
    }

    /// Add fields to this span.
    addFields(&readonly this, fields: Fields): void {
        writeTrace(this.sink, TraceEntry {
            kind: TraceEventKind.Fields,
            traceId: this.context.traceId,
            spanId: this.context.spanId,
            name: &readonly this.name,
            fields,
        });
    }

    /// Add one event to this span.
    event<'a>(&'a readonly this, name: &'a readonly string, fields?: Fields): void {
        writeTrace(this.sink, TraceEntry {
            kind: TraceEventKind.Event,
            traceId: this.context.traceId,
            spanId: this.context.spanId,
            name: &readonly this.name,
            event: name,
            fields,
        });
    }

    /// Set this span status.
    setStatus(&this, status: SpanStatus): void {
        this.status = status;
    }

    /// Mark this span as failed.
    error(&this, error: unknown): void {
        this.status = SpanStatus.Error;
        writeTrace(this.sink, TraceEntry {
            kind: TraceEventKind.Error,
            traceId: this.context.traceId,
            spanId: this.context.spanId,
            name: &readonly this.name,
            error,
        });
    }

    /// Finish this span.
    end(&this, status?: SpanStatus): void {
        if (this.isEnded) {
            return;
        }

        this.isEnded = true;
        this.status = status ?? this.status;
        writeTrace(this.sink, TraceEntry {
            kind: TraceEventKind.End,
            traceId: this.context.traceId,
            spanId: this.context.spanId,
            name: &readonly this.name,
            status: this.status,
        });
    }
}

/// Trace span starter.
@languageItem("telemetry.Tracer")
export class Tracer {
    /// Optional sink for spans created by this tracer.
    private readonly sink: readonly TraceSink | undefined;

    /// Create a tracer.
    constructor(sink?: readonly TraceSink) {
        this.sink = sink;
    }

    /// Start one span.
    start(&readonly this, name: &readonly string, options?: SpanOptions): Span {
        const context = telemetry.get().createSpanContext(options?.parent);
        new Span(name, context, options?.kind, options?.fields, this.sink)
    }

    /// Run `body` inside one span.
    span<T>(
        &readonly this,
        name: &readonly string,
        body: (span: Span) => T,
        options?: SpanOptions,
    ): T {
        let active = this.start(name, options);
        const value = body(active);
        active.end();

        value
    }

    /// Run async `body` inside one span.
    spanAsync<T: Copy>(
        &readonly this,
        name: &readonly string,
        body: (span: Span) => Promise<T>,
        options?: SpanOptions,
    ): Promise<T> {
        let active = this.start(name, options);

        body(active).finally(() => active.end())
    }

    /// Run task `body` inside one span.
    async spanTask<T>(
        &readonly this,
        name: &readonly string,
        body: (span: Span) => Task<T>,
        options?: SpanOptions,
    ): Task<T> {
        let active = this.start(name, options);
        const value = await body(active);
        active.end();

        value
    }
}

/// Return the default tracer.
export function tracer(): Tracer {
    new Tracer()
}

/// Start one span with the default tracer.
export function start(name: &readonly string, options?: SpanOptions): Span {
    tracer().start(name, options)
}

/// Run `body` inside one span.
export function span<T>(name: &readonly string, body: (span: Span) => T, options?: SpanOptions): T {
    tracer().span(name, body, options)
}

/// Run async `body` inside one span.
export function spanAsync<T: Copy>(
    name: &readonly string,
    body: (span: Span) => Promise<T>,
    options?: SpanOptions,
): Promise<T> {
    tracer().spanAsync(name, body, options)
}

/// Run task `body` inside one span.
export function spanTask<T>(
    name: &readonly string,
    body: (span: Span) => Task<T>,
    options?: SpanOptions,
): Task<T> {
    tracer().spanTask(name, body, options)
}

/// Write one trace entry to a trace sink.
function writeTrace(sink: readonly TraceSink | undefined, entry: TraceEntry): void {
    if (sink == undefined) {
        telemetry.get().emitTrace(&readonly entry)
    } else {
        sink.write(&readonly entry)
    }
}
