import { Promise, Task } from "tspp:async";
import { Error, Result } from "tspp:error";
import { Copy, Dynamic } from "tspp:memory";
import { Duration } from "tspp:time";

import { Cleanup } from "./context.tspp";

/// Result produced while creating one fixture instance.
export type FixtureResult<T> =
    | T
    | Result<T, Dynamic<Error>>
    | Task<T | Result<T, Dynamic<Error>>>
    | (T extends Copy ? Promise<T | Result<T, Dynamic<Error>>> : never);

/// State provided while creating one fixture.
@languageItem("test.FixtureContext")
export newtype interface FixtureContext {
    /// Run one cleanup after this fixture expires.
    onCleanup(cleanup: Cleanup): void;
}

/// Options shared by all fixture scopes.
export type FixtureOptions = {
    /// Create the fixture before a test first requests it.
    auto?: boolean;

    /// Allow project configuration to provide the fixture value.
    injected?: boolean;

    /// Maximum fixture setup and cleanup duration.
    timeout?: Duration;
};

/// Options for one test-scoped fixture.
export type TestFixtureOptions = FixtureOptions & {
    /// Create one fixture instance per test run.
    scope?: "test";
};

/// Options for one module-scoped fixture.
export type ModuleFixtureOptions = FixtureOptions & {
    /// Reuse one fixture instance for the current module in each Worker.
    scope: "module";
};

/// Options for one Worker-scoped fixture.
export type WorkerFixtureOptions = FixtureOptions & {
    /// Reuse one fixture instance for the current Worker.
    scope: "worker";
};

/// Function that creates one fixture instance.
export type Fixture<C, T> = (context: &C, fixture: FixtureContext) => FixtureResult<T>;
