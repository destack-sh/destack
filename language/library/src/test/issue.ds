import { Panic, SourceLocation } from "destack:error";
import { Json } from "destack:json";

import { ArtifactId } from "./artifact.ds";

/// Test issue kind.
@languageItem("test.IssueKind")
export enum IssueKind {
    /// Assertion failed.
    Assertion = 1,
    /// Snapshot comparison failed.
    Snapshot = 2,
    /// Fuzzing found a counterexample.
    Counterexample = 3,
    /// Simulation invariant failed.
    Invariant = 5,
    /// Execution trapped or panicked.
    Panic = 6,
    /// Execution exceeded its deadline.
    Timeout = 7,
    /// Test definition was invalid.
    InvalidCase = 8,
    /// External operation failed.
    Error = 9,
}

/// Structured issue found during a test run.
@languageItem("test.Issue")
export struct Issue {
    /// Issue kind.
    kind: IssueKind;

    /// Human-readable issue message.
    message: ^string;

    /// Source location when available.
    location?: SourceLocation;

    /// Uncaught panic when this issue ended a Worker.
    panic?: readonly Panic;

    /// Structured fields attached to this issue.
    fields?: { readonly [key: string]: Json };

    /// Related artifact identifiers.
    artifacts?: [ArtifactId];
}
