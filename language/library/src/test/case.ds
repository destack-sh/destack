import { Duration } from "destack:time";

import { CaseId } from "./id.ds";
import { CaseKind, Options } from "./options.ds";
import { Body } from "./result.ds";

/// Test registration argument after the test name.
export type CaseArgument = Body | Options | Duration;

/// Registered test case.
export struct Case {
    /// Stable case identifier.
    id: CaseId;

    /// Case name.
    name: string;

    /// Case kind.
    kind: CaseKind;

    /// Case options.
    options?: Options;
}

/// Register one test.
@binding("destack.test.case.register", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerCase(name: string, argument?: CaseArgument, body?: Body): void;

/// Register one skipped test.
@binding("destack.test.case.skip", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerSkippedCase(name: string, argument?: CaseArgument, body?: Body): void;

/// Register one focused test.
@binding("destack.test.case.only", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerFocusedCase(name: string, argument?: CaseArgument, body?: Body): void;

/// Register one pending test.
@binding("destack.test.case.todo", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerPendingCase(name: string): void;

export {
    registerCase,
    registerCase as case,
    registerCase as it,
    registerCase as test,
    registerFocusedCase as caseOnly,
    registerFocusedCase as itOnly,
    registerFocusedCase as testOnly,
    registerPendingCase as caseTodo,
    registerPendingCase as itTodo,
    registerPendingCase as testTodo,
    registerSkippedCase as caseSkip,
    registerSkippedCase as itSkip,
    registerSkippedCase as testSkip,
};
