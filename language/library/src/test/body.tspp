import { Promise, Task } from "tspp:async";
import { Error, Result } from "tspp:error";
import { Dynamic } from "tspp:memory";

import { CaseContext, Context } from "./context.tspp";

/// Successful or recoverable completion of one test callback.
export type BodyResult =
    | void
    | Result<void, Dynamic<Error>>
    | Promise<void | Result<void, Dynamic<Error>>>
    | Task<void | Result<void, Dynamic<Error>>>;

/// Test case callback.
export type Body<C: CaseContext = CaseContext> = (context: &C) => BodyResult;

/// Repeatable test hook callback.
export type HookBody<C: Context = Context> = (context: &C) => BodyResult;

/// Test suite registration callback.
export type SuiteBody = ^Function<(), void, "once">;

/// Hook wrapped around one callback invocation.
export type AroundHook<C: Context = Context> = (
    run: ^Function<(), BodyResult, "once">,
    context: &C,
) => BodyResult;
