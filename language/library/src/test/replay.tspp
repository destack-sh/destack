import { Json } from "tspp:json";
import { RandomSeed } from "tspp:runtime";

/// Stable replay identifier.
@languageItem("test.ReplayId")
export newtype ReplayId = string;

/// Replay source kind.
@languageItem("test.ReplayKind")
export enum ReplayKind {
    /// Ordinary test replay.
    Case = 1,
    /// Fuzz sample replay.
    Fuzz = 2,
    /// Simulation replay.
    Simulation = 3,
}

/// One recorded replay input.
@languageItem("test.ReplayInput")
export struct ReplayInput {
    /// Input name.
    name: string;

    /// Input value.
    value: Json;
}

/// Reproducible test run input.
@languageItem("test.Replay")
export struct Replay {
    /// Replay identifier when persisted.
    id?: ReplayId;

    /// Replay kind.
    kind: ReplayKind;

    /// Deterministic seed when relevant.
    seed?: RandomSeed;

    /// Recorded inputs.
    inputs?: [ReplayInput];
}
