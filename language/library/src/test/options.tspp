import { Json } from "tspp:json";
import { Label } from "tspp:runtime";
import { Duration } from "tspp:time";

/// Test case execution kind.
@languageItem("test.CaseKind")
export enum CaseKind {
    /// Ordinary example-based check.
    Example = 1,
    /// Fuzz case.
    Fuzz = 3,
    /// Simulation case.
    Simulation = 4,
}

/// Execution isolation using a pooled Worker, fresh Runtime, or fresh World.
@languageItem("test.Isolation")
export type Isolation = "worker" | "runtime" | "world";

/// Retry policy for one test.
export type RetryOptions = {
    /// Maximum retry count after the first failed run.
    count: uint32;

    /// Delay before each retry.
    delay?: Duration;
};

/// Test registration options.
@languageItem("test.Options")
export type Options = {
    /// Focus this registration.
    only?: boolean;

    /// Skip this registration.
    skip?: boolean;

    /// Record this registration without running it.
    todo?: boolean;

    /// Require this registration to fail.
    fails?: boolean;

    /// Permit this test to run concurrently with its siblings.
    concurrent?: boolean;

    /// Maximum execution duration.
    timeout?: Duration;

    /// Retry policy after failure.
    retry?: uint32 | RetryOptions;

    /// Additional successful repetitions.
    repeats?: uint32;

    /// Isolation used to execute this registration.
    isolation?: Isolation;

    /// Shuffle direct children of this suite.
    shuffle?: boolean;

    /// Labels attached to this registration.
    labels?: [Label];

    /// Tags used to select and report this registration.
    tags?: string[];

    /// Structured metadata attached to this registration.
    meta?: { readonly [key: string]: Json };
};
