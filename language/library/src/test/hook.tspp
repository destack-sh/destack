/// Register setup before all tests in the current suite.
@languageItem("test.beforeAll")
export function beforeAll(body: HookBody<SuiteContext>, timeout?: Duration): void {
    todo("test.beforeAll");
}

/// Register cleanup after all tests in the current suite.
@languageItem("test.afterAll")
export function afterAll(body: HookBody<SuiteContext>, timeout?: Duration): void {
    todo("test.afterAll");
}

/// Register a function around all tests in the current suite.
@languageItem("test.aroundAll")
export function aroundAll(body: AroundHook<SuiteContext>, timeout?: Duration): void {
    todo("test.aroundAll");
}

/// Register setup before each test in the current suite.
@languageItem("test.beforeEach")
export function beforeEach(body: HookBody<CaseContext>, timeout?: Duration): void {
    todo("test.beforeEach");
