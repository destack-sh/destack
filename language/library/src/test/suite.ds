import { Duration } from "destack:time";

import { SuiteId } from "./id.ds";
import { Options } from "./options.ds";
import { SuiteBody } from "./result.ds";

/// Test suite registration argument after the suite name.
export type SuiteArgument = SuiteBody | Options | Duration;

/// Registered test suite.
export struct Suite {
    /// Stable suite identifier.
    id: SuiteId;

    /// Suite name.
    name: string;

    /// Suite options.
    options?: Options;
}

/// Register one test suite.
@binding("destack.test.suite.register", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerSuite(name: string, argument?: SuiteArgument, body?: SuiteBody): void;

/// Register one skipped test suite.
@binding("destack.test.suite.skip", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerSkippedSuite(
    name: string,
    argument?: SuiteArgument,
    body?: SuiteBody,
): void;

/// Register one focused test suite.
@binding("destack.test.suite.only", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerFocusedSuite(
    name: string,
    argument?: SuiteArgument,
    body?: SuiteBody,
): void;

/// Register one pending test suite.
@binding("destack.test.suite.todo", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function registerPendingSuite(name: string): void;

export {
    registerSuite,
    registerSuite as describe,
    registerSuite as suite,
    registerFocusedSuite as describeOnly,
    registerFocusedSuite as suiteOnly,
    registerPendingSuite as describeTodo,
    registerPendingSuite as suiteTodo,
    registerSkippedSuite as describeSkip,
    registerSkippedSuite as suiteSkip,
};
