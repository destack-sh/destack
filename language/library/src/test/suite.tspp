import { todo } from "tspp:error";
import { Iterable } from "tspp:iter";

import { SuiteBody } from "./body.tspp";
import { SuiteId } from "./id.tspp";
import { Options } from "./options.tspp";

/// Test suite registration function.
export const describe: TestSuite = createSuite();

/// Alias for `describe`.
export const suite: TestSuite = describe;

/// Callable test suite registration interface.
@languageItem("test.TestSuite")
export newtype interface TestSuite {
    /// Register one test suite.
    (name: string, body?: SuiteBody): void;

    /// Register one configured test suite.
    (name: string, options: Options, body?: SuiteBody): void;

    /// Register skipped suites.
    readonly skip: TestSuite;

    /// Register focused suites.
    readonly only: TestSuite;

    /// Register pending suites.
    readonly todo: TestSuite;

    /// Register suites whose cases may run concurrently.
    readonly concurrent: TestSuite;

    /// Register suites whose direct children run in shuffled order.
    readonly shuffle: TestSuite;

    /// Register suites when `condition` holds.
    runIf(condition: boolean): TestSuite;

    /// Register skipped suites when `condition` holds.
    skipIf(condition: boolean): TestSuite;

    /// Register one suite for each parameter tuple.
    each<P: (...unknown[],)>(values: Iterable<P>): ParameterizedSuite<P>;

    /// Register one suite for each value without spreading arrays.
    for<T>(values: Iterable<T>): TableSuite<T>;
}

/// Suite registration over one parameter tuple.
@languageItem("test.ParameterizedSuite")
export newtype interface ParameterizedSuite<P: (...unknown[],)> {
    /// Register one parameterized suite.
    (name: string, body?: Function<P, void>): void;

    /// Register one configured parameterized suite.
    (name: string, options: Options, body?: Function<P, void>): void;

    /// Register skipped parameterized suites.
    readonly skip: ParameterizedSuite<P>;

    /// Register focused parameterized suites.
    readonly only: ParameterizedSuite<P>;

    /// Register pending parameterized suites.
    readonly todo: ParameterizedSuite<P>;

    /// Register parameterized suites whose cases may run concurrently.
    readonly concurrent: ParameterizedSuite<P>;

    /// Register parameterized suites whose direct children run in shuffled order.
    readonly shuffle: ParameterizedSuite<P>;
}

/// Suite registration over one unspread table value.
@languageItem("test.TableSuite")
export newtype interface TableSuite<T> {
    /// Register one table suite.
    (name: string, body?: (value: T) => void): void;

    /// Register one configured table suite.
    (name: string, options: Options, body?: (value: T) => void): void;

    /// Register skipped table suites.
    readonly skip: TableSuite<T>;

    /// Register focused table suites.
    readonly only: TableSuite<T>;

    /// Register pending table suites.
    readonly todo: TableSuite<T>;

    /// Register table suites whose cases may run concurrently.
    readonly concurrent: TableSuite<T>;

    /// Register table suites whose direct children run in shuffled order.
    readonly shuffle: TableSuite<T>;
}

/// Registered test suite.
@languageItem("test.Suite")
export struct Suite {
    /// Stable suite identifier.
    id: SuiteId;

    /// Suite name.
    name: string;

    /// Suite options.
    options: Options;
}

/// Create one suite registration function.
function createSuite(): TestSuite {
    todo("test.createSuite")
}
