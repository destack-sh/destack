import { IpcEventBinding } from "./event.ds";
import { IpcFutexBinding } from "./futex.ds";
import { IpcMemoryBinding } from "./memory.ds";
import { IpcMessageBinding } from "./message.ds";
import { IpcPipeBinding } from "./pipe.ds";
import { IpcSemaphoreBinding } from "./semaphore.ds";
import { IpcUnixBinding } from "./unix.ds";

/// IPC binding family.
@languageItem("ipc.IpcBinding")
export interface IpcBinding {
    /// Event bindings.
    readonly event: IpcEventBinding;
    /// Futex bindings.
    readonly futex: IpcFutexBinding;
    /// Memory bindings.
    readonly memory: IpcMemoryBinding;
    /// Message bindings.
    readonly message: IpcMessageBinding;
    /// Pipe bindings.
    readonly pipe: IpcPipeBinding;
    /// Semaphore bindings.
    readonly semaphore: IpcSemaphoreBinding;
    /// Unix socket bindings.
    readonly unix: IpcUnixBinding;
}
