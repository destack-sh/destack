import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for an IPC event counter.
export newtype EventCounterHandle = ResourceId;

/// Event counter creation flags.
export newtype EventCounterFlags = uint32;

/// Create the event counter in nonblocking mode.
export const EVENT_COUNTER_NONBLOCK: EventCounterFlags = EventCounterFlags(0x1);

/// Create the event counter as close-on-exec.
export const EVENT_COUNTER_CLOEXEC: EventCounterFlags = EventCounterFlags(0x2);

/// Event binding family.
export interface IpcEventBinding {
    /// Create one Linux event counter.
    @binding("destack.ipc.eventCounter.create", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.eventCounter"],
        platforms: ["linux"],
    })
    createEventCounter(
        initial: uint64,
        flags: EventCounterFlags,
    ): Result<EventCounterHandle, HostError>;

    /// Close one event counter handle.
    @binding("destack.ipc.eventCounter.close", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.eventCounter"],
        platforms: ["linux"],
    })
    closeEventCounter(event: EventCounterHandle): Result<void, HostError>;

    /// Read one event counter value.
    @binding("destack.ipc.eventCounter.read", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.eventCounter"],
        platforms: ["linux"],
    })
    readEventCounter(event: EventCounterHandle): Result<uint64, HostError>;

    /// Add one value to an event counter.
    @binding("destack.ipc.eventCounter.write", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.eventCounter"],
        platforms: ["linux"],
    })
    writeEventCounter(event: EventCounterHandle, value: uint64): Result<void, HostError>;
}
