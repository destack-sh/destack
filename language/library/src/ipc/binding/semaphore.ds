import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for an IPC semaphore.
export newtype SemaphoreHandle = ResourceId;

/// Semaphore creation flags.
export newtype SemaphoreFlags = uint32;

/// Create the semaphore only when it does not already exist.
export const SEMAPHORE_CREATE_EXCLUSIVE: SemaphoreFlags = SemaphoreFlags(0x1);

/// Semaphore creation options.
export struct SemaphoreOptions {
    /// Initial semaphore count.
    initial: uint32;
    /// Maximum semaphore count where the host requires it.
    maximum?: uint32;
    /// Creation flags.
    flags: SemaphoreFlags;
}

/// Semaphore binding family.
export interface IpcSemaphoreBinding {
    /// Create one named semaphore.
    @binding("destack.ipc.semaphore.create", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["windows", "unix"],
    })
    createSemaphore(
        name: &readonly string,
        options: SemaphoreOptions,
    ): Result<SemaphoreHandle, HostError>;

    /// Open one named semaphore.
    @binding("destack.ipc.semaphore.open", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["windows", "unix"],
    })
    openSemaphore(
        name: &readonly string,
        flags: SemaphoreFlags,
    ): Result<SemaphoreHandle, HostError>;

    /// Close one semaphore handle.
    @binding("destack.ipc.semaphore.close", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["windows", "unix"],
    })
    closeSemaphore(semaphore: SemaphoreHandle): Result<void, HostError>;

    /// Remove one named semaphore.
    @binding("destack.ipc.semaphore.remove", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["unix"],
    })
    removeSemaphore(name: &readonly string): Result<void, HostError>;

    /// Wait for one semaphore count.
    @binding("destack.ipc.semaphore.wait", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["windows", "unix"],
    })
    waitSemaphore(semaphore: SemaphoreHandle, timeoutNanoseconds?: uint64): Result<void, HostError>;

    /// Increment one semaphore count.
    @binding("destack.ipc.semaphore.post", {
        provider: "host",
        effect: "external",
        requires: ["host.ipc.semaphore"],
        families: ["windows", "unix"],
    })
    postSemaphore(semaphore: SemaphoreHandle, count: uint32): Result<void, HostError>;
}
