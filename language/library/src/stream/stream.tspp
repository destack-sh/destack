import { Task } from "tspp:async";
import { IteratorResult } from "tspp:iter";

/// Protocol for asynchronously transferring values to one consumer.
@languageItem("stream.Stream")
export newtype interface Stream<T> {
    /// The completion value produced when the stream ends.
    type Return = void;

    /// Advance and transfer the next yield or completion.
    next(&this): Task<IteratorResult<T, this.Return>>;
}
