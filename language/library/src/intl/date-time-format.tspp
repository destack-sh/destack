import { HostError, RangeError, Result, todo } from "tspp:error";

import { Instant } from "../time/instant.tspp";
import { PlainDateTime } from "../time/plain-date-time.tspp";
import { PlainDate } from "../time/plain-date.tspp";
import { PlainMonthDay } from "../time/plain-month-day.tspp";
import { PlainTime } from "../time/plain-time.tspp";
import { PlainYearMonth } from "../time/plain-year-month.tspp";
import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.tspp";
import { IntlError } from "./error.tspp";
import { HourCycle } from "./locale.tspp";

/// A date-time text width.
export type DateTimeTextStyle = "long" | "short" | "narrow";

/// A numeric date-time field width.
export type DateTimeNumericStyle = "numeric" | "2-digit";

/// A month field width.
export type MonthStyle = DateTimeNumericStyle | DateTimeTextStyle;

/// A time-zone name width.
export type TimeZoneNameStyle =
    | "short"
    | "long"
    | "shortOffset"
    | "longOffset"
    | "shortGeneric"
    | "longGeneric";

/// A complete date or time formatting width.
export type DateTimeStyle = "full" | "long" | "medium" | "short";

/// A date-time format selection algorithm.
export type FormatMatcher = "basic" | "best fit";

/// Options for creating a date-time formatter.
export interface DateTimeFormatOptions {
    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// The calendar identifier.
    calendar?: string;

    /// The numbering system identifier.
    numberingSystem?: string;

    /// The time-zone identifier.
    timeZone?: string;

    /// The weekday width.
    weekday?: DateTimeTextStyle;

    /// The era width.
    era?: DateTimeTextStyle;

    /// The year width.
    year?: DateTimeNumericStyle;

    /// The month width.
    month?: MonthStyle;

    /// The day width.
    day?: DateTimeNumericStyle;

    /// The day-period width.
    dayPeriod?: DateTimeTextStyle;

    /// The hour width.
    hour?: DateTimeNumericStyle;

    /// The minute width.
    minute?: DateTimeNumericStyle;

    /// The second width.
    second?: DateTimeNumericStyle;

    /// The fractional second digit count.
    fractionalSecondDigits?: 1 | 2 | 3;

    /// The time-zone name width.
    timeZoneName?: TimeZoneNameStyle;

    /// The complete date width.
    dateStyle?: DateTimeStyle;

    /// The complete time width.
    timeStyle?: DateTimeStyle;

    /// The format selection algorithm.
    formatMatcher?: FormatMatcher;

    /// Whether to use a 12-hour clock.
    hour12?: boolean;

    /// The hour cycle.
    hourCycle?: HourCycle;
}

/// The resolved date-time formatter options.
export struct ResolvedDateTimeFormatOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// The resolved calendar identifier.
    calendar: string;

    /// The resolved numbering system identifier.
    numberingSystem: string;

    /// The resolved time-zone identifier.
    timeZone: string;

    /// Whether the formatter uses a 12-hour clock.
    hour12?: boolean;

    /// The resolved hour cycle.
    hourCycle?: HourCycle;

    /// The weekday width.
    weekday?: DateTimeTextStyle;

    /// The era width.
    era?: DateTimeTextStyle;

    /// The year width.
    year?: DateTimeNumericStyle;

    /// The month width.
    month?: MonthStyle;

    /// The day width.
    day?: DateTimeNumericStyle;

    /// The day-period width.
    dayPeriod?: DateTimeTextStyle;

    /// The hour width.
    hour?: DateTimeNumericStyle;

    /// The minute width.
    minute?: DateTimeNumericStyle;

    /// The second width.
    second?: DateTimeNumericStyle;

    /// The fractional second digit count.
    fractionalSecondDigits?: 1 | 2 | 3;

    /// The time-zone name width.
    timeZoneName?: TimeZoneNameStyle;

    /// The complete date width.
    dateStyle?: DateTimeStyle;

    /// The complete time width.
    timeStyle?: DateTimeStyle;
}

/// A validated Temporal value accepted by date-time formatters.
export type TemporalDateTimeFormatValue =
    | PlainDate
    | PlainYearMonth
    | PlainMonthDay
    | PlainTime
    | PlainDateTime
    | Instant;

/// A value accepted by date-time formatters.
export type DateTimeFormatValue = number | TemporalDateTimeFormatValue;

/// A date-time format part category.
export type DateTimeFormatPartType =
    | "day"
    | "dayPeriod"
    | "era"
    | "fractionalSecond"
    | "hour"
    | "literal"
    | "minute"
    | "month"
    | "relatedYear"
    | "second"
    | "timeZoneName"
    | "weekday"
    | "year"
    | "yearName"
    | "unknown";

/// One formatted date-time part.
export struct DateTimeFormatPart {
    /// The part category.
    type: DateTimeFormatPartType;

    /// The formatted text.
    value: string;
}

/// One formatted date-time range part.
export struct DateTimeRangeFormatPart {
    /// The part category.
    type: DateTimeFormatPartType;

    /// The formatted text.
    value: string;

    /// The range value that produced this part.
    source: "startRange" | "endRange" | "shared";
}

/// A locale-sensitive date-time formatter.
@languageItem("intl.DateTimeFormat")
export class DateTimeFormat {
    /// Create a date-time formatter for the default locale.
    static create(): DateTimeFormat {
        todo("DateTimeFormat.createDefault")
    }

    /// Create a date-time formatter.
    static create(
        locales?: &readonly Locales,
        options?: &readonly DateTimeFormatOptions,
    ): Result<DateTimeFormat, IntlError> {
        todo("DateTimeFormat.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: &readonly Locales,
        options?: &readonly SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("DateTimeFormat.supportedLocalesOf")
    }

    /// Construct a validated date-time formatter internally.
    private constructor() {
        todo("DateTimeFormat.constructor");
    }

    /// Format a validated Temporal value.
    format(
        &readonly this,
        value: &readonly TemporalDateTimeFormatValue,
    ): Result<string, IntlError> {
        todo("DateTimeFormat.formatTemporal")
    }

    /// Format the current time.
    format(&readonly this): Result<string, HostError> {
        todo("DateTimeFormat.formatCurrent")
    }

    /// Format an epoch millisecond value.
    format(&readonly this, value: number): Result<string, RangeError> {
        todo("DateTimeFormat.format")
    }

    /// Format a validated Temporal value into separate parts.
    formatToParts(
        &readonly this,
        value: &readonly TemporalDateTimeFormatValue,
    ): Result<^DateTimeFormatPart[], IntlError> {
        todo("DateTimeFormat.formatTemporalToParts")
    }

    /// Format the current time into separate parts.
    formatToParts(&readonly this): Result<^DateTimeFormatPart[], HostError> {
        todo("DateTimeFormat.formatCurrentToParts")
    }

    /// Format an epoch millisecond value into separate parts.
    formatToParts(&readonly this, value: number): Result<^DateTimeFormatPart[], RangeError> {
        todo("DateTimeFormat.formatToParts")
    }

    /// Format a date-time range.
    formatRange(
        &readonly this,
        start: &readonly DateTimeFormatValue,
        end: &readonly DateTimeFormatValue,
    ): Result<string, IntlError> {
        todo("DateTimeFormat.formatRange")
    }

    /// Format a date-time range into separate parts.
    formatRangeToParts(
        &readonly this,
        start: &readonly DateTimeFormatValue,
        end: &readonly DateTimeFormatValue,
    ): Result<^DateTimeRangeFormatPart[], IntlError> {
        todo("DateTimeFormat.formatRangeToParts")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedDateTimeFormatOptions {
        todo("DateTimeFormat.resolvedOptions")
    }
}
