import { Result, todo } from "tspp:error";
import { Iterable } from "tspp:iter";

import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.tspp";
import { IntlError } from "./error.tspp";

/// A list conjunction style.
export type ListFormatType = "conjunction" | "disjunction" | "unit";

/// A list width.
export type ListFormatStyle = "long" | "short" | "narrow";

/// Options for creating a list formatter.
export interface ListFormatOptions {
    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// The list conjunction style.
    type?: ListFormatType;

    /// The list width.
    style?: ListFormatStyle;
}

/// The resolved list formatter options.
export struct ResolvedListFormatOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// The list conjunction style.
    type: ListFormatType;

    /// The list width.
    style: ListFormatStyle;
}

/// One formatted list part.
export struct ListFormatPart {
    /// The part category.
    type: "element" | "literal";

    /// The formatted text.
    value: string;
}

/// A locale-sensitive list formatter.
@languageItem("intl.ListFormat")
export class ListFormat {
    /// Create a list formatter for the default locale.
    static create(): ListFormat {
        todo("ListFormat.createDefault")
    }

    /// Create a list formatter.
    static create(
        locales?: &readonly Locales,
        options?: &readonly ListFormatOptions,
    ): Result<ListFormat, IntlError> {
        todo("ListFormat.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: &readonly Locales,
        options?: &readonly SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("ListFormat.supportedLocalesOf")
    }

    /// Construct a validated list formatter internally.
    private constructor() {
        todo("ListFormat.constructor");
    }

    /// Format a list of strings.
    format(&readonly this, list: Iterable<string>): ^string {
        todo("ListFormat.format")
    }

    /// Format a list into separate parts.
    formatToParts(&readonly this, list: Iterable<string>): ^ListFormatPart[] {
        todo("ListFormat.formatToParts")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedListFormatOptions {
        todo("ListFormat.resolvedOptions")
    }
}
