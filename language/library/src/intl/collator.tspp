import { Result, todo } from "tspp:error";
import { Ordering } from "tspp:ops";

import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.tspp";
import { IntlError } from "./error.tspp";
import { CaseFirst } from "./locale.tspp";

/// A collation use.
export type CollatorUsage = "sort" | "search";

/// A collation sensitivity.
export type CollatorSensitivity = "base" | "accent" | "case" | "variant";

/// Options for creating a collator.
export interface CollatorOptions {
    /// Whether the collator sorts or searches.
    usage?: CollatorUsage;

    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// The collation identifier.
    collation?: string;

    /// Whether collation treats numeric text as numbers.
    numeric?: boolean;

    /// The collation case ordering.
    caseFirst?: CaseFirst;

    /// The collation sensitivity.
    sensitivity?: CollatorSensitivity;

    /// Whether collation ignores punctuation.
    ignorePunctuation?: boolean;
}

/// The resolved collator options.
export struct ResolvedCollatorOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// Whether the collator sorts or searches.
    usage: CollatorUsage;

    /// The collation sensitivity.
    sensitivity: CollatorSensitivity;

    /// Whether collation ignores punctuation.
    ignorePunctuation: boolean;

    /// The resolved collation identifier.
    collation: string;

    /// Whether collation treats numeric text as numbers.
    numeric: boolean;

    /// The collation case ordering.
    caseFirst: CaseFirst;
}

/// A locale-sensitive string collator.
@languageItem("intl.Collator")
export class Collator {
    /// Create a collator for the default locale.
    static create(): Collator {
        todo("Collator.createDefault")
    }

    /// Create a collator.
    static create(
        locales?: &readonly Locales,
        options?: &readonly CollatorOptions,
    ): Result<Collator, IntlError> {
        todo("Collator.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: &readonly Locales,
        options?: &readonly SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("Collator.supportedLocalesOf")
    }

    /// Construct a validated collator internally.
    private constructor() {
        todo("Collator.constructor");
    }

    /// Compare two strings using this collation.
    compare(&immutable this, left: &immutable string, right: &immutable string): Ordering {
        todo("Collator.compare")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedCollatorOptions {
        todo("Collator.resolvedOptions")
    }
}
