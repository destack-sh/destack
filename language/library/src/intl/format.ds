import { Result } from "destack:error";
import { MaybeOwned } from "destack:memory";

import { Locales } from "./common.ds";
import { IntlError } from "./error.ds";

/// Value with a locale-sensitive string representation.
@languageItem("intl.ToLocaleString")
export newtype interface ToLocaleString {
    /// Return a string using the default locale.
    toLocaleString(&readonly this): MaybeOwned<string>;

    /// Return a string using `locales`.
    toLocaleString(&readonly this, locales: Locales): Result<MaybeOwned<string>, IntlError>;
}
