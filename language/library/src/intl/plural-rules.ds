import { Result, todo } from "destack:error";

import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.ds";
import { IntlError } from "./error.ds";
import {
    CompactDisplay,
    DigitOptions,
    NumberNotation,
    RoundingIncrement,
    RoundingMode,
    RoundingOptions,
    TrailingZeroDisplay,
} from "./number-format.ds";

/// A Unicode plural category.
export type PluralCategory = "zero" | "one" | "two" | "few" | "many" | "other";

/// A plural rule kind.
export type PluralRuleType = "cardinal" | "ordinal";

/// Options for creating plural rules.
export interface PluralRulesOptions extends DigitOptions, RoundingOptions {
    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// The plural rule kind.
    type?: PluralRuleType;

    /// The number notation.
    notation?: NumberNotation;

    /// The compact notation width.
    compactDisplay?: CompactDisplay;
}

/// The resolved plural rule options.
export struct ResolvedPluralRulesOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// The plural categories used by the locale.
    pluralCategories: ^PluralCategory[];

    /// The plural rule kind.
    type: PluralRuleType;

    /// The number notation.
    notation: NumberNotation;

    /// The compact notation width.
    compactDisplay?: CompactDisplay;

    /// The minimum integer digit count.
    minimumIntegerDigits: number;

    /// The minimum fraction digit count.
    minimumFractionDigits?: number;

    /// The maximum fraction digit count.
    maximumFractionDigits?: number;

    /// The minimum significant digit count.
    minimumSignificantDigits?: number;

    /// The maximum significant digit count.
    maximumSignificantDigits?: number;

    /// The rounding priority.
    roundingPriority: "auto" | "morePrecision" | "lessPrecision";

    /// The rounding mode.
    roundingMode: RoundingMode;

    /// The rounding increment.
    roundingIncrement: RoundingIncrement;

    /// The trailing-zero display mode.
    trailingZeroDisplay: TrailingZeroDisplay;
}

/// Locale-sensitive plural selection rules.
@languageItem("intl.PluralRules")
export class PluralRules {
    /// Create plural selection rules for the default locale.
    static create(): PluralRules {
        todo("PluralRules.createDefault")
    }

    /// Create plural selection rules.
    static create(
        locales?: &readonly Locales,
        options?: &readonly PluralRulesOptions,
    ): Result<PluralRules, IntlError> {
        todo("PluralRules.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: &readonly Locales,
        options?: &readonly SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("PluralRules.supportedLocalesOf")
    }

    /// Construct validated plural rules internally.
    private constructor() {
        todo("PluralRules.constructor");
    }

    /// Select the plural category for `value`.
    select(&readonly this, value: number): PluralCategory {
        todo("PluralRules.select")
    }

    /// Select the plural category for a range.
    selectRange(&readonly this, start: number, end: number): Result<PluralCategory, IntlError> {
        todo("PluralRules.selectRange")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedPluralRulesOptions {
        todo("PluralRules.resolvedOptions")
    }
}
