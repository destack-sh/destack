import { Result, todo } from "destack:error";

import { IntlError } from "./error.ds";

/// A Unicode hour cycle identifier.
export type HourCycle = "h11" | "h12" | "h23" | "h24";

/// A collation case ordering.
export type CaseFirst = "upper" | "lower" | "false";

/// An ISO calendar day of week from Monday at one through Sunday at seven.
export type Weekday = 1 | 2 | 3 | 4 | 5 | 6 | 7;

/// A Unicode first-day identifier.
export type FirstDayIdentifier = "sun" | "mon" | "tue" | "wed" | "thu" | "fri" | "sat";

/// A Unicode first-day identifier accepted by `Locale`.
export type FirstDayOfWeek = "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | FirstDayIdentifier;

/// Options for creating a locale.
export interface LocaleOptions {
    /// The primary language subtag.
    language?: string;

    /// The script subtag.
    script?: string;

    /// The region subtag.
    region?: string;

    /// The variant subtags separated by hyphens.
    variants?: string;

    /// The calendar identifier.
    calendar?: string;

    /// The collation identifier.
    collation?: string;

    /// The first day of the week.
    firstDayOfWeek?: FirstDayOfWeek;

    /// The hour cycle.
    hourCycle?: HourCycle;

    /// The collation case ordering.
    caseFirst?: CaseFirst;

    /// Whether collation treats numeric text as numbers.
    numeric?: boolean;

    /// The numbering system identifier.
    numberingSystem?: string;
}

/// Locale text layout information.
export struct TextInfo {
    /// The default text direction.
    direction: "ltr" | "rtl";
}

/// Locale calendar week information.
export struct WeekInfo {
    /// The first day of the week.
    firstDay: Weekday;

    /// The weekend days in ascending order.
    weekend: ^Weekday[];
}

/// A parsed and canonical Unicode locale identifier.
@languageItem("intl.Locale")
export class Locale {
    /// Create a locale.
    static create(
        tag: &readonly string | Locale,
        options?: &readonly LocaleOptions,
    ): Result<Locale, IntlError> {
        todo("Locale.create")
    }

    /// Construct a validated locale internally.
    private constructor() {
        todo("Locale.constructor");
    }

    /// The locale identifier without extensions.
    get baseName(&readonly this): ^string {
        todo("Locale.baseName")
    }

    /// The calendar override.
    get calendar(&readonly this): string | undefined {
        todo("Locale.calendar")
    }

    /// The collation case ordering override.
    get caseFirst(&readonly this): CaseFirst | undefined {
        todo("Locale.caseFirst")
    }

    /// The collation override.
    get collation(&readonly this): string | undefined {
        todo("Locale.collation")
    }

    /// The first-day override.
    get firstDayOfWeek(&readonly this): FirstDayIdentifier | undefined {
        todo("Locale.firstDayOfWeek")
    }

    /// The hour-cycle override.
    get hourCycle(&readonly this): HourCycle | undefined {
        todo("Locale.hourCycle")
    }

    /// The primary language subtag.
    get language(&readonly this): ^string {
        todo("Locale.language")
    }

    /// The numbering-system override.
    get numberingSystem(&readonly this): string | undefined {
        todo("Locale.numberingSystem")
    }

    /// The numeric-collation override.
    get numeric(&readonly this): boolean | undefined {
        todo("Locale.numeric")
    }

    /// The region subtag.
    get region(&readonly this): string | undefined {
        todo("Locale.region")
    }

    /// The script subtag.
    get script(&readonly this): string | undefined {
        todo("Locale.script")
    }

    /// The variant subtags separated by hyphens.
    get variants(&readonly this): string | undefined {
        todo("Locale.variants")
    }

    /// Add likely language, script, and region subtags.
    maximize(&readonly this): Locale {
        todo("Locale.maximize")
    }

    /// Remove language, script, and region subtags inferred by `maximize`.
    minimize(&readonly this): Locale {
        todo("Locale.minimize")
    }

    /// Return the preferred calendar identifiers.
    getCalendars(&readonly this): ^string[] {
        todo("Locale.getCalendars")
    }

    /// Return the preferred collation identifiers.
    getCollations(&readonly this): ^string[] {
        todo("Locale.getCollations")
    }

    /// Return the preferred hour cycles.
    getHourCycles(&readonly this): ^HourCycle[] {
        todo("Locale.getHourCycles")
    }

    /// Return the preferred numbering system identifiers.
    getNumberingSystems(&readonly this): ^string[] {
        todo("Locale.getNumberingSystems")
    }

    /// Return the time zones for the locale region.
    getTimeZones(&readonly this): ^string[] | undefined {
        todo("Locale.getTimeZones")
    }

    /// Return the default text layout information.
    getTextInfo(&readonly this): TextInfo {
        todo("Locale.getTextInfo")
    }

    /// Return the calendar week information.
    getWeekInfo(&readonly this): WeekInfo {
        todo("Locale.getWeekInfo")
    }

    /// Return the canonical locale identifier.
    toString(&readonly this): ^string {
        todo("Locale.toString")
    }
}
