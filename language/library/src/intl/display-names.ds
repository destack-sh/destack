import { Result, todo } from "destack:error";

import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.ds";
import { IntlError } from "./error.ds";

/// A display-name width.
export type DisplayNamesStyle = "long" | "short" | "narrow";

/// A display-name code category.
export type DisplayNamesType =
    | "language"
    | "region"
    | "script"
    | "currency"
    | "calendar"
    | "dateTimeField";

/// A missing display-name policy.
export type DisplayNamesFallback = "code" | "none";

/// A language display mode.
export type DisplayNamesLanguageDisplay = "dialect" | "standard";

/// Options for creating a display-name formatter.
export interface DisplayNamesOptions {
    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// The display-name width.
    style?: DisplayNamesStyle;

    /// The code category.
    type: DisplayNamesType;

    /// The missing-name policy.
    fallback?: DisplayNamesFallback;

    /// The language display mode.
    languageDisplay?: DisplayNamesLanguageDisplay;
}

/// The resolved display-name formatter options.
export struct ResolvedDisplayNamesOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// The display-name width.
    style: DisplayNamesStyle;

    /// The code category.
    type: DisplayNamesType;

    /// The missing-name policy.
    fallback: DisplayNamesFallback;

    /// The language display mode for language codes.
    languageDisplay?: DisplayNamesLanguageDisplay;
}

/// A locale-sensitive display-name formatter.
@languageItem("intl.DisplayNames")
export class DisplayNames {
    /// Create a display-name formatter.
    static create(locales: Locales, options: DisplayNamesOptions): Result<DisplayNames, IntlError> {
        todo("DisplayNames.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: Locales,
        options?: SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("DisplayNames.supportedLocalesOf")
    }

    /// Construct a validated display-name formatter internally.
    private constructor() {
        todo("DisplayNames.constructor");
    }

    /// Return the display name for `code`.
    of(&readonly this, code: &readonly string): Result<string | undefined, IntlError> {
        todo("DisplayNames.of")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedDisplayNamesOptions {
        todo("DisplayNames.resolvedOptions")
    }
}
