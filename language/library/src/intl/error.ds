import { Error, RangeError, TypeError } from "destack:error";
import { MaybeOwned } from "destack:memory";

/// Locale, formatting, collation, or segmentation failure.
@languageItem("intl.IntlError")
export newtype IntlError = RangeError | TypeError;

export extension of IntlError implements Error {
    /// Format this error for users.
    display(): MaybeOwned<string> {
        MaybeOwned.borrowed(this.message)
    }
}
