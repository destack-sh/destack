import { Result, todo } from "destack:error";

import { Exclude } from "destack:types";

import { LocaleIdentifier, LocaleMatcher, Locales, SupportedLocalesOptions } from "./common.ds";
import { IntlError } from "./error.ds";
import { NumberFormatPartType } from "./number-format.ds";

/// A relative-time unit.
export type RelativeTimeUnit =
    | "year"
    | "years"
    | "quarter"
    | "quarters"
    | "month"
    | "months"
    | "week"
    | "weeks"
    | "day"
    | "days"
    | "hour"
    | "hours"
    | "minute"
    | "minutes"
    | "second"
    | "seconds";

/// A singular relative-time unit.
export type RelativeTimeUnitSingular =
    | "year"
    | "quarter"
    | "month"
    | "week"
    | "day"
    | "hour"
    | "minute"
    | "second";

/// A relative-time word selection mode.
export type RelativeTimeNumeric = "always" | "auto";

/// A relative-time width.
export type RelativeTimeStyle = "long" | "short" | "narrow";

/// Options for creating a relative-time formatter.
export interface RelativeTimeFormatOptions {
    /// The locale selection algorithm.
    localeMatcher?: LocaleMatcher;

    /// Whether named relative times such as `yesterday` may be used.
    numeric?: RelativeTimeNumeric;

    /// The output width.
    style?: RelativeTimeStyle;
}

/// The resolved relative-time formatter options.
export struct ResolvedRelativeTimeFormatOptions {
    /// The resolved locale identifier.
    locale: LocaleIdentifier;

    /// The output width.
    style: RelativeTimeStyle;

    /// The relative-time word selection mode.
    numeric: RelativeTimeNumeric;

    /// The resolved numbering system identifier.
    numberingSystem: string;
}

/// One formatted relative-time part.
export newtype RelativeTimeFormatPart =
    | {
          /// The literal part category.
          type: "literal";

          /// The formatted text.
          value: string;
      }
    | {
          /// The numeric part category.
          type: Exclude<NumberFormatPartType, "literal">;

          /// The formatted text.
          value: string;

          /// The related unit.
          unit: RelativeTimeUnitSingular;
      };

/// A locale-sensitive relative-time formatter.
@languageItem("intl.RelativeTimeFormat")
export class RelativeTimeFormat {
    /// Create a relative-time formatter for the default locale.
    static create(): RelativeTimeFormat {
        todo("RelativeTimeFormat.createDefault")
    }

    /// Create a relative-time formatter.
    static create(
        locales?: Locales,
        options?: RelativeTimeFormatOptions,
    ): Result<RelativeTimeFormat, IntlError> {
        todo("RelativeTimeFormat.create")
    }

    /// Return the supported requested locales.
    static supportedLocalesOf(
        locales: Locales,
        options?: SupportedLocalesOptions,
    ): Result<^string[], IntlError> {
        todo("RelativeTimeFormat.supportedLocalesOf")
    }

    /// Construct a validated relative-time formatter internally.
    private constructor() {
        todo("RelativeTimeFormat.constructor");
    }

    /// Format a relative time.
    format(&readonly this, value: number, unit: RelativeTimeUnit): Result<string, IntlError> {
        todo("RelativeTimeFormat.format")
    }

    /// Format a relative time into separate parts.
    formatToParts(
        &readonly this,
        value: number,
        unit: RelativeTimeUnit,
    ): Result<^RelativeTimeFormatPart[], IntlError> {
        todo("RelativeTimeFormat.formatToParts")
    }

    /// Return the resolved options.
    resolvedOptions(&readonly this): ResolvedRelativeTimeFormatOptions {
        todo("RelativeTimeFormat.resolvedOptions")
    }
}
