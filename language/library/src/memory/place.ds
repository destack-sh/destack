/// Concrete memory space tag kind.
@languageItem("memory.Space")
export type Space = "local" | "shared" | "static" | "frame";

/// Placement tag kind for qualified storage.
@languageItem("memory.Place")
export type Place = "ambient" | Space;

/// Placement form for exactly `T`.
@languageItem("memory.Placed")
export newtype Placed<T, comptime P: Place> = intrinsic;
