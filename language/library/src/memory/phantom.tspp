import { Clone, Copy, Default } from "./capability.tspp";

/// Zero-sized marker for ownership, variance, and drop behavior.
@languageItem("memory.Phantom")
export newtype Phantom<out T> = intrinsic;

export extension<T> of Phantom<T> implements Clone, Copy, Default {
    /// Create a phantom marker.
    static new(): Phantom<T> {
        return newPhantom<T>();
    }

    /// Clone this phantom marker.
    clone(this: &immutable this): Phantom<T> {
        Phantom.new()
    }

    /// Create the default phantom marker.
    static default(): Phantom<T> {
        Phantom.new()
    }
}

/// Create one phantom marker.
@intrinsic("memory.phantom.new")
export declare function newPhantom<T>(): Phantom<T>;
