import { As, Borrow } from "destack:convert";
import { Result, todo } from "destack:error";
import { Dereference } from "destack:ops";

import { Access } from "./access.ds";
import { Borrowed } from "./borrow.ds";
import { Clone, Default, Unpin, Zeroable } from "./capability.ds";
import { AllocationError } from "./error.ds";
import { MaybeUninit } from "./init.ds";
import { Owned } from "./owned.ds";
import { Pin } from "./pin.ds";
import { Space } from "./place.ds";
import { Region } from "./region.ds";
import { WithAccess } from "./type.ds";

/// A uniquely owned heap allocation for an owned `T`.
@languageItem("memory.Box")
export newtype Box<T> = Unique<Owned<T>>;

/// Internal thin unique heap reference.
@languageItem("memory.Unique")
newtype Unique<out T> = intrinsic;

extension<T> of Unique<Owned<T>> {
    /// Leak this allocation and borrow it for static lifetime.
    leak(this): Borrowed<T, 'static> {
        leakUnique<T>(this)
    }
}

export extension<T, const A: Access = "readonly"> of Box<T> implements As<T, A>, Borrow<T, A> {
    /// Allocate `value` on the heap.
    static new(value: ^T): Box<T> {
        todo("Box.new")
    }

    /// Try to allocate `value` on the heap.
    static tryNew(value: ^T): Result<Box<T>, AllocationError> {
        todo("Box.tryNew")
    }

    /// Allocate uninitialized storage on the heap.
    static newUninit(): Box<MaybeUninit<T>> {
        todo("Box.newUninit")
    }

    /// Try to allocate uninitialized storage on the heap.
    static tryNewUninit(): Result<Box<MaybeUninit<T>>, AllocationError> {
        todo("Box.tryNewUninit")
    }

    /// Allocate zeroed storage on the heap.
    static newZeroed(): Box<MaybeUninit<T>> where T: Zeroable {
        todo("Box.newZeroed")
    }

    /// Try to allocate zeroed storage on the heap.
    static tryNewZeroed(): Result<Box<MaybeUninit<T>>, AllocationError> where T: Zeroable {
        todo("Box.tryNewZeroed")
    }

    /// Allocate and pin `value` on the heap.
    static pin(value: ^T): Pin<Box<T>> {
        todo("Box.pin")
    }

    /// Try to allocate and pin `value` on the heap.
    static tryPin(value: ^T): Result<Pin<Box<T>>, AllocationError> {
        todo("Box.tryPin")
    }

    /// Move the value out of this box.
    intoInner(this): ^T {
        todo("Box.intoInner")
    }

    /// Leak this box and borrow its allocation for static lifetime.
    leak(this): Borrowed<T, 'static> {
        (this as Unique<Owned<T>>).leak()
    }

    /// Return the raw pointer to the boxed value.
    asPointer(&this): *T {
        todo("Box.asPointer")
    }

    /// Borrow the boxed value with readonly access.
    asReference(&readonly this): &readonly T {
        todo("Box.asReference")
    }

    /// Borrow the boxed value with mutable access.
    asExclusive(&exclusive this): &exclusive T {
        todo("Box.asExclusive")
    }

    /// Borrow the boxed value.
    as<const R: Region>(this: Borrowed<Box<T>, R, A>): Borrowed<T, R, A> {
        this.dereference()
    }

    /// Borrow the boxed value.
    borrow<const R: Region>(this: Borrowed<Box<T>, R, A>): Borrowed<T, R, A> {
        this.dereference()
    }
}

export extension<T, const A: Access> of Box<T> implements Dereference<A> {
    /// The pointee type.
    type Target = T;

    /// Borrow the boxed value.
    dereference<const R: Region>(this: Borrowed<this, R, A>): Borrowed<this.Target, R, A> {
        todo("Box.dereference")
    }
}

@unsafe
export extension<T> of Box<T> implements Unpin {}

export extension<T> of Box<T> implements Clone where T: Clone {
    /// Clone the boxed value into a new box.
    clone(this: &immutable this): Box<T> {
        todo("Box.clone")
    }

    /// Clone `source` into this allocation.
    cloneFrom(&exclusive this, source: &immutable Box<T>): void {
        this.asExclusive().cloneFrom(source.dereference());
    }
}

export extension<T> of Box<T> implements Default where T: Default {
    /// Create a box with the default value.
    static default(): Box<T> {
        Box.new(T.default())
    }
}

/// Leak one unique allocation and borrow it for static lifetime.
@intrinsic("memory.unique.leak")
declare function leakUnique<T, const S: Space>(
    unique: Unique<Owned<T>>,
): Borrowed<T, 'static & S, "mutable">;
