import { Result, todo } from "destack:error";

import { MaybeUninit } from "../init.ds";
import { Space } from "../place.ds";
import { AllocationError } from "../error.ds";
import { Unique } from "../unique.ds";

/// Typed bump arena in space `S`.
export struct Bump<S: Space = "local"> {
    /// The reserved storage bytes.
    storage: Unique<[MaybeUninit<uint8>]>;

    /// The next free byte offset.
    offset: usize = 0;
}

export extension<S: Space = "local"> of Bump<S> {
    /// Create a bump arena over `storage`.
    static new(storage: Unique<[MaybeUninit<uint8>]>): Bump<S> {
        Bump {
            storage,
            offset: 0,
        }
    }

    /// Allocate `value` in this bump arena.
    alloc<T>(this: &exclusive Bump<S>, value: ^T): &exclusive T {
        todo("Bump.alloc")
    }

    /// Try to allocate `value` in this bump arena.
    tryAlloc<T>(this: &exclusive Bump<S>, value: ^T): Result<&exclusive T, AllocationError> {
        todo("Bump.tryAlloc")
    }

    /// Try to allocate uninitialized storage in this bump arena.
    tryAllocUninit<T>(
        this: &exclusive Bump<S>,
    ): Result<&exclusive MaybeUninit<T>, AllocationError> {
        todo("Bump.tryAllocUninit")
    }

    /// Release all bump allocations.
    reset(&exclusive this): void {
        todo("Bump.reset");
    }

    /// Return the allocated byte count.
    get used(): usize {
        this.offset
    }
}
