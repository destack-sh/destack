import { Result, todo } from "destack:error";

import { AllocationError } from "../error.ds";
import { MaybeUninit } from "../init.ds";
import { Space } from "../place.ds";

/// Typed bump arena in space `S`.
@languageItem("memory.arena.Bump")
export struct Bump<const S: Space = "local"> {
    /// The reserved storage bytes.
    storage: ^[MaybeUninit<uint8>];

    /// The next free byte offset.
    offset: usize = 0;
}

export extension<const S: Space = "local"> of Bump<S> {
    /// Create a bump arena over `storage`.
    static new(storage: ^[MaybeUninit<uint8>]): Bump<S> {
        Bump {
            storage,
            offset: 0,
        }
    }

    /// Allocate `value` in this bump arena.
    alloc<T>(this: &Bump<S>, value: ^T): &T {
        todo("Bump.alloc")
    }

    /// Try to allocate `value` in this bump arena.
    tryAlloc<T>(this: &Bump<S>, value: ^T): Result<&T, AllocationError> {
        todo("Bump.tryAlloc")
    }

    /// Try to allocate uninitialized storage in this bump arena.
    tryAllocUninit<T>(
        this: &Bump<S>,
    ): Result<&MaybeUninit<T>, AllocationError> {
        todo("Bump.tryAllocUninit")
    }

    /// Release all bump allocations.
    reset(&this): void {
        todo("Bump.reset");
    }

    /// Return the allocated byte count.
    get used(): usize {
        this.offset
    }
}
