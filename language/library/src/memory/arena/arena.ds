import { Result, todo } from "destack:error";

import { ReadonlyBorrowed } from "../borrow.ds";
import { AllocationError } from "../error.ds";
import { Lifetime } from "../lifetime.ds";
import { Space } from "../place.ds";
import { Bump } from "./bump.ds";

/// Typed arena for values with a shared lifetime.
@languageItem("memory.arena.Arena")
export struct Arena<in out T, const R: Lifetime, const S: Space = "local"> {
    /// The backing bump allocator.
    bump: Bump<S>;

    /// The number of allocated values.
    length: usize = 0;
}

export extension<T, const R: Lifetime, const S: Space = "local"> of Arena<T, R, S> {
    /// Create an arena backed by `bump`.
    static new(bump: Bump<S>): Arena<T, R, S> {
        Arena {
            bump,
            length: 0,
        }
    }

    /// Allocate `value` in this arena.
    alloc(&this, value: ^T): ReadonlyBorrowed<T, R & S> {
        todo("Arena.alloc")
    }

    /// Try to allocate `value` in this arena.
    tryAlloc(
        this: &Arena<T, R, S>,
        value: ^T,
    ): Result<ReadonlyBorrowed<T, R & S>, AllocationError> {
        todo("Arena.tryAlloc")
    }

    /// Return the number of allocated values.
    get size(): usize {
        this.length
    }

    /// Drop all values allocated in this arena.
    clear(&this): void {
        todo("Arena.clear");
    }
}
