import { Copy, Default } from "./capability.ds";

import { WithAccess } from "./type.ds";

/// Replace `destination` and return its previous value.
@intrinsic("memory.ptr.replace")
export declare function replace<T, const A: "mutable" | "exclusive">(
    destination: WithAccess<&T, A>,
    value: T,
): T where A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never);

/// Replace `destination` with its default value and return its previous value.
export function take<T: Default, const A: "mutable" | "exclusive">(
    destination: WithAccess<&T, A>,
): T where A: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never) {
    replace(destination, T.default())
}
