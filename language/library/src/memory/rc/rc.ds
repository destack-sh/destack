import { As, Borrow } from "destack:convert";
import { Result, todo } from "destack:error";
import { Access, Borrowed, Region } from "destack:memory";
import { Dereference } from "destack:ops";

import { Clone, Copy, Default, Unpin, Zeroable } from "../capability.ds";
import { Drop } from "../drop.ds";
import { AllocationError } from "../error.ds";
import { MaybeUninit } from "../init.ds";
import { Owned } from "../owned.ds";
import { Pin } from "../pin.ds";
import { Weak } from "./weak.ds";

/// Reference-counted heap block for one worker.
@languageItem("memory.rc.RcInner")
export struct RcInner<T> implements !SharedSafe {
    /// The strong reference count.
    private strong: usize;

    /// The weak reference count.
    private weak: usize;

    /// The stored value.
    private value: MaybeUninit<T>;
}

@unsafe
export extension<T> of Rc<T> implements Unpin {}

/// Local reference-counted ownership.
@languageItem("memory.rc.Rc")
export struct Rc<T> implements !SharedSafe {
    /// The reference-counted allocation.
    private inner: *RcInner<Owned<T>>;
}

export extension<T> of Rc<T> implements Clone, Dereference, As<T>, Borrow<T>, !Copy, Drop {
    /// The pointee type.
    type Target = T;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Allocate a new reference-counted value.
    static new(value: ^T): Rc<T> {
        todo("Rc.new")
    }

    /// Try to allocate a new reference-counted value.
    static tryNew(value: ^T): Result<Rc<T>, AllocationError> {
        todo("Rc.tryNew")
    }

    /// Allocate a new reference-counted value that can refer to its weak handle.
    static newCyclic(makeValue: (weak: Weak<T>) => ^T): Rc<T> {
        todo("Rc.newCyclic")
    }

    /// Allocate uninitialized storage.
    static newUninit(): Rc<MaybeUninit<T>> {
        todo("Rc.newUninit")
    }

    /// Try to allocate uninitialized storage.
    static tryNewUninit(): Result<Rc<MaybeUninit<T>>, AllocationError> {
        todo("Rc.tryNewUninit")
    }

    /// Allocate zeroed storage.
    static newZeroed(): Rc<MaybeUninit<T>> where T: Zeroable {
        todo("Rc.newZeroed")
    }

    /// Try to allocate zeroed storage.
    static tryNewZeroed(): Result<Rc<MaybeUninit<T>>, AllocationError> where T: Zeroable {
        todo("Rc.tryNewZeroed")
    }

    /// Create a reference-counted handle from a raw value pointer.
    @unsafe
    static fromRaw(pointer: *T): Rc<T> {
        todo("Rc.fromRaw")
    }

    /// Allocate a new pinned reference-counted value.
    static pin(value: ^T): Pin<Rc<T>> {
        todo("Rc.pin")
    }

    /// Try to allocate a new pinned reference-counted value.
    static tryPin(value: ^T): Result<Pin<Rc<T>>, AllocationError> {
        todo("Rc.tryPin")
    }

    /// Release this strong count and reclaim the payload when no strong handles remain.
    drop(&exclusive this): void {
        todo("Rc.drop");
    }

    /// Clone this strong handle.
    clone(this: &immutable this): ^this {
        todo("Rc.clone")
    }

    /// Create a weak handle to the same block.
    downgrade(&readonly this): Weak<T> {
        todo("Rc.downgrade")
    }

    /// Return whether this handle is the only strong handle.
    isUnique(&readonly this): boolean {
        todo("Rc.isUnique")
    }

    /// Return whether this handle points to the same allocation as `other`.
    pointerEquals(&readonly this, other: &readonly Rc<T>): boolean {
        todo("Rc.pointerEquals")
    }

    /// Return the count of strong handles, including handles retained by borrows.
    strongCount(&readonly this): usize {
        todo("Rc.strongCount")
    }

    /// Return the count of explicit weak handles, including handles retained by borrows.
    weakCount(&readonly this): usize {
        todo("Rc.weakCount")
    }

    /// Move the value out when this is the only strong handle.
    intoInner(this): ^T | undefined {
        todo("Rc.intoInner")
    }

    /// Move the value out when this is the only strong handle.
    tryUnwrap(this): Result<^T, Rc<T>> {
        todo("Rc.tryUnwrap")
    }

    /// Move the value out or clone it when shared.
    unwrapOrClone(this): ^T where ^T: Clone {
        todo("Rc.unwrapOrClone")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(&readonly this): *T {
        todo("Rc.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this): *T {
        todo("Rc.intoRaw")
    }

    /// Borrow the value exclusively when no other strong or weak handle exists.
    getExclusive(&exclusive this): &exclusive T | undefined {
        todo("Rc.getExclusive")
    }

    /// Borrow the value exclusively, cloning or detaching weak handles when needed.
    makeExclusive(&exclusive this): &exclusive T where ^T: Clone {
        todo("Rc.makeExclusive")
    }

    /// Borrow the referenced value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("Rc.dereference")
    }

    /// Borrow the referenced value.
    as(&readonly this): &readonly T {
        this.dereference()
    }

    /// Borrow the referenced value.
    borrow(&readonly this): &readonly T {
        this.dereference()
    }
}

export extension<T> of Rc<T> implements Default where T: Default {
    /// Create a reference-counted handle with the default value.
    static default(): Rc<T> {
        Rc.new(T.default())
    }
}
