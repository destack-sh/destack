import { ImmutableOf } from "./type.ds";

/// Mark a type as having a complete storage representation.
@languageItem("memory.Concrete")
export newtype interface Concrete {}

/// Mark a type as safe for runtime erasure.
@languageItem("memory.DynamicSafe")
export newtype interface DynamicSafe {}

/// Mark a type as safe to store in shared space.
@languageItem("memory.SharedSafe")
export newtype interface SharedSafe {}

/// Mark a type as explicitly cloneable.
@languageItem("memory.Clone")
export newtype interface Clone {
    /// Clone this value.
    clone(this: ImmutableOf<this>): ^this;

    /// Replace this value with a clone of `source`.
    cloneFrom(&exclusive this, source: ImmutableOf<this>): void {
        *this = source.clone();
    }
}

/// Mark a type as implicitly duplicable without ownership transfer.
@languageItem("memory.Copy")
export newtype interface Copy {}

/// Mark a type as safe to move out of pinned storage.
@languageItem("memory.Unpin")
export newtype interface Unpin {}

/// Mark a type as valid when all bytes are zero.
@languageItem("memory.Zeroable")
export newtype interface Zeroable {}

/// Mark a type as having a conventional default value.
@languageItem("memory.Default")
export newtype interface Default {
    /// Create the default value.
    static default(): ^this;
}
