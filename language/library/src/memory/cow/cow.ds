import { todo } from "destack:error";

import { Clone } from "../capability.ds";

/// Borrowed copy-on-write value.
export struct CowBorrowed<T> {
    /// The copy-on-write discriminator.
    kind: "borrowed";

    /// The borrowed value.
    value: T;
}

/// Owned copy-on-write value.
export struct CowOwned<T> {
    /// The copy-on-write discriminator.
    kind: "owned";

    /// The owned value.
    value: T;
}

/// Copy-on-write value.
@derive(Tagged)
export newtype Cow<T> = CowBorrowed<&readonly T> | CowOwned<^T>;

/// Readonly borrowed or owned value.
export type MaybeOwned<T> = Cow<T>;

export extension<T> of Cow<T> {
    /// Create a borrowed copy-on-write value.
    static borrowed(value: &readonly T): Cow<T> {
        todo("Cow.borrowed")
    }

    /// Create an owned copy-on-write value.
    static owned(value: ^T): Cow<T> {
        todo("Cow.owned")
    }

    /// Return whether this value is borrowed.
    isBorrowed(): boolean {
        todo("Cow.isBorrowed")
    }

    /// Return whether this value is owned.
    isOwned(): boolean {
        todo("Cow.isOwned")
    }

    /// Borrow the value.
    borrow(): &readonly T {
        todo("Cow.borrow")
    }

    /// Borrow owned storage, cloning first if needed.
    toExclusive(&exclusive this): &exclusive T where T: Clone {
        todo("Cow.toExclusive")
    }

    /// Move or clone this value into owned storage.
    intoOwned(this): ^T where T: Clone {
        todo("Cow.intoOwned")
    }
}
