import { As, Borrow } from "tspp:convert";
import { Result, todo } from "tspp:error";
import { Access, Borrowed, Region } from "tspp:memory";
import { Dereference } from "tspp:ops";
import { Atomic } from "tspp:sync";

import { Clone, Copy, Default, Unpin, Zeroable } from "../capability.tspp";
import { Drop } from "../drop.tspp";
import { AllocationError } from "../error.tspp";
import { MaybeUninit } from "../init.tspp";
import { Owned } from "../owned.tspp";
import { Pin } from "../pin.tspp";
import { Weak } from "./weak.tspp";

/// Reference-counted heap block for shared storage.
@languageItem("memory.arc.ArcInner")
export shared struct ArcInner<T> {
    /// The strong reference count.
    private strong: Atomic<usize>;

    /// The weak reference count.
    private weak: Atomic<usize>;

    /// The stored value.
    private value: MaybeUninit<T>;
}

@unsafe
export extension<T> of Arc<T> implements Unpin {}

/// Shared reference-counted ownership.
@languageItem("memory.arc.Arc")
export struct Arc<T> {
    /// The reference-counted allocation.
    private inner: *ArcInner<Owned<T>>;
}

export extension<T> of Arc<T> implements Clone, Dereference, As<T>, Borrow<T>, !Copy, Drop {
    /// The pointee type.
    type Target = T;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Allocate a new shared reference-counted value.
    static new(value: ^T): Arc<T> {
        todo("Arc.new")
    }

    /// Try to allocate a new shared reference-counted value.
    static tryNew(value: ^T): Result<Arc<T>, AllocationError> {
        todo("Arc.tryNew")
    }

    /// Allocate a new shared reference-counted value that can refer to its weak handle.
    static newCyclic(makeValue: (weak: Weak<T>) => ^T): Arc<T> {
        todo("Arc.newCyclic")
    }

    /// Allocate uninitialized storage.
    static newUninit(): Arc<MaybeUninit<T>> {
        todo("Arc.newUninit")
    }

    /// Try to allocate uninitialized storage.
    static tryNewUninit(): Result<Arc<MaybeUninit<T>>, AllocationError> {
        todo("Arc.tryNewUninit")
    }

    /// Allocate zeroed storage.
    static newZeroed(): Arc<MaybeUninit<T>> where T: Zeroable {
        todo("Arc.newZeroed")
    }

    /// Try to allocate zeroed storage.
    static tryNewZeroed(): Result<Arc<MaybeUninit<T>>, AllocationError> where T: Zeroable {
        todo("Arc.tryNewZeroed")
    }

    /// Create a shared reference-counted handle from a raw value pointer.
    @unsafe
    static fromRaw(pointer: *T): Arc<T> {
        todo("Arc.fromRaw")
    }

    /// Allocate a new pinned shared reference-counted value.
    static pin(value: ^T): Pin<Arc<T>> {
        todo("Arc.pin")
    }

    /// Try to allocate a new pinned shared reference-counted value.
    static tryPin(value: ^T): Result<Pin<Arc<T>>, AllocationError> {
        todo("Arc.tryPin")
    }

    /// Release this strong count and reclaim the payload when no strong handles remain.
    drop(&exclusive this): void {
        todo("Arc.drop");
    }

    /// Clone this strong handle.
    clone(this: &immutable this): ^this {
        todo("Arc.clone")
    }

    /// Create a weak handle to the same block.
    downgrade(&readonly this): Weak<T> {
        todo("Arc.downgrade")
    }

    /// Return whether this handle is the only strong handle.
    isUnique(&readonly this): boolean {
        todo("Arc.isUnique")
    }

    /// Return whether this handle points to the same allocation as `other`.
    pointerEquals(&readonly this, other: &readonly Arc<T>): boolean {
        todo("Arc.pointerEquals")
    }

    /// Return the count of strong handles, including handles retained by borrows.
    strongCount(&readonly this): usize {
        todo("Arc.strongCount")
    }

    /// Return the count of explicit weak handles, including handles retained by borrows.
    weakCount(&readonly this): usize {
        todo("Arc.weakCount")
    }

    /// Move the value out when this is the only strong handle.
    intoInner(this): ^T | undefined {
        todo("Arc.intoInner")
    }

    /// Move the value out when this is the only strong handle.
    tryUnwrap(this): Result<^T, Arc<T>> {
        todo("Arc.tryUnwrap")
    }

    /// Move the value out or clone it when shared.
    unwrapOrClone(this): ^T where ^T: Clone {
        todo("Arc.unwrapOrClone")
    }

    /// Return the raw pointer to the referenced value.
    asPointer(&readonly this): *T {
        todo("Arc.asPointer")
    }

    /// Move this handle into a raw value pointer.
    intoRaw(this): *T {
        todo("Arc.intoRaw")
    }

    /// Borrow the value exclusively when no other strong or weak handle exists.
    getExclusive(&exclusive this): &exclusive T | undefined {
        todo("Arc.getExclusive")
    }

    /// Borrow the value exclusively, cloning or detaching weak handles when needed.
    makeExclusive(&exclusive this): &exclusive T where ^T: Clone {
        todo("Arc.makeExclusive")
    }

    /// Borrow the referenced value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("Arc.dereference")
    }

    /// Borrow the referenced value.
    as(&readonly this): &readonly T {
        this.dereference()
    }

    /// Borrow the referenced value.
    borrow(&readonly this): &readonly T {
        this.dereference()
    }
}

export extension<T> of Arc<T> implements Default where T: Default {
    /// Create a shared reference-counted handle with the default value.
    static default(): Arc<T> {
        Arc.new(T.default())
    }
}
