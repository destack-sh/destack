import { Access } from "./access.ds";

/// Ownership kind for qualified storage.
@languageItem("memory.Ownership")
export type Ownership = "managed" | "owned" | "borrowed" | "raw";

/// Qualify `Q` with access `A`, preserving its region.
@languageItem("memory.WithAccess")
export type WithAccess<Q, const A: Access> = intrinsic;

/// Project the space `T` occupies.
@languageItem("memory.PlaceOf")
export type PlaceOf<T> = intrinsic;

/// Project the access mode `T` grants.
@languageItem("memory.AccessOf")
export type AccessOf<T> = intrinsic;
