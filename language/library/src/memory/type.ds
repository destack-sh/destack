import { Access, Readonly } from "./access.ds";
import { Borrowed, ExclusiveBorrowed, ReadonlyBorrowed } from "./borrow.ds";
import { Lifetime } from "./lifetime.ds";
import { Managed } from "./managed.ds";
import { Owned } from "./owned.ds";
import { Place, Placed, Space } from "./place.ds";
import { Raw } from "./raw.ds";

/// Ownership kind for qualified storage.
@languageItem("memory.Ownership")
export type Ownership = "managed" | "owned" | "borrowed" | "raw";

/// Rebase `T` into the shared space.
export type Shared<T> = WithPlace<T, "shared">;

/// Rebase `T` into the local space.
export type Local<T> = WithPlace<T, "local">;

/// Rebase `T` into the ambient place.
export type Ambient<T> = WithPlace<T, "ambient">;

/// Extract the payload under the outermost memory form.
@languageItem("memory.PayloadOf")
export newtype PayloadOf<T> = intrinsic;

/// Extract the unqualified base type of `T`.
@languageItem("memory.BaseOf")
export newtype BaseOf<T> = intrinsic;

/// Extract the outer ownership form of `T`.
@languageItem("memory.OwnershipOf")
export newtype OwnershipOf<T> = intrinsic;

/// Extract the ownership of `T`, or fall back to `D`.
@languageItem("memory.OwnershipOr")
export newtype OwnershipOr<T, comptime D: Ownership> = intrinsic;

/// Extract the placement of `T`.
@languageItem("memory.PlaceOf")
export newtype PlaceOf<T> = intrinsic;

/// Extract the placement of `T`, or fall back to `D`.
@languageItem("memory.PlaceOr")
export newtype PlaceOr<T, comptime D: Place> = intrinsic;

/// Resolve ambient placement in concrete space `S`.
@languageItem("memory.PlaceIn")
export newtype PlaceIn<T, comptime S: Space> = intrinsic;

/// Extract the explicit concrete space of `T`.
@languageItem("memory.SpaceOf")
export newtype SpaceOf<T> = intrinsic;

/// Extract the explicit concrete space of `T`, or fall back to `D`.
@languageItem("memory.SpaceOr")
export newtype SpaceOr<T, comptime D: Space> = intrinsic;

/// Extract the borrow lifetime of `T`.
@languageItem("memory.LifetimeOf")
export newtype LifetimeOf<T> = intrinsic;

/// Extract the borrow lifetime of `T`, or fall back to `D`.
@languageItem("memory.LifetimeOr")
export newtype LifetimeOr<T, comptime D: Lifetime> = intrinsic;

/// Extract the access mode of `T`.
@languageItem("memory.AccessOf")
export newtype AccessOf<T> = intrinsic;

/// Extract the access mode of `T`, or fall back to `D`.
@languageItem("memory.AccessOr")
export newtype AccessOr<T, comptime D: Access> = intrinsic;

/// Return whether `T` is managed.
@languageItem("memory.IsManaged")
export newtype IsManaged<T> = intrinsic;

/// Return whether `T` is owned.
@languageItem("memory.IsOwned")
export newtype IsOwned<T> = intrinsic;

/// Return whether `T` is borrowed.
@languageItem("memory.IsBorrowed")
export newtype IsBorrowed<T> = intrinsic;

/// Return whether `T` is raw.
@languageItem("memory.IsRaw")
export newtype IsRaw<T> = intrinsic;

/// Return whether `T` is explicitly placed in shared space.
@languageItem("memory.IsShared")
export newtype IsShared<T> = intrinsic;

/// Return whether `T` resolves to shared space in concrete space `S`.
@languageItem("memory.IsSharedIn")
export newtype IsSharedIn<T, comptime S: Space> = intrinsic;

/// Replace the unqualified base type of `Q` with `T`.
@languageItem("memory.WithBase")
export newtype WithBase<Q, T> = intrinsic;

/// Add ownership form `O` around `Q`.
@languageItem("memory.WithOwnership")
export newtype WithOwnership<Q, comptime O: Ownership, comptime L: Lifetime = LifetimeOf<Q>> = intrinsic;

/// Place `Q` in `P`.
@languageItem("memory.WithPlace")
export newtype WithPlace<Q, comptime P: Place> = intrinsic;

/// Place `Q` in concrete space `S`.
@languageItem("memory.WithSpace")
export newtype WithSpace<Q, comptime S: Space> = intrinsic;

/// Reborrow `Q` with lifetime `L`.
@languageItem("memory.WithLifetime")
export newtype WithLifetime<Q, comptime L: Lifetime> = intrinsic;

/// Reborrow `Q` with access mode `A`.
@languageItem("memory.WithAccess")
export newtype WithAccess<Q, comptime A: Access> = intrinsic;

/// Rebase each field of `T` into managed form.
export type ManagedFields<T> = {
    [K in keyof T]: Managed<T[K]>;
};

/// Rebase each field of `T` into owned form.
export type OwnedFields<T> = {
    [K in keyof T]: Owned<T[K]>;
};

/// Rebase each field of `T` into borrowed form.
export type BorrowedFields<T, comptime L: Lifetime> = {
    [K in keyof T]: Borrowed<T[K], L>;
};

/// Rebase each field of `T` into readonly borrowed form.
export type ReadonlyBorrowedFields<T, comptime L: Lifetime> = {
    [K in keyof T]: ReadonlyBorrowed<T[K], L>;
};

/// Rebase each field of `T` into exclusive borrowed form.
export type ExclusiveBorrowedFields<T, comptime L: Lifetime> = {
    [K in keyof T]: ExclusiveBorrowed<T[K], L>;
};

/// Rebase each field of `T` into raw pointer form.
export type RawFields<T> = {
    [K in keyof T]: Raw<T[K]>;
};

/// Rebase each field of `T` into shared space.
export type SharedFields<T> = {
    [K in keyof T]: Shared<T[K]>;
};

/// Rebase each field of `T` into local space.
export type LocalFields<T> = {
    [K in keyof T]: Local<T[K]>;
};

/// Rebase each field of `T` into ambient placement.
export type AmbientFields<T> = {
    [K in keyof T]: Ambient<T[K]>;
};
