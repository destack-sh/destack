import { Access } from "./access.tspp";
import { Region } from "./region.tspp";

/// Borrowed access form for exactly `T`.
@languageItem("memory.Borrowed")
export newtype Borrowed<T, const R: Region, const A: Access = "mutable"> = intrinsic;

/// Readonly borrowed access to `T` within region `R`.
export type ReadonlyBorrowed<T, const R: Region> = Borrowed<T, R, "readonly">;

/// Mutable borrowed access to `T` within region `R`.
export type MutableBorrowed<T, const R: Region> = Borrowed<T, R, "mutable">;
