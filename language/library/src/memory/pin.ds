import { As, Borrow } from "destack:convert";
import { todo } from "destack:error";
import { WithAccess } from "destack:memory";
import { Dereference } from "destack:ops";

import { Unpin } from "./capability.ds";

/// Address-stable storage.
@languageItem("memory.Pin")
export newtype Pin<out T> = intrinsic;

export extension<T> of Pin<T> implements Dereference<"readonly">, As<T>, Borrow<T> {
    /// The projected result form.
    type Output = T;

    /// Pin a movable root.
    static new(value: T): Pin<T> where T: Unpin {
        todo("Pin.new")
    }

    /// Pin `value` without proving that its address is stable.
    static unchecked(value: T): Pin<T> {
        todo("Pin.unchecked")
    }

    /// Move out the pinned root when it is movable.
    intoInner(this): T where T: Unpin {
        todo("Pin.intoInner")
    }

    /// Borrow the pinned root with readonly access.
    asReference(): &readonly T {
        todo("Pin.asReference")
    }

    /// Project this pinned root into pinned mutable access.
    asPinnedExclusive(&this): Pin<&T> {
        todo("Pin.asPinnedExclusive")
    }

    /// Borrow the pinned root with mutable access when it is movable.
    asExclusive(&this): &T where T: Unpin {
        todo("Pin.asExclusive")
    }

    /// Borrow the pinned root.
    dereference(&readonly this): WithAccess<&this.Output, "readonly"> {
        todo("Pin.dereference")
    }

    /// Borrow the pinned root.
    as(&readonly this): &readonly T {
        this.dereference()
    }

    /// Borrow the pinned root.
    borrow(&readonly this): &readonly T {
        this.dereference()
    }
}
