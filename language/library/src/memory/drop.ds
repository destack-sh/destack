import { Access } from "./access.ds";
import { Default } from "./capability.ds";
import { WithAccess } from "./type.ds";

/// Ownership finalization capability.
@languageItem("memory.Drop")
export newtype interface Drop {
    /// Drop this value.
    drop(&exclusive this): void;
}

/// Owned storage whose `Drop` does not run automatically.
@languageItem("memory.ManuallyDrop")
export newtype ManuallyDrop<out T> = intrinsic;

export extension<T> of ManuallyDrop<T> {
    /// Wrap `value` without scheduling its destructor.
    static new(value: T): ManuallyDrop<T> {
        return newManuallyDrop<T>(value);
    }

    /// Move the wrapped value out.
    intoInner(this): T {
        return intoManuallyDropInner<T>(this);
    }

    /// Move the wrapped value out; the caller must prevent further access until reinitialized.
    @unsafe
    take(&exclusive this): T {
        return takeManuallyDrop<T>(this);
    }

    /// Borrow the wrapped value.
    asReference(&this): &T {
        return manuallyDropReference<T>(this);
    }

    /// Borrow the wrapped value with readonly access.
    asReadonlyReference(&readonly this): &readonly T {
        return manuallyDropReference<T, "readonly">(this);
    }

    /// Borrow the wrapped value with exclusive mutable access.
    asExclusive(&exclusive this): &exclusive T {
        return manuallyDropReference<T, "exclusive">(this);
    }

    /// Drop the wrapped value.
    dropInner(this): void {
        drop(intoManuallyDropInner<T>(this));
    }
}

/// Wrap one value without scheduling its destructor.
@intrinsic("memory.manuallyDrop.new")
export declare function newManuallyDrop<T>(value: T): ManuallyDrop<T>;

/// Move one wrapped value out.
@intrinsic("memory.manuallyDrop.intoInner")
export declare function intoManuallyDropInner<T>(wrapped: ManuallyDrop<T>): T;

/// Move the wrapped value out; the caller must prevent further access until reinitialized.
@unsafe
@intrinsic("memory.manuallyDrop.take")
export declare function takeManuallyDrop<T>(wrapped: &exclusive ManuallyDrop<T>): T;

/// Borrow one wrapped value at the access of its borrow.
@intrinsic("memory.manuallyDrop.asReference")
export declare function manuallyDropReference<T, const A: Access = "mutable">(
    wrapped: WithAccess<&ManuallyDrop<T>, A>,
): WithAccess<&T, A>;

export extension<T> of ManuallyDrop<T> implements Default where T: Default {
    /// Wrap the default value.
    static default(): ManuallyDrop<T> {
        ManuallyDrop.new(T.default())
    }
}

/// End ownership of `value` at this point.
@intrinsic("memory.drop")
export declare function drop<T>(value: T): void;

/// End ownership of `value` without running its destructor.
@languageItem("memory.forget")
export function forget<T>(value: T): void {
    newManuallyDrop<T>(value);
}
