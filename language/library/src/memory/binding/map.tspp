import { HostError } from "tspp:error/host";
import { FileHandle } from "tspp:fs/binding";

import { Pointer } from "../pointer.tspp";

import { MemoryProtection, VirtualMemoryRange } from "./virtual.tspp";

/// File mapping visibility.
@languageItem("memory.binding.MappedMemoryVisibility")
export enum MappedMemoryVisibility {
    /// Share writes with the backing object.
    Shared = 1,
    /// Keep writes private to this process.
    Private = 2,
}

/// Flags for file and anonymous memory mappings.
@languageItem("memory.binding.MappedMemoryFlags")
export newtype MappedMemoryFlags = uint32;

export extension of MappedMemoryFlags {
    /// No mapped memory flags.
    const none = MappedMemoryFlags(0x0);

    /// Request a fixed virtual address when the host supports it.
    const fixed = MappedMemoryFlags(0x10);

    /// Request large page backing where supported.
    const largePages = MappedMemoryFlags(0x20);
}

/// Flags for flushing mapped memory.
@languageItem("memory.binding.MappedMemorySyncFlags")
export newtype MappedMemorySyncFlags = uint32;

export extension of MappedMemorySyncFlags {
    /// No mapped memory synchronization flags.
    const none = MappedMemorySyncFlags(0x0);

    /// Schedule asynchronous writeback for dirty mapping pages.
    const async = MappedMemorySyncFlags(0x1);

    /// Invalidate cached mapping pages after synchronization.
    const invalidate = MappedMemorySyncFlags(0x2);

    /// Wait for dirty mapping pages to be written back.
    const wait = MappedMemorySyncFlags(0x4);
}

/// Map binding family.
@languageItem("memory.binding.MemoryMapBinding")
export interface MemoryMapBinding {
    /// Map a file backed memory range.
    @unsafe
    @binding("tspp.memory.map.file", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.map"],
        families: ["windows", "unix"],
    })
    mapFileMemory(
        file: FileHandle,
        offset: uint64,
        length: uint64,
        protection: MemoryProtection,
        visibility: MappedMemoryVisibility,
        flags: MappedMemoryFlags,
        addressHint?: Pointer<uint8>,
    ): Result<VirtualMemoryRange, HostError>;

    /// Map an anonymous memory range.
    @unsafe
    @binding("tspp.memory.map.anonymous", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.map"],
        families: ["windows", "unix"],
    })
    mapAnonymousMemory(
        length: uint64,
        protection: MemoryProtection,
        visibility: MappedMemoryVisibility,
        flags: MappedMemoryFlags,
        addressHint?: Pointer<uint8>,
    ): Result<VirtualMemoryRange, HostError>;

    /// Unmap a mapped memory range.
    @unsafe
    @binding("tspp.memory.map.unmap", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.map"],
        families: ["windows", "unix"],
    })
    unmapMemory(range: VirtualMemoryRange): Result<void, HostError>;

    /// Flush mapped memory to backing storage.
    @binding("tspp.memory.map.sync", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.map"],
        families: ["windows", "unix"],
    })
    syncMappedMemory(
        range: VirtualMemoryRange,
        flags: MappedMemorySyncFlags,
    ): Result<void, HostError>;
}
