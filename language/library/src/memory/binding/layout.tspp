import { HostError } from "tspp:error/host";

/// Virtual memory layout constraints.
export struct VirtualMemoryLayout {
    /// Virtual memory page size bytes.
    pageSizeBytes: uint64;
    /// Virtual memory allocation granularity bytes.
    allocationGranularityBytes: uint64;
    /// Large page allocation size bytes when available.
    largePageSizeBytes?: uint64;
}

/// Layout binding family.
@languageItem("memory.binding.MemoryLayoutBinding")
export interface MemoryLayoutBinding {
    /// Read virtual memory layout constraints.
    @binding("tspp.memory.layout.read", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.layout.read"],
        families: ["windows", "unix"],
    })
    readVirtualMemoryLayout(): Result<VirtualMemoryLayout, HostError>;
}
