import { Binding } from "destack:binding";

import { MemoryAdviseBinding } from "./advise.ds";
import { MemoryLayoutBinding } from "./layout.ds";
import { MemoryLockBinding } from "./lock.ds";
import { MemoryMapBinding } from "./map.ds";
import { MemoryVirtualBinding } from "./virtual.ds";

/// Memory binding family.
@languageItem("memory.MemoryBinding")
export interface MemoryBinding {
    /// Advise bindings.
    readonly advise: MemoryAdviseBinding;
    /// Layout bindings.
    readonly layout: MemoryLayoutBinding;
    /// Lock bindings.
    readonly lock: MemoryLockBinding;
    /// Map bindings.
    readonly map: MemoryMapBinding;
    /// Virtual bindings.
    readonly virtual: MemoryVirtualBinding;
}

/// Current memory binding family.
export const memory = new Binding<MemoryBinding>("memory");
