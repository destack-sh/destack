import { HostError } from "destack:error/host";

import { Pointer } from "../pointer.ds";

/// Virtual memory address range.
export struct VirtualMemoryRange {
    /// Base virtual address.
    address: Pointer<uint8>;
    /// Range length in bytes.
    length: uint64;
}

/// Bitmask of virtual memory protection permissions.
@languageItem("memory.binding.MemoryProtection")
export newtype MemoryProtection = uint32;

export extension of MemoryProtection {
    /// No protection bits.
    const none = MemoryProtection(0x0);

    /// Allow reads from mapped pages.
    const read = MemoryProtection(0x1);

    /// Allow writes to mapped pages.
    const write = MemoryProtection(0x2);

    /// Allow instruction fetch from mapped pages.
    const execute = MemoryProtection(0x4);
}

/// Flags for virtual memory reservation operations.
@languageItem("memory.binding.VirtualMemoryReserveFlags")
export newtype VirtualMemoryReserveFlags = uint32;

export extension of VirtualMemoryReserveFlags {
    /// No reserve flags.
    const none = VirtualMemoryReserveFlags(0x0);

    /// Prefer high virtual addresses where supported.
    const topDown = VirtualMemoryReserveFlags(0x1);

    /// Reserve address space without guaranteed swap reservation where supported.
    const noReserve = VirtualMemoryReserveFlags(0x2);
}

/// Virtual binding family.
@languageItem("memory.binding.MemoryVirtualBinding")
export interface MemoryVirtualBinding {
    /// Reserve one virtual memory range.
    @binding("destack.memory.virtual.reserve", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.virtual"],
        families: ["windows", "unix"],
    })
    reserveVirtualMemory(
        length: uint64,
        flags: VirtualMemoryReserveFlags,
        addressHint?: Pointer<uint8>,
    ): Result<VirtualMemoryRange, HostError>;

    /// Commit physical backing for one reserved virtual memory range.
    @unsafe
    @binding("destack.memory.virtual.commit", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.virtual"],
        families: ["windows", "unix"],
    })
    commitVirtualMemory(
        range: VirtualMemoryRange,
        protection: MemoryProtection,
    ): Result<void, HostError>;

    /// Decommit physical backing from one virtual memory range.
    @unsafe
    @binding("destack.memory.virtual.decommit", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.virtual"],
        families: ["windows", "unix"],
    })
    decommitVirtualMemory(range: VirtualMemoryRange): Result<void, HostError>;

    /// Release one reserved virtual memory range.
    @unsafe
    @binding("destack.memory.virtual.release", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.virtual"],
        families: ["windows", "unix"],
    })
    releaseVirtualMemory(range: VirtualMemoryRange): Result<void, HostError>;

    /// Change virtual memory protection for one range.
    @unsafe
    @binding("destack.memory.virtual.protect", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.virtual"],
        families: ["windows", "unix"],
    })
    protectVirtualMemory(
        range: VirtualMemoryRange,
        protection: MemoryProtection,
    ): Result<void, HostError>;

    /// Flush instruction cache for one executable memory range.
    @binding("destack.memory.virtual.instructionCache.flush", {
        provider: "host",
        effect: "external",
        requires: ["host.memory.execute"],
        families: ["windows", "unix"],
    })
    flushInstructionCache(range: VirtualMemoryRange): Result<void, HostError>;
}
