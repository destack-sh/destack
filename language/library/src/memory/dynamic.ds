import { Type } from "destack:reflect/type";

import { DynamicSafe } from "./capability.ds";

/// Erased runtime value for interface constraint `T`.
///
/// `Dynamic<T>` stores an erased payload and concrete runtime type id.
/// It is compiler-known because static interface constraints are specialized by default, while `Dynamic<T>` explicitly requests runtime erasure.
@languageItem("memory.Dynamic")
export newtype Dynamic<T: DynamicSafe> = intrinsic;

export extension<T: DynamicSafe> of Dynamic<T> {
    /// Return the runtime type carried by this erased value.
    @intrinsic("memory.dynamic.type")
    get type(): Type<unknown>;

    /// Return the erased payload pointer.
    @unsafe
    @intrinsic("memory.dynamic.payload")
    get payload(): *void;
}
