import { Lifetime } from "./lifetime.ds";
import { Space } from "./place.ds";

/// Reference region: the referent's lifetime extent and monomorphic space.
///
/// A tick name declares a region parameter, `&` meets an extent with a space,
/// and `|` joins extents. Extents erase and join freely, spaces stay
/// statically known: a value spanning spaces is a union of placed types.
@languageItem("memory.Region")
export newtype Region = intrinsic;
