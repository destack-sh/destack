import { Copy } from "./capability.tspp";

import { WithAccess } from "./type.tspp";

/// Exchange the values at `left` and `right`.
@intrinsic("memory.ptr.swap")
export declare function swap<
    T,
    const Left: "mutable" | "exclusive",
    const Right: "mutable" | "exclusive",
>(left: WithAccess<&T, Left>, right: WithAccess<&T, Right>): void
    where
        Left: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never),
        Right: "exclusive" | ((T,) extends (Copy,) ? "mutable" : never);
