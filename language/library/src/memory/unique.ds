import { Borrowed } from "./borrow.ds";
import { Owned } from "./owned.ds";

/// Unique traced heap handle containing exactly `T`.
///
/// `Unique<T>` is the low-level storage handle behind types such as `Box<T>`.
/// It is compiler-known because tracing, drop, and move checking must understand the handle.
@languageItem("memory.Unique")
export newtype Unique<out T> = intrinsic;

export extension<T> of Unique<Owned<T>> {
    /// Leak this allocation and borrow it for static lifetime.
    leak(this): Borrowed<T, "static"> {
        return leakUnique<T>(this);
    }
}

export extension<T> of Unique<[T]> {
    /// Create an empty slice handle without allocating.
    static empty(): Unique<[T]> {
        return emptyUniqueSlice<T>();
    }
}

/// Leak one allocation and borrow it for static lifetime.
@intrinsic("memory.unique.leak")
export declare function leakUnique<T>(unique: Unique<Owned<T>>): Borrowed<T, "static">;

/// Create one empty slice handle without allocating.
@intrinsic("memory.unique.empty")
export declare function emptyUniqueSlice<T>(): Unique<[T]>;
