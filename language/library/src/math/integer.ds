import { Result, todo } from "destack:error";
import { IntlError, Locales, NumberFormatOptions, ToLocaleString } from "destack:intl";
import { Clone, Concrete, Copy } from "destack:memory";
import { DefaultEqual, Equal, Hash, Hasher, PartialEqual } from "destack:ops";
import { sizeOf } from "destack:reflect";

import { One, Zero } from "./identity.ds";

/// Marker for integer literals, intervals, and builtin integer types.
@languageItem("math.IntegerDomain")
export newtype interface IntegerDomain {}

/// Marker for the builtin integer types of any width.
@languageItem("math.Integer")
export newtype interface Integer extends Concrete, Copy, IntegerDomain, Zero, One {}

/// The unsigned builtin integer type with the same width as `T`.
@languageItem("math.Unsigned")
export type Unsigned<T: Integer> = intrinsic;

/// Methods shared by every builtin integer type.
export extension<T: Integer> of T
    implements Clone, PartialEqual<T>, Equal<T>, Hash, DefaultEqual<T>, ToLocaleString
{
    /// Return this number as a string.
    toString(this, radix?: number): ^string {
        todo("Number.toString")
    }

    /// Return this number in fixed-point notation.
    toFixed(this, fractionDigits?: number): ^string {
        todo("Number.toFixed")
    }

    /// Return this number in exponential notation.
    toExponential(this, fractionDigits?: number): ^string {
        todo("Number.toExponential")
    }

    /// Return this number with the requested precision.
    toPrecision(this, precision?: number): ^string {
        todo("Number.toPrecision")
    }

    /// Return this number as a locale-aware string.
    toLocaleString(this): ^string {
        todo("Number.toLocaleStringDefault")
    }

    /// Return this number as a locale-aware string with explicit locales.
    toLocaleString(this, locales: &readonly Locales): Result<string, IntlError> {
        todo("Number.toLocaleStringLocales")
    }

    /// Return this number as a locale-aware string with explicit options.
    toLocaleString(
        this,
        locales?: &readonly Locales,
        options?: &readonly NumberFormatOptions,
    ): Result<string, IntlError> {
        todo("Number.toLocaleString")
    }

    /// Return a copy of this value.
    clone(&immutable this): ^this {
        *this
    }

    /// Return whether this value equals `other`.
    equal(&immutable this, other: &immutable T): boolean {
        *this === *other
    }

    /// Add this value to `state`.
    hash(&immutable this, state: &Hasher): void {
        state.writeUsize(this.truncate<usize>());
    }

    /// Return the least representable value.
    static minimum(): T {
        todo("Integer.minimum")
    }

    /// Return the greatest representable value.
    static maximum(): T {
        todo("Integer.maximum")
    }

    /// Return the midpoint rounded toward zero without intermediate overflow.
    midpoint(this, other: T): T {
        midpoint(this, other)
    }

    /// Clamp this value between ordered bounds.
    ///
    /// Traps when `minimum` exceeds `maximum`.
    clamp(this, minimum: T, maximum: T): T {
        clamp(this, minimum, maximum)
    }

    /// Divide and round the quotient toward positive infinity.
    ///
    /// Traps on division by zero or signed division overflow.
    divideCeil(this, other: T): T {
        divideCeil(this, other)
    }

    /// Return the Euclidean quotient.
    ///
    /// Traps on division by zero or signed division overflow.
    divideEuclidean(this, other: T): T {
        let quotient = this / other;
        let remainder = this % other;

        if (remainder < T.zero()) {
            if (other > T.zero()) {
                quotient - T.one()
            } else {
                quotient + T.one()
            }
        } else {
            quotient
        }
    }

    /// Return the least nonnegative remainder.
    ///
    /// Traps on division by zero or signed division overflow.
    remainderEuclidean(this, other: T): T {
        remainderEuclidean(this, other)
    }

    /// Return whether this value is a multiple of `other`.
    ///
    /// A zero divisor produces `true` exactly when this value is also zero.
    isMultipleOf(this, other: T): boolean {
        isMultipleOf(this, other)
    }

    /// Return a value that represents this value's sign.
    signum(this): T {
        todo("Integer.signum")
    }

    /// Return the floor of the logarithm in `base`.
    integerLog(this, base: T): uint32 {
        todo("Integer.integerLog")
    }

    /// Return the floor of the base-two logarithm.
    integerLog2(this): uint32 {
        todo("Integer.integerLog2")
    }

    /// Return the floor of the base-ten logarithm.
    integerLog10(this): uint32 {
        todo("Integer.integerLog10")
    }

    /// Return the floor of the logarithm, or `undefined` for an invalid value or base.
    checkedIntegerLog(this, base: T): uint32 | undefined {
        todo("Integer.checkedIntegerLog")
    }

    /// Return the floor of the base-two logarithm, or `undefined` for an invalid value.
    checkedIntegerLog2(this): uint32 | undefined {
        todo("Integer.checkedIntegerLog2")
    }

    /// Return the floor of the base-ten logarithm, or `undefined` for an invalid value.
    checkedIntegerLog10(this): uint32 | undefined {
        todo("Integer.checkedIntegerLog10")
    }

    /// Return the absolute difference between this value and `other`.
    absDiff(this, other: T): Unsigned<T> {
        absDiff(this, other)
    }

    /// Count the leading zero bits.
    countLeadingZeros(this): uint32 {
        countLeadingZeros(this)
    }

    /// Count the trailing zero bits.
    countTrailingZeros(this): uint32 {
        countTrailingZeros(this)
    }

    /// Count the leading one bits.
    countLeadingOnes(this): uint32 {
        (~this).countLeadingZeros()
    }

    /// Count the trailing one bits.
    countTrailingOnes(this): uint32 {
        (~this).countTrailingZeros()
    }

    /// Count the one bits.
    countOnes(this): uint32 {
        countOnes(this)
    }

    /// Count the zero bits.
    countZeros(this): uint32 {
        (sizeOf<T>() * 8).truncate<uint32>() - this.countOnes()
    }

    /// Reverse the byte order.
    swapBytes(this): T {
        swapBytes(this)
    }

    /// Return `value` with bytes interpreted as big-endian.
    static fromBigEndian(value: T): T {
        todo("Integer.fromBigEndian")
    }

    /// Return `value` with bytes interpreted as little-endian.
    static fromLittleEndian(value: T): T {
        todo("Integer.fromLittleEndian")
    }

    /// Return this value encoded as big-endian.
    toBigEndian(this): T {
        todo("Integer.toBigEndian")
    }

    /// Return this value encoded as little-endian.
    toLittleEndian(this): T {
        todo("Integer.toLittleEndian")
    }

    /// Reverse every bit.
    reverseBits(this): T {
        reverseBits(this)
    }

    /// Return this value with only its least-significant one bit set.
    ///
    /// Returns zero when this value is zero.
    isolateLowestOne(this): T {
        isolateLowestOne(this)
    }

    /// Rotate bits left.
    rotateLeft(this, amount: uint32): T {
        rotateLeft(this, amount)
    }

    /// Rotate bits right.
    rotateRight(this, amount: uint32): T {
        rotateRight(this, amount)
    }

    /// Return whether this value is a power of two.
    isPowerOfTwo(this): boolean {
        this > T.zero() && (this & (this - T.one())) == T.zero()
    }

    /// Return the next power of two, or `undefined` on overflow.
    nextPowerOfTwo(this): T | undefined {
        todo("Integer.nextPowerOfTwo")
    }

    /// Compare two integers by value.
    static equal(value: &immutable T, key: &immutable T): boolean {
        *value == *key
    }

    /// Hash an integer by value.
    static hash(value: &immutable T, state: &Hasher): void {
        value.hash(state);
    }
}

/// Compute an integer midpoint rounded toward zero without intermediate overflow.
@intrinsic("math.arithmetic.midpoint")
declare function midpoint<T: Integer>(left: T, right: T): T;

/// Clamp one integer between ordered bounds.
///
/// Traps when `minimum` exceeds `maximum`.
@intrinsic("math.arithmetic.clamp")
declare function clamp<T: Integer>(value: T, minimum: T, maximum: T): T;

/// Divide integers and round the quotient toward positive infinity.
///
/// Traps on division by zero or signed division overflow.
@intrinsic("math.arithmetic.divideCeil")
declare function divideCeil<T: Integer>(left: T, right: T): T;

/// Compute the least nonnegative integer remainder.
///
/// Traps on division by zero or signed division overflow.
@intrinsic("math.arithmetic.remainderEuclidean")
declare function remainderEuclidean<T: Integer>(left: T, right: T): T;

/// Test whether one integer is a multiple of another.
///
/// A zero divisor produces `true` exactly when `left` is also zero.
@intrinsic("math.arithmetic.isMultipleOf")
declare function isMultipleOf<T: Integer>(left: T, right: T): boolean;

/// Compute the absolute difference between two integers.
@intrinsic("math.arithmetic.absDiff")
declare function absDiff<T: Integer>(left: T, right: T): Unsigned<T>;

/// Count leading zero bits.
@intrinsic("math.bits.leadingZeroCount")
declare function countLeadingZeros<T: Integer>(value: T): uint32;

/// Count trailing zero bits.
@intrinsic("math.bits.trailingZeroCount")
declare function countTrailingZeros<T: Integer>(value: T): uint32;

/// Count one bits.
@intrinsic("math.bits.populationCount")
declare function countOnes<T: Integer>(value: T): uint32;

/// Reverse byte order.
@intrinsic("math.bits.byteSwap")
declare function swapBytes<T: Integer>(value: T): T;

/// Reverse every bit.
@intrinsic("math.bits.bitReverse")
declare function reverseBits<T: Integer>(value: T): T;

/// Isolate the least-significant one bit.
///
/// Returns zero when `value` is zero.
@intrinsic("math.bits.isolateLowestOne")
declare function isolateLowestOne<T: Integer>(value: T): T;

/// Rotate bits left.
@intrinsic("math.bits.rotateLeft")
declare function rotateLeft<T: Integer>(value: T, amount: uint32): T;

/// Rotate bits right.
@intrinsic("math.bits.rotateRight")
declare function rotateRight<T: Integer>(value: T, amount: uint32): T;
