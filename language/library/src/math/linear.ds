    /// Return this vector limited to `length`.
    limitLength(length: T): Vector4<T> {
        todo("Vector4.limitLength")
    }

    /// Linearly interpolate toward `other`.
    lerp(other: Vector4<T>, weight: T): Vector4<T> {
