    }

    /// Return the normalized vector.
    normalized(): Vector4<T> {
        let length = this.length();

        Vector4 {
            x: this.x / length,
            y: this.y / length,
            z: this.z / length,
            w: this.w / length,
        }
    }

    /// Return a normalized vector, or zero when the length is zero.
    normalizedOrZero(): Vector4<T> {
