import { Slice } from "destack:collections";
import { todo } from "destack:error";

/// Fixed-width vector type.
@languageItem("math.Vector")
export newtype Vector<T, comptime N: int> = intrinsic;

/// Vector mask type.
export type Mask<comptime N: int> = Vector<boolean, N>;

/// Return the number of lanes in `Vector<T, N>`.
export type LaneCount<V> = V extends Vector<infer T, infer N> ? N : never;

/// Return the element type in `Vector<T, N>`.
export type LaneOf<V> = V extends Vector<infer T, infer N> ? T : never;

/// Broadcast scalar to all lanes.
///
/// Creates a vector with all lanes set to the same scalar value.
@intrinsic("math.vector.splat")
export declare function splat<T, comptime N: int>(value: T): Vector<T, N>;

/// Return the lane at `index`.
@intrinsic("math.vector.extract")
export declare function extract<T, comptime N: int>(value: Vector<T, N>, index: uint32): T;

/// Return a vector with one lane replaced.
@intrinsic("math.vector.insert")
export declare function insert<T, comptime N: int>(
    vector: Vector<T, N>,
    index: uint32,
    value: T,
): Vector<T, N>;

/// Shuffle vector lanes.
///
/// Rearranges elements from two input vectors according to a mask.
/// Each element in the result comes from either `a` or `b` as specified by the mask.
@intrinsic("math.vector.shuffle")
export declare function shuffle<T, comptime N: int, comptime M: int, comptime Pattern: [uint32; M]>(
    a: Vector<T, N>,
    b: Vector<T, N>,
): Vector<T, M>;

/// Per-lane conditional select.
///
/// Returns a[i] if mask[i] is true, otherwise b[i], for each lane.
@intrinsic("math.vector.select")
export declare function select<T, comptime N: int>(
    mask: Vector<boolean, N>,
    a: Vector<T, N>,
    b: Vector<T, N>,
): Vector<T, N>;

/// Convert vector lanes to `U`.
@intrinsic("math.vector.convert")
export declare function convert<U, T, comptime N: int>(value: Vector<T, N>): Vector<U, N>;

/// Load `N` contiguous values from `source`.
export function load<T, comptime N: int>(source: &readonly Slice<T>): Vector<T, N> {
    todo("vector.load")
}

/// Store `value` into `destination`.
export function store<T, comptime N: int>(
    destination: &exclusive Slice<T>,
    value: Vector<T, N>,
): void {
    todo("vector.store");
}

/// Return a lane mask for equality.
@intrinsic("math.vector.equal")
export declare function equal<T, comptime N: int>(left: Vector<T, N>, right: Vector<T, N>): Mask<N>;

/// Return a lane mask for inequality.
@intrinsic("math.vector.notEqual")
export declare function notEqual<T, comptime N: int>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for less-than comparison.
@intrinsic("math.vector.less")
export declare function less<T, comptime N: int>(left: Vector<T, N>, right: Vector<T, N>): Mask<N>;

/// Return a lane mask for less-than-or-equal comparison.
@intrinsic("math.vector.lessEqual")
export declare function lessEqual<T, comptime N: int>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for greater-than comparison.
@intrinsic("math.vector.greater")
export declare function greater<T, comptime N: int>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for greater-than-or-equal comparison.
@intrinsic("math.vector.greaterEqual")
export declare function greaterEqual<T, comptime N: int>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Horizontal reduction: sum all lanes.
@intrinsic("math.vector.reduce.add")
export declare function reduceAdd<T, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: multiply all lanes.
@intrinsic("math.vector.reduce.mul")
export declare function reduceMul<T, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: minimum of all lanes.
@intrinsic("math.vector.reduce.min")
export declare function reduceMin<T, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: maximum of all lanes.
@intrinsic("math.vector.reduce.max")
export declare function reduceMax<T, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise AND of all lanes.
@intrinsic("math.vector.reduce.and")
export declare function reduceAnd<T: int, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise OR of all lanes.
@intrinsic("math.vector.reduce.or")
export declare function reduceOr<T: int, comptime N: int>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise XOR of all lanes.
@intrinsic("math.vector.reduce.xor")
export declare function reduceXor<T: int, comptime N: int>(v: Vector<T, N>): T;
