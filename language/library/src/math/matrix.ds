import { Add, Multiply, Subtract } from "destack:ops";

import { Float } from "./float.ds";
import { Vector2, Vector3, Vector4 } from "./linear.ds";
import { Numeric } from "./numeric.ds";

/// Two-by-two matrix in row-major field order.
@languageItem("math.Matrix2")
export struct Matrix2<T: Numeric> {
    /// First row, first column.
    m00: T;

    /// First row, second column.
    m01: T;

    /// Second row, first column.
    m10: T;

    /// Second row, second column.
    m11: T;
}

/// Three-by-three matrix in row-major field order.
@languageItem("math.Matrix3")
export struct Matrix3<T: Numeric> {
    /// First row.
    x: Vector3<T>;

    /// Second row.
    y: Vector3<T>;

    /// Third row.
    z: Vector3<T>;
}

/// Four-by-four matrix in row-major field order.
@languageItem("math.Matrix4")
export struct Matrix4<T: Numeric> {
    /// First row.
    x: Vector4<T>;

    /// Second row.
    y: Vector4<T>;

    /// Third row.
    z: Vector4<T>;

    /// Fourth row.
    w: Vector4<T>;
}

/// Two-by-two single-precision matrix.
export type Matrix2f = Matrix2<float32>;

/// Three-by-three single-precision matrix.
export type Matrix3f = Matrix3<float32>;

/// Four-by-four single-precision matrix.
export type Matrix4f = Matrix4<float32>;

/// Two-by-two double-precision matrix.
export type Matrix2d = Matrix2<float64>;

/// Three-by-three double-precision matrix.
export type Matrix3d = Matrix3<float64>;

/// Four-by-four double-precision matrix.
export type Matrix4d = Matrix4<float64>;

/// Two-by-two signed integer matrix.
export type Matrix2i = Matrix2<int32>;

/// Three-by-three signed integer matrix.
export type Matrix3i = Matrix3<int32>;

/// Four-by-four signed integer matrix.
export type Matrix4i = Matrix4<int32>;

export extension<T: Numeric> of Matrix2<T>
    implements Add<Matrix2<T>>, Subtract<Matrix2<T>>, Multiply<Matrix2<T>>
{
    /// The arithmetic result type.
    type Output = Matrix2<T>;

    /// Return the identity matrix.
    static identity(): Matrix2<T> {
        Matrix2 { m00: T.one(), m01: T.zero(), m10: T.zero(), m11: T.one() }
    }

    /// Return the zero matrix.
    static zero(): Matrix2<T> {
        Matrix2 { m00: T.zero(), m01: T.zero(), m10: T.zero(), m11: T.zero() }
    }

    /// Create a matrix from rows.
    static rows(x: Vector2<T>, y: Vector2<T>): Matrix2<T> {
        Matrix2 { m00: x.x, m01: x.y, m10: y.x, m11: y.y }
    }

    /// Return the determinant.
    determinant(this): T {
        this.m00 * this.m11 - this.m01 * this.m10
    }

    /// Return the transposed matrix.
    transpose(this): Matrix2<T> {
        Matrix2 { m00: this.m00, m01: this.m10, m10: this.m01, m11: this.m11 }
    }

    /// Add `other`.
    add(this, other: Matrix2<T>): this.Output {
        Matrix2 {
            m00: this.m00 + other.m00,
            m01: this.m01 + other.m01,
            m10: this.m10 + other.m10,
            m11: this.m11 + other.m11,
        }
    }

    /// Subtract `other`.
    subtract(this, other: Matrix2<T>): this.Output {
        Matrix2 {
            m00: this.m00 - other.m00,
            m01: this.m01 - other.m01,
            m10: this.m10 - other.m10,
            m11: this.m11 - other.m11,
        }
    }

    /// Multiply by `other`.
    multiply(this, other: Matrix2<T>): this.Output {
        Matrix2 {
            m00: this.m00 * other.m00 + this.m01 * other.m10,
            m01: this.m00 * other.m01 + this.m01 * other.m11,
            m10: this.m10 * other.m00 + this.m11 * other.m10,
            m11: this.m10 * other.m01 + this.m11 * other.m11,
        }
    }

    /// Transform `vector`.
    transform(this, vector: Vector2<T>): Vector2<T> {
        Vector2 {
            x: this.m00 * vector.x + this.m01 * vector.y,
            y: this.m10 * vector.x + this.m11 * vector.y,
        }
    }
}

export extension<T: Float> of Matrix2<T> {
    /// Return the inverse matrix.
    inverse(this): Matrix2<T> {
        let scale = T.one() / this.determinant();

        Matrix2 {
            m00: this.m11 * scale,
            m01: -this.m01 * scale,
            m10: -this.m10 * scale,
            m11: this.m00 * scale,
        }
    }
}

export extension<T: Numeric> of Matrix3<T>
    implements Add<Matrix3<T>>, Subtract<Matrix3<T>>, Multiply<Matrix3<T>>
{
    /// The arithmetic result type.
    type Output = Matrix3<T>;

    /// Return the identity matrix.
    static identity(): Matrix3<T> {
        Matrix3 {
            x: Vector3 { x: T.one(), y: T.zero(), z: T.zero() },
            y: Vector3 { x: T.zero(), y: T.one(), z: T.zero() },
            z: Vector3 { x: T.zero(), y: T.zero(), z: T.one() },
        }
    }

    /// Return the zero matrix.
    static zero(): Matrix3<T> {
        Matrix3 {
            x: Vector3.zero(),
            y: Vector3.zero(),
            z: Vector3.zero(),
        }
    }

    /// Create a matrix from rows.
    static rows(x: Vector3<T>, y: Vector3<T>, z: Vector3<T>): Matrix3<T> {
        Matrix3 { x, y, z }
    }

    /// Return a two-dimensional scale matrix.
    static scale(scale: Vector2<T>): Matrix3<T> {
        Matrix3 {
            x: Vector3 { x: scale.x, y: T.zero(), z: T.zero() },
            y: Vector3 { x: T.zero(), y: scale.y, z: T.zero() },
            z: Vector3 { x: T.zero(), y: T.zero(), z: T.one() },
        }
    }

    /// Return a two-dimensional translation matrix.
    static translation(offset: Vector2<T>): Matrix3<T> {
        Matrix3 {
            x: Vector3 { x: T.one(), y: T.zero(), z: offset.x },
            y: Vector3 { x: T.zero(), y: T.one(), z: offset.y },
            z: Vector3 { x: T.zero(), y: T.zero(), z: T.one() },
        }
    }

    /// Return the determinant.
    determinant(this): T {
        this.x.dot(this.y.cross(this.z))
    }

    /// Return the transposed matrix.
    transpose(this): Matrix3<T> {
        Matrix3 {
            x: Vector3 { x: this.x.x, y: this.y.x, z: this.z.x },
            y: Vector3 { x: this.x.y, y: this.y.y, z: this.z.y },
            z: Vector3 { x: this.x.z, y: this.y.z, z: this.z.z },
        }
    }

    /// Add `other`.
    add(this, other: Matrix3<T>): this.Output {
        Matrix3 { x: this.x + other.x, y: this.y + other.y, z: this.z + other.z }
    }

    /// Subtract `other`.
    subtract(this, other: Matrix3<T>): this.Output {
        Matrix3 { x: this.x - other.x, y: this.y - other.y, z: this.z - other.z }
    }

    /// Multiply by `other`.
    multiply(this, other: Matrix3<T>): this.Output {
        let columns = other.transpose();

        Matrix3 {
            x: Vector3 {
                x: this.x.dot(columns.x),
                y: this.x.dot(columns.y),
                z: this.x.dot(columns.z),
            },
            y: Vector3 {
                x: this.y.dot(columns.x),
                y: this.y.dot(columns.y),
                z: this.y.dot(columns.z),
            },
            z: Vector3 {
                x: this.z.dot(columns.x),
                y: this.z.dot(columns.y),
                z: this.z.dot(columns.z),
            },
        }
    }

    /// Transform `vector`.
    transform(this, vector: Vector3<T>): Vector3<T> {
        Vector3 {
            x: this.x.dot(vector),
            y: this.y.dot(vector),
            z: this.z.dot(vector),
        }
    }
}

export extension<T: Float> of Matrix3<T> {
    /// Return the inverse matrix.
    inverse(this): Matrix3<T> {
        let cofactors = Matrix3 {
            x: this.y.cross(this.z),
            y: this.z.cross(this.x),
            z: this.x.cross(this.y),
        };
        let scale = T.one() / this.x.dot(cofactors.x);
        let adjugate = cofactors.transpose();

        Matrix3 { x: adjugate.x * scale, y: adjugate.y * scale, z: adjugate.z * scale }
    }
}

export extension<T: Numeric> of Matrix4<T>
    implements Add<Matrix4<T>>, Subtract<Matrix4<T>>, Multiply<Matrix4<T>>
{
    /// The arithmetic result type.
    type Output = Matrix4<T>;

    /// Return the identity matrix.
    static identity(): Matrix4<T> {
        Matrix4 {
            x: Vector4 { x: T.one(), y: T.zero(), z: T.zero(), w: T.zero() },
            y: Vector4 { x: T.zero(), y: T.one(), z: T.zero(), w: T.zero() },
            z: Vector4 { x: T.zero(), y: T.zero(), z: T.one(), w: T.zero() },
            w: Vector4 { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() },
        }
    }

    /// Return the zero matrix.
    static zero(): Matrix4<T> {
        Matrix4 {
            x: Vector4.zero(),
            y: Vector4.zero(),
            z: Vector4.zero(),
            w: Vector4.zero(),
        }
    }

    /// Create a matrix from rows.
    static rows(x: Vector4<T>, y: Vector4<T>, z: Vector4<T>, w: Vector4<T>): Matrix4<T> {
        Matrix4 { x, y, z, w }
    }

    /// Return a three-dimensional scale matrix.
    static scale(scale: Vector3<T>): Matrix4<T> {
        Matrix4 {
            x: Vector4 { x: scale.x, y: T.zero(), z: T.zero(), w: T.zero() },
            y: Vector4 { x: T.zero(), y: scale.y, z: T.zero(), w: T.zero() },
            z: Vector4 { x: T.zero(), y: T.zero(), z: scale.z, w: T.zero() },
            w: Vector4 { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() },
        }
    }

    /// Return a three-dimensional translation matrix.
    static translation(offset: Vector3<T>): Matrix4<T> {
        Matrix4 {
            x: Vector4 { x: T.one(), y: T.zero(), z: T.zero(), w: offset.x },
            y: Vector4 { x: T.zero(), y: T.one(), z: T.zero(), w: offset.y },
            z: Vector4 { x: T.zero(), y: T.zero(), z: T.one(), w: offset.z },
            w: Vector4 { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() },
        }
    }

    /// Return an orthographic projection matrix.
    static orthographic(left: T, right: T, bottom: T, top: T, near: T, far: T): Matrix4<T> {
        let width = right - left;
        let height = top - bottom;
        let depth = near - far;

        Matrix4 {
            x: Vector4 {
                x: (T.one() + T.one()) / width,
                y: T.zero(),
                z: T.zero(),
                w: -(left + right) / width,
            },
            y: Vector4 {
                x: T.zero(),
                y: (T.one() + T.one()) / height,
                z: T.zero(),
                w: -(bottom + top) / height,
            },
            z: Vector4 { x: T.zero(), y: T.zero(), z: T.one() / depth, w: near / depth },
            w: Vector4 { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() },
        }
    }

    /// Return the determinant.
    determinant(this): T {
        let zw = this.z.z * this.w.w - this.z.w * this.w.z;
        let yw = this.z.y * this.w.w - this.z.w * this.w.y;
        let yz = this.z.y * this.w.z - this.z.z * this.w.y;
        let xw = this.z.x * this.w.w - this.z.w * this.w.x;
        let xz = this.z.x * this.w.z - this.z.z * this.w.x;
        let xy = this.z.x * this.w.y - this.z.y * this.w.x;

        this.x.x * (this.y.y * zw - this.y.z * yw + this.y.w * yz)
            - this.x.y * (this.y.x * zw - this.y.z * xw + this.y.w * xz)
            + this.x.z * (this.y.x * yw - this.y.y * xw + this.y.w * xy)
            - this.x.w * (this.y.x * yz - this.y.y * xz + this.y.z * xy)
    }

    /// Return the transposed matrix.
    transpose(this): Matrix4<T> {
        Matrix4 {
            x: Vector4 { x: this.x.x, y: this.y.x, z: this.z.x, w: this.w.x },
            y: Vector4 { x: this.x.y, y: this.y.y, z: this.z.y, w: this.w.y },
            z: Vector4 { x: this.x.z, y: this.y.z, z: this.z.z, w: this.w.z },
            w: Vector4 { x: this.x.w, y: this.y.w, z: this.z.w, w: this.w.w },
        }
    }

    /// Add `other`.
    add(this, other: Matrix4<T>): this.Output {
        Matrix4 {
            x: this.x + other.x,
            y: this.y + other.y,
            z: this.z + other.z,
            w: this.w + other.w,
        }
    }

    /// Subtract `other`.
    subtract(this, other: Matrix4<T>): this.Output {
        Matrix4 {
            x: this.x - other.x,
            y: this.y - other.y,
            z: this.z - other.z,
            w: this.w - other.w,
        }
    }

    /// Multiply by `other`.
    multiply(this, other: Matrix4<T>): this.Output {
        let columns = other.transpose();

        Matrix4 {
            x: Vector4 {
                x: this.x.dot(columns.x),
                y: this.x.dot(columns.y),
                z: this.x.dot(columns.z),
                w: this.x.dot(columns.w),
            },
            y: Vector4 {
                x: this.y.dot(columns.x),
                y: this.y.dot(columns.y),
                z: this.y.dot(columns.z),
                w: this.y.dot(columns.w),
            },
            z: Vector4 {
                x: this.z.dot(columns.x),
                y: this.z.dot(columns.y),
                z: this.z.dot(columns.z),
                w: this.z.dot(columns.w),
            },
            w: Vector4 {
                x: this.w.dot(columns.x),
                y: this.w.dot(columns.y),
                z: this.w.dot(columns.z),
                w: this.w.dot(columns.w),
            },
        }
    }

    /// Transform `vector`.
    transform(this, vector: Vector4<T>): Vector4<T> {
        Vector4 {
            x: this.x.dot(vector),
            y: this.y.dot(vector),
            z: this.z.dot(vector),
            w: this.w.dot(vector),
        }
    }

    /// Transform `point` with affine coordinates.
    transformPoint(this, point: Vector3<T>): Vector3<T> {
        Vector3 {
            x: this.x.x * point.x + this.x.y * point.y + this.x.z * point.z + this.x.w,
            y: this.y.x * point.x + this.y.y * point.y + this.y.z * point.z + this.y.w,
            z: this.z.x * point.x + this.z.y * point.y + this.z.z * point.z + this.z.w,
        }
    }

    /// Transform `direction` without translation.
    transformDirection(this, direction: Vector3<T>): Vector3<T> {
        Vector3 {
            x: this.x.x * direction.x + this.x.y * direction.y + this.x.z * direction.z,
            y: this.y.x * direction.x + this.y.y * direction.y + this.y.z * direction.z,
            z: this.z.x * direction.x + this.z.y * direction.y + this.z.z * direction.z,
        }
    }
}

export extension<T: Float> of Matrix4<T> {
    /// Return a perspective projection matrix.
    static perspective(fovY: T, aspect: T, near: T, far: T): Matrix4<T> {
        let height = T.one() / (fovY / (T.one() + T.one())).tan();
        let width = height / aspect;
        let depth = far / (near - far);

        Matrix4 {
            x: Vector4 { x: width, y: T.zero(), z: T.zero(), w: T.zero() },
            y: Vector4 { x: T.zero(), y: height, z: T.zero(), w: T.zero() },
            z: Vector4 { x: T.zero(), y: T.zero(), z: depth, w: depth * near },
            w: Vector4 { x: T.zero(), y: T.zero(), z: -T.one(), w: T.zero() },
        }
    }

    /// Return a view matrix looking from `eye` toward `target`.
    static lookAt(eye: Vector3<T>, target: Vector3<T>, up: Vector3<T>): Matrix4<T> {
        let ahead = (target - eye).normalized();
        let right = ahead.cross(up).normalized();
        let above = right.cross(ahead);

        Matrix4 {
            x: Vector4 { x: right.x, y: right.y, z: right.z, w: -right.dot(eye) },
            y: Vector4 { x: above.x, y: above.y, z: above.z, w: -above.dot(eye) },
            z: Vector4 { x: -ahead.x, y: -ahead.y, z: -ahead.z, w: ahead.dot(eye) },
            w: Vector4 { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() },
        }
    }

    /// Return the inverse matrix.
    inverse(this): Matrix4<T> {
        let topXY = this.x.x * this.y.y - this.x.y * this.y.x;
        let topXZ = this.x.x * this.y.z - this.x.z * this.y.x;
        let topXW = this.x.x * this.y.w - this.x.w * this.y.x;
        let topYZ = this.x.y * this.y.z - this.x.z * this.y.y;
        let topYW = this.x.y * this.y.w - this.x.w * this.y.y;
        let topZW = this.x.z * this.y.w - this.x.w * this.y.z;

        let bottomXY = this.z.x * this.w.y - this.z.y * this.w.x;
        let bottomXZ = this.z.x * this.w.z - this.z.z * this.w.x;
        let bottomXW = this.z.x * this.w.w - this.z.w * this.w.x;
        let bottomYZ = this.z.y * this.w.z - this.z.z * this.w.y;
        let bottomYW = this.z.y * this.w.w - this.z.w * this.w.y;
        let bottomZW = this.z.z * this.w.w - this.z.w * this.w.z;

        let scale = T.one()
            / (topXY * bottomZW
                - topXZ * bottomYW
                + topXW * bottomYZ
                + topYZ * bottomXW
                - topYW * bottomXZ
                + topZW * bottomXY);

        Matrix4 {
            x: Vector4 {
                x: (this.y.y * bottomZW - this.y.z * bottomYW + this.y.w * bottomYZ) * scale,
                y: (this.x.z * bottomYW - this.x.y * bottomZW - this.x.w * bottomYZ) * scale,
                z: (this.w.y * topZW - this.w.z * topYW + this.w.w * topYZ) * scale,
                w: (this.z.z * topYW - this.z.y * topZW - this.z.w * topYZ) * scale,
            },
            y: Vector4 {
                x: (this.y.z * bottomXW - this.y.x * bottomZW - this.y.w * bottomXZ) * scale,
                y: (this.x.x * bottomZW - this.x.z * bottomXW + this.x.w * bottomXZ) * scale,
                z: (this.w.z * topXW - this.w.x * topZW - this.w.w * topXZ) * scale,
                w: (this.z.x * topZW - this.z.z * topXW + this.z.w * topXZ) * scale,
            },
            z: Vector4 {
                x: (this.y.x * bottomYW - this.y.y * bottomXW + this.y.w * bottomXY) * scale,
                y: (this.x.y * bottomXW - this.x.x * bottomYW - this.x.w * bottomXY) * scale,
                z: (this.w.x * topYW - this.w.y * topXW + this.w.w * topXY) * scale,
                w: (this.z.y * topXW - this.z.x * topYW - this.z.w * topXY) * scale,
            },
            w: Vector4 {
                x: (this.y.y * bottomXZ - this.y.x * bottomYZ - this.y.z * bottomXY) * scale,
                y: (this.x.x * bottomYZ - this.x.y * bottomXZ + this.x.z * bottomXY) * scale,
                z: (this.w.y * topXZ - this.w.x * topYZ - this.w.z * topXY) * scale,
                w: (this.z.x * topYZ - this.z.y * topXZ + this.z.z * topXY) * scale,
            },
        }
    }
}
