import { todo } from "destack:error";
import { Concrete } from "destack:memory";
import { sizeOf } from "destack:reflect";
import { Integer } from "./scalar.ds";

/// Count leading zeros in an integer.
@intrinsic("math.bits.leadingZeroCount")
export declare function leadingZeroCount<T: Integer>(value: T): uint32;

/// Count leading zeros in an integer.
export function clz<T: Integer>(value: T): uint32 {
    leadingZeroCount(value)
}

/// Count trailing zeros in an integer.
@intrinsic("math.bits.trailingZeroCount")
export declare function trailingZeroCount<T: Integer>(value: T): uint32;

/// Count trailing zeros in an integer.
export function ctz<T: Integer>(value: T): uint32 {
    trailingZeroCount(value)
}

/// Count leading ones in an integer.
export function leadingOneCount<T: Integer>(value: T): uint32 {
    leadingZeroCount(~value)
}

/// Count trailing ones in an integer.
export function trailingOneCount<T: Integer>(value: T): uint32 {
    trailingZeroCount(~value)
}

/// Count set bits in an integer.
@intrinsic("math.bits.populationCount")
export declare function oneCount<T: Integer>(value: T): uint32;

/// Count set bits in an integer.
export function popcnt<T: Integer>(value: T): uint32 {
    oneCount(value)
}

/// Count unset bits in an integer.
export function zeroCount<T: Integer>(value: T): uint32 {
    ((sizeOf<T>() * 8) as uint32) - oneCount(value)
}

/// Reverse byte order.
@intrinsic("math.bits.byteSwap")
export declare function byteSwap<T: Integer>(value: T): T;

/// Return `value` with bytes interpreted as big-endian.
export function fromBigEndian<T: Integer>(value: T): T {
    todo("fromBigEndian")
}

/// Return `value` with bytes interpreted as little-endian.
export function fromLittleEndian<T: Integer>(value: T): T {
    todo("fromLittleEndian")
}

/// Return `value` encoded as big-endian.
export function toBigEndian<T: Integer>(value: T): T {
    todo("toBigEndian")
}

/// Return `value` encoded as little-endian.
export function toLittleEndian<T: Integer>(value: T): T {
    todo("toLittleEndian")
}

/// Reverse all bits.
@intrinsic("math.bits.bitReverse")
export declare function bitReverse<T: Integer>(value: T): T;

/// Reverse all bits.
export function reverseBits<T: Integer>(value: T): T {
    bitReverse(value)
}

/// Rotate bits left.
@intrinsic("math.bits.rotateLeft")
export declare function rotateLeft<T: Integer>(value: T, amount: uint32): T;

/// Rotate bits right.
@intrinsic("math.bits.rotateRight")
export declare function rotateRight<T: Integer>(value: T, amount: uint32): T;

/// Return whether `value` is a power of two.
export function isPowerOfTwo<T: Integer>(value: T): boolean {
    value > 0 && (value & (value - 1)) == 0
}

/// Return the next power of two greater than or equal to `value`.
export function nextPowerOfTwo<T: Integer>(value: T): T | undefined {
    todo("nextPowerOfTwo")
}
