import { Add, Divide, Multiply, Negate, PartialEqual, Power, Subtract } from "tspp:ops";

import { Float } from "./float.tspp";

/// Complex number with floating-point components.
@languageItem("math.Complex")
export struct Complex<T: Float> {
    /// The real component.
    real: T;

    /// The imaginary component.
    imaginary: T;
}

/// Single-precision complex number.
export type Complexf = Complex<float32>;

/// Double-precision complex number.
export type Complexd = Complex<float64>;

export extension<T: Float> of Complex<T>
    implements
        Add<Complex<T>>,
        Subtract<Complex<T>>,
        Multiply<Complex<T>>,
        Divide<Complex<T>>,
        Power<Complex<T>>,
        Negate,
        PartialEqual<Complex<T>>
{
    /// The arithmetic result type.
    type Output = Complex<T>;

    /// Create a complex value from cartesian components.
    static new(real: T, imaginary: T): Complex<T> {
        Complex { real, imaginary }
    }

    /// Return zero.
    static zero(): Complex<T> {
        Complex {
            real: T.zero(),
            imaginary: T.zero(),
        }
    }

    /// Return one.
    static one(): Complex<T> {
        Complex {
            real: T.one(),
            imaginary: T.zero(),
        }
    }

    /// Return the imaginary unit.
    static i(): Complex<T> {
        Complex {
            real: T.zero(),
            imaginary: T.one(),
        }
    }

    /// Create a complex value from polar components.
    static polar(radius: T, angle: T): Complex<T> {
        Complex {
            real: radius * angle.cos(),
            imaginary: radius * angle.sin(),
        }
    }

    /// Return the squared magnitude.
    magnitudeSquared(this): T {
        this.real * this.real + this.imaginary * this.imaginary
    }

    /// Return the magnitude.
    magnitude(this): T {
        this.magnitudeSquared().sqrt()
    }

    /// Return the phase angle in radians.
    phase(this): T {
        this.imaginary.atan2(this.real)
    }

    /// Return the complex conjugate.
    conjugate(this): Complex<T> {
        Complex { real: this.real, imaginary: -this.imaginary }
    }

    /// Return the multiplicative inverse.
    inverse(this): Complex<T> {
        let scale = T.one() / this.magnitudeSquared();

        Complex { real: this.real * scale, imaginary: -this.imaginary * scale }
    }

    /// Return this value divided by its magnitude.
    normalized(this): Complex<T> {
        let magnitude = this.magnitude();

        Complex { real: this.real / magnitude, imaginary: this.imaginary / magnitude }
    }

    /// Return the complex exponential.
    exp(this): Complex<T> {
        Complex.polar(this.real.exp(), this.imaginary)
    }

    /// Return the natural logarithm.
    log(this): Complex<T> {
        Complex { real: this.magnitude().log(), imaginary: this.phase() }
    }

    /// Return the square root.
    sqrt(this): Complex<T> {
        Complex.polar(this.magnitude().sqrt(), this.phase() / (T.one() + T.one()))
    }

    /// Raise this value to `exponent`.
    power(this, exponent: Complex<T>): Complex<T> {
        this.log().multiply(exponent).exp()
    }

    /// Return the complex sine.
    sin(this): Complex<T> {
        Complex {
            real: this.real.sin() * this.imaginary.cosh(),
            imaginary: this.real.cos() * this.imaginary.sinh(),
        }
    }

    /// Return the complex cosine.
    cos(this): Complex<T> {
        Complex {
            real: this.real.cos() * this.imaginary.cosh(),
            imaginary: -(this.real.sin() * this.imaginary.sinh()),
        }
    }

    /// Return the complex tangent.
    tan(this): Complex<T> {
        this.sin().divide(this.cos())
    }

    /// Return the hyperbolic sine.
    sinh(this): Complex<T> {
        Complex {
            real: this.real.sinh() * this.imaginary.cos(),
            imaginary: this.real.cosh() * this.imaginary.sin(),
        }
    }

    /// Return the hyperbolic cosine.
    cosh(this): Complex<T> {
        Complex {
            real: this.real.cosh() * this.imaginary.cos(),
            imaginary: this.real.sinh() * this.imaginary.sin(),
        }
    }

    /// Return the hyperbolic tangent.
    tanh(this): Complex<T> {
        this.sinh().divide(this.cosh())
    }

    /// Return whether both components are finite.
    isFinite(this): boolean {
        this.real.isFinite() && this.imaginary.isFinite()
    }

    /// Return whether either component is NaN.
    isNaN(this): boolean {
        this.real.isNaN() || this.imaginary.isNaN()
    }

    /// Add `other`.
    add(this, other: Complex<T>): this.Output {
        Complex {
            real: this.real + other.real,
            imaginary: this.imaginary + other.imaginary,
        }
    }

    /// Subtract `other`.
    subtract(this, other: Complex<T>): this.Output {
        Complex {
            real: this.real - other.real,
            imaginary: this.imaginary - other.imaginary,
        }
    }

    /// Multiply by `other`.
    multiply(this, other: Complex<T>): this.Output {
        Complex {
            real: this.real * other.real - this.imaginary * other.imaginary,
            imaginary: this.real * other.imaginary + this.imaginary * other.real,
        }
    }

    /// Divide by `other`.
    divide(this, other: Complex<T>): this.Output {
        let denominator = other.real * other.real + other.imaginary * other.imaginary;

        Complex {
            real: (this.real * other.real + this.imaginary * other.imaginary) / denominator,
            imaginary: (this.imaginary * other.real - this.real * other.imaginary) / denominator,
        }
    }

    /// Negate this value.
    negate(this): this.Output {
        Complex { real: -this.real, imaginary: -this.imaginary }
    }

    /// Return whether both components are equal.
    equal(&immutable this, other: &immutable Complex<T>): boolean {
        this.real == other.real && this.imaginary == other.imaginary
    }
}
