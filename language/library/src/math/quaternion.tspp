import { Multiply } from "tspp:ops";

import { Float } from "./float.tspp";
import { Vector3 } from "./linear.tspp";
import { Matrix3 } from "./matrix.tspp";

/// Quaternion rotation value.
@languageItem("math.Quaternion")
export struct Quaternion<T: Float> {
    /// The vector x component.
    x: T;

    /// The vector y component.
    y: T;

    /// The vector z component.
    z: T;

    /// The scalar component.
    w: T;
}

/// Single-precision quaternion.
export type Quaternionf = Quaternion<float32>;

/// Double-precision quaternion.
export type Quaterniond = Quaternion<float64>;

export extension<T: Float> of Quaternion<T> implements Multiply<Quaternion<T>> {
    /// The arithmetic result type.
    type Output = Quaternion<T>;

    /// Return the identity rotation.
    static identity(): Quaternion<T> {
        Quaternion { x: T.zero(), y: T.zero(), z: T.zero(), w: T.one() }
    }

    /// Create a rotation from an axis and angle in radians.
    static fromAxisAngle(axis: Vector3<T>, angle: T): Quaternion<T> {
        let two = T.one() + T.one();
        let half = angle / two;
        let sin = half.sin();

        Quaternion { x: axis.x * sin, y: axis.y * sin, z: axis.z * sin, w: half.cos() }
    }

    /// Create a rotation from Euler angles in radians.
    static fromEuler(euler: Vector3<T>): Quaternion<T> {
        let two = T.one() + T.one();
        let rollCos = (euler.x / two).cos();
        let rollSin = (euler.x / two).sin();
        let pitchCos = (euler.y / two).cos();
        let pitchSin = (euler.y / two).sin();
        let yawCos = (euler.z / two).cos();
        let yawSin = (euler.z / two).sin();

        Quaternion {
            x: rollSin * pitchCos * yawCos - rollCos * pitchSin * yawSin,
            y: rollCos * pitchSin * yawCos + rollSin * pitchCos * yawSin,
            z: rollCos * pitchCos * yawSin - rollSin * pitchSin * yawCos,
            w: rollCos * pitchCos * yawCos + rollSin * pitchSin * yawSin,
        }
    }

    /// Create a rotation from `from` to `to`.
    static fromToRotation(from: Vector3<T>, to: Vector3<T>): Quaternion<T> {
        let axis = from.cross(to);
        let scalar = T.one() + from.dot(to);

        if (scalar > T.zero()) {
            return Quaternion { x: axis.x, y: axis.y, z: axis.z, w: scalar }.normalized();
        }

        let opposed = from.x.abs() > from.z.abs()
            ? Vector3 { x: -from.y, y: from.x, z: T.zero() }
            : Vector3 { x: T.zero(), y: -from.z, z: from.y };

        Quaternion { x: opposed.x, y: opposed.y, z: opposed.z, w: T.zero() }.normalized()
    }

    /// Create a rotation looking in `forward` with `up` as vertical reference.
    static lookRotation(forward: Vector3<T>, up: Vector3<T>): Quaternion<T> {
        let two = T.one() + T.one();
        let ahead = forward.normalized();
        let right = up.cross(ahead).normalized();
        let above = ahead.cross(right);
        let trace = right.x + above.y + ahead.z;

        if (trace > T.zero()) {
            let scale = (trace + T.one()).sqrt() * (T.one() + T.one());

            return Quaternion {
                x: (above.z - ahead.y) / scale,
                y: (ahead.x - right.z) / scale,
                z: (right.y - above.x) / scale,
                w: scale / (two + two),
            };
        }

        if (right.x > above.y && right.x > ahead.z) {
            let scale = (T.one() + right.x - above.y - ahead.z).sqrt() * two;

            return Quaternion {
                x: scale / (two + two),
                y: (above.x + right.y) / scale,
                z: (ahead.x + right.z) / scale,
                w: (above.z - ahead.y) / scale,
            };
        }

        if (above.y > ahead.z) {
            let scale = (T.one() + above.y - right.x - ahead.z).sqrt() * two;

            return Quaternion {
                x: (above.x + right.y) / scale,
                y: scale / (two + two),
                z: (ahead.y + above.z) / scale,
                w: (ahead.x - right.z) / scale,
            };
        }

        let scale = (T.one() + ahead.z - right.x - above.y).sqrt() * two;

        Quaternion {
            x: (ahead.x + right.z) / scale,
            y: (ahead.y + above.z) / scale,
            z: scale / (two + two),
            w: (right.y - above.x) / scale,
        }
    }

    /// Return the dot product with `other`.
    dot(this, other: Quaternion<T>): T {
        this.x * other.x + this.y * other.y + this.z * other.z + this.w * other.w
    }

    /// Return the squared length.
    lengthSquared(this): T {
        this.dot(this)
    }

    /// Return the length.
    length(this): T {
        this.lengthSquared().sqrt()
    }

    /// Return the normalized quaternion.
    normalized(this): Quaternion<T> {
        let length = this.length();

        Quaternion {
            x: this.x / length,
            y: this.y / length,
            z: this.z / length,
            w: this.w / length,
        }
    }

    /// Return a normalized quaternion, or identity when the length is zero.
    normalizedOrIdentity(this): Quaternion<T> {
        let length = this.length();

        if (length == T.zero()) {
            Quaternion.identity()
        } else {
            Quaternion {
                x: this.x / length,
                y: this.y / length,
                z: this.z / length,
                w: this.w / length,
            }
        }
    }

    /// Return the conjugate quaternion.
    conjugate(this): Quaternion<T> {
        Quaternion { x: -this.x, y: -this.y, z: -this.z, w: this.w }
    }

    /// Return the inverse rotation.
    inverse(this): Quaternion<T> {
        let scale = T.one() / this.lengthSquared();

        Quaternion {
            x: -this.x * scale,
            y: -this.y * scale,
            z: -this.z * scale,
            w: this.w * scale,
        }
    }

    /// Return the rotation axis.
    axis(this): Vector3<T> {
        Vector3 { x: this.x, y: this.y, z: this.z }.normalizedOrZero()
    }

    /// Return the rotation angle in radians.
    angle(this): T {
        let two = T.one() + T.one();
        let sin = (this.x * this.x + this.y * this.y + this.z * this.z).sqrt();

        sin.atan2(this.w) * two
    }

    /// Return the angle to `other` in radians.
    angleTo(this, other: Quaternion<T>): T {
        let two = T.one() + T.one();

        this.dot(other).abs().min(T.one()).acos() * two
    }

    /// Convert this rotation to Euler angles in radians.
    toEuler(this): Vector3<T> {
        let two = T.one() + T.one();
        let pitchSin = (this.w * this.y - this.x * this.z) * two;

        Vector3 {
            x: ((this.w * this.x + this.y * this.z) * two).atan2(
                T.one() - (this.x * this.x + this.y * this.y) * two,
            ),
            y: pitchSin.min(T.one()).max(-T.one()).asin(),
            z: ((this.w * this.z + this.x * this.y) * two).atan2(
                T.one() - (this.y * this.y + this.z * this.z) * two,
            ),
        }
    }

    /// Convert this rotation to axis-angle representation.
    toAxisAngle(this): (Vector3<T>, T) {
        (this.axis(), this.angle())
    }

    /// Convert this rotation to a matrix.
    toMatrix(this): Matrix3<T> {
        let two = T.one() + T.one();
        let xx = this.x * this.x;
        let yy = this.y * this.y;
        let zz = this.z * this.z;

        Matrix3 {
            x: Vector3 {
                x: T.one() - (yy + zz) * two,
                y: (this.x * this.y - this.w * this.z) * two,
                z: (this.x * this.z + this.w * this.y) * two,
            },
            y: Vector3 {
                x: (this.x * this.y + this.w * this.z) * two,
                y: T.one() - (xx + zz) * two,
                z: (this.y * this.z - this.w * this.x) * two,
            },
            z: Vector3 {
                x: (this.x * this.z - this.w * this.y) * two,
                y: (this.y * this.z + this.w * this.x) * two,
                z: T.one() - (xx + yy) * two,
            },
        }
    }

    /// Multiply by `other`.
    multiply(this, other: Quaternion<T>): this.Output {
        Quaternion {
            x: this.w * other.x + this.x * other.w + this.y * other.z - this.z * other.y,
            y: this.w * other.y - this.x * other.z + this.y * other.w + this.z * other.x,
            z: this.w * other.z + this.x * other.y - this.y * other.x + this.z * other.w,
            w: this.w * other.w - this.x * other.x - this.y * other.y - this.z * other.z,
        }
    }

    /// Rotate `vector`.
    rotate(this, vector: Vector3<T>): Vector3<T> {
        let two = T.one() + T.one();
        let axis = Vector3 { x: this.x, y: this.y, z: this.z };
        let cross = axis.cross(vector);
        let scale = this.w * this.w - axis.dot(axis);
        let along = axis.dot(vector) * two;
        let twist = this.w * two;

        Vector3 {
            x: vector.x * scale + axis.x * along + cross.x * twist,
            y: vector.y * scale + axis.y * along + cross.y * twist,
            z: vector.z * scale + axis.z * along + cross.z * twist,
        }
    }

    /// Linearly interpolate toward `other` and normalize the result.
    nlerp(this, other: Quaternion<T>, weight: T): Quaternion<T> {
        let scale = this.dot(other) < T.zero() ? -weight : weight;
        let keep = T.one() - weight;

        Quaternion {
            x: this.x * keep + other.x * scale,
            y: this.y * keep + other.y * scale,
            z: this.z * keep + other.z * scale,
            w: this.w * keep + other.w * scale,
        }.normalized()
    }

    /// Spherically interpolate toward `other`.
    slerp(this, other: Quaternion<T>, weight: T): Quaternion<T> {
        this.slerpUnclamped(other, weight.min(T.one()).max(T.zero()))
    }

    /// Spherically interpolate toward `other` without clamping `weight`.
    slerpUnclamped(this, other: Quaternion<T>, weight: T): Quaternion<T> {
        let dot = this.dot(other);
        let bias = dot < T.zero() ? -T.one() : T.one();
        let angle = (dot * bias).min(T.one()).acos();
        let sin = angle.sin();

        if (sin == T.zero()) {
            return this.nlerp(other, weight);
        }

        let keep = (angle * (T.one() - weight)).sin() / sin;
        let scale = (angle * weight).sin() / sin * bias;

        Quaternion {
            x: this.x * keep + other.x * scale,
            y: this.y * keep + other.y * scale,
            z: this.z * keep + other.z * scale,
            w: this.w * keep + other.w * scale,
        }
    }
}
