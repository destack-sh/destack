import { Add, Multiply, Negate, Subtract } from "destack:ops";

import { Arithmetic } from "./arithmetic.ds";
import { Integer } from "./integer.ds";

/// Integer wrapper whose operators use modular arithmetic.
export newtype Wrapping<T: Integer> = T;

export extension<T: Integer> of Wrapping<T> implements Add<Wrapping<T>> {
    type Output = Wrapping<T>;

    /// Add with modular arithmetic.
    add(other: Wrapping<T>): this.Output {
        Wrapping((this as T).wrappingAdd(other as T))
    }
}

export extension<T: Integer> of Wrapping<T> implements Subtract<Wrapping<T>> {
    type Output = Wrapping<T>;

    /// Subtract with modular arithmetic.
    subtract(other: Wrapping<T>): this.Output {
        Wrapping((this as T).wrappingSubtract(other as T))
    }
}

export extension<T: Integer> of Wrapping<T> implements Multiply<Wrapping<T>> {
    type Output = Wrapping<T>;

    /// Multiply with modular arithmetic.
    multiply(other: Wrapping<T>): this.Output {
        Wrapping((this as T).wrappingMultiply(other as T))
    }
}

export extension<T: Integer> of Wrapping<T> implements Negate {
    type Output = Wrapping<T>;

    /// Negate with modular arithmetic.
    negate(): this.Output {
        Wrapping((this as T).wrappingNegate())
    }
}
