import { Slice } from "destack:collections";
import { Result, todo } from "destack:error";
import { IntlError, Locales, NumberFormatOptions, ToLocaleString } from "destack:intl";
import { MaybeUninit } from "destack:memory";
import {
    Add,
    And,
    Compare,
    Divide,
    Equal,
    Hash,
    Hasher,
    Multiply,
    Not,
    Or,
    Ordering,
    Power,
    Remainder,
    ShiftLeft,
    ShiftRight,
    Subtract,
    Xor,
} from "destack:ops";

/// Arbitrary-precision integer.
@languageItem("math.BigInt")
export class BigInt {
    /// The sign of this integer: -1, 0, or 1.
    private sign: int8 = 0;

    /// The little-endian magnitude limb storage, whose slice length is the capacity.
    private limbs: ^[MaybeUninit<uint64>] = Slice.new();

    /// The significant limb count, with no trailing zero limbs.
    private length: usize = 0;
}

export extension of BigInt {
    /// Return zero.
    static zero(): bigint {
        todo("BigInt.zero")
    }

    /// Return one.
    static one(): bigint {
        todo("BigInt.one")
    }

    /// Convert `value` to a bigint.
    static from(value: string | number | bigint): bigint {
        todo("BigInt.from")
    }

    /// Parse a bigint from `text`.
    static parse(text: string, radix?: number): bigint {
        todo("BigInt.parse")
    }

    /// Return the signed low bits of `value`.
    static asIntN(bits: number, value: bigint): bigint {
        todo("BigInt.asIntN")
    }

    /// Return the unsigned low bits of `value`.
    static asUintN(bits: number, value: bigint): bigint {
        todo("BigInt.asUintN")
    }
}

export extension of bigint
    implements
        Add<bigint>,
        And<bigint>,
        Compare<bigint>,
        Divide<bigint>,
        Equal<bigint>,
        Hash,
        Multiply<bigint>,
        Not,
        Or<bigint>,
        Power<bigint>,
        Remainder<bigint>,
        ShiftLeft<usize>,
        ShiftRight<usize>,
        Subtract<bigint>,
        ToLocaleString,
        Xor<bigint>
{
    /// The arithmetic result type.
    type Output = bigint;

    /// Return whether this integer is zero.
    get isZero(&readonly this): boolean {
        todo("BigInt.isZero")
    }

    /// Return whether this integer is negative.
    get isNegative(&readonly this): boolean {
        todo("BigInt.isNegative")
    }

    /// Return the absolute value.
    abs(&readonly this): bigint {
        todo("BigInt.abs")
    }

    /// Return the greatest common divisor with `other`.
    gcd(&readonly this, other: bigint): bigint {
        todo("BigInt.gcd")
    }

    /// Return the least common multiple with `other`.
    lcm(&readonly this, other: bigint): bigint {
        todo("BigInt.lcm")
    }

    /// Return -1, 0, or 1 according to this integer's sign.
    signum(&readonly this): int32 {
        todo("BigInt.signum")
    }

    /// Return a float64 approximation.
    toNumber(&readonly this): number {
        todo("BigInt.toNumber")
    }

    /// Return the primitive bigint value.
    valueOf(&readonly this): bigint {
        todo("BigInt.valueOf")
    }

    /// Return this integer as a string.
    toString(&readonly this, radix?: number): string {
        todo("BigInt.toString")
    }

    /// Return this integer as a locale-aware string.
    toLocaleString(&readonly this): string {
        todo("BigInt.toLocaleStringDefault")
    }

    /// Return this integer as a locale-aware string with explicit locales.
    toLocaleString(&readonly this, locales: Locales): Result<string, IntlError> {
        todo("BigInt.toLocaleStringLocales")
    }

    /// Return this integer as a locale-aware string with explicit options.
    toLocaleString(
        &readonly this,
        locales?: Locales,
        options?: NumberFormatOptions,
    ): Result<string, IntlError> {
        todo("BigInt.toLocaleString")
    }

    /// Return whether this integer equals `other`.
    equal(this: &immutable this, other: &immutable bigint): boolean {
        todo("BigInt.equal")
    }

    /// Compare partially with `other`.
    partialCompare(
        this: &immutable this,
        other: &immutable bigint,
    ): Ordering | null {
        this.compare(other)
    }

    /// Add this integer to `state`.
    hash(this: &immutable this, state: &Hasher): void {
        todo("BigInt.hash");
    }

    /// Compare with `other`.
    compare(this: &immutable this, other: &immutable bigint): Ordering {
        todo("BigInt.compare")
    }

    /// Add `other`.
    add(&readonly this, other: bigint): this.Output {
        todo("BigInt.add")
    }

    /// Subtract `other`.
    subtract(&readonly this, other: bigint): this.Output {
        todo("BigInt.subtract")
    }

    /// Multiply by `other`.
    multiply(&readonly this, other: bigint): this.Output {
        todo("BigInt.multiply")
    }

    /// Divide by `other`.
    divide(&readonly this, other: bigint): this.Output {
        todo("BigInt.divide")
    }

    /// Return the remainder after division by `other`.
    remainder(&readonly this, other: bigint): this.Output {
        todo("BigInt.remainder")
    }

    /// Raise this integer to `exponent`.
    power(&readonly this, exponent: bigint): this.Output {
        todo("BigInt.power")
    }

    /// Return the bitwise and with `other`.
    and(&readonly this, other: bigint): this.Output {
        todo("BigInt.and")
    }

    /// Return the bitwise or with `other`.
    or(&readonly this, other: bigint): this.Output {
        todo("BigInt.or")
    }

    /// Return the bitwise xor with `other`.
    xor(&readonly this, other: bigint): this.Output {
        todo("BigInt.xor")
    }

    /// Return the bitwise complement.
    not(&readonly this): this.Output {
        todo("BigInt.not")
    }

    /// Shift left by `amount`.
    shiftLeft(&readonly this, amount: usize): this.Output {
        todo("BigInt.shiftLeft")
    }

    /// Shift right by `amount`.
    shiftRight(&readonly this, amount: usize): this.Output {
        todo("BigInt.shiftRight")
    }
}
