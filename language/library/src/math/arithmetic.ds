import { todo } from "destack:error";

import { Integer } from "./integer.ds";

/// Explicit overflow behaviors for builtin integer arithmetic.
export extension Arithmetic<T: Integer> of T {
    /// Return `this + other`, or `undefined` on overflow.
    checkedAdd(other: T): T | undefined {
        let (result, overflow) = overflowingAdd(this, other);

        if (overflow) {
            return undefined;
        }

        result
    }

    /// Return `this - other`, or `undefined` on overflow.
    checkedSubtract(other: T): T | undefined {
        let (result, overflow) = overflowingSubtract(this, other);

        if (overflow) {
            return undefined;
        }

        result
    }

    /// Return `this * other`, or `undefined` on overflow.
    checkedMultiply(other: T): T | undefined {
        let (result, overflow) = overflowingMultiply(this, other);

        if (overflow) {
            return undefined;
        }

        result
    }

    /// Return `this / other`, or `undefined` on division by zero or overflow.
    checkedDivide(other: T): T | undefined {
        todo("Integer.checkedDivide")
    }

    /// Return `this % other`, or `undefined` on division by zero or overflow.
    checkedRemainder(other: T): T | undefined {
        todo("Integer.checkedRemainder")
    }

    /// Return the Euclidean quotient, or `undefined` on division by zero or overflow.
    checkedDivideEuclidean(other: T): T | undefined {
        todo("Integer.checkedDivideEuclidean")
    }

    /// Return the Euclidean remainder, or `undefined` on division by zero or overflow.
    checkedRemainderEuclidean(other: T): T | undefined {
        todo("Integer.checkedRemainderEuclidean")
    }

    /// Return `-this`, or `undefined` on overflow.
    checkedNegate(): T | undefined {
        todo("Integer.checkedNegate")
    }

    /// Return the absolute value, or `undefined` on overflow.
    checkedAbs(): T | undefined {
        todo("Integer.checkedAbs")
    }

    /// Return `this ** exponent`, or `undefined` on overflow.
    checkedPower(exponent: uint32): T | undefined {
        todo("Integer.checkedPower")
    }

    /// Shift left, or `undefined` when the shift amount is out of range.
    checkedShiftLeft(amount: uint32): T | undefined {
        todo("Integer.checkedShiftLeft")
    }

    /// Shift right, or `undefined` when the shift amount is out of range.
    checkedShiftRight(amount: uint32): T | undefined {
        todo("Integer.checkedShiftRight")
    }

    /// Return wrapped `this + other` with an overflow flag.
    overflowingAdd(other: T): (T, boolean) {
        overflowingAdd(this, other)
    }

    /// Return wrapped `this - other` with an overflow flag.
    overflowingSubtract(other: T): (T, boolean) {
        overflowingSubtract(this, other)
    }

    /// Return wrapped `this * other` with an overflow flag.
    overflowingMultiply(other: T): (T, boolean) {
        overflowingMultiply(this, other)
    }

    /// Return wrapped `this / other` with an overflow flag.
    overflowingDivide(other: T): (T, boolean) {
        todo("Integer.overflowingDivide")
    }

    /// Return wrapped `this % other` with an overflow flag.
    overflowingRemainder(other: T): (T, boolean) {
        todo("Integer.overflowingRemainder")
    }

    /// Return the wrapped Euclidean quotient with an overflow flag.
    overflowingDivideEuclidean(other: T): (T, boolean) {
        todo("Integer.overflowingDivideEuclidean")
    }

    /// Return the wrapped Euclidean remainder with an overflow flag.
    overflowingRemainderEuclidean(other: T): (T, boolean) {
        todo("Integer.overflowingRemainderEuclidean")
    }

    /// Return wrapped `-this` with an overflow flag.
    overflowingNegate(): (T, boolean) {
        todo("Integer.overflowingNegate")
    }

    /// Return the wrapped absolute value with an overflow flag.
    overflowingAbs(): (T, boolean) {
        todo("Integer.overflowingAbs")
    }

    /// Return wrapped `this ** exponent` with an overflow flag.
    overflowingPower(exponent: uint32): (T, boolean) {
        todo("Integer.overflowingPower")
    }

    /// Shift left with an out-of-range flag.
    overflowingShiftLeft(amount: uint32): (T, boolean) {
        todo("Integer.overflowingShiftLeft")
    }

    /// Shift right with an out-of-range flag.
    overflowingShiftRight(amount: uint32): (T, boolean) {
        todo("Integer.overflowingShiftRight")
    }

    /// Return `this + other` with modular arithmetic.
    wrappingAdd(other: T): T {
        todo("Integer.wrappingAdd")
    }

    /// Return `this - other` with modular arithmetic.
    wrappingSubtract(other: T): T {
        todo("Integer.wrappingSubtract")
    }

    /// Return `this * other` with modular arithmetic.
    wrappingMultiply(other: T): T {
        todo("Integer.wrappingMultiply")
    }

    /// Return `this / other`, wrapping the one overflowing case.
    wrappingDivide(other: T): T {
        todo("Integer.wrappingDivide")
    }

    /// Return `this % other`, wrapping the one overflowing case.
    wrappingRemainder(other: T): T {
        todo("Integer.wrappingRemainder")
    }

    /// Return the Euclidean quotient, wrapping the one overflowing case.
    wrappingDivideEuclidean(other: T): T {
        todo("Integer.wrappingDivideEuclidean")
    }

    /// Return the Euclidean remainder, wrapping the one overflowing case.
    wrappingRemainderEuclidean(other: T): T {
        todo("Integer.wrappingRemainderEuclidean")
    }

    /// Return `-this` with modular arithmetic.
    wrappingNegate(): T {
        todo("Integer.wrappingNegate")
    }

    /// Return the absolute value with modular arithmetic.
    wrappingAbs(): T {
        todo("Integer.wrappingAbs")
    }

    /// Return `this ** exponent` with modular arithmetic.
    wrappingPower(exponent: uint32): T {
        todo("Integer.wrappingPower")
    }

    /// Shift left with a masked shift amount.
    wrappingShiftLeft(amount: uint32): T {
        todo("Integer.wrappingShiftLeft")
    }

    /// Shift right with a masked shift amount.
    wrappingShiftRight(amount: uint32): T {
        todo("Integer.wrappingShiftRight")
    }

    /// Return `this + other`, clamping at the bounds.
    saturatingAdd(other: T): T {
        saturatingAdd(this, other)
    }

    /// Return `this - other`, clamping at the bounds.
    saturatingSubtract(other: T): T {
        saturatingSubtract(this, other)
    }

    /// Return `this * other`, clamping at the bounds.
    saturatingMultiply(other: T): T {
        todo("Integer.saturatingMultiply")
    }

    /// Return `-this`, clamping at the bounds.
    saturatingNegate(): T {
        todo("Integer.saturatingNegate")
    }

    /// Return the absolute value, clamping at the bounds.
    saturatingAbs(): T {
        todo("Integer.saturatingAbs")
    }

    /// Return `this ** exponent`, clamping at the bounds.
    saturatingPower(exponent: uint32): T {
        todo("Integer.saturatingPower")
    }

    /// Add without overflow checks.
    @unsafe
    uncheckedAdd(other: T): T {
        uncheckedAdd(this, other)
    }

    /// Subtract without overflow checks.
    @unsafe
    uncheckedSubtract(other: T): T {
        uncheckedSubtract(this, other)
    }

    /// Multiply without overflow checks.
    @unsafe
    uncheckedMultiply(other: T): T {
        uncheckedMultiply(this, other)
    }

    /// Divide without division checks.
    @unsafe
    uncheckedDivide(other: T): T {
        uncheckedDivide(this, other)
    }

    /// Return a remainder without division checks.
    @unsafe
    uncheckedRemainder(other: T): T {
        uncheckedRemainder(this, other)
    }

    /// Shift left without checking the shift amount.
    @unsafe
    uncheckedShiftLeft(amount: uint32): T {
        uncheckedShiftLeft(this, amount)
    }

    /// Shift right without checking the shift amount.
    @unsafe
    uncheckedShiftRight(amount: uint32): T {
        uncheckedShiftRight(this, amount)
    }
}

/// Add and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.add")
declare function overflowingAdd<T: Integer>(a: T, b: T): (T, boolean);

/// Subtract and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.subtract")
declare function overflowingSubtract<T: Integer>(a: T, b: T): (T, boolean);

/// Multiply and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.multiply")
declare function overflowingMultiply<T: Integer>(a: T, b: T): (T, boolean);

/// Add with saturation at numeric bounds.
@intrinsic("math.arithmetic.saturating.add")
declare function saturatingAdd<T: Integer>(a: T, b: T): T;

/// Subtract with saturation at numeric bounds.
@intrinsic("math.arithmetic.saturating.subtract")
declare function saturatingSubtract<T: Integer>(a: T, b: T): T;

/// Add without overflow checks.
@intrinsic("math.arithmetic.unchecked.add")
@unsafe
declare function uncheckedAdd<T: Integer>(a: T, b: T): T;

/// Subtract without overflow checks.
@intrinsic("math.arithmetic.unchecked.subtract")
@unsafe
declare function uncheckedSubtract<T: Integer>(a: T, b: T): T;

/// Multiply without overflow checks.
@intrinsic("math.arithmetic.unchecked.multiply")
@unsafe
declare function uncheckedMultiply<T: Integer>(a: T, b: T): T;

/// Divide without division checks.
@intrinsic("math.arithmetic.unchecked.divide")
@unsafe
declare function uncheckedDivide<T: Integer>(a: T, b: T): T;

/// Return remainder without division checks.
@intrinsic("math.arithmetic.unchecked.remainder")
@unsafe
declare function uncheckedRemainder<T: Integer>(a: T, b: T): T;

/// Shift left without checking the shift amount.
@intrinsic("math.arithmetic.unchecked.shiftLeft")
@unsafe
declare function uncheckedShiftLeft<T: Integer>(value: T, amount: uint32): T;

/// Shift right without checking the shift amount.
@intrinsic("math.arithmetic.unchecked.shiftRight")
@unsafe
declare function uncheckedShiftRight<T: Integer>(value: T, amount: uint32): T;
