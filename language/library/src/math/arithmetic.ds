import { todo } from "destack:error";

/// Return `a + b`, or `undefined` on overflow.
export function checkedAdd<T: int>(a: T, b: T): T | undefined {
    let (result, overflow) = overflowingAdd(a, b);

    if (overflow) {
        return undefined;
    }

    result
}

/// Return `a - b`, or `undefined` on overflow.
export function checkedSubtract<T: int>(a: T, b: T): T | undefined {
    let (result, overflow) = overflowingSubtract(a, b);

    if (overflow) {
        return undefined;
    }

    result
}

/// Return `a * b`, or `undefined` on overflow.
export function checkedMultiply<T: int>(a: T, b: T): T | undefined {
    let (result, overflow) = overflowingMultiply(a, b);

    if (overflow) {
        return undefined;
    }

    result
}

/// Return `a / b`, or `undefined` on division by zero or overflow.
export function checkedDivide<T: int>(a: T, b: T): T | undefined {
    todo("checkedDivide")
}

/// Return `a % b`, or `undefined` on division by zero or overflow.
export function checkedRemainder<T: int>(a: T, b: T): T | undefined {
    todo("checkedRemainder")
}

/// Return Euclidean division, or `undefined` on division by zero or overflow.
export function checkedDivideEuclidean<T: int>(a: T, b: T): T | undefined {
    todo("checkedDivideEuclidean")
}

/// Return Euclidean remainder, or `undefined` on division by zero or overflow.
export function checkedRemainderEuclidean<T: int>(a: T, b: T): T | undefined {
    todo("checkedRemainderEuclidean")
}

/// Return `-value`, or `undefined` on overflow.
export function checkedNegate<T: int>(value: T): T | undefined {
    todo("checkedNegate")
}

/// Return absolute value, or `undefined` on overflow.
export function checkedAbs<T: int>(value: T): T | undefined {
    todo("checkedAbs")
}

/// Return `base ** exponent`, or `undefined` on overflow.
export function checkedPower<T: int>(base: T, exponent: uint32): T | undefined {
    todo("checkedPower")
}

/// Return `value << amount`, or `undefined` when the shift is invalid.
export function checkedShiftLeft<T: int>(value: T, amount: uint32): T | undefined {
    todo("checkedShiftLeft")
}

/// Return `value >> amount`, or `undefined` when the shift is invalid.
export function checkedShiftRight<T: int>(value: T, amount: uint32): T | undefined {
    todo("checkedShiftRight")
}

/// Add and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.add")
export declare function overflowingAdd<T: int>(a: T, b: T): [T, boolean];

/// Subtract and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.subtract")
export declare function overflowingSubtract<T: int>(a: T, b: T): [T, boolean];

/// Multiply and report whether overflow occurred.
@intrinsic("math.arithmetic.overflowing.multiply")
export declare function overflowingMultiply<T: int>(a: T, b: T): [T, boolean];

/// Divide and report whether overflow occurred.
export function overflowingDivide<T: int>(a: T, b: T): [T, boolean] {
    todo("overflowingDivide")
}

/// Return remainder and report whether overflow occurred.
export function overflowingRemainder<T: int>(a: T, b: T): [T, boolean] {
    todo("overflowingRemainder")
}

