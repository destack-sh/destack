export declare function saturatingAdd<T: int>(a: T, b: T): T;

/// Subtract with saturation at numeric bounds.
@intrinsic("math.arithmetic.saturating.subtract")
export declare function saturatingSubtract<T: int>(a: T, b: T): T;

