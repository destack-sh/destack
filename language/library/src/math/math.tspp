import { todo } from "tspp:error";
import { Iterable } from "tspp:iter";

/// Floating point math functions and constants.
@languageItem("math.Math")
export class Math {
    /// Euler's number.
    static readonly E: number = 2.718281828459045;

    /// The natural logarithm of 10.
    static readonly LN10: number = 2.302585092994046;

    /// The natural logarithm of 2.
    static readonly LN2: number = 0.6931471805599453;

    /// The base-2 logarithm of Euler's number.
    static readonly LOG2E: number = 1.4426950408889634;

    /// The base-10 logarithm of Euler's number.
    static readonly LOG10E: number = 0.4342944819032518;

    /// Pi.
    static readonly PI: number = 3.141592653589793;

    /// The square root of 1/2.
    static readonly SQRT1_2: number = 0.7071067811865476;

    /// The square root of 2.
    static readonly SQRT2: number = 1.4142135623730951;

    /// Return the absolute value of `value`.
    static abs(value: number): number {
        todo("Math.abs")
    }

    /// Return the arccosine of `value`.
    static acos(value: number): number {
        todo("Math.acos")
    }

    /// Return the arcsine of `value`.
    static asin(value: number): number {
        todo("Math.asin")
    }

    /// Return the arctangent of `value`.
    static atan(value: number): number {
        todo("Math.atan")
    }

    /// Return the angle from the positive x-axis to `y, x`.
    static atan2(y: number, x: number): number {
        todo("Math.atan2")
    }

    /// Return the inverse hyperbolic cosine of `value`.
    static acosh(value: number): number {
        todo("Math.acosh")
    }

    /// Return the inverse hyperbolic sine of `value`.
    static asinh(value: number): number {
        todo("Math.asinh")
    }

    /// Return the inverse hyperbolic tangent of `value`.
    static atanh(value: number): number {
        todo("Math.atanh")
    }

    /// Return the cube root of `value`.
    static cbrt(value: number): number {
        todo("Math.cbrt")
    }

    /// Return the smallest integer greater than or equal to `value`.
    static ceil(value: number): number {
        todo("Math.ceil")
    }

    /// Return the number of leading zero bits in `value` as a number.
    static clz32(value: number): number {
        todo("Math.clz32")
    }

    /// Return the cosine of `value`.
    static cos(value: number): number {
        todo("Math.cos")
    }

    /// Return the hyperbolic cosine of `value`.
    static cosh(value: number): number {
        todo("Math.cosh")
    }

    /// Return e raised to `value`.
    static exp(value: number): number {
        todo("Math.exp")
    }

    /// Return e raised to `value`, minus 1.
    static expm1(value: number): number {
        todo("Math.expm1")
    }

    /// Return the largest integer less than or equal to `value`.
    static floor(value: number): number {
        todo("Math.floor")
    }

    /// Return `value` rounded to float16 precision.
    static f16round(value: number): number {
        todo("Math.f16round")
    }

    /// Return `value` rounded to float32 precision.
    static fround(value: number): number {
        todo("Math.fround")
    }

    /// Return the square root of the sum of squared values.
    static hypot(...values: number[]): number {
        todo("Math.hypot")
    }

    /// Return the low 32 bits of signed integer multiplication.
    static imul(a: number, b: number): number {
        todo("Math.imul")
    }

    /// Return the natural logarithm of `value`.
    static log(value: number): number {
        todo("Math.log")
    }

    /// Return the natural logarithm of 1 plus `value`.
    static log1p(value: number): number {
        todo("Math.log1p")
    }

    /// Return the base-2 logarithm of `value`.
    static log2(value: number): number {
        todo("Math.log2")
    }

    /// Return the base-10 logarithm of `value`.
    static log10(value: number): number {
        todo("Math.log10")
    }

    /// Return the maximum value.
    static max(...values: number[]): number {
        todo("Math.max")
    }

    /// Return the minimum value.
    static min(...values: number[]): number {
        todo("Math.min")
    }

    /// Return `base` raised to `exponent`.
    static pow(base: number, exponent: number): number {
        todo("Math.pow")
    }

    /// Return a pseudo-random number in [0, 1).
    static random(): number {
        todo("Math.random")
    }

    /// Return `value` rounded to the nearest integer, breaking ties toward positive infinity.
    static round(value: number): number {
        todo("Math.round")
    }

    /// Return the sign of `value`.
    static sign(value: number): number {
        todo("Math.sign")
    }

    /// Return the sine of `value`.
    static sin(value: number): number {
        todo("Math.sin")
    }

    /// Return the hyperbolic sine of `value`.
    static sinh(value: number): number {
        todo("Math.sinh")
    }

    /// Return the square root of `value`.
    static sqrt(value: number): number {
        todo("Math.sqrt")
    }

    /// Return the sum of `values` without intermediate rounding.
    static sumPrecise(values: Iterable<number>): number {
        todo("Math.sumPrecise")
    }

    /// Return the tangent of `value`.
    static tan(value: number): number {
        todo("Math.tan")
    }

    /// Return the hyperbolic tangent of `value`.
    static tanh(value: number): number {
        todo("Math.tanh")
    }

    /// Return `value` with its fractional digits truncated.
    static trunc(value: number): number {
        todo("Math.trunc")
    }
}
