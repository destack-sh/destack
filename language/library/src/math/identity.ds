/// Numeric type with an additive identity.
@languageItem("math.Zero")
export newtype interface Zero {
    /// Return the additive identity.
    static zero(): this;
}

/// Numeric type with a multiplicative identity.
@languageItem("math.One")
export newtype interface One {
    /// Return the multiplicative identity.
    static one(): this;
}

/// Numeric type constructible from an integer literal.
@languageItem("math.FromIntegerLiteral")
export newtype interface FromIntegerLiteral {
    /// Return the value one integer literal denotes.
    static fromIntegerLiteral(value: int64): this;
}

/// Numeric type constructible from a float literal.
@languageItem("math.FromFloatLiteral")
export newtype interface FromFloatLiteral {
    /// Return the value one float literal denotes.
    static fromFloatLiteral(value: float64): this;
}
