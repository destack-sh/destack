import { Integer } from "./integer.tspp";
import { Numeric } from "./numeric.tspp";

/// Fixed-width vector type.
@languageItem("math.Vector")
export newtype Vector<T: Numeric | boolean, const N: usize> = intrinsic;

/// Vector mask type.
export type Mask<const N: usize> = Vector<boolean, N>;

/// Return the number of lanes in `Vector<T, N>`.
export type LaneCount<V> = V extends Vector<infer T, infer N> ? N : never;

/// Return the element type in `Vector<T, N>`.
export type LaneOf<V> = V extends Vector<infer T, infer N> ? T : never;

/// Broadcast `value` to every lane.
@intrinsic("math.vector.splat")
export declare function splat<T: Numeric | boolean, const N: usize>(value: T): Vector<T, N>;

/// Return the lane at `index`.
@intrinsic("math.vector.extract")
export declare function extract<T: Numeric | boolean, const N: usize>(
    value: Vector<T, N>,
    index: uint32,
): T;

/// Return a vector with one lane replaced.
@intrinsic("math.vector.insert")
export declare function insert<T: Numeric | boolean, const N: usize>(
    vector: Vector<T, N>,
    index: uint32,
    value: T,
): Vector<T, N>;

/// Select lanes from `a` and `b` according to `Pattern`.
@intrinsic("math.vector.shuffle")
export declare function shuffle<
    T: Numeric | boolean,
    const N: usize,
    const M: usize,
    const Pattern: [uint32; M],
>(a: Vector<T, N>, b: Vector<T, N>): Vector<T, M>;

/// Select `a[i]` when `mask[i]` is true and `b[i]` otherwise.
@intrinsic("math.vector.select")
export declare function select<T: Numeric | boolean, const N: usize>(
    mask: Vector<boolean, N>,
    a: Vector<T, N>,
    b: Vector<T, N>,
): Vector<T, N>;

/// Convert vector lanes to `U`.
@intrinsic("math.vector.convert")
export declare function convert<U: Numeric | boolean, T: Numeric | boolean, const N: usize>(
    value: Vector<T, N>,
): Vector<U, N>;

/// Load `N` contiguous values from `source`.
export function load<T: Numeric | boolean, const N: usize>(source: &readonly [T]): Vector<T, N> {
    let result = splat<T, N>(source[0]);

    for (let lane: usize = 1; lane < N; lane += 1) {
        result = insert(result, lane.truncate<uint32>(), source[lane.truncate<isize>()]);
    }

    result
}

/// Store `value` into `destination`.
export function store<T: Numeric | boolean, const N: usize>(
    destination: &[T],
    value: Vector<T, N>,
): void {
    for (let lane: usize = 0; lane < N; lane += 1) {
        destination[lane.truncate<isize>()] = extract(value, lane.truncate<uint32>());
    }
}

/// Return a lane mask for equality.
@intrinsic("math.vector.equal")
export declare function equal<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for inequality.
@intrinsic("math.vector.notEqual")
export declare function notEqual<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for less-than comparison.
@intrinsic("math.vector.less")
export declare function less<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for less-than-or-equal comparison.
@intrinsic("math.vector.lessEqual")
export declare function lessEqual<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for greater-than comparison.
@intrinsic("math.vector.greater")
export declare function greater<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Return a lane mask for greater-than-or-equal comparison.
@intrinsic("math.vector.greaterEqual")
export declare function greaterEqual<T: Numeric | boolean, const N: usize>(
    left: Vector<T, N>,
    right: Vector<T, N>,
): Mask<N>;

/// Horizontal reduction: sum all lanes.
@intrinsic("math.vector.reduce.add")
export declare function reduceAdd<T: Numeric, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: multiply all lanes.
@intrinsic("math.vector.reduce.mul")
export declare function reduceMul<T: Numeric, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: minimum of all lanes.
@intrinsic("math.vector.reduce.min")
export declare function reduceMin<T: Numeric, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: maximum of all lanes.
@intrinsic("math.vector.reduce.max")
export declare function reduceMax<T: Numeric, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise AND of all lanes.
@intrinsic("math.vector.reduce.and")
export declare function reduceAnd<T: Integer, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise OR of all lanes.
@intrinsic("math.vector.reduce.or")
export declare function reduceOr<T: Integer, const N: usize>(v: Vector<T, N>): T;

/// Horizontal reduction: bitwise XOR of all lanes.
@intrinsic("math.vector.reduce.xor")
export declare function reduceXor<T: Integer, const N: usize>(v: Vector<T, N>): T;
