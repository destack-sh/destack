import { todo } from "destack:error";

import { Integer } from "./integer.ds";

/// Convert to `U`, keeping the low bits.
@intrinsic("math.cast.int.truncate")
declare function truncateInt<T: Integer, U: Integer>(value: T): U;

/// Convert to `U`, clamping into the destination range.
@intrinsic("math.cast.int.saturate")
declare function saturateInt<T: Integer, U: Integer>(value: T): U;

/// Explicit lossy conversions between builtin integer types.
///
/// `as` between numeric types is lossless-only; these methods pick the lossy behavior explicitly.
export extension Cast<T: Integer> of T {
    /// Convert to `U`, keeping the low bits.
    truncate<U: Integer>(this): U {
        truncateInt<T, U>(this)
    }

    /// Convert to `U`, clamping into the destination range.
    saturate<U: Integer>(this): U {
        saturateInt<T, U>(this)
    }

    /// Convert to `U` when the value is representable, or return `undefined`.
    tryInto<U: Integer>(this): U | undefined {
        todo("Integer.tryInto")
    }
}
