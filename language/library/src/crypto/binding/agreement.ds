import { Array } from "destack:collections";
import { CryptoKeyHandle, CryptoStoreHandle } from "destack:crypto/binding";
import { HostError } from "destack:error/host";

import { CryptoDigestAlgorithm, CryptoKeyAgreementAlgorithm } from "./algorithm.ds";
import { CryptoDerivedKey } from "./key.ds";

/// Key-agreement HKDF derivation.
export struct CryptoAgreementHkdf<'a> {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm used by the KDF stage.
    digest: CryptoDigestAlgorithm;
    /// KDF salt bytes.
    salt: &'a readonly [uint8];
    /// KDF context info bytes.
    info: &'a readonly [uint8];
}

/// Key-agreement SP 800-56A concat derivation.
export struct CryptoAgreementSp80056aConcat<'a> {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Algorithm identifier bytes.
    algorithmId: &'a readonly [uint8];
    /// Party U info bytes.
    partyUInfo: &'a readonly [uint8];
    /// Party V info bytes.
    partyVInfo: &'a readonly [uint8];
    /// Public supplemental info bytes.
    publicInfo: &'a readonly [uint8];
    /// Private supplemental info bytes.
    privateInfo: &'a readonly [uint8];
}

/// Key-agreement X9.63 derivation.
export struct CryptoAgreementX963<'a> {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Shared info bytes.
    sharedInfo: &'a readonly [uint8];
}

/// Key-agreement X9.42 concat derivation.
export struct CryptoAgreementX942Concat<'a> {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Algorithm identifier bytes.
    algorithmId: &'a readonly [uint8];
    /// Party U info bytes.
    partyUInfo: &'a readonly [uint8];
    /// Party V info bytes.
    partyVInfo: &'a readonly [uint8];
    /// Public supplemental info bytes.
    publicInfo: &'a readonly [uint8];
    /// Private supplemental info bytes.
    privateInfo: &'a readonly [uint8];
}

/// Key-agreement derivation.
export newtype CryptoAgreementDerivation<'a> =
    | CryptoAgreementHkdf<'a>
    | CryptoAgreementSp80056aConcat<'a>
    | CryptoAgreementX963<'a>
    | CryptoAgreementX942Concat<'a>;

/// Key-agreement raw byte request.
export struct CryptoAgreementBits<'a> {
    /// Agreement derivation.
    derivation: CryptoAgreementDerivation<'a>;
    /// Derived key length in bytes.
    length: uint32;
}

/// Agreement binding family.
export interface CryptoAgreementBinding {
    /// Derive one shared secret from one local private key and one peer public key.
    @binding("destack.crypto.agreement.deriveSharedSecret", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.key.agree"],
        families: ["windows", "unix"],
    })
    deriveSharedSecret(
        privateKey: CryptoKeyHandle,
        peerPublicKey: CryptoKeyHandle,
        algorithm: CryptoKeyAgreementAlgorithm,
    ): Result<uint8[], HostError>;

    /// Derive raw bytes from one local private key and one peer public key.
    @binding("destack.crypto.agreement.deriveBits", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.key.agree", "host.crypto.kdf"],
        families: ["windows", "unix"],
    })
    deriveAgreementBits(
        privateKey: CryptoKeyHandle,
        peerPublicKey: CryptoKeyHandle,
        request: &readonly CryptoAgreementBits,
    ): Result<uint8[], HostError>;

    /// Derive one key from one local private key and one peer public key.
    @binding("destack.crypto.agreement.deriveKey", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.key.agree", "host.crypto.kdf", "host.crypto.store.write"],
        families: ["windows", "unix"],
    })
    deriveAgreementKey(
        store: CryptoStoreHandle,
        privateKey: CryptoKeyHandle,
        peerPublicKey: CryptoKeyHandle,
        derivation: &readonly CryptoAgreementDerivation,
        key: &readonly CryptoDerivedKey,
    ): Result<CryptoKeyHandle, HostError>;
}
