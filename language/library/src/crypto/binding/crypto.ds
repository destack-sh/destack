import { Binding } from "destack:binding";

import { CryptoAgreementBinding } from "./agreement.ds";
import { CryptoCertificateBinding } from "./certificate.ds";
import { CryptoCipherBinding } from "./cipher.ds";
import { CryptoDigestBinding } from "./digest.ds";
import { CryptoKdfBinding } from "./kdf.ds";
import { CryptoKeyBinding } from "./key.ds";
import { CryptoMacBinding } from "./mac.ds";
import { CryptoStoreBinding } from "./store.ds";

/// Cryptography binding family.
@languageItem("crypto.CryptoBinding")
export interface CryptoBinding {
    /// Agreement bindings.
    readonly agreement: CryptoAgreementBinding;
    /// Certificate bindings.
    readonly certificate: CryptoCertificateBinding;
    /// Cipher bindings.
    readonly cipher: CryptoCipherBinding;
    /// Digest bindings.
    readonly digest: CryptoDigestBinding;
    /// Kdf bindings.
    readonly kdf: CryptoKdfBinding;
    /// Key bindings.
    readonly key: CryptoKeyBinding;
    /// Mac bindings.
    readonly mac: CryptoMacBinding;
    /// Store bindings.
    readonly store: CryptoStoreBinding;
}

/// Current cryptography binding family.
export const crypto = new Binding<CryptoBinding>("crypto");
