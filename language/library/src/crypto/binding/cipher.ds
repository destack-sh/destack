import { Array } from "destack:collections";
import { CryptoKeyHandle } from "destack:crypto/binding";
import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

import { CryptoCipherAlgorithm } from "./algorithm.ds";

/// Handle for one cryptographic symmetric-cipher context.
export newtype CryptoCipherHandle = ResourceId;

/// Cipher direction.
export enum CryptoCipherDirection {
    /// Encrypt payload bytes.
    Encrypt = 1,
    /// Decrypt payload bytes.
    Decrypt = 2,
}

/// Cipher parameters.
export struct CryptoCipherParameters {
    /// Symmetric cipher algorithm.
    algorithm: CryptoCipherAlgorithm;
    /// Nonce or IV bytes.
    nonce: &readonly [uint8];
    /// Additional authenticated data bytes.
    additionalData?: &readonly [uint8];
    /// Authentication tag bytes for decryption.
    tag?: &readonly [uint8];
    /// Authentication tag length in bytes for encryption.
    tagLength?: uint32;
}

/// Cipher output.
export struct CryptoCipherOutput {
    /// Cipher output bytes.
    bytes: uint8[];
    /// Authentication tag for AEAD encryption.
    tag?: uint8[];
}

/// Cipher binding family.
export interface CryptoCipherBinding {
    /// Encrypt one payload in one shot.
    @binding("destack.crypto.cipher.encrypt", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    encryptCipher(
        key: CryptoKeyHandle,
        parameters: &readonly CryptoCipherParameters,
        payload: &readonly [uint8],
    ): Result<CryptoCipherOutput, HostError>;

    /// Decrypt one payload in one shot.
    @binding("destack.crypto.cipher.decrypt", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    decryptCipher(
        key: CryptoKeyHandle,
        parameters: &readonly CryptoCipherParameters,
        payload: &readonly [uint8],
    ): Result<uint8[], HostError>;

    /// Open one streaming cipher context.
    @binding("destack.crypto.cipher.open", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    openCipher(
        key: CryptoKeyHandle,
        direction: CryptoCipherDirection,
        parameters: &readonly CryptoCipherParameters,
    ): Result<CryptoCipherHandle, HostError>;

    /// Add authenticated data to one streaming cipher context.
    @binding("destack.crypto.cipher.additionalData.update", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    updateCipherAdditionalData(
        cipher: CryptoCipherHandle,
        additionalData: &readonly [uint8],
    ): Result<void, HostError>;

    /// Update one streaming cipher context with one payload chunk.
    @binding("destack.crypto.cipher.update", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    updateCipher(
        cipher: CryptoCipherHandle,
        payload: &readonly [uint8],
    ): Result<uint8[], HostError>;

    /// Finalize one streaming cipher context.
    @binding("destack.crypto.cipher.finish", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    finishCipher(
        cipher: CryptoCipherHandle,
        finalPayload: &readonly [uint8],
    ): Result<CryptoCipherOutput, HostError>;

    /// Close one streaming cipher context.
    @binding("destack.crypto.cipher.close", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.cipher"],
        families: ["windows", "unix"],
    })
    closeCipher(cipher: CryptoCipherHandle): Result<void, HostError>;
}
