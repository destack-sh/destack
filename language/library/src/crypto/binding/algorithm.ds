/// Key object kind.
export enum CryptoKeyKind {
    /// Secret symmetric key material.
    Secret = 1,
    /// Public key material.
    Public = 2,
    /// Private key material.
    Private = 3,
}

/// Key material residency.
export enum CryptoKeyResidency {
    /// Software-managed key material.
    Software = 1,
    /// Host-managed opaque key material.
    HostOpaque = 2,
    /// Hardware-managed opaque key material.
    HardwareOpaque = 3,
}

/// Key algorithm family.
export enum CryptoKeyAlgorithm {
    /// RSA key family.
    Rsa = 1,
    /// Elliptic-curve key family.
    Ec = 2,
    /// Ed25519 key family.
    Ed25519 = 3,
    /// Ed448 key family.
    Ed448 = 4,
    /// X25519 key family.
    X25519 = 5,
    /// X448 key family.
    X448 = 6,
    /// AES key family.
    Aes = 7,
    /// ChaCha20 key family.
    ChaCha20 = 8,
    /// HMAC key family.
    Hmac = 9,
}

/// Named curve selector.
export enum CryptoNamedCurve {
    /// NIST P-256.
    P256 = 1,
    /// NIST P-384.
    P384 = 2,
    /// NIST P-521.
    P521 = 3,
    /// SEC secp256k1.
    Secp256k1 = 4,
}

/// Key material format.
export enum CryptoKeyFormat {
    /// PKCS#8 PEM.
    Pkcs8Pem = 1,
    /// PKCS#8 DER.
    Pkcs8Der = 2,
    /// SubjectPublicKeyInfo PEM.
    SpkiPem = 3,
    /// SubjectPublicKeyInfo DER.
    SpkiDer = 4,
    /// JSON Web Key.
    Jwk = 5,
    /// Raw key bytes.
    Raw = 6,
    /// SEC1 PEM.
    Sec1Pem = 7,
    /// SEC1 DER.
    Sec1Der = 8,
    /// Encrypted PKCS#8 PEM.
    Pkcs8EncryptedPem = 9,
    /// Encrypted PKCS#8 DER.
    Pkcs8EncryptedDer = 10,
}

/// Digest algorithm selector.
export enum CryptoDigestAlgorithm {
    /// SHA-1.
    Sha1 = 1,
    /// SHA-224.
    Sha224 = 2,
    /// SHA-256.
    Sha256 = 3,
    /// SHA-384.
    Sha384 = 4,
    /// SHA-512.
    Sha512 = 5,
    /// SHA3-256.
    Sha3_256 = 6,
    /// SHA3-384.
    Sha3_384 = 7,
    /// SHA3-512.
    Sha3_512 = 8,
    /// BLAKE2b-512.
    Blake2b512 = 9,
    /// BLAKE2s-256.
    Blake2s256 = 10,
}

/// Signature algorithm selector.
export enum CryptoSignatureAlgorithm {
    /// RSASSA-PKCS1-v1_5.
    RsaPkcs1v15 = 1,
    /// RSASSA-PSS.
    RsaPss = 2,
    /// ECDSA.
    Ecdsa = 3,
    /// Ed25519.
    Ed25519 = 4,
    /// Ed448.
    Ed448 = 5,
}

/// Asymmetric encryption algorithm selector.
export enum CryptoAsymmetricEncryptionAlgorithm {
    /// RSAES-PKCS1-v1_5.
    RsaPkcs1v15 = 1,
    /// RSAES-OAEP.
    RsaOaep = 2,
}

/// Key wrap algorithm selector.
export enum CryptoKeyWrapAlgorithm {
    /// RSAES-OAEP key wrap.
    RsaOaep = 1,
    /// AES key wrap, RFC 3394.
    AesKw = 2,
    /// AES key wrap with padding, RFC 5649.
    AesKwp = 3,
}

/// Symmetric encryption algorithm selector.
export enum CryptoCipherAlgorithm {
    /// AES-GCM.
    AesGcm = 1,
    /// AES-CTR.
    AesCtr = 2,
    /// AES-CBC.
    AesCbc = 3,
    /// ChaCha20-Poly1305.
    ChaCha20Poly1305 = 4,
}

/// Message authentication algorithm selector.
export enum CryptoMacAlgorithm {
    /// HMAC.
    Hmac = 1,
}

/// Key-derivation algorithm selector.
export enum CryptoKdfAlgorithm {
    /// HKDF.
    Hkdf = 1,
    /// PBKDF2.
    Pbkdf2 = 2,
    /// scrypt.
    Scrypt = 3,
    /// Argon2id.
    Argon2id = 4,
    /// NIST SP 800-108 counter-mode KDF.
    Sp800108Counter = 5,
    /// NIST SP 800-56A concat KDF.
    Sp80056aConcat = 6,
    /// ANSI X9.63 KDF.
    X963 = 7,
    /// ANSI X9.42 concat KDF.
    X942Concat = 8,
    /// TLS 1.2 PRF.
    Tls12Prf = 9,
}

/// Key agreement algorithm selector.
export enum CryptoKeyAgreementAlgorithm {
    /// ECDH over one named curve.
    Ecdh = 1,
    /// X25519.
    X25519 = 2,
    /// X448.
    X448 = 3,
}

/// Key usage flags.
export newtype CryptoKeyUsageFlags = uint32;

/// Key usage: sign.
export const CRYPTO_KEY_USAGE_SIGN: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0001);

/// Key usage: verify.
export const CRYPTO_KEY_USAGE_VERIFY: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0002);

/// Key usage: encrypt.
export const CRYPTO_KEY_USAGE_ENCRYPT: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0004);

/// Key usage: decrypt.
export const CRYPTO_KEY_USAGE_DECRYPT: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0008);

/// Key usage: wrap.
export const CRYPTO_KEY_USAGE_WRAP: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0010);

/// Key usage: unwrap.
export const CRYPTO_KEY_USAGE_UNWRAP: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0020);

/// Key usage: derive bits.
export const CRYPTO_KEY_USAGE_DERIVE_BITS: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0040);

/// Key usage: derive key.
export const CRYPTO_KEY_USAGE_DERIVE_KEY: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0080);

/// Key usage: export.
export const CRYPTO_KEY_USAGE_EXPORT: CryptoKeyUsageFlags = CryptoKeyUsageFlags(0x0000_0100);
