import { Array } from "destack:collections";
import { CryptoKeyHandle, CryptoStoreHandle } from "destack:crypto/binding";
import { HostError } from "destack:error/host";

import { CryptoDigestAlgorithm } from "./algorithm.ds";
import { CryptoDerivedKey } from "./key.ds";

/// HKDF derivation.
export struct CryptoHkdf<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Input keying material.
    inputKeyMaterial: &'a readonly [uint8];
    /// Optional salt bytes.
    salt: &'a readonly [uint8];
    /// Context and application info bytes.
    info: &'a readonly [uint8];
}

/// PBKDF2 derivation.
export struct CryptoPbkdf2<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Password bytes.
    password: &'a readonly [uint8];
    /// Salt bytes.
    salt: &'a readonly [uint8];
    /// Iteration count.
    iterations: uint32;
}

/// `scrypt` derivation.
export struct CryptoScrypt<'a> {
    /// Password bytes.
    password: &'a readonly [uint8];
    /// Salt bytes.
    salt: &'a readonly [uint8];
    /// CPU and memory cost parameter.
    cost: uint32;
    /// Block size parameter.
    blockSize: uint32;
    /// Parallelization parameter.
    parallelization: uint32;
    /// Maximum memory in bytes.
    maxMemoryBytes: uint64;
}

/// Argon2id derivation.
export struct CryptoArgon2id<'a> {
    /// Password bytes.
    password: &'a readonly [uint8];
    /// Salt bytes.
    salt: &'a readonly [uint8];
    /// Optional associated data bytes.
    associatedData: &'a readonly [uint8];
    /// Optional secret bytes.
    secret: &'a readonly [uint8];
    /// Iteration count.
    iterations: uint32;
    /// Memory size in kibibytes.
    memoryKiB: uint32;
    /// Parallel workers.
    parallelism: uint32;
}

/// SP 800-108 counter-mode derivation.
export struct CryptoSp800108Counter<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Secret key bytes.
    key: &'a readonly [uint8];
    /// Label bytes.
    label: &'a readonly [uint8];
    /// Context bytes.
    context: &'a readonly [uint8];
}

/// SP 800-56A concat derivation.
export struct CryptoSp80056aConcat<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Shared secret bytes.
    secret: &'a readonly [uint8];
    /// Algorithm identifier bytes.
    algorithmId: &'a readonly [uint8];
    /// Party U info bytes.
    partyUInfo: &'a readonly [uint8];
    /// Party V info bytes.
    partyVInfo: &'a readonly [uint8];
    /// Public supplemental info bytes.
    publicInfo: &'a readonly [uint8];
    /// Private supplemental info bytes.
    privateInfo: &'a readonly [uint8];
}

/// X9.63 derivation.
export struct CryptoX963<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Shared secret bytes.
    secret: &'a readonly [uint8];
    /// Shared info bytes.
    sharedInfo: &'a readonly [uint8];
}

/// X9.42 concat derivation.
export struct CryptoX942Concat<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Shared secret bytes.
    secret: &'a readonly [uint8];
    /// Algorithm identifier bytes.
    algorithmId: &'a readonly [uint8];
    /// Party U info bytes.
    partyUInfo: &'a readonly [uint8];
    /// Party V info bytes.
    partyVInfo: &'a readonly [uint8];
    /// Public supplemental info bytes.
    publicInfo: &'a readonly [uint8];
    /// Private supplemental info bytes.
    privateInfo: &'a readonly [uint8];
}

/// TLS 1.2 PRF derivation.
export struct CryptoTls12Prf<'a> {
    /// Digest algorithm.
    digest: CryptoDigestAlgorithm;
    /// Secret bytes.
    secret: &'a readonly [uint8];
    /// Label bytes.
    label: &'a readonly [uint8];
    /// Seed bytes.
    seed: &'a readonly [uint8];
}

/// Key derivation.
export newtype CryptoKdf<'a> =
    | CryptoHkdf<'a>
    | CryptoPbkdf2<'a>
    | CryptoScrypt<'a>
    | CryptoArgon2id<'a>
    | CryptoSp800108Counter<'a>
    | CryptoSp80056aConcat<'a>
    | CryptoX963<'a>
    | CryptoX942Concat<'a>
    | CryptoTls12Prf<'a>;

/// Key derivation raw byte request.
export struct CryptoKdfBits<'a> {
    /// Key derivation.
    kdf: CryptoKdf<'a>;
    /// Output length in bytes.
    length: uint32;
}

/// Kdf binding family.
export interface CryptoKdfBinding {
    /// Derive raw bytes.
    @binding("destack.crypto.kdf.deriveBits", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.kdf"],
        families: ["windows", "unix"],
    })
    deriveKdfBits(request: &readonly CryptoKdfBits): Result<uint8[], HostError>;

    /// Derive one key.
    @binding("destack.crypto.kdf.deriveKey", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.kdf", "host.crypto.store.write"],
        families: ["windows", "unix"],
    })
    deriveKdfKey(
        store: CryptoStoreHandle,
        kdf: &readonly CryptoKdf,
        key: &readonly CryptoDerivedKey,
    ): Result<CryptoKeyHandle, HostError>;
}
