import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

import { CryptoDigestAlgorithm } from "./algorithm.ds";

/// Handle for one cryptographic digest context.
export newtype CryptoDigestHandle = ResourceId;

/// Digest binding family.
export interface CryptoDigest {
    /// Compute one digest in one shot.
    @binding("destack.crypto.digest.compute", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.digest"],
        families: ["windows", "unix"],
        simulation: true,
    })
    computeDigest(
        algorithm: CryptoDigestAlgorithm,
        payload: &readonly [uint8],
    ): Result<Array<uint8>, HostError>;

    /// Open one streaming digest context.
    @binding("destack.crypto.digest.open", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.digest"],
        families: ["windows", "unix"],
        simulation: true,
    })
    openDigest(algorithm: CryptoDigestAlgorithm): Result<CryptoDigestHandle, HostError>;

    /// Update one streaming digest context.
    @binding("destack.crypto.digest.update", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.digest"],
        families: ["windows", "unix"],
        simulation: true,
    })
    updateDigest(digest: CryptoDigestHandle, payload: &readonly [uint8]): Result<void, HostError>;

    /// Finalize one streaming digest context and return one digest output.
    @binding("destack.crypto.digest.finish", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.digest"],
        families: ["windows", "unix"],
        simulation: true,
    })
    finishDigest(digest: CryptoDigestHandle): Result<Array<uint8>, HostError>;

    /// Close one streaming digest context.
    @binding("destack.crypto.digest.close", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.digest"],
        families: ["windows", "unix"],
        simulation: true,
    })
    closeDigest(digest: CryptoDigestHandle): Result<void, HostError>;
}
