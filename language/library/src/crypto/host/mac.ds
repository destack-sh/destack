import { Array } from "destack:collections";
import { CryptoKeyHandle } from "destack:crypto/host";
import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

import { CryptoDigestAlgorithm, CryptoMacAlgorithm } from "./algorithm.ds";

/// Handle for one cryptographic message-authentication context.
export newtype CryptoMacHandle = ResourceId;

/// MAC parameters.
export struct CryptoMacParameters {
    /// Message authentication algorithm.
    algorithm: CryptoMacAlgorithm;
    /// Digest algorithm for HMAC.
    digest: CryptoDigestAlgorithm;
    /// Output tag length in bytes.
    tagLength?: uint32;
}

/// Mac binding family.
export interface CryptoMac {
    /// Compute one message authentication code in one shot.
    @binding("destack.crypto.mac.compute", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    computeMac(
        key: CryptoKeyHandle,
        parameters: &readonly CryptoMacParameters,
        payload: &readonly [uint8],
    ): Result<Array<uint8>, HostError>;

    /// Verify one message authentication code in one shot.
    @binding("destack.crypto.mac.verify", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    verifyMac(
        key: CryptoKeyHandle,
        parameters: &readonly CryptoMacParameters,
        payload: &readonly [uint8],
        tag: &readonly [uint8],
    ): Result<boolean, HostError>;

    /// Open one streaming MAC context.
    @binding("destack.crypto.mac.open", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    openMac(
        key: CryptoKeyHandle,
        parameters: &readonly CryptoMacParameters,
    ): Result<CryptoMacHandle, HostError>;

    /// Update one streaming MAC context.
    @binding("destack.crypto.mac.update", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    updateMac(mac: CryptoMacHandle, payload: &readonly [uint8]): Result<void, HostError>;

    /// Finalize one streaming MAC context and return one tag.
    @binding("destack.crypto.mac.finish", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    finishMac(mac: CryptoMacHandle): Result<Array<uint8>, HostError>;

    /// Close one streaming MAC context.
    @binding("destack.crypto.mac.close", {
        effect: "external",
        replay: "forbidden",
        requires: ["host.crypto.mac"],
        families: ["windows", "unix"],
        simulation: true,
    })
    closeMac(mac: CryptoMacHandle): Result<void, HostError>;
}
