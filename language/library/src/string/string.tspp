import { Array, Slice } from "tspp:collections";
import { As, Borrow, From } from "tspp:convert";
import { Result, todo } from "tspp:error";
import { CollatorOptions, IntlError, Locales } from "tspp:intl";
import { Iterator } from "tspp:iter";
import { Borrowed, Clone, Default, Region, WithAccess } from "tspp:memory";

import { Add, DefaultEqual, Equal, Hash, Hasher, Ordering, PartialEqual } from "tspp:ops";
import { RegExp, RegExpMatch } from "tspp:regexp";

import { StringBuilder } from "./builder.tspp";
import { StringSlice } from "./slice.tspp";

/// Immutable ECMAScript string.
@languageItem("string.String")
export class String {
    /// The owned UTF-16 code units.
    private codeUnits: ^[uint16] = Slice.new();
}

/// Raw template string parts.
export type StringRawParts = {
    /// The raw template segments.
    readonly raw: readonly string[];
};

/// Match result from `String.match`.
export type StringMatch = RegExpMatch | readonly string[];

/// Replacement value used by `String.replace` and `String.replaceAll`.
export type StringReplacement =
    | string
    | ((match: string, ...captures: (string | undefined)[]) => string);

export extension of String implements Default {
    /// Create an empty string.
    static new(): ^string {
        todo("String.new")
    }

    /// Create the default string.
    static default(): ^string {
        String.new()
    }

    /// Create a string from UTF-16 code units.
    static fromCharCode(...codes: uint16[]): ^string {
        todo("String.fromCharCode")
    }

    /// Create a string from Unicode code points.
    static fromCodePoint(...codePoints: uint32[]): ^string {
        todo("String.fromCodePoint")
    }

    /// Create a string from raw template parts.
    static raw(parts: StringRawParts, ...substitutions: unknown[]): ^string {
        todo("String.raw")
    }

    /// Copy a string slice into owned storage.
    static from(value: &readonly StringSlice): ^string {
        todo("String.from")
    }

    /// Consume a string builder into owned storage.
    static from(value: ^StringBuilder): ^string {
        value.intoString()
    }
}

export extension of string
    implements
        Clone,
        Add<string>,
        PartialEqual<string>,
        Equal<string>,
        PartialEqual<StringSlice>,
        Equal<StringSlice>,
        Hash
{
    /// Copy this string into owned storage.
    clone(this: &immutable this): ^this {
        this.as().toOwned()
    }

    /// The concatenated string type.
    type Output = ^string;

    /// The length in UTF-16 code units.
    get length(&readonly this): isize {
        todo("String.length")
    }

    /// Check if the string is empty.
    get isEmpty(&readonly this): boolean {
        todo("String.isEmpty")
    }

    /// Return whether this string equals `other`.
    equal(this: &immutable this, other: &immutable StringSlice): boolean {
        todo("String.equalSlice")
    }

    /// Return one UTF-16 code unit as a string, or the empty string out of bounds.
    charAt(&readonly this, index: isize): ^string {
        todo("String.charAt")
    }

    /// Get the character at `index`, counting from the end when negative.
    at(&readonly this, index: isize): ^string | undefined {
        todo("String.at")
    }

    /// Return the UTF-16 code unit at the index, or NaN out of bounds.
    charCodeAt(&readonly this, index: isize): number {
        todo("String.charCodeAt")
    }

    /// Get the Unicode code point at the given index.
    codePointAt(&readonly this, index: isize): uint32 | undefined {
        todo("String.codePointAt")
    }

    /// Concatenate two strings.
    concat(&readonly this, ...values: (&readonly string)[]): ^string {
        todo("String.concat")
    }

    /// Check if string includes a substring.
    includes(&readonly this, search: &readonly string, position?: isize): boolean {
        todo("String.includes")
    }

    /// Return the first substring index, or -1 when absent.
    indexOf(&readonly this, search: &readonly string, position?: isize): isize {
        todo("String.indexOf")
    }

    /// Return the last substring index, or -1 when absent.
    lastIndexOf(&readonly this, search: &readonly string, position?: isize): isize {
        todo("String.lastIndexOf")
    }

    /// Compare with `other` using locale ordering.
    localeCompare(&readonly this, other: &readonly string): Ordering {
        todo("String.localeCompareDefault")
    }

    /// Compare with `other` using explicit locale ordering.
    localeCompare(
        &readonly this,
        other: &readonly string,
        locales?: &readonly Locales,
        options?: &readonly CollatorOptions,
    ): Result<Ordering, IntlError> {
        todo("String.localeCompare")
    }

    /// Match this string against `pattern`.
    match(&readonly this, pattern: &readonly string | RegExp): StringMatch | null {
        todo("String.match")
    }

    /// Match every occurrence of `pattern`.
    matchAll(&readonly this, pattern: RegExp): Iterator<RegExpMatch> {
        todo("String.matchAll")
    }

    /// Replace the first matching text.
    replace(
        &readonly this,
        pattern: &readonly string | RegExp,
        replacement: StringReplacement,
    ): ^string {
        todo("String.replace")
    }

    /// Replace every matching text.
    replaceAll(
        &readonly this,
        pattern: &readonly string | RegExp,
        replacement: StringReplacement,
    ): ^string {
        todo("String.replaceAll")
    }

    /// Return the first match index, or -1 when absent.
    search(&readonly this, pattern: &readonly string | RegExp): isize {
        todo("String.search")
    }

    /// Split this string by `separator`.
    split(&readonly this, separator?: &readonly string | RegExp, limit?: isize): ^Array<string> {
        todo("String.split")
    }

    /// Split this string once around the first exact separator.
    splitOnce(&readonly this, separator: &readonly string): (string, string) | undefined {
        todo("String.splitOnce")
    }

    /// Check if string starts with a prefix.
    startsWith(&readonly this, search: &readonly string, position?: isize): boolean {
        todo("String.startsWith")
    }

    /// Check if string ends with a suffix.
    endsWith(&readonly this, search: &readonly string, endPosition?: isize): boolean {
        todo("String.endsWith")
    }

    /// Return the text after an exact prefix.
    stripPrefix(&readonly this, prefix: &readonly string): ^string | undefined {
        todo("String.stripPrefix")
    }

    /// Return the text before an exact suffix.
    stripSuffix(&readonly this, suffix: &readonly string): ^string | undefined {
        todo("String.stripSuffix")
    }

    /// Extract a substring.
    substring(&readonly this, start: isize, end?: isize): ^string {
        todo("String.substring")
    }

    /// Extract a slice of the string.
    slice(&readonly this, start?: isize, end?: isize): ^string {
        todo("String.slice")
    }

    /// Convert to lowercase.
    toLowerCase(&readonly this): ^string {
        todo("String.toLowerCase")
    }

    /// Convert to lowercase using locale rules.
    toLocaleLowerCase(&readonly this): ^string {
        todo("String.toLocaleLowerCaseDefault")
    }

    /// Convert to lowercase using explicit locale rules.
    toLocaleLowerCase(&readonly this, locales?: &readonly Locales): Result<^string, IntlError> {
        todo("String.toLocaleLowerCase")
    }

    /// Convert to uppercase.
    toUpperCase(&readonly this): ^string {
