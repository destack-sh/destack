    }

    /// Convert to uppercase using locale rules.
    toLocaleUpperCase(&readonly this): ^string {
        todo("String.toLocaleUpperCaseDefault")
    }

    /// Convert to uppercase using explicit locale rules.
    toLocaleUpperCase(&readonly this, locales?: &readonly Locales): Result<^string, IntlError> {
        todo("String.toLocaleUpperCase")
    }

    /// Normalize this string.
    normalize(&readonly this, form?: "NFC" | "NFD" | "NFKC" | "NFKD"): ^string {
        todo("String.normalize")
    }

    /// Remove leading and trailing whitespace.
    trim(&readonly this): ^string {
        todo("String.trim")
    }

    /// Remove leading whitespace.
    trimStart(&readonly this): ^string {
        todo("String.trimStart")
    }

    /// Remove trailing whitespace.
    trimEnd(&readonly this): ^string {
        todo("String.trimEnd")
    }

    /// Repeat the string n times.
    repeat(&readonly this, count: isize): ^string {
        todo("String.repeat")
    }

    /// Pad the start of the string.
    padStart(&readonly this, targetLength: isize, padString?: &readonly string): ^string {
        todo("String.padStart")
    }

    /// Pad the end of the string.
    padEnd(&readonly this, targetLength: isize, padString?: &readonly string): ^string {
        todo("String.padEnd")
    }

    /// Return whether this string is well-formed Unicode.
    isWellFormed(&readonly this): boolean {
        todo("String.isWellFormed")
    }

    /// Return this string with invalid Unicode replaced.
    toWellFormed(&readonly this): ^string {
        todo("String.toWellFormed")
    }

    /// Return the primitive string value.
    valueOf(&readonly this): string {
        todo("String.valueOf")
    }

    /// Return the owned string value.
    toString(&readonly this): ^string {
        todo("String.toString")
    }

    /// Equality comparison.
    equal(this: &immutable this, other: &immutable string): boolean {
        todo("String.equal")
    }

    /// Add this string to `state`.
    hash(this: &immutable this, state: &Hasher): void {
