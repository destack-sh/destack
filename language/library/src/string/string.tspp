}

export extension of string implements From<&readonly StringSlice>, From<^StringBuilder> {
    /// Create a managed string from borrowed text.
    static from(value: &readonly StringSlice): string {
        String.from(value)
    }

    /// Create a managed string from a string builder.
    static from(value: ^StringBuilder): string {
        String.from(value)
    }
}

export extension of ^string implements From<&readonly StringSlice>, From<^StringBuilder> {
    /// Create an owned string from borrowed text.
    static from(value: &readonly StringSlice): ^string {
        String.from(value)
    }

    /// Create an owned string from a string builder.
    static from(value: ^StringBuilder): ^string {
        String.from(value)
    }
}

export extension<const A: Access> of String implements As<StringSlice, A>, Borrow<StringSlice, A> {
    /// Borrow this string as a string slice.
    as<const R: Region>(this: Borrowed<this, R, A>): Borrowed<StringSlice, R, A> {
        todo("String.as")
    }

    /// Borrow this string as a string slice.
    borrow<const R: Region>(this: Borrowed<this, R, A>): Borrowed<StringSlice, R, A> {
        this.as()
    }
}

/// Join one template's literal chunks with the text its interpolations produced.
///
/// The chunks always outnumber the spans by one, so each span sits between two chunks.
@languageItem("string.fromTemplate")
export function stringFromTemplate(chunks: &readonly [string], spans: &readonly [string]): ^string {
    todo("stringFromTemplate")
}

export extension<Q: Borrow<StringSlice>> of string implements DefaultEqual<Q> {
    /// Compare string contents with a stored string.
    static equal(value: &immutable Q, key: &immutable this): boolean {
        todo("string.equal");
    }

    /// Hash string contents using the same encoding as the stored string.
    static hash(value: &immutable Q, state: &Hasher): void {
        todo("string.hash");
    }
}
