import { Borrow, ToOwned } from "tspp:convert";
import { todo } from "tspp:error";

import { DefaultEqual, Equal, Hash, Hasher, PartialEqual } from "tspp:ops";

/// Borrowed sequence of ECMAScript UTF-16 code units.
@languageItem("string.StringSlice")
export newtype StringSlice = [uint16];

export extension of StringSlice
    implements
        ToOwned,
        PartialEqual<StringSlice>,
        Equal<StringSlice>,
        PartialEqual<string>,
        Equal<string>,
        Hash
{
    /// The owned value type.
    type Owned = ^string;

    /// Return the number of UTF-16 code units.
    get length(&readonly this): isize {
        todo("StringSlice.length")
    }

    /// Return whether this slice is empty.
    get isEmpty(&readonly this): boolean {
        todo("StringSlice.isEmpty")
    }

    /// Get the UTF-16 code unit at `index`.
    charCodeAt(&readonly this, index: isize): uint16 | undefined {
        todo("StringSlice.charCodeAt")
    }

    /// Get the Unicode code point at `index`.
    codePointAt(&readonly this, index: isize): uint32 | undefined {
        todo("StringSlice.codePointAt")
    }

    /// Borrow a range of this slice.
    slice(&readonly this, start?: isize, end?: isize): &readonly StringSlice {
        todo("StringSlice.slice")
    }

    /// Copy this slice into an owned string.
    toOwned(&immutable this): ^string {
        todo("StringSlice.toOwned")
    }

    /// Return whether this string slice equals `other`.
    equal(&immutable this, other: &immutable StringSlice): boolean {
        todo("StringSlice.equal")
    }

    /// Return whether this string slice equals `other`.
    equal(&immutable this, other: &immutable string): boolean {
        todo("StringSlice.equalString")
    }

    /// Add this string slice to `state`.
    hash(&immutable this, state: &Hasher): void {
        todo("StringSlice.hash");
    }
}

export extension<S: Borrow<StringSlice>> of S {
    /// Return whether this text contains `search`.
    includes<Q: Borrow<StringSlice>>(
        &readonly this,
        search: &readonly Q,
        position?: isize,
    ): boolean {
        todo("StringSlice.includes")
    }

    /// Find the first index of `search`.
    indexOf<Q: Borrow<StringSlice>>(
        &readonly this,
        search: &readonly Q,
        position?: isize,
    ): isize | undefined {
        todo("StringSlice.indexOf")
    }

    /// Find the last index of `search`.
    lastIndexOf<Q: Borrow<StringSlice>>(
        &readonly this,
        search: &readonly Q,
        position?: isize,
    ): isize | undefined {
        todo("StringSlice.lastIndexOf")
    }

    /// Split this text once around the first exact separator.
    splitOnce<Q: Borrow<StringSlice>>(
        &readonly this,
        separator: &readonly Q,
    ): (&readonly StringSlice, &readonly StringSlice) | undefined {
        todo("StringSlice.splitOnce")
    }

    /// Return whether this text starts with `prefix`.
    startsWith<Q: Borrow<StringSlice>>(
        &readonly this,
        prefix: &readonly Q,
        position?: isize,
    ): boolean {
        todo("StringSlice.startsWith")
    }

    /// Return whether this text ends with `suffix`.
    endsWith<Q: Borrow<StringSlice>>(
        &readonly this,
        suffix: &readonly Q,
        endPosition?: isize,
    ): boolean {
        todo("StringSlice.endsWith")
    }

    /// Borrow the text after an exact prefix.
    stripPrefix<Q: Borrow<StringSlice>>(
        &readonly this,
        prefix: &readonly Q,
    ): &readonly StringSlice | undefined {
        todo("StringSlice.stripPrefix")
    }

    /// Borrow the text before an exact suffix.
    stripSuffix<Q: Borrow<StringSlice>>(
        &readonly this,
        suffix: &readonly Q,
    ): &readonly StringSlice | undefined {
        todo("StringSlice.stripSuffix")
    }
}

export extension<Q: Borrow<StringSlice>> of StringSlice implements DefaultEqual<Q> {
    /// Compare string contents with a stored string.
    static equal(value: &immutable Q, key: &immutable this): boolean {
        todo("StringSlice.equal");
    }

    /// Hash string contents using the same encoding as the stored string.
    static hash(value: &immutable Q, state: &Hasher): void {
