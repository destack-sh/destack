import { Slice } from "destack:collections";
import { As, Borrow, ToOwned } from "destack:convert";
import { Error, Result, todo } from "destack:error";
import { Iterator } from "destack:iter";
import { Borrowed, Clone, Default, Region, WithAccess } from "destack:memory";

import {
    Compare,
    DefaultEqual,
    Equal,
    Hash,
    Hasher,
    Ordering,
    PartialCompare,
    PartialEqual,
} from "destack:ops";

import { Utf8DecodeError } from "./utf8.ds";

/// Borrowed bytes terminated by exactly one zero byte with no interior zero bytes.
@languageItem("string.CStringSlice")
@repr("transparent")
export struct CStringSlice {
    /// The validated bytes including their final zero byte.
    private bytes: [uint8];
}

/// Owned bytes terminated by exactly one zero byte with no interior zero bytes.
@languageItem("string.CString")
export class CString {
    /// The bytes including the final zero byte.
    private bytes: ^[uint8] = Slice.new();
}

/// An interior zero byte in a C string source.
@languageItem("string.InteriorNulError")
export struct InteriorNulError {
    /// The error discriminator.
    kind: "interiorNul" = "interiorNul";

    /// The zero byte offset.
    offset: usize;
}

/// A byte sequence without its required final zero byte.
@languageItem("string.MissingNulError")
export struct MissingNulError {
    /// The error discriminator.
    kind: "missingNul" = "missingNul";

    /// The source byte length.
    length: usize;
}

/// Failure to construct a valid C string.
@languageItem("string.CStringError")
export newtype CStringError = InteriorNulError | MissingNulError;

/// Failure to consume a C string as UTF-8 text.
@languageItem("string.CStringIntoStringError")
export struct CStringIntoStringError {
    /// The error discriminator.
    kind: "invalidUtf8" = "invalidUtf8";

    /// The original C string.
    value: ^CString;

    /// The UTF-8 decoding failure.
    error: Utf8DecodeError;
}

export extension of CStringSlice implements ToOwned, Hash {
    /// The owned value type.
    type Owned = ^CString;

    /// Borrow bytes through the first zero byte.
    static fromBytesUntilNul(
        value: &immutable [uint8],
    ): Result<&readonly CStringSlice, MissingNulError> {
        todo("CStringSlice.fromBytesUntilNul")
    }

    /// Borrow bytes that end with exactly one zero byte.
    static fromBytesWithNul(
        value: &immutable [uint8],
    ): Result<&readonly CStringSlice, CStringError> {
        todo("CStringSlice.fromBytesWithNul")
    }

    /// Borrow bytes without validating the C string invariant.
    @unsafe
    static fromBytesWithNulUnchecked(value: &readonly [uint8]): &readonly CStringSlice {
        todo("CStringSlice.fromBytesWithNulUnchecked")
    }

    /// Borrow a zero-terminated C string from `pointer`.
    @unsafe
    static fromPointer<'a>(pointer: *uint8): &'a readonly CStringSlice {
        todo("CStringSlice.fromPointer")
    }

    /// Copy this C string into owned storage.
    toOwned(&immutable this): ^CString {
        todo("CStringSlice.toOwned")
    }

    /// Add this C string to `state` without its final zero byte.
    hash(&immutable this, state: &Hasher): void {
        todo("CStringSlice.hash");
    }
}

export extension<const A: Access> of CStringSlice implements As<[uint8], A> {
    /// Borrow the bytes before the final zero byte.
    as<const R: Region>(this: Borrowed<this, R, A>): Borrowed<[uint8], R, A> {
        todo("CStringSlice.as")
    }
}

export extension of CString implements Clone, Default, Hash {
    /// Create an empty C string.
    static new(): ^CString {
        todo("CString.new")
    }

    /// Create the default C string.
    static default(): ^CString {
        CString.new()
    }

    /// Encode text as a C string.
    static fromString(value: string): Result<^CString, InteriorNulError> {
        todo("CString.fromString")
    }

    /// Copy bytes and append their final zero byte.
    static fromBytes(value: &readonly [uint8]): Result<^CString, InteriorNulError> {
        todo("CString.fromBytes")
    }

    /// Consume bytes and append their final zero byte.
    static fromBytes(value: ^[uint8]): Result<^CString, InteriorNulError> {
        todo("CString.fromBytes")
    }

    /// Copy bytes and append their final zero byte without checking for interior zeros.
    @unsafe
    static fromBytesUnchecked(value: &readonly [uint8]): ^CString {
        todo("CString.fromBytesUnchecked")
    }

    /// Consume bytes and append their final zero byte without checking for interior zeros.
    @unsafe
    static fromBytesUnchecked(value: ^[uint8]): ^CString {
        todo("CString.fromBytesUnchecked")
    }

    /// Copy bytes that already include their final zero byte.
    static fromBytesWithNul(value: &readonly [uint8]): Result<^CString, CStringError> {
        todo("CString.fromBytesWithNul")
    }

    /// Consume bytes that already include their final zero byte.
    static fromBytesWithNul(value: ^[uint8]): Result<^CString, CStringError> {
        todo("CString.fromBytesWithNul")
    }

    /// Copy terminated bytes without validating the C string invariant.
    @unsafe
    static fromBytesWithNulUnchecked(value: &readonly [uint8]): ^CString {
        todo("CString.fromBytesWithNulUnchecked")
    }

    /// Consume terminated bytes without validating the C string invariant.
    @unsafe
    static fromBytesWithNulUnchecked(value: ^[uint8]): ^CString {
        todo("CString.fromBytesWithNulUnchecked")
    }

    /// Reclaim a C string previously released by `intoRaw`.
    @unsafe
    static fromRaw(pointer: *uint8): ^CString {
        todo("CString.fromRaw")
    }

    /// Clone this C string.
    clone(this: &immutable this): ^CString {
        this.as().toOwned()
    }

    /// Add this C string to `state` without its final zero byte.
    hash(this: &immutable this, state: &Hasher): void {
        this.as().hash(state);
    }

    /// Decode and consume this C string as UTF-8 text.
    intoString(^this): Result<^string, CStringIntoStringError> {
        todo("CString.intoString")
    }

    /// Move the bytes before the final zero byte out of this string.
    intoBytes(^this): ^[uint8] {
        todo("CString.intoBytes")
    }

    /// Move all bytes including the final zero byte out of this string.
    intoBytesWithNul(^this): ^[uint8] {
        todo("CString.intoBytesWithNul")
    }

    /// Release this C string as a raw pointer for later reclamation by `fromRaw`.
    intoRaw(^this): *uint8 {
        todo("CString.intoRaw")
    }
}

export extension<const A: Access> of CString
    implements As<CStringSlice, A>, Borrow<CStringSlice, A>
{
    /// Borrow this owned C string as a C string slice.
    as<const R: Region>(this: Borrowed<this, R, A>): Borrowed<CStringSlice, R, A> {
        todo("CString.as")
    }

    /// Borrow this owned C string as a C string slice.
    borrow<const R: Region>(this: Borrowed<this, R, A>): Borrowed<CStringSlice, R, A> {
        this.as()
    }
}

export extension<S: Borrow<CStringSlice>> of S {
    /// Return the byte length before the final zero byte.
    get byteLength(&readonly this): usize {
        todo("CString.byteLength")
    }

    /// Return whether this C string contains no bytes before its final zero byte.
    get isEmpty(&readonly this): boolean {
        todo("CString.isEmpty")
    }

    /// Borrow the bytes before the final zero byte.
    asBytes(&readonly this): &readonly [uint8] {
        this.borrow().as()
    }

    /// Borrow all bytes including the final zero byte.
    asBytesWithNul(&readonly this): &readonly [uint8] {
        todo("CString.asBytesWithNul")
    }

    /// Return a raw pointer to the first byte.
    asPointer(&readonly this): *uint8 {
        todo("CString.asPointer")
    }

    /// Iterate over the bytes before the final zero byte.
    bytes(&readonly this): Iterator<uint8> {
        todo("CString.bytes")
    }

    /// Decode this C string as UTF-8 text.
    decode(&readonly this): Result<^string, Utf8DecodeError> {
        todo("CString.decode")
    }

    /// Decode this C string as UTF-8 and replace invalid sequences.
    decodeLossy(&readonly this): ^string {
        todo("CString.decodeLossy")
    }
}

export extension<Q: Borrow<CStringSlice>> of CStringSlice
    implements PartialEqual<Q>, Equal<Q>, PartialCompare<Q>, Compare<Q>
{
    /// Return whether this C string equals `other` byte for byte.
    equal(this: &immutable this, other: &immutable Q): boolean {
        todo("CString.equal")
    }

    /// Compare this C string with `other` byte for byte.
    compare(this: &immutable this, other: &immutable Q): Ordering {
        todo("CString.compare")
    }

    /// Partially compare this C string with `other` byte for byte.
    partialCompare(this: &immutable this, other: &immutable Q): Ordering | null {
        this.compare(other)
    }
}

export extension<Q: Borrow<CStringSlice>> of CString
    implements PartialEqual<Q>, Equal<Q>, PartialCompare<Q>, Compare<Q>
{
    /// Return whether this C string equals `other` byte for byte.
    equal(this: &immutable this, other: &immutable Q): boolean {
        todo("CString.equal")
    }

    /// Compare this C string with `other` byte for byte.
    compare(this: &immutable this, other: &immutable Q): Ordering {
        todo("CString.compare")
    }

    /// Partially compare this C string with `other` byte for byte.
    partialCompare(this: &immutable this, other: &immutable Q): Ordering | null {
        this.compare(other)
    }
}

export extension of InteriorNulError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("InteriorNulError.display")
    }
}

export extension of MissingNulError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("MissingNulError.display")
    }
}

export extension of CStringError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("CStringError.display")
    }
}

export extension of CStringIntoStringError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("CStringIntoStringError.display")
    }
}

export extension<Q: Borrow<CStringSlice>> of CString implements DefaultEqual<Q> {
    /// Compare string contents with a stored string.
    static equal(value: &immutable Q, key: &immutable this): boolean {
        todo("CString.equal");
    }

    /// Hash string contents using the same encoding as the stored string.
    static hash(value: &immutable Q, state: &Hasher): void {
        todo("CString.hash");
    }
}

export extension<Q: Borrow<CStringSlice>> of CStringSlice implements DefaultEqual<Q> {
    /// Compare string contents with a stored string.
    static equal(value: &immutable Q, key: &immutable this): boolean {
        todo("CStringSlice.equal");
    }

    /// Hash string contents using the same encoding as the stored string.
    static hash(value: &immutable Q, state: &Hasher): void {
        todo("CStringSlice.hash");
    }
}
