import { Slice } from "destack:collections";
import { As, Borrow, ToOwned } from "destack:convert";
import { Error, Result, todo } from "destack:error";
import { Iterator } from "destack:iter";
import { AllocationError, Clone, Default, MaybeUninit, ValueOf, WithAccess } from "destack:memory";

import {
    Compare,
    DefaultEqual,
    Equal,
    Hash,
    Hasher,
    Ordering,
    PartialCompare,
    PartialEqual,
} from "destack:ops";

/// Borrowed platform-native string in its opaque encoded representation.
@languageItem("string.OsStringSlice")
@repr("transparent")
export struct OsStringSlice {
    /// The opaque encoded bytes.
    private bytes: [uint8];
}

/// Immutable owned platform-native string.
@languageItem("string.OsString")
export class OsString {
    /// The opaque encoded bytes.
    private bytes: ^[uint8] = Slice.new();
}

/// Mutable platform-native string builder.
@languageItem("string.OsStringBuilder")
export class OsStringBuilder {
    /// The opaque encoded byte storage.
    private storage: ^[MaybeUninit<uint8>] = Slice.new();

    /// The initialized encoded byte count.
    private initializedLength: usize = 0;

    /// The allocated encoded byte count.
    private allocatedCapacity: usize = 0;
}

/// Failure to decode a native string as Unicode text.
@languageItem("string.OsStringDecodeError")
export struct OsStringDecodeError {
    /// The error discriminator.
    kind: "invalidUnicode" = "invalidUnicode";

    /// The opaque encoded byte offset where decoding failed.
    offset: usize;
}

/// Failure to consume a native string as Unicode text.
@languageItem("string.OsStringIntoStringError")
export struct OsStringIntoStringError {
    /// The error discriminator.
    kind: "invalidUnicode" = "invalidUnicode";

    /// The original native string.
    value: ^OsString;

    /// The native string decoding failure.
    error: OsStringDecodeError;
}

export extension of OsStringSlice implements ToOwned, As<[uint8], "readonly">, Hash {
    /// The owned value type.
    type Owned = ^OsString;

    /// Borrow bytes previously obtained from `asEncodedBytes`.
    @unsafe
    static fromEncodedBytesUnchecked(value: &readonly [uint8]): &readonly OsStringSlice {
        todo("OsStringSlice.fromEncodedBytesUnchecked")
    }

    /// Borrow arbitrary native bytes on Unix targets.
    @if(import.meta.target.family == "unix")
    static fromBytes(value: &readonly [uint8]): &readonly OsStringSlice {
        todo("OsStringSlice.fromBytes")
    }

    /// Borrow the opaque encoded bytes.
    as(&readonly this): &readonly [uint8] {
        todo("OsStringSlice.as")
    }

    /// Borrow the opaque encoded bytes.
    asEncodedBytes(&readonly this): &readonly [uint8] {
        this.as()
    }

    /// Borrow arbitrary native bytes on Unix targets.
    @if(import.meta.target.family == "unix")
    asBytes(&readonly this): &readonly [uint8] {
        this.as()
    }

    /// Iterate over native UTF-16 code units on Windows targets.
    @if(import.meta.target.family == "windows")
    encodeUtf16(&readonly this): Iterator<uint16> {
        todo("OsStringSlice.encodeUtf16")
    }

    /// Copy this native string into owned storage.
    toOwned(&readonly this): ^OsString {
        todo("OsStringSlice.toOwned")
    }

    /// Add the opaque encoded bytes to `state`.
    hash(&readonly this, state: &Hasher): void {
        todo("OsStringSlice.hash");
    }
}

export extension of OsString implements Clone, Default, Hash {
    /// Create an empty native string.
    static new(): ^OsString {
        todo("OsString.new")
    }

    /// Create the default native string.
    static default(): ^OsString {
        OsString.new()
    }

    /// Encode Unicode text for the current platform.
    static fromString(value: string): ^OsString {
        todo("OsString.fromString")
    }

    /// Copy bytes previously obtained from `intoEncodedBytes`.
    @unsafe
    static fromEncodedBytesUnchecked(value: &readonly [uint8]): ^OsString {
        todo("OsString.fromEncodedBytesUnchecked")
    }

    /// Consume bytes previously obtained from `intoEncodedBytes`.
    @unsafe
    static fromEncodedBytesUnchecked(value: ^[uint8]): ^OsString {
        todo("OsString.fromEncodedBytesUnchecked")
    }

    /// Copy arbitrary native bytes on Unix targets.
    @if(import.meta.target.family == "unix")
    static fromBytes(value: &readonly [uint8]): ^OsString {
        todo("OsString.fromBytes")
    }

    /// Consume arbitrary native bytes on Unix targets.
    @if(import.meta.target.family == "unix")
    static fromBytes(value: ^[uint8]): ^OsString {
        todo("OsString.fromBytes")
    }

    /// Copy native UTF-16 code units on Windows targets.
    @if(import.meta.target.family == "windows")
    static fromUtf16(value: &readonly [uint16]): ^OsString {
        todo("OsString.fromUtf16")
    }

    /// Consume native UTF-16 code units on Windows targets.
    @if(import.meta.target.family == "windows")
    static fromUtf16(value: ^[uint16]): ^OsString {
        todo("OsString.fromUtf16")
    }

    /// Clone this native string.
    clone(this: &readonly ValueOf<this>): ^OsString {
        this.as().toOwned()
    }

    /// Add the opaque encoded bytes to `state`.
    hash(this: &readonly ValueOf<this>, state: &Hasher): void {
        this.as().hash(state);
    }

    /// Decode and consume this native string as Unicode text.
    intoString(^this): Result<^string, OsStringIntoStringError> {
        todo("OsString.intoString")
    }

    /// Move out the opaque encoded bytes.
    intoEncodedBytes(^this): ^[uint8] {
        todo("OsString.intoEncodedBytes")
    }

    /// Move out arbitrary native bytes on Unix targets.
    @if(import.meta.target.family == "unix")
    intoBytes(^this): ^[uint8] {
        todo("OsString.intoBytes")
    }

    /// Encode and consume this native string as UTF-16 code units on Windows targets.
    @if(import.meta.target.family == "windows")
    intoUtf16(^this): ^[uint16] {
        todo("OsString.intoUtf16")
    }
}

export extension<const A: "readonly" | "immutable"> of OsString
    implements As<OsStringSlice, A>, Borrow<OsStringSlice, A>
{
    /// Borrow this owned native string as a native string slice.
    as(this: WithAccess<&this, A>): WithAccess<&OsStringSlice, A> {
        todo("OsString.as")
    }

    /// Borrow this owned native string as a native string slice.
    borrow(this: WithAccess<&this, A>): WithAccess<&OsStringSlice, A> {
        this.as()
    }
}

export extension of OsStringBuilder
    implements Default, As<OsStringSlice>, Borrow<OsStringSlice>, Hash
{
    /// Return the allocated encoded byte count.
    get capacity(&readonly this): usize {
        todo("OsStringBuilder.capacity")
    }

    /// Create an empty native string builder.
    static new(): ^OsStringBuilder {
        todo("OsStringBuilder.new")
    }

    /// Create a native string builder with at least `capacity` encoded bytes.
    static withCapacity(capacity: usize): ^OsStringBuilder {
        todo("OsStringBuilder.withCapacity")
    }

    /// Create the default native string builder.
    static default(): ^OsStringBuilder {
        OsStringBuilder.new()
    }

    /// Create a native string builder from Unicode text.
    static fromString(value: string): ^OsStringBuilder {
        todo("OsStringBuilder.fromString")
    }

    /// Create a native string builder from an owned native string.
    static from(value: ^OsString): ^OsStringBuilder {
        todo("OsStringBuilder.from")
    }

    /// Create a native string builder by copying a native string slice.
    static from(value: &readonly OsStringSlice): ^OsStringBuilder {
        todo("OsStringBuilder.from")
    }

    /// Borrow the initialized native string.
    as(&readonly this): &readonly OsStringSlice {
        todo("OsStringBuilder.as")
    }

    /// Borrow the initialized native string.
    borrow(&readonly this): &readonly OsStringSlice {
        this.as()
    }

    /// Add the initialized native string to `state`.
    hash(this: &readonly ValueOf<this>, state: &Hasher): void {
        this.as().hash(state);
    }

    /// Remove all native text.
    clear(&this): void {
        todo("OsStringBuilder.clear");
    }

    /// Reserve at least `additional` more encoded bytes.
    reserve(&this, additional: usize): void {
        todo("OsStringBuilder.reserve");
    }

    /// Reserve exactly `additional` more encoded bytes.
    reserveExact(&this, additional: usize): void {
        todo("OsStringBuilder.reserveExact");
    }

    /// Try to reserve at least `additional` more encoded bytes.
    tryReserve(&this, additional: usize): Result<void, AllocationError> {
        todo("OsStringBuilder.tryReserve")
    }

    /// Release capacity beyond the initialized encoded bytes.
    shrinkToFit(&this): void {
        todo("OsStringBuilder.shrinkToFit");
    }

    /// Convert ASCII uppercase letters in place to lowercase.
    makeAsciiLowercase(&this): void {
        todo("OsStringBuilder.makeAsciiLowercase");
    }

    /// Convert ASCII lowercase letters in place to uppercase.
    makeAsciiUppercase(&this): void {
        todo("OsStringBuilder.makeAsciiUppercase");
    }

    /// Append Unicode text.
    append(&this, value: string): void {
        todo("OsStringBuilder.append");
    }

    /// Append native text.
    append(&this, value: &readonly OsStringSlice): void {
        todo("OsStringBuilder.append");
    }

    /// Copy the initialized native string into owned storage.
    toOsString(&readonly this): ^OsString {
        todo("OsStringBuilder.toOsString")
    }

    /// Consume this builder and return its native string.
    intoOsString(^this): ^OsString {
        todo("OsStringBuilder.intoOsString")
    }
}

export extension<S: Borrow<OsStringSlice>> of S {
    /// Return the opaque encoded byte length.
    get encodedLength(&readonly this): usize {
        todo("OsString.encodedLength")
    }

    /// Return whether this native string is empty.
    get isEmpty(&readonly this): boolean {
        todo("OsString.isEmpty")
    }

    /// Decode this native string as Unicode text.
    decode(&readonly this): Result<^string, OsStringDecodeError> {
        todo("OsString.decode")
    }

    /// Decode this native string and replace invalid sequences.
    decodeLossy(&readonly this): ^string {
        todo("OsString.decodeLossy")
    }

    /// Return whether every native code unit is ASCII.
    isAscii(&readonly this): boolean {
        todo("OsString.isAscii")
    }

    /// Return whether this native string equals `other`, ignoring ASCII case.
    equalIgnoreAsciiCase<Q: Borrow<OsStringSlice>>(&readonly this, other: &readonly Q): boolean {
        todo("OsString.equalIgnoreAsciiCase")
    }

    /// Copy this native string with ASCII uppercase letters converted to lowercase.
    toAsciiLowercase(&readonly this): ^OsString {
        todo("OsString.toAsciiLowercase")
    }

    /// Copy this native string with ASCII lowercase letters converted to uppercase.
    toAsciiUppercase(&readonly this): ^OsString {
        todo("OsString.toAsciiUppercase")
    }
}

export extension<S: Borrow<OsStringSlice>, Q: Borrow<OsStringSlice>> of S
    implements PartialEqual<Q>, Equal<Q>, PartialCompare<Q>, Compare<Q>
{
    /// Return whether this native string has the same encoded bytes as `other`.
    equal(this: &readonly ValueOf<this>, other: &readonly ValueOf<Q>): boolean {
        todo("OsString.equal")
    }

    /// Compare this native string's encoded bytes with `other`.
    compare(this: &readonly ValueOf<this>, other: &readonly ValueOf<Q>): Ordering {
        todo("OsString.compare")
    }

    /// Partially compare this native string's encoded bytes with `other`.
    partialCompare(this: &readonly ValueOf<this>, other: &readonly ValueOf<Q>): Ordering | null {
        this.compare(other)
    }
}

export extension of OsStringDecodeError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("OsStringDecodeError.display")
    }
}

export extension of OsStringIntoStringError implements Error {
    /// Format this error for users.
    display(&readonly this): string {
        todo("OsStringIntoStringError.display")
    }
}

export extension<Q: Borrow<OsStringSlice>> of OsString implements DefaultEqual<Q> {
    /// Compare string contents with a stored string.
    static equal(value: &readonly ValueOf<Q>, key: &readonly ValueOf<this>): boolean {
        todo("OsString.equal");
    }

    /// Hash string contents using the same encoding as the stored string.
    static hash(value: &readonly ValueOf<Q>, state: &Hasher): void {
        todo("OsString.hash");
    }
}

