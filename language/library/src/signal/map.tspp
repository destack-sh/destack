import { todo } from "tspp:error";
import { Copy, Default } from "tspp:memory";
import { Equality, Equate } from "tspp:ops";

import {
    Accessor,
    PollingAccessor,
    PollingSourceAccessor,
    SignalArgument,
    SignalRef,
    SourceAccessor,
} from "./accessor.tspp";
import { DerivationMayPend, DerivationValue } from "./derive.tspp";

/// An optional list value.
export type Maybe<T> = T | void | null | undefined | false;

/// Options for reactive array mapping.
export type MapArrayOptions<Item, Output, Key = Item, E = Equality<Key>> = {
    /// Identity mode or a stable key derived from each item.
    keyed?: boolean | ^((item: SignalArgument<Item>) => Key);

    /// Value derived when the input is empty.
    fallback?: ^(() => Output);

    /// The key comparer.
    comparer?: E;

    /// Diagnostic name.
    name?: string;
};

/// Options for reactive repetition.
export type RepeatOptions<Output, From = Accessor<usize | undefined>> = {
    /// Reactive first index.
    from?: From;

    /// Value derived when the count is zero.
    fallback?: ^(() => Output);

    /// Diagnostic name.
    name?: string;
};

/// Reactive item argument selected for copyable and affine values.
type MapItem<Item> = (Item,) extends (Copy,) ? Item : SignalRef<Item>;

/// Ready or polling list accessor accepted by array mapping.
type ListAccessor<Item> =
    | Accessor<Maybe<readonly Item[]>>
    | PollingAccessor<Maybe<readonly Item[]>>;

/// Item exposed by one ready or polling list accessor.
type ListItem<List> =
    List extends Accessor<Maybe<readonly (infer Item)[]>>
        ? Item
        : List extends PollingAccessor<Maybe<readonly (infer Item)[]>>
          ? Item
          : never;

/// Ready or polling count accessor accepted by repetition.
type CountAccessor = Accessor<usize> | PollingAccessor<usize>;

/// Ready or polling offset accessor accepted by repetition.
type FromAccessor = Accessor<usize | undefined> | PollingAccessor<usize | undefined>;

/// Whether one accessor may be pending.
type AccessorMayPend<Read> = Read extends PollingAccessor<unknown> ? true : false;

/// Array accessor selected from its input and mapped output.
type MapArrayAccessor<List, Output> = true extends AccessorMayPend<List> | DerivationMayPend<Output>
    ? PollingSourceAccessor<DerivationValue<Output>[]>
    : SourceAccessor<DerivationValue<Output>[]>;

/// Array accessor selected from its count, offset, and mapped output.
type RepeatAccessor<Count, From, Output> = true extends
    | AccessorMayPend<Count>
    | AccessorMayPend<From>
    | DerivationMayPend<Output>
    ? PollingSourceAccessor<DerivationValue<Output>[]>
    : SourceAccessor<DerivationValue<Output>[]>;

/// Map a reactive array and retain rows by item equality and hash.
export function mapArray<List: ListAccessor<unknown>, Output, E = Equality<ListItem<List>>>(
    list: List,
    map: ^Function<(MapItem<ListItem<List>>, SourceAccessor<usize>), Output>,
    options?: MapArrayOptions<ListItem<List>, Output, ListItem<List>, E> & { keyed?: true },
): MapArrayAccessor<List, Output> where E: Equate<ListItem<List>>, E: Default {
    todo("signal.mapArray")
}

/// Map a reactive array and retain rows by their index.
export function mapArray<List: ListAccessor<unknown>, Output>(
    list: List,
    map: ^Function<(SourceAccessor<ListItem<List>>, usize), Output>,
    options: MapArrayOptions<ListItem<List>, Output> & { keyed: false },
): MapArrayAccessor<List, Output> {
    todo("signal.mapArray")
}

/// Map a reactive array and retain rows by a derived key.
export function mapArray<List: ListAccessor<unknown>, Key, Output, E = Equality<Key>>(
    list: List,
    map: ^Function<(SourceAccessor<ListItem<List>>, SourceAccessor<usize>), Output>,
    options: MapArrayOptions<ListItem<List>, Output, Key, E> & {
        keyed: ^Function<(SignalArgument<ListItem<List>>,), Key>;
    },
): MapArrayAccessor<List, Output> where E: Equate<Key>, E: Default {
    todo("signal.mapArray")
}

/// Map a reactive array and retain rows by item equality and hash.
export function mapArray<List: ListAccessor<unknown>, Output, E = Equality<ListItem<List>>>(
    list: List,
    map: ^Function<(MapItem<ListItem<List>>, SourceAccessor<usize>), Output>,
    options: MapArrayOptions<ListItem<List>, Output, ListItem<List>, E> & {
        keyed?: true;
        comparer: E;
    },
): MapArrayAccessor<List, Output> where E: Equate<ListItem<List>> {
    todo("signal.mapArray")
}

/// Map a reactive array and retain rows by a derived key.
export function mapArray<List: ListAccessor<unknown>, Key, Output, E = Equality<Key>>(
    list: List,
    map: ^Function<(SourceAccessor<ListItem<List>>, SourceAccessor<usize>), Output>,
    options: MapArrayOptions<ListItem<List>, Output, Key, E> & {
        keyed: ^Function<(SignalArgument<ListItem<List>>,), Key>;
        comparer: E;
    },
): MapArrayAccessor<List, Output> where E: Equate<Key> {
    todo("signal.mapArray")
}

/// Map a reactive count and retain rows by index.
export function repeat<
    Output,
    Count: CountAccessor,
    From: FromAccessor = Accessor<usize | undefined>,
>(
    count: Count,
    map: ^Function<(usize,), Output>,
    options?: RepeatOptions<Output, From>,
): RepeatAccessor<Count, From, Output> {
    todo("signal.repeat")
}
