import { Copy } from "destack:memory";

import { SignalArgument, SignalRef } from "./accessor.ds";

/// Setter for one writable signal value.
export type Setter<in out T> = {
    /// Clear a value whose type includes undefined.
    (...arguments: undefined extends T ? () : never): undefined;

    /// Derive and return a copyable value.
    <U: T>(update: ^Function<(SignalArgument<T>,), U, "once">): U where U: Copy;

    /// Derive and retain readonly access to an affine value.
    <U: T>(update: ^Function<(SignalArgument<T>,), U, "once">): SignalRef<U>;

    /// Replace and return a copyable value.
    <U: T>(value: U): U where U: Copy;

    /// Replace and retain readonly access to an affine value.
    <U: T>(value: U): SignalRef<U>;
};
