import { Poll } from "destack:async";
import { todo } from "destack:error";
import { Access, Borrowed, Copy, Region } from "destack:memory";
import { Dereference } from "destack:ops";

/// Stable readonly access to one observed signal value.
export class SignalRef<T> implements Dereference<"readonly"> {
    /// The pointee type.
    type Target = T;

    /// The retained value.
    private readonly value: T;

    /// Retain one observed value.
    private constructor(value: T) {
        this.value = value;
    }

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the retained value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("SignalRef.dereference")
    }
}

/// A copied callback value or protected access to a retained signal value.
export type SignalArgument<'a, T> = (T,) extends (Copy,) ? T : &'a immutable T;

/// Repeatable read of an available signal value.
export type Accessor<out T> = {
    /// Copy the current value.
    (): T where T: Copy;

    /// Retain readonly access to the current value.
    (): SignalRef<T>;
};

/// Repeatable read of a signal value that may be pending.
export type PollingAccessor<out T> = {
    /// Poll and copy the current value.
    (): Poll<T> where T: Copy;

    /// Poll for readonly access to the current value.
    (): Poll<SignalRef<T>>;
};

/// Capability for reevaluating one signal source.
export newtype interface Refreshable {
    /// Reevaluate this source.
    static refresh(source: &readonly this): void;
}

/// Refreshable accessor whose value is available.
export type SourceAccessor<T> = Accessor<T> & Refreshable;

/// Refreshable accessor whose value may be pending.
export type PollingSourceAccessor<T> = PollingAccessor<T> & Refreshable;
