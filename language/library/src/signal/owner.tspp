import { todo } from "tspp:error";
import { Dispose } from "tspp:memory";

/// One signal owner and its retained children.
export class Owner implements Dispose {
    /// Prevent direct construction.
    private constructor() {}

    /// Dispose this owner and its retained children.
    dispose(this): void {
        todo("Owner.dispose");
    }
}

/// Options for creating an owner.
export type OwnerOptions = {
    /// Stable parent child identifier.
    id?: string;

    /// Whether child identifiers inherit through this owner.
    transparent?: boolean;
};

/// Create one owner under the current owner and capture the current execution context.
export function createOwner(options?: OwnerOptions): Owner {
    todo("signal.createOwner")
}

/// Return the current signal owner.
export function getOwner(): Owner | undefined {
    todo("signal.getOwner")
}

/// Return whether an owner has been disposed.
export function isDisposed(owner: &readonly Owner): boolean {
    todo("signal.isDisposed")
}

/// Run one body under an owner and its captured execution context.
export function runWithOwner<T>(
    owner: &readonly Owner | undefined,
    body: ^Function<(), T, "once">,
): T {
    todo("signal.runWithOwner")
}

/// Create one detached signal owner and run its initializer.
export function createRoot<T>(
    initialize: ^Function<(^Function<(), void, "once">,), T, "once">,
    options?: OwnerOptions,
): T {
    todo("signal.createRoot")
}

/// Run one function when the current owner disposes it.
export function onCleanup(cleanup: ^Function<(), void, "once">): void {
    todo("signal.onCleanup");
}

/// Run one function after the current owner settles.
export function onSettled(
    callback: ^Function<(), void | ^Function<(), void, "once">, "once">,
): void {
    todo("signal.onSettled");
}
