import { AsyncIterable, Poll, Promise, Task } from "tspp:async";
import { Stream } from "tspp:stream";

import { PollingSourceAccessor, SignalRef, SourceAccessor } from "./accessor.tspp";
import { Setter } from "./setter.tspp";

/// Value exposed by one signal derivation return.
///
/// A signal node retains a returned `SignalRef` and exposes its referenced value.
export type DerivationValue<Output> =
    Output extends Task<infer T>
        ? DerivationValue<T>
        : Output extends Promise<infer T>
          ? DerivationValue<T>
          : Output extends Stream<infer T>
            ? DerivationValue<T>
            : Output extends AsyncIterable<infer T>
              ? DerivationValue<T>
              : Output extends Poll<infer T>
                ? DerivationValue<T>
                : Output extends SignalRef<infer T>
                  ? T
                  : Output;

/// Whether one derivation output may be pending.
export type DerivationMayPend<Output> =
    Output extends Task<infer T>
        ? true
        : Output extends Promise<infer T>
          ? true
          : Output extends Stream<infer T>
            ? true
            : Output extends AsyncIterable<infer T>
              ? true
              : Output extends Poll<infer T>
                ? true
                : false;

/// Accessor selected from one signal derivation output.
export type DerivationAccessor<Output> =
    true extends DerivationMayPend<Output>
        ? PollingSourceAccessor<DerivationValue<Output>>
        : SourceAccessor<DerivationValue<Output>>;

/// Getter and setter selected from one writable signal derivation output.
export type DerivationSignal<Output> = (
    DerivationAccessor<Output>,
    Setter<DerivationValue<Output>>,
);
