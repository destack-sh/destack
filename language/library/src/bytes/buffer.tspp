import { Slice } from "tspp:collections";
import { todo } from "tspp:error";
import { Access, Borrowed, MaybeUninit, Region } from "tspp:memory";

import { Bytes } from "./bytes.tspp";

/// Growable byte buffer.
@languageItem("bytes.ByteBuffer")
export class ByteBuffer {
    /// The owned byte storage.
    private storage: ^[MaybeUninit<uint8>] = Slice.new();

    /// The initialized byte count.
    private initializedLength: isize = 0;

    /// The allocated byte capacity.
    private allocatedCapacity: usize = 0;

    /// Create an empty byte buffer.
    static new(): ^ByteBuffer {
        todo("ByteBuffer.new")
    }

    /// Create a byte buffer with room for at least `capacity` bytes.
    static withCapacity(capacity: usize): ^ByteBuffer {
        todo("ByteBuffer.withCapacity")
    }

    /// Create a byte buffer containing `bytes`.
    static from(bytes: &readonly [uint8]): ^ByteBuffer {
        todo("ByteBuffer.from")
    }

    /// Return the initialized byte count.
    get length(&readonly this): isize {
        this.initializedLength
    }

    /// Return the initialized byte count.
    get size(&readonly this): isize {
        this.initializedLength
    }

    /// Return the allocated byte capacity.
    get capacity(&readonly this): usize {
        this.allocatedCapacity
    }

    /// Return whether this buffer has no initialized bytes.
    get isEmpty(&readonly this): boolean {
        this.initializedLength == 0
    }

    /// Reserve room for at least `additional` more bytes.
    reserve(&this, additional: usize): void {
        todo("ByteBuffer.reserve");
    }

    /// Remove all initialized bytes.
    clear(&this): void {
        todo("ByteBuffer.clear");
    }

    /// Release unused capacity.
    compact(&this): void {
        todo("ByteBuffer.compact");
    }

    /// Append one byte.
    writeByte(&this, value: uint8): void {
        todo("ByteBuffer.writeByte");
    }

    /// Append bytes.
    write(&this, bytes: &readonly [uint8]): void {
        todo("ByteBuffer.write");
    }

    /// Append `count` copies of `value`.
    fill(&this, value: uint8, count: isize): void {
        todo("ByteBuffer.fill");
    }

    /// Borrow initialized bytes.
    asBytes<const R: Region, const A: Access = "readonly">(
        this: Borrowed<ByteBuffer, R, A>,
    ): Borrowed<[uint8], R, A> {
        todo("ByteBuffer.asBytes")
    }

    /// Clone initialized bytes into immutable storage.
    toBytes(&readonly this): Bytes {
        todo("ByteBuffer.toBytes")
    }

    /// Move initialized bytes into immutable storage.
    intoBytes(^this): Bytes {
        todo("ByteBuffer.intoBytes")
    }
}
