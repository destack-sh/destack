import { todo } from "tspp:error";

import { Bytes } from "./bytes.tspp";

/// Sequential byte reader over in-memory bytes.
@languageItem("bytes.ByteReader")
export class ByteReader {
    /// The source bytes.
    bytes: Bytes;

    /// The current byte offset.
    offset: usize = 0;

    /// Create a reader over `source`.
    private constructor(source: Bytes) {
        this.bytes = source;
    }

    /// Create a reader for `bytes`.
    static from(bytes: Bytes): ^ByteReader {
        todo("ByteReader.from")
    }

    /// Return the total byte count.
    size(&readonly this): usize {
        todo("ByteReader.size")
    }

    /// Return the current byte offset.
    position(&readonly this): usize {
        todo("ByteReader.position")
    }

    /// Return the unread byte count.
    remaining(&readonly this): usize {
        todo("ByteReader.remaining")
    }

    /// Return whether no unread bytes remain.
    isEmpty(&readonly this): boolean {
        todo("ByteReader.isEmpty")
    }

    /// Move the current byte offset.
    seek(&this, offset: usize): void {
        todo("ByteReader.seek");
    }

    /// Skip up to `count` bytes.
    skip(&this, count: usize): usize {
        todo("ByteReader.skip")
    }

    /// Return the next byte without advancing.
    peekByte(&readonly this): uint8 | undefined {
        todo("ByteReader.peekByte")
    }

    /// Read one byte.
    readByte(&this): uint8 | undefined {
        todo("ByteReader.readByte")
    }

    /// Step back by one byte.
    unreadByte(&this): void {
        todo("ByteReader.unreadByte");
    }

    /// Read at most `length` bytes.
    read(&this, length: usize): Bytes {
        todo("ByteReader.read")
    }

    /// Read exactly `length` bytes.
    readExact(&this, length: usize): Bytes | undefined {
        todo("ByteReader.readExact")
    }

    /// Read bytes until `delimiter` is consumed.
    readUntil(&this, delimiter: uint8): Bytes | undefined {
        todo("ByteReader.readUntil")
    }

    /// Read all remaining bytes.
    readToEnd(&this): Bytes {
        todo("ByteReader.readToEnd")
    }
}
