import { Result } from "destack:error";

/// Structured value serializer.
@languageItem("serde.Serializer")
export newtype interface Serializer {
    /// Serialization error type.
    type Error;

    /// Serialize a null value.
    serializeNull(&exclusive this): Result<void, this.Error>;

    /// Serialize an undefined value.
    serializeUndefined(&exclusive this): Result<void, this.Error>;

    /// Serialize a boolean value.
    serializeBoolean(&exclusive this, value: boolean): Result<void, this.Error>;

    /// Serialize a number value.
    serializeNumber(&exclusive this, value: number): Result<void, this.Error>;

    /// Serialize a string value.
    serializeString(&exclusive this, value: string): Result<void, this.Error>;

    /// Serialize an array value.
    serializeArray<T: Serialize<this>>(
        &exclusive this,
        value: readonly T[],
    ): Result<void, this.Error>;

    /// Serialize an object field.
    serializeField<T: Serialize<this>>(
        &exclusive this,
        key: string,
        value: &readonly T,
    ): Result<void, this.Error>;
}

/// Structured value deserializer.
@languageItem("serde.Deserializer")
export newtype interface Deserializer {
    /// Deserialization error type.
    type Error;

    /// Deserialize a null value.
    deserializeNull(&exclusive this): Result<void, this.Error>;

    /// Deserialize a boolean value.
    deserializeBoolean(&exclusive this): Result<boolean, this.Error>;

    /// Deserialize a number value.
    deserializeNumber(&exclusive this): Result<number, this.Error>;

    /// Deserialize a string value.
    deserializeString(&exclusive this): Result<^string, this.Error>;

    /// Deserialize an array value.
    deserializeArray<T: Deserialize<this>>(&exclusive this): Result<^T[], this.Error>;

    /// Deserialize an object field.
    deserializeField<T: Deserialize<this>>(
        &exclusive this,
        key: string,
    ): Result<T | undefined, this.Error>;
}

/// Value that can serialize itself through `S`.
@languageItem("serde.Serialize")
export newtype interface Serialize<S: Serializer> {
    /// Serialize this value.
    serialize(&readonly this, serializer: &exclusive S): Result<void, S.Error>;
}

/// Value that can be deserialized through `D`.
@languageItem("serde.Deserialize")
export newtype interface Deserialize<D: Deserializer> {
    /// Deserialize one value.
    static deserialize(deserializer: &exclusive D): Result<this, D.Error>;
}
