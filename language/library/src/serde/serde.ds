import { Result } from "destack:error";
import { Copy, ImmutableOf, WithAccess } from "destack:memory";

/// Structured value serializer.
@languageItem("serde.Serializer")
export newtype interface Serializer {
    /// Serialization error type.
    type Error;

    /// Serialize a null value.
    serializeNull(&this): Result<void, this.Error>;

    /// Serialize an undefined value.
    serializeUndefined(&this): Result<void, this.Error>;

    /// Serialize a boolean value.
    serializeBoolean(&this, value: boolean): Result<void, this.Error>;

    /// Serialize a number value.
    serializeNumber(&this, value: number): Result<void, this.Error>;

    /// Serialize a string value.
    serializeString(&this, value: string): Result<void, this.Error>;

    /// Serialize an array value.
    serializeArray<T, const A: "readonly" | "immutable">(
        &this,
        value: WithAccess<&readonly T[], A>,
    ): Result<void, this.Error>
        where T: Serialize<this>, A: "immutable" | ((T,) extends (Copy,) ? "readonly" : never);

    /// Serialize an object field.
    serializeField<T>(
        &this,
        key: string,
        value: ImmutableOf<T>,
    ): Result<void, this.Error> where T: Serialize<this>;
}

/// Structured value deserializer.
@languageItem("serde.Deserializer")
export newtype interface Deserializer {
    /// Deserialization error type.
    type Error;

    /// Deserialize a null value.
    deserializeNull(&this): Result<void, this.Error>;

    /// Deserialize a boolean value.
    deserializeBoolean(&this): Result<boolean, this.Error>;

    /// Deserialize a number value.
    deserializeNumber(&this): Result<number, this.Error>;

    /// Deserialize a string value.
    deserializeString(&this): Result<^string, this.Error>;

    /// Deserialize an array value.
    deserializeArray<T: Deserialize<this>>(&this): Result<^T[], this.Error>;

    /// Deserialize an object field.
    deserializeField<T: Deserialize<this>>(&this, key: string): Result<T | undefined, this.Error>;
}

/// Value that can serialize itself through `S`.
@languageItem("serde.Serialize")
export newtype interface Serialize<S: Serializer> {
    /// Serialize this value.
    serialize(this: ImmutableOf<this>, serializer: &S): Result<void, S.Error>;
}

/// Value that can be deserialized through `D`.
@languageItem("serde.Deserialize")
export newtype interface Deserialize<D: Deserializer> {
    /// Deserialize one value.
    static deserialize(deserializer: &D): Result<this, D.Error>;
}
