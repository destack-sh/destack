import { Binding } from "destack:binding";

import { AudioBackendBinding } from "./backend.ds";
import { AudioClockBinding } from "./clock.ds";
import { AudioDeviceBinding } from "./device.ds";
import { AudioEventBinding } from "./event.ds";
import { AudioStreamBinding } from "./stream.ds";

/// Audio binding family.
@languageItem("audio.AudioBinding")
export interface AudioBinding {
    /// Backend bindings.
    readonly backend: AudioBackendBinding;
    /// Clock bindings.
    readonly clock: AudioClockBinding;
    /// Device bindings.
    readonly device: AudioDeviceBinding;
    /// Event bindings.
    readonly event: AudioEventBinding;
    /// Stream bindings.
    readonly stream: AudioStreamBinding;
}

/// Current audio binding family.
export const audio: Binding<AudioBinding> = new Binding<AudioBinding>("audio");
