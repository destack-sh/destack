import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

import { AudioBackendKind, AudioBackendSelection } from "./backend.ds";

/// Handle for one audio stream endpoint.
export newtype AudioStreamHandle = ResourceId;

import { AudioDirection, AudioFormat, AudioShareMode } from "./device.ds";

/// Audio stream option flags.
export newtype AudioStreamFlags = uint32;

/// No stream flags.
export const AUDIO_STREAM_NONE: AudioStreamFlags = AudioStreamFlags(0x0);

/// Request raw backend format without automatic conversion.
export const AUDIO_STREAM_RAW: AudioStreamFlags = AudioStreamFlags(0x1);

/// Request xrun diagnostics.
export const AUDIO_STREAM_REPORT_XRUN: AudioStreamFlags = AudioStreamFlags(0x2);

/// Require exact format matching.
export const AUDIO_STREAM_EXACT_FORMAT: AudioStreamFlags = AudioStreamFlags(0x4);

/// Audio stream transfer contract.
export enum AudioStreamMode {
    /// Caller moves audio through read and write calls.
    Buffered = 1,
    /// Runtime processes audio on the host audio deadline.
    Realtime = 2,
}

/// Audio stream state.
export enum AudioStreamState {
    /// Stream is stopped.
    Stopped = 1,
    /// Stream is running.
    Running = 2,
    /// Stream is paused.
    Paused = 3,
    /// Stream is draining queued playback data.
    Draining = 4,
    /// Stream lost its host device.
    DeviceLost = 5,
    /// Stream was interrupted by host policy.
    Interrupted = 6,
    /// Stream backend failed.
    Failed = 7,
}

/// Audio stream open request.
export struct AudioStreamRequest {
    /// Backend selection.
    backend: AudioBackendSelection;
    /// Device identifier, omitted for the backend default device.
    deviceId?: string;
    /// Stream direction.
    direction: AudioDirection;
    /// Share mode.
    shareMode: AudioShareMode;
    /// Stream transfer contract.
    mode: AudioStreamMode;
    /// Requested audio format.
    format: AudioFormat;
    /// Requested processing quantum in frames, or zero for backend default.
    quantumFrames: uint32;
    /// Requested buffering in frames, or zero for backend default.
    bufferFrames: uint32;
    /// Stream flags.
    flags: AudioStreamFlags;
}

/// Opened audio stream state.
export struct AudioStream {
    /// Host backend.
    backend: AudioBackendKind;
    /// Stream device identifier.
    deviceId: string;
    /// Stream direction.
    direction: AudioDirection;
    /// Share mode.
    shareMode: AudioShareMode;
    /// Stream transfer contract.
    mode: AudioStreamMode;
    /// Negotiated audio format.
    format: AudioFormat;
    /// Buffer size in frames.
    bufferFrames: uint32;
    /// Processing quantum in frames.
    quantumFrames: uint32;
    /// Backend buffer count.
    bufferCount: uint32;
    /// Bytes per sample.
    sampleBytes: uint16;
    /// Bytes per interleaved frame.
    frameBytes: uint32;
    /// Bytes per channel plane when using planar buffers.
    planeBytes: uint32;
    /// Effective stream flags.
    flags: AudioStreamFlags;
}

/// Audio stream status.
export struct AudioStreamStatus {
    /// Current stream state.
    state: AudioStreamState;
    /// Readable capture frames.
    readableFrames: uint64;
    /// Writable playback frames.
    writableFrames: uint64;
    /// Buffered playback frames.
    bufferedFrames: uint64;
    /// Input latency in nanoseconds.
    inputLatencyNs: uint64;
    /// Output latency in nanoseconds.
    outputLatencyNs: uint64;
    /// Total underflow or overflow count.
    xrunCount: uint64;
    /// Total frames accepted by or delivered from the backend.
    processedFrames: uint64;
    /// Realtime process load as a fraction of the quantum budget.
    processLoad: float64;
    /// Last status sample timestamp in monotonic nanoseconds.
    timestampNs: uint64;
}

/// Audio stream support result.
export struct AudioStreamSupport {
    /// Whether the request can be opened exactly.
    isExact: boolean;
    /// Negotiated audio stream state.
    stream: AudioStream;
}

/// Check whether one audio stream can be opened.
@binding("destack.audio.stream.support", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function supportAudioStream(
    request: &readonly AudioStreamRequest,
): Result<AudioStreamSupport, HostError>;

/// Open one audio stream.
@binding("destack.audio.stream.open", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openAudioStream(
    request: &readonly AudioStreamRequest,
): Result<AudioStreamHandle, HostError>;

/// Close one audio stream.
@binding("destack.audio.stream.close", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeAudioStream(stream: AudioStreamHandle): Result<void, HostError>;

/// Start one audio stream.
@binding("destack.audio.stream.start", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function startAudioStream(stream: AudioStreamHandle): Result<void, HostError>;

/// Pause one audio stream.
@binding("destack.audio.stream.pause", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function pauseAudioStream(stream: AudioStreamHandle): Result<void, HostError>;

/// Resume one audio stream.
@binding("destack.audio.stream.resume", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function resumeAudioStream(stream: AudioStreamHandle): Result<void, HostError>;

/// Stop one audio stream.
@binding("destack.audio.stream.stop", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function stopAudioStream(stream: AudioStreamHandle): Result<void, HostError>;

/// Drain queued playback data.
@binding("destack.audio.stream.drain", {
    effect: "external",
    requires: ["host.audio.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function drainAudioStream(
    stream: AudioStreamHandle,
    timeoutNs?: uint64,
): Result<void, HostError>;

/// Read one opened audio stream state.
@binding("destack.audio.stream.describe", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeAudioStream(
    stream: AudioStreamHandle,
): Result<AudioStream, HostError>;

/// Read one stream status sample.
@binding("destack.audio.stream.status", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function audioStreamStatus(
    stream: AudioStreamHandle,
): Result<AudioStreamStatus, HostError>;

/// Read buffered capture frames into one buffer.
@binding("destack.audio.stream.read", {
    effect: "external",
    requires: ["host.audio.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readAudioStream(
    stream: AudioStreamHandle,
    buffer: &[uint8],
    timeoutNs?: uint64,
): Result<uint64, HostError>;

/// Write buffered playback frames from one buffer.
@binding("destack.audio.stream.write", {
    effect: "external",
    requires: ["host.audio.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeAudioStream(
    stream: AudioStreamHandle,
    bytes: &readonly [uint8],
    timeoutNs?: uint64,
): Result<uint64, HostError>;

/// Set one stream gain multiplier.
@binding("destack.audio.stream.gain", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setAudioStreamGain(
    stream: AudioStreamHandle,
    gain: float64,
): Result<void, HostError>;

/// Set one stream mute state.
@binding("destack.audio.stream.mute", {
    effect: "external",
    requires: ["host.audio.stream"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setAudioStreamMute(
    stream: AudioStreamHandle,
    isMuted: boolean,
): Result<void, HostError>;
