import { AudioStreamHandle } from "destack:audio/host";
import { HostError } from "destack:error/host";

/// Audio stream clock quality.
export enum AudioClockQuality {
    /// No timestamp is available.
    None = 0,
    /// Timestamp is estimated from software state.
    Estimated = 1,
    /// Timestamp is correlated with a device or hardware clock.
    Hardware = 2,
}

/// Audio stream clock sample.
export struct AudioClockSample {
    /// Stream position in frames.
    frames: uint64;
    /// Runtime monotonic timestamp in nanoseconds.
    monotonicNs: uint64;
    /// Device clock timestamp in nanoseconds.
    deviceNs?: uint64;
    /// Input ADC timestamp in nanoseconds.
    inputAdcNs?: uint64;
    /// Output DAC timestamp in nanoseconds.
    outputDacNs?: uint64;
    /// Timestamp quality.
    quality: AudioClockQuality;
    /// Estimated drift in parts per million.
    driftPpm?: float64;
}

/// Read one stream clock sample.
@binding("destack.audio.clock.stream", {
    effect: "external",
    requires: ["host.audio.clock"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function audioStreamClock(
    stream: AudioStreamHandle,
): Result<AudioClockSample, HostError>;
