import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";

import { Duration, DurationLike } from "./duration.ds";
import { TimeError } from "./error.ds";
import { DifferenceOptions, OverflowOptions, RoundTo, TimeToStringOptions } from "./option.ds";
import { PlainDateTime } from "./plain-date-time.ds";
import { ComparisonResult } from "./unit.ds";
import { ZonedDateTime } from "./zoned-date-time.ds";

/// Temporal plain time fields.
export type PlainTimeFields = {
    /// Hour.
    hour?: number;
    /// Minute.
    minute?: number;
    /// Second.
    second?: number;
    /// Millisecond.
    millisecond?: number;
    /// Microsecond.
    microsecond?: number;
    /// Nanosecond.
    nanosecond?: number;
};

/// Value convertible to a Temporal plain time.
export type PlainTimeLike = PlainTime | PlainDateTime | ZonedDateTime | PlainTimeFields | string;

/// Temporal plain time.
@languageItem("time.PlainTime")
export class PlainTime implements ToLocaleString {
