    static create(): PlainTime {
        todo("PlainTime.createDefault")
    }

    /// Create a plain time from positional fields.
    static create(
        hour?: number,
        minute?: number,
        second?: number,
        millisecond?: number,
        microsecond?: number,
        nanosecond?: number,
    ): Result<PlainTime, RangeError> {
        todo("PlainTime.create")
    }

    /// Create a plain time.
    static from(
        item: &readonly PlainTimeLike,
        options?: &readonly OverflowOptions,
    ): Result<PlainTime, TimeError> {
        todo("PlainTime.from")
    }

    /// Compare two plain times.
    static compare(
        one: &readonly PlainTimeLike,
        two: &readonly PlainTimeLike,
    ): Result<ComparisonResult, TimeError> {
        todo("PlainTime.compare")
    }

    /// Construct a validated plain time internally.
    private constructor() {
        todo("PlainTime.constructor");
    }

    /// Hour.
    get hour(&readonly this): number {
        todo("PlainTime.hour")
    }

    /// Minute.
    get minute(&readonly this): number {
        todo("PlainTime.minute")
    }

    /// Second.
    get second(&readonly this): number {
        todo("PlainTime.second")
    }

    /// Millisecond.
    get millisecond(&readonly this): number {
        todo("PlainTime.millisecond")
    }

    /// Microsecond.
    get microsecond(&readonly this): number {
        todo("PlainTime.microsecond")
    }

    /// Nanosecond.
    get nanosecond(&readonly this): number {
        todo("PlainTime.nanosecond")
    }

    /// Return true when this time equals `other`.
    equals(&readonly this, other: &readonly PlainTime): boolean {
        todo("PlainTime.equalsPlainTime")
    }

    /// Convert `other` and return whether it equals this time.
    equals(&readonly this, other: &readonly PlainTimeLike): Result<boolean, TimeError> {
        todo("PlainTime.equals")
    }

    /// Return this time with updated fields.
    with(
        &readonly this,
        timeLike: &readonly PlainTime | PlainTimeFields,
        options?: &readonly OverflowOptions,
    ): Result<PlainTime, TimeError> {
        todo("PlainTime.with")
    }

    /// Add a duration.
    add(&readonly this, durationLike: &readonly DurationLike): Result<PlainTime, TimeError> {
        todo("PlainTime.add")
    }

    /// Subtract a duration.
    subtract(&readonly this, durationLike: &readonly DurationLike): Result<PlainTime, TimeError> {
        todo("PlainTime.subtract")
    }

    /// Return the duration until `other`.
    until(
        &readonly this,
        other: &readonly PlainTimeLike,
