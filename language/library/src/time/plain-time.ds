import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales } from "destack:intl";
import { MaybeOwned } from "destack:memory";

import { Duration, DurationLike } from "./duration.ds";
import { TimeError } from "./error.ds";
import { DifferenceOptions, OverflowOptions, RoundTo, TimeToStringOptions } from "./option.ds";
import { PlainDateTime } from "./plain-date-time.ds";
import { ComparisonResult } from "./unit.ds";
import { ZonedDateTime } from "./zoned-date-time.ds";

/// Temporal plain time fields.
export type PlainTimeFields = {
    /// Hour.
    hour?: number;
    /// Minute.
    minute?: number;
    /// Second.
    second?: number;
    /// Millisecond.
    millisecond?: number;
    /// Microsecond.
    microsecond?: number;
    /// Nanosecond.
    nanosecond?: number;
};

/// Value convertible to a Temporal plain time.
export type PlainTimeLike = PlainTime | PlainDateTime | ZonedDateTime | PlainTimeFields | string;

/// Temporal plain time.
@languageItem("time.PlainTime")
export class PlainTime {
    /// Create midnight.
    static create(): PlainTime {
        todo("PlainTime.createDefault")
    }

    /// Create a plain time from positional fields.
    static create(
        hour?: number,
        minute?: number,
        second?: number,
        millisecond?: number,
        microsecond?: number,
        nanosecond?: number,
    ): Result<PlainTime, RangeError> {
        todo("PlainTime.create")
    }

    /// Create a plain time.
    static from(item: PlainTimeLike, options?: OverflowOptions): Result<PlainTime, TimeError> {
        todo("PlainTime.from")
    }

    /// Compare two plain times.
    static compare(one: PlainTimeLike, two: PlainTimeLike): Result<ComparisonResult, TimeError> {
        todo("PlainTime.compare")
    }

    /// Construct a validated plain time internally.
    private constructor() {
        todo("PlainTime.constructor");
    }

    /// Hour.
    get hour(): number {
        todo("PlainTime.hour")
    }

    /// Minute.
    get minute(): number {
        todo("PlainTime.minute")
    }

    /// Second.
    get second(): number {
        todo("PlainTime.second")
    }

    /// Millisecond.
    get millisecond(): number {
        todo("PlainTime.millisecond")
    }

    /// Microsecond.
    get microsecond(): number {
        todo("PlainTime.microsecond")
    }

    /// Nanosecond.
    get nanosecond(): number {
        todo("PlainTime.nanosecond")
    }

    /// Return true when this time equals `other`.
    equals(other: PlainTime): boolean {
        todo("PlainTime.equalsPlainTime")
    }

    /// Convert `other` and return whether it equals this time.
    equals(other: PlainTimeLike): Result<boolean, TimeError> {
        todo("PlainTime.equals")
    }

    /// Return this time with updated fields.
    with(
        timeLike: PlainTime | PlainTimeFields,
        options?: OverflowOptions,
    ): Result<PlainTime, TimeError> {
        todo("PlainTime.with")
    }

    /// Add a duration.
    add(durationLike: DurationLike): Result<PlainTime, TimeError> {
        todo("PlainTime.add")
    }

    /// Subtract a duration.
    subtract(durationLike: DurationLike): Result<PlainTime, TimeError> {
        todo("PlainTime.subtract")
    }

    /// Return the duration until `other`.
    until(
        other: PlainTimeLike,
        options?: DifferenceOptions<
            "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainTime.until")
    }

    /// Return the duration since `other`.
    since(
        other: PlainTimeLike,
        options?: DifferenceOptions<
            "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainTime.since")
    }

    /// Round this time.
    round(
        roundTo: RoundTo<
            "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<PlainTime, TimeError> {
        todo("PlainTime.round")
    }

    /// Return a locale-aware string.
    toLocaleString(): MaybeOwned<string> {
        todo("PlainTime.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit options.
    toLocaleString(
        locales?: Locales,
        options?: DateTimeFormatOptions,
    ): Result<MaybeOwned<string>, IntlError> {
        todo("PlainTime.toLocaleString")
    }

    /// Return a JSON string.
    toJSON(): MaybeOwned<string> {
        todo("PlainTime.toJSON")
    }

    /// Return an ISO string.
    toString(): MaybeOwned<string> {
        todo("PlainTime.toString")
    }

    /// Return an ISO string with explicit precision options.
    toString(options: TimeToStringOptions): MaybeOwned<string> {
        todo("PlainTime.toString")
    }

    /// Reject numeric coercion.
    valueOf(): never {
        todo("PlainTime.valueOf")
    }
}
