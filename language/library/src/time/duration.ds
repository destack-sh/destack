import { RangeError, Result, todo } from "destack:error";
import { DurationFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";
import { MaybeOwned } from "destack:memory";

import { TimeError } from "./error.ds";
import {
    DurationRelativeToOptions,
    DurationRoundTo,
    DurationToStringOptions,
    DurationTotalOf,
} from "./option.ds";
import { ComparisonResult, SmallestUnit, TimeUnit } from "./unit.ds";

/// Temporal duration fields.
export type DurationFields = {
    /// Year count.
    years?: number;
    /// Month count.
    months?: number;
    /// Week count.
    weeks?: number;
    /// Day count.
    days?: number;
    /// Hour count.
    hours?: number;
    /// Minute count.
    minutes?: number;
    /// Second count.
    seconds?: number;
    /// Millisecond count.
    milliseconds?: number;
    /// Microsecond count.
    microseconds?: number;
    /// Nanosecond count.
    nanoseconds?: number;
};

/// Value convertible to a Temporal duration.
export type DurationLike = Duration | DurationFields | string;

/// Temporal duration.
@languageItem("time.Duration")
export class Duration implements ToLocaleString {
    /// Create a zero duration.
    static create(): Duration {
        todo("Duration.createDefault")
    }

    /// Create a duration from positional fields.
    static create(
        years?: number,
        months?: number,
        weeks?: number,
        days?: number,
        hours?: number,
        minutes?: number,
        seconds?: number,
        milliseconds?: number,
        microseconds?: number,
        nanoseconds?: number,
    ): Result<Duration, RangeError> {
        todo("Duration.create")
    }

    /// Create a duration from another duration, fields, or a string.
    static from(item: DurationLike): Result<Duration, TimeError> {
        todo("Duration.from")
    }

    /// Compare two durations.
    static compare(
        one: DurationLike,
        two: DurationLike,
        options?: DurationRelativeToOptions,
    ): Result<ComparisonResult, TimeError> {
        todo("Duration.compare")
    }

    /// Construct a validated duration internally.
    private constructor() {
        todo("Duration.constructor");
    }

    /// The duration sign.
    get sign(): -1 | 0 | 1 {
        todo("Duration.sign")
    }

    /// Whether every field is zero.
    get blank(): boolean {
        todo("Duration.blank")
    }

    /// Year count.
    get years(): number {
        todo("Duration.years")
    }

    /// Month count.
    get months(): number {
        todo("Duration.months")
    }

    /// Week count.
    get weeks(): number {
        todo("Duration.weeks")
    }

    /// Day count.
    get days(): number {
        todo("Duration.days")
    }

    /// Hour count.
    get hours(): number {
        todo("Duration.hours")
    }

    /// Minute count.
    get minutes(): number {
        todo("Duration.minutes")
    }

    /// Second count.
    get seconds(): number {
        todo("Duration.seconds")
    }

    /// Millisecond count.
    get milliseconds(): number {
        todo("Duration.milliseconds")
    }

    /// Microsecond count.
    get microseconds(): number {
        todo("Duration.microseconds")
    }

    /// Nanosecond count.
    get nanoseconds(): number {
        todo("Duration.nanoseconds")
    }

    /// Return the negated duration.
    negated(): Duration {
        todo("Duration.negated")
    }

    /// Return the absolute duration.
    abs(): Duration {
        todo("Duration.abs")
    }

    /// Return a duration with updated fields.
    with(durationLike: Duration | DurationFields): Result<Duration, TimeError> {
        todo("Duration.with")
    }

    /// Add another duration.
    add(other: DurationLike): Result<Duration, TimeError> {
        todo("Duration.add")
    }

    /// Subtract another duration.
    subtract(other: DurationLike): Result<Duration, TimeError> {
        todo("Duration.subtract")
    }

    /// Round this duration.
    round(roundTo: DurationRoundTo): Result<Duration, TimeError> {
        todo("Duration.round")
    }

    /// Return this duration totalled in one time unit.
    total(totalOf: SmallestUnit<TimeUnit>): number {
        todo("Duration.totalTime")
    }

    /// Return this duration totalled in one unit, relative to a date when the unit needs one.
    total(totalOf: DurationTotalOf): Result<number, TimeError> {
        todo("Duration.total")
    }

    /// Return a locale-aware string.
    toLocaleString(&readonly this): MaybeOwned<string> {
        todo("Duration.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit locales.
    toLocaleString(&readonly this, locales: Locales): Result<MaybeOwned<string>, IntlError> {
        todo("Duration.toLocaleStringLocales")
    }

    /// Return a locale-aware string with explicit options.
    toLocaleString(
        &readonly this,
        locales?: Locales,
        options?: DurationFormatOptions,
    ): Result<MaybeOwned<string>, IntlError> {
        todo("Duration.toLocaleString")
    }

    /// Return a JSON string.
    toJSON(): MaybeOwned<string> {
        todo("Duration.toJSON")
    }

    /// Return an ISO string.
    toString(): MaybeOwned<string> {
        todo("Duration.toString")
    }

    /// Return an ISO string with explicit precision options.
    toString(options: DurationToStringOptions): MaybeOwned<string> {
        todo("Duration.toString")
    }

    /// Reject numeric coercion.
    valueOf(): never {
        todo("Duration.valueOf")
    }
}
