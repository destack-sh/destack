import { HostError } from "tspp:error/host";
import { ResourceId } from "tspp:runtime/resource";

import { Clock, Duration, Timestamp } from "./clock.tspp";

/// Handle for a scheduled timer.
@languageItem("time.binding.TimerHandle")
export newtype TimerHandle = ResourceId;

/// Timer firing mode.
@languageItem("time.binding.TimerMode")
export enum TimerMode {
    /// Fire once.
    Once = 1,
    /// Fire repeatedly.
    Interval = 2,
}

/// Relative timer start point.
export struct TimerDelay {
    /// Delay before the first firing.
    duration: Duration;
}

/// Absolute timer start point.
export struct TimerDeadline {
    /// Deadline clock.
    clock: Clock;
    /// Deadline timestamp.
    time: Timestamp;
}

/// Timer start point.
export type TimerStart = TimerDelay | TimerDeadline;

/// Timer schedule.
export struct TimerSchedule {
    /// First timer firing.
    start: TimerStart;
    /// Timer firing mode.
    mode: TimerMode;
    /// Repeating interval for interval timers.
    interval?: Duration;
}

/// Timer binding family.
@languageItem("time.binding.TimeTimerBinding")
export interface TimeTimerBinding {
    /// Open one timer resource.
    @binding("tspp.time.timer.open", {
        provider: "host",
        effect: "external",
        requires: ["host.time.timer"],
        families: ["windows", "unix", "wasm"],
    })
    openTimer(schedule: &readonly TimerSchedule): Result<TimerHandle, HostError>;

    /// Close one timer resource.
    @binding("tspp.time.timer.close", {
        provider: "host",
        effect: "external",
        requires: ["host.time.timer"],
        families: ["windows", "unix", "wasm"],
    })
    closeTimer(timer: TimerHandle): Result<void, HostError>;

    /// Arm one timer with a new schedule.
    @binding("tspp.time.timer.arm", {
        provider: "host",
        effect: "external",
        requires: ["host.time.timer"],
        families: ["windows", "unix", "wasm"],
    })
    armTimer(timer: TimerHandle, schedule: &readonly TimerSchedule): Result<void, HostError>;

    /// Disarm one timer.
    @binding("tspp.time.timer.disarm", {
        provider: "host",
        effect: "external",
        requires: ["host.time.timer"],
        families: ["windows", "unix", "wasm"],
    })
    disarmTimer(timer: TimerHandle): Result<void, HostError>;

    /// Read elapsed timer firings.
    @binding("tspp.time.timer.read", {
        provider: "host",
        effect: "external",
        requires: ["host.time.timer"],
        families: ["windows", "unix", "wasm"],
    })
    readTimer(timer: TimerHandle): Result<uint64, HostError>;
}
