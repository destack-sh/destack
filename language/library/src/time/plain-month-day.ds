import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";

import { TimeError } from "./error.ds";
import { OverflowOptions, PlainDateToStringOptions } from "./option.ds";
import { PlainDate } from "./plain-date.ds";

/// Temporal plain month-day fields.
export type PlainMonthDayFields = {
    /// Calendar era.
    era?: string;
    /// Calendar era year.
    eraYear?: number;
    /// Calendar year.
    year?: number;
    /// Calendar month.
    month?: number;
    /// Calendar month code.
    monthCode?: string;
    /// Calendar day.
    day?: number;
};

/// Temporal plain month-day fields used for conversion.
export type PlainMonthDayInput = PlainMonthDayFields & {
    /// Calendar day.
    day: number;

    /// Calendar.
    calendar?: string;
};

/// Value convertible to a Temporal plain month-day.
export type PlainMonthDayLike = PlainMonthDay | PlainMonthDayInput | string;

/// Fields used to create a plain date from a month-day.
export type PlainMonthDayToPlainDateOptions = {
    /// Calendar era.
    era?: string;

    /// Calendar era year.
    eraYear?: number;

    /// Calendar year.
    year?: number;
};

/// Temporal plain month-day.
@languageItem("time.PlainMonthDay")
export class PlainMonthDay implements ToLocaleString {
