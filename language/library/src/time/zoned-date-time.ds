    }

    /// Return the duration until `other`.
    until(
        &readonly this,
        other: &readonly ZonedDateTimeLike,
        options?: &readonly DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
