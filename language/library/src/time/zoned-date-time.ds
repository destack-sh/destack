import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";
import { MaybeOwned } from "destack:memory";

import { Duration, DurationLike } from "./duration.ds";
import { TimeError } from "./error.ds";
import { Instant } from "./instant.ds";
import {
    DifferenceOptions,
    OverflowOptions,
    RoundTo,
    ZonedDateTimeFromOptions,
    ZonedDateTimeToStringOptions,
} from "./option.ds";
import { PlainDateTime, PlainDateTimeFields, PlainDateTimeInput } from "./plain-date-time.ds";
import { CalendarLike, PlainDate } from "./plain-date.ds";
import { PlainTime, PlainTimeLike } from "./plain-time.ds";
import { ComparisonResult } from "./unit.ds";

/// Temporal time-zone-like value.
export type TimeZoneLike = string | ZonedDateTime;

/// Temporal transition direction.
export type TransitionDirection =
    | "next"
    | "previous"
    | {
          /// Transition direction.
          direction: "next" | "previous";
      };

/// Temporal zoned date-time fields.
export type ZonedDateTimeFields = PlainDateTimeFields & {
    /// Time-zone offset string.
    offset?: string;
};

/// Temporal zoned date-time fields used for conversion.
export type ZonedDateTimeInput = PlainDateTimeInput & {
    /// Time-zone offset string.
    offset?: string;
    /// Time zone.
    timeZone: TimeZoneLike;
};

/// Value convertible to a Temporal zoned date-time.
export type ZonedDateTimeLike = ZonedDateTime | ZonedDateTimeInput | string;

/// Temporal zoned date-time.
@languageItem("time.ZonedDateTime")
export class ZonedDateTime implements ToLocaleString {
    /// Create a zoned date-time from epoch nanoseconds.
    static create(
        epochNanoseconds: bigint,
        timeZone: string,
        calendar?: string,
    ): Result<ZonedDateTime, RangeError> {
        todo("ZonedDateTime.create")
    }

    /// Create a zoned date-time.
    static from(
        item: ZonedDateTimeLike,
        options?: ZonedDateTimeFromOptions,
    ): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.from")
    }

    /// Compare two zoned date-times.
    static compare(
        one: ZonedDateTimeLike,
        two: ZonedDateTimeLike,
    ): Result<ComparisonResult, TimeError> {
        todo("ZonedDateTime.compare")
    }

    /// Construct a validated zoned date-time internally.
    private constructor() {
        todo("ZonedDateTime.constructor");
    }

    /// Calendar era.
    get era(): MaybeOwned<string> | undefined {
        todo("ZonedDateTime.era")
    }

    /// Calendar era year.
    get eraYear(): number | undefined {
        todo("ZonedDateTime.eraYear")
    }

    /// Calendar year.
    get year(): number {
        todo("ZonedDateTime.year")
    }

    /// Calendar month.
    get month(): number {
        todo("ZonedDateTime.month")
    }

    /// Calendar month code.
    get monthCode(): MaybeOwned<string> {
        todo("ZonedDateTime.monthCode")
    }

    /// Calendar day.
    get day(): number {
        todo("ZonedDateTime.day")
    }

    /// Hour.
    get hour(): number {
        todo("ZonedDateTime.hour")
    }

    /// Minute.
    get minute(): number {
        todo("ZonedDateTime.minute")
    }

    /// Second.
    get second(): number {
        todo("ZonedDateTime.second")
    }

    /// Millisecond.
    get millisecond(): number {
        todo("ZonedDateTime.millisecond")
    }

    /// Microsecond.
    get microsecond(): number {
        todo("ZonedDateTime.microsecond")
    }

    /// Nanosecond.
    get nanosecond(): number {
        todo("ZonedDateTime.nanosecond")
    }

    /// Time-zone identifier.
    get timeZoneId(): MaybeOwned<string> {
        todo("ZonedDateTime.timeZoneId")
    }

    /// Calendar identifier.
    get calendarId(): MaybeOwned<string> {
        todo("ZonedDateTime.calendarId")
    }

    /// Day of week.
    get dayOfWeek(): number {
        todo("ZonedDateTime.dayOfWeek")
    }

    /// Day of year.
    get dayOfYear(): number {
        todo("ZonedDateTime.dayOfYear")
    }

    /// Week of year.
    get weekOfYear(): number | undefined {
        todo("ZonedDateTime.weekOfYear")
    }

    /// Week-based year.
    get yearOfWeek(): number | undefined {
        todo("ZonedDateTime.yearOfWeek")
    }

    /// Hours in this day.
    get hoursInDay(): number {
        todo("ZonedDateTime.hoursInDay")
    }

    /// Days in this week.
    get daysInWeek(): number {
        todo("ZonedDateTime.daysInWeek")
    }

    /// Days in this month.
    get daysInMonth(): number {
        todo("ZonedDateTime.daysInMonth")
    }

    /// Days in this year.
    get daysInYear(): number {
        todo("ZonedDateTime.daysInYear")
    }

    /// Months in this year.
    get monthsInYear(): number {
        todo("ZonedDateTime.monthsInYear")
    }

    /// Whether this year is a leap year.
    get inLeapYear(): boolean {
        todo("ZonedDateTime.inLeapYear")
    }

    /// Offset in nanoseconds.
    get offsetNanoseconds(): number {
        todo("ZonedDateTime.offsetNanoseconds")
    }

    /// Offset string.
    get offset(): MaybeOwned<string> {
        todo("ZonedDateTime.offset")
    }

    /// Epoch milliseconds.
    get epochMilliseconds(): number {
        todo("ZonedDateTime.epochMilliseconds")
    }

    /// Epoch nanoseconds.
    get epochNanoseconds(): bigint {
        todo("ZonedDateTime.epochNanoseconds")
    }

    /// Return true when this zoned date-time equals `other`.
    equals(other: ZonedDateTime): boolean {
        todo("ZonedDateTime.equalsZonedDateTime")
    }

    /// Convert `other` and return whether it equals this zoned date-time.
    equals(other: ZonedDateTimeLike): Result<boolean, TimeError> {
        todo("ZonedDateTime.equals")
    }

    /// Return this zoned date-time with updated fields.
    with(
        zonedDateTimeLike: ZonedDateTimeFields,
        options?: ZonedDateTimeFromOptions,
    ): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.with")
    }

    /// Return this zoned date-time with another time.
    withPlainTime(time?: PlainTimeLike): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.withPlainTime")
    }

    /// Return this zoned date-time in another calendar.
    withCalendar(calendar: CalendarLike): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.withCalendar")
    }

    /// Return this zoned date-time in another time zone.
    withTimeZone(timeZone: TimeZoneLike): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.withTimeZone")
    }

    /// Add a duration.
    add(durationLike: DurationLike, options?: OverflowOptions): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.add")
    }

    /// Subtract a duration.
    subtract(
        durationLike: DurationLike,
        options?: OverflowOptions,
    ): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.subtract")
    }

    /// Return the duration until `other`.
    until(
        other: ZonedDateTimeLike,
        options?: DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("ZonedDateTime.until")
    }

    /// Return the duration since `other`.
    since(
        other: ZonedDateTimeLike,
        options?: DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("ZonedDateTime.since")
    }

    /// Round this zoned date-time.
    round(
        roundTo: RoundTo<
            "day" | "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<ZonedDateTime, TimeError> {
        todo("ZonedDateTime.round")
    }

    /// Return the start of this day.
    startOfDay(): ZonedDateTime {
        todo("ZonedDateTime.startOfDay")
    }

    /// Return the next or previous time-zone transition.
    getTimeZoneTransition(direction: TransitionDirection): ZonedDateTime | null {
        todo("ZonedDateTime.getTimeZoneTransition")
    }

    /// Convert this zoned date-time into an instant.
    toInstant(): Instant {
        todo("ZonedDateTime.toInstant")
    }

    /// Return the plain date-time part.
    toPlainDateTime(): PlainDateTime {
        todo("ZonedDateTime.toPlainDateTime")
    }

    /// Return the plain date part.
    toPlainDate(): PlainDate {
        todo("ZonedDateTime.toPlainDate")
    }

    /// Return the plain time part.
    toPlainTime(): PlainTime {
        todo("ZonedDateTime.toPlainTime")
    }

    /// Return a locale-aware string.
    toLocaleString(): MaybeOwned<string> {
        todo("ZonedDateTime.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit options.
    toLocaleString(
        locales?: Locales,
        options?: DateTimeFormatOptions,
    ): Result<MaybeOwned<string>, IntlError> {
        todo("ZonedDateTime.toLocaleString")
    }

    /// Return a JSON string.
    toJSON(): MaybeOwned<string> {
        todo("ZonedDateTime.toJSON")
    }

    /// Return an ISO string.
    toString(): MaybeOwned<string> {
        todo("ZonedDateTime.toString")
    }

    /// Return an ISO string with explicit rendering options.
    toString(options: ZonedDateTimeToStringOptions): MaybeOwned<string> {
        todo("ZonedDateTime.toString")
    }

    /// Reject numeric coercion.
    valueOf(): never {
        todo("ZonedDateTime.valueOf")
    }
}
