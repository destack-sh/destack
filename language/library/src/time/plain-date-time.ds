import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";
import { MaybeOwned } from "destack:memory";

import { Duration, DurationLike } from "./duration.ds";
import { TimeError } from "./error.ds";
import {
    DifferenceOptions,
    DisambiguationOptions,
    OverflowOptions,
    PlainDateTimeToStringOptions,
    RoundTo,
} from "./option.ds";
import { CalendarLike, PlainDate } from "./plain-date.ds";
import { PlainTime, PlainTimeLike } from "./plain-time.ds";
import { ComparisonResult } from "./unit.ds";
import { TimeZoneLike, ZonedDateTime } from "./zoned-date-time.ds";

/// Temporal plain date-time fields.
export type PlainDateTimeFields = {
    /// Calendar era.
    era?: string;
    /// Calendar era year.
    eraYear?: number;
    /// Calendar year.
    year?: number;
    /// Calendar month.
    month?: number;
    /// Calendar month code.
    monthCode?: string;
    /// Calendar day.
    day?: number;
    /// Hour.
    hour?: number;
    /// Minute.
    minute?: number;
    /// Second.
    second?: number;
    /// Millisecond.
    millisecond?: number;
    /// Microsecond.
    microsecond?: number;
    /// Nanosecond.
    nanosecond?: number;
};

/// Temporal plain date-time fields used for conversion.
export type PlainDateTimeInput = PlainDateTimeFields & {
    /// Calendar day.
    day: number;

    /// Calendar.
    calendar?: string;
};

/// Value convertible to a Temporal plain date-time.
export type PlainDateTimeLike =
    | PlainDateTime
    | ZonedDateTime
    | PlainDate
    | PlainDateTimeInput
    | string;

/// Temporal plain date-time.
@languageItem("time.PlainDateTime")
export class PlainDateTime implements ToLocaleString {
    /// Create an ISO plain date-time.
    static create(
        isoYear: number,
        isoMonth: number,
        isoDay: number,
        hour?: number,
        minute?: number,
        second?: number,
        millisecond?: number,
        microsecond?: number,
        nanosecond?: number,
        calendar?: string,
    ): Result<PlainDateTime, RangeError> {
        todo("PlainDateTime.create")
    }

    /// Create a plain date-time.
    static from(
        item: PlainDateTimeLike,
        options?: OverflowOptions,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.from")
    }

    /// Compare two plain date-times.
    static compare(
        one: PlainDateTimeLike,
        two: PlainDateTimeLike,
    ): Result<ComparisonResult, TimeError> {
        todo("PlainDateTime.compare")
    }

    /// Construct a validated plain date-time internally.
    private constructor() {
        todo("PlainDateTime.constructor");
    }

    /// Calendar era.
    get era(): MaybeOwned<string> | undefined {
        todo("PlainDateTime.era")
    }

    /// Calendar era year.
    get eraYear(): number | undefined {
        todo("PlainDateTime.eraYear")
    }

    /// Calendar year.
    get year(): number {
        todo("PlainDateTime.year")
    }

    /// Calendar month.
    get month(): number {
        todo("PlainDateTime.month")
    }

    /// Calendar month code.
    get monthCode(): MaybeOwned<string> {
        todo("PlainDateTime.monthCode")
    }

    /// Calendar day.
    get day(): number {
        todo("PlainDateTime.day")
    }

    /// Hour.
    get hour(): number {
        todo("PlainDateTime.hour")
    }

    /// Minute.
    get minute(): number {
        todo("PlainDateTime.minute")
    }

    /// Second.
    get second(): number {
        todo("PlainDateTime.second")
    }

    /// Millisecond.
    get millisecond(): number {
        todo("PlainDateTime.millisecond")
    }

    /// Microsecond.
    get microsecond(): number {
        todo("PlainDateTime.microsecond")
    }

    /// Nanosecond.
    get nanosecond(): number {
        todo("PlainDateTime.nanosecond")
    }

    /// Calendar identifier.
    get calendarId(): MaybeOwned<string> {
        todo("PlainDateTime.calendarId")
    }

    /// Day of week.
    get dayOfWeek(): number {
        todo("PlainDateTime.dayOfWeek")
    }

    /// Day of year.
    get dayOfYear(): number {
        todo("PlainDateTime.dayOfYear")
    }

    /// Week of year.
    get weekOfYear(): number | undefined {
        todo("PlainDateTime.weekOfYear")
    }

    /// Week-based year.
    get yearOfWeek(): number | undefined {
        todo("PlainDateTime.yearOfWeek")
    }

    /// Days in this week.
    get daysInWeek(): number {
        todo("PlainDateTime.daysInWeek")
    }

    /// Days in this year.
    get daysInYear(): number {
        todo("PlainDateTime.daysInYear")
    }

    /// Days in this month.
    get daysInMonth(): number {
        todo("PlainDateTime.daysInMonth")
    }

    /// Months in this year.
    get monthsInYear(): number {
        todo("PlainDateTime.monthsInYear")
    }

    /// Whether this year is a leap year.
    get inLeapYear(): boolean {
        todo("PlainDateTime.inLeapYear")
    }

    /// Return true when this date-time equals `other`.
    equals(other: PlainDateTime): boolean {
        todo("PlainDateTime.equalsPlainDateTime")
    }

    /// Convert `other` and return whether it equals this date-time.
    equals(other: PlainDateTimeLike): Result<boolean, TimeError> {
        todo("PlainDateTime.equals")
    }

    /// Return this date-time with updated fields.
    with(
        dateTimeLike: PlainDateTimeFields,
        options?: OverflowOptions,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.with")
    }

    /// Return this date-time with another time.
    withPlainTime(time?: PlainTimeLike): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.withPlainTime")
    }

    /// Return this date-time in another calendar.
    withCalendar(calendar: CalendarLike): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.withCalendar")
    }

    /// Add a duration.
    add(durationLike: DurationLike, options?: OverflowOptions): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.add")
    }

    /// Subtract a duration.
    subtract(
        durationLike: DurationLike,
        options?: OverflowOptions,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.subtract")
    }

    /// Return the duration until `other`.
    until(
        other: PlainDateTimeLike,
        options?: DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainDateTime.until")
    }

    /// Return the duration since `other`.
    since(
        other: PlainDateTimeLike,
        options?: DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainDateTime.since")
    }

    /// Round this date-time.
    round(
        roundTo: RoundTo<
            "day" | "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.round")
    }

    /// Convert this date-time into a zoned date-time.
    toZonedDateTime(
        timeZone: TimeZoneLike,
        options?: DisambiguationOptions,
    ): Result<ZonedDateTime, TimeError> {
        todo("PlainDateTime.toZonedDateTime")
    }

    /// Return the date part.
    toPlainDate(): PlainDate {
        todo("PlainDateTime.toPlainDate")
    }

    /// Return the time part.
    toPlainTime(): PlainTime {
        todo("PlainDateTime.toPlainTime")
    }

    /// Return a locale-aware string.
    toLocaleString(): MaybeOwned<string> {
        todo("PlainDateTime.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit options.
    toLocaleString(
        locales?: Locales,
        options?: DateTimeFormatOptions,
    ): Result<MaybeOwned<string>, IntlError> {
        todo("PlainDateTime.toLocaleString")
    }

    /// Return a JSON string.
    toJSON(): MaybeOwned<string> {
        todo("PlainDateTime.toJSON")
    }

    /// Return an ISO string.
    toString(): MaybeOwned<string> {
        todo("PlainDateTime.toString")
    }

    /// Return an ISO string with explicit rendering options.
    toString(options: PlainDateTimeToStringOptions): MaybeOwned<string> {
        todo("PlainDateTime.toString")
    }

    /// Reject numeric coercion.
    valueOf(): never {
        todo("PlainDateTime.valueOf")
    }
}
