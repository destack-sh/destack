        todo("PlainDateTime.subtract")
    }

    /// Return the duration until `other`.
    until(
        &readonly this,
        other: &readonly PlainDateTimeLike,
        options?: &readonly DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainDateTime.until")
    }

    /// Return the duration since `other`.
    since(
        &readonly this,
        other: &readonly PlainDateTimeLike,
        options?: &readonly DifferenceOptions<
            | "year"
            | "month"
            | "week"
            | "day"
            | "hour"
            | "minute"
            | "second"
            | "millisecond"
            | "microsecond"
            | "nanosecond"
        >,
    ): Result<Duration, TimeError> {
        todo("PlainDateTime.since")
    }

    /// Round this date-time.
    round(
        &readonly this,
        roundTo: &readonly RoundTo<
            "day" | "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
        >,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDateTime.round")
    }

    /// Convert this date-time into a zoned date-time.
    toZonedDateTime(
        &readonly this,
        timeZone: TimeZoneLike,
        options?: &readonly DisambiguationOptions,
    ): Result<ZonedDateTime, TimeError> {
        todo("PlainDateTime.toZonedDateTime")
    }

    /// Return the date part.
    toPlainDate(&readonly this): PlainDate {
        todo("PlainDateTime.toPlainDate")
    }

    /// Return the time part.
    toPlainTime(&readonly this): PlainTime {
        todo("PlainDateTime.toPlainTime")
    }

    /// Return a locale-aware string.
    toLocaleString(&readonly this): ^string {
        todo("PlainDateTime.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit locales.
    toLocaleString(&readonly this, locales: &readonly Locales): Result<string, IntlError> {
        todo("PlainDateTime.toLocaleStringLocales")
    }

    /// Return a locale-aware string with explicit options.
