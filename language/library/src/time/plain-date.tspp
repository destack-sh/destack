import { RangeError, Result, todo } from "tspp:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "tspp:intl";

import { Duration, DurationLike } from "./duration.tspp";
import { TimeError } from "./error.tspp";
import { DifferenceOptions, OverflowOptions, PlainDateToStringOptions } from "./option.tspp";
import { PlainDateTime } from "./plain-date-time.tspp";
import { PlainMonthDay } from "./plain-month-day.tspp";
import { PlainTimeLike } from "./plain-time.tspp";
import { PlainYearMonth } from "./plain-year-month.tspp";
import { ComparisonResult } from "./unit.tspp";
import { TimeZoneLike, ZonedDateTime } from "./zoned-date-time.tspp";

/// Temporal calendar-like value.
export type CalendarLike =
    | string
    | ZonedDateTime
    | PlainDateTime
    | PlainDate
    | PlainYearMonth
    | PlainMonthDay;

/// Temporal plain date fields.
export type PlainDateFields = {
    /// Calendar era.
    era?: string;
    /// Calendar era year.
    eraYear?: number;
    /// Calendar year.
    year?: number;
    /// Calendar month.
    month?: number;
    /// Calendar month code.
    monthCode?: string;
    /// Calendar day.
    day?: number;
};

/// Temporal plain date fields used for conversion.
export type PlainDateInput = PlainDateFields & {
    /// Calendar day.
    day: number;

    /// Calendar.
    calendar?: string;
};

/// Value convertible to a Temporal plain date.
export type PlainDateLike = PlainDate | ZonedDateTime | PlainDateTime | PlainDateInput | string;

/// Temporal plain date.
@languageItem("time.PlainDate")
export class PlainDate implements ToLocaleString {
    /// Create an ISO plain date.
    static create(
        isoYear: number,
        isoMonth: number,
        isoDay: number,
        calendar?: string,
    ): Result<PlainDate, RangeError> {
        todo("PlainDate.create")
    }

    /// Create a plain date.
    static from(
        item: &readonly PlainDateLike,
        options?: &readonly OverflowOptions,
    ): Result<PlainDate, TimeError> {
        todo("PlainDate.from")
    }

    /// Compare two plain dates.
    static compare(
        one: &readonly PlainDateLike,
        two: &readonly PlainDateLike,
    ): Result<ComparisonResult, TimeError> {
        todo("PlainDate.compare")
    }

    /// Construct a validated plain date internally.
    private constructor() {
        todo("PlainDate.constructor");
    }

    /// Calendar era.
    get era(&readonly this): string | undefined {
        todo("PlainDate.era")
    }

    /// Calendar era year.
    get eraYear(&readonly this): number | undefined {
        todo("PlainDate.eraYear")
    }

    /// Calendar year.
    get year(&readonly this): number {
        todo("PlainDate.year")
    }

    /// Calendar month.
    get month(&readonly this): number {
        todo("PlainDate.month")
    }

    /// Calendar month code.
    get monthCode(&readonly this): ^string {
        todo("PlainDate.monthCode")
    }

    /// Calendar day.
    get day(&readonly this): number {
        todo("PlainDate.day")
    }

    /// Calendar identifier.
    get calendarId(&readonly this): ^string {
        todo("PlainDate.calendarId")
    }

    /// Day of week.
    get dayOfWeek(&readonly this): number {
        todo("PlainDate.dayOfWeek")
    }

    /// Day of year.
    get dayOfYear(&readonly this): number {
        todo("PlainDate.dayOfYear")
    }

    /// Week of year.
    get weekOfYear(&readonly this): number | undefined {
        todo("PlainDate.weekOfYear")
    }

    /// Week-based year.
    get yearOfWeek(&readonly this): number | undefined {
        todo("PlainDate.yearOfWeek")
    }

    /// Days in this week.
    get daysInWeek(&readonly this): number {
        todo("PlainDate.daysInWeek")
    }

    /// Days in this year.
    get daysInYear(&readonly this): number {
        todo("PlainDate.daysInYear")
    }

    /// Days in this month.
    get daysInMonth(&readonly this): number {
        todo("PlainDate.daysInMonth")
    }

    /// Months in this year.
    get monthsInYear(&readonly this): number {
        todo("PlainDate.monthsInYear")
    }

    /// Whether this year is a leap year.
    get inLeapYear(&readonly this): boolean {
        todo("PlainDate.inLeapYear")
    }

    /// Return true when this date equals `other`.
    equals(&readonly this, other: &readonly PlainDate): boolean {
        todo("PlainDate.equalsPlainDate")
    }

    /// Convert `other` and return whether it equals this date.
    equals(&readonly this, other: &readonly PlainDateLike): Result<boolean, TimeError> {
        todo("PlainDate.equals")
    }

    /// Return this date with updated fields.
    with(
        &readonly this,
        dateLike: &readonly PlainDateFields,
        options?: &readonly OverflowOptions,
    ): Result<PlainDate, TimeError> {
        todo("PlainDate.with")
    }

    /// Return this date in another calendar.
    withCalendar(&readonly this, calendar: CalendarLike): Result<PlainDate, TimeError> {
        todo("PlainDate.withCalendar")
    }

    /// Add a duration.
    add(
        &readonly this,
        durationLike: &readonly DurationLike,
        options?: &readonly OverflowOptions,
    ): Result<PlainDate, TimeError> {
        todo("PlainDate.add")
    }

    /// Subtract a duration.
    subtract(
        &readonly this,
        durationLike: &readonly DurationLike,
        options?: &readonly OverflowOptions,
    ): Result<PlainDate, TimeError> {
        todo("PlainDate.subtract")
    }

    /// Return the duration until `other`.
    until(
        &readonly this,
        other: &readonly PlainDateLike,
        options?: &readonly DifferenceOptions<"year" | "month" | "week" | "day">,
    ): Result<Duration, TimeError> {
        todo("PlainDate.until")
    }

    /// Return the duration since `other`.
    since(
        &readonly this,
        other: &readonly PlainDateLike,
        options?: &readonly DifferenceOptions<"year" | "month" | "week" | "day">,
    ): Result<Duration, TimeError> {
        todo("PlainDate.since")
    }

    /// Combine this date with a time.
    toPlainDateTime(
        &readonly this,
        time?: &readonly PlainTimeLike,
    ): Result<PlainDateTime, TimeError> {
        todo("PlainDate.toPlainDateTime")
    }

    /// Convert this date into a zoned date-time.
    toZonedDateTime(
        &readonly this,
        options: TimeZoneLike | { timeZone: TimeZoneLike; plainTime?: PlainTimeLike },
    ): Result<ZonedDateTime, TimeError> {
        todo("PlainDate.toZonedDateTime")
    }

    /// Return the year-month part.
    toPlainYearMonth(&readonly this): PlainYearMonth {
        todo("PlainDate.toPlainYearMonth")
    }

    /// Return the month-day part.
    toPlainMonthDay(&readonly this): PlainMonthDay {
        todo("PlainDate.toPlainMonthDay")
    }

    /// Return a locale-aware string.
    toLocaleString(&readonly this): ^string {
        todo("PlainDate.toLocaleStringDefault")
    }

    /// Return a locale-aware string with explicit locales.
    toLocaleString(&readonly this, locales: &readonly Locales): Result<string, IntlError> {
        todo("PlainDate.toLocaleStringLocales")
    }

    /// Return a locale-aware string with explicit options.
    toLocaleString(
        &readonly this,
        locales?: &readonly Locales,
        options?: &readonly DateTimeFormatOptions,
    ): Result<string, IntlError> {
        todo("PlainDate.toLocaleString")
    }

    /// Return a JSON string.
    toJSON(&readonly this): ^string {
        todo("PlainDate.toJSON")
    }

    /// Return an ISO string.
    toString(&readonly this): ^string {
        todo("PlainDate.toString")
    }

    /// Return an ISO string with explicit calendar options.
    toString(&readonly this, options: &readonly PlainDateToStringOptions): ^string {
        todo("PlainDate.toString")
    }

    /// Reject numeric coercion.
    valueOf(&readonly this): never {
        todo("PlainDate.valueOf")
    }
}
