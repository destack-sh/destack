/// Temporal plain year-month fields.
export type PlainYearMonthFields = {
    /// Calendar era.
    era?: string;
    /// Calendar era year.
    eraYear?: number;
    /// Calendar year.
    year?: number;
    /// Calendar month.
    month?: number;
    /// Calendar month code.
    monthCode?: string;
};

/// Temporal plain year-month fields used for conversion.
export type PlainYearMonthInput = PlainYearMonthFields & {
    /// Calendar.
    calendar?: string;
};

/// Value convertible to a Temporal plain year-month.
export type PlainYearMonthLike = PlainYearMonth | PlainYearMonthInput | string;

