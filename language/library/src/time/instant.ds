        todo("Instant.fromEpochNanoseconds")
    }

    /// Create an instant from another instant or string.
    static from(item: InstantLike): Result<Instant, TimeError> {
        todo("Instant.from")
    }

    /// Compare two instants.
    static compare(one: InstantLike, two: InstantLike): Result<ComparisonResult, TimeError> {
        todo("Instant.compare")
    }

    /// Construct a validated instant internally.
    private constructor() {
        todo("Instant.constructor");
    }

    /// Epoch milliseconds.
    get epochMilliseconds(): number {
        todo("Instant.epochMilliseconds")
    }

    /// Epoch nanoseconds.
    get epochNanoseconds(): bigint {
        todo("Instant.epochNanoseconds")
    }

    /// Return true when this instant equals `other`.
    equals(other: Instant): boolean {
        todo("Instant.equalsInstant")
    }

    /// Parse `other` and return whether it equals this instant.
    equals(other: InstantLike): Result<boolean, TimeError> {
        todo("Instant.equals")
    }

    /// Add a time duration.
    add(durationLike: DurationLike): Result<Instant, TimeError> {
        todo("Instant.add")
    }

    /// Subtract a time duration.
    subtract(durationLike: DurationLike): Result<Instant, TimeError> {
        todo("Instant.subtract")
    }

    /// Return the duration until `other`.
    until(
        other: InstantLike,
        options?: DifferenceOptions<
            "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond"
