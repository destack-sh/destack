import { RangeError, Result, todo } from "destack:error";
import { DateTimeFormatOptions, IntlError, Locales, ToLocaleString } from "destack:intl";
import { MaybeOwned } from "destack:memory";

import { Duration, DurationLike } from "./duration.ds";
import { TimeError } from "./error.ds";
import { DifferenceOptions, InstantToStringOptions, RoundTo } from "./option.ds";
import { ComparisonResult } from "./unit.ds";
import { TimeZoneLike, ZonedDateTime } from "./zoned-date-time.ds";

/// Value convertible to a Temporal instant.
export type InstantLike = Instant | ZonedDateTime | string;

/// Temporal instant.
@languageItem("time.Instant")
export class Instant implements ToLocaleString {
