import { EdgeId, EdgeKind } from "./edge.tspp";
import { EntityId, EntityKind } from "./entity.tspp";
import { LabelSet } from "./label.tspp";

/// Entity decorator options.
export struct EntityOptions<T = unknown> {
    /// Entity kind.
    kind: EntityKind;
    /// Entity identifier projection.
    id?: (value: &readonly T) => EntityId;
    /// Entity name projection.
    name?: (value: &readonly T) => string | undefined;
    /// Entity labels projection.
    labels?: (value: &readonly T) => LabelSet | undefined;
}

/// Edge decorator options.
export struct EdgeOptions<T = unknown> {
    /// Edge kind.
    kind: EdgeKind;
    /// Edge identifier projection.
    id?: (value: &readonly T) => EdgeId;
    /// Source entity projection.
    from?: (value: &readonly T) => EntityId;
    /// Destination entity projection.
    to?: (value: &readonly T) => EntityId;
    /// Edge name projection.
    name?: (value: &readonly T) => string | undefined;
    /// Edge labels projection.
    labels?: (value: &readonly T) => LabelSet | undefined;
}

/// Mark a declaration as a topology entity.
@languageItem("topology.entity")
export newtype entity<T = unknown> = EntityOptions<T>;

/// Mark a declaration as a topology edge.
@languageItem("topology.edge")
export newtype edge<T = unknown> = EdgeOptions<T>;
