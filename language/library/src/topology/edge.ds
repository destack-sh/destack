import { EntityId, EntitySelector } from "./entity.ds";
import { LabelSelector, LabelSet } from "./label.ds";

/// Topology edge identifier.
export newtype EdgeId = string;

/// Topology edge kind.
export newtype EdgeKind = string;

/// Direction selector for directional relationships.
export enum Direction {
    /// Affect ingress traffic.
    Ingress = 1,
    /// Affect egress traffic.
    Egress = 2,
    /// Affect both directions.
    Both = 3,
}

/// Concrete topology edge record.
export struct EdgeRecord {
    /// Edge identifier.
    id: EdgeId;
    /// Edge kind.
    kind: EdgeKind;
    /// Source entity.
    from: EntityId;
    /// Destination entity.
    to: EntityId;
    /// Optional edge name.
    name?: string;
    /// Edge labels.
    labels?: LabelSet;
}

/// Selector that matches every edge.
export struct EdgeAny {
    /// Selector discriminator.
    kind: "any";
}

/// Selector that matches one edge by id.
export struct EdgeById {
    /// Selector discriminator.
    kind: "id";
    /// Edge id to match.
    id: EdgeId;
}

/// Selector that matches a fixed edge id set.
export struct EdgeByIds {
    /// Selector discriminator.
    kind: "ids";
    /// Edge ids to match.
    ids: [EdgeId];
}

/// Selector that matches edges by kind.
export struct EdgeByKind {
    /// Selector discriminator.
    kind: "kind";
    /// Edge kind to match.
    edgeKind: EdgeKind;
}

/// Selector that matches edges incident to selected entities.
export struct EdgeIncident {
    /// Selector discriminator.
    kind: "incident";
    /// Incident entity selector.
    entity: EntitySelector;
}

/// Selector that matches edges between source and destination selectors.
export struct EdgeBetween {
    /// Selector discriminator.
    kind: "between";
    /// Source entity selector.
    from: EntitySelector;
    /// Destination entity selector.
    to: EntitySelector;
}

/// Selector that matches edges by labels.
export struct EdgeByLabels {
    /// Selector discriminator.
    kind: "labels";
    /// Label selector clauses.
    labels: [LabelSelector];
}

/// Topology edge selector.
@derive(Tagged)
export newtype EdgeSelector =
    | EdgeAny
    | EdgeById
    | EdgeByIds
    | EdgeByKind
    | EdgeIncident
    | EdgeBetween
    | EdgeByLabels;

/// Programmable edge projection.
export newtype interface Edge {
    /// Edge kind for this projected value.
    type Kind: EdgeKind;

    /// Return this value's edge identifier.
    edgeId(this: &readonly this): EdgeId;

    /// Return this value's source entity.
    edgeFrom(this: &readonly this): EntityId;

    /// Return this value's destination entity.
    edgeTo(this: &readonly this): EntityId;

    /// Return this value's edge name.
    edgeName(this: &readonly this): string | undefined;

    /// Return this value's edge labels.
    edgeLabels(this: &readonly this): LabelSet | undefined;
}

/// Match every topology edge.
export function anyEdge(): EdgeSelector {
    EdgeAny { kind: "any" }
}

/// Match one topology edge by id.
export function edgeId(id: EdgeId): EdgeSelector {
    EdgeById { kind: "id", id }
}

/// Match topology edges by kind.
export function edgeKind(kind: EdgeKind): EdgeSelector {
    EdgeByKind { kind: "kind", edgeKind: kind }
}

/// Match topology edges between two entity selectors.
export function between(from: EntitySelector, to: EntitySelector): EdgeSelector {
    EdgeBetween { kind: "between", from, to }
}

/// Project one value to an edge record.
export function edgeOf<T: Edge>(value: &readonly T): EdgeRecord {
    EdgeRecord {
        id: value.edgeId(),
        kind: T.Kind,
        from: value.edgeFrom(),
        to: value.edgeTo(),
        name: value.edgeName(),
        labels: value.edgeLabels(),
    }
}
