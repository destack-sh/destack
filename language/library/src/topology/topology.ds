import { HostError } from "destack:error/host";
import { WorldHandle } from "destack:runtime";

import { topology } from "./binding/topology.ds";
import {
    Edge,
    EdgeId,
    EdgeKind,
    EdgeKindRecord,
    EdgeRecord,
    EdgeSelector,
    edgeOf,
} from "./edge.ds";
import {
    Entity,
    EntityId,
    EntityKind,
    EntityKindRecord,
    EntityRecord,
    EntitySelector,
    entityOf,
} from "./entity.ds";
import { LabelSet } from "./label.ds";

/// Registered topology entity reference.
@languageItem("topology.EntityRef")
export newtype EntityRef = EntityId;

/// Registered topology edge reference.
@languageItem("topology.EdgeRef")
export newtype EdgeRef = EdgeId;

/// Entity or edge topology record.
@languageItem("topology.Record")
export newtype Record = EntityRecord | EdgeRecord;

/// Runtime topology graph.
@languageItem("topology.Topology")
export class Topology {
    /// World handle.
    world: WorldHandle;

    /// Wrap one runtime world topology.
    constructor(world: WorldHandle) {
        this.world = world;
    }

    /// Define one entity kind.
    defineEntityKind(&readonly this, kind: EntityKind, labels?: LabelSet): Result<void, HostError> {
        topology.get().entity.defineKind(this.world, EntityKindRecord { kind, labels })
    }

    /// Undefine one entity kind.
    undefineEntityKind(&readonly this, kind: EntityKind): Result<void, HostError> {
        topology.get().entity.undefineKind(this.world, kind)
    }

    /// Define one edge kind.
    defineEdgeKind(&readonly this, kind: EdgeKind, labels?: LabelSet): Result<void, HostError> {
        topology.get().edge.defineKind(this.world, EdgeKindRecord { kind, labels })
    }

    /// Undefine one edge kind.
    undefineEdgeKind(&readonly this, kind: EdgeKind): Result<void, HostError> {
        topology.get().edge.undefineKind(this.world, kind)
    }

    /// Upsert one entity record.
    upsertEntity(&readonly this, entity: EntityRecord): Result<EntityRef, HostError> {
        topology.get().entity.upsert(this.world, entity).map((id) => EntityRef(id))
    }

    /// Upsert one edge record.
    upsertEdge(&readonly this, edge: EdgeRecord): Result<EdgeRef, HostError> {
        topology.get().edge.upsert(this.world, edge).map((id) => EdgeRef(id))
    }

    /// Observe one entity-like value.
    observe<T: Entity>(&readonly this, value: &readonly T): Result<EntityRef, HostError> {
        this.upsertEntity(entityOf(value))
    }

    /// Observe one edge-like value.
    connect<T: Edge>(&readonly this, value: &readonly T): Result<EdgeRef, HostError> {
        this.upsertEdge(edgeOf(value))
    }

    /// Remove one entity.
    removeEntity(&readonly this, id: EntityId): Result<boolean, HostError> {
        topology.get().entity.remove(this.world, id)
    }

    /// Remove one edge.
    removeEdge(&readonly this, id: EdgeId): Result<boolean, HostError> {
        topology.get().edge.remove(this.world, id)
    }

    /// Return entities matching `selector`.
    entities(&readonly this, selector?: EntitySelector): Result<[EntityRecord], HostError> {
        topology.get().entity.list(this.world, selector)
    }

    /// Return edges matching `selector`.
    edges(&readonly this, selector?: EdgeSelector): Result<[EdgeRecord], HostError> {
        topology.get().edge.list(this.world, selector)
    }
}
