import { Binding } from "destack:binding";

import { TopologyEdgeBinding } from "./edge.ds";
import { TopologyEntityBinding } from "./entity.ds";

/// Topology binding family.
@languageItem("topology.TopologyBinding")
export interface TopologyBinding {
    /// Edge bindings.
    readonly edge: TopologyEdgeBinding;
    /// Entity bindings.
    readonly entity: TopologyEntityBinding;
}

/// Current topology binding family.
export const topology = new Binding<TopologyBinding>("topology");
