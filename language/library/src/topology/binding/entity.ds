import { HostError } from "destack:error/host";
import { WorldHandle } from "destack:runtime";

import { EntityId, EntityKind, EntityKindRecord, EntityRecord, EntitySelector } from "../entity.ds";

/// Topology entity binding family.
export interface TopologyEntity {
    /// Define one runtime topology entity kind.
    @binding("destack.topology.entity.kind.define", {
        requires: ["runtime.topology.entity.kind.define"],
    })
    defineKind(
        world: WorldHandle,
        kind: EntityKindRecord,
    ): Result<void, HostError>;

    /// Undefine one runtime topology entity kind.
    @binding("destack.topology.entity.kind.undefine", {
        requires: ["runtime.topology.entity.kind.undefine"],
    })
    undefineKind(
        world: WorldHandle,
        kind: EntityKind,
    ): Result<void, HostError>;

    /// Upsert one runtime topology entity.
    @binding("destack.topology.entity.upsert", {
        requires: ["runtime.topology.entity.upsert"],
    })
    upsert(
        world: WorldHandle,
        entity: EntityRecord,
    ): Result<EntityId, HostError>;

    /// Remove one runtime topology entity.
    @binding("destack.topology.entity.remove", {
        requires: ["runtime.topology.entity.remove"],
    })
    remove(
        world: WorldHandle,
        entity: EntityId,
    ): Result<boolean, HostError>;

    /// Return runtime topology entities.
    @binding("destack.topology.entity.list", {
        requires: ["runtime.topology.entity.read"],
    })
    list(
        world: WorldHandle,
        selector?: EntitySelector,
    ): Result<[EntityRecord], HostError>;
}
