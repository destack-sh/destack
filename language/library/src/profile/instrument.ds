/// Profile counter instrument, identified by its name.
@languageItem("profile.Counter")
export newtype Counter<Name: string> = intrinsic;

/// Profile sampler instrument, identified by its name.
@languageItem("profile.Sampler")
export newtype Sampler<Name: string> = intrinsic;

/// Profile unit label.
@languageItem("profile.Unit")
export newtype Unit = string;

/// Profile instrument options.
export struct InstrumentOptions {
    /// Unit for recorded values.
    unit?: Unit;

    /// Human-readable instrument description.
    description?: string;
}

/// Define one statically named profile counter.
@intrinsic("profile.counter")
export declare function counter<Name: string>(
    name: Name,
    options?: InstrumentOptions,
): Counter<Name>;

/// Define one statically named profile sampler.
@intrinsic("profile.sampler")
export declare function sampler<Name: string>(
    name: Name,
    options?: InstrumentOptions,
): Sampler<Name>;

export extension<Name: string> of Counter<Name> {
    /// Increment this counter at the calling site.
    @languageItem("profile.Counter.increment")
    @intrinsic("profile.increment")
    declare increment(&readonly this): void;
}

export extension<Name: string> of Sampler<Name> {
    /// Record one sample at the calling site.
    @languageItem("profile.Sampler.sample")
    @intrinsic("profile.sample")
    declare sample(&readonly this, value: number): void;
}
