import { Derive } from "./config.tspp";

/// Target operating system.
@languageItem("module.Platform")
export type Platform =
    | "unknown"
    | "windows"
    | "macos"
    | "linux"
    | "freebsd"
    | "openbsd"
    | "netbsd"
    | "dragonfly"
    | "solaris"
    | "illumos"
    | "haiku"
    | "fuchsia"
    | "redox"
    | "hermit"
    | "none";

/// Runtime selected for the build.
@languageItem("module.Runtime")
export type Runtime = "tspp" | "js";

/// Build artifact kind.
@languageItem("module.Output")
export type Output = "bundle" | "program";

/// Stability promised by one published package or product.
@languageItem("module.Stability")
export type Stability = "experimental" | "alpha" | "beta" | "stable";

/// Host environment providing imports and ambient effects.
@languageItem("module.Host")
export type Host = "native" | "browser" | "wasi" | "emscripten" | "freestanding";

/// Coarse target family metadata.
@languageItem("module.TargetFamily")
export type TargetFamily =
    | "web"
    | "windows"
    | "unix"
    | "wasm"
    | "bare-metal"
    | "universal"
    | "other";

/// Structured target metadata.
@languageItem("module.ImportMetaTarget")
export interface ImportMetaTarget {
    /// Coarse target family.
    readonly family: TargetFamily;
    /// Target architecture tag when one exists.
    readonly arch: string | undefined;
    /// Target vendor tag when one exists.
    readonly vendor: string | undefined;
    /// Target ABI tag when one exists.
    readonly abi: string | undefined;
}

/// Environment variables available at compile time.
@languageItem("module.ImportMetaEnv")
export interface ImportMetaEnv {
    /// Index signature for arbitrary environment variables.
    readonly [key: string]: string | undefined;
}

/// Metadata about the current module and build configuration.
@languageItem("module.ImportMeta")
export interface ImportMeta {
    /// The URL of the current module (file:// for local, https:// for remote).
    readonly url: string;
    /// The file system path of the current module (only for local files).
    readonly path: string | undefined;
    /// Alias of `path`.
    readonly file: string | undefined;
    /// Alias of `file`.
    readonly filename: string | undefined;
    /// The directory containing the current module (only for local files).
    readonly dir: string | undefined;
    /// Alias of `dir`.
    readonly dirname: string | undefined;
    /// The artifact produced by the current build target.
    readonly output: Output;
    /// The target platform (OS) being compiled for.
    readonly platform: Platform;
    /// Runtime selected for this build.
    readonly runtime: Runtime;
    /// Structured target metadata.
    readonly target: ImportMetaTarget;
    /// Active build target name.
    readonly targetName: string | undefined;
    /// Active deliverable product name.
    readonly product: string | undefined;
    /// Active package version.
    readonly version: string | undefined;
    /// Stability promised by the active package or product.
    readonly stability: Stability | undefined;
    /// Auto-derives declared by the current module.
    readonly derive: readonly Derive[];
    /// Active product role.
    readonly role: string | undefined;
    /// Labels contributed by active source graph conditions.
    readonly labels: { readonly [key: string]: readonly string[] | undefined };
    /// Target host environment.
    readonly host: Host;
    /// Active source graph modes.
    readonly modes: readonly string[];
    /// Active source graph roles.
    readonly roles: readonly string[];
    /// Active source graph features.
    readonly features: readonly string[];
    /// Active source graph tags.
    readonly tags: readonly string[];
    /// True when the debug mode is active.
    readonly debug: boolean;
    /// True when the development mode is active.
    readonly dev: boolean;
    /// True when the production mode is active.
    readonly prod: boolean;
    /// True when the test mode is active.
    readonly test: boolean;
    /// True when the lint mode is active.
    readonly lint: boolean;
    /// Environment variables (from build configuration).
    readonly env: ImportMetaEnv;
}
