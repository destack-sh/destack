/// Well-known derive considered automatically for nominal declarations.
@languageItem("module.Derive")
export type Derive =
    | "Compare"
    | "Copy"
    | "Clone"
    | "Debug"
    | "Default"
    | "DefaultEqual"
    | "Deserialize"
    | "Equal"
    | "Hash"
    | "PartialCompare"
    | "PartialEqual"
    | "Serialize";

/// Static configuration for one source module.
@languageItem("module.Module")
export interface Module {
    /// Auto-derives considered for nominal declarations in this module.
    readonly derive?: readonly Derive[];
    /// Active deliverable product name for this module.
    readonly product?: string;
    /// Active source graph role for this module.
    readonly role?: string;
    /// Module metadata labels.
    readonly labels?: { readonly [key: string]: readonly string[] };
}
