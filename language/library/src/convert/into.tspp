import { Error, Result } from "tspp:error";

import { From, TryFrom } from "./from.tspp";

/// Infallible conversion into `T`.
@languageItem("convert.Into")
export newtype interface Into<T> {
    /// Convert this value.
    into(this): T;
}

export extension<T, U> of T implements Into<U> where U: From<T> {
    /// Convert this value through `U.from`.
    into(this): U {
        U.from(this)
    }
}

/// Fallible conversion into `T`.
@languageItem("convert.TryInto")
export newtype interface TryInto<T> {
    /// The error produced when the conversion fails.
    type Error = Error;

    /// Convert this value, or return an error.
    tryInto(this): Result<T, this.Error>;
}

export extension<T, U> of T implements TryInto<U> where U: TryFrom<T> {
    /// The target conversion's error.
    type Error = U.Error;

    /// Convert this value through `U.tryFrom`.
    tryInto(this): Result<U, U.Error> {
        U.tryFrom(this)
    }
}
