import { Error, Result } from "tspp:error";

/// Infallible conversion from `T`.
@languageItem("convert.From")
export newtype interface From<T> {
    /// Convert `value`.
    static from(value: T): this;
}

/// Fallible conversion from `T`.
@languageItem("convert.TryFrom")
export newtype interface TryFrom<T> {
    /// The error produced when the conversion fails.
    type Error = Error;

    /// Convert `value`, or return an error.
    static tryFrom(value: T): Result<this, this.Error>;
}

export extension<T> of T implements From<T> {
    /// Return `value` itself.
    static from(value: T): T {
        value
    }
}
