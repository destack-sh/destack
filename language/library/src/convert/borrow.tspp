import { Access, Borrowed, Region } from "tspp:memory";

/// Equivalent borrowed form of a value.
///
/// Borrowed values must preserve equality, hashing, and ordering with the owner.
@languageItem("convert.Borrow")
export newtype interface Borrow<T, const A: Access = "readonly"> {
    /// Borrow this value.
    borrow<const R: Region>(this: Borrowed<this, R, A>): Borrowed<T, R, A>;
}

export extension<T, const A: Access = "readonly"> of T implements Borrow<T, A> {
    /// Borrow this value as itself.
    borrow<const R: Region>(this: Borrowed<T, R, A>): Borrowed<T, R, A> {
        this
    }
}

/// Owned form of a borrowed value.
@languageItem("convert.ToOwned")
export newtype interface ToOwned {
    /// The owned value type.
    type Owned: Borrow<this, "immutable">;

    /// Copy this value into owned storage.
    toOwned(&immutable this): this.Owned;
}
