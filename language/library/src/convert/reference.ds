import { Access, WithAccess } from "destack:memory";

/// Interface for reference conversion.
///
/// `A` selects the access form required by the conversion.
@languageItem("convert.As")
export newtype interface As<T, comptime A: Access = "readonly"> {
    /// Borrow this value as `T`.
    as(this: WithAccess<&this, A>): WithAccess<&T, A>;
}
