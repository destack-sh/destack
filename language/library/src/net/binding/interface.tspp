import { HostError } from "tspp:error/host";

import { IpAddress } from "./address.tspp";

/// Network interface flags.
@languageItem("net.binding.NetworkInterfaceFlags")
export newtype NetworkInterfaceFlags = uint64;

export extension of NetworkInterfaceFlags {
    /// Interface is administratively up.
    const up = NetworkInterfaceFlags(0x1);

    /// Interface is a loopback interface.
    const loopback = NetworkInterfaceFlags(0x2);

    /// Interface supports broadcast.
    const broadcast = NetworkInterfaceFlags(0x4);

    /// Interface supports multicast.
    const multicast = NetworkInterfaceFlags(0x8);

    /// Interface is point-to-point.
    const pointToPoint = NetworkInterfaceFlags(0x10);
}

/// Network interface address.
export struct NetworkInterfaceAddress {
    /// Interface address.
    address: IpAddress;
    /// Prefix length in bits.
    prefixLength: uint8;
}

/// Network interface descriptor.
export struct NetworkInterface {
    /// Interface name.
    name: string;
    /// Interface index.
    index: uint32;
    /// Interface flags.
    flags: NetworkInterfaceFlags;
    /// Interface MTU in bytes.
    mtu: uint32;
    /// Link-layer hardware address.
    hardwareAddress: [uint8];
    /// Interface addresses.
    addresses: NetworkInterfaceAddress[];
}

/// Network interface binding family.
@languageItem("net.binding.NetInterfaceBinding")
export interface NetInterfaceBinding {
    /// List network interfaces.
    @binding("tspp.net.interface.list", {
        provider: "host",
        effect: "external",
        requires: ["host.net.interface"],
        families: ["windows", "unix"],
    })
    list(): Result<NetworkInterface[], HostError>;

    /// Resolve an interface name to an index.
    @binding("tspp.net.interface.index", {
        provider: "host",
        effect: "external",
        requires: ["host.net.interface"],
        families: ["windows", "unix"],
    })
    index(name: &readonly string): Result<uint32, HostError>;

    /// Resolve an interface index to a name.
    @binding("tspp.net.interface.name", {
        provider: "host",
        effect: "external",
        requires: ["host.net.interface"],
        families: ["windows", "unix"],
    })
    name(index: uint32): Result<^string, HostError>;
}
