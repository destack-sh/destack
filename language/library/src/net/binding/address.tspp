/// Socket address family.
@languageItem("net.binding.SocketFamily")
export enum SocketFamily {
    /// No address family preference.
    Unspecified = 0,
    /// IPv4 address family.
    IPv4 = 4,
    /// IPv6 address family.
    IPv6 = 6,
    /// Unix domain socket address family.
    Unix = 1,
}

/// IPv4 address bytes.
export struct Ipv4Address {
    /// Address octets in network order.
    octets: [uint8; 4];
}

/// IPv6 address bytes.
export struct Ipv6Address {
    /// Address octets in network order.
    octets: [uint8; 16];
    /// Scope identifier for scoped addresses.
    scopeId: uint32;
}

/// IPv4 address payload.
export struct IpAddressIpv4 {
    /// Address discriminator.
    kind: "ipv4";
    /// IPv4 address.
    address: Ipv4Address;
}

/// IPv6 address payload.
export struct IpAddressIpv6 {
    /// Address discriminator.
    kind: "ipv6";
    /// IPv6 address.
    address: Ipv6Address;
}

/// IP address payload.
@languageItem("net.binding.IpAddress")
export newtype IpAddress = IpAddressIpv4 | IpAddressIpv6;

/// IP socket endpoint.
export struct IpEndpoint {
    /// Endpoint address.
    address: IpAddress;
    /// Endpoint port in host byte order.
    port: uint16;
}

/// Filesystem path Unix socket address.
export struct UnixAddressPath {
    /// Address discriminator.
    kind: "path";
    /// Filesystem socket path.
    path: string;
}

/// Abstract Unix socket address.
export struct UnixAddressAbstract {
    /// Address discriminator.
    kind: "abstract";
    /// Abstract socket name.
    name: [uint8];
}

/// Unnamed Unix socket address.
export struct UnixAddressUnnamed {
    /// Address discriminator.
    kind: "unnamed";
}

/// Unix domain socket address payload.
@languageItem("net.binding.UnixAddress")
export newtype UnixAddress = UnixAddressPath | UnixAddressAbstract | UnixAddressUnnamed;

/// Raw socket address payload for host-specific address families.
export struct RawSocketAddress {
    /// Socket address family.
    family: uint16;
    /// Raw sockaddr bytes.
    bytes: [uint8];
}

/// IP socket address payload.
export struct SocketAddressIp {
    /// Address discriminator.
    kind: "ip";
    /// IP endpoint.
    endpoint: IpEndpoint;
}

/// Unix socket address payload.
export struct SocketAddressUnix {
    /// Address discriminator.
    kind: "unix";
    /// Unix socket address.
    address: UnixAddress;
}

/// Raw socket address payload.
export struct SocketAddressRaw {
    /// Address discriminator.
    kind: "raw";
    /// Raw socket address.
    address: RawSocketAddress;
}

/// Socket address payload.
@languageItem("net.binding.SocketAddress")
export newtype SocketAddress = SocketAddressIp | SocketAddressUnix | SocketAddressRaw;
