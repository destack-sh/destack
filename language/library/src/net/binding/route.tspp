import { HostError } from "tspp:error/host";

import { IpAddress, SocketFamily } from "./address.tspp";

/// IP prefix.
export struct IpPrefix {
    /// Prefix address.
    address: IpAddress;
    /// Prefix length in bits.
    length: uint8;
}

/// Network route entry kind.
@languageItem("net.binding.NetworkRouteKind")
export enum NetworkRouteKind {
    /// Unicast route.
    Unicast = 1,
    /// Local route.
    Local = 2,
    /// Broadcast route.
    Broadcast = 3,
    /// Multicast route.
    Multicast = 4,
    /// Blackhole route.
    Blackhole = 5,
}

/// Network route table entry.
export struct NetworkRouteEntry {
    /// Route family.
    family: SocketFamily;
    /// Destination prefix.
    destination: IpPrefix;
    /// Next-hop gateway address.
    gateway?: IpAddress;
    /// Output interface index.
    interfaceIndex: uint32;
    /// Route metric.
    metric: uint32;
    /// Route kind.
    kind: NetworkRouteKind;
}

/// Network route binding family.
@languageItem("net.binding.NetRouteBinding")
export interface NetRouteBinding {
    /// List route table entries.
    @binding("tspp.net.route.list", {
        provider: "host",
        effect: "external",
        requires: ["host.net.route.read"],
        families: ["windows", "unix"],
    })
    list(family: SocketFamily): Result<NetworkRouteEntry[], HostError>;

    /// Add a route table entry.
    @binding("tspp.net.route.add", {
        provider: "host",
        effect: "external",
        requires: ["host.net.route.write"],
        families: ["windows", "unix"],
    })
    add(route: NetworkRouteEntry): Result<void, HostError>;

    /// Remove a route table entry.
    @binding("tspp.net.route.remove", {
        provider: "host",
        effect: "external",
        requires: ["host.net.route.write"],
        families: ["windows", "unix"],
    })
    remove(route: NetworkRouteEntry): Result<void, HostError>;
}
