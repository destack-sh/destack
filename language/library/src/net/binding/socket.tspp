import { HostError } from "tspp:error/host";
import { ResourceId, TransferredHandle } from "tspp:runtime/resource";

import { SocketAddress, SocketFamily } from "./address.tspp";

/// Handle for a network socket.
@languageItem("net.binding.SocketHandle")
export newtype SocketHandle = ResourceId;

/// Socket type.
@languageItem("net.binding.SocketType")
export enum SocketType {
    /// Stream-oriented socket.
    Stream = 1,
    /// Datagram-oriented socket.
    Datagram = 2,
    /// Raw protocol socket.
    Raw = 3,
    /// Sequenced packet socket.
    SequencedPacket = 5,
}

/// Socket protocol number.
@languageItem("net.binding.SocketProtocol")
export newtype SocketProtocol = int32;

/// Socket creation flags.
@languageItem("net.binding.SocketFlags")
export newtype SocketFlags = uint32;

export extension of SocketFlags {
    /// Create the socket in nonblocking mode.
    const nonblocking = SocketFlags(0x1);

    /// Create the socket as close-on-exec or non-inheritable.
    const closeOnExec = SocketFlags(0x2);
}

/// Socket open options.
export struct SocketOpenOptions {
    /// Address family.
    family: SocketFamily;
    /// Socket type.
    socketType: SocketType;
    /// Protocol number.
    protocol: SocketProtocol;
    /// Creation flags.
    flags: SocketFlags;
}

/// Socket accept flags.
@languageItem("net.binding.SocketAcceptFlags")
export newtype SocketAcceptFlags = uint32;

export extension of SocketAcceptFlags {
    /// Accept the socket in nonblocking mode.
    const nonblocking = SocketAcceptFlags(0x1);

    /// Accept the socket as close-on-exec or non-inheritable.
    const closeOnExec = SocketAcceptFlags(0x2);
}

/// Message flags for send and receive operations.
@languageItem("net.binding.SocketMessageFlags")
export newtype SocketMessageFlags = uint32;

export extension of SocketMessageFlags {
    /// Read without consuming queued data.
    const peek = SocketMessageFlags(0x1);

    /// Process out-of-band data.
    const outOfBand = SocketMessageFlags(0x2);

    /// Send without routing table lookup where supported.
    const doNotRoute = SocketMessageFlags(0x4);

    /// Wait until the receive buffer is full where supported.
    const waitAll = SocketMessageFlags(0x8);
}

/// Shutdown mode for sockets.
@languageItem("net.binding.SocketShutdown")
export enum SocketShutdown {
    /// Shut down reads.
    Read = 0,
    /// Shut down writes.
    Write = 1,
    /// Shut down reads and writes.
    ReadWrite = 2,
}

/// Pair of connected socket handles.
export struct SocketPair {
    /// First socket in the pair.
    first: SocketHandle;
    /// Second socket in the pair.
    second: SocketHandle;
}

/// Accepted socket result.
export struct SocketAcceptResult {
    /// Accepted socket handle.
    socket: SocketHandle;
    /// Peer address captured during accept.
    address: SocketAddress;
}

/// Peer credentials captured from ancillary data.
export struct SocketCredentials {
    /// Process identifier.
    pid: uint32;
    /// User identifier.
    uid: uint32;
    /// Group identifier.
    gid: uint32;
}

/// Outbound message metadata.
export struct SocketSendMessage {
    /// Destination address for unconnected sockets.
    address?: SocketAddress;
    /// Ancillary control bytes.
    control: [uint8];
    /// Resource handles to pass.
    handles: [TransferredHandle];
    /// Credentials to send when enabled.
    credentials?: SocketCredentials;
    /// Per-message flags.
    flags: SocketMessageFlags;
}

/// Inbound message options.
export struct SocketReceiveMessageOptions {
    /// Per-message flags.
    flags: SocketMessageFlags;
    /// Whether peer credentials should be captured.
    wantsCredentials: boolean;
}

/// Inbound message result.
export struct SocketReceiveMessageResult {
    /// Payload bytes received.
    bytes: uint64;
    /// Source address when returned by the host.
    address?: SocketAddress;
    /// Flags returned by the host.
    flags: SocketMessageFlags;
    /// Ancillary control bytes written.
    controlBytes: uint64;
    /// Resource handles written.
    handleCount: uint64;
    /// Peer credentials when available.
    credentials?: SocketCredentials;
    /// Whether payload bytes were truncated.
    isPayloadTruncated: boolean;
    /// Whether ancillary control bytes were truncated.
    isControlTruncated: boolean;
}

/// Inbound datagram result.
export struct SocketReceiveFromResult {
    /// Payload bytes received.
    bytes: uint64;
    /// Source address when returned by the host.
    address?: SocketAddress;
    /// Flags returned by the host.
    flags: SocketMessageFlags;
    /// Whether payload bytes were truncated.
    isPayloadTruncated: boolean;
}

/// Receive request for one batch slot.
export struct SocketReceiveBatchEntry {
    /// Payload output buffer.
    payload: [uint8];
    /// Ancillary control output buffer.
    control: [uint8];
    /// Resource handle output buffer.
    handles: [TransferredHandle];
    /// Per-message options.
    options: SocketReceiveMessageOptions;
}

/// Send request for one batch slot.
export struct SocketSendBatchEntry {
    /// Payload input buffer.
    payload: [uint8];
    /// Per-message metadata.
    message: SocketSendMessage;
}

/// Socket binding family.
@languageItem("net.binding.NetSocketBinding")
export interface NetSocketBinding {
    /// Create a socket.
    @binding("tspp.net.socket.open", {
        provider: "host",
        effect: "external",
        requires: ["host.net.open"],
        families: ["windows", "unix"],
    })
    open(options: SocketOpenOptions): Result<SocketHandle, HostError>;

    /// Create a connected socket pair.
    @binding("tspp.net.socket.pair", {
        provider: "host",
        effect: "external",
        requires: ["host.net.open"],
        families: ["unix"],
    })
    pair(options: SocketOpenOptions): Result<SocketPair, HostError>;

    /// Bind a socket to a local address.
    @binding("tspp.net.socket.bind", {
        provider: "host",
        effect: "external",
        requires: ["host.net.listen"],
        families: ["windows", "unix"],
    })
    bind(socket: SocketHandle, address: &readonly SocketAddress): Result<void, HostError>;

    /// Mark a bound stream socket as a listener.
    @binding("tspp.net.socket.listen", {
        provider: "host",
        effect: "external",
        requires: ["host.net.listen"],
        families: ["windows", "unix"],
    })
    listen(socket: SocketHandle, backlog: uint32): Result<void, HostError>;

    /// Accept one connection from a listener socket.
    @binding("tspp.net.socket.accept", {
        provider: "host",
        effect: "external",
        requires: ["host.net.accept"],
        families: ["windows", "unix"],
    })
    accept(socket: SocketHandle, flags: SocketAcceptFlags): Result<SocketAcceptResult, HostError>;

    /// Connect a socket to a remote address.
    @binding("tspp.net.socket.connect", {
        provider: "host",
        effect: "external",
        requires: ["host.net.connect"],
        families: ["windows", "unix"],
    })
    connect(socket: SocketHandle, address: &readonly SocketAddress): Result<void, HostError>;

    /// Close a socket handle.
    @binding("tspp.net.socket.close", {
        provider: "host",
        effect: "external",
        requires: ["host.net.close"],
        families: ["windows", "unix"],
    })
    close(socket: SocketHandle): Result<void, HostError>;

    /// Shut down a socket for reads, writes, or both.
    @binding("tspp.net.socket.shutdown", {
        provider: "host",
        effect: "external",
        requires: ["host.net.close"],
        families: ["windows", "unix"],
    })
    shutdown(socket: SocketHandle, how: SocketShutdown): Result<void, HostError>;

    /// Enable or disable nonblocking mode on a socket.
    @binding("tspp.net.socket.nonblocking", {
        provider: "host",
        effect: "external",
        requires: ["host.net.option"],
        families: ["windows", "unix"],
    })
    setNonblocking(socket: SocketHandle, isEnabled: boolean): Result<void, HostError>;

    /// Read the local socket address.
    @binding("tspp.net.socket.localAddress", {
        provider: "host",
        effect: "external",
        requires: ["host.net.status"],
        families: ["windows", "unix"],
    })
    localAddress(socket: SocketHandle): Result<SocketAddress, HostError>;

    /// Read the remote socket address.
    @binding("tspp.net.socket.peerAddress", {
        provider: "host",
        effect: "external",
        requires: ["host.net.status"],
        families: ["windows", "unix"],
    })
    peerAddress(socket: SocketHandle): Result<SocketAddress, HostError>;

    /// Receive bytes from a socket.
    @binding("tspp.net.socket.receive", {
        provider: "host",
        effect: "external",
        requires: ["host.net.read"],
        families: ["windows", "unix"],
    })
    receive(
        socket: SocketHandle,
        buffer: &[uint8],
        flags: SocketMessageFlags,
    ): Result<uint64, HostError>;

    /// Send bytes to a socket.
    @binding("tspp.net.socket.send", {
        provider: "host",
        effect: "external",
        requires: ["host.net.write"],
        families: ["windows", "unix"],
    })
    send(
        socket: SocketHandle,
        buffer: &readonly [uint8],
        flags: SocketMessageFlags,
    ): Result<uint64, HostError>;

    /// Receive bytes and source address from a socket.
    @binding("tspp.net.socket.receiveFrom", {
        provider: "host",
        effect: "external",
        requires: ["host.net.read"],
        families: ["windows", "unix"],
    })
    receiveFrom(
        socket: SocketHandle,
        buffer: &[uint8],
        flags: SocketMessageFlags,
    ): Result<SocketReceiveFromResult, HostError>;

    /// Send bytes to a destination address.
    @binding("tspp.net.socket.sendTo", {
        provider: "host",
        effect: "external",
        requires: ["host.net.write"],
        families: ["windows", "unix"],
    })
    sendTo(
        socket: SocketHandle,
        buffer: &readonly [uint8],
        address: &readonly SocketAddress,
        flags: SocketMessageFlags,
    ): Result<uint64, HostError>;

    /// Receive one message with ancillary data.
    @binding("tspp.net.socket.receiveMessage", {
        provider: "host",
        effect: "external",
        requires: ["host.net.read"],
        families: ["windows", "unix"],
    })
    receiveMessage(
        socket: SocketHandle,
        payload: &[uint8],
        control: &[uint8],
        handles: &[TransferredHandle],
        options: SocketReceiveMessageOptions,
    ): Result<SocketReceiveMessageResult, HostError>;

    /// Send one message with ancillary data.
    @binding("tspp.net.socket.sendMessage", {
        provider: "host",
        effect: "external",
        requires: ["host.net.write"],
        families: ["windows", "unix"],
    })
    sendMessage(
        socket: SocketHandle,
        payload: &readonly [uint8],
        message: &readonly SocketSendMessage,
    ): Result<uint64, HostError>;

    /// Receive multiple messages into caller-owned buffers.
    @binding("tspp.net.socket.receiveBatch", {
        provider: "host",
        effect: "external",
        requires: ["host.net.read"],
        families: ["windows", "unix"],
    })
    receiveBatch(
        socket: SocketHandle,
        requests: &[SocketReceiveBatchEntry],
        results: &[SocketReceiveMessageResult],
    ): Result<uint64, HostError>;

    /// Send multiple messages from caller-owned buffers.
    @binding("tspp.net.socket.sendBatch", {
        provider: "host",
        effect: "external",
        requires: ["host.net.write"],
        families: ["windows", "unix"],
    })
    sendBatch(
        socket: SocketHandle,
        messages: &readonly [SocketSendBatchEntry],
    ): Result<uint64, HostError>;
}
