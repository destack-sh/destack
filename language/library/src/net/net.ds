import { todo } from "destack:error";
import { HostError } from "destack:error/host";
import {
    AddressLookupQuery,
    AddressLookupResult,
    SocketAddress,
    SocketFamily,
    SocketHandle,
    SocketMessageFlags,
    SocketReceiveFromResult,
} from "destack:net/binding";

/// Owned stream socket.
export struct Connection {
    /// Host socket handle.
    handle: SocketHandle;
}

/// Owned stream listener.
export struct Listener {
    /// Host listener socket handle.
    handle: SocketHandle;
}

/// Owned datagram socket.
export struct DatagramSocket {
    /// Host socket handle.
    handle: SocketHandle;
}

/// Stream listen options.
export struct ListenOptions {
    /// Local address.
    address: SocketAddress;
    /// Pending connection backlog.
    backlog: uint32;
}

/// Stream connect options.
export struct ConnectOptions {
    /// Remote address.
    address: SocketAddress;
}

/// Datagram socket options.
export struct DatagramOptions {
    /// Socket address family.
    family: SocketFamily;
    /// Local address to bind when present.
    address?: SocketAddress;
}

/// Open one stream connection.
export function connect(options: ConnectOptions): Task<Result<Connection, HostError>> {
    todo("net.connect")
}

/// Listen for stream connections.
export function listen(options: ListenOptions): Task<Result<Listener, HostError>> {
    todo("net.listen")
}

/// Open one datagram socket.
export function openDatagram(options: DatagramOptions): Task<Result<DatagramSocket, HostError>> {
    todo("net.openDatagram")
}

/// Accept one stream connection.
export function accept(listener: &Listener): Task<Result<Connection, HostError>> {
    todo("net.accept")
}

/// Close one stream connection.
export function close(connection: Connection): Task<Result<void, HostError>> {
    todo("net.close")
}

/// Close one stream listener.
export function closeListener(listener: Listener): Task<Result<void, HostError>> {
    todo("net.closeListener")
}

/// Close one datagram socket.
export function closeDatagram(socket: DatagramSocket): Task<Result<void, HostError>> {
    todo("net.closeDatagram")
}

/// Read from one stream connection.
export function read(connection: &Connection, buffer: &[uint8]): Task<Result<uint64, HostError>> {
    todo("net.read")
}

/// Write to one stream connection.
export function write(
    connection: &Connection,
    buffer: &readonly [uint8],
): Task<Result<uint64, HostError>> {
    todo("net.write")
}

/// Receive one datagram from a socket.
export function receiveFrom(
    socket: &DatagramSocket,
    buffer: &[uint8],
    flags: SocketMessageFlags,
): Task<Result<SocketReceiveFromResult, HostError>> {
    todo("net.receiveFrom")
}

/// Send one datagram to a remote endpoint.
export function sendTo(
    socket: &DatagramSocket,
    address: SocketAddress,
    buffer: &readonly [uint8],
    flags: SocketMessageFlags,
): Task<Result<uint64, HostError>> {
    todo("net.sendTo")
}

/// Resolve a host and service.
export function lookup(
    query: AddressLookupQuery,
): Task<Result<^Array<AddressLookupResult>, HostError>> {
    todo("net.lookup")
}
