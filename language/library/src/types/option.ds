import { From } from "destack:convert";
import { panic, Result, todo } from "destack:error";
import { Default } from "destack:memory";
import {
    Break,
    Compare,
    Continue,
    ControlFlow,
    Equal,
    FromResidual,
    Ordering,
    Try,
} from "destack:ops";

/// Explicit optional value.
@languageItem("types.Option")
export newtype Option<T> = T | null;

extension<T> of Option<T> {
    /// Wrap `value` as an option.
    @intrinsic("types.option.some")
    static some(value: T): Option<T>;

    /// Create an absent option.
    @intrinsic("types.option.none")
    static none(): Option<T>;

    /// Convert a nullable value into an option.
    static fromNullable(value: T | null): Option<T> {
        value as Option<T>
    }

    /// Convert `null` and `undefined` into absence.
    static fromNullish(value: T | null | undefined): Option<T> {
        match (value) {
            null => Option<T>.none()
            undefined => Option<T>.none()
            value => Option<T>.some(value)
        }
    }

    /// Return this option as its nullable carrier.
    toNullable(): T | null {
        this as T | null
    }

    /// Return true when this option has a value.
    isSome(&readonly this): boolean {
        this.toNullable() != null
    }

    /// Return true when this option is empty.
    isNone(&readonly this): boolean {
        this.toNullable() == null
    }

    /// Return true when this option has a value accepted by `predicate`.
    isSomeAnd(&readonly this, predicate: (value: &readonly T) => boolean): boolean {
        match (this.toNullable()) {
            null => false
            value => predicate(&readonly value)
        }
    }

    /// Return true when this option is empty or has a value accepted by `predicate`.
    isNoneOr(&readonly this, predicate: (value: &readonly T) => boolean): boolean {
        match (this.toNullable()) {
            null => true
            value => predicate(&readonly value)
        }
    }

    /// Borrow the value as readonly access.
    asReadonly(&readonly this): Option<&readonly T> {
        todo("Option.asReadonly")
    }

    /// Borrow the value as mutable access.
    asMutable(&this): Option<&T> {
        todo("Option.asMutable")
    }

    /// Borrow the value as exclusive access.
    asExclusive(&exclusive this): Option<&exclusive T> {
        todo("Option.asExclusive")
    }

    /// Return the value or panic with `message`.
    expect(message: string): T {
        match (this.toNullable()) {
            null => panic(message)
            value => value
        }
    }

    /// Return the value or panic.
    unwrap(): T {
        this.expect("called Option.unwrap() on None")
    }

    /// Return the value without checking for absence.
    @unsafe
    unwrapUnchecked(): T {
        todo("Option.unwrapUnchecked")
    }

    /// Return the value or `default`.
    unwrapOr(default: T): T {
        match (this.toNullable()) {
            null => default
            value => value
        }
    }

    /// Return the value or the default value.
    unwrapOrDefault(): T where T: Default {
        match (this.toNullable()) {
            null => T.default()
            value => value
        }
    }

    /// Return the value or compute one.
    unwrapOrElse(f: () => T): T {
        match (this.toNullable()) {
            null => f()
            value => value
        }
    }

    /// Map the value.
    map<U>(f: (value: T) => U): Option<U> {
        match (this.toNullable()) {
            null => Option<U>.none()
            value => Option<U>.some(f(value))
        }
    }

    /// Map the value or return `default`.
    mapOr<U>(default: U, f: (value: T) => U): U {
        match (this.toNullable()) {
            null => default
            value => f(value)
        }
    }

    /// Map the value or compute a fallback.
    mapOrElse<U>(default: () => U, f: (value: T) => U): U {
        match (this.toNullable()) {
            null => default()
            value => f(value)
        }
    }

    /// Continue with another option-returning operation.
    andThen<U>(f: (value: T) => Option<U>): Option<U> {
        match (this.toNullable()) {
            null => Option<U>.none()
            value => f(value)
        }
    }

    /// Keep the value when `predicate` returns true.
    filter(predicate: (value: &readonly T) => boolean): Option<T> {
        match (this.toNullable()) {
            null => Option<T>.none()
            value if (predicate(&readonly value)) => this
            _ => Option<T>.none()
        }
    }

    /// Return `other` when this option has a value.
    and<U>(other: Option<U>): Option<U> {
        match (this.toNullable()) {
            null => Option<U>.none()
            _ => other
        }
    }

    /// Return this option or `other`.
    or(other: Option<T>): Option<T> {
        match (this.toNullable()) {
            null => other
            _ => this
        }
    }

    /// Return this option or compute another option.
    orElse(f: () => Option<T>): Option<T> {
        match (this.toNullable()) {
            null => f()
            _ => this
        }
    }

    /// Return whichever option has a value, or none when both states match.
    xor(other: Option<T>): Option<T> {
        match (this.toNullable()) {
            null => other.isSome() ? other : Option<T>.none()
            value => other.isNone() ? Option<T>.some(value) : Option<T>.none()
        }
    }

    /// Combine two options.
    zip<U>(other: Option<U>): Option<(T, U)> {
        match (this.toNullable()) {
            null => Option<(T, U)>.none()
            value => other.map((otherValue) => (value, otherValue))
        }
    }

    /// Combine two options with `f`.
    zipWith<U, V>(other: Option<U>, f: (left: T, right: U) => V): Option<V> {
        match (this.toNullable()) {
            null => Option<V>.none()
            value => other.map((otherValue) => f(value, otherValue))
        }
    }

    /// Convert this option to a result.
    okOr<E>(error: E): Result<T, E> {
        match (this.toNullable()) {
            null => Result.err(error)
            value => Result.ok(value)
        }
    }

    /// Convert this option to a result with a computed error.
    okOrElse<E>(f: () => E): Result<T, E> {
        match (this.toNullable()) {
            null => Result.err(f())
            value => Result.ok(value)
        }
    }

    /// Fold either option state into one value.
    match<U>(arms: { some: (value: T) => U; none: () => U }): U {
        match (this.toNullable()) {
            null => arms.none()
            value => arms.some(value)
        }
    }

    /// Flatten one nested option layer.
    flatten<U>(this: Option<Option<U>>): Option<U> {
        match (this.toNullable()) {
            null => Option<U>.none()
            value => value
        }
    }

    /// Move an option outside a result.
    transpose<U, E>(this: Option<Result<U, E>>): Result<Option<U>, E> {
        match (this.toNullable()) {
            null => Result.ok(Option<U>.none())
            value => value.map((inner) => Option<U>.some(inner))
        }
    }

    /// Split an optional pair into a pair of options.
    unzip<U, V>(this: Option<(U, V)>): (Option<U>, Option<V>) {
        match (this.toNullable()) {
            null => (Option<U>.none(), Option<V>.none())
            (left, right) => (Option<U>.some(left), Option<V>.some(right))
        }
    }

    /// Run a side effect on the value and keep the original option.
    tap(f: (value: &readonly T) => void): Option<T> {
        match (this.toNullable()) {
            null => this
            value => {
                f(&readonly value);
                this
            }
        }
    }

    /// Replace this option with a value and return a borrow to it.
    insert(&exclusive this, value: T): &exclusive T {
        todo("Option.insert")
    }

    /// Return the existing value or insert `value`.
    getOrInsert(&exclusive this, value: T): &exclusive T {
        todo("Option.getOrInsert")
    }

    /// Return the existing value or insert the default value.
    getOrInsertDefault(&exclusive this): &exclusive T where T: Default {
        todo("Option.getOrInsertDefault")
    }

    /// Return the existing value or insert a computed value.
    getOrInsertWith(&exclusive this, f: () => T): &exclusive T {
        todo("Option.getOrInsertWith")
    }

    /// Take the value and leave none.
    take(&exclusive this): Option<T> {
        todo("Option.take")
    }

    /// Take the value when `predicate` accepts it.
    takeIf(&exclusive this, predicate: (value: &T) => boolean): Option<T> {
        todo("Option.takeIf")
    }

    /// Replace this option and return the previous value.
    replace(&exclusive this, value: T): Option<T> {
        todo("Option.replace")
    }
}

extension<T> of Option<T> implements Default {
    /// Create an empty option.
    static default(): Option<T> {
        Option<T>.none()
    }
}

extension<T> of Option<T> implements From<T> {
    /// Convert a value into an option.
    static from(value: T): Option<T> {
        Option<T>.some(value)
    }
}

extension<T> of Option<T> implements Try {
    /// The present value.
    type Output = T;

    /// The residual option.
    type Residual = Option<never>;

    /// Create an option from a successful value.
    static fromOutput(output: T): Option<T> {
        Option<T>.some(output)
    }

    /// Branch into present or absent control flow.
    branch(): ControlFlow<Option<never>, T> {
        match (this.toNullable()) {
            null => Break { kind: "break", residual: Option<never>.none() }
            value => Continue { kind: "continue", value }
        }
    }
}

extension<T> of Option<T> implements FromResidual<Option<never>> {
    /// Create an option from a propagated residual.
    static fromResidual(residual: Option<never>): Option<T> {
        Option<T>.none()
    }
}

extension<T: Equal<T>> of Option<T> implements Equal<Option<T>> {
    /// Compare two options.
    equal(other: Option<T>): boolean {
        match (this.toNullable()) {
            null => other.toNullable() == null
            value => {
                match (other.toNullable()) {
                    null => false
                    otherValue => value.equal(otherValue)
                }
            }
        }
    }
}

extension<T: Compare<T>> of Option<T> implements Compare<Option<T>> {
    /// Compare two options, with none ordered before some.
    compare(other: Option<T>): Ordering {
        match (this.toNullable()) {
            null => other.toNullable() == null ? Ordering.Equal : Ordering.Less
            value => {
                match (other.toNullable()) {
                    null => Ordering.Greater
                    otherValue => value.compare(otherValue)
                }
            }
        }
    }
}
