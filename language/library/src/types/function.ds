/// Permitted invocation count for a callable value.
export type Multiplicity = "repeatable" | "once";

/// Callable value type, repeatable by default and affine when invoked once.
@languageItem("types.Function")
export newtype Function<
    Parameters: readonly (...unknown[],) = (),
    Return = unknown,
    const M: Multiplicity = "repeatable",
> = intrinsic;

/// Thin callable value type.
@languageItem("types.FunctionPointer")
export newtype FunctionPointer<
    Parameters: readonly (...unknown[],) = (),
    Return = unknown,
> = intrinsic;

/// Extract the parameter tuple from a callable type.
@languageItem("types.Parameters")
export type Parameters<T> = T extends (...parameters: infer P) => unknown ? P : never;

/// Extract the parameter tuple from a constructor type.
@languageItem("types.ConstructorParameters")
export type ConstructorParameters<T> = T extends new (...parameters: infer P) => unknown
    ? P
    : never;

/// Extract the return type from a callable type.
@languageItem("types.ReturnType")
export type ReturnType<T> = T extends (...parameters: never) => infer R ? R : never;

/// Extract the instance type from a constructor type.
@languageItem("types.InstanceType")
export type InstanceType<T> = T extends new (...parameters: never) => infer R ? R : never;

/// Extract the explicit receiver from a callable type.
@languageItem("types.ThisParameterType")
export type ThisParameterType<T> = T extends (this: infer This, ...parameters: never) => unknown
    ? This
    : unknown;

/// Remove the explicit receiver from a callable type.
@languageItem("types.OmitThisParameter")
export type OmitThisParameter<T> =
    unknown extends ThisParameterType<T>
        ? T
        : T extends (this: infer This, ...parameters: infer P) => infer R
          ? (...parameters: P) => R
          : T;
