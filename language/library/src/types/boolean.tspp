import { Clone } from "tspp:memory";
import { Debug, Display, Equal, Hash, Hasher, PartialEqual } from "tspp:ops";

/// Methods of the builtin boolean type.
export extension Boolean of boolean
    implements Clone, PartialEqual<boolean>, Equal<boolean>, Hash, Display, Debug
{
    /// Return `true` or `false` as a user-facing string.
    display(&immutable this): ^string {
        if (*this) {
            "true"
        } else {
            "false"
        }
    }

    /// Return `true` or `false` as a developer-facing string.
    debug(&immutable this): ^string {
        this.display()
    }

    /// Return a copy of this value.
    clone(&immutable this): boolean {
        *this
    }

    /// Return whether this value equals `other`.
    equal(&immutable this, other: &immutable boolean): boolean {
        *this === *other
    }

    /// Add this value to `state`.
    hash(&immutable this, state: &Hasher): void {
        state.writeUint8(if (*this) { 1 } else { 0 });
    }
}
