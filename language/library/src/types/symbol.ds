import { todo } from "destack:error";
import { MaybeOwned } from "destack:memory";

/// Create a new unique symbol.
@binding("destack.types.symbol.create", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
declare function createSymbol(description?: string | number): symbol;

/// Global symbol operations.
@languageItem("types.Symbol")
export class Symbol {
    /// Create a new unique symbol.
    static create(description?: string | number): symbol {
        return createSymbol(description);
    }

    /// Return a symbol from the shared registry.
    @languageItem("types.Symbol.for")
    static for(key: string): symbol {
        todo("Symbol.for")
    }

    /// Return the registry key for `value`.
    static keyFor(value: symbol): MaybeOwned<string> | undefined {
        todo("Symbol.keyFor")
    }
}
