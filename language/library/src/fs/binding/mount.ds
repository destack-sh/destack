import { HostError } from "destack:error/host";

import { Path } from "../path.ds";

/// Filesystem mount entry.
export struct Mount {
    /// Source device or backing object when the host exposes one.
    source?: string;
    /// Target mount path.
    target: Path;
    /// Filesystem type name when the host exposes one.
    fileSystem?: string;
    /// Host-defined mount flags bitmask when the host exposes one.
    hostFlags?: uint64;
}

/// Filesystem mount binding family.
@languageItem("fs.binding.MountBinding")
export interface MountBinding {
    /// List filesystem mounts.
    @binding("destack.fs.mount.list", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.mount.list"],
        families: ["windows", "unix"],
    })
    list(): Result<Mount[], HostError>;
}
