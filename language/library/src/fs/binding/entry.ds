import { DirectoryHandle } from "destack:fs/binding";

import { Path } from "./path.ds";

/// Filesystem entry addressed by an optional directory root and host path.
export struct FilesystemEntry {
    /// Directory root for relative resolution.
    directory?: DirectoryHandle;
    /// Host path payload.
    path: Path;
}

/// Build an entry resolved from the ambient process namespace.
export function filesystemEntry(path: Path): FilesystemEntry {
    FilesystemEntry {
        path,
    }
}

/// Build an entry resolved relative to a directory handle.
export function filesystemEntryAt(directory: DirectoryHandle, path: Path): FilesystemEntry {
    FilesystemEntry {
        directory,
        path,
    }
}
