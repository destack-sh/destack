import * as binding from "destack:binding";

import { AttributeBinding } from "./attribute.ds";
import { DirectoryBinding } from "./directory.ds";
import { FileBinding } from "./file.ds";
import { MountBinding } from "./mount.ds";
import { NamespaceBinding } from "./namespace.ds";
import { StatusBinding } from "./status.ds";
import { VolumeBinding } from "./volume.ds";
import { WatchBinding } from "./watch.ds";
import { XattrBinding } from "./xattr.ds";

/// Current filesystem binding family.
export const fs: binding.Binding<Binding> = new binding.Binding<Binding>("fs");

/// Filesystem binding family.
@languageItem("fs.Binding")
export interface Binding {
    /// File attribute bindings.
    readonly attribute: AttributeBinding;
    /// Directory bindings.
    readonly directory: DirectoryBinding;
    /// File descriptor bindings.
    readonly file: FileBinding;
    /// Mount table bindings.
    readonly mount: MountBinding;
    /// Namespace bindings.
    readonly namespace: NamespaceBinding;
    /// Status bindings.
    readonly status: StatusBinding;
    /// Volume bindings.
    readonly volume: VolumeBinding;
    /// Watch bindings.
    readonly watch: WatchBinding;
    /// Extended attribute bindings.
    readonly xattr: XattrBinding;
}
