import { Binding } from "destack:binding";

import { FsAttributeBinding } from "./attribute.ds";
import { FsDirectoryBinding } from "./directory.ds";
import { FsFileBinding } from "./file.ds";
import { FsMountBinding } from "./mount.ds";
import { FsNamespaceBinding } from "./namespace.ds";
import { FsStatusBinding } from "./status.ds";
import { FsVolumeBinding } from "./volume.ds";
import { FsWatchBinding } from "./watch.ds";
import { FsXattrBinding } from "./xattr.ds";

/// Filesystem binding family.
@languageItem("fs.FsBinding")
export interface FsBinding {
    /// File attribute bindings.
    readonly attribute: FsAttributeBinding;
    /// Directory bindings.
    readonly directory: FsDirectoryBinding;
    /// File descriptor bindings.
    readonly file: FsFileBinding;
    /// Mount table bindings.
    readonly mount: FsMountBinding;
    /// Namespace bindings.
    readonly namespace: FsNamespaceBinding;
    /// Status bindings.
    readonly status: FsStatusBinding;
    /// Volume bindings.
    readonly volume: FsVolumeBinding;
    /// Watch bindings.
    readonly watch: FsWatchBinding;
    /// Extended attribute bindings.
    readonly xattr: FsXattrBinding;
}

/// Current filesystem binding family.
export const fs = new Binding<FsBinding>("fs");
