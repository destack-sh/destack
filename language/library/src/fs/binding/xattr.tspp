import { HostError } from "tspp:error/host";
import { FileHandle } from "tspp:fs/binding";

import { Entry } from "./entry.tspp";

/// Extended attribute creation flags.
@languageItem("fs.binding.XattrFlags")
export newtype XattrFlags = uint32;

export extension of XattrFlags {
    /// Create an attribute and fail if it already exists.
    const create = XattrFlags(0x1);

    /// Replace an attribute and fail if it does not exist.
    const replace = XattrFlags(0x2);
}

/// Filesystem entry extended attribute target.
export struct XattrTargetEntry {
    /// Target discriminator.
    kind: "entry";
    /// Target filesystem entry.
    entry: Entry;
    /// Whether symbolic links should be followed.
    isFollowing: boolean;
}

/// Open file extended attribute target.
export struct XattrTargetFile {
    /// Target discriminator.
    kind: "file";
    /// Target file handle.
    file: FileHandle;
}

/// Target for extended attribute operations.
@languageItem("fs.binding.XattrTarget")
export newtype XattrTarget = XattrTargetEntry | XattrTargetFile;

/// Filesystem extended attribute binding family.
@languageItem("fs.binding.XattrBinding")
export interface XattrBinding {
    /// Read one extended attribute into an output buffer.
    @binding("tspp.fs.xattr.read", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.xattr"],
        families: ["unix"],
    })
    read(
        target: &readonly XattrTarget,
        name: &readonly [uint8],
        buffer: &[uint8],
    ): Result<uint64, HostError>;

    /// Write one extended attribute.
    @binding("tspp.fs.xattr.write", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.xattr"],
        families: ["unix"],
    })
    write(
        target: &readonly XattrTarget,
        name: &readonly [uint8],
        value: &readonly [uint8],
        flags: XattrFlags,
    ): Result<void, HostError>;

    /// List extended attribute names into an output buffer.
    @binding("tspp.fs.xattr.list", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.xattr"],
        families: ["unix"],
    })
    list(target: &readonly XattrTarget, buffer: &[uint8]): Result<uint64, HostError>;

    /// Remove one extended attribute.
    @binding("tspp.fs.xattr.remove", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.xattr"],
        families: ["unix"],
    })
    remove(target: &readonly XattrTarget, name: &readonly [uint8]): Result<void, HostError>;
}
