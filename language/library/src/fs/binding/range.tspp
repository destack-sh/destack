/// File offset in bytes.
@languageItem("fs.binding.FileOffset")
export newtype FileOffset = int64;

/// File size in bytes.
@languageItem("fs.binding.FileSize")
export newtype FileSize = uint64;

/// File byte range.
export struct FileRange {
    /// Starting byte offset.
    offset: FileOffset;
    /// Range length in bytes.
    length: FileSize;
}
