/// Shared host output buffer containing one or more paths.
@languageItem("fs.binding.PathBuffer")
export newtype PathBuffer = PathByteBuffer | PathUtf16Buffer;

/// Byte-oriented host path output buffer.
export struct PathByteBuffer {
    /// The native encoding discriminator.
    kind: "bytes" = "bytes";

    /// The raw path bytes.
    bytes: [uint8];
}

/// UTF-16-oriented host path output buffer.
export struct PathUtf16Buffer {
    /// The native encoding discriminator.
    kind: "utf16" = "utf16";

    /// The raw path code units.
    units: [uint16];
}

/// One path range in a shared host output buffer.
export struct PathSpan {
    /// The native code-unit offset.
    offset: uint64;

    /// The native code-unit length.
    length: uint64;
}

export extension of PathBuffer {
    /// Wrap a byte-oriented output buffer.
    static bytes(bytes: [uint8]): PathBuffer {
        PathBuffer(PathByteBuffer { bytes })
    }

    /// Wrap a UTF-16-oriented output buffer.
    static utf16(units: [uint16]): PathBuffer {
        PathBuffer(PathUtf16Buffer { units })
    }
}
