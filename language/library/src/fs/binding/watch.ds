import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

import { FilesystemEntry } from "./entry.ds";
import { PathBuffer, PathSpan } from "./path.ds";

/// Handle for a filesystem watcher.
export newtype WatchHandle = ResourceId;

/// Filesystem watch mask bitset.
export newtype FileWatchMask = uint32;

/// Watch mask bit for create events.
export const FILE_WATCH_CREATE: FileWatchMask = FileWatchMask(1 << 0);

/// Watch mask bit for remove events.
export const FILE_WATCH_REMOVE: FileWatchMask = FileWatchMask(1 << 1);

/// Watch mask bit for modify events.
export const FILE_WATCH_MODIFY: FileWatchMask = FileWatchMask(1 << 2);

/// Watch mask bit for rename events.
export const FILE_WATCH_RENAME: FileWatchMask = FileWatchMask(1 << 3);

/// Watch mask bit for metadata events.
export const FILE_WATCH_METADATA: FileWatchMask = FileWatchMask(1 << 4);

/// Watch mask bit for overflow events.
export const FILE_WATCH_OVERFLOW: FileWatchMask = FileWatchMask(1 << 5);

/// Watch mask value that subscribes to all event classes.
export const FILE_WATCH_ALL: FileWatchMask = FileWatchMask(0x3f);

/// Filesystem watch options.
export struct FileWatchOptions {
    /// Event mask to subscribe to.
    mask: FileWatchMask;
    /// Whether recursive watching is requested.
    isRecursive: boolean;
    /// Whether symlink entries should be followed.
    isFollowing: boolean;
}

/// Filesystem create watch event.
export struct FileWatchEventCreate {
    /// Event discriminator.
    kind: "create";
    /// Host event cookie.
    cookie: uint64;
    /// Event path.
    path: PathSpan;
}

/// Filesystem remove watch event.
export struct FileWatchEventRemove {
    /// Event discriminator.
    kind: "remove";
    /// Host event cookie.
    cookie: uint64;
    /// Event path.
    path: PathSpan;
}

/// Filesystem modify watch event.
export struct FileWatchEventModify {
    /// Event discriminator.
    kind: "modify";
    /// Host event cookie.
    cookie: uint64;
    /// Event path.
    path: PathSpan;
}

/// Filesystem rename watch event.
export struct FileWatchEventRename {
    /// Event discriminator.
    kind: "rename";
    /// Host event cookie.
    cookie: uint64;
    /// Event path.
    path: PathSpan;
    /// Related path.
    related: PathSpan;
}

/// Filesystem metadata watch event.
export struct FileWatchEventMetadata {
    /// Event discriminator.
    kind: "metadata";
    /// Host event cookie.
    cookie: uint64;
    /// Event path.
    path: PathSpan;
}

/// Filesystem overflow watch event.
export struct FileWatchEventOverflow {
    /// Event discriminator.
    kind: "overflow";
    /// Host event cookie.
    cookie: uint64;
}

/// Filesystem watch event.
export newtype FileWatchEvent =
    | FileWatchEventCreate
    | FileWatchEventRemove
    | FileWatchEventModify
    | FileWatchEventRename
    | FileWatchEventMetadata
    | FileWatchEventOverflow;

/// Watch events written by one read operation.
export struct FileWatchBatch {
    /// Number of events written into the output slice.
    count: uint64;
    /// Path buffer length consumed by event paths.
    pathLength: uint64;
    /// Whether the host reported dropped events.
    hasOverflow: boolean;
}

/// Filesystem watch binding family.
export interface FsWatch {
    /// Start watching one filesystem entry.
    @binding("destack.fs.watch.open", {
        effect: "external",
        requires: ["host.fs.watch"],
        families: ["windows", "unix"],
        simulation: true,
    })
    open(
        entry: &readonly FilesystemEntry,
        options: FileWatchOptions,
    ): Result<WatchHandle, HostError>;

    /// Stop watching and release the watch handle.
    @binding("destack.fs.watch.close", {
        effect: "external",
        requires: ["host.fs.watch"],
        families: ["windows", "unix"],
        simulation: true,
    })
    close(watch: WatchHandle): Result<void, HostError>;

    /// Read watch events into an output slice.
    @binding("destack.fs.watch.read", {
        effect: "external",
        requires: ["host.fs.watch"],
        families: ["windows", "unix"],
        simulation: true,
    })
    read(
        watch: WatchHandle,
        events: &[FileWatchEvent],
        paths: &PathBuffer,
    ): Result<FileWatchBatch, HostError>;
}
