import { HostError } from "tspp:error/host";
import { FileHandle } from "tspp:fs/binding";

import { Entry } from "./entry.tspp";
import { FileSize } from "./range.tspp";

/// File permission mode bits.
@languageItem("fs.binding.FileMode")
export newtype FileMode = uint32;

export extension of FileMode {
    /// File type bits mask.
    const typeMask = FileMode(0xf000);

    /// FIFO file type bits.
    const fifo = FileMode(0x1000);

    /// Character device file type bits.
    const character = FileMode(0x2000);

    /// Directory file type bits.
    const directory = FileMode(0x4000);

    /// Block device file type bits.
    const block = FileMode(0x6000);

    /// Regular file type bits.
    const file = FileMode(0x8000);

    /// Symbolic link file type bits.
    const symlink = FileMode(0xa000);

    /// Socket file type bits.
    const socket = FileMode(0xc000);

    /// Owner read permission bit.
    const ownerRead = FileMode(0x0100);

    /// Owner write permission bit.
    const ownerWrite = FileMode(0x0080);

    /// Owner execute permission bit.
    const ownerExecute = FileMode(0x0040);

    /// Group read permission bit.
    const groupRead = FileMode(0x0020);

    /// Group write permission bit.
    const groupWrite = FileMode(0x0010);

    /// Group execute permission bit.
    const groupExecute = FileMode(0x0008);

    /// Other read permission bit.
    const otherRead = FileMode(0x0004);

    /// Other write permission bit.
    const otherWrite = FileMode(0x0002);

    /// Other execute permission bit.
    const otherExecute = FileMode(0x0001);
}

/// File timestamp in nanoseconds since the Unix epoch.
@languageItem("fs.binding.FileTime")
export newtype FileTime = int64;

/// Access and modification timestamps.
export struct FileTimes {
    /// Last access time.
    access: FileTime;
    /// Last modification time.
    modification: FileTime;
}

/// Windows file security identifier bytes.
@languageItem("fs.binding.FilePrincipalSid")
export newtype FilePrincipalSid = [uint8];

/// Unix file owner principal.
export struct FilePrincipalUnix {
    /// Principal discriminator.
    kind: "unix";
    /// Unix user or group identifier.
    id: uint32;
}

/// Windows file owner principal.
export struct FilePrincipalWindows {
    /// Principal discriminator.
    kind: "windows";
    /// Windows security identifier.
    sid: FilePrincipalSid;
}

/// File owner principal.
@languageItem("fs.binding.FilePrincipal")
export newtype FilePrincipal = FilePrincipalUnix | FilePrincipalWindows;

/// File owner assignment.
export struct FileOwner {
    /// User owner principal.
    user?: FilePrincipal;
    /// Group owner principal.
    group?: FilePrincipal;
}

/// File status field mask.
@languageItem("fs.binding.FileStatusMask")
export newtype FileStatusMask = uint32;

export extension of FileStatusMask {
    /// Request device identifier.
    const device = FileStatusMask(0x0001);

    /// Request node identifier.
    const node = FileStatusMask(0x0002);

    /// Request mode bits.
    const mode = FileStatusMask(0x0004);

    /// Request hard link count.
    const links = FileStatusMask(0x0008);

    /// Request owner principals.
    const owner = FileStatusMask(0x0010);

    /// Request node device identifier.
    const nodeDevice = FileStatusMask(0x0020);

    /// Request file size.
    const size = FileStatusMask(0x0040);

    /// Request allocated block fields.
    const blocks = FileStatusMask(0x0080);

    /// Request access timestamp.
    const accessTime = FileStatusMask(0x0100);

    /// Request modification timestamp.
    const modificationTime = FileStatusMask(0x0200);

    /// Request status change timestamp.
    const changeTime = FileStatusMask(0x0400);

    /// Request file creation time.
    const created = FileStatusMask(0x0800);

    /// Request mount identifier.
    const mount = FileStatusMask(0x1000);

    /// Request the common portable status fields.
    const basic = FileStatusMask(0x07ff);

    /// Request all fields the host can provide.
    const all = FileStatusMask(0x1fff);
}

/// File status flags.
@languageItem("fs.binding.FileStatusFlags")
export newtype FileStatusFlags = uint32;

export extension of FileStatusFlags {
    /// Do not force attribute synchronization.
    const doNotSync = FileStatusFlags(0x4000);

    /// Force attribute synchronization when the host supports it.
    const forceSync = FileStatusFlags(0x2000);

    /// Allow an empty path for handle status by empty path.
    const emptyPath = FileStatusFlags(0x10);
}

/// File status options.
export struct FileStatusOptions {
    /// Whether the final path component should be followed when it is a symlink.
    isFollowing: boolean;
    /// Status behavior flags.
    flags: FileStatusFlags;
    /// Requested field mask.
    mask: FileStatusMask;
}

/// File status returned by host metadata operations.
export struct FileStatus {
    /// Mask of fields populated by the host.
    mask: FileStatusMask;
    /// Device identifier.
    device: uint64;
    /// Inode or file identifier.
    node: uint64;
    /// File mode bits.
    mode: FileMode;
    /// Hard link count.
    links: uint32;
    /// File owner principals.
    owner: FileOwner;
    /// Device identifier for device nodes.
    nodeDevice: uint64;
    /// File size in bytes.
    size: FileSize;
    /// Preferred block size for I/O.
    blockSize: uint64;
    /// Allocated block count.
    blocks: uint64;
    /// Last access time.
    accessTime: FileTime;
    /// Last modification time.
    modificationTime: FileTime;
    /// Last status change time.
    changeTime: FileTime;
    /// Creation time when available.
    creationTime: FileTime;
    /// Mount identifier when available.
    mount: uint64;
}

/// Filesystem status binding family.
@languageItem("fs.binding.StatusBinding")
export interface StatusBinding {
    /// Read status for a filesystem entry.
    @binding("tspp.fs.status.entry", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.metadata"],
        families: ["windows", "unix"],
    })
    readEntry(entry: &readonly Entry, options: FileStatusOptions): Result<FileStatus, HostError>;

    /// Read status for an open file.
    @binding("tspp.fs.status.file", {
        provider: "host",
        effect: "external",
        requires: ["host.fs.metadata"],
        families: ["windows", "unix"],
    })
    readFile(file: FileHandle, options: FileStatusOptions): Result<FileStatus, HostError>;
}
