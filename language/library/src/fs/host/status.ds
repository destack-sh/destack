import { HostError } from "destack:error/host";
import { FileHandle } from "destack:fs/host";

import { FilesystemEntry } from "./entry.ds";
import { FileSize } from "./range.ds";

/// File permission mode bits.
export newtype FileMode = uint32;

/// File type bits mask.
export const FILE_MODE_TYPE: FileMode = FileMode(0xf000);

/// FIFO file type bits.
export const FILE_MODE_FIFO: FileMode = FileMode(0x1000);

/// Character device file type bits.
export const FILE_MODE_CHARACTER: FileMode = FileMode(0x2000);

/// Directory file type bits.
export const FILE_MODE_DIRECTORY: FileMode = FileMode(0x4000);

/// Block device file type bits.
export const FILE_MODE_BLOCK: FileMode = FileMode(0x6000);

/// Regular file type bits.
export const FILE_MODE_FILE: FileMode = FileMode(0x8000);

/// Symbolic link file type bits.
export const FILE_MODE_SYMLINK: FileMode = FileMode(0xa000);

/// Socket file type bits.
export const FILE_MODE_SOCKET: FileMode = FileMode(0xc000);

/// Owner read permission bit.
export const FILE_MODE_OWNER_READ: FileMode = FileMode(0x0100);

/// Owner write permission bit.
export const FILE_MODE_OWNER_WRITE: FileMode = FileMode(0x0080);

/// Owner execute permission bit.
export const FILE_MODE_OWNER_EXECUTE: FileMode = FileMode(0x0040);

/// Group read permission bit.
export const FILE_MODE_GROUP_READ: FileMode = FileMode(0x0020);

/// Group write permission bit.
export const FILE_MODE_GROUP_WRITE: FileMode = FileMode(0x0010);

/// Group execute permission bit.
export const FILE_MODE_GROUP_EXECUTE: FileMode = FileMode(0x0008);

/// Other read permission bit.
export const FILE_MODE_OTHER_READ: FileMode = FileMode(0x0004);

/// Other write permission bit.
export const FILE_MODE_OTHER_WRITE: FileMode = FileMode(0x0002);

/// Other execute permission bit.
export const FILE_MODE_OTHER_EXECUTE: FileMode = FileMode(0x0001);

/// File timestamp in nanoseconds since the Unix epoch.
export newtype FileTime = int64;

/// Access and modification timestamps.
export struct FileTimes {
    /// Last access time.
    access: FileTime;
    /// Last modification time.
    modification: FileTime;
}

/// Windows file security identifier bytes.
export newtype FilePrincipalSid = [uint8];

/// Unix file owner principal.
export struct FilePrincipalUnix {
    /// Principal discriminator.
    kind: "unix";
    /// Unix user or group identifier.
    id: uint32;
}

/// Windows file owner principal.
export struct FilePrincipalWindows {
    /// Principal discriminator.
    kind: "windows";
    /// Windows security identifier.
    sid: FilePrincipalSid;
}

/// File owner principal.
export newtype FilePrincipal = FilePrincipalUnix | FilePrincipalWindows;

/// File owner assignment.
export struct FileOwner {
    /// User owner principal.
    user?: FilePrincipal;
    /// Group owner principal.
    group?: FilePrincipal;
}

/// File status field mask.
export newtype FileStatusMask = uint32;

/// Request device identifier.
export const FILE_STATUS_DEVICE: FileStatusMask = FileStatusMask(0x0001);

/// Request node identifier.
export const FILE_STATUS_NODE: FileStatusMask = FileStatusMask(0x0002);

/// Request mode bits.
export const FILE_STATUS_MODE: FileStatusMask = FileStatusMask(0x0004);

/// Request hard link count.
export const FILE_STATUS_LINKS: FileStatusMask = FileStatusMask(0x0008);

/// Request owner principals.
export const FILE_STATUS_OWNER: FileStatusMask = FileStatusMask(0x0010);

/// Request node device identifier.
export const FILE_STATUS_NODE_DEVICE: FileStatusMask = FileStatusMask(0x0020);

/// Request file size.
export const FILE_STATUS_SIZE: FileStatusMask = FileStatusMask(0x0040);

/// Request allocated block fields.
export const FILE_STATUS_BLOCKS: FileStatusMask = FileStatusMask(0x0080);

/// Request access timestamp.
export const FILE_STATUS_ACCESS_TIME: FileStatusMask = FileStatusMask(0x0100);

/// Request modification timestamp.
export const FILE_STATUS_MODIFICATION_TIME: FileStatusMask = FileStatusMask(0x0200);

/// Request status change timestamp.
export const FILE_STATUS_CHANGE_TIME: FileStatusMask = FileStatusMask(0x0400);

/// Request file creation time.
export const FILE_STATUS_CREATED: FileStatusMask = FileStatusMask(0x0800);

/// Request mount identifier.
export const FILE_STATUS_MOUNT: FileStatusMask = FileStatusMask(0x1000);

/// Request the common portable status fields.
export const FILE_STATUS_BASIC: FileStatusMask = FileStatusMask(0x07ff);

/// Request all fields the host can provide.
export const FILE_STATUS_ALL: FileStatusMask = FileStatusMask(0x1fff);

/// File status flags.
export newtype FileStatusFlags = uint32;

/// Do not force attribute synchronization.
export const FILE_STATUS_DONT_SYNC: FileStatusFlags = FileStatusFlags(0x4000);

/// Force attribute synchronization when the host supports it.
export const FILE_STATUS_FORCE_SYNC: FileStatusFlags = FileStatusFlags(0x2000);

/// Allow an empty path for handle status by empty path.
export const FILE_STATUS_EMPTY_PATH: FileStatusFlags = FileStatusFlags(0x10);

/// File status options.
export struct FileStatusOptions {
    /// Whether the final path component should be followed when it is a symlink.
    isFollowing: boolean;
    /// Status behavior flags.
    flags: FileStatusFlags;
    /// Requested field mask.
    mask: FileStatusMask;
}

/// File status returned by host metadata operations.
export struct FileStatus {
    /// Mask of fields populated by the host.
    mask: FileStatusMask;
    /// Device identifier.
    device: uint64;
    /// Inode or file identifier.
    node: uint64;
    /// File mode bits.
    mode: FileMode;
    /// Hard link count.
    links: uint32;
    /// File owner principals.
    owner: FileOwner;
    /// Device identifier for device nodes.
    nodeDevice: uint64;
    /// File size in bytes.
    size: FileSize;
    /// Preferred block size for I/O.
    blockSize: uint64;
    /// Allocated block count.
    blocks: uint64;
    /// Last access time.
    accessTime: FileTime;
    /// Last modification time.
    modificationTime: FileTime;
    /// Last status change time.
    changeTime: FileTime;
    /// Creation time when available.
    creationTime: FileTime;
    /// Mount identifier when available.
    mount: uint64;
}

/// Filesystem status binding family.
export interface FsStatus {
    /// Read status for a filesystem entry.
    @binding("destack.fs.status.entry", {
        effect: "external",
        requires: ["host.fs.metadata"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readEntry(
        entry: &readonly FilesystemEntry,
        options: FileStatusOptions,
    ): Result<FileStatus, HostError>;

    /// Read status for an open file.
    @binding("destack.fs.status.file", {
        effect: "external",
        requires: ["host.fs.metadata"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readFile(file: FileHandle, options: FileStatusOptions): Result<FileStatus, HostError>;
}
