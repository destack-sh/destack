import { Access, WithAccess } from "destack:memory";
import { Option } from "destack:types";

/// A protocol for producing a sequence of values.
@languageItem("iter.Iterator")
export newtype interface Iterator {
    type Item;

    /// Advance and return the next item, or `null` when exhausted.
    next(): Option<this.Item>;
}

/// A value that can produce an iterator.
@languageItem("iter.Iterable")
export newtype interface Iterable {
    type Item;

    /// Return a new iterator for this receiver form.
    iterator(): Iterator<this.Item>;
}

/// Every iterator is trivially iterable as itself.
extension<I: Iterator> of I implements Iterable {
    type Item = I.Item;

    /// Return this iterator.
    iterator(): I {
        this
    }
}

/// Collection built from an iterator.
@languageItem("iter.FromIterator")
export newtype interface FromIterator<T> {
    /// Build this value from `values`.
    static fromIterator(values: Iterator<T>): this;
}

/// Collection extended from an iterable sequence.
@languageItem("iter.Extend")
export newtype interface Extend<T, comptime A: Access = "mutable"> {
    /// Append `values`.
    extend(this: WithAccess<&this, A>, values: Iterable<T>): void;
}

export extension<I: Iterator> of I {
    /// Collect this iterator into `C`.
    collect<C>(): C where C: FromIterator<I.Item> {
        C.fromIterator(this)
    }
}
