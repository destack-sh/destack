import { Json } from "destack:json";
import * as test from "destack:test";

/// Stable simulation trace identifier.
export newtype TraceId = string;

/// Recorded simulation event.
export struct TraceEvent {
    /// Simulation tick.
    tick: uint64;

    /// Event name.
    name: string;

    /// Event value when available.
    value?: Json;
}

/// Recorded simulation trace.
export struct Trace {
    /// Trace identifier when persisted.
    id?: TraceId;

    /// Trace events.
    events: [TraceEvent];

    /// Replay input when available.
    replay?: test.Replay;
}
