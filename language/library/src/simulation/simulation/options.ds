import { RandomSeed } from "destack:runtime";
import * as test from "destack:test";

import { HostPatch } from "../host/host.ds";
import { ScenarioOptions } from "../scenario/scenario.ds";

/// Simulation seed.
export type Seed = RandomSeed;

/// Simulation registration options.
export type Options = test.Options & {
    /// Deterministic simulation seed.
    seed?: Seed;
    /// Initial scenario options.
    scenario?: ScenarioOptions;
    /// Explicit host overrides.
    host?: HostPatch;
};
