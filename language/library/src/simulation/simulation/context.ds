import { Promise } from "destack:async";
import { Measure } from "destack:bench";
import { Result } from "destack:error";
import { HostError } from "destack:error/host";
import * as runtime from "destack:runtime";
import * as test from "destack:test";

import { Fault } from "../fault/fault.ds";
import { Rule, RuleId, Selector } from "../scenario/rule.ds";
import { Scenario } from "../scenario/scenario.ds";
import { Trigger } from "../scenario/trigger.ds";
import { Simulation } from "./simulation.ds";

/// Simulation callback context.
export newtype interface Context extends test.CaseContext {
    /// Active simulation.
    readonly simulation: Simulation;

    /// Simulation world.
    readonly world: runtime.World;

    /// Active simulation scenario.
    readonly scenario: Scenario;

    /// Runtime causal trace.
    readonly trace: runtime.Trace;

    /// Create one runtime in this simulation world.
    runtime(options?: runtime.RuntimeCreateOptions): Result<runtime.Runtime, HostError>;

    /// Create one worker in `owner`.
    worker(
        owner: runtime.Runtime,
        options?: runtime.WorkerCreateOptions,
    ): Result<runtime.Worker, HostError>;

    /// Install one rule in the active simulation scenario.
    rule(rule: Rule): RuleId;

    /// Install one fault in the active simulation scenario.
    fault(select: Selector, fault: Fault, trigger?: Trigger): RuleId;

    /// Install one simulated binding implementation.
    bind<T>(name: string, implementation: T): T;

    /// Advance the simulation world by one deterministic step.
    step(): Result<runtime.TickResult, HostError>;

    /// Run the simulation until no work is ready.
    runUntilIdle(): Promise<void>;

    /// Create one benchmark measurement inside this simulation.
    measure(name: string): Measure;
}

/// Simulation callback result.
export type BodyResult = test.BodyResult;

/// Simulation callback.
export type Body = (ctx: Context) => BodyResult;

/// Simulation suite callback.
export type SuiteBody = () => void;
