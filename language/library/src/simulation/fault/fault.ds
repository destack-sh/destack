import { Duration } from "destack:time";
import { Direction } from "destack:topology";

import { Attempt } from "../binding/attempt.ds";

/// Stable error code used by simulation faults.
export newtype ErrorCode = string;

/// Error payload for operation and randomness faults.
export struct Error {
    /// Stable error code.
    code: ErrorCode;
    /// Optional module-specific error class.
    class?: string;
    /// Optional diagnostic message.
    message?: string;
}

/// Delay jitter distribution.
export enum JitterDistribution {
    /// Uniform random jitter.
    Uniform = 1,
    /// Normal random jitter.
    Normal = 2,
    /// Exponential random jitter.
    Exponential = 3,
}

/// Deterministic delay payload.
export struct Delay {
    /// Base delay.
    base: Duration;
    /// Optional jitter.
    jitter?: Duration;
    /// Optional jitter distribution.
    distribution?: JitterDistribution;
}

/// Deterministic operation error fault.
export struct OperationError {
    /// Fault discriminator.
    kind: "operation.error";
    /// Error payload for the injected failure.
    error: Error;
}

/// Deterministic operation timeout fault.
export struct OperationTimeout {
    /// Fault discriminator.
    kind: "operation.timeout";
    /// Optional timeout duration.
    after?: Duration;
    /// Optional timeout error override.
    error?: Error;
}

/// Deterministic operation delay fault.
export struct OperationDelay {
    /// Fault discriminator.
    kind: "operation.delay";
    /// Delay payload.
    delay: Delay;
}

/// Operation fault.
@derive(Tagged)
export newtype OperationFault = OperationError | OperationTimeout | OperationDelay;

/// Resource class for capacity and quota faults.
export enum Resource {
    /// Memory budget.
    Memory = 1,
    /// File descriptor budget.
    FileDescriptor = 2,
    /// File handle budget.
    FileHandle = 3,
    /// Socket budget.
    Socket = 4,
    /// Thread budget.
    Thread = 5,
    /// Process budget.
    Process = 6,
    /// Disk space budget.
    DiskSpace = 7,
    /// Inode budget.
    Inode = 8,
    /// Network bandwidth budget.
    Bandwidth = 9,
    /// CPU budget.
    Cpu = 10,
    /// GPU budget.
    Gpu = 11,
    /// Queue depth budget.
    Queue = 12,
    /// Timer budget.
    Timer = 13,
}

/// Resource limit value with explicit units.
@derive(Tagged)
export newtype ResourceLimitValue =
    | {
          /// Limit discriminator.
          kind: "count";
          /// Count limit.
          count: uint64;
      }
    | {
          /// Limit discriminator.
          kind: "bytes";
          /// Byte limit.
          bytes: uint64;
      }
    | {
          /// Limit discriminator.
          kind: "rate";
          /// Maximum units per second.
          perSecond: uint64;
      }
    | {
          /// Limit discriminator.
          kind: "percent";
          /// Budget in parts per million.
          ppm: uint32;
      };

/// Resource pressure fault.
export struct ResourcePressure {
    /// Fault discriminator.
    kind: "resource.pressure";
    /// Pressured resource class.
    resource: Resource;
    /// Optional pressure level in parts per million.
    levelPpm?: uint32;
}

/// Resource limit fault.
export struct ResourceLimit {
    /// Fault discriminator.
    kind: "resource.limit";
    /// Limited resource class.
    resource: Resource;
    /// Resource limit.
    limit: ResourceLimitValue;
}

/// Resource fault.
@derive(Tagged)
export newtype ResourceFault = ResourcePressure | ResourceLimit;

/// Data corruption mode for payload faults.
export enum CorruptionMode {
    /// Flip one random bit in the payload.
    BitFlip = 1,
    /// Replace all bytes with zero.
    ZeroFill = 2,
    /// Replace bytes with random data.
    RandomBytes = 3,
    /// Return only a prefix of the payload.
    Truncate = 4,
}

/// Storage corruption target.
export enum CorruptionTarget {
    /// Stored payload bytes.
    Data = 1,
    /// Storage metadata.
    Metadata = 2,
    /// Write-ahead journal or log.
    Journal = 3,
    /// Secondary index or derived lookup state.
    Index = 4,
}

/// Storage ordering fault.
export enum OrderFault {
    /// Persist writes in an order different from issue order.
    ReorderPersist = 1,
    /// Expose writes in an order different from issue order.
    ReorderVisibility = 2,
    /// Expose only part of an ordered write sequence.
    TornSequence = 3,
}

/// Storage durability fault.
export enum DurabilityFault {
    /// Acknowledge writes before durability barriers complete.
    AckWithoutSync = 1,
    /// Lose one write that was already acknowledged.
    LoseAcknowledgedWrite = 2,
    /// Report sync success without enforcing durability.
    SyncNoop = 3,
    /// Persist file payload without required metadata durability.
    MetadataNotDurable = 4,
    /// Acknowledge one distributed write before quorum durability.
    AckBeforeQuorumPersist = 5,
}

/// Storage consistency fault.
export enum ConsistencyFault {
    /// Return an old value from storage.
    StaleRead = 1,
    /// Hide one entry that should be visible.
    MissingEntry = 2,
    /// Expose one entry that should not be visible.
    ExtraEntry = 3,
    /// Return stale metadata for a visible entry.
    StaleMetadata = 4,
    /// Expose rename as multiple non-atomic steps.
    NonAtomicRename = 5,
    /// Diverge committed state across replicas.
    ReplicaDivergence = 6,
}

/// Storage corruption fault.
export struct StorageCorrupt {
    /// Fault discriminator.
    kind: "storage.corrupt";
    /// Corruption target.
    target: CorruptionTarget;
    /// Optional corruption mode.
    mode?: CorruptionMode;
}

/// Storage ordering fault payload.
export struct StorageOrder {
    /// Fault discriminator.
    kind: "storage.order";
    /// Storage ordering fault selector.
    fault: OrderFault;
}

/// Storage durability fault payload.
export struct StorageDurability {
    /// Fault discriminator.
    kind: "storage.durability";
    /// Durability fault selector.
    fault: DurabilityFault;
}

/// Storage consistency fault payload.
export struct StorageConsistency {
    /// Fault discriminator.
    kind: "storage.consistency";
    /// Storage consistency fault selector.
    fault: ConsistencyFault;
    /// Optional maximum staleness in nanoseconds.
    maxAgeNanos?: uint64;
}

/// Storage fault.
@derive(Tagged)
export newtype StorageFault =
    | StorageCorrupt
    | StorageOrder
    | StorageDurability
    | StorageConsistency;

/// Transport limit mode for delivery-shaped faults.
@derive(Tagged)
export newtype TransportLimitMode =
    | {
          /// Limit discriminator.
          kind: "data";
          /// Total byte budget.
          bytes: uint64;
      }
    | {
          /// Limit discriminator.
          kind: "throughput";
          /// Maximum throughput in bytes per second.
          bytesPerSecond: uint64;
      }
    | {
          /// Limit discriminator.
          kind: "rate";
          /// Maximum operations per second.
          opsPerSecond: uint64;
      };

/// Transport delay fault.
export struct TransportDelay {
    /// Fault discriminator.
    kind: "transport.delay";
    /// Delay payload.
    delay: Delay;
}

/// Transport drop fault.
export struct TransportDrop {
    /// Fault discriminator.
    kind: "transport.drop";
}

/// Transport duplicate fault.
export struct TransportDuplicate {
    /// Fault discriminator.
    kind: "transport.duplicate";
    /// Number of duplicates emitted when the fault triggers.
    copies?: uint32;
}

/// Transport reorder fault.
export struct TransportReorder {
    /// Fault discriminator.
    kind: "transport.reorder";
    /// Reordering window size.
    window?: uint32;
}

/// Transport corruption fault.
export struct TransportCorrupt {
    /// Fault discriminator.
    kind: "transport.corrupt";
    /// Corruption mode.
    mode?: CorruptionMode;
}

/// Transport partial-delivery fault.
export struct TransportPartial {
    /// Fault discriminator.
    kind: "transport.partial";
    /// Maximum delivered byte count.
    maxBytes?: uint64;
}

/// Transport fragmentation fault.
export struct TransportFragment {
    /// Fault discriminator.
    kind: "transport.fragment";
    /// Maximum fragment byte count.
    maxBytes?: uint64;
}

/// Transport disconnect fault.
export struct TransportDisconnect {
    /// Fault discriminator.
    kind: "transport.disconnect";
}

/// Transport reset fault.
export struct TransportReset {
    /// Fault discriminator.
    kind: "transport.reset";
}

/// Transport partition fault.
export struct TransportPartition {
    /// Fault discriminator.
    kind: "transport.partition";
    /// Optional partition duration.
    duration?: Duration;
    /// Optional direction selector.
    direction?: Direction;
}

/// Transport blackhole fault.
export struct TransportBlackhole {
    /// Fault discriminator.
    kind: "transport.blackhole";
    /// Optional blackhole duration.
    duration?: Duration;
    /// Optional direction selector.
    direction?: Direction;
}

/// Transport limit fault.
export struct TransportLimit {
    /// Fault discriminator.
    kind: "transport.limit";
    /// Limit payload.
    limit: TransportLimitMode;
}

/// Transport fault.
@derive(Tagged)
export newtype TransportFault =
    | TransportDelay
    | TransportDrop
    | TransportDuplicate
    | TransportReorder
    | TransportCorrupt
    | TransportPartial
    | TransportFragment
    | TransportDisconnect
    | TransportReset
    | TransportPartition
    | TransportBlackhole
    | TransportLimit;

/// Clock jump fault.
export struct ClockJump {
    /// Fault discriminator.
    kind: "clock.jump";
    /// Signed jump delta in nanoseconds.
    deltaNanos: int64;
}

/// Clock drift fault.
export struct ClockDrift {
    /// Fault discriminator.
    kind: "clock.drift";
    /// Signed rate offset in parts per million.
    ratePpm: int64;
}

/// Clock freeze fault.
export struct ClockFreeze {
    /// Fault discriminator.
    kind: "clock.freeze";
    /// Optional freeze duration.
    duration?: Duration;
}

/// Clock resolution fault.
export struct ClockResolution {
    /// Fault discriminator.
    kind: "clock.resolution";
    /// Clock resolution.
    resolution: Duration;
}

/// Clock jitter fault.
export struct ClockJitter {
    /// Fault discriminator.
    kind: "clock.jitter";
    /// Jitter duration.
    jitter: Duration;
    /// Optional jitter distribution.
    distribution?: JitterDistribution;
}

/// Clock fault.
@derive(Tagged)
export newtype ClockFault = ClockJump | ClockDrift | ClockFreeze | ClockResolution | ClockJitter;

/// Random-source error fault.
export struct RandomError {
    /// Fault discriminator.
    kind: "random.error";
    /// Error payload.
    error: Error;
}

/// Random repeat fault.
export struct RandomRepeat {
    /// Fault discriminator.
    kind: "random.repeat";
    /// Optional repeated byte window.
    windowBytes?: uint64;
}

/// Random zero-fill fault.
export struct RandomZero {
    /// Fault discriminator.
    kind: "random.zero";
}

/// Random bias fault.
export struct RandomBias {
    /// Fault discriminator.
    kind: "random.bias";
    /// Optional bit index to bias.
    bit?: uint8;
    /// Bias probability in parts per million.
    probabilityPpm: uint32;
}

/// Random fault.
@derive(Tagged)
export newtype RandomFault = RandomError | RandomRepeat | RandomZero | RandomBias;

/// Lifecycle crash fault.
export struct LifecycleCrash {
    /// Fault discriminator.
    kind: "lifecycle.crash";
    /// Optional signal number.
    signal?: int64;
}

/// Lifecycle pause fault.
export struct LifecyclePause {
    /// Fault discriminator.
    kind: "lifecycle.pause";
    /// Optional pause duration.
    duration?: Duration;
}

/// Lifecycle restart fault.
export struct LifecycleRestart {
    /// Fault discriminator.
    kind: "lifecycle.restart";
    /// Optional restart delay.
    delay?: Duration;
}

/// Lifecycle reboot fault.
export struct LifecycleReboot {
    /// Fault discriminator.
    kind: "lifecycle.reboot";
    /// Optional reboot delay.
    delay?: Duration;
}

/// Lifecycle fault.
@derive(Tagged)
export newtype LifecycleFault =
    | LifecycleCrash
    | LifecyclePause
    | LifecycleRestart
    | LifecycleReboot;

/// User-defined simulation fault.
export struct CustomFault {
    /// Fault discriminator.
    kind: "custom";
    /// Stable custom fault name.
    name: string;
    /// Optional custom fault payload.
    payload?: unknown;
}

/// Simulation fault payload.
@derive(Tagged)
export newtype Fault =
    | OperationFault
    | ResourceFault
    | TransportFault
    | StorageFault
    | ClockFault
    | RandomFault
    | LifecycleFault
    | CustomFault;

/// Fault accepted by a scenario rule.
export struct TriggeredFault {
    /// Rule identifier that emitted this fault.
    ruleId: string;
    /// Attempt that matched the rule.
    attempt: Attempt;
    /// Fault payload.
    fault: Fault;
}

/// Triggered fault set for one simulated attempt.
export class FaultSet {
    /// Triggered faults.
    readonly faults: [TriggeredFault];

    /// Create a fault set.
    constructor(faults: [TriggeredFault]) {
        this.faults = faults;
    }

    /// Return whether no fault triggered.
    isEmpty(&readonly this): boolean {
        this.faults.isEmpty
    }
}
/// Create a user-defined simulation fault.
export function custom(name: string, payload?: unknown): CustomFault {
    CustomFault { kind: "custom", name, payload }
}
