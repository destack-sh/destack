/// Stable scenario identifier.
export newtype ScenarioId = uint64;

/// Scenario construction options.
export struct ScenarioOptions {
    /// Optional scenario name.
    name?: string;
    /// Initial enabled state.
    enabled?: boolean;
    /// Scenario labels.
    labels?: LabelSet;
    /// Initial rule list.
    rules?: [Rule];
}

/// Active simulation scenario.
export class Scenario {
