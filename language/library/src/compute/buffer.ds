import { Slice } from "destack:collections";
import { Context } from "destack:context";
import { Result } from "destack:error";

import { Device } from "./device.ds";
import { ComputeError } from "./error.ds";
import { Event, Stream } from "./stream.ds";

/// Host mapping permission for a compute buffer.
export enum HostAccess {
    /// Host code cannot map the buffer.
    None = 1,
    /// Host-readable storage.
    Read = 2,
    /// Host-writable storage.
    Write = 3,
    /// Host-readable and host-writable storage.
    ReadWrite = 4,
}

/// Allocation options for a compute buffer.
export struct BufferOptions {
    /// Debug label.
    label?: string;

    /// Host mapping permission.
    hostAccess: HostAccess = HostAccess.None;

    /// Requested byte alignment.
    alignment?: usize;
}

/// Byte region copied between compute buffers.
export struct BufferCopyRegion {
    /// Source byte offset.
    sourceOffset: usize = 0;

    /// Destination byte offset.
    destinationOffset: usize = 0;

    /// Copy byte length.
    byteLength: usize;
}

/// Typed storage allocated on one compute device.
@languageItem("compute.Buffer")
export newtype Buffer<T> = intrinsic;

export extension<T> of Buffer<T> {
    /// Return the device that owns this buffer.
    get device(): Device {
        Context.current().compute.buffer.device(this)
    }

    /// Return the element count.
    get length(): usize {
        Context.current().compute.buffer.length(this)
    }

    /// Return the byte length.
    get byteLength(): usize {
        Context.current().compute.buffer.byteLength(this)
    }

    /// Allocate a compute buffer.
    static allocate(
        device: Device,
        length: usize,
        options?: BufferOptions,
    ): Result<Buffer<T>, ComputeError> {
        Context.current().compute.buffer.allocate(device, length, options)
    }

    /// Create a buffer initialized from host values.
    static from(
        device: Device,
        values: [T],
        options?: BufferOptions,
    ): Result<Buffer<T>, ComputeError> {
        Context.current().compute.buffer.from(device, values, options)
    }

    /// Copy this buffer to `destination`.
    copyTo(destination: Buffer<T>, region: BufferCopyRegion, stream?: Stream): Event {
        Context.current().compute.buffer.copyTo(this, destination, region, stream)
    }

    /// Fill this buffer with `value`.
    fill(value: T, stream?: Stream): Event {
        Context.current().compute.buffer.fill(this, value, stream)
    }

    /// Read this buffer into host memory.
    read(stream?: Stream): Result<[T], ComputeError> {
        Context.current().compute.buffer.read(this, stream)
    }

    /// Write host values into this buffer.
    write(values: [T], stream?: Stream): Event {
        Context.current().compute.buffer.write(this, values, stream)
    }
}
