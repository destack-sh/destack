import { Slice } from "destack:collections";
import { Context } from "destack:context";
import { Result } from "destack:error";

import { Buffer } from "./buffer.ds";
import { Device } from "./device.ds";
import { ComputeError } from "./error.ds";
import { Event, Stream } from "./stream.ds";
import { WorkgroupCount, WorkgroupSize } from "./workgroup.ds";

/// Format for a compute program source.
export enum ProgramFormat {
    /// TS++ compute function lowered by the toolchain.
    Destack = 1,
    /// WebGPU Shading Language source.
    Wgsl = 2,
    /// SPIR-V binary.
    SpirV = 3,
    /// Metal Shading Language source.
    Msl = 4,
    /// HLSL source.
    Hlsl = 5,
    /// DXIL binary.
    Dxil = 6,
    /// GLSL source.
    Glsl = 7,
}

/// Text compute program source.
export struct ProgramText {
    /// The source variant.
    kind: "text" = "text";

    /// The source format.
    format: ProgramFormat;

    /// The source text.
    source: string;
}

/// Binary compute program source.
export struct ProgramBinary {
    /// The source variant.
    kind: "binary" = "binary";

    /// The source format.
    format: ProgramFormat;

    /// The source bytes.
    bytes: [uint8];
}

/// Compute program source.
@derive(Tagged)
export newtype ProgramSource = ProgramText | ProgramBinary;

/// Compile options for one compute program.
export struct ProgramOptions {
    /// Debug label.
    label?: string;

    /// Entry point names to retain when provided.
    entries?: [string];

    /// Whether to keep backend debug information.
    debug: boolean = false;
}

/// Severity of a compute program diagnostic.
export enum ProgramDiagnosticSeverity {
    /// Informational diagnostic.
    Info = 1,
    /// Warning diagnostic.
    Warning = 2,
    /// Error diagnostic.
    Error = 3,
}

/// Source location for a compute program diagnostic.
export struct ProgramLocation {
    /// Zero-based byte offset.
    offset?: usize;

    /// One-based line number.
    line?: uint32;

    /// One-based column number.
    column?: uint32;

    /// Byte length covered by the diagnostic.
    length?: usize;
}

/// Diagnostic emitted while compiling a compute program.
export struct ProgramDiagnostic {
    /// Diagnostic severity.
    severity: ProgramDiagnosticSeverity;

    /// Human-readable diagnostic message.
    message: string;

    /// Source location when available.
    location?: ProgramLocation;
}

/// Report from compiling a compute program.
export struct ProgramReport {
    /// Compiled program when compilation succeeded.
    program?: Program;

    /// Compiler diagnostics.
    diagnostics: [ProgramDiagnostic];
}

/// Compiled compute code for one device.
@languageItem("compute.Program")
export newtype Program = intrinsic;

export extension of Program {
    /// Return the device that owns this program.
    get device(&readonly this): Device {
        Context.current().compute.program.device(this)
    }

    /// Compile `source` for `device`.
    static compile(
        device: &readonly Device,
        source: ProgramSource,
        options?: ProgramOptions,
    ): Result<Program, ComputeError> {
        Context.current().compute.program.compile(device, source, options)
    }

    /// Compile `source` for `device` and return diagnostics.
    static build(
        device: &readonly Device,
        source: ProgramSource,
        options?: ProgramOptions,
    ): ProgramReport {
        Context.current().compute.program.build(device, source, options)
    }

    /// Return a kernel entry point by name.
    kernel(&readonly this, name: string): Result<Kernel, ComputeError> {
        Context.current().compute.program.kernel(this, name)
    }
}

/// Encoded kernel argument.
@languageItem("compute.KernelArgument")
export newtype KernelArgument = intrinsic;

export extension of KernelArgument {
    /// Encode `value` as one kernel argument.
    static value<T>(value: T): KernelArgument {
        Context.current().compute.program.argumentValue(value)
    }

    /// Encode `buffer` as one kernel argument.
    static buffer<T>(buffer: Buffer<T>): KernelArgument {
        Context.current().compute.program.argumentBuffer(buffer)
    }

    /// Encode raw argument bytes.
    @unsafe
    static bytes(bytes: [uint8]): KernelArgument {
        Context.current().compute.program.argumentBytes(bytes)
    }
}

/// Kernel parameter kind.
export enum KernelParameterKind {
    /// Plain value argument.
    Value = 1,
    /// Buffer argument.
    Buffer = 2,
    /// Tensor argument.
    Tensor = 3,
    /// Shared memory argument.
    WorkgroupMemory = 4,
}

/// Kernel parameter visible through reflection.
export struct KernelParameter {
    /// Parameter name when available.
    name?: string;

    /// Parameter kind.
    kind: KernelParameterKind;

    /// Parameter byte size when statically known.
    byteLength?: usize;

    /// Required byte alignment when known.
    alignment?: usize;
}

/// Kernel entry point metadata.
export struct KernelSignature {
    /// Parameter metadata in call order.
    parameters: [KernelParameter];

    /// Default workgroup size when declared.
    workgroupSize?: WorkgroupSize;
}

/// Callable entry point inside a compute program.
@languageItem("compute.Kernel")
export newtype Kernel = intrinsic;

export extension of Kernel {
    /// Return the program that owns this kernel.
    get program(&readonly this): Program {
        Context.current().compute.program.kernelProgram(this)
    }

    /// Return the kernel entry point name.
    get name(&readonly this): &readonly string {
        Context.current().compute.program.kernelName(this)
    }

    /// Return this kernel's signature metadata.
    signature(&readonly this): KernelSignature {
        Context.current().compute.program.signature(this)
    }

    /// Dispatch this kernel on `stream`.
    dispatch(
        &readonly this,
        arguments: [KernelArgument],
        workgroups: WorkgroupCount,
        workgroupSize?: WorkgroupSize,
        stream?: &Stream,
    ): Event {
        Context.current().compute.program.dispatch(
            this,
            arguments,
            workgroups,
            workgroupSize,
            stream,
        )
    }
}
