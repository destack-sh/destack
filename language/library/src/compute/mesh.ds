import { Slice } from "destack:collections";
import { compute } from "./binding/compute.ds";
import { Device } from "./device.ds";

/// Named axis inside a compute mesh.
export struct MeshAxis {
    /// Human-readable axis name.
    name: string;

    /// Device count along this axis.
    size: usize;
}

/// Multi-device placement topology.
@languageItem("compute.Mesh")
export newtype Mesh = intrinsic;

export extension of Mesh {
    /// Create a mesh from devices and named axes.
    static new(devices: &readonly [Device], axes: &readonly [MeshAxis]): Mesh {
        compute.get().mesh.create(devices, axes)
    }

    /// Return the mesh axes.
    get axes(&readonly this): &readonly [MeshAxis] {
        compute.get().mesh.axes(this)
    }

    /// Return the devices in row-major mesh order.
    get devices(&readonly this): &readonly [Device] {
        compute.get().mesh.devices(this)
    }

    /// Return the number of mesh axes.
    get rank(&readonly this): usize {
        compute.get().mesh.rank(this)
    }

    /// Return the total number of devices.
    get size(&readonly this): usize {
        compute.get().mesh.size(this)
    }
}
