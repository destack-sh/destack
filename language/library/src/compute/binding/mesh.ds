import { Device } from "../device.ds";
import { Mesh, MeshAxis } from "../mesh.ds";

/// Compute mesh binding family.
export interface ComputeMeshBinding {
    /// Create a mesh from devices and named axes.
    @binding("destack.compute.mesh.create", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.mesh.create"],
    })
    create(devices: &readonly [Device], axes: &readonly [MeshAxis]): Mesh;

    /// Return the mesh axes.
    @binding("destack.compute.mesh.axes", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.mesh.read"],
    })
    axes(mesh: Mesh): &readonly [MeshAxis];

    /// Return the devices in row-major mesh order.
    @binding("destack.compute.mesh.devices", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.mesh.read"],
    })
    devices(mesh: Mesh): &readonly [Device];

    /// Return the number of mesh axes.
    @binding("destack.compute.mesh.rank", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.mesh.read"],
    })
    rank(mesh: Mesh): usize;

    /// Return the total number of devices.
    @binding("destack.compute.mesh.size", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.mesh.read"],
    })
    size(mesh: Mesh): usize;
}
