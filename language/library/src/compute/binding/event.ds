import { Event, Stream } from "../stream.ds";

/// Compute event binding family.
export interface ComputeEventBinding {
    /// Return the stream that recorded `event`.
    @binding("destack.compute.event.stream", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.event.read"],
    })
    stream(event: Event): Stream;

    /// Record an event on `stream`.
    @binding("destack.compute.event.record", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.event.record"],
    })
    record(stream: Stream): Event;

    /// Return whether `event` has completed.
    @binding("destack.compute.event.complete", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.event.read"],
    })
    isComplete(event: Event): boolean;

    /// Wait until `event` completes.
    @binding("destack.compute.event.synchronize", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.event.synchronize"],
    })
    synchronize(event: Event): void;

    /// Return milliseconds elapsed from `start` to `end`.
    @binding("destack.compute.event.elapsed", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.event.read"],
    })
    elapsedSince(end: Event, start: Event): float64;
}
