import { Result } from "destack:error";

import { Buffer } from "../buffer.ds";
import { Device } from "../device.ds";
import { ComputeError } from "../error.ds";
import {
    Kernel,
    KernelArgument,
    KernelSignature,
    Program,
    ProgramOptions,
    ProgramReport,
    ProgramSource,
} from "../program.ds";
import { Event, Stream } from "../stream.ds";
import { WorkgroupCount, WorkgroupSize } from "../workgroup.ds";

/// Compute program binding family.
export interface ComputeProgramBinding {
    /// Return the device that owns `program`.
    @binding("destack.compute.program.device", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.program.read"],
    })
    device(program: &readonly Program): Device;

    /// Compile `source` for `device`.
    @binding("destack.compute.program.compile", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.program.compile"],
    })
    compile(
        device: &readonly Device,
        source: ProgramSource,
        options?: ProgramOptions,
    ): Result<Program, ComputeError>;

    /// Compile `source` for `device` and return diagnostics.
    @binding("destack.compute.program.build", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.program.compile"],
    })
    build(device: &readonly Device, source: ProgramSource, options?: ProgramOptions): ProgramReport;

    /// Return a kernel entry point by name.
    @binding("destack.compute.program.kernel", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.program.read"],
    })
    kernel(program: &readonly Program, name: string): Result<Kernel, ComputeError>;

    /// Encode `value` as one kernel argument.
    @binding("destack.compute.kernel.argument.value", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.argument"],
    })
    argumentValue<T>(value: T): KernelArgument;

    /// Encode `buffer` as one kernel argument.
    @binding("destack.compute.kernel.argument.buffer", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.argument"],
    })
    argumentBuffer<T>(buffer: Buffer<T>): KernelArgument;

    /// Encode raw argument bytes.
    @binding("destack.compute.kernel.argument.bytes", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.argument"],
    })
    argumentBytes(bytes: [uint8]): KernelArgument;

    /// Return the program that owns `kernel`.
    @binding("destack.compute.kernel.program", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.read"],
    })
    kernelProgram(kernel: &readonly Kernel): Program;

    /// Return the kernel entry point name.
    @binding("destack.compute.kernel.name", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.read"],
    })
    kernelName(kernel: &readonly Kernel): &readonly string;

    /// Return kernel signature metadata.
    @binding("destack.compute.kernel.signature", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.kernel.read"],
    })
    signature(kernel: &readonly Kernel): KernelSignature;

    /// Dispatch `kernel` on `stream`.
    @binding("destack.compute.kernel.dispatch", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.kernel.dispatch"],
    })
    dispatch(
        kernel: &readonly Kernel,
        arguments: [KernelArgument],
        workgroups: WorkgroupCount,
        workgroupSize?: WorkgroupSize,
        stream?: &Stream,
    ): Event;
}
