import { ResourceId } from "destack:runtime/resource";

/// Handle for one compute device endpoint.
export newtype ComputeDeviceHandle = ResourceId;

/// Handle for one compute stream endpoint.
export newtype ComputeStreamHandle = ResourceId;

/// Handle for one compute event endpoint.
export newtype ComputeEventHandle = ResourceId;

/// Handle for one compute mesh endpoint.
export newtype ComputeMeshHandle = ResourceId;

/// Handle for one compute buffer endpoint.
export newtype ComputeBufferHandle = ResourceId;

/// Handle for one compute program endpoint.
export newtype ComputeProgramHandle = ResourceId;

/// Handle for one compute kernel endpoint.
export newtype ComputeKernelHandle = ResourceId;

/// Handle for one encoded compute kernel argument.
export newtype ComputeKernelArgumentHandle = ResourceId;
