import { Result } from "destack:error";

import { Buffer, BufferCopyRegion, BufferOptions } from "../buffer.ds";
import { Device } from "../device.ds";
import { ComputeError } from "../error.ds";
import { Event, Stream } from "../stream.ds";

/// Compute buffer binding family.
export interface ComputeBufferBinding {
    /// Return the device that owns `buffer`.
    @binding("destack.compute.buffer.device", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.buffer.read"],
    })
    device<T>(buffer: Buffer<T>): Device;

    /// Return the element count.
    @binding("destack.compute.buffer.length", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.buffer.read"],
    })
    length<T>(buffer: Buffer<T>): usize;

    /// Return the byte length.
    @binding("destack.compute.buffer.byteLength", {
        provider: "host",
        effect: "deterministic",
        requires: ["host.compute.buffer.read"],
    })
    byteLength<T>(buffer: Buffer<T>): usize;

    /// Allocate a compute buffer.
    @binding("destack.compute.buffer.allocate", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.allocate"],
    })
    allocate<T>(
        device: Device,
        length: usize,
        options?: BufferOptions,
    ): Result<Buffer<T>, ComputeError>;

    /// Create a buffer initialized from host values.
    @binding("destack.compute.buffer.from", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.allocate", "host.compute.buffer.write"],
    })
    from<T>(device: Device, values: [T], options?: BufferOptions): Result<Buffer<T>, ComputeError>;

    /// Copy bytes between compute buffers.
    @binding("destack.compute.buffer.copy", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.copy"],
    })
    copyTo<T>(
        source: Buffer<T>,
        destination: Buffer<T>,
        region: BufferCopyRegion,
        stream?: Stream,
    ): Event;

    /// Fill one compute buffer.
    @binding("destack.compute.buffer.fill", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.write"],
    })
    fill<T>(buffer: Buffer<T>, value: T, stream?: Stream): Event;

    /// Read a compute buffer into host memory.
    @binding("destack.compute.buffer.read", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.read"],
    })
    read<T>(buffer: Buffer<T>, stream?: Stream): Result<[T], ComputeError>;

    /// Write host values into a compute buffer.
    @binding("destack.compute.buffer.write", {
        provider: "host",
        effect: "external",
        requires: ["host.compute.buffer.write"],
    })
    write<T>(buffer: Buffer<T>, values: [T], stream?: Stream): Event;
}
