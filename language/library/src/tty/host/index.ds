import { TtyPty } from "./pty.ds";
import { TtyTerminal } from "./terminal.ds";
import { TtyTermios } from "./termios.ds";

export * from "./pty.ds";
export * from "./terminal.ds";
export * from "./termios.ds";

/// TTY binding family.
@languageItem("tty.Tty")
export interface Tty {
    /// PTY bindings.
    readonly pty: TtyPty;
    /// Terminal bindings.
    readonly terminal: TtyTerminal;
    /// termios bindings.
    readonly termios: TtyTermios;
}
