import { HostError } from "destack:error/host";
import { FileHandle } from "destack:fs/binding";
import { ResourceId } from "destack:runtime/resource";

/// Handle for a terminal device.
export newtype TtyHandle = ResourceId;

/// Terminal mode snapshot.
export struct TtyMode {
    /// Input mode bit flags.
    inputFlags: uint64;
    /// Output mode bit flags.
    outputFlags: uint64;
    /// Control mode bit flags.
    controlFlags: uint64;
    /// Local mode bit flags.
    localFlags: uint64;
}

/// Terminal size descriptor.
export struct TtySize {
    /// Character rows.
    rows: uint32;
    /// Character columns.
    columns: uint32;
    /// Horizontal pixel size.
    xPixels: uint32;
    /// Vertical pixel size.
    yPixels: uint32;
}

/// Terminal binding family.
export interface TtyTerminalBinding {
    /// Open one standard input terminal handle.
    @binding("destack.tty.standardInput.open", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.open", "host.tty.read"],
        families: ["windows", "unix"],
    })
    openStandardInputTty(): Result<TtyHandle, HostError>;

    /// Open one standard output terminal handle.
    @binding("destack.tty.standardOutput.open", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.open", "host.tty.write"],
        families: ["windows", "unix"],
    })
    openStandardOutputTty(): Result<TtyHandle, HostError>;

    /// Open one standard error terminal handle.
    @binding("destack.tty.standardError.open", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.open", "host.tty.write"],
        families: ["windows", "unix"],
    })
    openStandardErrorTty(): Result<TtyHandle, HostError>;

    /// Close one terminal handle.
    @binding("destack.tty.close", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.close"],
        families: ["windows", "unix"],
    })
    closeTty(tty: TtyHandle): Result<void, HostError>;

    /// Return whether one file handle is attached to a terminal.
    @binding("destack.tty.file.isTerminal", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.status"],
        families: ["windows", "unix"],
    })
    isTerminalFile(handle: FileHandle): Result<boolean, HostError>;

    /// Read bytes from a terminal.
    @binding("destack.tty.read", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.read"],
        families: ["windows", "unix"],
    })
    readTty(tty: TtyHandle, buffer: &[uint8]): Result<uint64, HostError>;

    /// Write bytes to a terminal.
    @binding("destack.tty.write", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.write"],
        families: ["windows", "unix"],
    })
    writeTty(tty: TtyHandle, buffer: &readonly [uint8]): Result<uint64, HostError>;

    /// Read terminal mode flags.
    @binding("destack.tty.mode.read", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.mode"],
        families: ["windows", "unix"],
    })
    readTtyMode(tty: TtyHandle): Result<TtyMode, HostError>;

    /// Apply terminal mode flags.
    @binding("destack.tty.mode.set", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.mode"],
        families: ["windows", "unix"],
    })
    setTtyMode(tty: TtyHandle, mode: &readonly TtyMode): Result<void, HostError>;

    /// Enable or disable raw terminal mode.
    @binding("destack.tty.mode.raw.set", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.mode"],
        families: ["windows", "unix"],
    })
    setRawTtyMode(tty: TtyHandle, enabled: boolean): Result<void, HostError>;

    /// Read terminal size.
    @binding("destack.tty.size.read", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.size"],
        families: ["windows", "unix"],
    })
    readTtySize(tty: TtyHandle): Result<TtySize, HostError>;

    /// Apply terminal size.
    @binding("destack.tty.size.set", {
        provider: "host",
        effect: "external",
        requires: ["host.tty.size"],
        families: ["windows", "unix"],
    })
    setTtySize(tty: TtyHandle, size: &readonly TtySize): Result<void, HostError>;
}
