import { Binding } from "destack:binding";

import { TtyPtyBinding } from "./pty.ds";
import { TtyTerminalBinding } from "./terminal.ds";
import { TtyTermiosBinding } from "./termios.ds";

/// TTY binding family.
@languageItem("tty.TtyBinding")
export interface TtyBinding {
    /// PTY bindings.
    readonly pty: TtyPtyBinding;
    /// Terminal bindings.
    readonly terminal: TtyTerminalBinding;
    /// `termios` bindings.
    readonly termios: TtyTermiosBinding;
}

/// Current TTY binding family.
export const tty: Binding<TtyBinding> = new Binding<TtyBinding>("tty");
