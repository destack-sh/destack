import { HostError } from "destack:error/host";

/// Umask binding family.
export interface ProcessUmaskBinding {
    /// Set process file-creation umask and return the previous value.
    @binding("destack.process.umask", {
        provider: "host",
        effect: "external",
        requires: ["host.process.umask"],
        families: ["unix"],
    })
    umask(mask: uint32): Result<uint32, HostError>;
}
