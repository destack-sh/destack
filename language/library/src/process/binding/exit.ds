import { HostError } from "destack:error/host";

/// Exit binding family.
export interface ProcessExit {
    /// Exit the current process with the given code.
    @binding("destack.process.exit", {
        effect: "external",
        requires: ["host.process.exit"],
        families: ["windows", "unix"],
        simulation: true,
    })
    exit(code: uint32): Result<void, HostError>;
}
