import { HostError } from "destack:error/host";
import { ProcessHandle } from "destack:process/binding";
import { ResourceId } from "destack:runtime/resource";

import { ProcessId } from "./identity.ds";

/// Handle for a signal subscription.
export newtype SignalHandle = ResourceId;

/// Signal number for process control.
export newtype Signal = uint32;

/// Signal event payload delivered by a subscription.
export struct SignalEvent {
    /// Signal number observed by the runtime.
    signal: Signal;
    /// Process id associated with the signal.
    pid?: ProcessId;
}

/// Signal binding family.
export interface ProcessSignalBinding {
    /// Send a signal to a target process.
    @binding("destack.process.signal.send", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.send"],
        families: ["windows", "unix"],
    })
    sendSignal(pid: ProcessId, signal: Signal): Result<void, HostError>;

    /// Send a signal to a target process handle.
    @binding("destack.process.signal.handle", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.send"],
        families: ["windows", "unix"],
    })
    signalProcess(process: ProcessHandle, signal: Signal): Result<void, HostError>;

    /// Subscribe to one signal value.
    @binding("destack.process.signal.subscribe", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    subscribeSignal(signal: Signal): Result<SignalHandle, HostError>;

    /// Remove a signal subscription handle.
    @binding("destack.process.signal.unsubscribe", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    unsubscribeSignal(handle: SignalHandle): Result<void, HostError>;

    /// Receive the next signal event from a subscription.
    @binding("destack.process.signal.receive", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    receiveSignal(handle: SignalHandle): Result<SignalEvent, HostError>;

    /// Poll one signal event without blocking.
    @binding("destack.process.signal.tryReceive", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    tryReceiveSignal(handle: SignalHandle): Result<SignalEvent, HostError>;

    /// Wait for one signal from a requested set.
    @binding("destack.process.signal.wait", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    waitSignal(signals: &readonly [Signal]): Result<SignalEvent, HostError>;

    /// Poll one signal from a requested set without blocking.
    @binding("destack.process.signal.tryWait", {
        provider: "host",
        effect: "external",
        requires: ["host.process.signal.receive"],
        families: ["windows", "unix"],
    })
    tryWaitSignal(signals: &readonly [Signal]): Result<SignalEvent, HostError>;
}
