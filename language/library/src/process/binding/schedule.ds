import { HostError } from "destack:error/host";

import { ProcessId } from "./identity.ds";

/// Process priority value in the host scheduler.
export newtype ProcessPriority = int32;

/// Logical processor index for affinity masks.
export struct Processor {
    /// Processor group on hosts that partition logical processors.
    group: uint16;
    /// Logical processor index within the group.
    index: uint16;
}

/// Logical processors allowed to run one process.
export struct ProcessAffinity {
    /// Logical processors in the affinity mask.
    processors: [Processor];
}

/// Schedule binding family.
export interface ProcessScheduleBinding {
    /// Read one process priority.
    @binding("destack.process.schedule.priority.read", {
        provider: "host",
        effect: "external",
        requires: ["host.process.priority"],
        families: ["windows", "unix"],
    })
    readProcessPriority(process: ProcessId): Result<ProcessPriority, HostError>;

    /// Set one process priority.
    @binding("destack.process.schedule.priority.set", {
        provider: "host",
        effect: "external",
        requires: ["host.process.priority"],
        families: ["windows", "unix"],
    })
    setProcessPriority(process: ProcessId, priority: ProcessPriority): Result<void, HostError>;

    /// Read one process CPU affinity.
    @binding("destack.process.schedule.affinity.read", {
        provider: "host",
        effect: "external",
        requires: ["host.process.affinity"],
        families: ["windows", "unix"],
    })
    readProcessAffinity(process: ProcessId): Result<ProcessAffinity, HostError>;

    /// Set one process CPU affinity.
    @binding("destack.process.schedule.affinity.set", {
        provider: "host",
        effect: "external",
        requires: ["host.process.affinity"],
        families: ["windows", "unix"],
    })
    setProcessAffinity(
        process: ProcessId,
        affinity: &readonly ProcessAffinity,
    ): Result<void, HostError>;
}
