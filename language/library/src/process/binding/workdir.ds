import { HostError } from "destack:error/host";
import { Path } from "destack:fs/binding";

/// Workdir binding family.
export interface ProcessWorkdirBinding {
    /// Return the current working directory.
    @binding("destack.process.workdir.get", {
        provider: "host",
        effect: "external",
        requires: ["host.process.workdir.read"],
        families: ["windows", "unix"],
    })
    getCurrentDirectory(): Result<Path, HostError>;

    /// Change the current working directory.
    @binding("destack.process.workdir.set", {
        provider: "host",
        effect: "external",
        requires: ["host.process.workdir.write"],
        families: ["windows", "unix"],
    })
    setCurrentDirectory(path: &readonly Path): Result<void, HostError>;
}
