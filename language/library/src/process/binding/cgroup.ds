import { HostError } from "destack:error/host";

/// Linux cgroup path.
export newtype CgroupPath = string;

/// Linux cgroup v2 controller.
export enum CgroupController {
    /// CPU controller.
    Cpu = 0,
    /// Memory controller.
    Memory = 1,
    /// I/O controller.
    Io = 2,
    /// Process-count controller.
    Pids = 3,
    /// CPU-set controller.
    Cpuset = 4,
}

/// Cgroup binding family.
export interface ProcessCgroupBinding {
    /// Join one Linux control group.
    @binding("destack.process.cgroup.join", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.process.cgroup.write"],
        platforms: ["linux"],
    })
    joinCgroup(path: &readonly CgroupPath): Result<void, HostError>;

    /// Read one Linux cgroup v2 control file.
    @binding("destack.process.cgroup.read", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.process.cgroup.read"],
        platforms: ["linux"],
    })
    readCgroup(
        path: &readonly CgroupPath,
        controller: CgroupController,
        file: &readonly string,
    ): Result<^string, HostError>;

    /// Write one Linux cgroup v2 control file.
    @binding("destack.process.cgroup.write", {
        provider: "host",
        effect: "external",
        replay: "forbidden",
        requires: ["host.process.cgroup.write"],
        platforms: ["linux"],
    })
    writeCgroup(
        path: &readonly CgroupPath,
        controller: CgroupController,
        file: &readonly string,
        value: &readonly string,
    ): Result<void, HostError>;
}
