import { Binding } from "destack:binding";

import { ProcessArgumentBinding } from "./argument.ds";
import { ProcessCgroupBinding } from "./cgroup.ds";
import { ProcessEnvironmentBinding } from "./environment.ds";
import { ProcessExecBinding } from "./exec.ds";
import { ProcessExitBinding } from "./exit.ds";
import { ProcessHandleBinding } from "./handle.ds";
import { ProcessIdentityBinding } from "./identity.ds";
import { ProcessIsolationBinding } from "./isolation.ds";
import { ProcessJobBinding } from "./job.ds";
import { ProcessLimitBinding } from "./limit.ds";
import { ProcessScheduleBinding } from "./schedule.ds";
import { ProcessSessionBinding } from "./session.ds";
import { ProcessSignalBinding } from "./signal.ds";
import { ProcessSpawnBinding } from "./spawn.ds";
import { ProcessStdioBinding } from "./stdio.ds";
import { ProcessUmaskBinding } from "./umask.ds";
import { ProcessWaitBinding } from "./wait.ds";
import { ProcessWorkdirBinding } from "./workdir.ds";

/// Process binding family.
@languageItem("process.ProcessBinding")
export interface ProcessBinding {
    /// Argument bindings.
    readonly argument: ProcessArgumentBinding;
    /// Cgroup bindings.
    readonly cgroup: ProcessCgroupBinding;
    /// Environment bindings.
    readonly environment: ProcessEnvironmentBinding;
    /// Exec bindings.
    readonly exec: ProcessExecBinding;
    /// Exit bindings.
    readonly exit: ProcessExitBinding;
    /// Handle bindings.
    readonly handle: ProcessHandleBinding;
    /// Identity bindings.
    readonly identity: ProcessIdentityBinding;
    /// Isolation bindings.
    readonly isolation: ProcessIsolationBinding;
    /// Job bindings.
    readonly job: ProcessJobBinding;
    /// Limit bindings.
    readonly limit: ProcessLimitBinding;
    /// Schedule bindings.
    readonly schedule: ProcessScheduleBinding;
    /// Session bindings.
    readonly session: ProcessSessionBinding;
    /// Signal bindings.
    readonly signal: ProcessSignalBinding;
    /// Spawn bindings.
    readonly spawn: ProcessSpawnBinding;
    /// Stdio bindings.
    readonly stdio: ProcessStdioBinding;
    /// Umask bindings.
    readonly umask: ProcessUmaskBinding;
    /// Wait bindings.
    readonly wait: ProcessWaitBinding;
    /// Workdir bindings.
    readonly workdir: ProcessWorkdirBinding;
}

/// Current process binding family.
export const process = new Binding<ProcessBinding>("process");
