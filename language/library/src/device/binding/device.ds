import { Binding } from "destack:binding";

import { DeviceBluetoothBinding } from "./bluetooth.ds";
import { DeviceCameraBinding } from "./camera.ds";
import { DeviceHidBinding } from "./hid.ds";
import { DeviceMidiBinding } from "./midi.ds";
import { DeviceSerialBinding } from "./serial.ds";
import { DeviceUsbBinding } from "./usb.ds";

/// Device binding family.
@languageItem("device.DeviceBinding")
export interface DeviceBinding {
    /// Bluetooth bindings.
    readonly bluetooth: DeviceBluetoothBinding;
    /// Camera bindings.
    readonly camera: DeviceCameraBinding;
    /// Hid bindings.
    readonly hid: DeviceHidBinding;
    /// Midi bindings.
    readonly midi: DeviceMidiBinding;
    /// Serial bindings.
    readonly serial: DeviceSerialBinding;
    /// Usb bindings.
    readonly usb: DeviceUsbBinding;
}

/// Current device binding family.
export const device: Binding<DeviceBinding> = new Binding<DeviceBinding>("device");
