import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { ResourceId } from "destack:runtime/resource";

/// Handle for one camera device endpoint.
export newtype CameraDeviceHandle = ResourceId;

/// Handle for one camera watch stream.
export newtype CameraWatchHandle = ResourceId;

/// Handle for one camera stream endpoint.
export newtype CameraStreamHandle = ResourceId;

/// Camera facing mode.
export enum CameraFacing {
    /// Host did not classify the facing mode.
    Unknown = 0,
    /// User-facing camera.
    User = 1,
    /// Environment-facing camera.
    Environment = 2,
    /// External or detached camera.
    External = 3,
}

/// Camera pixel format.
export enum CameraPixelFormat {
    /// Packed 8-bit BGRA.
    Bgra8 = 1,
    /// Packed 8-bit RGBA.
    Rgba8 = 2,
    /// Packed 8-bit NV12.
    Nv12 = 3,
    /// Planar YUV 4:2:0.
    Yuv420 = 4,
    /// JPEG encoded frame bytes.
    Jpeg = 5,
}

/// Camera color space.
export enum CameraColorSpace {
    /// Host did not report color-space information.
    Unknown = 0,
    /// sRGB color space.
    Srgb = 1,
    /// ITU-R BT.601 color space.
    Bt601 = 2,
    /// ITU-R BT.709 color space.
    Bt709 = 3,
    /// ITU-R BT.2020 color space.
    Bt2020 = 4,
}

/// Camera dynamic-range mode.
export enum CameraDynamicRange {
    /// Standard dynamic range.
    Standard = 1,
    /// HDR10 dynamic range.
    Hdr10 = 2,
    /// Hybrid log-gamma dynamic range.
    Hlg = 3,
}

/// Camera control identifier.
export enum CameraControl {
    /// Exposure compensation control.
    ExposureCompensation = 1,
    /// Exposure time control in nanoseconds.
    ExposureTimeNs = 2,
    /// Sensor ISO control.
    SensorIso = 3,
    /// White-balance temperature control in kelvin.
    WhiteBalanceKelvin = 4,
    /// Focus distance control in diopters.
    FocusDistanceDiopters = 5,
    /// Zoom ratio control.
    ZoomRatio = 6,
    /// Pan angle control in degrees.
    PanDegrees = 7,
    /// Tilt angle control in degrees.
    TiltDegrees = 8,
    /// Torch control.
    Torch = 9,
}

/// Camera control mode.
export enum CameraControlMode {
    /// Control is disabled.
    Off = 0,
    /// Host automatic control.
    Auto = 1,
    /// Continuous host automatic control.
    ContinuousAuto = 2,
    /// Manual control.
    Manual = 3,
    /// Control is enabled.
    On = 4,
}

/// Camera control mode flags.
export newtype CameraControlModeFlags = uint32;

/// Camera control supports the off mode.
export const CAMERA_CONTROL_MODE_OFF: CameraControlModeFlags = CameraControlModeFlags(0x01);

/// Camera control supports automatic mode.
export const CAMERA_CONTROL_MODE_AUTO: CameraControlModeFlags = CameraControlModeFlags(0x02);

/// Camera control supports continuous automatic mode.
export const CAMERA_CONTROL_MODE_CONTINUOUS_AUTO: CameraControlModeFlags =
    CameraControlModeFlags(0x04);

/// Camera control supports manual mode.
export const CAMERA_CONTROL_MODE_MANUAL: CameraControlModeFlags = CameraControlModeFlags(0x08);

/// Camera control supports the on mode.
export const CAMERA_CONTROL_MODE_ON: CameraControlModeFlags = CameraControlModeFlags(0x10);

/// Camera device.
export struct CameraDevice {
    /// Stable camera identifier.
    id: string;
    /// Shared physical-device group identifier when available.
    groupId?: string;
    /// Host-visible camera name.
    name: string;
    /// Host-visible manufacturer string when available.
    manufacturer?: string;
    /// Host-reported facing mode.
    facing: CameraFacing;
    /// Whether the camera can provide depth frames.
    isDepthCapable: boolean;
}

/// Camera stream format.
export struct CameraFormat {
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame rate in milli-frames per second.
    frameRateMilliHz: uint32;
    /// Pixel format.
    pixelFormat: CameraPixelFormat;
    /// Color space.
    colorSpace: CameraColorSpace;
    /// Dynamic-range mode.
    dynamicRange: CameraDynamicRange;
}

/// Camera stream open options.
export struct CameraStreamOptions {
    /// Requested stream format.
    format: CameraFormat;
    /// Preferred host buffer count, or zero for backend default.
    bufferCount: uint32;
}

/// Camera frame plane.
export struct CameraPlane {
    /// Plane byte offset in the output buffer.
    offsetBytes: uint32;
    /// Plane byte length in the output buffer.
    byteCount: uint32;
    /// Plane row stride in bytes.
    rowStrideBytes: uint32;
    /// Plane pixel stride in bytes.
    pixelStrideBytes: uint32;
}

/// Camera frame result.
export struct CameraFrame {
    /// Frame timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Frame format.
    format: CameraFormat;
    /// Payload bytes written.
    bytes: uint64;
    /// Plane entries written.
    planes: uint32;
}

/// Camera control capability.
export struct CameraControlCapability {
    /// Control identifier.
    control: CameraControl;
    /// Supported control mode flags.
    modes: CameraControlModeFlags;
    /// Minimum numeric value.
    minimum: float64;
    /// Maximum numeric value.
    maximum: float64;
    /// Default numeric value.
    defaultValue: float64;
    /// Step size, zero for continuous controls.
    step: float64;
}

/// Camera control value.
export struct CameraControlValue {
    /// Control identifier.
    control: CameraControl;
    /// Control mode.
    mode: CameraControlMode;
    /// Numeric value when applicable.
    value: float64;
}

/// Camera attached watch event.
export struct CameraWatchEventAttached {
    /// Event discriminator.
    kind: "attached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Camera device.
    camera: CameraDevice;
}

/// Camera detached watch event.
export struct CameraWatchEventDetached {
    /// Event discriminator.
    kind: "detached";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Camera device.
    camera: CameraDevice;
}

/// Camera changed watch event.
export struct CameraWatchEventChanged {
    /// Event discriminator.
    kind: "changed";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Camera device.
    camera: CameraDevice;
}

/// Camera overflow watch event.
export struct CameraWatchEventOverflow {
    /// Event discriminator.
    kind: "overflow";
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number.
    sequence: uint64;
    /// Number of dropped events.
    droppedCount: uint64;
}

/// Camera topology event.
@derive(Tagged)
export newtype CameraWatchEvent =
    | CameraWatchEventAttached
    | CameraWatchEventDetached
    | CameraWatchEventChanged
    | CameraWatchEventOverflow;

/// Camera binding family.
export interface DeviceCamera {
    /// List camera devices.
    @binding("destack.device.camera.list", {
        effect: "external",
        requires: ["host.device.camera.list"],
        families: ["windows", "unix"],
        simulation: true,
    })
    listCameraDevices(): Result<Array<CameraDevice>, HostError>;

    /// Open a camera topology watch.
    @binding("destack.device.camera.watch.open", {
        effect: "external",
        requires: ["host.device.camera.list"],
        families: ["windows", "unix"],
        simulation: true,
    })
    openCameraWatch(): Result<CameraWatchHandle, HostError>;

    /// Close a camera topology watch.
    @binding("destack.device.camera.watch.close", {
        effect: "external",
        requires: ["host.device.camera.list"],
        families: ["windows", "unix"],
        simulation: true,
    })
    closeCameraWatch(watch: CameraWatchHandle): Result<void, HostError>;

    /// Read one camera topology event.
    @binding("destack.device.camera.watch.read", {
        effect: "external",
        requires: ["host.device.camera.list"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readCameraWatch(
        watch: CameraWatchHandle,
        timeoutNs?: uint64,
    ): Result<CameraWatchEvent, HostError>;

    /// Open a camera device.
    @binding("destack.device.camera.open", {
        effect: "external",
        requires: ["host.device.camera.open"],
        families: ["windows", "unix"],
        simulation: true,
    })
    openCameraDevice(id: &readonly string): Result<CameraDeviceHandle, HostError>;

    /// Close a camera device.
    @binding("destack.device.camera.close", {
        effect: "external",
        requires: ["host.device.camera.open"],
        families: ["windows", "unix"],
        simulation: true,
    })
    closeCameraDevice(camera: CameraDeviceHandle): Result<void, HostError>;

    /// Describe a camera device.
    @binding("destack.device.camera.describe", {
        effect: "external",
        requires: ["host.device.camera.open"],
        families: ["windows", "unix"],
        simulation: true,
    })
    describeCameraDevice(camera: CameraDeviceHandle): Result<CameraDevice, HostError>;

    /// List camera stream formats.
    @binding("destack.device.camera.format.list", {
        effect: "external",
        requires: ["host.device.camera.open"],
        families: ["windows", "unix"],
        simulation: true,
    })
    listCameraFormats(camera: CameraDeviceHandle): Result<Array<CameraFormat>, HostError>;

    /// Open a camera stream.
    @binding("destack.device.camera.stream.open", {
        effect: "external",
        requires: ["host.device.camera.capture"],
        families: ["windows", "unix"],
        simulation: true,
    })
    openCameraStream(
        camera: CameraDeviceHandle,
        options: &readonly CameraStreamOptions,
    ): Result<CameraStreamHandle, HostError>;

    /// Close a camera stream.
    @binding("destack.device.camera.stream.close", {
        effect: "external",
        requires: ["host.device.camera.capture"],
        families: ["windows", "unix"],
        simulation: true,
    })
    closeCameraStream(stream: CameraStreamHandle): Result<void, HostError>;

    /// Start camera stream capture.
    @binding("destack.device.camera.stream.start", {
        effect: "external",
        requires: ["host.device.camera.capture"],
        families: ["windows", "unix"],
        simulation: true,
    })
    startCameraStream(stream: CameraStreamHandle): Result<void, HostError>;

    /// Stop camera stream capture.
    @binding("destack.device.camera.stream.stop", {
        effect: "external",
        requires: ["host.device.camera.capture"],
        families: ["windows", "unix"],
        simulation: true,
    })
    stopCameraStream(stream: CameraStreamHandle): Result<void, HostError>;

    /// Read one camera frame.
    @binding("destack.device.camera.frame.read", {
        effect: "external",
        requires: ["host.device.camera.capture"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readCameraFrame(
        stream: CameraStreamHandle,
        buffer: &[uint8],
        planes: &[CameraPlane],
        timeoutNs?: uint64,
    ): Result<CameraFrame, HostError>;

    /// List camera control capabilities.
    @binding("destack.device.camera.control.list", {
        effect: "external",
        requires: ["host.device.camera.configure"],
        families: ["windows", "unix"],
        simulation: true,
    })
    listCameraControls(
        stream: CameraStreamHandle,
    ): Result<Array<CameraControlCapability>, HostError>;

    /// Read camera control values.
    @binding("destack.device.camera.control.get", {
        effect: "external",
        requires: ["host.device.camera.configure"],
        families: ["windows", "unix"],
        simulation: true,
    })
    getCameraControls(
        stream: CameraStreamHandle,
        controls: &readonly [CameraControl],
        values: &[CameraControlValue],
    ): Result<uint32, HostError>;

    /// Update camera control values.
    @binding("destack.device.camera.control.set", {
        effect: "external",
        requires: ["host.device.camera.configure"],
        families: ["windows", "unix"],
        simulation: true,
    })
    setCameraControls(
        stream: CameraStreamHandle,
        controls: &readonly [CameraControlValue],
    ): Result<void, HostError>;
}
