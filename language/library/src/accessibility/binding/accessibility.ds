import { Binding } from "destack:binding";

import { AccessibilityActionBinding } from "./action.ds";
import { AccessibilityNotificationBinding } from "./notification.ds";
import { AccessibilityTextBinding } from "./text.ds";
import { AccessibilityTreeBinding } from "./tree.ds";

/// Accessibility binding family.
@languageItem("accessibility.AccessibilityBinding")
export interface AccessibilityBinding {
    /// Action bindings.
    readonly action: AccessibilityActionBinding;
    /// Notification bindings.
    readonly notification: AccessibilityNotificationBinding;
    /// Text bindings.
    readonly text: AccessibilityTextBinding;
    /// Tree bindings.
    readonly tree: AccessibilityTreeBinding;
}

/// Current accessibility binding family.
export const accessibility: Binding<AccessibilityBinding> = new Binding<AccessibilityBinding>(
    "accessibility",
);
