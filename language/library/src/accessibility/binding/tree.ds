import { WindowHandle } from "destack:display/binding";
import { HostError } from "destack:error/host";

import { AccessibilityNode, AccessibilityNodeId } from "./node.ds";

/// Monotonic accessibility tree version.
export newtype AccessibilityTreeRevision = uint64;

/// Accessibility tree update.
export struct AccessibilityTreeUpdate {
    /// Monotonic tree revision.
    revision: AccessibilityTreeRevision;
    /// Root node identifier.
    rootNodeId: AccessibilityNodeId;
    /// Focused node identifier, or the root when nothing else is focused.
    focusedNodeId: AccessibilityNodeId;
    /// Added or replaced node descriptors.
    /// Each node replaces the previous descriptor for the same identifier.
    nodes: [AccessibilityNode];
    /// Removed node identifiers.
    removedNodeIds: [AccessibilityNodeId];
}

/// Tree binding family.
export interface AccessibilityTree {
    /// Apply one accessibility tree update.
    @binding("destack.accessibility.tree.apply", {
        effect: "external",
        requires: ["host.accessibility.tree"],
        families: ["windows", "unix"],
        simulation: true,
        affinity: "worker",
    })
    applyAccessibilityTree(
        window: WindowHandle,
        update: &readonly AccessibilityTreeUpdate,
    ): Result<void, HostError>;

    /// Clear the published accessibility tree.
    @binding("destack.accessibility.tree.clear", {
        effect: "external",
        requires: ["host.accessibility.tree"],
        families: ["windows", "unix"],
        simulation: true,
        affinity: "worker",
    })
    clearAccessibilityTree(window: WindowHandle): Result<void, HostError>;

    /// Resolve one accessibility node at one point.
    @binding("destack.accessibility.tree.hitTest", {
        effect: "external",
        requires: ["host.accessibility.tree"],
        families: ["windows", "unix"],
        simulation: true,
        affinity: "worker",
    })
    hitTestAccessibilityTree(
        window: WindowHandle,
        x: float64,
        y: float64,
    ): Result<AccessibilityNodeId | undefined, HostError>;
}
