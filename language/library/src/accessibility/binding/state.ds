/// Tri-state value for `aria-checked` and `aria-pressed`.
export enum AccessibilityTristate {
    /// `false`.
    False = 1,
    /// `true`.
    True = 2,
    /// `mixed`.
    Mixed = 3,
}

/// `aria-current` selector.
export enum AccessibilityCurrentKind {
    /// `true`.
    True = 1,
    /// `page`.
    Page = 2,
    /// `step`.
    Step = 3,
    /// `location`.
    Location = 4,
    /// `date`.
    Date = 5,
    /// `time`.
    Time = 6,
}

/// `aria-invalid` selector.
export enum AccessibilityInvalidKind {
    /// `true`.
    True = 1,
    /// `grammar`.
    Grammar = 2,
    /// `spelling`.
    Spelling = 3,
}

/// `aria-autocomplete` selector.
export enum AccessibilityAutoComplete {
    /// `inline`.
    Inline = 1,
    /// `list`.
    List = 2,
    /// `both`.
    Both = 3,
}

/// `aria-haspopup` selector.
export enum AccessibilityHasPopup {
    /// `menu` or `true`.
    Menu = 1,
    /// `listbox`.
    ListBox = 2,
    /// `tree`.
    Tree = 3,
    /// `grid`.
    Grid = 4,
    /// `dialog`.
    Dialog = 5,
}

/// `aria-orientation` selector.
export enum AccessibilityOrientation {
    /// `horizontal`.
    Horizontal = 1,
    /// `vertical`.
    Vertical = 2,
}

/// `aria-live` politeness selector.
export enum AccessibilityLiveRegionPoliteness {
    /// `off`.
    Off = 1,
    /// `polite`.
    Polite = 2,
    /// `assertive`.
    Assertive = 3,
}

/// `aria-sort` selector.
export enum AccessibilitySortDirection {
    /// `ascending`.
    Ascending = 1,
    /// `descending`.
    Descending = 2,
    /// `other`.
    Other = 3,
}

/// Expanded state selector.
export enum AccessibilityExpandedState {
    /// Collapsed.
    Collapsed = 1,
    /// Expanded.
    Expanded = 2,
    /// Partially expanded.
    Partial = 3,
}

/// `aria-relevant` flags.
export newtype AccessibilityRelevantFlags = uint32;

/// No `aria-relevant` tokens.
export const ACCESSIBILITY_RELEVANT_NONE: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x0);

/// `additions`.
export const ACCESSIBILITY_RELEVANT_ADDITIONS: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x1);

/// `removals`.
export const ACCESSIBILITY_RELEVANT_REMOVALS: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x2);

/// `text`.
export const ACCESSIBILITY_RELEVANT_TEXT: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x4);

/// `all`.
export const ACCESSIBILITY_RELEVANT_ALL: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x7);

/// Boolean accessibility state flags.
export newtype AccessibilityStateFlags = uint32;

/// No boolean accessibility states.
export const ACCESSIBILITY_STATE_NONE: AccessibilityStateFlags = AccessibilityStateFlags(0x0);

/// `aria-atomic`.
export const ACCESSIBILITY_STATE_ATOMIC: AccessibilityStateFlags = AccessibilityStateFlags(0x1);

/// `aria-busy`.
export const ACCESSIBILITY_STATE_BUSY: AccessibilityStateFlags = AccessibilityStateFlags(0x2);

/// `aria-disabled`.
export const ACCESSIBILITY_STATE_DISABLED: AccessibilityStateFlags = AccessibilityStateFlags(0x4);

/// Hidden from the accessibility tree.
export const ACCESSIBILITY_STATE_HIDDEN: AccessibilityStateFlags = AccessibilityStateFlags(0x8);

/// Able to receive accessibility focus.
export const ACCESSIBILITY_STATE_FOCUSABLE: AccessibilityStateFlags = AccessibilityStateFlags(0x10);

/// Currently owns accessibility focus.
export const ACCESSIBILITY_STATE_FOCUSED: AccessibilityStateFlags = AccessibilityStateFlags(0x20);

/// `aria-modal`.
export const ACCESSIBILITY_STATE_MODAL: AccessibilityStateFlags = AccessibilityStateFlags(0x40);

/// Accepts editable text input.
export const ACCESSIBILITY_STATE_EDITABLE: AccessibilityStateFlags = AccessibilityStateFlags(0x80);

/// `aria-readonly`.
export const ACCESSIBILITY_STATE_READ_ONLY: AccessibilityStateFlags =
    AccessibilityStateFlags(0x100);

/// `aria-required`.
export const ACCESSIBILITY_STATE_REQUIRED: AccessibilityStateFlags = AccessibilityStateFlags(0x200);

/// Visited link target.
export const ACCESSIBILITY_STATE_VISITED: AccessibilityStateFlags = AccessibilityStateFlags(0x400);

/// Numeric range value for widgets such as sliders, meters, and spin buttons.
export struct AccessibilityRangeValue {
    /// `aria-valuemin`.
    min?: float64;
    /// `aria-valuemax`.
    max?: float64;
    /// `aria-valuenow`.
    now?: float64;
    /// `aria-valuetext`.
    text?: string;
}

/// Grid or list state for collection widgets.
export struct AccessibilityCollection {
    /// `aria-rowcount`.
    rowCount?: int32;
    /// `aria-colcount`.
    columnCount?: int32;
    /// Whether the collection supports multiple selection.
    isMultiselectable: boolean;
    /// Whether the collection requires at least one selected item.
    isSelectionRequired: boolean;
}

/// Grid or list item state for collection members.
export struct AccessibilityCollectionItem {
    /// `aria-level`.
    level?: uint32;
    /// `aria-posinset`.
    positionInSet?: uint32;
    /// `aria-setsize`.
    setSize?: uint32;
    /// `aria-rowindex`.
    rowIndex?: uint32;
    /// `aria-colindex`.
    columnIndex?: uint32;
    /// `aria-rowspan`.
    rowSpan?: uint32;
    /// `aria-colspan`.
    columnSpan?: uint32;
}

/// Scroll state for one scrollable accessibility node.
export struct AccessibilityScrollState {
    /// Whether the node is currently scrollable.
    isScrollable: boolean;
    /// Horizontal scroll offset when available.
    x?: float64;
    /// Vertical scroll offset when available.
    y?: float64;
    /// Horizontal scroll range maximum when available.
    maxX?: float64;
    /// Vertical scroll range maximum when available.
    maxY?: float64;
    /// Horizontal viewport size when available.
    viewportWidth?: float64;
    /// Vertical viewport size when available.
    viewportHeight?: float64;
}

/// Shared node state derived from ARIA and platform accessibility properties.
export struct AccessibilityNodeState {
    /// Boolean accessibility states.
    flags: AccessibilityStateFlags;
    /// `aria-checked`.
    checked?: AccessibilityTristate;
    /// `aria-pressed`.
    pressed?: AccessibilityTristate;
    /// `aria-current`.
    current?: AccessibilityCurrentKind;
    /// `aria-invalid`.
    invalid?: AccessibilityInvalidKind;
    /// `aria-autocomplete`.
    autoComplete?: AccessibilityAutoComplete;
    /// `aria-haspopup`.
    hasPopup?: AccessibilityHasPopup;
    /// `aria-orientation`.
    orientation?: AccessibilityOrientation;
    /// `aria-live`.
    live?: AccessibilityLiveRegionPoliteness;
    /// `aria-relevant`.
    relevant: AccessibilityRelevantFlags;
    /// `aria-sort`.
    sort?: AccessibilitySortDirection;
    /// `aria-level`.
    level?: uint32;
    /// `aria-valuetext`.
    valueText?: string;
    /// `aria-valuenow`, `aria-valuemin`, and `aria-valuemax`.
    rangeValue?: AccessibilityRangeValue;
    /// Collection metadata for containers such as grids and lists.
    collection?: AccessibilityCollection;
    /// Collection metadata for collection members.
    collectionItem?: AccessibilityCollectionItem;
    /// Scroll metadata for scrollable nodes.
    scroll?: AccessibilityScrollState;
    /// Expanded state.
    expanded?: AccessibilityExpandedState;
    /// `aria-selected`.
    isSelected?: boolean;
}
