import { AccessibilityAction } from "./action.ds";
import { AccessibilityNotification } from "./notification.ds";
import { AccessibilityText } from "./text.ds";
import { AccessibilityTree } from "./tree.ds";

/// Accessibility binding family.
@languageItem("accessibility.Accessibility")
export interface Accessibility {
    /// Action bindings.
    readonly action: AccessibilityAction;
    /// Notification bindings.
    readonly notification: AccessibilityNotification;
    /// Text bindings.
    readonly text: AccessibilityText;
    /// Tree bindings.
    readonly tree: AccessibilityTree;
}
