import { Copy } from "destack:memory";

/// Cooperative execution on the current Worker.
@languageItem("async.Fiber")
export struct Fiber implements Copy, !SharedSafe {
    /// Opaque fiber identity.
    private readonly handle: uint64;

    /// Return the currently executing fiber.
    static current(): Fiber {
        return currentFiber();
    }

    /// Create one suspended fiber.
    static create(body: ^Function<(), void, "once">): Fiber {
        return createFiber(body);
    }

    /// Park the current fiber until it is woken.
    static park(): void {
        parkFiber();
    }

    /// Queue this fiber for execution, retaining the wake until its next park.
    wake(this): void {
        wakeFiber(this);
    }

    /// Resume this fiber until it yields or returns.
    resume(this): void {
        resumeFiber(this);
    }

    /// Yield execution to the fiber that resumed this one.
    static yield(): void {
        yieldFiber();
    }

    /// Request cancellation at this fiber's next park.
    cancel(this): void {
        cancelFiber(this);
    }

    /// Queue one thunk to run on a fresh fiber.
    static spawn(body: ^Function<(), void, "once">): Fiber {
        let fiber = Fiber.create(body);

        fiber.wake();

        return fiber;
    }
}

/// Return the currently executing fiber.
@binding("destack.fiber.current", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
declare function currentFiber(): Fiber;

/// Create one suspended fiber.
@languageItem("async.Fiber.create")
@binding("destack.fiber.create", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
declare function createFiber(body: ^Function<(), void, "once">): Fiber;

/// Park the current fiber until it is woken.
@binding("destack.fiber.park", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
    park: true,
})
declare function parkFiber(): void;

/// Queue one fiber for execution, retaining the wake until its next park.
@binding("destack.fiber.wake", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
declare function wakeFiber(fiber: Fiber): void;

/// Resume one fiber until it yields or returns.
@languageItem("async.Fiber.resume")
@binding("destack.fiber.resume", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
declare function resumeFiber(fiber: Fiber): void;

/// Yield execution to the fiber that resumed this one.
@binding("destack.fiber.yield", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
    park: true,
})
declare function yieldFiber(): void;

/// Request cancellation at one fiber's next park.
@binding("destack.fiber.cancel", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
declare function cancelFiber(fiber: Fiber): void;
