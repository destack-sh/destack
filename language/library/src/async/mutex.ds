import { todo } from "destack:error";
import { Access, Borrowed, Copy, Default, Dispose, Region } from "destack:memory";
import { Dereference } from "destack:ops";

import { Task } from "./task.ds";

/// Asynchronous mutual exclusion lock.
@languageItem("async.AsyncMutex")
export local class AsyncMutex<T> {
    /// The protected value.
    private value: T;

    /// Create an async mutex protecting `value`.
    constructor(value: T) {
        this.value = value;
    }

    /// Lock this mutex by suspending the current task.
    lock<'a>(&'a readonly this): Task<AsyncMutexGuard<'a, T>> {
        todo("AsyncMutex.lock")
    }

    /// Try to lock this mutex without suspending.
    tryLock<'a>(&'a readonly this): AsyncMutexGuard<'a, T> | undefined {
        todo("AsyncMutex.tryLock")
    }

    /// Borrow the protected value without locking.
    getExclusive(&exclusive this): &exclusive T {
        todo("AsyncMutex.getExclusive")
    }

    /// Consume this mutex and return the protected value.
    intoInner(^this): T {
        todo("AsyncMutex.intoInner")
    }
}

export extension<T: Default> of AsyncMutex<T> implements Default {
    /// Create the default async mutex.
    static default(): ^AsyncMutex<T> {
        new AsyncMutex(T.default())
    }
}

/// Active async mutex guard.
export local struct AsyncMutexGuard<'a, T> {
    /// The locked mutex.
    private mutex: &'a readonly AsyncMutex<T>;
}

export extension<'a, T> of AsyncMutexGuard<'a, T>
    implements Dispose, !Copy, Dereference<"exclusive">
{
    /// The pointee type.
    type Target = T;

    /// Unlock this guard.
    dispose(this): void {
        todo("AsyncMutexGuard.dispose");
    }

    /// Borrow the protected value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "exclusive">,
    ): Borrowed<this.Target, R, "exclusive"> {
        todo("AsyncMutexGuard.dereference")
    }
}

export extension<'a, T> of AsyncMutexGuard<'a, T> implements Dereference<"readonly"> {
    /// The pointee type.
    type Target = T;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the protected value with readonly access.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("AsyncMutexGuard.dereference")
    }
}
