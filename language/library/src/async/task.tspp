import { todo, trap } from "tspp:error";
import { AsyncDispose, Cell, Copy, Dispose } from "tspp:memory";

import { Awaitable } from "./awaitable.tspp";
import { Fiber } from "./fiber.tspp";
import { Promise } from "./promise.tspp";

/// Single-consumer asynchronous result.
@languageItem("async.Task")
export struct Task<T> implements Awaitable<T>, Dispose, !Copy, !SharedSafe {
    /// Shared task state.
    private readonly state: TaskState<T>;

    /// Create an already completed task.
    static resolve<T>(value: T): Task<T> {
        let start = Task.open<T>();
        start.producer.complete(value);

        return start.task;
    }

    /// Run one body on a fresh fiber and expose its result.
    @languageItem("async.Task.create")
    static spawn<T>(body: ^Function<(), T, "once">): Task<T> {
        let start = Task.open<T>();
        let producer = start.producer;

        @capture("move")
        let run: ^Function<(), void, "once"> = () => {
            producer.attach();
            producer.complete(body());
        };
        Fiber.spawn(run);

        return start.task;
    }

    /// Open one task and its producer.
    private static open<T>(): TaskStart<T> {
        let state = new TaskState<T>();

        return TaskStart {
            task: Task { state },
            producer: TaskProducer { state },
        };
    }

    /// Park until this task completes, then move its result out.
    private static park<T>(task: Task<T>): T {
        task.state.wait(Fiber.current());
        Fiber.park();

        return task.state.take();
    }

    /// Request cancellation at the producer's next park.
    cancel(&readonly this): void {
        this.state.cancel();
    }

    /// Request producer cancellation when this task is disposed.
    dispose(this): void {
        this.state.cancel();
    }
}

/// Producer retained by one lowered async body.
struct TaskProducer<T> implements Dispose, !Copy, !SharedSafe {
    /// Shared task state.
    private readonly state: TaskState<T>;

    /// Attach the current producer fiber.
    @languageItem("async.Task.attach")
    attach(&readonly this): void {
        this.state.attach(Fiber.current());
    }

    /// Complete this task with one result.
    @languageItem("async.Task.complete")
    complete(this, value: T): void {
        this.state.complete(value);
    }

    /// Complete this task through cancellation after cleanup.
    dispose(this): void {
        this.state.completeCancellation();
    }
}

/// Task and producer returned to lowered async entry code.
struct TaskStart<T> implements !SharedSafe {
    /// The consumer returned by the async function.
    task: Task<T>;

    /// The producer bound into the task body.
    producer: TaskProducer<T>;
}

/// Shared state between one task and its producer.
class TaskState<T> {
    /// Current task phase.
    private readonly phase: Cell<TaskPhase<T>>;

    /// Create pending task state.
    constructor() {
        this.phase = Cell.new(TaskPending {
            kind: "pending",
            producer: undefined,
            waiter: undefined,
            isCancelled: false,
        });
    }

    /// Attach the current producer fiber.
    attach(&readonly this, producer: Fiber): void {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskPending { waiter, isCancelled } => {
                this.phase.set(TaskPending {
                    kind: "pending",
                    producer,
                    waiter,
                    isCancelled,
                });
                if (isCancelled) {
                    producer.cancel();
                }
            }
            phase => {
                this.phase.set(phase);
                trap("task producer attached after settlement")
            }
        }
    }

    /// Register one consumer or queue its completed continuation.
    wait(&readonly this, waiter: Fiber): void {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskPending { producer, waiter: undefined, isCancelled } => {
                this.phase.set(TaskPending {
                    kind: "pending",
                    producer,
                    waiter,
                    isCancelled,
                });
            }
            TaskDone { value } => {
                this.phase.set(TaskDone { kind: "done", value });
                queueMicrotask(() => {
                    waiter.wake();
                });
            }
            TaskCancelled {} => {
                this.phase.set(TaskCancelled { kind: "cancelled" });
                queueMicrotask(() => {
                    waiter.cancel();
                });
            }
            TaskPending {} => trap("task already has a consumer")
            TaskTaken {} => trap("task result was already consumed")
        }
    }

    /// Request cancellation at the producer's next park.
    cancel(&readonly this): void {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskPending { producer, waiter } => {
                this.phase.set(TaskPending {
                    kind: "pending",
                    producer,
                    waiter,
                    isCancelled: true,
                });
                if (producer != undefined) {
                    producer.cancel();
                }
            }
            phase => {
                this.phase.set(phase);
            }
        }
    }

    /// Complete this task and wake its consumer.
    complete(&readonly this, value: T): void {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskPending { waiter } => {
                this.phase.set(TaskDone { kind: "done", value });
                if (waiter != undefined) {
                    queueMicrotask(() => {
                        waiter.wake();
                    });
                }
            }
            _ => trap("task completed twice")
        }
    }

    /// Complete this task through cancellation and cancel its consumer.
    completeCancellation(&readonly this): void {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskPending { waiter } => {
                this.phase.set(TaskCancelled { kind: "cancelled" });
                if (waiter != undefined) {
                    queueMicrotask(() => {
                        waiter.cancel();
                    });
                }
            }
            TaskDone { value } => {
                this.phase.set(TaskDone { kind: "done", value });
            }
            TaskCancelled {} => {
                this.phase.set(TaskCancelled { kind: "cancelled" });
            }
            TaskTaken {} => trap("task producer dropped during a state transition")
        }
    }

    /// Move the completed result out.
    take(&readonly this): T {
        match (this.phase.replace(TaskTaken { kind: "taken" })) {
            TaskDone { value } => value
            _ => trap("task resumed without a completed result")
        }
    }
}

/// One task's settlement phase.
type TaskPhase<T> = TaskPending | TaskDone<T> | TaskCancelled | TaskTaken;

/// Task awaiting producer completion.
struct TaskPending implements !SharedSafe {
    /// The phase tag.
    kind: "pending";

    /// The producer fiber once execution starts.
    producer: Fiber | undefined;

    /// The blocked consumer when present.
    waiter: Fiber | undefined;

    /// Whether cancellation was requested.
    isCancelled: boolean;
}

/// Task holding an unconsumed result.
struct TaskDone<T> implements !SharedSafe {
    /// The phase tag.
    kind: "done";

    /// The completed result.
    value: T;
}

/// Task whose producer completed through cancellation.
struct TaskCancelled implements !SharedSafe {
    /// The phase tag.
    kind: "cancelled";
}

/// Task whose result was consumed or is being updated.
struct TaskTaken implements !SharedSafe {
    /// The phase tag.
    kind: "taken";
}

/// Structured owner of spawned tasks.
///
/// Asynchronous disposal waits for every child before it completes.
/// Cancellation requests are delivered cooperatively at cancellable asynchronous operations.
@languageItem("async.TaskScope")
export struct TaskScope implements AsyncDispose, !Copy, !SharedSafe {
    /// Opaque task scope identity.
    private handle: uint64;

    /// Open a new task scope.
    static open(): TaskScope {
        todo("TaskScope.open")
    }

    /// Spawn one task owned by this scope.
    spawn<T>(&this, body: ^Function<(), T, "once">): Task<T> {
        todo("TaskScope.spawn")
    }

    /// Request cancellation of every pending child.
    cancel(&readonly this): void {
        todo("TaskScope.cancel");
    }

    /// Cancel pending children and wait for their cleanup.
    async asyncDispose(this): Promise<void> {
        todo("TaskScope.asyncDispose")
    }
}

/// Queue one function after the active task finishes.
@languageItem("async.queueMicrotask")
@binding("tspp.async.microtask.queue", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function queueMicrotask(run: ^Function<(), void, "once">): void;
