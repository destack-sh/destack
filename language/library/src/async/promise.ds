import { todo } from "destack:error";
import { Iterable } from "destack:iter";

import { Continuation, queueMicrotask, suspendContinuation } from "./continuation.ds";

/// Async result object.
///
/// A promise never rejects in Destack: recoverable asynchronous failure is represented as
/// `Promise<Result<T, E>>`, and panic remains the Worker fault boundary.
@languageItem("async.Promise")
export local class Promise<T> {
    /// The current settlement state.
    private state: PromiseState<T>;

    /// Create a promise from an eager executor.
    constructor(executor: (resolve: (value: T) => void) => void) {
        this.state = PromisePending {
            kind: "pending",
            head: undefined,
            tail: undefined,
        };

        let resolve = (value: T) => {
            this.fulfill(value);
        };

        executor(resolve);
    }

    /// Continue when the promise fulfills, adopting the returned promise.
    then<U>(onFulfilled: (value: T) => Promise<U>): Promise<U> {
        let next = new Promise<U>((resolve) => {
            this.addReaction((value) => {
                onFulfilled(value).then(resolve);
            });
        });

        return next;
    }

    /// Continue when the promise fulfills.
    then<U>(onFulfilled: (value: T) => U): Promise<U> {
        let next = new Promise<U>((resolve) => {
            this.addReaction((value) => {
                resolve(onFulfilled(value));
            });
        });

        return next;
    }

    /// Continue after the promise fulfills, adopting the returned promise.
    finally(onFinally: () => Promise<void>): Promise<T> {
        return this.then((value) => {
            onFinally().then(() => value)
        });
    }

    /// Continue after the promise fulfills, keeping the value.
    finally(onFinally: () => void): Promise<T> {
        return this.then((value) => {
            onFinally();
            value
        });
    }

    /// Return an existing promise.
    static resolve<T>(value: Promise<T>): Promise<T> {
        value
    }

    /// Create a fulfilled promise.
    static resolve<T>(value: T): Promise<T> {
        new Promise<T>((resolve) => {
            resolve(value);
        })
    }

    /// Wait for all promises.
    static all<T>(values: Iterable<T | Promise<T>>): Promise<T[]> {
        todo("Promise.all")
    }

    /// Wait for the first fulfilled promise.
    static race<T>(values: Iterable<T | Promise<T>>): Promise<T> {
        todo("Promise.race")
    }

    /// Create a promise with an exposed resolving function.
    static withResolvers<T>(): PromiseResolvers<T> {
        let resolve: ((value: T) => void) | undefined = undefined;
        let promise = new Promise<T>((innerResolve) => {
            resolve = innerResolve;
        });

        return PromiseResolvers {
            promise,
            resolve: resolve!,
        };
    }

    /// Wait for this promise and return its fulfilled value on a later async turn.
    private awaitValue(): T {
        return suspendContinuation<T>((continuation) => {
            this.addAwaiter(continuation);
        });
    }

    /// Fulfill this promise with a final value.
    private fulfill(value: T): void {
        // ignore repeated fulfillment
        if (this.state.kind == "fulfilled") {
            return;
        }

        // publish the value before running waiters
        let waiters = this.state.head;
        this.state = PromiseFulfilled { kind: "fulfilled", value };
        this.queueWaiters(waiters, value);
    }

    /// Add one continuation waiter.
    private addAwaiter(continuation: Continuation<T>): void {
        this.addWaiter(PromiseAwaiter {
            kind: "await",
            continuation,
            next: undefined,
        });
    }

    /// Add one reaction waiter.
    private addReaction(run: (value: T) => void): void {
        this.addWaiter(PromiseReaction {
            kind: "reaction",
            run,
            next: undefined,
        });
    }

    /// Add or schedule one waiter.
    private addWaiter(waiter: PromiseWaiter<T>): void {
        // schedule immediately after fulfillment
        if (this.state.kind == "fulfilled") {
            this.queueWaiter(waiter, this.state.value);
            return;
        }

        // append to the pending waiter list
        if (this.state.tail == undefined) {
            this.state.head = waiter;
            this.state.tail = waiter;
        } else {
            this.state.tail.next = waiter;
            this.state.tail = waiter;
        }
    }

    /// Schedule all waiters after fulfillment.
    private queueWaiters(head: PromiseWaiter<T> | undefined, value: T): void {
        // detach before queueing each waiter
        let waiter = head;
        while (waiter != undefined) {
            let next = waiter.next;
            waiter.next = undefined;
            this.queueWaiter(waiter, value);
            waiter = next;
        }
    }

    /// Schedule one waiter after fulfillment.
    private queueWaiter(waiter: PromiseWaiter<T>, value: T): void {
        // resume awaiters through the continuation scheduler
        if (waiter.kind == "await") {
            waiter.continuation.queue(value);
        }
        // run callback reactions as microtasks
        else {
            queueMicrotask(() => {
                waiter.run(value);
            });
        }
    }
}

/// Promise with its resolving function.
@languageItem("async.PromiseResolvers")
export local struct PromiseResolvers<T> {
    /// The created promise.
    promise: Promise<T>;

    /// Resolve the promise.
    resolve: (value: T) => void;
}

/// Current promise state.
type PromiseState<T> = PromisePending<T> | PromiseFulfilled<T>;

/// Pending promise state.
local struct PromisePending<T> {
    /// The state tag.
    kind: "pending";

    /// First waiter to run after fulfillment.
    head: PromiseWaiter<T> | undefined;

    /// Last waiter to run after fulfillment.
    tail: PromiseWaiter<T> | undefined;
}

/// Fulfilled promise state.
local struct PromiseFulfilled<T> {
    /// The state tag.
    kind: "fulfilled";

    /// The fulfilled value.
    value: T;
}

/// One promise fulfillment waiter.
type PromiseWaiter<T> = PromiseAwaiter<T> | PromiseReaction<T>;

/// Await continuation parked inside one pending promise.
local struct PromiseAwaiter<T> {
    /// The waiter tag.
    kind: "await";

    /// Continuation to resume with the fulfilled value.
    continuation: Continuation<T>;

    /// Next waiter in fulfillment order.
    next: PromiseWaiter<T> | undefined;
}

/// Then/finally reaction parked inside one pending promise.
local struct PromiseReaction<T> {
    /// The waiter tag.
    kind: "reaction";

    /// Reaction to run with the fulfilled value.
    run: (value: T) => void;

    /// Next waiter in fulfillment order.
    next: PromiseWaiter<T> | undefined;
}
