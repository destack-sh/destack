import { todo } from "destack:error";
import { Iterable } from "destack:iter";

import { queueMicrotask } from "./continuation.ds";

/// Worker-local async result object.
@languageItem("async.Promise")
export class Promise<T> {
    /// The current settlement state.
    private state: PromiseState<T>;

    /// Create a promise from an executor.
    constructor(executor: PromiseExecutor<T>) {
        this.state = { kind: "pending", reactions: [] };

        let resolve: PromiseResolve<T> = (value) => {
            this.resolve(value);
        };

        executor(resolve);
    }

    /// Continue when the promise fulfills.
    then<U>(onFulfilled: (value: T) => U | Promise<U>): Promise<U> {
        new Promise<U>((resolve) => {
            this.react({
                onFulfilled: (value) => {
                    resolve(onFulfilled(value));
                },
            });
        })
    }

    /// Continue after the promise fulfills, keeping the value.
    finally(onFinally: () => void | Promise<void>): Promise<T> {
        this.then((value) => {
            Promise.resolve(onFinally()).then(() => value)
        })
    }

    /// Create a fulfilled promise.
    static resolve<T>(value: T | Promise<T>): Promise<T> {
        if (value instanceof Promise) {
            value as Promise<T>
        } else {
            new Promise<T>((resolve) => {
                resolve(value as T);
            })
        }
    }

    /// Wait for all promises.
    static all<T>(values: Iterable<T | Promise<T>>): Promise<T[]> {
        todo("Promise.all")
    }

    /// Wait for the first fulfilled promise.
    static race<T>(values: Iterable<T | Promise<T>>): Promise<T> {
        todo("Promise.race")
    }

    /// Create a promise with an exposed resolving function.
    static withResolvers<T>(): PromiseResolvers<T> {
        let resolve: PromiseResolve<T> | undefined = undefined;
        let promise = new Promise<T>((innerResolve) => {
            resolve = innerResolve;
        });

        PromiseResolvers {
            promise,
            resolve: resolve!,
        }
    }

    /// Resolve this promise with a value or another promise.
    private resolve(value: T | Promise<T>): void {
        if (value instanceof Promise) {
            value.then((value) => {
                this.fulfill(value);
            });
        } else {
            this.fulfill(value);
        }
    }

    /// Fulfill this promise with a final value.
    private fulfill(value: T): void {
        if (this.state.kind == "pending") {
            let reactions = this.state.reactions;
            this.state = { kind: "fulfilled", value };
            this.queueReactions(reactions);
        }
    }

    /// Add or schedule one reaction.
    private react(reaction: PromiseReaction<T>): void {
        if (this.state.kind == "pending") {
            this.state.reactions.push(reaction);
        } else {
            this.queueReaction(reaction);
        }
    }

    /// Schedule reactions after fulfillment.
    private queueReactions(reactions: PromiseReaction<T>[]): void {
        for (let index: number = 0; index < reactions.length; index += 1) {
            this.queueReaction(reactions[index]);
        }
    }

    /// Schedule one reaction after fulfillment.
    private queueReaction(reaction: PromiseReaction<T>): void {
        queueMicrotask(() => {
            if (this.state.kind == "fulfilled") {
                reaction.onFulfilled(this.state.value);
            }
        });
    }
}

/// Promise with its resolving function.
@languageItem("async.PromiseResolvers")
export struct PromiseResolvers<T> {
    /// The created promise.
    promise: Promise<T>;

    /// Resolve the promise.
    resolve: PromiseResolve<T>;
}

/// Function that resolves a promise.
export type PromiseResolve<T> = (value: T | Promise<T>) => void;

/// Function that starts a promise.
export type PromiseExecutor<T> = (resolve: PromiseResolve<T>) => void;

/// Current promise state.
type PromiseState<T> = PromisePending<T> | PromiseFulfilled<T>;

/// Pending promise state.
interface PromisePending<T> {
    /// The state tag.
    kind: "pending";

    /// Continuations waiting for fulfillment.
    reactions: PromiseReaction<T>[];
}

/// Fulfilled promise state.
interface PromiseFulfilled<T> {
    /// The state tag.
    kind: "fulfilled";

    /// The fulfilled value.
    value: T;
}

/// Promise continuation callback.
interface PromiseReaction<T> {
    /// Fulfillment callback.
    onFulfilled: (value: T) => void;
}
