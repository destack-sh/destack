import { todo, trap } from "destack:error";
import { Iterable } from "destack:iter";
import { Copy } from "destack:memory";

import { Awaitable } from "./awaitable.ds";
import { Waiter } from "./continuation.ds";
import { queueMicrotask } from "./task.ds";

/// Value produced by asynchronous execution.
///
/// A promise never rejects in Destack: recoverable failure remains an explicit `Result` value,
/// and panic remains the Worker fault boundary.
/// Every observer receives the same copyable value.
@languageItem("async.Promise")
export local class Promise<T: Copy> implements Awaitable<T> {
    /// The current settlement state.
    private state: PromiseState<T>;

    /// Create a promise from an eager executor.
    constructor(executor: (resolve: (value: T) => void) => void) {
        this.state = PromisePending {
            kind: "pending",
            head: undefined,
            tail: undefined,
        };

        let resolve = (value: T) => {
            Promise.fulfill(this, value);
        };

        executor(resolve);
    }

    /// Continue when the promise fulfills, adopting the returned promise.
    then<U: Copy>(onFulfilled: (value: T) => Promise<U>): Promise<U> {
        let next = Promise.pending<U>();
        this.addReaction(
            (source) => {
                let returned = onFulfilled(source.observe());
                returned.addReaction(
                    (source) => {
                        next.forward(source);
                    },
                    () => {
                        Promise.cancel(next);
                    },
                );
            },
            () => {
                Promise.cancel(next);
            },
        );

        return next;
    }

    /// Continue when the promise fulfills.
    then<U: Copy>(onFulfilled: (value: T) => U): Promise<U> {
        let next = Promise.pending<U>();
        this.addReaction(
            (source) => {
                Promise.fulfill(next, onFulfilled(source.observe()));
            },
            () => {
                Promise.cancel(next);
            },
        );

        return next;
    }

    /// Continue after the promise fulfills, adopting the returned promise.
    finally(onFinally: () => Promise<void>): Promise<T> {
        let next = Promise.pending<T>();
        this.addReaction(
            (source) => {
                let returned = onFinally();
                returned.addReaction(
                    (_completion) => {
                        next.forward(source);
                    },
                    () => {
                        Promise.cancel(next);
                    },
                );
            },
            () => {
                let returned = onFinally();
                returned.addReaction(
                    (_completion) => {
                        Promise.cancel(next);
                    },
                    () => {
                        Promise.cancel(next);
                    },
                );
            },
        );

        return next;
    }

    /// Continue after the promise fulfills, keeping the value.
    finally(onFinally: () => void): Promise<T> {
        let next = Promise.pending<T>();
        this.addReaction(
            (source) => {
                onFinally();
                next.forward(source);
            },
            () => {
                onFinally();
                Promise.cancel(next);
            },
        );

        return next;
    }

    /// Return an existing promise.
    static resolve<T: Copy>(value: Promise<T>): Promise<T> {
        value
    }

    /// Create a fulfilled promise.
    static resolve<T: Copy>(value: T): Promise<T> {
        new Promise<T>((resolve) => {
            resolve(value);
        })
    }

    /// Wait for all promises.
    static all<T: Copy>(values: Iterable<T | Promise<T>>): Promise<T[]> {
        todo("Promise.all")
    }

    /// Wait for the first fulfilled promise.
    static race<T: Copy>(values: Iterable<T | Promise<T>>): Promise<T> {
        todo("Promise.race")
    }

    /// Create a promise with an exposed resolving function.
    static withResolvers<T: Copy>(): PromiseResolvers<T> {
        let resolve: ((value: T) => void) | undefined = undefined;
        let promise = new Promise<T>((innerResolve) => {
            resolve = innerResolve;
        });

        return PromiseResolvers {
            promise,
            resolve: resolve!,
        };
    }

    /// Create the pending promise owned by one lowered async function.
    @languageItem("async.Promise.create")
    private static create<T: Copy>(): Promise<T> {
        return Promise.pending<T>();
    }

    /// Park one waiter until a promise fulfills.
    static park<T: Copy>(promise: Promise<T>, waiter: Waiter<T>): void {
        promise.addWaiter(new PromiseAwaiter(waiter));
    }

    /// Fulfill one promise with a final value.
    @languageItem("async.Promise.fulfill")
    private static fulfill<T: Copy>(promise: Promise<T>, value: T): void {
        // ignore repeated settlement
        if (promise.state.kind != "pending") {
            return;
        }

        // publish the value before running waiters
        let waiters = promise.state.head;
        promise.state = PromiseFulfilled { kind: "fulfilled", value };
        promise.queueWaiters(waiters, promise);
    }

    /// Cancel one promise from its producing async function.
    @languageItem("async.Promise.cancel")
    private static cancel<T: Copy>(promise: Promise<T>): void {
        // ignore repeated settlement
        if (promise.state.kind != "pending") {
            return;
        }

        // publish cancellation before running waiters
        let waiters = promise.state.head;
        promise.state = PromiseCancelled { kind: "cancelled" };
        promise.cancelWaiters(waiters);
    }

    /// Fulfill this promise from an existing fulfilled promise.
    private forward(source: Promise<T>): void {
        // ignore repeated settlement
        if (this.state.kind != "pending") {
            return;
        }

        // retain the source before running waiters
        let waiters = this.state.head;
        this.state = PromiseForwarded { kind: "forwarded", source };
        this.queueWaiters(waiters, source);
    }

    /// Observe this fulfilled promise.
    private observe(): T {
        // require the normalized result owner
        if (this.state.kind != "fulfilled") {
            trap("promise does not own a fulfilled value")
        }

        return this.state.value;
    }

    /// Add one reaction.
    private addReaction(run: (source: Promise<T>) => void, cancel: () => void): void {
        this.addWaiter(new PromiseReaction(run, cancel));
    }

    /// Add or schedule one waiter.
    private addWaiter(waiter: PromiseWaiter<T>): void {
        // schedule from direct fulfilled storage
        if (this.state.kind == "fulfilled") {
            this.queueWaiter(waiter, this);
        }
        // schedule from forwarded fulfilled storage
        else if (this.state.kind == "forwarded") {
            this.queueWaiter(waiter, this.state.source);
        }
        // propagate producer cancellation
        else if (this.state.kind == "cancelled") {
            this.cancelWaiter(waiter);
        }
        // retain pending waiters
        else {
            // initialize the pending list
            if (this.state.tail == undefined) {
                this.state.head = waiter;
                this.state.tail = waiter;
            }
            // append in settlement order
            else {
                this.state.tail.next = waiter;
                this.state.tail = waiter;
            }
        }
    }

    /// Schedule all waiters after fulfillment.
    private queueWaiters(head: PromiseWaiter<T> | undefined, source: Promise<T>): void {
        // detach before queueing each waiter
        let waiter = head;
        while (waiter != undefined) {
            let next = waiter.next;
            waiter.next = undefined;
            this.queueWaiter(waiter, source);
            waiter = next;
        }
    }

    /// Cancel all waiters after producer cancellation.
    private cancelWaiters(head: PromiseWaiter<T> | undefined): void {
        let waiter = head;

        // detach before cancelling each waiter
        while (waiter != undefined) {
            let next = waiter.next;
            waiter.next = undefined;
            this.cancelWaiter(waiter);
            waiter = next;
        }
    }

    /// Schedule one waiter after fulfillment.
    private queueWaiter(waiter: PromiseWaiter<T>, source: Promise<T>): void {
        // resume compiler-lowered await directly
        if (waiter.kind == "await") {
            waiter.waiter.queue(source.observe());
        }
        // schedule user reactions as callbacks
        else {
            queueMicrotask(() => {
                waiter.run(source);
            });
        }
    }

    /// Cancel one waiter after producer cancellation.
    private cancelWaiter(waiter: PromiseWaiter<T>): void {
        // cancel compiler-lowered await directly
        if (waiter.kind == "await") {
            waiter.waiter.cancel();
        }
        // propagate cancellation through user reactions
        else {
            queueMicrotask(() => {
                waiter.cancel();
            });
        }
    }

    /// Create one unresolved promise.
    private static pending<T: Copy>(): Promise<T> {
        new Promise<T>((_resolve) => {})
    }
}

/// Promise with its resolving function.
@languageItem("async.PromiseResolvers")
export local struct PromiseResolvers<T: Copy> {
    /// The created promise.
    promise: Promise<T>;

    /// Resolve the promise.
    resolve: (value: T) => void;
}

/// Current promise state.
type PromiseState<T: Copy> =
    | PromisePending<T>
    | PromiseFulfilled<T>
    | PromiseForwarded<T>
    | PromiseCancelled;

/// Pending promise state.
local struct PromisePending<T: Copy> {
    /// The state tag.
    kind: "pending";

    /// First waiter to run after fulfillment.
    head: PromiseWaiter<T> | undefined;

    /// Last waiter to run after fulfillment.
    tail: PromiseWaiter<T> | undefined;
}

/// Fulfilled promise state.
local struct PromiseFulfilled<T: Copy> {
    /// The state tag.
    kind: "fulfilled";

    /// The fulfilled value.
    value: T;
}

/// Promise state forwarded to existing fulfilled storage.
local struct PromiseForwarded<T: Copy> {
    /// The state tag.
    kind: "forwarded";

    /// The fulfilled promise that owns the value.
    source: Promise<T>;
}

/// Promise cancelled by its producing async function.
local struct PromiseCancelled {
    /// The state tag.
    kind: "cancelled";
}

/// One promise settlement waiter.
type PromiseWaiter<T: Copy> = PromiseAwaiter<T> | PromiseReaction<T>;

/// One execution awaiting promise settlement.
local class PromiseAwaiter<T: Copy> {
    /// The waiter tag.
    kind: "await";

    /// The parked execution.
    waiter: Waiter<T>;

    /// Next waiter in fulfillment order.
    next: PromiseWaiter<T> | undefined;

    /// Create one promise awaiter.
    constructor(waiter: Waiter<T>) {
        this.kind = "await";
        this.waiter = waiter;
        this.next = undefined;
    }
}

/// One callback reacting to promise settlement.
local class PromiseReaction<T: Copy> {
    /// The waiter tag.
    kind: "reaction";

    /// Callback to queue with the fulfilled source.
    run: (source: Promise<T>) => void;

    /// Cancellation continuation for the derived promise.
    cancel: () => void;

    /// Next waiter in fulfillment order.
    next: PromiseWaiter<T> | undefined;

    /// Create one promise reaction.
    constructor(run: (source: Promise<T>) => void, cancel: () => void) {
        this.kind = "reaction";
        this.run = run;
        this.cancel = cancel;
        this.next = undefined;
    }
}
