import { Deque } from "destack:collections";
import { Cell, Copy } from "destack:memory";

import { Fiber } from "./fiber.ds";
import { Poll, Pollable, Ready } from "./poll.ds";

/// Sending and receiving ends of one open channel.
export struct ChannelEnds<T> implements !SharedSafe {
    /// The producer end.
    sender: ChannelSender<T>;

    /// The consumer end.
    receiver: ChannelReceiver<T>;
}

/// Shareable sending end of one channel.
export class ChannelSender<T> {
    /// Shared channel state.
    private readonly state: ChannelState<T>;

    /// Create the sending end over shared state.
    constructor(state: ChannelState<T>) {
        this.state = state;
    }

    /// Send one value, waking a parked receiver.
    send(&readonly this, value: T): void {
        this.state.push(value);
    }
}

/// Owned receiving end of one channel, polled for the next value.
export struct ChannelReceiver<T> implements !Copy, !SharedSafe {
    /// Shared channel state.
    private state: ChannelState<T>;
}

export extension<T> of ChannelReceiver<T> implements Pollable<T> {
    /// Return the next value when one is queued.
    poll(&exclusive this): Poll<T> {
        this.state.pop()
    }

    /// Set or clear the fiber to wake at the next send.
    setWaiter(&exclusive this, fiber: Fiber | undefined): void {
        this.state.setWaiter(fiber);
    }
}

/// Open one channel and return both ends.
export function channel<T>(): ChannelEnds<T> {
    let state = new ChannelState<T>();

    return ChannelEnds {
        sender: new ChannelSender(state),
        receiver: ChannelReceiver { state },
    };
}

/// Shared queue and waiter state between the channel ends.
class ChannelState<T> {
    /// The queued values in send order.
    private readonly values: Cell<Deque<Ready<T>>>;

    /// The fiber parked on the next value.
    private readonly waiter: Cell<Fiber | undefined>;

    /// Create empty channel state.
    constructor() {
        this.values = Cell.new(Deque.new());
        this.waiter = Cell.new(undefined);
    }

    /// Queue one value and wake the parked receiver.
    push(&readonly this, value: T): void {
        let values = this.values.replace(Deque.new());
        values.pushBack(Ready { value });
        this.values.set(values);
        let waiter = this.waiter.replace(undefined);
        if (waiter != undefined) {
            waiter.wake();
        }
    }

    /// Take the next queued value.
    pop(&readonly this): Poll<T> {
        let values = this.values.replace(Deque.new());
        let next = values.popFront();
        this.values.set(values);
        if (next == undefined) {
            return Poll.pending();
        }

        return Poll(next);
    }

    /// Set or clear the fiber to wake at the next send.
    setWaiter(&readonly this, fiber: Fiber | undefined): void {
        this.waiter.set(fiber);
    }
}
