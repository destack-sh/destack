import { Drop } from "destack:memory";

/// Owned value for one suspended generator continuation.
///
/// Resuming a continuation consumes it, and dropping it cancels it.
@languageItem("async.Continuation")
export local struct Continuation<TResume = void, TYield = never, TReturn = void> implements Drop {
    /// Opaque continuation identity.
    private handle: uint64;

    /// Resume this continuation with one value.
    ///
    /// This returns the next yield or return result.
    resume(this, value: TResume): ContinuationResult<TResume, TYield, TReturn> {
        return resumeContinuation<TResume, TYield, TReturn>(this, value);
    }

    /// Resume this continuation through its completion path.
    complete(this, value: TReturn): ContinuationResult<TResume, TYield, TReturn> {
        return completeContinuation<TResume, TYield, TReturn>(this, value);
    }

    /// Cancel this continuation without producing another user value.
    drop(): void {
        dropContinuation<TResume, TYield, TReturn>(this);
    }
}

/// Owned value for one parked asynchronous execution.
///
/// Queueing a waiter consumes it, and dropping it cancels its suspended execution.
@languageItem("async.Waiter")
export local struct Waiter<T> implements Drop {
    /// Opaque waiter identity.
    private handle: uint64;

    /// Queue this waiter on the current Worker's microtask queue.
    queue(this, value: T): void {
        queueWaiter(this, value);
    }

    /// Cancel this waiter without producing another user value.
    drop(): void {
        dropWaiter(this);
    }
}

/// Resume one continuation with one value.
@intrinsic("async.continuation.resume")
export declare function resumeContinuation<TResume, TYield = never, TReturn = void>(
    continuation: Continuation<TResume, TYield, TReturn>,
    value: TResume,
): ContinuationResult<TResume, TYield, TReturn>;

/// Queue one waiter on the current Worker's microtask queue.
@intrinsic("async.waiter.queue")
export declare function queueWaiter<T>(waiter: Waiter<T>, value: T): void;

/// Resume one continuation through its completion path.
@intrinsic("async.continuation.complete")
export declare function completeContinuation<TResume, TYield = never, TReturn = void>(
    continuation: Continuation<TResume, TYield, TReturn>,
    value: TReturn,
): ContinuationResult<TResume, TYield, TReturn>;

/// Cancel one continuation without producing another user value.
@intrinsic("async.continuation.drop")
export declare function dropContinuation<TResume, TYield = never, TReturn = void>(
    continuation: Continuation<TResume, TYield, TReturn>,
): void;

/// Cancel one waiter without producing another user value.
@intrinsic("async.waiter.drop")
export declare function dropWaiter<T>(waiter: Waiter<T>): void;

/// Resume command delivered into a yielded continuation.
@languageItem("async.Resume")
@derive(Tagged)
export local newtype Resume<TResume, TReturn> =
    | ResumeNext<TResume>
    | ResumeReturn<TReturn>
    | ResumeCancel;

/// Continue a yielded continuation with a normal resume value.
@languageItem("async.ResumeNext")
export local struct ResumeNext<T> {
    /// The command tag.
    kind: "next" = "next";

    /// The value observed by the suspended expression.
    value: T;
}

/// Continue a yielded continuation through its completion path.
@languageItem("async.ResumeReturn")
export local struct ResumeReturn<T> {
    /// The command tag.
    kind: "return" = "return";

    /// The value delivered to the completion path.
    value: T;
}

/// Continue a yielded continuation through its cancellation path.
@languageItem("async.ResumeCancel")
export local struct ResumeCancel {
    /// The command tag.
    kind: "cancel" = "cancel";
}

/// Suspended continuation produced by a generator `yield`.
@languageItem("async.ContinuationYield")
export local struct ContinuationYield<TResume, TYield, TReturn> {
    /// The result tag.
    kind: "yield" = "yield";

    /// The yielded value.
    value: TYield;

    /// The continuation to resume for the next step.
    continuation: Continuation<TResume, TYield, TReturn>;
}

/// Completed continuation.
@languageItem("async.ContinuationReturn")
export local struct ContinuationReturn<T> {
    /// The result tag.
    kind: "return" = "return";

    /// The returned value.
    value: T;
}

/// Result of resuming a continuation.
@languageItem("async.ContinuationResult")
@derive(Tagged)
export local newtype ContinuationResult<TResume, TYield, TReturn> =
    | ContinuationYield<TResume, TYield, TReturn>
    | ContinuationReturn<TReturn>;
