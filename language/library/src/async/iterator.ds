import { IteratorResult } from "destack:iter";
import { Copy } from "destack:memory";

import { Promise } from "./promise.ds";

/// Protocol for asynchronously producing values.
@languageItem("async.AsyncIterator")
export local newtype interface AsyncIterator<T: Copy> {
    /// The completion value produced when the sequence ends.
    type Return: Copy = void;

    /// Advance and return the next yield or completion.
    next(&this): Promise<IteratorResult<T, this.Return>>;
}

/// Value that can produce an async iterator.
@languageItem("async.AsyncIterable")
export local newtype interface AsyncIterable<T: Copy> {
    /// The asynchronous iterator produced by this value.
    type Iterator: AsyncIterator<T> = AsyncIterator<T>;

    /// Return an asynchronous iterator over this value.
    asyncIterator(this): this.Iterator;
}

/// Every async iterator is trivially async-iterable as itself.
export extension<T: Copy, I: AsyncIterator<T>> of I implements AsyncIterable<T> {
    /// The asynchronous iterator itself.
    type Iterator = I;

    /// Return this async iterator.
    asyncIterator(this): I {
        this
    }
}
