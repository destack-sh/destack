import { AsyncResult, todo } from "destack:error";
import { AsyncDispose } from "destack:memory";

import { Promise } from "./promise.ds";

/// Structured owner of spawned tasks.
///
/// A scope owns every task spawned into it and cannot exit while children are pending:
/// disposing the scope cancels the remaining children and awaits their cleanup.
export local class TaskScope implements AsyncDispose {
    /// Open a new task scope.
    static open(): TaskScope {
        todo("TaskScope.open")
    }

    /// Spawn a task owned by this scope.
    spawn<T>(body: () => Promise<T>): Task<T> {
        todo("TaskScope.spawn")
    }

    /// Adopt an already pending promise into this scope.
    adopt<T>(promise: Promise<T>): Task<T> {
        todo("TaskScope.adopt")
    }

    /// Cancel all pending children.
    cancel(): void {
        todo("TaskScope.cancel");
    }

    /// Wait for all pending children to complete.
    join(): Promise<void> {
        todo("TaskScope.join")
    }

    /// Cancel remaining children and await their cleanup.
    asyncDispose(): Promise<void> {
        todo("TaskScope.asyncDispose")
    }
}

/// Task owned by a `TaskScope`.
export local class Task<T> {
    /// Wait for the task to complete or cancel.
    join(): AsyncResult<T, Cancelled> {
        todo("Task.join")
    }

    /// Request cancellation.
    ///
    /// Cancellation resumes the task's parked continuation through its cancellation path.
    cancel(): void {
        todo("Task.cancel");
    }
}

/// Cancellation marker observed when joining a cancelled task.
export local struct Cancelled {}

/// Yield back to the current Worker scheduler.
export function yieldNow(): Promise<void> {
    todo("async.yieldNow")
}
