import { todo } from "destack:error";
import { AsyncDispose, Drop } from "destack:memory";

import { Waiter } from "./continuation.ds";
import { Promise } from "./promise.ds";

/// Single-consumer asynchronous result.
///
/// Awaiting consumes the task and transfers its result.
/// Dropping the task detaches the result while its scope retains the execution.
@languageItem("async.Task")
export local struct Task<T> implements Drop {
    /// Opaque task identity.
    private handle: uint64;

    /// Create an already completed task.
    static resolve<T>(value: T): Task<T> {
        return resolveTask(value);
    }

    /// Park one waiter until a task completes.
    @languageItem("async.Task.park")
    private static park<T>(task: Task<T>, waiter: Waiter<T>): void {
        parkTask(task, waiter);
    }

    /// Request cooperative cancellation.
    cancel(&readonly this): void {
        cancelTask(&readonly this);
    }

    /// Detach this task result.
    drop(): void {
        dropTask(this);
    }
}

/// Structured owner of spawned tasks.
///
/// A scope waits for every child before it exits.
/// Cancellation requests are delivered cooperatively at cancellable asynchronous operations.
export local struct TaskScope implements AsyncDispose {
    /// Opaque task scope identity.
    private handle: uint64;

    /// Open a new task scope.
    static open(): TaskScope {
        todo("TaskScope.open")
    }

    /// Spawn one task owned by this scope.
    spawn<T>(&exclusive this, body: () => Task<T>): Task<T> {
        todo("TaskScope.spawn")
    }

    /// Request cancellation of every pending child.
    cancel(&readonly this): void {
        todo("TaskScope.cancel");
    }

    /// Wait for every child to complete.
    join(&readonly this): Promise<void> {
        todo("TaskScope.join")
    }

    /// Cancel pending children and wait for their cleanup.
    asyncDispose(): Promise<void> {
        todo("TaskScope.asyncDispose")
    }
}

/// Create an already completed task.
@intrinsic("async.task.resolve")
export declare function resolveTask<T>(value: T): Task<T>;

/// Request cooperative task cancellation.
@intrinsic("async.task.cancel")
export declare function cancelTask<T>(task: &readonly Task<T>): void;

/// Park one waiter until a task completes.
@intrinsic("async.task.park")
export declare function parkTask<T>(task: Task<T>, waiter: Waiter<T>): void;

/// Detach one task result.
@intrinsic("async.task.drop")
export declare function dropTask<T>(task: Task<T>): void;

/// Cancellation marker returned by cancellable operations.
export local struct Cancelled {}

/// Yield back to the current Worker scheduler.
export function yieldNow(): Promise<void> {
    todo("async.yieldNow")
}

/// Queue one function after the active task finishes.
@languageItem("async.queueMicrotask")
@binding("destack.async.microtask.queue", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function queueMicrotask(run: () => void): void;
