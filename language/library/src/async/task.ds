import { todo, trap } from "destack:error";
import { AsyncDispose, Cell, Copy, Drop } from "destack:memory";

import { Awaitable } from "./awaitable.ds";
import { Fiber } from "./fiber.ds";
import { Promise } from "./promise.ds";

/// Single-consumer asynchronous result on its own fiber.
///
/// Awaiting a task blocks the current fiber and moves the result out.
/// Cancellation requests are delivered cooperatively at cancellable operations.
@languageItem("async.Task")
export local class Task<T> implements Awaitable<T> {
    /// The single-consumer settlement state.
    private state: Cell<TaskState<T>>;

    /// Create one pending task.
    private constructor() {
        this.state = Cell.new(TaskPending { kind: "pending", waiter: undefined });
    }

    /// Create an already completed task.
    static resolve<T>(value: T): Task<T> {
        let task = new Task<T>();
        task.complete(value);

        return task;
    }

    /// Run one body on a fresh fiber and expose its result.
    static spawn<T>(body: () => T): Task<T> {
        let task = new Task<T>();
        Fiber.spawn(() => {
            task.complete(body());
        });

        return task;
    }

    /// Block the current fiber until a task completes, moving the result out.
    static block<T>(task: Task<T>): T {
        match (task.state.replace(TaskTaken { kind: "taken" })) {
            TaskPending { waiter: undefined } => {
                let pending = TaskPending { kind: "pending", waiter: Fiber.current() };
                task.state.set(pending);

                Fiber.park<T>()
            }
            TaskPending => trap("task already has a consumer")
            TaskDone { value } => value
            TaskTaken => trap("task result was already consumed")
        }
    }

    /// Request cancellation at the next suspension.
    cancel(&readonly this): void {
        todo("Task.cancel");
    }

    /// Settle this task, waking a blocked consumer.
    private complete(value: T): void {
        match (this.state.replace(TaskTaken { kind: "taken" })) {
            TaskPending { waiter: undefined } => {
                this.state.set(TaskDone { kind: "done", value });
            }
            TaskPending { waiter } => {
                waiter!.wake(value);
            }
            _ => trap("task completed twice")
        }
    }
}

/// One task's settlement state.
local type TaskState<T> = TaskPending | TaskDone<T> | TaskTaken;

/// Task awaiting its body.
local struct TaskPending {
    /// The state tag.
    kind: "pending";

    /// The blocked consumer when one arrived before completion.
    waiter: Fiber | undefined;
}

/// Task holding an unconsumed result.
local struct TaskDone<T> {
    /// The state tag.
    kind: "done";

    /// The moved-in result.
    value: T;
}

/// Task whose result was consumed or is being settled.
local struct TaskTaken {
    /// The state tag.
    kind: "taken";
}

/// Structured owner of spawned tasks.
///
/// Asynchronous disposal waits for every child before it completes.
/// Cancellation requests are delivered cooperatively at cancellable asynchronous operations.
export local struct TaskScope implements AsyncDispose, Drop {
    /// Opaque task scope identity.
    private handle: uint64;

    /// Open a new task scope.
    static open(): TaskScope {
        todo("TaskScope.open")
    }

    /// Spawn one task owned by this scope.
    spawn<T: Copy>(&exclusive this, body: () => Task<T>): Task<T> {
        todo("TaskScope.spawn")
    }

    /// Request cancellation of every pending child.
    cancel(&readonly this): void {
        todo("TaskScope.cancel");
    }

    /// Cancel pending children and wait for their cleanup.
    async asyncDispose(): Promise<void> {
        todo("TaskScope.asyncDispose")
    }

    /// Cancel pending children and detach their cleanup.
    drop(): void {
        todo("TaskScope.drop");
    }
}

/// Yield the current fiber back to the Worker scheduler.
export function yieldNow(): void {
    let me = Fiber.current();
    queueMicrotask(() => {
        me.wake(undefined);
    });
    Fiber.park<void>();
}

/// Queue one function after the active task finishes.
@languageItem("async.queueMicrotask")
@binding("destack.async.microtask.queue", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function queueMicrotask(run: () => void): void;
