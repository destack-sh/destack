import { todo } from "destack:error";
import { AsyncDispose, Drop } from "destack:memory";

import { Awaitable } from "./awaitable.ds";
import { Continuation, Waiter } from "./continuation.ds";
import { Promise } from "./promise.ds";

/// Single-consumer asynchronous result.
///
/// Awaiting consumes the task and transfers its result.
/// Dropping the task detaches its result without cancelling its execution.
/// Cancellation enters its continuation's cancellation path at the next suspension.
@languageItem("async.Task")
export local struct Task<T> implements Awaitable<T>, Drop {
    /// Opaque task identity.
    private handle: uint64;

    /// Create an already completed task.
    static resolve<T>(value: T): Task<T> {
        return resolveTask(value);
    }

    /// Start one coroutine as a task.
    @languageItem("async.Task.create")
    private static create<T>(continuation: Continuation<void, never, T>): Task<T> {
        return startTask(continuation);
    }

    /// Park one waiter until a task completes.
    static park<T>(task: Task<T>, waiter: Waiter<T>): void {
        parkTask(task, waiter);
    }

    /// Request cancellation at the next suspension.
    cancel(&readonly this): void {
        cancelTask(&readonly this);
    }

    /// Detach this task result.
    drop(): void {
        detachTask(this);
    }
}

/// Structured owner of spawned tasks.
///
/// Asynchronous disposal waits for every child before it completes.
/// Cancellation requests are delivered cooperatively at cancellable asynchronous operations.
export local struct TaskScope implements Awaitable<void>, AsyncDispose, Drop {
    /// Opaque task scope identity.
    private handle: uint64;

    /// Open a new task scope.
    static open(): TaskScope {
        return openScope();
    }

    /// Spawn one task owned by this scope.
    spawn<T>(&exclusive this, body: () => Task<T>): Task<T> {
        let task = body();
        attachTask(&readonly this, &readonly task);

        return task;
    }

    /// Request cancellation of every pending child.
    cancel(&readonly this): void {
        cancelScope(&readonly this);
    }

    /// Park one waiter until every child completes.
    static park(scope: TaskScope, waiter: Waiter<void>): void {
        parkScope(scope, waiter);
    }

    /// Consume this scope after every child completes.
    async join(this): Promise<void> {
        await this;
    }

    /// Cancel pending children and wait for their cleanup.
    async asyncDispose(): Promise<void> {
        this.cancel();
        await this;
    }

    /// Cancel pending children and detach their cleanup.
    drop(): void {
        this.cancel();
        detachScope(this);
    }
}

/// Create an already completed task.
@intrinsic("async.task.resolve")
export declare function resolveTask<T>(value: T): Task<T>;

/// Start one coroutine as a task.
@intrinsic("async.task.start")
export declare function startTask<T>(continuation: Continuation<void, never, T>): Task<T>;

/// Request task cancellation at the next suspension.
@intrinsic("async.task.cancel")
export declare function cancelTask<T>(task: &readonly Task<T>): void;

/// Park one waiter until a task completes.
@intrinsic("async.task.park")
export declare function parkTask<T>(task: Task<T>, waiter: Waiter<T>): void;

/// Detach one task result.
@intrinsic("async.task.detach")
export declare function detachTask<T>(task: Task<T>): void;

/// Open one structured task scope.
@binding("destack.async.taskScope.open", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
export declare function openScope(): TaskScope;

/// Attach one task execution to one scope.
@binding("destack.async.taskScope.attach", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
export declare function attachTask<T>(scope: &readonly TaskScope, task: &readonly Task<T>): void;

/// Request cancellation of every pending task in one scope.
@binding("destack.async.taskScope.cancel", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
export declare function cancelScope(scope: &readonly TaskScope): void;

/// Park one waiter until every task in one scope completes.
@binding("destack.async.taskScope.park", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
export declare function parkScope(scope: TaskScope, waiter: Waiter<void>): void;

/// Detach one scope while retaining pending task cleanup.
@binding("destack.async.taskScope.detach", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
    affinity: "worker",
})
export declare function detachScope(scope: TaskScope): void;

/// Yield back to the current Worker scheduler.
export function yieldNow(): Promise<void> {
    todo("async.yieldNow")
}

/// Queue one function after the active task finishes.
@languageItem("async.queueMicrotask")
@binding("destack.async.microtask.queue", {
    provider: "runtime",
    effect: "deterministic",
    requires: [],
})
export declare function queueMicrotask(run: () => void): void;
