import { todo } from "destack:error";
import { Iterator, IteratorResult } from "destack:iter";
import { Copy } from "destack:memory";

import { AsyncIterator } from "./iterator.ds";
import { Promise } from "./promise.ds";

/// The union of generator yield and return results.
@languageItem("async.GeneratorResult")
export type GeneratorResult<Y, R = void> = IteratorResult<Y, R>;

/// Generator object.
///
/// A generator body runs on its own fiber; each step wakes the body with the
/// consumer request and blocks the consumer until the body yields or returns.
@languageItem("async.Generator")
export local class Generator<Y, R = void, N = void> {
    /// The generator state.
    private state: GeneratorState;

    /// Create an idle generator awaiting its first step.
    private constructor() {
        this.state = GeneratorIdle { kind: "idle" };
    }

    /// Create a generator from its lowered body.
    @languageItem("async.Generator.create")
    private static create<Y, R, N>(
        body: (channel: GeneratorChannel<Y, R, N>) => R,
    ): Generator<Y, R, N> {
        todo("Generator.create")
    }

    /// Advance the generator with one value.
    next(value: N | undefined): GeneratorResult<Y, R> {
        todo("Generator.next")
    }

    /// Finalize the generator and return the completion value.
    return(value: R): GeneratorResult<Y, R> {
        todo("Generator.return")
    }
}

/// Generators iterate over their yielded values.
export extension<Y, R, N> of Generator<Y, R, N> implements Iterator<Y> {
    /// The generator's declared completion value.
    type Return = R;

    /// Advance the generator and return the next yield or completion.
    next(): IteratorResult<Y, R> {
        this.next(undefined)
    }
}

/// Step surface passed to one lowered generator body.
export local struct GeneratorChannel<Y, R, N> {
    /// Deliver one yielded value and block until the next request.
    yield(&exclusive this, value: Y): GeneratorResume<R, N> {
        todo("GeneratorChannel.yield")
    }
}

/// One consumer request delivered back into a generator body.
export type GeneratorResume<R, N> = GeneratorResumeNext<N> | GeneratorResumeFinish<R>;

/// Continue the body with one sent value.
export local struct GeneratorResumeNext<N> {
    /// The request tag.
    kind: "next";

    /// Value sent into the body.
    value: N | undefined;
}

/// Run the body's return path with one completion value.
export local struct GeneratorResumeFinish<R> {
    /// The request tag.
    kind: "finish";

    /// Value carried to the body return.
    value: R;
}

/// Async generator object.
///
/// Async generators serialize consumer requests and resolve one request promise per step.
@languageItem("async.AsyncGenerator")
export local class AsyncGenerator<Y: Copy, R: Copy = void, N = void> {
    /// The async generator state.
    private state: GeneratorState;

    /// Create an idle async generator awaiting its first step.
    private constructor() {
        this.state = GeneratorIdle { kind: "idle" };
    }

    /// Create an async generator from its lowered body.
    @languageItem("async.AsyncGenerator.create")
    private static create<Y: Copy, R: Copy, N>(
        body: (channel: GeneratorChannel<Y, R, N>) => R,
    ): AsyncGenerator<Y, R, N> {
        todo("AsyncGenerator.create")
    }

    /// Queue one generator step with an explicit value.
    next(value: N | undefined): Promise<GeneratorResult<Y, R>> {
        todo("AsyncGenerator.next")
    }

    /// Finalize the async generator and return the completion result promise.
    return(value: R): Promise<GeneratorResult<Y, R>> {
        todo("AsyncGenerator.return")
    }
}

/// Async generators iterate over their yielded values.
export extension<Y: Copy, R: Copy, N> of AsyncGenerator<Y, R, N> implements AsyncIterator<Y> {
    /// The generator's declared completion value.
    type Return = R;

    /// Advance and return the next yield or completion.
    next(): Promise<IteratorResult<Y, R>> {
        this.next(undefined)
    }
}

/// Lifecycle of one generator body fiber.
local type GeneratorState = GeneratorIdle;

/// Body not yet started.
local struct GeneratorIdle {
    /// The state tag.
    kind: "idle";
}
