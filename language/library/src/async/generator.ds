import { todo } from "destack:error";
import { Iterator } from "destack:iter";
import { Drop } from "destack:memory";
import { Option } from "destack:types";

import { ContinuationHandle } from "./continuation.ds";
import { AsyncIterator } from "./iterator.ds";
import { Promise } from "./promise.ds";

/// Worker-local generator object.
@languageItem("async.Generator")
export class Generator<Y, R = void, N = void> implements Drop {
    /// The generator state.
    private state: GeneratorState;

    /// The suspended continuation.
    private continuation: ContinuationHandle;

    /// Resume the generator with `value` and return the next result.
    resume(value: N): GeneratorResult<Y, R> {
        todo("Generator.resume")
    }

    /// Finalize the generator and return the completion value.
    return(value: R): GeneratorResult<Y, R> {
        todo("Generator.return")
    }

    /// Drop the suspended generator frame.
    drop(): void {
        todo("Generator.drop");
    }
}

/// Generators iterate over their yielded values, dropping returns and resume values.
extension<Y, R, N> of Generator<Y, R, N> implements Iterator {
    type Item = Y;

    /// Advance the generator and return the next yielded value.
    next(): Option<Y> {
        todo("Generator.next")
    }
}

/// Worker-local async generator object.
@languageItem("async.AsyncGenerator")
export class AsyncGenerator<Y, R = void, N = void> implements Drop {
    /// The underlying generator.
    private generator: Generator<Y, R, N>;

    /// Resume the generator with `value` and return the next result.
    resume(value: N): Promise<GeneratorResult<Y, R>> {
        todo("AsyncGenerator.resume")
    }

    /// Finalize the generator and return the completion value.
    return(value: R): Promise<GeneratorResult<Y, R>> {
        todo("AsyncGenerator.return")
    }

    /// Drop the suspended async generator frame.
    drop(): void {
        todo("AsyncGenerator.drop");
    }
}

/// Async generators iterate over their yielded values, dropping returns and resume values.
extension<Y, R, N> of AsyncGenerator<Y, R, N> implements AsyncIterator {
    type Item = Y;

    /// Advance the generator and return the next yielded value.
    next(): Promise<Option<Y>> {
        todo("AsyncGenerator.next")
    }
}

/// The union of generator yield and return results.
@languageItem("async.GeneratorResult")
@derive(Tagged)
export newtype GeneratorResult<Y, R = void> = GeneratorYield<Y> | GeneratorReturn<R>;

/// A yielded generator value.
@languageItem("async.GeneratorYield")
export struct GeneratorYield<Y> {
    /// The result tag.
    kind: "yield" = "yield";

    /// The yielded value.
    value: Y;
}

/// A completed generator value.
@languageItem("async.GeneratorReturn")
export struct GeneratorReturn<R> {
    /// The result tag.
    kind: "return" = "return";

    /// The return value.
    value: R;
}

/// State of a generator object.
@languageItem("async.GeneratorState")
export type GeneratorState = "suspended" | "running" | "completed";
