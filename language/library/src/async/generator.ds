import { trap } from "destack:error";
import { Iterator, IteratorResult, IteratorReturn, IteratorYield } from "destack:iter";
import { Cell, Copy } from "destack:memory";

import { Fiber } from "./fiber.ds";
import { AsyncIterator } from "./iterator.ds";
import { Promise, PromiseResolvers } from "./promise.ds";
import { queueMicrotask } from "./task.ds";

/// The union of generator yield and return results.
@languageItem("async.GeneratorResult")
export type GeneratorResult<Y, R = void> = IteratorResult<Y, R>;

/// One request delivered into a generator body.
export type GeneratorRequest<R, N> = GeneratorNext<N> | GeneratorReturn<R>;

/// Continue the producer with one sent value.
@languageItem("async.GeneratorNext")
export struct GeneratorNext<N> implements !SharedSafe {
    /// The request tag.
    kind: "next";

    /// Value sent into the producer.
    value: N | undefined;
}

/// Run the producer's return path with one completion value.
@languageItem("async.GeneratorReturn")
export struct GeneratorReturn<R> implements !SharedSafe {
    /// The request tag.
    kind: "return";

    /// Value carried into the return path.
    value: R;
}

/// Generator object.
@languageItem("async.Generator")
export class Generator<Y, R = void, N = void> {
    /// Shared producer state.
    private readonly state: GeneratorState<Y, R, N>;

    /// Create a generator over one producer state.
    private constructor(state: GeneratorState<Y, R, N>) {
        this.state = state;
    }

    /// Create a suspended generator from its lowered body.
    @languageItem("async.Generator.create")
    private static create<Y, R, N>(
        body: ^Function<(GeneratorProducer<Y, R, N>,), R, "once">,
    ): Generator<Y, R, N> {
        let state = new GeneratorState<Y, R, N>();

        @capture("move")
        let run: ^Function<(), void, "once"> = () => {
            let producer = GeneratorProducer { state };
            let request = state.begin();
            let result = match (request) {
                GeneratorNext {} => body(producer)
                GeneratorReturn { value } => value
            };
            state.complete(result);
        };
        let producer = Fiber.create(run);
        state.attach(producer);

        return new Generator(state);
    }

    /// Advance the generator with one value.
    next(&this, value: N | undefined): GeneratorResult<Y, R> {
        return this.state.advance(GeneratorNext { kind: "next", value });
    }

    /// Finalize the generator and return the completion value.
    return(&this, value: R): GeneratorResult<Y, R> {
        return this.state.advance(GeneratorReturn { kind: "return", value });
    }
}

/// Generators iterate over their yielded values.
export extension<Y, R, N> of Generator<Y, R, N> implements Iterator<Y> {
    /// The generator's declared completion value.
    type Return = R;

    /// Advance the generator and return the next yield or completion.
    next(&this): IteratorResult<Y, R> {
        this.next(undefined)
    }
}

/// Step operations available to one lowered generator body.
export struct GeneratorProducer<Y, R, N> implements !SharedSafe {
    /// Shared producer state.
    private readonly state: GeneratorState<Y, R, N>;

    /// Yield one value, suspend the producer, and receive the next consumer request.
    @languageItem("async.Generator.yield")
    yield(&this, value: Y): GeneratorRequest<R, N> {
        this.state.publish(value);
        Fiber.yield();

        return this.state.takeRequest();
    }
}

/// Shared state between one synchronous generator and its producer.
class GeneratorState<Y, R, N> {
    /// Current generator phase.
    private readonly phase: Cell<GeneratorPhase<Y, R, N>>;

    /// Suspended producer fiber.
    private readonly producer: Cell<Fiber | undefined>;

    /// Create one suspended-start state.
    constructor() {
        this.phase = Cell.new(GeneratorStart { kind: "start" });
        this.producer = Cell.new(undefined);
    }

    /// Attach the suspended producer fiber.
    attach(&readonly this, producer: Fiber): void {
        if (this.producer.replace(producer) != undefined) {
            trap("generator producer attached twice");
        }
    }

    /// Submit one consumer request and run the producer synchronously.
    advance(&readonly this, request: GeneratorRequest<R, N>): GeneratorResult<Y, R> {
        match (this.phase.replace(GeneratorMoving { kind: "moving" })) {
            GeneratorStart {} | GeneratorSuspended {} => {
                this.phase.set(GeneratorRequested {
                    kind: "requested",
                    request,
                });
            }
            GeneratorExhausted {} => {
                this.phase.set(GeneratorExhausted { kind: "exhausted" });

                return match (request) {
                    GeneratorNext {} => IteratorResult(IteratorReturn { value: undefined })
                    GeneratorReturn { value } => IteratorResult(IteratorReturn { value })
                };
            }
            phase => {
                this.phase.set(phase);
                trap("generator is already executing")
            }
        }

        let producer = this.producer.get();
        if (producer == undefined) {
            trap("generator has no producer");
        }
        producer!.resume();

        return this.takeResult();
    }

    /// Begin producer execution with its first consumer request.
    begin(&readonly this): GeneratorRequest<R, N> {
        return this.takeRequest();
    }

    /// Publish one yielded value ahead of the producer's suspension.
    publish(&readonly this, value: Y): void {
        match (this.phase.replace(GeneratorMoving { kind: "moving" })) {
            GeneratorRunning {} => {
                this.phase.set(GeneratorYielded { kind: "yielded", value });
            }
            phase => {
                this.phase.set(phase);
                trap("generator yielded outside producer execution")
            }
        }
    }

    /// Publish the producer's return value.
    complete(&readonly this, value: R): void {
        match (this.phase.replace(GeneratorMoving { kind: "moving" })) {
            GeneratorRunning {} => {
                this.phase.set(GeneratorReturned { kind: "returned", value });
            }
            phase => {
                this.phase.set(phase);
                trap("generator completed outside producer execution")
            }
        }
        this.producer.replace(undefined);
    }

    /// Take the request submitted before producer execution.
    takeRequest(&readonly this): GeneratorRequest<R, N> {
        match (this.phase.replace(GeneratorMoving { kind: "moving" })) {
            GeneratorRequested { request } => {
                this.phase.set(GeneratorRunning { kind: "running" });

                request
            }
            phase => {
                this.phase.set(phase);
                trap("generator resumed without a consumer request")
            }
        }
    }

    /// Take the value published before returning to the consumer.
    private takeResult(&readonly this): GeneratorResult<Y, R> {
        match (this.phase.replace(GeneratorMoving { kind: "moving" })) {
            GeneratorYielded { value } => {
                this.phase.set(GeneratorSuspended { kind: "suspended" });

                IteratorResult(IteratorYield { value })
            }
            GeneratorReturned { value } => {
                this.phase.set(GeneratorExhausted { kind: "exhausted" });

                IteratorResult(IteratorReturn { value })
            }
            phase => {
                this.phase.set(phase);
                trap("generator returned without a result")
            }
        }
    }
}

/// Async generator object.
@languageItem("async.AsyncGenerator")
export class AsyncGenerator<Y: Copy, R: Copy = void, N = void> {
    /// Shared producer state.
    private readonly state: AsyncGeneratorState<Y, R, N>;

    /// Create an async generator over one producer state.
    private constructor(state: AsyncGeneratorState<Y, R, N>) {
        this.state = state;
    }

    /// Create a suspended async generator from its lowered body.
    @languageItem("async.AsyncGenerator.create")
    private static create<Y: Copy, R: Copy, N>(
        body: ^Function<(AsyncGeneratorProducer<Y, R, N>,), R, "once">,
    ): AsyncGenerator<Y, R, N> {
        let state = new AsyncGeneratorState<Y, R, N>();

        @capture("move")
        let run: ^Function<(), void, "once"> = () => {
            let producer = AsyncGeneratorProducer { state };
            let request = state.begin();
            let result = match (request) {
                GeneratorNext {} => body(producer)
                GeneratorReturn { value } => value
            };
            state.complete(result);
        };
        let producer = Fiber.create(run);
        state.attach(producer);

        return new AsyncGenerator(state);
    }

    /// Queue one generator step with an explicit value.
    next(&this, value: N | undefined): Promise<GeneratorResult<Y, R>> {
        return this.state.enqueue(GeneratorNext { kind: "next", value });
    }

    /// Finalize the generator and return its completion asynchronously.
    return(&this, value: R): Promise<GeneratorResult<Y, R>> {
        return this.state.enqueue(GeneratorReturn { kind: "return", value });
    }
}

/// Async generators iterate over their yielded values.
export extension<Y: Copy, R: Copy, N> of AsyncGenerator<Y, R, N> implements AsyncIterator<Y> {
    /// The generator's declared completion value.
    type Return = R;

    /// Advance and return the next yield or completion.
    next(&this): Promise<IteratorResult<Y, R>> {
        this.next(undefined)
    }
}

/// Step operations available to one lowered async generator body.
export struct AsyncGeneratorProducer<Y: Copy, R: Copy, N> implements !SharedSafe {
    /// Shared producer state.
    private readonly state: AsyncGeneratorState<Y, R, N>;

    /// Yield one value, park the producer, and receive the next consumer request.
    @languageItem("async.AsyncGenerator.yield")
    yield(&this, value: Y): GeneratorRequest<R, N> {
        this.state.publish(value);
        Fiber.park();

        return this.state.takeRequest();
    }
}

/// Shared state between one async generator and its producer.
class AsyncGeneratorState<Y: Copy, R: Copy, N> {
    /// Current generator phase.
    private readonly phase: Cell<AsyncGeneratorPhase>;

    /// Suspended producer fiber.
    private readonly producer: Cell<Fiber | undefined>;

    /// First queued request.
    private readonly head: Cell<AsyncGeneratorRequest<Y, R, N> | undefined>;

    /// Last queued request.
    private readonly tail: Cell<AsyncGeneratorRequest<Y, R, N> | undefined>;

    /// Request currently owned by the producer.
    private readonly active: Cell<AsyncGeneratorRequest<Y, R, N> | undefined>;

    /// Create one suspended-start state.
    constructor() {
        this.phase = Cell.new(AsyncGeneratorPhase.Start);
        this.producer = Cell.new(undefined);
        this.head = Cell.new(undefined);
        this.tail = Cell.new(undefined);
        this.active = Cell.new(undefined);
    }

    /// Attach the suspended producer fiber.
    attach(&readonly this, producer: Fiber): void {
        if (this.producer.replace(producer) != undefined) {
            trap("async generator producer attached twice");
        }
    }

    /// Queue one consumer request and return its promise.
    enqueue(&readonly this, operation: GeneratorRequest<R, N>): Promise<GeneratorResult<Y, R>> {
        let settlement = Promise.withResolvers<GeneratorResult<Y, R>>();

        // settle requests immediately after producer completion
        if (this.phase.get() == AsyncGeneratorPhase.Completed) {
            settlement.resolve(this.completedResult(operation));

            return settlement.promise;
        }

        // append the request in consumer order
        let request = new AsyncGeneratorRequest(operation, settlement);
        let tail = this.tail.replace(request);
        if (tail == undefined) {
            this.head.set(request);
        } else {
            tail!.next.set(request);
        }

        // schedule suspended producer execution once
        if (
            this.phase.get() == AsyncGeneratorPhase.Start
                || this.phase.get() == AsyncGeneratorPhase.Suspended
        ) {
            this.phase.set(AsyncGeneratorPhase.Scheduled);
            this.wake();
        }

        return settlement.promise;
    }

    /// Begin producer execution with its first queued request.
    begin(&readonly this): GeneratorRequest<R, N> {
        return this.takeRequest();
    }

    /// Publish one yielded value and schedule the producer's wake when a request already waits.
    publish(&readonly this, value: Y): void {
        let request = this.takeActive();
        request.settlement.resolve(IteratorResult(IteratorYield { value }));
        this.phase.set(AsyncGeneratorPhase.Suspended);
        if (this.head.get() != undefined) {
            this.phase.set(AsyncGeneratorPhase.Scheduled);
            let producer = Fiber.current();
            queueMicrotask(() => {
                producer.wake();
            });
        }
    }

    /// Publish the producer's return value and drain queued requests.
    complete(&readonly this, value: R): void {
        let request = this.takeActive();
        request.settlement.resolve(IteratorResult(IteratorReturn { value }));
        this.phase.set(AsyncGeneratorPhase.Completed);

        // settle requests queued before completion became visible
        while (this.head.get() != undefined) {
            let request = this.pop();
            request.settlement.resolve(this.completedResult(request.take()));
        }
        this.producer.replace(undefined);
    }

    /// Wake the suspended producer.
    private wake(&readonly this): void {
        let producer = this.producer.get();
        if (producer == undefined) {
            trap("async generator has no producer");
        }
        producer!.wake();
    }

    /// Move the next queued request into producer ownership.
    takeRequest(&readonly this): GeneratorRequest<R, N> {
        let request = this.pop();
        let operation = request.take();
        this.active.set(request);
        this.phase.set(AsyncGeneratorPhase.Running);

        operation
    }

    /// Take the request currently owned by the producer.
    private takeActive(&readonly this): AsyncGeneratorRequest<Y, R, N> {
        let request = this.active.replace(undefined);
        if (request == undefined) {
            trap("async generator has no active request");
        }

        request!
    }

    /// Pop the first queued request.
    private pop(&readonly this): AsyncGeneratorRequest<Y, R, N> {
        let request = this.head.replace(undefined);
        if (request == undefined) {
            trap("async generator resumed without a request");
        }
        let next = request!.next.replace(undefined);
        this.head.set(next);
        if (next == undefined) {
            this.tail.set(undefined);
        }

        request!
    }

    /// Return the result of one request after producer completion.
    private completedResult(
        &readonly this,
        operation: GeneratorRequest<R, N>,
    ): GeneratorResult<Y, R> {
        return match (operation) {
            GeneratorNext {} => IteratorResult(IteratorReturn { value: undefined })
            GeneratorReturn { value } => IteratorResult(IteratorReturn { value })
        };
    }
}

/// One queued async generator request.
class AsyncGeneratorRequest<Y: Copy, R: Copy, N> {
    /// Requested producer operation.
    private readonly operation: Cell<GeneratorRequest<R, N> | undefined>;

    /// Promise settled by this request.
    settlement: PromiseResolvers<GeneratorResult<Y, R>>;

    /// Next request in consumer order.
    next: Cell<AsyncGeneratorRequest<Y, R, N> | undefined>;

    /// Create one queued request.
    constructor(
        operation: GeneratorRequest<R, N>,
        settlement: PromiseResolvers<GeneratorResult<Y, R>>,
    ) {
        this.operation = Cell.new(operation);
        this.settlement = settlement;
        this.next = Cell.new(undefined);
    }

    /// Move out the requested producer operation.
    take(&readonly this): GeneratorRequest<R, N> {
        let operation = this.operation.replace(undefined);
        if (operation == undefined) {
            trap("async generator request was already consumed");
        }

        operation!
    }
}

/// One synchronous generator execution phase.
type GeneratorPhase<Y, R, N> =
    | GeneratorStart
    | GeneratorSuspended
    | GeneratorRequested<R, N>
    | GeneratorRunning
    | GeneratorYielded<Y>
    | GeneratorReturned<R>
    | GeneratorExhausted
    | GeneratorMoving;

/// Producer has not started.
struct GeneratorStart implements !SharedSafe {
    /// The phase tag.
    kind: "start";
}

/// Producer is suspended after yielding.
struct GeneratorSuspended implements !SharedSafe {
    /// The phase tag.
    kind: "suspended";
}

/// Consumer request awaiting producer execution.
struct GeneratorRequested<R, N> implements !SharedSafe {
    /// The phase tag.
    kind: "requested";

    /// The submitted request.
    request: GeneratorRequest<R, N>;
}

/// Producer is executing.
struct GeneratorRunning implements !SharedSafe {
    /// The phase tag.
    kind: "running";
}

/// Producer yielded one value.
struct GeneratorYielded<Y> implements !SharedSafe {
    /// The phase tag.
    kind: "yielded";

    /// The yielded value.
    value: Y;
}

/// Producer returned one value.
struct GeneratorReturned<R> implements !SharedSafe {
    /// The phase tag.
    kind: "returned";

    /// The returned value.
    value: R;
}

/// Producer has completed.
struct GeneratorExhausted implements !SharedSafe {
    /// The phase tag.
    kind: "exhausted";
}

/// Generator phase is being moved through its cell.
struct GeneratorMoving implements !SharedSafe {
    /// The phase tag.
    kind: "moving";
}

/// One async generator execution phase.
enum AsyncGeneratorPhase {
    /// Producer has not started.
    Start,

    /// Producer is queued for execution.
    Scheduled,

    /// Producer is executing.
    Running,

    /// Producer is parked after yielding.
    Suspended,

    /// Producer has completed.
    Completed,
}
