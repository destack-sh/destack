import { todo } from "destack:error";
import { Access, Borrowed, Copy, Default, Dispose, Region, ValueOf } from "destack:memory";
import { Dereference } from "destack:ops";

import { Task } from "./task.ds";

/// Asynchronous reader-writer lock.
@languageItem("async.AsyncRwLock")
export local class AsyncRwLock<T> {
    /// The protected value.
    private value: T;

    /// Create an async reader-writer lock protecting `value`.
    constructor(value: T) {
        this.value = value;
    }

    /// Lock this value for shared reading.
    read<'a>(&'a readonly this): Task<AsyncRwLockReadGuard<'a, T>> {
        todo("AsyncRwLock.read")
    }

    /// Try to lock this value for shared reading.
    tryRead<'a>(&'a readonly this): AsyncRwLockReadGuard<'a, T> | undefined {
        todo("AsyncRwLock.tryRead")
    }

    /// Lock this value for exclusive writing.
    write<'a>(&'a readonly this): Task<AsyncRwLockWriteGuard<'a, T>> {
        todo("AsyncRwLock.write")
    }

    /// Try to lock this value for exclusive writing.
    tryWrite<'a>(&'a readonly this): AsyncRwLockWriteGuard<'a, T> | undefined {
        todo("AsyncRwLock.tryWrite")
    }

    /// Borrow the protected value without locking.
    getExclusive(&exclusive this): &exclusive ValueOf<T> {
        todo("AsyncRwLock.getExclusive")
    }

    /// Consume this lock and return the protected value.
    intoInner(^this): T {
        todo("AsyncRwLock.intoInner")
    }
}

export extension<T: Default> of AsyncRwLock<T> implements Default {
    /// Create the default async reader-writer lock.
    static default(): ^AsyncRwLock<T> {
        new AsyncRwLock(T.default())
    }
}

/// Active async readonly lock guard.
export local struct AsyncRwLockReadGuard<'a, T> {
    /// The locked value.
    private lock: &'a readonly AsyncRwLock<T>;
}

export extension<'a, T> of AsyncRwLockReadGuard<'a, T>
    implements Dispose, !Copy, Dereference<"readonly">
{
    /// The pointee type.
    type Target = ValueOf<T>;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Release this guard.
    dispose(this): void {
        todo("AsyncRwLockReadGuard.dispose");
    }

    /// Borrow the protected value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("AsyncRwLockReadGuard.dereference")
    }
}

/// Active async exclusive lock guard.
export local struct AsyncRwLockWriteGuard<'a, T> {
    /// The locked value.
    private lock: &'a readonly AsyncRwLock<T>;
}

export extension<'a, T> of AsyncRwLockWriteGuard<'a, T>
    implements Dispose, !Copy, Dereference<"exclusive">
{
    /// The pointee type.
    type Target = ValueOf<T>;

    /// Release this guard.
    dispose(this): void {
        todo("AsyncRwLockWriteGuard.dispose");
    }

    /// Borrow the protected value.
    dereference<const R: Region>(
        this: Borrowed<this, R, "exclusive">,
    ): Borrowed<this.Target, R, "exclusive"> {
        todo("AsyncRwLockWriteGuard.dereference")
    }

    /// Downgrade this write guard to a read guard.
    downgrade(this): AsyncRwLockReadGuard<'a, T> {
        todo("AsyncRwLockWriteGuard.downgrade")
    }
}

export extension<'a, T> of AsyncRwLockWriteGuard<'a, T> implements Dereference<"readonly"> {
    /// The pointee type.
    type Target = ValueOf<T>;

    /// The access supplied by the pointer.
    const OutputAccess: Access = "immutable";

    /// Borrow the protected value with readonly access.
    dereference<const R: Region>(
        this: Borrowed<this, R, "readonly">,
    ): Borrowed<this.Target, R, "immutable"> {
        todo("AsyncRwLockWriteGuard.dereference")
    }
}
