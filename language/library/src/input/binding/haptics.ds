import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/binding";

/// Haptic effect kind.
export enum HapticEffect {
    /// Whole-device dual-rumble effect.
    DualRumble = 1,
    /// Trigger-localized rumble effect.
    TriggerRumble = 2,
}

/// Haptic playback result.
export enum HapticResult {
    /// Playback request completed.
    Complete = 1,
    /// Playback request was preempted by a newer request.
    Preempted = 2,
}

/// Haptic effect parameters.
export struct HapticParameters {
    /// Effect duration in milliseconds.
    durationMs: uint64;
    /// Effect start delay in milliseconds.
    startDelayMs: uint64;
    /// Low-frequency or strong-motor magnitude in the range `[0, 1]`.
    strongMagnitude: float64;
    /// High-frequency or weak-motor magnitude in the range `[0, 1]`.
    weakMagnitude: float64;
    /// Left trigger rumble magnitude in the range `[0, 1]`.
    leftTrigger: float64;
    /// Right trigger rumble magnitude in the range `[0, 1]`.
    rightTrigger: float64;
}

/// Haptics binding family.
export interface InputHaptics {
    /// List supported haptic effects.
    @binding("destack.input.haptics.effects.list", {
        effect: "external",
        requires: ["host.input.haptics"],
        families: ["windows", "unix"],
        simulation: true,
    })
    listHapticEffects(device: InputDeviceHandle): Result<Array<HapticEffect>, HostError>;

    /// Play one haptic effect.
    @binding("destack.input.haptics.play", {
        effect: "external",
        requires: ["host.input.haptics"],
        families: ["windows", "unix"],
        simulation: true,
    })
    playHaptics(
        device: InputDeviceHandle,
        effect: HapticEffect,
        parameters: &readonly HapticParameters,
    ): Result<HapticResult, HostError>;

    /// Stop active haptic effects.
    @binding("destack.input.haptics.stop", {
        effect: "external",
        requires: ["host.input.haptics"],
        families: ["windows", "unix"],
        simulation: true,
    })
    stopHaptics(device: InputDeviceHandle): Result<void, HostError>;
}
