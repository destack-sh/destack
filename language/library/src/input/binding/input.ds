import { Binding } from "destack:binding";

import { InputClipboardBinding } from "./clipboard.ds";
import { InputDeviceBinding } from "./device.ds";
import { InputEventBinding } from "./event.ds";
import { InputGamepadBinding } from "./gamepad.ds";
import { InputHapticsBinding } from "./haptics.ds";
import { InputKeyboardBinding } from "./keyboard.ds";
import { InputPointerBinding } from "./pointer.ds";
import { InputSensorBinding } from "./sensor.ds";
import { InputTextBinding } from "./text.ds";
import { InputTouchBinding } from "./touch.ds";

/// Input binding family.
@languageItem("input.InputBinding")
export interface InputBinding {
    /// Clipboard bindings.
    readonly clipboard: InputClipboardBinding;
    /// Device bindings.
    readonly device: InputDeviceBinding;
    /// Event bindings.
    readonly event: InputEventBinding;
    /// Gamepad bindings.
    readonly gamepad: InputGamepadBinding;
    /// Haptics bindings.
    readonly haptics: InputHapticsBinding;
    /// Keyboard bindings.
    readonly keyboard: InputKeyboardBinding;
    /// Pointer bindings.
    readonly pointer: InputPointerBinding;
    /// Sensor bindings.
    readonly sensor: InputSensorBinding;
    /// Text bindings.
    readonly text: InputTextBinding;
    /// Touch bindings.
    readonly touch: InputTouchBinding;
}

/// Current input binding family.
export const input: Binding<InputBinding> = new Binding<InputBinding>("input");
