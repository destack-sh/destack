import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/host";

/// Gamepad mapping.
export enum GamepadMapping {
    /// No canonical mapping is available.
    None = 0,
    /// Standard web gamepad mapping.
    Standard = 1,
    /// Standard XR gamepad mapping.
    XrStandard = 2,
}

/// Gamepad connection kind.
export enum GamepadConnection {
    /// Host did not classify the connection.
    Unknown = 0,
    /// Wired transport.
    Wired = 1,
    /// Wireless transport.
    Wireless = 2,
    /// Virtual or emulated transport.
    Virtual = 3,
}

/// Gamepad battery state.
export enum GamepadBatteryState {
    /// Battery state is unknown.
    Unknown = 0,
    /// Battery is charging.
    Charging = 1,
    /// Battery is discharging.
    Discharging = 2,
    /// Battery is full.
    Full = 3,
    /// Battery is not present.
    NotPresent = 4,
}

/// Gamepad control selector.
export struct GamepadControl {
    /// Canonical control index when available.
    index?: uint32;
    /// Host-native control code.
    hostCode: uint32;
}

/// Gamepad control kind.
export enum GamepadControlKind {
    /// Gamepad button.
    Button = 1,
    /// Gamepad axis.
    Axis = 2,
    /// Gamepad touch contact.
    Touch = 3,
}

/// Gamepad battery status.
export struct GamepadBattery {
    /// Battery state.
    state: GamepadBatteryState;
    /// Battery level in the range `[0, 1]` when available.
    level?: float64;
}

/// Gamepad button state.
export struct GamepadButton {
    /// Whether the button is currently pressed.
    isPressed: boolean;
    /// Whether the button is currently touched.
    isTouched: boolean;
    /// Analog button value in the normalized range `[0, 1]`.
    value: float64;
}

/// Gamepad touch contact state.
export struct GamepadTouch {
    /// Touch identifier in host contact space.
    touchId: uint32;
    /// Touch surface identifier.
    surfaceId: uint32;
    /// Normalized x coordinate in the range `[-1, 1]` when reported by the host.
    x: float64;
    /// Normalized y coordinate in the range `[-1, 1]` when reported by the host.
    y: float64;
    /// Normalized pressure in the range `[0, 1]` when reported by the host.
    pressure?: float64;
}

/// Gamepad motion state snapshot.
export struct GamepadMotion {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Linear acceleration x component in meters per second squared.
    accelerationX: float64;
    /// Linear acceleration y component in meters per second squared.
    accelerationY: float64;
    /// Linear acceleration z component in meters per second squared.
    accelerationZ: float64;
    /// Gravity x component in meters per second squared when available.
    gravityX?: float64;
    /// Gravity y component in meters per second squared when available.
    gravityY?: float64;
    /// Gravity z component in meters per second squared when available.
    gravityZ?: float64;
    /// Rotation rate around x in radians per second.
    gyroscopeX: float64;
    /// Rotation rate around y in radians per second.
    gyroscopeY: float64;
    /// Rotation rate around z in radians per second.
    gyroscopeZ: float64;
}

/// Gamepad state snapshot.
export struct GamepadState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Whether the gamepad is currently connected.
    isConnected: boolean;
    /// Stable source device identifier.
    deviceId: string;
    /// Stable instance identifier when available.
    instanceId?: string;
    /// Stable gamepad GUID when available.
    guid?: string;
    /// Host device name when available.
    hostName?: string;
    /// Active mapping display name when available.
    mappingName?: string;
    /// Active gamepad mapping.
    mapping: GamepadMapping;
    /// Connection kind when available.
    connection: GamepadConnection;
    /// Player index in the range `[0, 15]` when available.
    playerIndex?: uint8;
    /// Stable web-style slot index when assigned.
    slotIndex?: uint8;
    /// Battery status.
    battery: GamepadBattery;
    /// Whether this device supports whole-device rumble.
    supportsRumble: boolean;
    /// Whether this device supports trigger rumble.
    supportsTriggerRumble: boolean;
    /// Whether this device exposes motion sensors.
    supportsMotion: boolean;
    /// Whether this device exposes touch surfaces.
    supportsTouch: boolean;
    /// Whether this device supports light control.
    supportsLight: boolean;
    /// Whether motion sensors are currently enabled.
    isMotionEnabled: boolean;
    /// Effective motion sample rate in hertz when available.
    motionSampleRateHz?: float64;
    /// Axis values in normalized host order.
    axes: Array<float64>;
    /// Button values in normalized host order.
    buttons: Array<GamepadButton>;
    /// Touch contacts when the device exposes touch surfaces.
    touches: Array<GamepadTouch>;
    /// Motion state when sensors are enabled.
    motion?: GamepadMotion;
}

/// Gamepad binding family.
export interface InputGamepad {
    /// Read one gamepad state snapshot.
    @binding("destack.input.gamepad.state.read", {
        effect: "external",
        requires: ["host.input.gamepad"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readGamepadState(device: InputDeviceHandle): Result<GamepadState, HostError>;

    /// Set one gamepad player index.
    @binding("destack.input.gamepad.player.index.set", {
        effect: "external",
        requires: ["host.input.gamepad"],
        families: ["windows", "unix"],
        simulation: true,
    })
    setGamepadPlayerIndex(device: InputDeviceHandle, playerIndex: uint8): Result<void, HostError>;

    /// Set one gamepad light color.
    @binding("destack.input.gamepad.light.set", {
        effect: "external",
        requires: ["host.input.gamepad"],
        families: ["windows", "unix"],
        simulation: true,
    })
    setGamepadLight(
        device: InputDeviceHandle,
        red: uint8,
        green: uint8,
        blue: uint8,
    ): Result<void, HostError>;

    /// Enable or disable gamepad motion sensors.
    @binding("destack.input.gamepad.motion.set", {
        effect: "external",
        requires: ["host.input.gamepad"],
        families: ["windows", "unix"],
        simulation: true,
    })
    setGamepadMotion(device: InputDeviceHandle, isEnabled: boolean): Result<void, HostError>;

    /// Set the gamepad motion sensor sample rate.
    @binding("destack.input.gamepad.motion.rate.set", {
        effect: "external",
        requires: ["host.input.gamepad"],
        families: ["windows", "unix"],
        simulation: true,
    })
    setGamepadMotionRate(device: InputDeviceHandle, sampleRateHz: float64): Result<void, HostError>;
}
