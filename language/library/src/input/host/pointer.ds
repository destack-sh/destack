import { WindowHandle } from "destack:display/host";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/host";

import { ModifierState } from "./keyboard.ds";

/// Pointer kind.
export enum PointerKind {
    /// Mouse-style pointer.
    Mouse = 1,
    /// Pen or stylus pointer.
    Pen = 2,
    /// Touch contact pointer.
    Touch = 3,
    /// Host did not classify the pointer.
    Unknown = 255,
}

/// Pen tool kind.
export enum PenTool {
    /// Standard stylus or pencil tip.
    Stylus = 1,
    /// Eraser tip or eraser tool mode.
    Eraser = 2,
    /// Host did not classify the pen tool.
    Unknown = 255,
}

/// Pointer coordinate space.
export enum CoordinateSpace {
    /// Window-local logical coordinates.
    WindowLogical = 1,
    /// Window-local physical pixel coordinates.
    WindowPhysical = 2,
    /// Global desktop logical coordinates.
    GlobalLogical = 3,
    /// Global desktop physical pixel coordinates.
    GlobalPhysical = 4,
    /// Relative motion delta coordinates.
    Relative = 5,
}

/// Wheel delta unit.
export enum WheelUnit {
    /// Pixel deltas.
    Pixel = 1,
    /// Line deltas.
    Line = 2,
    /// Page deltas.
    Page = 3,
}

/// Pointer contact geometry.
export struct PointerContact {
    /// Contact width in the reported coordinate space.
    width: float64;
    /// Contact height in the reported coordinate space.
    height: float64;
}

/// Pen-specific pointer state.
export struct PenState {
    /// Pen tool kind.
    tool: PenTool;
    /// Pen pressure in the normalized range `[0, 1]` when available.
    pressure?: float64;
    /// Pen tangential pressure in the normalized range `[-1, 1]` when available.
    tangentialPressure?: float64;
    /// Pen tilt around the x axis in degrees when available.
    tiltX?: float64;
    /// Pen tilt around the y axis in degrees when available.
    tiltY?: float64;
    /// Pen altitude angle in radians when available.
    altitudeRadians?: float64;
    /// Pen azimuth angle in radians when available.
    azimuthRadians?: float64;
    /// Hover distance from the surface when available.
    hoverDistance?: float64;
    /// Pen barrel rotation in degrees when available.
    twist?: float64;
    /// Whether the pen tip is currently in contact with the surface.
    isInContact: boolean;
    /// Whether the pen is currently in proximity range.
    isInRange: boolean;
}

/// Pointer motion sample.
export struct PointerSample {
    /// Coordinate space for the reported position.
    space: CoordinateSpace;
    /// Absolute x coordinate when available.
    x?: float64;
    /// Absolute y coordinate when available.
    y?: float64;
    /// Relative x delta when available.
    deltaX?: float64;
    /// Relative y delta when available.
    deltaY?: float64;
    /// Contact geometry when available.
    contact?: PointerContact;
    /// Pen state when available.
    pen?: PenState;
    /// Monotonic sample timestamp in nanoseconds.
    timestampNs: uint64;
}

/// Pointer state snapshot.
export struct PointerState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the host stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Stable pointer identifier for this active pointer.
    pointerId: uint64;
    /// Pointer kind.
    pointerKind: PointerKind;
    /// Whether this is the primary pointer for its kind.
    isPrimary: boolean;
    /// Position coordinate space.
    space: CoordinateSpace;
    /// Pointer x position.
    x: float64;
    /// Pointer y position.
    y: float64;
    /// Relative x delta since the previous snapshot when available.
    deltaX?: float64;
    /// Relative y delta since the previous snapshot when available.
    deltaY?: float64;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Keyboard modifier and lock state.
    modifiers: ModifierState;
    /// Pen state when available.
    pen?: PenState;
    /// Contact geometry when available.
    contact?: PointerContact;
}

/// Pointer grab mode.
export enum PointerGrabMode {
    /// Do not grab the pointer.
    None = 0,
    /// Constrain pointer movement to the window bounds.
    Confined = 1,
    /// Lock pointer movement and report relative deltas.
    Locked = 2,
}

/// Read one pointer state snapshot.
@binding("destack.input.pointer.state.read", {
    effect: "external",
    requires: ["host.input.pointer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readPointerState(
    device: InputDeviceHandle,
): Result<PointerState, HostError>;

/// Enable or disable relative pointer mode.
@binding("destack.input.pointer.relative.set", {
    effect: "external",
    requires: ["host.input.pointer"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function setPointerRelativeMode(
    device: InputDeviceHandle,
    isEnabled: boolean,
): Result<void, HostError>;

/// Set pointer grab mode.
@binding("destack.input.pointer.grab", {
    effect: "external",
    requires: ["host.input.grab"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function setPointerGrab(
    device: InputDeviceHandle,
    window: WindowHandle,
    mode: PointerGrabMode,
): Result<void, HostError>;

/// Enable or disable pointer capture.
@binding("destack.input.pointer.capture", {
    effect: "external",
    requires: ["host.input.grab"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function capturePointer(
    device: InputDeviceHandle,
    window: WindowHandle,
    isEnabled: boolean,
): Result<void, HostError>;

/// Warp pointer position.
@binding("destack.input.pointer.warp", {
    effect: "external",
    requires: ["host.input.pointer"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function warpPointer(
    device: InputDeviceHandle,
    window: WindowHandle,
    x: float64,
    y: float64,
): Result<void, HostError>;
