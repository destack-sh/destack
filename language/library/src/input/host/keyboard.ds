import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/host";

/// Physical key location.
export enum KeyLocation {
    /// Standard key position.
    Standard = 0,
    /// Left-side modifier or duplicate key.
    Left = 1,
    /// Right-side modifier or duplicate key.
    Right = 2,
    /// Numpad key position.
    Numpad = 3,
}

/// Keyboard modifier and lock state.
export struct ModifierState {
    /// Whether Alt is active.
    isAlt: boolean;
    /// Whether AltGraph is active.
    isAltGraph: boolean;
    /// Whether Caps Lock is active.
    isCapsLock: boolean;
    /// Whether Control is active.
    isControl: boolean;
    /// Whether Fn is active.
    isFn: boolean;
    /// Whether Fn Lock is active.
    isFnLock: boolean;
    /// Whether Meta is active.
    isMeta: boolean;
    /// Whether Num Lock is active.
    isNumLock: boolean;
    /// Whether Scroll Lock is active.
    isScrollLock: boolean;
    /// Whether Shift is active.
    isShift: boolean;
    /// Whether Symbol is active.
    isSymbol: boolean;
    /// Whether Symbol Lock is active.
    isSymbolLock: boolean;
}

/// Keyboard layout descriptor.
export struct KeyboardLayout {
    /// Stable host layout identifier when available.
    id?: string;
    /// Display name for the active layout when available.
    name?: string;
    /// BCP 47 locale tag when available.
    locale?: string;
    /// Host variant identifier when available.
    variant?: string;
}

/// Keyboard state snapshot.
export struct KeyboardState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the host stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Host modifier bitset.
    hostModifiers: uint32;
    /// Keyboard modifier and lock state.
    modifiers: ModifierState;
    /// Normalized physical codes currently pressed.
    pressedCodes: Array<string>;
    /// Normalized logical keys currently pressed.
    pressedKeys: Array<string>;
    /// Host key codes currently pressed.
    pressedHostCodes: Array<uint32>;
    /// Host hardware scan codes currently pressed when available.
    pressedScanCodes: Array<uint32>;
    /// Active layout when available.
    layout?: KeyboardLayout;
    /// Whether the keyboard is currently within one active composition session.
    isComposing: boolean;
}

/// Keyboard binding family.
export interface InputKeyboard {
    /// Read one keyboard state snapshot.
    @binding("destack.input.keyboard.state.read", {
        effect: "external",
        requires: ["host.input.keyboard"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readKeyboardState(device: InputDeviceHandle): Result<KeyboardState, HostError>;

    /// Query keyboard layout metadata.
    @binding("destack.input.keyboard.layout.read", {
        effect: "external",
        requires: ["host.input.keyboard"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readKeyboardLayout(device: InputDeviceHandle): Result<KeyboardLayout, HostError>;
}
