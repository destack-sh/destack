import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { Path } from "destack:fs/host";

/// Clipboard item representation kind.
export enum ClipboardRepresentationKind {
    /// Text payload.
    Text = 1,
    /// Filesystem payload.
    File = 2,
    /// Arbitrary byte payload.
    Bytes = 3,
}

/// Clipboard presentation style.
export enum ClipboardPresentationStyle {
    /// No presentation preference.
    Unspecified = 0,
    /// Inline presentation.
    Inline = 1,
    /// Attachment presentation.
    Attachment = 2,
}

/// Clipboard representation descriptor.
export struct ClipboardRepresentation {
    /// MIME type or host-native format identifier.
    mimeType: string;
    /// Representation kind.
    kind: ClipboardRepresentationKind;
    /// Suggested representation name when available.
    name?: string;
    /// Whether a filesystem representation refers to a directory.
    isDirectory: boolean;
    /// Representation length in bytes when available.
    byteLength?: uint64;
}

/// Clipboard item descriptor.
export struct ClipboardItem {
    /// Presentation preference.
    presentationStyle: ClipboardPresentationStyle;
    /// Available representations in provider order.
    representations: Array<ClipboardRepresentation>;
}

/// Clipboard text payload.
export struct ClipboardPayloadText {
    /// Payload discriminator.
    kind: "text";
    /// MIME type or host-native format identifier.
    mimeType: string;
    /// Suggested representation name when available.
    name?: string;
    /// Text payload.
    text: string;
}

/// Clipboard file payload.
export struct ClipboardPayloadFile {
    /// Payload discriminator.
    kind: "file";
    /// MIME type or host-native format identifier.
    mimeType: string;
    /// Suggested representation name when available.
    name?: string;
    /// Filesystem payload.
    path: Path;
    /// Whether the filesystem payload refers to a directory.
    isDirectory: boolean;
}

/// Clipboard byte payload.
export struct ClipboardPayloadBytes {
    /// Payload discriminator.
    kind: "bytes";
    /// MIME type or host-native format identifier.
    mimeType: string;
    /// Suggested representation name when available.
    name?: string;
    /// Byte payload.
    bytes: Array<uint8>;
}

/// Clipboard representation payload.
@derive(Tagged)
export newtype ClipboardPayload =
    | ClipboardPayloadText
    | ClipboardPayloadFile
    | ClipboardPayloadBytes;

/// Clipboard item payload.
export struct ClipboardWriteItem {
    /// Presentation preference.
    presentationStyle: ClipboardPresentationStyle;
    /// Representations to publish in provider order.
    payloads: Array<ClipboardPayload>;
}

/// Query whether text clipboard payload exists.
@binding("destack.input.clipboard.text.has", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function hasClipboardText(): Result<boolean, HostError>;

/// List clipboard items.
@binding("destack.input.clipboard.items.list", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listClipboardItems(): Result<Array<ClipboardItem>, HostError>;

/// Read one text clipboard payload.
@binding("destack.input.clipboard.text.read", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readClipboardText(): Result<^string, HostError>;

/// Read one clipboard item representation as text.
@binding("destack.input.clipboard.item.text.read", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readClipboardItemText(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<^string, HostError>;

/// Read one clipboard item representation as bytes.
@binding("destack.input.clipboard.item.bytes.read", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readClipboardItemBytes(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<Array<uint8>, HostError>;

/// Read one clipboard item representation as a filesystem path.
@binding("destack.input.clipboard.item.path.read", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readClipboardItemPath(
    itemIndex: uint32,
    representationIndex: uint32,
): Result<Path, HostError>;

/// Write one text clipboard payload.
@binding("destack.input.clipboard.text.write", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeClipboardText(text: &readonly string): Result<void, HostError>;

/// Write clipboard items.
@binding("destack.input.clipboard.items.write", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function writeClipboardItems(
    items: &readonly [ClipboardWriteItem],
): Result<void, HostError>;

/// Read the clipboard sequence number.
@binding("destack.input.clipboard.sequence.read", {
    effect: "external",
    requires: ["host.input.clipboard.read"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readClipboardSequence(): Result<uint64, HostError>;

/// Clear clipboard payloads.
@binding("destack.input.clipboard.clear", {
    effect: "external",
    replay: "forbidden",
    requires: ["host.input.clipboard.write"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function clearClipboard(): Result<void, HostError>;
