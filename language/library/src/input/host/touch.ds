import { Array } from "destack:collections";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/host";

/// Touch contact phase.
export enum TouchPhase {
    /// Contact began.
    Begin = 1,
    /// Contact moved.
    Move = 2,
    /// Contact ended.
    End = 3,
    /// Contact was canceled.
    Cancel = 4,
}

/// Touch contact snapshot.
export struct TouchContact {
    /// Host contact identifier.
    contactId: uint32;
    /// Contact phase.
    phase: TouchPhase;
    /// Contact x coordinate in host-native units.
    x: float64;
    /// Contact y coordinate in host-native units.
    y: float64;
    /// Contact pressure in the normalized range `[0, 1]` when available.
    pressure?: float64;
    /// Contact major radius in host-native units when available.
    radiusX?: float64;
    /// Contact minor radius in host-native units when available.
    radiusY?: float64;
    /// Contact tilt around the x axis in degrees when available.
    tiltX?: float64;
    /// Contact tilt around the y axis in degrees when available.
    tiltY?: float64;
}

/// Touch state snapshot.
export struct TouchState {
    /// Monotonic update timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the host stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Active contacts for this snapshot.
    contacts: Array<TouchContact>;
}

/// Read one touch state snapshot.
@binding("destack.input.touch.state.read", {
    effect: "external",
    requires: ["host.input.touch"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readTouchState(device: InputDeviceHandle): Result<TouchState, HostError>;
