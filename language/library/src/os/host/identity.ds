import { HostError } from "destack:error/host";

/// Operating-system identity.
export struct OsIdentity {
    /// Hostname string.
    hostname: string;
    /// Operating-system name.
    name: string;
    /// Operating-system release string.
    release: string;
    /// Machine architecture string.
    architecture: string;
}

/// Identity binding family.
export interface OsIdentity {
    /// Read operating-system identity.
    @binding("destack.os.identity.read", {
        effect: "external",
        requires: ["host.os.identity.read"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readOsIdentity(): Result<OsIdentity, HostError>;
}
