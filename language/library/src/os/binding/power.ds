import { HostError } from "destack:error/host";

/// Operating-system power source.
export enum OsPowerSource {
    /// External line power is active.
    External = 1,
    /// Battery power is active.
    Battery = 2,
    /// Power source is unknown.
    Unknown = 3,
}

/// Power binding family.
export interface OsPower {
    /// Read operating-system power source.
    @binding("destack.os.powerSource.read", {
        effect: "external",
        requires: ["host.os.power.read"],
        families: ["windows", "unix"],
        simulation: true,
    })
    readOsPowerSource(): Result<OsPowerSource, HostError>;
}
