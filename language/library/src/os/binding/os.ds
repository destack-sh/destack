import { OsCapacityBinding } from "./capacity.ds";
import { OsIdentityBinding } from "./identity.ds";
import { OsPowerBinding } from "./power.ds";
import { OsPressureBinding } from "./pressure.ds";

/// Operating system binding family.
@languageItem("os.OsBinding")
export interface OsBinding {
    /// Capacity bindings.
    readonly capacity: OsCapacityBinding;
    /// Identity bindings.
    readonly identity: OsIdentityBinding;
    /// Power bindings.
    readonly power: OsPowerBinding;
    /// Pressure bindings.
    readonly pressure: OsPressureBinding;
}
