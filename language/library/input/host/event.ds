import { Array } from "destack:collections";
import { WindowHandle } from "destack:display/host";
import { HostError } from "destack:error/host";
import { InputDeviceHandle } from "destack:input/host";
import { ResourceId } from "destack:runtime/resource";

import { InputDevice, InputDeviceKind } from "./device.ds";
import { GamepadControl, GamepadControlKind } from "./gamepad.ds";
import { KeyLocation, ModifierState } from "./keyboard.ds";
import {
    CoordinateSpace,
    PenState,
    PointerContact,
    PointerKind,
    PointerSample,
    WheelUnit,
} from "./pointer.ds";
import { SensorKind } from "./sensor.ds";

/// Handle for one input event subscription.
export newtype InputEventHandle = ResourceId;

/// Input event flags.
export newtype InputEventFlags = uint64;

/// Subscribe to device topology events.
export const INPUT_EVENT_DEVICE: InputEventFlags = InputEventFlags(0x0001);

/// Subscribe to keyboard events.
export const INPUT_EVENT_KEYBOARD: InputEventFlags = InputEventFlags(0x0002);

/// Subscribe to pointer events.
export const INPUT_EVENT_POINTER: InputEventFlags = InputEventFlags(0x0004);

/// Subscribe to touch events.
export const INPUT_EVENT_TOUCH: InputEventFlags = InputEventFlags(0x0008);

/// Subscribe to gamepad events.
export const INPUT_EVENT_GAMEPAD: InputEventFlags = InputEventFlags(0x0010);

/// Subscribe to sensor events.
export const INPUT_EVENT_SENSOR: InputEventFlags = InputEventFlags(0x0020);

/// Subscribe to text events.
export const INPUT_EVENT_TEXT: InputEventFlags = InputEventFlags(0x0040);

/// Input event overflow policy.
export enum InputEventOverflow {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report queue overflow as an error.
    Error = 3,
}

/// Input event decoding mode.
export enum InputEventMode {
    /// Host-translated event stream.
    Translated = 1,
    /// Raw hardware-style event stream.
    Raw = 2,
}

/// Input event subscription.
export struct InputEventSubscription {
    /// Event flags.
    flags: InputEventFlags;
    /// Device filter.
    device?: InputDeviceHandle;
    /// Device kind filter.
    deviceKind?: InputDeviceKind;
    /// Window filter.
    window?: WindowHandle;
    /// Event decoding mode.
    mode: InputEventMode;
    /// Queue capacity in events, or zero for the host default.
    capacity: uint32;
    /// Queue overflow policy.
    overflow: InputEventOverflow;
}

/// Input event action.
export enum InputEventAction {
    /// A control became active.
    Press = 1,
    /// A control became inactive.
    Release = 2,
    /// A control repeated while held.
    Repeat = 3,
    /// A continuous control moved.
    Move = 4,
    /// A scroll axis changed.
    Scroll = 5,
    /// An analog axis changed.
    Axis = 6,
    /// A text payload was emitted.
    Text = 7,
    /// A source became available.
    Connect = 8,
    /// A source became unavailable.
    Disconnect = 9,
    /// A source changed.
    Change = 10,
    /// A gesture, composition, or contact was canceled.
    Cancel = 11,
    /// A composite operation started.
    Begin = 12,
    /// A composite operation updated.
    Update = 13,
    /// A composite operation committed.
    Commit = 14,
    /// A composite operation ended.
    End = 15,
}

/// Input event header.
export struct InputEventHeader {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the stream.
    sequence: uint64;
    /// Number of events dropped before this event.
    droppedCount: uint64;
    /// Stable source device identifier.
    deviceId?: string;
    /// Target window when the event was routed to a window.
    window?: WindowHandle;
}

/// Input device event.
export struct InputEventDevice {
    /// Event discriminator.
    kind: "device";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Device descriptor.
    device: InputDevice;
}

/// Input key event.
export struct InputEventKey {
    /// Event discriminator.
    kind: "key";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Logical key value when available.
    key?: string;
    /// Physical key code when available.
    code?: string;
    /// Key location.
    location: KeyLocation;
    /// Host-native key code.
    hostCode: uint32;
    /// Host-native scan code when available.
    hostScanCode?: uint32;
    /// Host-native key value.
    hostValue: int64;
    /// Host-native modifier bitset.
    hostModifiers: uint32;
    /// Canonical modifier state.
    modifiers: ModifierState;
    /// Whether the event is a repeat.
    isRepeat: boolean;
    /// Whether the key event belongs to composition.
    isComposing: boolean;
}

/// Input pointer move event.
export struct InputEventPointerMove {
    /// Event discriminator.
    kind: "pointerMove";
    /// Shared event header.
    header: InputEventHeader;
    /// Stable pointer identifier.
    pointerId: uint64;
    /// Pointer kind.
    pointerKind: PointerKind;
    /// Whether this is the primary pointer for its kind.
    isPrimary: boolean;
    /// Coordinate space.
    space: CoordinateSpace;
    /// Pointer x coordinate.
    x: float64;
    /// Pointer y coordinate.
    y: float64;
    /// Relative x delta.
    deltaX: float64;
    /// Relative y delta.
    deltaY: float64;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Host-native pressed-button bitset.
    hostButtons: uint32;
    /// Keyboard modifier and lock state.
    modifiers: ModifierState;
    /// Contact geometry when available.
    contact?: PointerContact;
    /// Pen state when available.
    pen?: PenState;
    /// Coalesced pointer samples.
    coalesced: Array<PointerSample>;
    /// Predicted pointer samples.
    predicted: Array<PointerSample>;
}

/// Input pointer button event.
export struct InputEventPointerButton {
    /// Event discriminator.
    kind: "pointerButton";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Stable pointer identifier.
    pointerId: uint64;
    /// Pointer kind.
    pointerKind: PointerKind;
    /// Whether this is the primary pointer for its kind.
    isPrimary: boolean;
    /// Canonical button index when available.
    button?: int16;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Host-native button code.
    hostCode: uint32;
    /// Host-native button value.
    hostValue: int64;
    /// Pointer x coordinate.
    x: float64;
    /// Pointer y coordinate.
    y: float64;
    /// Coordinate space.
    space: CoordinateSpace;
    /// Keyboard modifier and lock state.
    modifiers: ModifierState;
    /// Contact geometry when available.
    contact?: PointerContact;
    /// Pen state when available.
    pen?: PenState;
}

/// Input wheel event.
export struct InputEventWheel {
    /// Event discriminator.
    kind: "wheel";
    /// Shared event header.
    header: InputEventHeader;
    /// Stable pointer identifier when available.
    pointerId?: uint64;
    /// Pointer kind when available.
    pointerKind?: PointerKind;
    /// Wheel delta unit.
    unit: WheelUnit;
    /// Wheel x delta.
    deltaX: float64;
    /// Wheel y delta.
    deltaY: float64;
    /// Pointer x coordinate.
    x: float64;
    /// Pointer y coordinate.
    y: float64;
    /// Coordinate space.
    space: CoordinateSpace;
    /// Canonical pressed-button bitset.
    buttons: uint32;
    /// Keyboard modifier and lock state.
    modifiers: ModifierState;
}

/// Input touch event.
export struct InputEventTouch {
    /// Event discriminator.
    kind: "touch";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Stable pointer identifier.
    pointerId: uint64;
    /// Whether this is the primary touch point.
    isPrimary: boolean;
    /// Touch x coordinate.
    x: float64;
    /// Touch y coordinate.
    y: float64;
    /// Coordinate space.
    space: CoordinateSpace;
    /// Touch pressure when available.
    pressure?: float64;
    /// Contact geometry when available.
    contact?: PointerContact;
    /// Touch tilt around the x axis when available.
    tiltX?: float64;
    /// Touch tilt around the y axis when available.
    tiltY?: float64;
    /// Touch rotation when available.
    twist?: float64;
}

/// Input gamepad event.
export struct InputEventGamepad {
    /// Event discriminator.
    kind: "gamepad";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Gamepad control kind.
    controlKind: GamepadControlKind;
    /// Gamepad control selector.
    control: GamepadControl;
    /// Host-native control code.
    hostCode: uint32;
    /// Host-native control value.
    hostValue: int64;
    /// Normalized control value.
    value: float64;
    /// Whether the control is pressed.
    isPressed: boolean;
    /// Whether the control is touched.
    isTouched: boolean;
}

/// Input sensor event.
export struct InputEventSensor {
    /// Event discriminator.
    kind: "sensor";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Sensor kind.
    sensor: SensorKind;
    /// Host-native sensor code.
    hostCode: uint32;
    /// Host-native sensor value.
    hostValue: int64;
    /// Sensor x component.
    x: float64;
    /// Sensor y component.
    y: float64;
    /// Sensor z component.
    z: float64;
    /// Sensor w component.
    w: float64;
}

/// Input text event.
export struct InputEventText {
    /// Event discriminator.
    kind: "text";
    /// Shared event header.
    header: InputEventHeader;
    /// Text payload.
    text: string;
    /// Whether the text belongs to composition.
    isComposing: boolean;
}

/// Input composition event.
export struct InputEventComposition {
    /// Event discriminator.
    kind: "composition";
    /// Shared event header.
    header: InputEventHeader;
    /// Event action.
    action: InputEventAction;
    /// Composition text payload.
    text: string;
    /// Selection start in UTF-16 code units when available.
    selectionStart?: uint32;
    /// Selection end in UTF-16 code units when available.
    selectionEnd?: uint32;
}

/// Input event.
@derive(Tagged)
export newtype InputEvent =
    | InputEventDevice
    | InputEventKey
    | InputEventPointerMove
    | InputEventPointerButton
    | InputEventWheel
    | InputEventTouch
    | InputEventGamepad
    | InputEventSensor
    | InputEventText
    | InputEventComposition;

/// Open an input event subscription.
@binding("destack.input.event.open", {
    effect: "external",
    requires: ["host.input.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function openInputEvents(
    subscription: &readonly InputEventSubscription,
): Result<InputEventHandle, HostError>;

/// Close an input event subscription.
@binding("destack.input.event.close", {
    effect: "external",
    requires: ["host.input.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function closeInputEvents(events: InputEventHandle): Result<void, HostError>;

/// Read input events.
@binding("destack.input.event.read", {
    effect: "external",
    requires: ["host.input.event"],
    families: ["windows", "unix"],
    simulation: true,
    affinity: "worker",
})
export declare function readInputEvents(
    events: InputEventHandle,
    maxEvents: uint32,
    timeoutNs?: uint64,
): Result<Array<InputEvent>, HostError>;
