import { ResourceId } from "destack:runtime/resource";
import { Array } from "destack:collections";
import { HostError } from "destack:error/host";

/// Handle for one input device endpoint.
export newtype InputDeviceHandle = ResourceId;

/// Input device kind.
export enum InputDeviceKind {
    /// Keyboard device.
    Keyboard = 1,
    /// Mouse device.
    Mouse = 2,
    /// Touch device.
    Touch = 3,
    /// Gamepad or joystick device.
    Gamepad = 4,
    /// Pen or tablet device.
    Pen = 5,
    /// Motion or environment sensor attached to input hardware.
    Sensor = 6,
    /// Host did not classify the device.
    Unknown = 255,
}

/// Input device list flags.
export newtype InputDeviceListFlags = uint32;

/// Include disconnected devices when the host reports them.
export const INPUT_DEVICE_LIST_DISCONNECTED: InputDeviceListFlags = InputDeviceListFlags(0x01);

/// Include virtual and emulated devices.
export const INPUT_DEVICE_LIST_VIRTUAL: InputDeviceListFlags = InputDeviceListFlags(0x02);

/// Include raw devices separately from translated endpoints.
export const INPUT_DEVICE_LIST_RAW: InputDeviceListFlags = InputDeviceListFlags(0x04);

/// Input device capability flags.
export newtype InputDeviceCapabilities = uint64;

/// Device can emit keyboard events.
export const INPUT_DEVICE_KEYBOARD: InputDeviceCapabilities = InputDeviceCapabilities(0x0001);

/// Device can emit pointer events.
export const INPUT_DEVICE_POINTER: InputDeviceCapabilities = InputDeviceCapabilities(0x0002);

/// Device can emit touch events.
export const INPUT_DEVICE_TOUCH: InputDeviceCapabilities = InputDeviceCapabilities(0x0004);

/// Device can emit pen events.
export const INPUT_DEVICE_PEN: InputDeviceCapabilities = InputDeviceCapabilities(0x0008);

/// Device can emit gamepad state.
export const INPUT_DEVICE_GAMEPAD: InputDeviceCapabilities = InputDeviceCapabilities(0x0010);

/// Device can emit text or composition events.
export const INPUT_DEVICE_TEXT: InputDeviceCapabilities = InputDeviceCapabilities(0x0020);

/// Device can emit sensor samples.
export const INPUT_DEVICE_SENSOR: InputDeviceCapabilities = InputDeviceCapabilities(0x0040);

/// Device can play haptic effects.
export const INPUT_DEVICE_HAPTICS: InputDeviceCapabilities = InputDeviceCapabilities(0x0080);

/// Device can be exclusively grabbed.
export const INPUT_DEVICE_EXCLUSIVE: InputDeviceCapabilities = InputDeviceCapabilities(0x0100);

/// Input device query.
export struct InputDeviceQuery {
    /// Device kind filter when present.
    kind?: InputDeviceKind;
    /// List behavior flags.
    flags: InputDeviceListFlags;
}

/// Input device descriptor.
export struct InputDevice {
    /// Stable input device identifier.
    id: string;
    /// Stable instance identifier for the current connection.
    instanceId?: string;
    /// Host hardware identifier when available.
    hardwareId?: string;
    /// Host serial number when available.
    serialNumber?: string;
    /// Host location identifier when available.
    locationId?: string;
    /// Gamepad-style GUID when available.
    guid?: string;
    /// Host-visible device name.
    name: string;
    /// Host transport name when available.
    transport?: string;
    /// Device kind.
    kind: InputDeviceKind;
    /// USB or Bluetooth vendor identifier when available.
    vendorId?: uint16;
    /// USB or Bluetooth product identifier when available.
    productId?: uint16;
    /// Logical key count when reported by the host.
    keyCount?: uint16;
    /// Logical button count when reported by the host.
    buttonCount?: uint16;
    /// Logical axis count when reported by the host.
    axisCount?: uint16;
    /// Capability flags.
    capabilities: InputDeviceCapabilities;
    /// Whether this device is currently connected.
    isConnected: boolean;
    /// Whether this device is virtual or emulated.
    isVirtual: boolean;
    /// Whether this device is provided by the system stack.
    isSystem: boolean;
}

/// Input axis descriptor.
export struct InputAxis {
    /// Host-native axis code.
    code: uint32;
    /// Minimum normalized axis value.
    minimum: float64;
    /// Maximum normalized axis value.
    maximum: float64;
    /// Neutral dead-zone width when reported by the host.
    flat: float64;
    /// Noise threshold when reported by the host.
    fuzz: float64;
    /// Unit resolution when reported by the host.
    resolution: float64;
}

/// Input button descriptor.
export struct InputButton {
    /// Host-native button code.
    code: uint32;
    /// Whether this button reports analog values.
    isAnalog: boolean;
}

/// Input device controls.
export struct InputDeviceControls {
    /// Axis descriptors in host order.
    axes: Array<InputAxis>;
    /// Button descriptors in host order.
    buttons: Array<InputButton>;
}

/// List input devices.
@binding("destack.input.device.list", {
    effect: "external",
    requires: ["host.input.device"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function listInputDevices(
    query: &readonly InputDeviceQuery,
): Result<Array<InputDevice>, HostError>;

/// Open one input device.
@binding("destack.input.device.open", {
    effect: "external",
    requires: ["host.input.device"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function openInputDevice(id: &readonly string): Result<InputDeviceHandle, HostError>;

/// Close one input device.
@binding("destack.input.device.close", {
    effect: "external",
    requires: ["host.input.device"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function closeInputDevice(device: InputDeviceHandle): Result<void, HostError>;

/// Describe one input device.
@binding("destack.input.device.describe", {
    effect: "external",
    requires: ["host.input.device"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function describeInputDevice(device: InputDeviceHandle): Result<InputDevice, HostError>;

/// Query controls for one input device.
@binding("destack.input.device.controls.read", {
    effect: "external",
    requires: ["host.input.device"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function readInputDeviceControls(
    device: InputDeviceHandle,
): Result<InputDeviceControls, HostError>;

/// Enable or disable exclusive device grab.
@binding("destack.input.device.grab", {
    effect: "external",
    requires: ["host.input.grab"],
    families: ["windows", "unix"],
    simulation: true,
})
export declare function grabInputDevice(
    device: InputDeviceHandle,
    isEnabled: boolean,
): Result<void, HostError>;
