/// Count leading zeros in an integer.
///
/// Returns the number of leading zero bits in the binary representation.
/// For a zero value, returns the bit width of the type.
@intrinsic("math.bits.leadingZeroCount")
export declare function clz<T: int>(value: T): uint32;

/// Count trailing zeros in an integer.
///
/// Returns the number of trailing zero bits in the binary representation.
/// For a zero value, returns the bit width of the type.
@intrinsic("math.bits.trailingZeroCount")
export declare function ctz<T: int>(value: T): uint32;

/// Population count (count of set bits).
///
/// Returns the number of bits set to 1 in the binary representation.
@intrinsic("math.bits.populationCount")
export declare function popcnt<T: int>(value: T): uint32;

/// Byte swap (endianness conversion).
///
/// Reverses the byte order of an integer.
/// Converts between big-endian and little-endian representations.
@intrinsic("math.bits.byteSwap")
export declare function byteSwap<T: int>(value: T): T;

/// Reverse all bits.
///
/// Reverses the bit order within the integer.
/// The MSB becomes the LSB and vice versa.
@intrinsic("math.bits.bitReverse")
export declare function bitReverse<T: int>(value: T): T;

/// Rotate bits left.
///
/// Rotates the bits of `value` left by `amount` positions.
/// Bits that overflow on the left wrap around to the right.
@intrinsic("math.bits.rotateLeft")
export declare function rotateLeft<T: int>(value: T, amount: uint32): T;

/// Rotate bits right.
///
/// Rotates the bits of `value` right by `amount` positions.
/// Bits that overflow on the right wrap around to the left.
@intrinsic("math.bits.rotateRight")
export declare function rotateRight<T: int>(value: T, amount: uint32): T;
