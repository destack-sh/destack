import { todo } from "destack:error";
import { MaybeOwned, MaybeUninit, Unique } from "destack:memory";
import {
    Add,
    And,
    Compare,
    Divide,
    Equal,
    Multiply,
    Not,
    Or,
    Ordering,
    Power,
    Remainder,
    ShiftLeft,
    ShiftRight,
    Subtract,
    Xor,
} from "destack:ops";

import { NumberFormatOptions } from "./number.ds";

/// Arbitrary-precision integer.
@languageItem("math.BigInt")
export class BigInt {
    /// The sign of this integer.
    private sign: int8 = 0;

    /// The little-endian limb storage.
    private limbs: Unique<[MaybeUninit<uint64>]>;

    /// The initialized limb count.
    private initializedLength: usize = 0;

    /// The allocated limb count.
    private capacity: usize = 0;
}

extension of BigInt implements
    Add<bigint>,
    And<bigint>,
    Compare<bigint>,
    Divide<bigint>,
    Equal<bigint>,
    Multiply<bigint>,
    Not,
    Or<bigint>,
    Power<bigint>,
    Remainder<bigint>,
    ShiftLeft<usize>,
    ShiftRight<usize>,
    Subtract<bigint>,
    Xor<bigint> {
    /// The arithmetic result type.
    type Output = bigint;

    /// Return zero.
    static zero(): bigint {
        todo("BigInt.zero")
    }

    /// Return one.
    static one(): bigint {
        todo("BigInt.one")
    }

    /// Convert `value` to a bigint.
    static from(value: string | number | bigint): bigint {
        todo("BigInt.from")
    }

    /// Parse a bigint from `text`.
    static parse(text: string, radix?: number): bigint {
        todo("BigInt.parse")
    }

    /// Return the signed low bits of `value`.
    static asIntN(bits: number, value: bigint): bigint {
        todo("BigInt.asIntN")
    }

    /// Return the unsigned low bits of `value`.
    static asUintN(bits: number, value: bigint): bigint {
        todo("BigInt.asUintN")
    }

    /// Return whether this integer is zero.
    get isZero(): boolean {
        todo("BigInt.isZero")
    }

    /// Return whether this integer is negative.
    get isNegative(): boolean {
        todo("BigInt.isNegative")
    }

    /// Return the absolute value.
    abs(this: &readonly bigint): bigint {
        todo("BigInt.abs")
    }

    /// Return the greatest common divisor with `other`.
    gcd(this: &readonly bigint, other: bigint): bigint {
        todo("BigInt.gcd")
    }

    /// Return the least common multiple with `other`.
    lcm(this: &readonly bigint, other: bigint): bigint {
        todo("BigInt.lcm")
    }

    /// Return -1, 0, or 1 according to this integer's sign.
    signum(this: &readonly bigint): int32 {
        todo("BigInt.signum")
    }

    /// Return a float64 approximation.
    toNumber(this: &readonly bigint): number {
        todo("BigInt.toNumber")
    }

    /// Return the primitive bigint value.
    valueOf(this: &readonly bigint): bigint {
        todo("BigInt.valueOf")
    }

    /// Return this integer as a string.
    toString(this: &readonly bigint, radix?: number): MaybeOwned<string> {
        todo("BigInt.toString")
    }

    /// Return this integer as a locale-aware string.
    toLocaleString(
        this: &readonly bigint,
        locales?: string | string[],
        options?: NumberFormatOptions,
    ): MaybeOwned<string> {
        todo("BigInt.toLocaleString")
    }

    /// Return whether this integer equals `other`.
    equal(this: &readonly bigint, other: bigint): boolean {
        todo("BigInt.equal")
    }

    /// Compare with `other`.
    compare(this: &readonly bigint, other: bigint): Ordering {
        todo("BigInt.compare")
    }

    /// Add `other`.
    add(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.add")
    }

    /// Subtract `other`.
    subtract(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.subtract")
    }

    /// Multiply by `other`.
    multiply(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.multiply")
    }

    /// Divide by `other`.
    divide(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.divide")
    }

    /// Return the remainder after division by `other`.
    remainder(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.remainder")
    }

    /// Raise this integer to `exponent`.
    power(this: &readonly bigint, exponent: bigint): this.Output {
        todo("BigInt.power")
    }

    /// Return the bitwise and with `other`.
    and(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.and")
    }

    /// Return the bitwise or with `other`.
    or(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.or")
    }

    /// Return the bitwise xor with `other`.
    xor(this: &readonly bigint, other: bigint): this.Output {
        todo("BigInt.xor")
    }

    /// Return the bitwise complement.
    not(this: &readonly bigint): this.Output {
        todo("BigInt.not")
    }

    /// Shift left by `amount`.
    shiftLeft(this: &readonly bigint, amount: usize): this.Output {
        todo("BigInt.shiftLeft")
    }

    /// Shift right by `amount`.
    shiftRight(this: &readonly bigint, amount: usize): this.Output {
        todo("BigInt.shiftRight")
    }
}
