import { todo } from "destack:error";
import { Multiply } from "destack:ops";
import { Vector2, Vector3, Vector4 } from "./linear.ds";

/// Two-by-two matrix in row-major field order.
export struct Matrix2<T: int | float> {
    /// First row, first column.
    m00: T;

    /// First row, second column.
    m01: T;

    /// Second row, first column.
    m10: T;

    /// Second row, second column.
    m11: T;
}

/// Three-by-three matrix in row-major field order.
export struct Matrix3<T: int | float> {
    /// First row.
    x: Vector3<T>;

    /// Second row.
    y: Vector3<T>;

    /// Third row.
    z: Vector3<T>;
}

/// Four-by-four matrix in row-major field order.
export struct Matrix4<T: int | float> {
    /// First row.
    x: Vector4<T>;

    /// Second row.
    y: Vector4<T>;

    /// Third row.
    z: Vector4<T>;

    /// Fourth row.
    w: Vector4<T>;
}

/// Two-by-two single-precision matrix.
export type Matrix2f = Matrix2<float32>;

/// Three-by-three single-precision matrix.
export type Matrix3f = Matrix3<float32>;

/// Four-by-four single-precision matrix.
export type Matrix4f = Matrix4<float32>;

/// Two-by-two double-precision matrix.
export type Matrix2d = Matrix2<float64>;

/// Three-by-three double-precision matrix.
export type Matrix3d = Matrix3<float64>;

/// Four-by-four double-precision matrix.
export type Matrix4d = Matrix4<float64>;

/// Two-by-two signed integer matrix.
export type Matrix2i = Matrix2<int32>;

/// Three-by-three signed integer matrix.
export type Matrix3i = Matrix3<int32>;

/// Four-by-four signed integer matrix.
export type Matrix4i = Matrix4<int32>;

extension<T: int | float> of Matrix2<T> implements Multiply<Matrix2<T>> {
    /// The arithmetic result type.
    type Output = Matrix2<T>;

    /// Return the identity matrix.
    static identity(): Matrix2<T> {
        todo("Matrix2.identity")
    }

    /// Return the determinant.
    determinant(): T {
        this.m00 * this.m11 - this.m01 * this.m10
    }

    /// Return the transposed matrix.
    transpose(): Matrix2<T> {
        Matrix2 { m00: this.m00, m01: this.m10, m10: this.m01, m11: this.m11 }
    }

    /// Multiply by `other`.
    multiply(other: Matrix2<T>): this.Output {
        Matrix2 {
            m00: this.m00 * other.m00 + this.m01 * other.m10,
            m01: this.m00 * other.m01 + this.m01 * other.m11,
            m10: this.m10 * other.m00 + this.m11 * other.m10,
            m11: this.m10 * other.m01 + this.m11 * other.m11,
        }
    }

    /// Transform `vector`.
    transform(vector: Vector2<T>): Vector2<T> {
        Vector2 {
            x: this.m00 * vector.x + this.m01 * vector.y,
            y: this.m10 * vector.x + this.m11 * vector.y,
        }
    }
}

extension<T: int | float> of Matrix3<T> {
    /// Return the identity matrix.
    static identity(): Matrix3<T> {
        todo("Matrix3.identity")
    }

    /// Return the transposed matrix.
    transpose(): Matrix3<T> {
        todo("Matrix3.transpose")
    }

    /// Transform `vector`.
    transform(vector: Vector3<T>): Vector3<T> {
        todo("Matrix3.transform")
    }
}

extension<T: int | float> of Matrix4<T> {
    /// Return the identity matrix.
    static identity(): Matrix4<T> {
        todo("Matrix4.identity")
    }

    /// Return the transposed matrix.
    transpose(): Matrix4<T> {
        todo("Matrix4.transpose")
    }

    /// Transform `vector`.
    transform(vector: Vector4<T>): Vector4<T> {
        todo("Matrix4.transform")
    }
}
