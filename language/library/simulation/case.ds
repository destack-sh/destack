import { todo } from "destack:error";

import { Body, SuiteBody } from "./context.ds";
import { Options } from "./options.ds";

/// Simulation registration argument after the name.
export type Argument = Body | Options;

/// Simulation suite argument after the name.
export type SuiteArgument = SuiteBody | Options;

/// Registered simulation case.
export struct Case {
    /// Case name.
    name: string;

    /// Case options.
    options?: Options;
}

/// Registered simulation suite.
export struct Suite {
    /// Suite name.
    name: string;

    /// Suite options.
    options?: Options;
}

/// Register one simulation case.
export function registerCase(name: string, argument?: Argument, body?: Body): void {
    todo("simulation.registerCase");
}

/// Register one simulation suite.
export function suite(name: string, argument?: SuiteArgument, body?: SuiteBody): void {
    todo("simulation.registerSuite");
}

/// Register one skipped simulation case.
export function caseSkip(name: string, body?: Body): void {
    registerCase(name, { skip: true }, body);
}

/// Register one focused simulation case.
export function caseOnly(name: string, body?: Body): void {
    registerCase(name, { only: true }, body);
}

/// Register one skipped simulation suite.
export function suiteSkip(name: string, body?: SuiteBody): void {
    suite(name, { skip: true }, body);
}

/// Register one focused simulation suite.
export function suiteOnly(name: string, body?: SuiteBody): void {
    suite(name, { only: true }, body);
}

export { registerCase as case };
