// test: goto_definition
// description: goto definition of functions and parameters

function add(a: int32, b: int32): int32 {
//       ^^^ def:add
//           ^ def:a
//                     ^ def:b
    a + b
//  ^ use:a -> def:a
//      ^ use:b -> def:b
}

const result = add(1, 2);
//             ^^^ use:add -> def:add
