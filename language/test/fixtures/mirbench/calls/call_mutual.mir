function callMutual(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 0int64
    jump b1(v1, v1)
b1(v2: int64, v3: int64):
    v4: boolean = int.ge.s v2, v0
    branch v4, b6(v3), b2
b2:
    v5: boolean = call isEven(v2): (int64) -> boolean
    branch v5, b3, b4
b3:
    v6: int64 = 1int64
    v7: int64 = int.add v3, v6
