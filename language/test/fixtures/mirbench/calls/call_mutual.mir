function isOdd(v0: int64): boolean {
b0(v0: int64):
    v1: int64 = 0int64
    v2: boolean = int.eq v0, v1
    branch v2, b2, b1
b1:
    v3: int64 = 1int64
    v4: int64 = int.sub v0, v3
    v5: boolean = call isEven(v4): (int64) -> boolean
    return v5
b2:
    v6: boolean = false
    return v6
}
function isEven(v0: int64): boolean {
b0(v0: int64):
    v1: int64 = 0int64
