
function @handle_get(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iadd v0, v1
    v3: i64 = iconst 3i64
    v4: i64 = imul v2, v3
    v5: i64 = iconst 7i64
    v6: i64 = iadd v4, v5
    return v6
}

function @handle_post(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = bxor v0, v1
    v3: i64 = iconst 11i64
    v4: i64 = iadd v2, v3
    v5: i64 = iconst 1i64
    v6: i64 = ishl v4, v5
    return v6
}

function @handle_put(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = isub v1, v0
    v3: i64 = iconst 5i64
    v4: i64 = iadd v2, v3
    v5: i64 = iconst 2i64
    v6: i64 = imul v4, v5
    return v6
}

function @handle_delete(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 1i64
    v3: i64 = ishl v0, v2
    v4: i64 = bxor v3, v1
    v5: i64 = iconst 13i64
    v6: i64 = iadd v4, v5
    return v6
}

function @request_router(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block3(v4), block2

// dispatch on route
block2:
    v6: i64 = iconst 1103515245i64
    v7: i64 = imul v3, v6
    v8: i64 = iconst 12345i64
    v9: i64 = iadd v7, v8
    v10: i64 = iconst 3i64
    v11: i64 = band v9, v10
    switch v11, block7, 0 => block4, 1 => block5, 2 => block6

// route handler get
block4:
    v12: i64 = call @handle_get(v3, v4)
    jump block8(v12, v3, v4)

// route handler post
block5:
    v13: i64 = call @handle_post(v3, v4)
    jump block8(v13, v3, v4)

// route handler put
block6:
    v14: i64 = call @handle_put(v3, v4)
    jump block8(v14, v3, v4)

// route handler delete
block7:
    v15: i64 = call @handle_delete(v3, v4)
    jump block8(v15, v3, v4)

// merge handlers, advance loop
block8(v16: i64, v17: i64, v18: i64):
    v19: i64 = iadd v18, v16
    v20: i64 = iconst 1i64
    v21: i64 = iadd v17, v20
    jump block1(v21, v19)

// return result
block3(v22: i64):
    v23: i64 = iconst 7i64
    v24: i64 = imul v0, v23
    v25: i64 = iadd v22, v24
    v26: i64 = iconst 3i64
    v27: i64 = iadd v25, v26
    v28: i64 = iconst 3i64
    v29: i64 = sshr v22, v28
    v30: i64 = bxor v27, v29
    v31: i64 = iconst 33i64
    v32: i64 = imul v30, v31
    v33: i64 = iconst 255i64
    v34: i64 = band v0, v33
    v35: i64 = iadd v32, v34
    return v35
}
