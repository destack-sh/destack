
function fanoutAdd(v0: int64, v1: int64): int64 {

// entry, init state
b0(v0: int64, v1: int64):
    v2: int64 = int.add v0, v1
    v3: int64 = 1int64
    v4: int64 = int.add v2, v3
    return v4
}

function fanoutMul(v0: int64, v1: int64): int64 {

// entry, init state
b0(v0: int64, v1: int64):
    v2: int64 = 3int64
    v3: int64 = int.mul v0, v2
    v4: int64 = int.add v3, v1
    return v4
}

function fanoutMix(v0: int64, v1: int64): int64 {

// entry, init state
b0(v0: int64, v1: int64):
    v2: int64 = int.xor v0, v1
    v3: int64 = 7int64
    v4: int64 = int.add v2, v3
    return v4
}

function fanoutHelper(v0: int64, v1: int64): int64 {

// entry, init state
b0(v0: int64, v1: int64):
    v2: int64 = int.add v0, v1
    return v2
}

function callgraphFanout(v0: int64, v1: int64, v2: (int64, int64) -> int64): int64  {
b0(v0: int64, v1: int64, v2: (int64, int64) -> int64):
    v3: int64 = 0int64
    v4: int64 = int.add v1, v3
    jump b1(v3, v4, v2)

// loop condition, check limit
b1(v5: int64, v6: int64, v7: (int64, int64) -> int64):
    v8: boolean = int.ge.s v5, v0
    branch v8, b5(v6), b2

// select a target
b2:
    v9: int64 = 3int64
    v10: int64 = int.rem.s v5, v9
    switch v10, b4, 0 => b3, 1 => b6, 2 => b4

// direct call add
b3:
    v11: int64 = call fanoutAdd(v5, v6): (int64, int64) -> int64
    jump b7(v11)

// direct call mix
b4:
    v12: int64 = call fanoutMix(v5, v6): (int64, int64) -> int64
    jump b7(v12)

// direct call multiply
b6:
    v13: int64 = call fanoutMul(v5, v6): (int64, int64) -> int64
    jump b7(v13)

// indirect call, advance loop
b7(v14: int64):
    v15: int64 = call.indirect v7(v14, v5): (int64, int64) -> int64
    v16: int64 = 1int64
    v17: int64 = int.add v5, v16
    jump b1(v17, v15, v7)

// return result
b5(v18: int64):
    v19: int64 = 7int64
    v20: int64 = int.mul v0, v19
    v21: int64 = int.add v18, v20
    v22: int64 = 3int64
    v23: int64 = int.add v21, v22
    v24: int64 = 3int64
    v25: int64 = int.shiftRight.s v18, v24
    v26: int64 = int.xor v23, v25
    v27: int64 = 33int64
    v28: int64 = int.mul v26, v27
    v29: int64 = 255int64
    v30: int64 = int.and v0, v29
    v31: int64 = int.add v28, v30
    return v31
}
