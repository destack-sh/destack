function callVtableDispatch(
    v0: int64,
    v1: int64,
    v2: (int64, int64) -> int64,
    v3: (int64, int64) -> int64,
    v4: (int64, int64) -> int64
) -> int64 {
b0(
    v0: int64,
    v1: int64,
    v2: (int64, int64) -> int64,
    v3: (int64, int64) -> int64,
    v4: (int64, int64) -> int64
):
    v5: int64 = 0int64
    v6: int64 = 0int64
    jump b1(v5, v6)

// loop condition, check limit
b1(v7: int64, v8: int64):
    v9: boolean = int.ge.s v7, v0
    branch v9, b3(v8), b2

// branch on condition
b2:
    v10: int64 = 1103515245int64
    v11: int64 = int.mul v7, v10
    v12: int64 = 12345int64
    v13: int64 = int.add v11, v12
    v14: int64 = 255int64
    v15: int64 = int.and v13, v14
    v16: int64 = 200int64
    v17: boolean = int.lt.s v15, v16
    branch v17, b4, b5

// merge branch, continue
b4:
    v18: int64 = call.indirect v2(v1, v8): (int64, int64) -> int64
    jump b8(v18, v7)

// branch on condition
b5:
    v19: int64 = 240int64
    v20: boolean = int.lt.s v15, v19
    branch v20, b6, b7

// merge branch, continue
b6:
    v21: int64 = call.indirect v3(v1, v8): (int64, int64) -> int64
    jump b8(v21, v7)

// merge branch, continue
b7:
    v22: int64 = call.indirect v4(v1, v8): (int64, int64) -> int64
    jump b8(v22, v7)

// merge branches, advance loop
b8(v23: int64, v24: int64):
    v25: int64 = 1int64
    v26: int64 = int.add v24, v25
    jump b1(v26, v23)

// return result
b3(v27: int64):
    return v27
}
