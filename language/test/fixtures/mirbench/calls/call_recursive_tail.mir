
function @countdown_rec(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 0i64
    v3: bool = icmp_eq v0, v2
    branch v3, block2, block1

// return helper result
block1:
    v4: i64 = iconst 1i64
    v5: i64 = isub v0, v4
    v6: i64 = iadd v1, v4
    v7: i64 = call @countdown_rec(v5, v6)
    return v7

// return result
block2:
    return v1
}

function @call_recursive_tail(v0: i64) -> i64 {

// entry, call helper
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = call @countdown_rec(v0, v1)
    return v2
}
