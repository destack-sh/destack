
function sum16(
    v0: int64, v1: int64, v2: int64, v3: int64, v4: int64, v5: int64, v6: int64, v7: int64,
    v8: int64, v9: int64, v10: int64, v11: int64, v12: int64, v13: int64, v14: int64, v15: int64
) -> int64 {
b0(
    v0: int64, v1: int64, v2: int64, v3: int64, v4: int64, v5: int64, v6: int64, v7: int64,
    v8: int64, v9: int64, v10: int64, v11: int64, v12: int64, v13: int64, v14: int64, v15: int64
):
    v16: int64 = int.add v0, v1
    v17: int64 = int.add v16, v2
    v18: int64 = int.add v17, v3
    v19: int64 = int.add v18, v4
    v20: int64 = int.add v19, v5
    v21: int64 = int.add v20, v6
    v22: int64 = int.add v21, v7
    v23: int64 = int.add v22, v8
    v24: int64 = int.add v23, v9
    v25: int64 = int.add v24, v10
    v26: int64 = int.add v25, v11
    v27: int64 = int.add v26, v12
    v28: int64 = int.add v27, v13
    v29: int64 = int.add v28, v14
    v30: int64 = int.add v29, v15
    return v30
}

function callManyArgs16(v0: int64): int64 {

// entry, init state
b0(v0: int64):
    v1: int64 = 0int64
    jump b1(v1, v1)

// loop condition, check limit
b1(v2: int64, v3: int64):
    v4: boolean = int.ge.s v2, v0
    branch v4, b3(v3), b2

// loop body, call helper
b2:
    v5: int64 = 1int64
    v6: int64 = 2int64
    v7: int64 = 3int64
    v8: int64 = 4int64
    v9: int64 = 5int64
    v10: int64 = 6int64
    v11: int64 = 7int64
    v12: int64 = 8int64
    v13: int64 = 9int64
    v14: int64 = 10int64
    v15: int64 = 11int64
    v16: int64 = 12int64
    v17: int64 = 13int64
    v18: int64 = 14int64
    v19: int64 = 15int64
    v20: int64 = 16int64
    v21: int64 = call sum16(v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20): (int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64, int64) -> int64
    v22: int64 = int.add v3, v21
    v23: int64 = 1int64
    v24: int64 = int.add v2, v23
    jump b1(v24, v22)

// return result
b3(v25: int64):
    return v25
}
