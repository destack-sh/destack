
function @method_add(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iadd v0, v1
    v3: i64 = iconst 1i64
    v4: i64 = iadd v2, v3
    return v4
}

