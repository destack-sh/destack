    v2: fn(i64, i64) -> i64,
    v3: fn(i64, i64) -> i64,
    v4: fn(i64, i64) -> i64
) -> i64 {
block0(
    v0: i64,
    v1: i64,
    v2: fn(i64, i64) -> i64,
    v3: fn(i64, i64) -> i64,
    v4: fn(i64, i64) -> i64
):
    v5: i64 = iconst 3i64
    v6: ref<managed fn(i64, i64) -> i64> = managed.alloc_array fn(i64, i64) -> i64, v5
    v7: i64 = iconst 0i64
    v8: ref<borrowed fn(i64, i64) -> i64> = element.addr v6, v7
    store v8, v2
    v9: i64 = iconst 1i64
    v10: ref<borrowed fn(i64, i64) -> i64> = element.addr v6, v9
    store v10, v3
    v11: i64 = iconst 2i64
    v12: ref<borrowed fn(i64, i64) -> i64> = element.addr v6, v11
    store v12, v4
    v13: i64 = iconst 0i64
    v14: i64 = iconst 0i64
    jump block1(v13, v14, v6)

// loop condition, check limit
block1(v15: i64, v16: i64, v17: ref<managed fn(i64, i64) -> i64>):
    v18: bool = icmp_sge v15, v0
    branch v18, block3(v16), block2

// loop body, update aggregates
block2:
    v19: i64 = iconst 1103515245i64
    v20: i64 = imul v15, v19
    v21: i64 = iconst 12345i64
    v22: i64 = iadd v20, v21
    v23: i64 = iconst 3i64
    v24: i64 = srem v22, v23
    v25: ref<borrowed fn(i64, i64) -> i64> = element.addr v17, v24
    v26: fn(i64, i64) -> i64 = load v25
    v27: i64 = call.indirect v26(v1, v16) -> fn(i64, i64) -> i64
    v28: i64 = iconst 1i64
    v29: i64 = iadd v15, v28
    jump block1(v29, v27, v17)

// return result
block3(v30: i64):
