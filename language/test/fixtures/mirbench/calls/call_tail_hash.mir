
function @hash_fold(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 0i64
    v3: bool = icmp_eq v0, v2
    branch v3, block2, block1

// block
block1:
    v4: i64 = iconst 1i64
    v5: i64 = isub v0, v4
    v6: i64 = iconst 33i64
    v7: i64 = imul v1, v6
    v8: i64 = sshr v1, v4
    v9: i64 = bxor v5, v8
    v10: i64 = iadd v7, v9
    tailcall @hash_fold(v5, v10)

// return result
block2:
    return v1
}

function @call_tail_hash(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 5381i64
    tailcall @hash_fold(v0, v1)
}
