
function stageAdd(v0: int64): int64 {

// entry, apply add
b0(v0: int64):
    v1: int64 = 2int64
    v2: int64 = int.add v0, v1
    return v2
}

function stageMul(v0: int64): int64 {

// entry, apply multiply
b0(v0: int64):
    v1: int64 = 3int64
    v2: int64 = int.mul v0, v1
    v3: int64 = 1int64
    v4: int64 = int.add v2, v3
    return v4
}

function stageMix(v0: int64): int64 {

// entry, apply mix
b0(v0: int64):
    v1: int64 = 7int64
    v2: int64 = int.xor v0, v1
    v3: int64 = 5int64
    v4: int64 = int.add v2, v3
    return v4
}

function callbackPipeline(v0: int64, v1: (int64) -> int64): int64  {
b0(v0: int64, v1: (int64) -> int64):
    v2: int64 = 0int64
    v3: int64 = 0int64
    jump b1(v2, v3, v1)

// loop condition, check limit
b1(v4: int64, v5: int64, v6: (int64) -> int64):
    v7: boolean = int.ge.s v4, v0
    branch v7, b3(v5), b2

// loop body, call pipeline
b2:
    v8: int64 = call stageAdd(v4): (int64) -> int64
    v9: int64 = call.indirect v6(v8): (int64) -> int64
    v10: int64 = call stageMul(v9): (int64) -> int64
    v11: int64 = int.add v5, v10
    v12: int64 = 1int64
    v13: int64 = int.add v4, v12
    jump b1(v13, v11, v6)

// return result
b3(v14: int64):
    v15: int64 = 7int64
    v16: int64 = int.mul v0, v15
    v17: int64 = int.add v14, v16
    v18: int64 = 3int64
    v19: int64 = int.add v17, v18
    v20: int64 = 3int64
    v21: int64 = int.shiftRight.s v14, v20
    v22: int64 = int.xor v19, v21
    v23: int64 = 33int64
    v24: int64 = int.mul v22, v23
    v25: int64 = 255int64
    v26: int64 = int.and v0, v25
    v27: int64 = int.add v24, v26
    return v27
}
