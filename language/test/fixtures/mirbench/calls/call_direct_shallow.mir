function @f5(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 1i64
    v2 = iadd v0, v1
    return v2
}

function @f4(v0: i64) -> i64 {

// entry, call helper
block0(v0: i64):
    v1 = call @f5(v0)
    return v1
}

function @f3(v0: i64) -> i64 {

// entry, call helper
block0(v0: i64):
    v1 = call @f4(v0)
    return v1
