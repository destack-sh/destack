function yieldLoop(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 0int64
    v2: int64 = 1int64
    jump b1(v1, v1)
b1(v3: int64, v4: int64):
    v5: boolean = int.ge.s v3, v0
    branch v5, b4(v4), b2(v3, v4)
b2(v6: int64, v7: int64):
    v8: int64 = int.add v6, v2
    yield v6, b3(v8, v7)
b3(v9: int64, v10: int64, v11: int64):
    v12: int64 = int.add v10, v11
    jump b1(v9, v12)
b4(v13: int64):
    return v13
}
