
function @yield_loop(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 1i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block4(v4), block2(v3, v4)

// loop body, yield index
block2(v6: i64, v7: i64):
    v8: i64 = iadd v6, v2
    yield v6, block3(v8, v7)

// resume, accumulate resume value
block3(v9: i64, v10: i64, v11: i64):
    v12: i64 = iadd v10, v11
    jump block1(v9, v12)

// return result
block4(v13: i64):
    return v13
}
