
function @sum8(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64):
    v8: i64 = iadd v0, v1
    v9: i64 = iadd v8, v2
    v10: i64 = iadd v9, v3
    v11: i64 = iadd v10, v4
    v12: i64 = iadd v11, v5
    v13: i64 = iadd v12, v6
    v14: i64 = iadd v13, v7
    return v14
}

function @call_many_args(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v2: i64, v3: i64):
    v4: bool = icmp_sge v2, v0
    branch v4, block3(v3), block2

// loop body, call helper
block2:
    v5: i64 = iconst 1i64
    v6: i64 = iconst 2i64
    v7: i64 = iconst 3i64
    v8: i64 = iconst 4i64
    v9: i64 = iconst 5i64
    v10: i64 = iconst 6i64
    v11: i64 = iconst 7i64
    v12: i64 = iconst 8i64
    v13: i64 = call @sum8(v5, v6, v7, v8, v9, v10, v11, v12)
    v14: i64 = iadd v3, v13
    v15: i64 = iadd v2, v5
    jump block1(v15, v14)

// return result
block3(v16: i64):
    return v16
}
