
function @stage1(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iadd v0, v1
    v3: i64 = iconst 3i64
    v4: i64 = imul v2, v3
    return v4
}

function @stage2(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = bxor v0, v1
    v3: i64 = iconst 5i64
    v4: i64 = iadd v2, v3
    return v4
}

function @stage3(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = isub v0, v1
    v3: i64 = iconst 2i64
    v4: i64 = imul v2, v3
    v5: i64 = iconst 11i64
    v6: i64 = iadd v4, v5
    return v6
}

function @stage4(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = bor v0, v1
    v3: i64 = iconst 13i64
    v4: i64 = iadd v2, v3
    v5: i64 = iconst 1i64
    v6: i64 = sshr v0, v5
    v7: i64 = bxor v4, v6
    return v7
}

function @stage5(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = band v0, v1
    v3: i64 = iconst 17i64
    v4: i64 = iadd v2, v3
    v5: i64 = iconst 1i64
    v6: i64 = ishl v4, v5
    return v6
}

function @stage6(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 19i64
    v3: i64 = iadd v0, v2
    v4: i64 = bxor v3, v1
    return v4
}

function @stage7(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 1i64
    v3: i64 = ishl v0, v2
    v4: i64 = bxor v3, v1
    v5: i64 = iconst 23i64
    v6: i64 = iadd v4, v5
    return v6
}

function @stage8(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 7i64
    v3: i64 = imul v0, v2
    v4: i64 = isub v3, v1
    v5: i64 = iconst 5i64
    v6: i64 = bxor v4, v5
    return v6
}

function @call_pipeline_chain(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 0i64
    jump block1(v2, v1)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, call helper
block2:
    v6: i64 = call @stage1(v4, v3)
    v7: i64 = call @stage2(v6, v3)
    v8: i64 = call @stage3(v7, v3)
    v9: i64 = call @stage4(v8, v3)
    v10: i64 = call @stage5(v9, v3)
    v11: i64 = call @stage6(v10, v3)
    v12: i64 = call @stage7(v11, v3)
    v13: i64 = call @stage8(v12, v3)
    v14: i64 = iconst 1i64
    v15: i64 = iadd v3, v14
    jump block1(v15, v13)

// return result
block3(v16: i64):
    return v16
}
