    v211: i64 = iadd v210, v207
    v212: i64 = iadd v211, v208
    v213: i64 = iadd v212, v209
    v214: i64 = iconst 7i64
    v215: i64 = imul v0, v214
    v216: i64 = iadd v213, v215
    v217: i64 = iconst 3i64
    v218: i64 = iadd v216, v217
    v219: i64 = iconst 3i64
