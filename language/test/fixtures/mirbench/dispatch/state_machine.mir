
function @state_machine(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    jump block1(v1, v1, v1)

// loop condition, check limit
block1(v2: i64, v3: i64, v4: i64):
    v5: bool = icmp_sge v2, v0
    branch v5, block5(v4), block2

// switch on selector
block2:
    switch v3, block3, 0 => block3, 1 => block6, 2 => block7

// update state, merge branch
block3:
    v6: i64 = iconst 1i64
    v7: i64 = iadd v4, v6
    v8: i64 = iconst 1i64
    jump block4(v8, v7)

// loop body, update accumulators
block6:
    v9: i64 = iconst 2i64
    v10: i64 = iadd v4, v9
    v11: i64 = iconst 2i64
    jump block4(v11, v10)

// loop body, update accumulators
block7:
    v12: i64 = iconst 3i64
    v13: i64 = iadd v4, v12
    v14: i64 = iconst 0i64
    jump block4(v14, v13)

// merge branches, advance loop
block4(v15: i64, v16: i64):
    v17: i64 = iconst 1i64
    v18: i64 = iadd v2, v17
    jump block1(v18, v15, v16)

// return result
block5(v19: i64):
    return v19
}
