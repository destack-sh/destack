function stateMachine(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 0int64
    jump b1(v1, v1, v1)
b1(v2: int64, v3: int64, v4: int64):
    v5: boolean = int.ge.s v2, v0
    branch v5, b7(v4), b2
b2:
    switch v3, b3, 0 => b3, 1 => b4, 2 => b5
b3:
    v6: int64 = 1int64
    v7: int64 = int.add v4, v6
    v8: int64 = 1int64
    jump b6(v8, v7)
b4:
    v9: int64 = 2int64
    v10: int64 = int.add v4, v9
    v11: int64 = 2int64
    jump b6(v11, v10)
b5:
    v12: int64 = 3int64
    v13: int64 = int.add v4, v12
    v14: int64 = 0int64
    jump b6(v14, v13)
b6(v15: int64, v16: int64):
    v17: int64 = 1int64
    v18: int64 = int.add v2, v17
    jump b1(v18, v15, v16)
b7(v19: int64):
