// return result
block20(v143: i64, v144: i64, v145: i64, v146: i64):
    v147: i64 = iadd v143, v144
    v148: i64 = iadd v147, v145
    v149: i64 = iadd v148, v146
    v150: i64 = iconst 7i64
    v151: i64 = imul v0, v150
    v152: i64 = iadd v149, v151
    v153: i64 = iconst 3i64
    v154: i64 = iadd v152, v153
    v155: i64 = iconst 3i64
    v156: i64 = sshr v149, v155
    v157: i64 = bxor v154, v156
    v158: i64 = iconst 33i64
    v159: i64 = imul v157, v158
    v160: i64 = iconst 255i64
    v161: i64 = band v0, v160
    v162: i64 = iadd v159, v161
