
function @loop_switch_mix(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block8(v4), block2

// compute selector
block2:
    v6: i64 = iconst 1103515245i64
    v7: i64 = imul v3, v6
    v8: i64 = iconst 12345i64
    v9: i64 = iadd v7, v8
    v10: i64 = iconst 6i64
    v11: i64 = srem v9, v10
    switch v11, block7, 0 => block3, 1 => block4, 2 => block5, 3 => block6, 4 => block9, 5 => block7

// case 0, linear step
block3:
    v12: i64 = iadd v4, v3
    v13: i64 = iconst 1i64
    jump block10(v12, v13)

// case 1, skip step
block4:
    v14: i64 = iconst 2i64
    v15: i64 = imul v3, v14
    v16: i64 = iadd v4, v15
    v17: i64 = iconst 2i64
    jump block10(v16, v17)

// case 2, offset step
block5:
    v18: i64 = iconst 7i64
    v19: i64 = iadd v3, v18
    v20: i64 = iadd v4, v19
    v21: i64 = iconst 1i64
    jump block10(v20, v21)

// case 3, xor delta
block6:
    v22: i64 = bxor v3, v4
    v23: i64 = iadd v4, v22
    v24: i64 = iconst 1i64
    jump block10(v23, v24)

// case 4, acc bias
block9:
    v25: i64 = iconst 3i64
    v26: i64 = iadd v4, v25
    v27: i64 = iadd v26, v3
    v28: i64 = iconst 2i64
    jump block10(v27, v28)

// default case, subtractive
block7:
    v29: i64 = isub v4, v3
    v30: i64 = iconst 1i64
    jump block10(v29, v30)

// merge branches, advance loop
block10(v31: i64, v32: i64):
    v33: i64 = iadd v3, v32
    jump block1(v33, v31)

// return result
block8(v34: i64):
    v35: i64 = iconst 7i64
    v36: i64 = imul v0, v35
    v37: i64 = iadd v34, v36
    v38: i64 = iconst 3i64
    v39: i64 = iadd v37, v38
    v40: i64 = iconst 3i64
    v41: i64 = sshr v34, v40
    v42: i64 = bxor v39, v41
    v43: i64 = iconst 33i64
    v44: i64 = imul v42, v43
    v45: i64 = iconst 255i64
    v46: i64 = band v0, v45
    v47: i64 = iadd v44, v46
    return v47
}
