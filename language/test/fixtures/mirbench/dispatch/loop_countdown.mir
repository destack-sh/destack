
function @loop_countdown(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: bool = icmp_eq v0, v1
    branch v2, block2, block1

// loop body, update accumulators
block1:
    v3: i64 = iconst 1i64
    v4: i64 = isub v0, v3
    jump block0(v4)

// return result
block2:
    return v0
}
