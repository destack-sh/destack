function @loop_nested(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v2: i64, v3: i64):
    v4 = icmp_sge v2, v0
    branch v4, block5(v3), block2

// merge branch, continue
block2:
    v5 = iconst 0i64
    jump block3(v5, v3)

// loop condition, check limit
block3(v6: i64, v7: i64):
    v8 = icmp_sge v6, v0
    branch v8, block4(v7), block6

// loop body, update accumulators
block6:
    v9 = iconst 1i64
    v10 = iadd v7, v9
    v11 = iadd v6, v9
    jump block3(v11, v10)

// loop body, update accumulators
block4(v12: i64):
    v13 = iconst 1i64
    v14 = iadd v2, v13
    jump block1(v14, v12)

// return result
block5(v15: i64):
    return v15
}
