function branchPredictable(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 0int64
    v2: int64 = 1int64
    jump b1(v1, v1)
b1(v3: int64, v4: int64):
    v5: boolean = int.ge.s v3, v0
    branch v5, b4(v4), b2
b2:
    v6: int64 = 1int64
    v7: boolean = int.gt.s v6, v1
    branch v7, b3, b3
b3:
    v8: int64 = int.add v4, v6
    v9: int64 = int.add v3, v6
    jump b1(v9, v8)
b4(v10: int64):
    return v10
}
