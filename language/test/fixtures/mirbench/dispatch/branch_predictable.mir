
function @branch_predictable(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 1i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block4(v4), block2

// branch on condition
block2:
    v6: i64 = iconst 1i64
    v7: bool = icmp_sgt v6, v1
    branch v7, block3, block3

// merge branches, advance loop
block3:
    v8: i64 = iadd v4, v6
    v9: i64 = iadd v3, v6
    jump block1(v9, v8)

// return result
block4(v10: i64):
    return v10
}
