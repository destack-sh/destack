function @query_string_scan(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    v5: i64 = iconst 0i64
    v6: i64 = iconst 0i64
    jump block1(v1, v2, v3, v4, v5, v6)

// loop condition, check limit
block1(v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64):
    v13: bool = icmp_sge v7, v0
    branch v13, block16(v8, v9, v10, v11, v12), block2(v7, v8, v9, v10, v11, v12)

// compute token
block2(v14: i64, v15: i64, v16: i64, v17: i64, v18: i64, v19: i64):
    v20: i64 = iconst 1664525i64
    v21: i64 = imul v14, v20
    v22: i64 = iconst 1013904223i64
    v23: i64 = iadd v21, v22
    v24: i64 = iconst 6i64
    v25: i64 = srem v23, v24
    switch v25, block7(v14, v15, v16, v17, v18, v19, v25), 0 => block3(v14, v15, v16, v17, v18, v19), 1 => block6(v14, v15, v16, v17, v18, v19)

// amp token
block3(v26: i64, v27: i64, v28: i64, v29: i64, v30: i64, v31: i64):
    v32: i64 = iconst 0i64
    v33: bool = icmp_eq v30, v32
    branch v33, block4(v26, v27, v28, v29, v31), block5(v26, v27, v28, v29, v31)

// amp in key mode
block4(v34: i64, v35: i64, v36: i64, v37: i64, v38: i64):
    v39: i64 = iconst 0i64
    v40: bool = icmp_eq v36, v39
    branch v40, block18(v34, v35, v36, v37, v39, v38), block8(v34, v35, v36, v37, v38)

// amp in value mode
block5(v41: i64, v42: i64, v43: i64, v44: i64, v45: i64):
    v46: i64 = iadd v42, v43
    v47: i64 = iadd v46, v44
    v48: i64 = iconst 1i64
    v49: i64 = iadd v45, v48
    v50: i64 = iconst 0i64
    jump block18(v41, v47, v50, v50, v50, v49)

// eq token
block6(v51: i64, v52: i64, v53: i64, v54: i64, v55: i64, v56: i64):
    v57: i64 = iconst 0i64
    v58: bool = icmp_eq v55, v57
    branch v58, block9(v51, v52, v53, v54, v56), block10(v51, v52, v53, v54, v55, v56)

// default token
block7(v59: i64, v60: i64, v61: i64, v62: i64, v63: i64, v64: i64, v65: i64):
    v66: i64 = iconst 0i64
    v67: bool = icmp_eq v63, v66
    branch v67, block11(v59, v60, v61, v62, v64, v65), block12(v59, v60, v61, v62, v63, v64, v65)

// flush key on amp
block8(v68: i64, v69: i64, v70: i64, v71: i64, v72: i64):
    v73: i64 = iadd v69, v70
    v74: i64 = iconst 1i64
    v75: i64 = iadd v72, v74
    v76: i64 = iconst 0i64
    jump block18(v68, v73, v76, v76, v76, v75)

// eq in key mode
block9(v77: i64, v78: i64, v79: i64, v80: i64, v81: i64):
    v82: i64 = iconst 1i64
    v83: i64 = iadd v78, v82
    v84: i64 = iconst 1i64
    jump block18(v77, v83, v79, v80, v84, v81)

// eq in value mode
block10(v85: i64, v86: i64, v87: i64, v88: i64, v89: i64, v90: i64):
    v91: i64 = iconst 1i64
    v92: i64 = iadd v88, v91
    jump block18(v85, v86, v87, v92, v89, v90)

// default in key mode
block11(v93: i64, v94: i64, v95: i64, v96: i64, v97: i64, v98: i64):
    v99: i64 = iconst 1i64
    v100: i64 = iadd v95, v99
    v101: i64 = iadd v94, v98
    v102: i64 = iconst 0i64
    jump block18(v93, v101, v100, v96, v102, v97)

// default in value mode
block12(v103: i64, v104: i64, v105: i64, v106: i64, v107: i64, v108: i64, v109: i64):
    v110: i64 = iconst 1i64
    v111: i64 = iadd v106, v110
    v112: i64 = iadd v104, v109
    jump block18(v103, v112, v105, v111, v107, v108)

// advance loop
block18(v113: i64, v114: i64, v115: i64, v116: i64, v117: i64, v118: i64):
    v119: i64 = iconst 1i64
    v120: i64 = iadd v113, v119
    jump block1(v120, v114, v115, v116, v117, v118)

// finalize trailing key/value
block16(v121: i64, v122: i64, v123: i64, v124: i64, v125: i64):
    v126: i64 = iconst 0i64
    v127: bool = icmp_eq v124, v126
    branch v127, block17(v121, v122, v123, v125), block19(v121, v122, v123, v125)

// finalize key mode
block17(v128: i64, v129: i64, v130: i64, v131: i64):
    v132: i64 = iconst 0i64
    v133: bool = icmp_eq v129, v132
    branch v133, block20(v128, v131), block21(v128, v129, v131)

// finalize value mode
block19(v134: i64, v135: i64, v136: i64, v137: i64):
    v138: i64 = iadd v134, v135
    v139: i64 = iadd v138, v136
    v140: i64 = iconst 1i64
    v141: i64 = iadd v137, v140
    jump block20(v139, v141)

// return result
block20(v142: i64, v143: i64):
    v144: i64 = iadd v142, v143
    v145: i64 = iconst 7i64
    v146: i64 = imul v0, v145
    v147: i64 = iadd v144, v146
    v148: i64 = iconst 3i64
    v149: i64 = iadd v147, v148
    v150: i64 = iconst 3i64
    v151: i64 = sshr v144, v150
    v152: i64 = bxor v149, v151
    v153: i64 = iconst 33i64
    v154: i64 = imul v152, v153
    v155: i64 = iconst 255i64
    v156: i64 = band v0, v155
    v157: i64 = iadd v154, v156
    return v157

// finalize key mode with key len
block21(v158: i64, v159: i64, v160: i64):
    v161: i64 = iadd v158, v159
    v162: i64 = iconst 1i64
    v163: i64 = iadd v160, v162
    jump block20(v161, v163)
}
