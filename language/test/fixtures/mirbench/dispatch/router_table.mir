    v204: i64 = iconst 0i64
    v205: bool = icmp_eq v203, v204
    v206: i64 = iconst 1i64
    v207: i64 = bxor v182, v206
    v208: i64 = select v205, v207, v182
    v209: i64 = iconst 1i64
