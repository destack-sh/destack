    v229: i64 = iadd v228, v225
    v230: i64 = iadd v229, v227
    v231: i64 = iconst 15i64
    v232: i64 = band v230, v231
    v233: ref<borrowed i64> = element.addr v219, v232
    v234: i64 = load v233
    switch v215, block21(v234, v212, v211, v213, v217, v218, v216, v225, v219, v220, v221), 0 => block18(v234, v212, v211, v213, v217, v218, v216, v225, v219, v220, v221), 1 => block19(v234, v212, v211, v213, v217, v218, v216, v225, v219, v220, v221), 2 => block20(v234, v212, v211, v213, v217, v218, v216, v225, v219, v220, v221)

