    v107: i64 = iconst 3i64
    v108: i64 = band v106, v107
    v109: i64 = iconst 1i64
    v110: i64 = iadd v108, v109
    v111: i64 = iconst 0i64
    v112: i64 = iconst 0i64
    jump block12(v111, v112, v92, v94, v98, v104, v110, v84, v85, v86, v87, v88)

