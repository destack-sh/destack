    v59: bool = icmp_sge v54, v58
    branch v59, block9(v55, v56, v57), block8(v54, v55, v56, v57)

// fill method table
block8(v60: i64, v61: ref<managed i64>, v62: ref<managed i64>, v63: ref<managed i64>):
    v64: i64 = iconst 11i64
    v65: i64 = imul v60, v64
