    v301: i64 = select v298, v300, v288
    v302: i64 = iadd v293, v301
    v303: i64 = iadd v302, v291
    v304: i64 = iadd v303, v290
    v305: i64 = iadd v304, v292
    v306: i64 = iconst 1i64
