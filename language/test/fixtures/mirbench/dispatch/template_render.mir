function @template_render(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    v5: i64 = iconst 0i64
    jump block1(v1, v2, v3, v4, v5)

// loop condition, check limit
block1(v6: i64, v7: i64, v8: i64, v9: i64, v10: i64):
    v11: bool = icmp_sge v6, v0
    branch v11, block16(v7, v8, v9, v10), block2(v6, v7, v8, v9, v10)

// compute token
block2(v12: i64, v13: i64, v14: i64, v15: i64, v16: i64):
    v17: i64 = iconst 1103515245i64
    v18: i64 = imul v12, v17
    v19: i64 = iconst 12345i64
    v20: i64 = iadd v18, v19
    v21: i64 = iconst 7i64
    v22: i64 = band v20, v21
    v23: i64 = iconst 0i64
    v24: bool = icmp_eq v14, v23
    branch v24, block3(v12, v13, v14, v15, v16, v22), block6(v12, v13, v14, v15, v16, v22)

// text mode
block3(v25: i64, v26: i64, v27: i64, v28: i64, v29: i64, v30: i64):
    v31: i64 = iconst 0i64
    v32: bool = icmp_eq v30, v31
    branch v32, block4(v25, v26, v28, v29), block5(v25, v26, v27, v28, v29)

// tag start
block4(v33: i64, v34: i64, v35: i64, v36: i64):
    v37: i64 = iconst 1i64
    v38: i64 = iadd v34, v37
    v39: i64 = iconst 1i64
    jump block14(v33, v38, v39, v35, v36)

// text passthrough
block5(v40: i64, v41: i64, v42: i64, v43: i64, v44: i64):
    v45: i64 = iconst 1i64
    v46: i64 = iadd v41, v45
    jump block14(v40, v46, v42, v43, v44)

// tag mode
block6(v47: i64, v48: i64, v49: i64, v50: i64, v51: i64, v52: i64):
    switch v52, block13(v47, v48, v50, v51), 1 => block7(v47, v48, v50, v51), 2 => block8(v47, v48, v50, v51), 3 => block9(v47, v48, v50, v51), 4 => block10(v47, v48, v50, v51)

// var token
block7(v53: i64, v54: i64, v55: i64, v56: i64):
    v57: i64 = iconst 1i64
    v58: i64 = iadd v56, v57
    v59: i64 = iconst 3i64
    v60: i64 = iadd v55, v59
    v61: i64 = iadd v54, v60
    v62: i64 = iconst 0i64
    jump block14(v53, v61, v62, v55, v58)

// section start
block8(v63: i64, v64: i64, v65: i64, v66: i64):
    v67: i64 = iconst 1i64
    v68: i64 = iadd v65, v67
    v69: i64 = iconst 2i64
    v70: i64 = iadd v64, v69
    v71: i64 = iconst 0i64
    jump block14(v63, v70, v71, v68, v66)

// section end
block9(v72: i64, v73: i64, v74: i64, v75: i64):
    v76: i64 = iconst 0i64
    v77: bool = icmp_sgt v74, v76
    v78: i64 = iconst 1i64
    v79: i64 = isub v74, v78
    v80: i64 = select v77, v79, v74
    v81: i64 = iconst 1i64
    v82: i64 = iadd v73, v81
    v83: i64 = iconst 0i64
    jump block14(v72, v82, v83, v80, v75)

// escape token
block10(v84: i64, v85: i64, v86: i64, v87: i64):
    v88: i64 = iconst 1i64
    v89: i64 = iadd v85, v88
    v90: i64 = iconst 0i64
    jump block14(v84, v89, v90, v86, v87)

// tag default
block13(v91: i64, v92: i64, v93: i64, v94: i64):
    v95: i64 = iconst 0i64
    jump block14(v91, v92, v95, v93, v94)

// advance loop
block14(v96: i64, v97: i64, v98: i64, v99: i64, v100: i64):
    v101: i64 = iconst 1i64
    v102: i64 = iadd v96, v101
    jump block1(v102, v97, v98, v99, v100)

// return result
block16(v103: i64, v104: i64, v105: i64, v106: i64):
    v107: i64 = iadd v103, v104
    v108: i64 = iadd v107, v105
    v109: i64 = iadd v108, v106
    v110: i64 = iconst 7i64
    v111: i64 = imul v0, v110
    v112: i64 = iadd v109, v111
    v113: i64 = iconst 3i64
    v114: i64 = iadd v112, v113
    v115: i64 = iconst 3i64
    v116: i64 = sshr v109, v115
    v117: i64 = bxor v114, v116
    v118: i64 = iconst 33i64
    v119: i64 = imul v117, v118
    v120: i64 = iconst 255i64
    v121: i64 = band v0, v120
    v122: i64 = iadd v119, v121
    return v122
}
