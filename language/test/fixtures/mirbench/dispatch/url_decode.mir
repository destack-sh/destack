
function @url_decode(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    jump block1(v1, v2, v3, v4)

// loop condition, check limit
block1(v5: i64, v6: i64, v7: i64, v8: i64):
    v9: bool = icmp_sge v5, v0
    branch v9, block13(v6), block2

// compute token
block2:
    v10: i64 = iconst 1103515245i64
    v11: i64 = imul v5, v10
    v12: i64 = iconst 12345i64
    v13: i64 = iadd v11, v12
    v14: i64 = iconst 31i64
    v15: i64 = band v13, v14
    v16: i64 = iconst 0i64
    v17: bool = icmp_eq v7, v16
    branch v17, block3(v5, v6, v7, v8, v15), block4(v5, v6, v7, v8, v15)

// pending is zero
block3(v18: i64, v19: i64, v20: i64, v21: i64, v22: i64):
    v23: i64 = iconst 16i64
    v24: bool = icmp_eq v22, v23
    branch v24, block5(v18, v19, v21), block6(v18, v19, v22, v21)

// percent start
block5(v25: i64, v26: i64, v27: i64):
    v28: i64 = iconst 1i64
    jump block12(v25, v26, v28, v27)

// non percent token
block6(v29: i64, v30: i64, v31: i64, v32: i64):
    v33: i64 = iconst 17i64
    v34: bool = icmp_eq v31, v33
    branch v34, block7(v29, v30, v32), block8(v29, v30, v31, v32)

// plus token
block7(v35: i64, v36: i64, v37: i64):
    v38: i64 = iconst 32i64
    v39: i64 = iadd v36, v38
    v40: i64 = iconst 0i64
    jump block12(v35, v39, v40, v37)

// normal token
block8(v41: i64, v42: i64, v43: i64, v44: i64):
    v45: i64 = iadd v42, v43
    v46: i64 = iconst 0i64
    jump block12(v41, v45, v46, v44)

// pending is non zero
block4(v47: i64, v48: i64, v49: i64, v50: i64, v51: i64):
    v52: i64 = iconst 1i64
    v53: bool = icmp_eq v49, v52
    branch v53, block9(v47, v48, v51), block10(v47, v48, v50, v51)

// first hex digit
block9(v54: i64, v55: i64, v56: i64):
    v57: i64 = iconst 15i64
    v58: i64 = band v56, v57
    v59: i64 = iconst 2i64
    jump block12(v54, v55, v59, v58)

// second hex digit
block10(v60: i64, v61: i64, v62: i64, v63: i64):
    v64: i64 = iconst 15i64
    v65: i64 = band v63, v64
    v66: i64 = iconst 16i64
    v67: i64 = imul v62, v66
    v68: i64 = iadd v67, v65
    v69: i64 = iadd v61, v68
    v70: i64 = iconst 0i64
    jump block12(v60, v69, v70, v62)

// advance loop
block12(v71: i64, v72: i64, v73: i64, v74: i64):
    v75: i64 = iconst 1i64
    v76: i64 = iadd v71, v75
    jump block1(v76, v72, v73, v74)

// return result
block13(v77: i64):
    v78: i64 = iconst 7i64
    v79: i64 = imul v0, v78
    v80: i64 = iadd v77, v79
    v81: i64 = iconst 3i64
    v82: i64 = iadd v80, v81
    v83: i64 = iconst 3i64
    v84: i64 = sshr v77, v83
    v85: i64 = bxor v82, v84
    v86: i64 = iconst 33i64
    v87: i64 = imul v85, v86
    v88: i64 = iconst 255i64
    v89: i64 = band v0, v88
    v90: i64 = iadd v87, v89
    return v90
}
