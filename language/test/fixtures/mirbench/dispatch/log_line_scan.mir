
function @log_line_scan(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    v5: i64 = iconst 0i64
    jump block1(v1, v2, v3, v4, v5)

// loop condition, check limit
block1(v6: i64, v7: i64, v8: i64, v9: i64, v10: i64):
    v11: bool = icmp_sge v6, v0
    branch v11, block10(v7, v8, v9, v10), block2

// compute token
block2:
    v12: i64 = iconst 1664525i64
    v13: i64 = imul v6, v12
    v14: i64 = iconst 1013904223i64
    v15: i64 = iadd v13, v14
    v16: i64 = iconst 15i64
    v17: i64 = band v15, v16
    v18: i64 = iconst 9i64
    v19: bool = icmp_sle v17, v18
    branch v19, block3(v6, v7, v8, v9, v10, v17), block4(v6, v7, v8, v9, v10, v17)

// digit token
block3(v20: i64, v21: i64, v22: i64, v23: i64, v24: i64, v25: i64):
    v26: i64 = iconst 1i64
    v27: i64 = iadd v21, v26
    v28: i64 = iadd v24, v25
    jump block8(v20, v27, v22, v26, v28)

// check space token
block4(v29: i64, v30: i64, v31: i64, v32: i64, v33: i64, v34: i64):
    v35: i64 = iconst 10i64
    v36: bool = icmp_eq v34, v35
    branch v36, block5(v29, v30, v31, v32, v33), block9(v29, v30, v31, v32, v33, v34)

// space token, check active span
block5(v37: i64, v38: i64, v39: i64, v40: i64, v41: i64):
    v42: i64 = iconst 0i64
    v43: bool = icmp_eq v40, v42
    branch v43, block6(v37, v38, v39, v40, v41), block7(v37, v38, v39, v40, v41)

// space token, no open span
block6(v44: i64, v45: i64, v46: i64, v47: i64, v48: i64):
    jump block8(v44, v45, v46, v47, v48)

// space token, close span
block7(v49: i64, v50: i64, v51: i64, v52: i64, v53: i64):
    v54: i64 = iconst 1i64
    v55: i64 = iadd v51, v54
    v56: i64 = iconst 0i64
    jump block8(v49, v50, v55, v56, v53)

// letter token
block9(v57: i64, v58: i64, v59: i64, v60: i64, v61: i64, v62: i64):
    v63: i64 = iconst 1i64
    v64: i64 = bxor v61, v62
    jump block8(v57, v58, v59, v63, v64)

// advance loop
block8(v65: i64, v66: i64, v67: i64, v68: i64, v69: i64):
    v70: i64 = iconst 1i64
    v71: i64 = iadd v65, v70
    jump block1(v71, v66, v67, v68, v69)

// finalize trailing span
block10(v72: i64, v73: i64, v74: i64, v75: i64):
    v76: i64 = iconst 0i64
    v77: bool = icmp_eq v74, v76
    branch v77, block12(v72, v73, v75), block11(v72, v73, v75)

// add trailing span
block11(v78: i64, v79: i64, v80: i64):
    v81: i64 = iconst 1i64
    v82: i64 = iadd v79, v81
    jump block12(v78, v82, v80)

// return result
block12(v83: i64, v84: i64, v85: i64):
    v86: i64 = iadd v83, v84
    v87: i64 = iadd v86, v85
    v88: i64 = iconst 7i64
    v89: i64 = imul v0, v88
    v90: i64 = iadd v87, v89
    v91: i64 = iconst 3i64
    v92: i64 = iadd v90, v91
    v93: i64 = iconst 3i64
    v94: i64 = sshr v87, v93
    v95: i64 = bxor v92, v94
    v96: i64 = iconst 33i64
    v97: i64 = imul v95, v96
    v98: i64 = iconst 255i64
    v99: i64 = band v0, v98
    v100: i64 = iadd v97, v99
    return v100
}
