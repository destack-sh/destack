
function @branch_alternating(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v2: i64, v3: i64):
    v4: bool = icmp_sge v2, v0
    branch v4, block5(v3), block2

// base case check
block2:
    v5: i64 = iconst 2i64
    v6: i64 = srem v2, v5
    v7: i64 = iconst 0i64
    v8: bool = icmp_eq v6, v7
    branch v8, block3, block4

// loop body, update accumulators
block3:
    v9: i64 = iconst 1i64
    v10: i64 = iadd v3, v9
    v11: i64 = iadd v2, v9
    jump block1(v11, v10)

// loop body, update accumulators
block4:
    v12: i64 = iconst 1i64
    v13: i64 = iadd v2, v12
    jump block1(v13, v3)

// return result
block5(v14: i64):
    return v14
}
