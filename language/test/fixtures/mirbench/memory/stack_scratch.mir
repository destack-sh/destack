
function @stack_scratch(v0: i64) -> i64 {

// entry, init allocations
block0(v0: i64):
    v1: ref<raw addrspace(stack) i64> = stack.alloc i64
    v2: ref<raw addrspace(stack) i64> = stack.alloc i64
    v3: i64 = iconst 0i64
    v4: i64 = iconst 1i64
    store v1, v3
    store v2, v4
    jump block1(v3, v1, v2)

// loop condition, check limit
block1(v5: i64, v6: ref<raw i64>, v7: ref<raw i64>):
    v8: bool = icmp_sge v5, v0
    branch v8, block3(v6, v7), block2

// loop body, update memory
block2:
    v9: i64 = load v6
    v10: i64 = load v7
    v11: i64 = iadd v9, v10
    store v6, v10
    store v7, v11
    v12: i64 = iconst 1i64
    v13: i64 = iadd v5, v12
    jump block1(v13, v6, v7)

// return accumulated value
block3(v14: ref<raw i64>, v15: ref<raw i64>):
    v16: i64 = load v15
    stack.drop v14
    stack.drop v15
    return v16
}
