
function @borrow_passthrough(v0: ref<borrowed i64>) -> ref<borrowed i64> {
block0(v0: ref<borrowed i64>):
    return v0
}

function @borrow_reborrow(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: ref<managed (i64, i64)> = managed.alloc (i64, i64)
    v2: ref<borrowed i64> = field.addr v1, 0
    store v2, v0
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    jump block1(v3, v4, v1)

// loop condition, check limit
block1(v5: i64, v6: i64, v7: ref<managed (i64, i64)>):
    v8: bool = icmp_sge v5, v0
    branch v8, block3(v6), block2

// loop body, read through borrowed refs
block2:
    v9: ref<borrowed i64> = field.addr v7, 0
    v10: ref<borrowed i64> = call @borrow_passthrough(v9) -> fn(ref<borrowed i64>) -> ref<borrowed i64>
    v11: i64 = load v10
    v12: i64 = iadd v6, v11
    v13: i64 = iadd v12, v5
    v14: i64 = iconst 1i64
    v15: i64 = iadd v5, v14
    jump block1(v15, v13, v7)

// return result
block3(v16: i64):
    v17: i64 = iconst 7i64
    v18: i64 = imul v0, v17
    v19: i64 = iadd v16, v18
    v20: i64 = iconst 3i64
    v21: i64 = iadd v19, v20
    v22: i64 = iconst 3i64
    v23: i64 = sshr v16, v22
    v24: i64 = bxor v21, v23
    v25: i64 = iconst 33i64
    v26: i64 = imul v24, v25
    v27: i64 = iconst 255i64
    v28: i64 = band v0, v27
    v29: i64 = iadd v26, v28
    return v29
}
