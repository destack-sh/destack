
function @object_graph_mark(v0: i64, v1: i64, v2: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst 1i64
    v4 = icmp_slt v0, v3
    branch v4, block1, block2

// merge branch, continue
block1:
    jump block3(v3)

// merge branch, continue
block2:
    jump block3(v0)

// branch on condition
block3(v5: i64):
    v6 = icmp_slt v1, v3
    branch v6, block4, block5

// merge branch, continue
block4:
    jump block6(v5, v3)

// merge branch, continue
block5:
    jump block6(v5, v1)

// branch on condition
block6(v7: i64, v8: i64):
    v9 = managed.alloc_array i64, v7 -> ref<managed i64>
    v10 = managed.alloc_array i64, v7 -> ref<managed i64>
    v11 = managed.alloc_array i64, v7 -> ref<managed i64>
    v12 = iconst 0i64
    jump block7(v12, v7, v9, v10, v11, v2, v8)
block7(
    v13: i64,
    v14: i64,
    v15: ref<managed i64>,
    v16: ref<managed i64>,
    v17: ref<managed i64>,
    v18: i64,
    v19: i64
):
    v20 = icmp_sge v13, v14
    branch v20, block9(v15, v16, v17, v14, v19), block8

// branch on condition
block8:
    v21 = bxor v13, v18
    v22 = element.addr v15, v13 -> ref<borrowed i64>
    store v22, v21
    v23 = iconst 3i64
    v24 = imul v13, v23
    v25 = iconst 1i64
    v26 = iadd v24, v25
    v27 = srem v26, v14
    v28 = element.addr v16, v13 -> ref<borrowed i64>
    store v28, v27
    v29 = iconst 7i64
    v30 = imul v13, v29
    v31 = iconst 2i64
    v32 = iadd v30, v31
    v33 = srem v32, v14
    v34 = element.addr v17, v13 -> ref<borrowed i64>
    store v34, v33
    v35 = iadd v13, v25
    jump block7(v35, v14, v15, v16, v17, v18, v19)
block9(
    v36: ref<managed i64>,
    v37: ref<managed i64>,
    v38: ref<managed i64>,
    v39: i64,
    v40: i64
):
    v41 = managed.alloc_array i64, v39 -> ref<managed i64>
    v42 = iconst 0i64
    jump block10(v42, v41, v36, v37, v38, v39, v40)
block10(
    v43: i64,
    v44: ref<managed i64>,
    v45: ref<managed i64>,
    v46: ref<managed i64>,
    v47: ref<managed i64>,
    v48: i64,
    v49: i64
):
    v50 = icmp_sge v43, v48
    branch v50, block12(v45, v46, v47, v44, v48, v49), block11

// branch on condition
block11:
    v51 = element.addr v44, v43 -> ref<borrowed i64>
    store v51, v42
    v52 = iconst 1i64
    v53 = iadd v43, v52
    jump block10(v53, v44, v45, v46, v47, v48, v49)
block12(
    v54: ref<managed i64>,
    v55: ref<managed i64>,
    v56: ref<managed i64>,
    v57: ref<managed i64>,
    v58: i64,
    v59: i64
):
    v60 = iconst 0i64
    v61 = iconst 0i64
    jump block13(v60, v61, v54, v55, v56, v57, v58, v59)
block13(
    v62: i64,
    v63: i64,
    v64: ref<managed i64>,
    v65: ref<managed i64>,
    v66: ref<managed i64>,
    v67: ref<managed i64>,
    v68: i64,
    v69: i64
):
    v70 = icmp_sge v62, v68
    branch v70, block26(v63), block14

// base case check
block14:
    v71 = element.addr v67, v62 -> ref<borrowed i64>
    v72 = load v71 -> i64
    v73 = iconst 0i64
    v74 = icmp_eq v72, v73
    branch v74, block15, block16(v63)

// update state, merge branch
block15:
    v75 = iconst 1i64
    store v71, v75
    v76 = element.addr v64, v62 -> ref<borrowed i64>
    v77 = load v76 -> i64
    v78 = iadd v63, v77
    jump block16(v78)

// merge branch, continue
block16(v79: i64):
    v80 = iconst 0i64
    jump block17(v80, v79)

// loop condition, check limit
block17(v81: i64, v82: i64):
    v83 = icmp_sge v81, v68
    branch v83, block25(v62, v82), block18

// base case check
block18:
    v84 = iadd v62, v81
    v85 = srem v84, v68
    v86 = element.addr v67, v85 -> ref<borrowed i64>
    v87 = load v86 -> i64
    v88 = iconst 0i64
    v89 = icmp_eq v87, v88
    branch v89, block24(v81, v82), block19(v81, v82, v85)

// jump to next block
block19(v90: i64, v91: i64, v92: i64):
    v93 = element.addr v65, v92 -> ref<borrowed i64>
    v94 = load v93 -> i64
    v95 = element.addr v66, v92 -> ref<borrowed i64>
    v96 = load v95 -> i64
    jump block20(v90, v91, v94, v96)

// base case check
block20(v97: i64, v98: i64, v99: i64, v100: i64):
    v101 = element.addr v67, v99 -> ref<borrowed i64>
    v102 = load v101 -> i64
    v103 = iconst 0i64
    v104 = icmp_eq v102, v103
    branch v104, block21, block22(v97, v98, v100)

// update state, merge branch
block21:
    v105 = iconst 1i64
    store v101, v105
    v106 = element.addr v64, v99 -> ref<borrowed i64>
    v107 = load v106 -> i64
    v108 = iadd v98, v107
    jump block22(v97, v108, v100)

// base case check
block22(v109: i64, v110: i64, v111: i64):
    v112 = element.addr v67, v111 -> ref<borrowed i64>
    v113 = load v112 -> i64
    v114 = iconst 0i64
    v115 = icmp_eq v113, v114
    branch v115, block23, block24(v109, v110)

// update state, merge branch
block23:
    v116 = iconst 1i64
    store v112, v116
    v117 = element.addr v64, v111 -> ref<borrowed i64>
    v118 = load v117 -> i64
    v119 = iadd v110, v118
    jump block24(v109, v119)

// merge branches, advance loop
block24(v120: i64, v121: i64):
    v122 = iconst 1i64
    v123 = iadd v120, v122
    jump block17(v123, v121)

// loop body, update accumulators
block25(v124: i64, v125: i64):
    v126 = iadd v124, v69
    jump block13(v126, v125, v64, v65, v66, v67, v68, v69)

// return result
block26(v127: i64):
    return v127
}
