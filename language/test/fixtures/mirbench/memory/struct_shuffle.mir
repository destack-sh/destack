type @Pair = { i64, i64 }

function @struct_shuffle(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: ref<raw addrspace(stack) mut @Pair> = stack.alloc @Pair
    v2: i64 = iconst 1i64
    v3: i64 = iconst 2i64
    v4: ref<borrowed i64> = field.addr v1, 0
    store v4, v2
    v5: ref<borrowed i64> = field.addr v1, 1
    store v5, v3
    v6: i64 = iconst 0i64
    jump block1(v6)

// loop condition, check limit
block1(v7: i64):
    v8: bool = icmp_sge v7, v0
    branch v8, block3, block2

// loop body, update aggregates
block2:
    v9: ref<borrowed i64> = field.addr v1, 0
    v10: i64 = load v9
    v11: ref<borrowed i64> = field.addr v1, 1
    v12: i64 = load v11
    v13: i64 = iadd v10, v12
    v14: i64 = iadd v13, v7
    v15: ref<borrowed i64> = field.addr v1, 0
    store v15, v14
    v16: i64 = iconst 1i64
    v17: i64 = iadd v7, v16
    jump block1(v17)

// return result
block3:
    v18: ref<borrowed i64> = field.addr v1, 0
    v19: i64 = load v18
    v20: ref<borrowed i64> = field.addr v1, 1
    v21: i64 = load v20
    v22: i64 = iadd v19, v21
    v23: i64 = iconst 7i64
    v24: i64 = imul v0, v23
    v25: i64 = iadd v22, v24
    v26: i64 = iconst 3i64
    v27: i64 = iadd v25, v26
    v28: i64 = iconst 3i64
    v29: i64 = sshr v22, v28
    v30: i64 = bxor v27, v29
    v31: i64 = iconst 33i64
    v32: i64 = imul v30, v31
    v33: i64 = iconst 255i64
    v34: i64 = band v0, v33
    v35: i64 = iadd v32, v34
    return v35
}
