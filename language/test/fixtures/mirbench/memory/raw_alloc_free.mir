
function @raw_alloc_free(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    v2 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5 = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update memory
block2:
    v6 = raw.alloc i64
    store v6, v3
    v7 = load v6
    raw.free v6
    v8 = iadd v4, v7
    v9 = iconst 1i64
    v10 = iadd v3, v9
    jump block1(v10, v8)

// return result
block3(v11: i64):
    return v11
}
