
function @symbol_table(v0: i64) -> i64 {

// entry, init tables
block0(v0: i64):
    v1: i64 = iconst 128i64
    v2: ref<managed i64> = managed.alloc_array i64, v1
    v3: ref<managed i64> = managed.alloc_array i64, v1
    v4: i64 = iconst 0i64
    jump block1(v4, v2, v3)

// loop condition, init keys
block1(v5: i64, v6: ref<managed i64>, v7: ref<managed i64>):
    v8: i64 = iconst 128i64
    v9: bool = icmp_sge v5, v8
    branch v9, block3(v6, v7), block2

// init key slot
block2:
    v10: ref<borrowed i64> = element.addr v6, v5
    v11: i64 = iconst -1i64
    store v10, v11
    v12: ref<borrowed i64> = element.addr v7, v5
    v13: i64 = iconst 0i64
    store v12, v13
    v14: i64 = iconst 1i64
    v15: i64 = iadd v5, v14
    jump block1(v15, v6, v7)

// init outer loop
block3(v16: ref<managed i64>, v17: ref<managed i64>):
    v18: i64 = iconst 0i64
    v19: i64 = iconst 0i64
    jump block4(v18, v19, v16, v17)

// loop condition, process keys
block4(v20: i64, v21: i64, v22: ref<managed i64>, v23: ref<managed i64>):
    v24: bool = icmp_sge v20, v0
    branch v24, block13(v21), block5

// compute key
block5:
    v25: i64 = iconst 1103515245i64
    v26: i64 = imul v20, v25
    v27: i64 = iconst 12345i64
    v28: i64 = iadd v26, v27
    v29: i64 = iconst 255i64
    v30: i64 = band v28, v29
    v31: i64 = iconst 0i64
    jump block6(v20, v21, v30, v31, v22, v23)

// probe loop
block6(v32: i64, v33: i64, v34: i64, v35: i64, v36: ref<managed i64>, v37: ref<managed i64>):
    v38: i64 = iconst 128i64
    v39: bool = icmp_sge v35, v38
    branch v39, block12(v32, v33, v36, v37), block7

// load key slot
block7:
    v40: ref<borrowed i64> = element.addr v36, v35
    v41: i64 = load v40
    v42: bool = icmp_eq v41, v34
    branch v42, block9(v32, v33, v35, v36, v37), block8

// check empty slot
block8:
    v43: i64 = iconst -1i64
    v44: bool = icmp_eq v41, v43
    branch v44, block10(v32, v33, v35, v36, v37, v34), block11(v32, v33, v34, v35, v36, v37)

// found key
block9(v45: i64, v46: i64, v47: i64, v48: ref<managed i64>, v49: ref<managed i64>):
    v50: ref<borrowed i64> = element.addr v49, v47
    v51: i64 = load v50
    v52: i64 = iadd v46, v51
    v53: i64 = iconst 1i64
    v54: i64 = iadd v45, v53
    jump block4(v54, v52, v48, v49)

// insert key
block10(v55: i64, v56: i64, v57: i64, v58: ref<managed i64>, v59: ref<managed i64>, v60: i64):
    v61: ref<borrowed i64> = element.addr v58, v57
    store v61, v60
    v62: ref<borrowed i64> = element.addr v59, v57
    store v62, v55
    v63: i64 = iadd v56, v55
    v64: i64 = iconst 1i64
    v65: i64 = iadd v55, v64
    jump block4(v65, v63, v58, v59)

// advance probe
block11(v66: i64, v67: i64, v68: i64, v69: i64, v70: ref<managed i64>, v71: ref<managed i64>):
    v72: i64 = iconst 1i64
    v73: i64 = iadd v69, v72
    jump block6(v66, v67, v68, v73, v70, v71)

// probe failed, advance outer loop
block12(v74: i64, v75: i64, v76: ref<managed i64>, v77: ref<managed i64>):
    v78: i64 = iconst 1i64
    v79: i64 = iadd v74, v78
    jump block4(v79, v75, v76, v77)

// return result
block13(v80: i64):
    v81: i64 = iconst 7i64
    v82: i64 = imul v0, v81
    v83: i64 = iadd v80, v82
    v84: i64 = iconst 3i64
    v85: i64 = iadd v83, v84
    v86: i64 = iconst 3i64
    v87: i64 = sshr v80, v86
    v88: i64 = bxor v85, v87
    v89: i64 = iconst 33i64
    v90: i64 = imul v88, v89
    v91: i64 = iconst 255i64
    v92: i64 = band v0, v91
    v93: i64 = iadd v90, v92
    return v93
}
