
function @memory_ssa_weave(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: ref<raw i64> = raw.alloc i64
    v2: i64 = iconst 0i64
    store v1, v2
    v3: i64 = iconst 0i64
    v4: i64 = iconst 0i64
    jump block1(v3, v4, v1)

// loop condition, check limit
block1(v5: i64, v6: i64, v7: ref<raw i64>):
    v8: bool = icmp_sge v5, v0
    branch v8, block4(v6, v7), block2

// branch on parity
block2:
    v9: i64 = iconst 1i64
    v10: i64 = band v5, v9
    v11: i64 = iconst 0i64
    v12: bool = icmp_eq v10, v11
    branch v12, block3, block5

// even branch, increment by index
block3:
    v13: i64 = load v7
    v14: i64 = iadd v13, v5
    store v7, v14
    jump block6

// odd branch, increment by constant
block5:
    v15: i64 = load v7
    v16: i64 = iconst 3i64
    v17: i64 = iadd v15, v16
    store v7, v17
    jump block6

// merge branches, accumulate
block6:
    v18: i64 = load v7
    v19: i64 = iadd v6, v18
    v20: i64 = iconst 1i64
    v21: i64 = iadd v5, v20
    jump block1(v21, v19, v7)

// return result
block4(v22: i64, v23: ref<raw i64>):
    v24: i64 = load v23
    raw.free v23
    v25: i64 = iadd v22, v24
    v26: i64 = iconst 7i64
    v27: i64 = imul v0, v26
    v28: i64 = iadd v25, v27
    v29: i64 = iconst 3i64
    v30: i64 = iadd v28, v29
    v31: i64 = iconst 3i64
    v32: i64 = sshr v25, v31
    v33: i64 = bxor v30, v32
    v34: i64 = iconst 33i64
    v35: i64 = imul v33, v34
    v36: i64 = iconst 255i64
    v37: i64 = band v0, v36
    v38: i64 = iadd v35, v37
    return v38
}
