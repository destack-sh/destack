
function @array_random_access(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2 = iconst 1i64
    v3 = icmp_slt v1, v2
    branch v3, block1, block2

// merge branch, continue
block1:
    v4 = iconst 1i64
