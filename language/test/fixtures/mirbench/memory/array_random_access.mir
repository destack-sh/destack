// merge branch, continue
block3(v5: i64):
    v6 = managed.alloc_array i64, v5
    v7 = iconst 0i64
    v8 = iconst 0i64
    jump block4(v7, v8, v6, v5)

// loop condition, check limit
block4(v9: i64, v10: i64, v11: ref<managed i64>, v12: i64):
    v13 = icmp_sge v9, v12
    branch v13, block6(v10, v11, v12), block5

// loop body, update aggregates
block5:
    v14 = element.addr v11, v9
    store v14, v9
    v15 = iconst 1i64
    v16 = iadd v9, v15
    jump block4(v16, v10, v11, v12)

// merge branch, continue
block6(v17: i64, v18: ref<managed i64>, v19: i64):
    v20 = iconst 0i64
    jump block7(v20, v17, v18, v19)

// loop condition, check limit
block7(v21: i64, v22: i64, v23: ref<managed i64>, v24: i64):
    v25 = icmp_sge v21, v0
    branch v25, block9(v22), block8

// loop body, update aggregates
block8:
    v26 = iconst 1103515245i64
    v27 = imul v21, v26
    v28 = iconst 12345i64
    v29 = iadd v27, v28
    v30 = srem v29, v24
    v31 = element.addr v23, v30
    v32 = load v31
    v33 = bxor v32, v29
    store v31, v33
    v34 = iadd v22, v33
    v35 = iconst 1i64
    v36 = iadd v21, v35
    jump block7(v36, v34, v23, v24)

// return result
block9(v37: i64):
