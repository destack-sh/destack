function localAccumulate(v0: int64): int64 {
    local local0: int64, owned
    local local1: int64, owned
b0(v0: int64):
    v1: int64 = 0int64
    v2: int64 = 1int64
    local.set local0, v1
    local.set local1, v2
    jump b1(v1)
b1(v3: int64):
    v4: boolean = int.eq v3, v3
    assume v4
    v5: boolean = int.ge.s v3, v0
    branch v5, b3, b2
b2:
    v6: int64 = local.get local0
    v7: int64 = local.get local1
    v8: int64 = int.add v6, v7
    local.set local0, v7
    local.set local1, v8
    v9: int64 = 1int64
    v10: int64 = int.add v3, v9
    jump b1(v10)
b3:
    v11: int64 = local.get local1
    return v11
}
