
function @local_accumulate(v0: i64) -> i64 {
    local0: i64 ; owned, mut
    local1: i64 ; owned, mut

// entry, init locals
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 1i64
    local.set local0, v1
    local.set local1, v2
    jump block1(v1)

// loop condition, check limit
block1(v3: i64):
    v4: bool = icmp_eq v3, v3
    assume v4
    v5: bool = icmp_sge v3, v0
    branch v5, block3, block2

// loop body, update accumulators
block2:
    v6: i64 = local.get local0
    v7: i64 = local.get local1
    v8: i64 = iadd v6, v7
    local.set local0, v7
    local.set local1, v8
    v9: i64 = iconst 1i64
    v10: i64 = iadd v3, v9
    jump block1(v10)

// return result
block3:
    v11: i64 = local.get local1
    return v11
}
