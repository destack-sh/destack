
function @alloc_array_large(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update aggregates
block2:
    v6: i64 = iconst 64i64
    v7: ref<managed i64> = managed.alloc_array i64, v6 -> ref<managed i64>
    v8: i64 = iconst 0i64
    v9: ref<borrowed i64> = element.addr v7, v8 -> ref<borrowed i64>
    store v9, v3
    v10: i64 = iconst 63i64
    v11: ref<borrowed i64> = element.addr v7, v10 -> ref<borrowed i64>
    store v11, v3
    v12: i64 = iadd v4, v3
    v13: i64 = iconst 1i64
    v14: i64 = iadd v3, v13
    jump block1(v14, v12)

// return result
block3(v15: i64):
    return v15
}
