function @load_store(v0: i64) -> i64 {

// entry, init allocations
block0(v0: i64):
    v1: ref<managed i64> = managed.alloc i64 -> ref<managed i64>
    v2: ref<managed i64> = managed.alloc i64 -> ref<managed i64>
    v3: i64 = iconst 0i64
    v4: i64 = iconst 1i64
    store v1, v3
    store v2, v4
    jump block1(v3)

// loop condition, check limit
block1(v5: i64):
    v6: bool = icmp_sge v5, v0
    branch v6, block3, block2

// loop body, update memory
block2:
    v7: i64 = load v1 -> i64
    v8: i64 = load v2 -> i64
    v9: i64 = iadd v7, v8
    store v1, v8
    store v2, v9
    v10: i64 = iconst 1i64
    v11: i64 = iadd v5, v10
    jump block1(v11)

// return accumulated value
block3:
    v12: i64 = load v2 -> i64
    return v12
}
