
function @array_walk(v0: i64) -> i64 {

// entry, init allocations
block0(v0: i64):
    v1: ref<managed i64> = managed.alloc_array i64, v0 -> ref<managed i64>
    v2: i64 = iconst 0i64
    jump block1(v2, v1)

// loop condition, check limit
block1(v3: i64, v4: ref<managed i64>):
    v5: bool = icmp_sge v3, v0
