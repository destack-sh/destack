    v11: i64 = iconst 0i64
    jump block4(v10, v9, v11)

// loop condition, check limit
block4(v12: i64, v13: ref<managed i64>, v14: i64):
    v15: bool = icmp_sge v12, v0
    branch v15, block6(v14), block5

// loop body, update aggregates
block5:
    v16: ref<borrowed i64> = element.addr v13, v12 -> ref<borrowed i64>
    v17: i64 = load v16 -> i64
    v18: i64 = iadd v14, v17
    v19: i64 = iconst 1i64
    v20: i64 = iadd v12, v19
