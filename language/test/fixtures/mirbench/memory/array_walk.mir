
function @array_walk(v0: i64) -> i64 {

// entry, init allocations
block0(v0: i64):
    v1 = managed.alloc_array i64, v0
    v2 = iconst 0i64
    jump block1(v2, v1)

// loop condition, check limit
block1(v3: i64, v4: ref<managed i64>):
    v5 = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update aggregates
block2:
    v6 = element.addr v4, v3
    store v6, v3
    v7 = iconst 1i64
    v8 = iadd v3, v7
    jump block1(v8, v4)

// merge branch, continue
block3(v9: ref<managed i64>):
    v10 = iconst 0i64
    v11 = iconst 0i64
    jump block4(v10, v9, v11)

// loop condition, check limit
block4(v12: i64, v13: ref<managed i64>, v14: i64):
    v15 = icmp_sge v12, v0
    branch v15, block6(v14), block5

// loop body, update aggregates
block5:
    v16 = element.addr v13, v12
    v17 = load v16
    v18 = iadd v14, v17
    v19 = iconst 1i64
    v20 = iadd v12, v19
    jump block4(v20, v13, v18)

// return result
block6(v20: i64):
    return v20
}
