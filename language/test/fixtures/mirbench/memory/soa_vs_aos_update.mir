
function @soa_vs_aos_update(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 1i64
    v3: bool = icmp_slt v1, v2
    branch v3, block1, block2

// merge branch, continue
block1:
    jump block3(v2)

// merge branch, continue
block2:
    jump block3(v1)

// update state, merge branch
block3(v4: i64):
    v5: i64 = imul v0, v4
    v6: ref<managed i64> = managed.alloc_array i64, v5 -> ref<managed i64>
    v7: ref<managed i64> = managed.alloc_array i64, v5 -> ref<managed i64>
    v8: i64 = iconst 2i64
    v9: i64 = imul v5, v8
    v10: ref<managed i64> = managed.alloc_array i64, v9 -> ref<managed i64>
    v11: i64 = iconst 0i64
    jump block4(v11, v5, v6, v7, v10)

// loop condition, check limit
block4(v12: i64, v13: i64, v14: ref<managed i64>, v15: ref<managed i64>, v16: ref<managed i64>):
    v17: bool = icmp_sge v12, v13
    branch v17, block6(v13, v14, v15, v16), block5

// loop body, update aggregates
block5:
    v18: i64 = iconst 1i64
    v19: i64 = iadd v12, v18
    v20: i64 = iconst 2i64
    v21: i64 = imul v19, v20
    v22: ref<borrowed i64> = element.addr v14, v12 -> ref<borrowed i64>
    store v22, v19
    v23: ref<borrowed i64> = element.addr v15, v12 -> ref<borrowed i64>
    store v23, v21
    v24: i64 = imul v12, v20
    v25: ref<borrowed i64> = element.addr v16, v24 -> ref<borrowed i64>
    store v25, v19
    v26: i64 = iadd v24, v18
    v27: ref<borrowed i64> = element.addr v16, v26 -> ref<borrowed i64>
    store v27, v21
    v28: i64 = iadd v12, v18
    jump block4(v28, v13, v14, v15, v16)

// merge branch, continue
block6(v29: i64, v30: ref<managed i64>, v31: ref<managed i64>, v32: ref<managed i64>):
    v33: i64 = iconst 0i64
    v34: i64 = iconst 0i64
    jump block7(v33, v34, v29, v30, v31, v32)

// loop condition, check limit
block7(v35: i64, v36: i64, v37: i64, v38: ref<managed i64>, v39: ref<managed i64>, v40: ref<managed i64>):
    v41: bool = icmp_sge v35, v37
    branch v41, block9(v36), block8

// loop body, update aggregates
block8:
    v42: ref<borrowed i64> = element.addr v38, v35 -> ref<borrowed i64>
    v43: i64 = load v42 -> i64
    v44: ref<borrowed i64> = element.addr v39, v35 -> ref<borrowed i64>
    v45: i64 = load v44 -> i64
    v46: i64 = iadd v43, v45
    v47: i64 = iconst 2i64
    v48: i64 = imul v35, v47
    v49: ref<borrowed i64> = element.addr v40, v48 -> ref<borrowed i64>
    v50: i64 = load v49 -> i64
    v51: i64 = iconst 1i64
    v52: i64 = iadd v48, v51
    v53: ref<borrowed i64> = element.addr v40, v52 -> ref<borrowed i64>
    v54: i64 = load v53 -> i64
    v55: i64 = iadd v50, v54
    v56: i64 = iadd v46, v55
    v57: i64 = iadd v36, v56
    v58: i64 = iconst 1i64
    v59: i64 = iadd v35, v58
    jump block7(v59, v57, v37, v38, v39, v40)

// return result
block9(v60: i64):
    return v60
}
