
function @nested_array_sum(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2 = iconst 1i64
    v3 = icmp_slt v0, v2
    branch v3, block1, block2

// merge branch, continue
block1:
    v4 = iconst 1i64
    jump block3(v4)

// merge branch, continue
block2:
    jump block3(v0)

// branch on condition
block3(v5: i64):
    v6 = iconst 1i64
    v7 = icmp_slt v1, v6
    branch v7, block4, block5

// merge branch, continue
block4:
    v8 = iconst 1i64
    jump block6(v5, v8)

// merge branch, continue
block5:
    jump block6(v5, v1)

// merge branch, continue
block6(v9: i64, v10: i64):
    v11 = managed.alloc_array ref<managed i64>, v9 -> ref<managed ref<managed i64>>
    v12 = iconst 0i64
    jump block7(v12, v9, v10)

// loop condition, check limit
block7(v13: i64, v14: i64, v15: i64):
    v16 = icmp_sge v13, v14
    branch v16, block12(v14, v15), block8

// branch on condition
block8:
    v17 = managed.alloc_array i64, v15 -> ref<managed i64>
    v18 = iconst 0i64
    jump block9(v18, v13, v15, v14)
block9(v19: i64, v20: i64, v21: i64, v22: i64):
    v23 = icmp_sge v19, v21
    branch v23, block10(v20, v22, v21), block11

// loop body, update aggregates
block11:
    v24 = iconst 31i64
    v25 = imul v20, v24
    v26 = iconst 7i64
    v27 = imul v19, v26
    v28 = iadd v25, v27
    v29 = element.addr v17, v19 -> ref<borrowed i64>
    store v29, v28
    v30 = iconst 1i64
    v31 = iadd v19, v30
    jump block9(v31, v20, v21, v22)
block10(v32: i64, v33: i64, v34: i64):
    v35 = element.addr v11, v32 -> ref<borrowed ref<managed i64>>
    store v35, v17
    v36 = iconst 1i64
    v37 = iadd v32, v36
    jump block7(v37, v33, v34)

// branch on condition
block12(v38: i64, v39: i64):
    v40 = iconst 0i64
    v41 = iconst 0i64
    jump block13(v40, v41, v38, v39)
block13(v42: i64, v43: i64, v44: i64, v45: i64):
    v46 = icmp_sge v42, v44
    branch v46, block16(v43), block14

// branch on condition
block14:
    v47 = element.addr v11, v42 -> ref<borrowed ref<managed i64>>
    v48 = load v47 -> ref<managed i64>
    v49 = iconst 0i64
    jump block15(v49, v43, v48, v42, v44, v45)
block15(v50: i64, v51: i64, v52: ref<managed i64>, v53: i64, v54: i64, v55: i64):
    v56 = icmp_sge v50, v55
    branch v56, block17(v51, v53, v54, v55), block18

// loop body, update aggregates
block18:
    v57 = element.addr v52, v50 -> ref<borrowed i64>
    v58 = load v57 -> i64
    v59 = iadd v51, v58
    v60 = iconst 1i64
    v61 = iadd v50, v60
    jump block15(v61, v59, v52, v53, v54, v55)
block17(v62: i64, v63: i64, v64: i64, v65: i64):
    v66 = iconst 1i64
    v67 = iadd v63, v66
    jump block13(v67, v62, v64, v65)

// return result
block16(v68: i64):
    return v68
}
