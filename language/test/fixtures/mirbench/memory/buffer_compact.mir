
function @buffer_compact(v0: i64) -> i64 {

// entry, init buffers
block0(v0: i64):
    v1: ref<managed i64> = managed.alloc_array i64, v0
    v2: ref<managed i64> = managed.alloc_array i64, v0
    v3: i64 = iconst 0i64
    jump block1(v3, v1, v2)

// loop condition, fill input
block1(v4: i64, v5: ref<managed i64>, v6: ref<managed i64>):
    v7: bool = icmp_sge v4, v0
    branch v7, block3(v5, v6), block2

// fill input values
block2:
    v8: i64 = iconst 5i64
    v9: i64 = imul v4, v8
    v10: i64 = iconst 7i64
    v11: i64 = iadd v9, v10
    v12: i64 = iconst 15i64
    v13: i64 = band v11, v12
    v14: i64 = iconst 4i64
    v15: bool = icmp_slt v13, v14
    branch v15, block4(v4, v5, v6), block5(v4, v5, v6, v13)

// store zeroed value
block4(v16: i64, v17: ref<managed i64>, v18: ref<managed i64>):
    v19: i64 = iconst 0i64
    v20: ref<borrowed i64> = element.addr v17, v16
    store v20, v19
    jump block6(v16, v17, v18)

// store non zero value
block5(v21: i64, v22: ref<managed i64>, v23: ref<managed i64>, v24: i64):
    v25: ref<borrowed i64> = element.addr v22, v21
    store v25, v24
    jump block6(v21, v22, v23)

// advance fill loop
block6(v26: i64, v27: ref<managed i64>, v28: ref<managed i64>):
    v29: i64 = iconst 1i64
    v30: i64 = iadd v26, v29
    jump block1(v30, v27, v28)

// init compact state
block3(v31: ref<managed i64>, v32: ref<managed i64>):
    v33: i64 = iconst 0i64
    v34: i64 = iconst 0i64
    v35: i64 = iconst 0i64
    jump block7(v33, v34, v35, v31, v32)

// loop condition, compact buffer
block7(v36: i64, v37: i64, v38: i64, v39: ref<managed i64>, v40: ref<managed i64>):
    v41: bool = icmp_sge v36, v0
    branch v41, block10(v37, v38), block8

// load value
block8:
    v42: ref<borrowed i64> = element.addr v39, v36
    v43: i64 = load v42
    v44: i64 = iconst 0i64
    v45: bool = icmp_eq v43, v44
    branch v45, block9(v36, v37, v38, v39, v40), block11(v36, v37, v38, v39, v40, v43)

// skip empty slots
block9(v46: i64, v47: i64, v48: i64, v49: ref<managed i64>, v50: ref<managed i64>):
    jump block12(v46, v47, v48, v49, v50)

// keep value
block11(v51: i64, v52: i64, v53: i64, v54: ref<managed i64>, v55: ref<managed i64>, v56: i64):
    v57: ref<borrowed i64> = element.addr v55, v52
    store v57, v56
    v58: i64 = iconst 1i64
    v59: i64 = iadd v52, v58
    v60: i64 = iadd v53, v56
    jump block12(v51, v59, v60, v54, v55)

// advance compact loop
block12(v61: i64, v62: i64, v63: i64, v64: ref<managed i64>, v65: ref<managed i64>):
    v66: i64 = iconst 1i64
    v67: i64 = iadd v61, v66
    jump block7(v67, v62, v63, v64, v65)

// return result
block10(v68: i64, v69: i64):
    v70: i64 = iadd v68, v69
    v71: i64 = iconst 7i64
    v72: i64 = imul v0, v71
    v73: i64 = iadd v70, v72
    v74: i64 = iconst 3i64
    v75: i64 = iadd v73, v74
    v76: i64 = iconst 3i64
    v77: i64 = sshr v70, v76
    v78: i64 = bxor v75, v77
    v79: i64 = iconst 33i64
    v80: i64 = imul v78, v79
    v81: i64 = iconst 255i64
    v82: i64 = band v0, v81
    v83: i64 = iadd v80, v82
    return v83
}
