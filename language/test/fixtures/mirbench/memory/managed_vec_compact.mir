block2:
    v8: i64 = iconst 1664525i64
    v9: i64 = imul v4, v8
    v10: i64 = iconst 1013904223i64
    v11: i64 = iadd v9, v10
    v12: i64 = iconst 1023i64
    v13: i64 = band v11, v12
    v14: ref<borrowed i64> = element.addr v5, v4
    store v14, v13
    v15: i64 = iconst 1i64
    v16: i64 = iadd v4, v15
    jump block1(v16, v5, v6)

// init compaction
block3(v17: ref<managed i64>, v18: ref<managed i64>):
    v19: i64 = iconst 0i64
    v20: i64 = iconst 0i64
    v21: i64 = iconst 0i64
    jump block4(v19, v20, v21, v17, v18)

// loop condition, compact
block4(v22: i64, v23: i64, v24: i64, v25: ref<managed i64>, v26: ref<managed i64>):
    v27: bool = icmp_sge v22, v0
    branch v27, block9(v23, v24), block5

// load value and test
block5:
    v28: ref<borrowed i64> = element.addr v25, v22
    v29: i64 = load v28
    v30: i64 = iconst 3i64
    v31: i64 = band v29, v30
    v32: i64 = iconst 0i64
    v33: bool = icmp_eq v31, v32
    branch v33, block6(v22, v23, v24, v25, v26, v29), block8(v22, v23, v24, v25, v26, v29)

// write compacted value
block6(v34: i64, v35: i64, v36: i64, v37: ref<managed i64>, v38: ref<managed i64>, v39: i64):
    v40: i64 = iadd v39, v35
    v41: ref<borrowed i64> = element.addr v38, v35
    store v41, v40
    v42: i64 = iadd v36, v40
    v43: i64 = iconst 1i64
    v44: i64 = iadd v35, v43
    v45: i64 = iadd v34, v43
    jump block4(v45, v44, v42, v37, v38)

// skip value
block8(v46: i64, v47: i64, v48: i64, v49: ref<managed i64>, v50: ref<managed i64>, v51: i64):
    v52: i64 = iadd v48, v51
    v53: i64 = iconst 1i64
    v54: i64 = iadd v46, v53
