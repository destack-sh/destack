block9(v55: i64, v56: i64):
    v57: i64 = iadd v55, v56
    v58: i64 = iconst 7i64
    v59: i64 = imul v0, v58
    v60: i64 = iadd v57, v59
    v61: i64 = iconst 3i64
    v62: i64 = iadd v60, v61
    v63: i64 = iconst 3i64
    v64: i64 = sshr v57, v63
    v65: i64 = bxor v62, v64
    v66: i64 = iconst 33i64
    v67: i64 = imul v65, v66
    v68: i64 = iconst 255i64
    v69: i64 = band v0, v68
    v70: i64 = iadd v67, v69
