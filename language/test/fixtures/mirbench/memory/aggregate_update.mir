// expect-errors=EO100

type @Triple = { i64, i64, i64 }

function @aggregate_update(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 1i64
    v2 = iconst 2i64
    v3 = iconst 3i64
    v4 = struct @Triple (v1, v2, v3)
    v5 = tuple (i64, i64) (v1, v3)
    v6 = array [i64; 4] (v1, v2, v3, v2)
    v7 = iconst 0i64
    jump block1(v7, v4, v5, v6)

// loop condition, check limit
block1(v8: i64, v9: @Triple, v10: (i64, i64), v11: [i64; 4]):
    v12 = icmp_sge v8, v0
    branch v12, block3(v9, v10, v11), block2

// loop body, update aggregates
block2:
    v13 = iconst 1i64
    v14 = band v8, v13
    v15 = icmp_eq v14, v13
    v16 = field.get v9, 1
    v17 = iconst 5i64
    v18 = iadd v16, v17
    v19 = isub v16, v17
    v20 = select v15, v18, v19
    v21 = field.set v9, 1, v20
    v22 = iconst 3i64
    v23 = band v8, v22
    v24 = element.get v11, v23
    v25 = iadd v24, v20
    v26 = element.set v11, v23, v25
    v27 = field.get v10, 0
    v28 = iadd v27, v20
    v29 = field.set v10, 0, v28
    v30 = iconst 1i64
    v31 = iadd v8, v30
    jump block1(v31, v21, v29, v26)

// return accumulated value
block3(v32: @Triple, v33: (i64, i64), v34: [i64; 4]):
    v35 = field.get v32, 1
    v36 = field.get v33, 0
    v37 = iconst 2i64
    v38 = element.get v34, v37
    v39 = iadd v35, v36
    v40 = iadd v39, v38
    return v40
}
