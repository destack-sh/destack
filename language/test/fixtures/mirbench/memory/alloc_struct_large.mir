
function @alloc_struct_large(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    v2 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5 = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update aggregates
block2:
    v6 = managed.alloc (i64, i64, i64, i64) -> ref<managed (i64, i64, i64, i64)>
    v7 = field.addr v6, 0 -> ref<borrowed i64>
    store v7, v3
    v8 = field.addr v6, 1 -> ref<borrowed i64>
    store v8, v3
    v9 = field.addr v6, 2 -> ref<borrowed i64>
    store v9, v3
    v10 = field.addr v6, 3 -> ref<borrowed i64>
    store v10, v3
    v11 = iadd v4, v3
    v12 = iconst 1i64
    v13 = iadd v3, v12
    jump block1(v13, v11)

// return result
block3(v14: i64):
    return v14
}
