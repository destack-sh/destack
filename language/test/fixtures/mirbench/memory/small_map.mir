
function @small_map(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 64i64
    v2: ref<managed i64> = managed.alloc_array i64, v1
    v3: ref<managed i64> = managed.alloc_array i64, v1
    v4: i64 = iconst 0i64
    v5: i64 = iconst 0i64
    v6: i64 = iconst 0i64
    jump block1(v6, v4, v5, v2, v3, v1)

// loop condition, check limit
block1(v7: i64, v8: i64, v9: i64, v10: ref<managed i64>, v11: ref<managed i64>, v12: i64):
    v13: bool = icmp_sge v7, v0
    branch v13, block12(v9, v8), block2

// compute hash
block2:
    v14: i64 = iconst 1103515245i64
    v15: i64 = imul v7, v14
    v16: i64 = iconst 12345i64
    v17: i64 = iadd v15, v16
    v18: i64 = iconst 16i64
    v19: i64 = sshr v17, v18
    v20: i64 = bxor v17, v19
    v21: i64 = iconst 1i64
    v22: i64 = iadd v17, v21
    v23: i64 = iconst 0i64
    jump block3(v23, v9, v8, v20, v22, v7, v10, v11, v12)

// loop condition, scan entries
block3(v24: i64, v25: i64, v26: i64, v27: i64, v28: i64, v29: i64, v30: ref<managed i64>, v31: ref<managed i64>, v32: i64):
    v33: bool = icmp_sge v24, v26
    branch v33, block7(v29, v26, v25, v27, v28, v30, v31, v32), block4

// compare key
block4:
    v34: ref<borrowed i64> = element.addr v30, v24
    v35: i64 = load v34
    v36: bool = icmp_eq v35, v27
    branch v36, block5(v24, v26, v27, v25, v29, v28, v30, v31, v32), block6(v24, v26, v25, v27, v28, v29, v30, v31, v32)

// found entry
block5(v37: i64, v38: i64, v39: i64, v40: i64, v41: i64, v42: i64, v43: ref<managed i64>, v44: ref<managed i64>, v45: i64):
    v46: ref<borrowed i64> = element.addr v44, v37
    v47: i64 = load v46
    v48: i64 = iadd v40, v47
    store v46, v42
    jump block10(v41, v38, v48, v43, v44, v45)

// advance scan
block6(v49: i64, v50: i64, v51: i64, v52: i64, v53: i64, v54: i64, v55: ref<managed i64>, v56: ref<managed i64>, v57: i64):
    v58: i64 = iconst 1i64
    v59: i64 = iadd v49, v58
    jump block3(v59, v51, v50, v52, v53, v54, v55, v56, v57)

// insert or drop
block7(v60: i64, v61: i64, v62: i64, v63: i64, v64: i64, v65: ref<managed i64>, v66: ref<managed i64>, v67: i64):
    v68: bool = icmp_sge v61, v67
    branch v68, block9(v60, v61, v62, v63, v65, v66, v67), block8(v60, v61, v62, v63, v64, v65, v66, v67)

// insert entry
block8(v69: i64, v70: i64, v71: i64, v72: i64, v73: i64, v74: ref<managed i64>, v75: ref<managed i64>, v76: i64):
    v77: ref<borrowed i64> = element.addr v74, v70
    store v77, v72
    v78: ref<borrowed i64> = element.addr v75, v70
    store v78, v73
    v79: i64 = iadd v71, v73
    v80: i64 = iconst 1i64
    v81: i64 = iadd v70, v80
    jump block10(v69, v81, v79, v74, v75, v76)

// table full
block9(v82: i64, v83: i64, v84: i64, v85: i64, v86: ref<managed i64>, v87: ref<managed i64>, v88: i64):
    v89: i64 = iadd v84, v85
    jump block10(v82, v83, v89, v86, v87, v88)

// advance loop
block10(v90: i64, v91: i64, v92: i64, v93: ref<managed i64>, v94: ref<managed i64>, v95: i64):
    v96: i64 = iconst 1i64
    v97: i64 = iadd v90, v96
    jump block1(v97, v91, v92, v93, v94, v95)

// return result
block12(v98: i64, v99: i64):
    v100: i64 = iadd v98, v99
    v101: i64 = iconst 7i64
    v102: i64 = imul v0, v101
    v103: i64 = iadd v100, v102
    v104: i64 = iconst 3i64
    v105: i64 = iadd v103, v104
    v106: i64 = iconst 3i64
    v107: i64 = sshr v100, v106
    v108: i64 = bxor v105, v107
    v109: i64 = iconst 33i64
    v110: i64 = imul v108, v109
    v111: i64 = iconst 255i64
    v112: i64 = band v0, v111
    v113: i64 = iadd v110, v112
    return v113
}
