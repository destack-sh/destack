
function @field_access(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    v2 = iconst 1i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5 = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update aggregates
block2:
    v6 = intrinsic.add.overflow(v4, v4)
    v7 = field.get v6, 0
    v8 = intrinsic.mul.overflow(v7, v4)
    v9 = field.get v8, 0
    v10 = intrinsic.sub.overflow(v9, v4)
    v11 = field.get v10, 0
    v12 = iconst 255i64
    v13 = band v11, v12
    v14 = iconst 1i64
    v15 = iadd v3, v14
    jump block1(v15, v13)

// return result
block3(v16: i64):
    return v16
}
