
function @build_list(v0: i64, v1: ref<managed i64>) -> ref<managed i64> {

// entry, init state
block0(v0: i64, v1: ref<managed i64>):
    v2 = iconst 0i64
    v3 = icmp_eq v0, v2
    branch v3, block2, block1

// return accumulated value
block1:
    v4 = iconst 2i64
    v5 = managed.alloc_array i64, v4
    store v5, v0
    v6 = field.addr v5, 1
    store v6, v1
    v7 = iconst 1i64
    v8 = isub v0, v7
    v9 = call @build_list(v8, v5)
    return v9

// return result
block2:
    return v1
}

function @walk_list(v0: ref<managed i64>, v1: i64) -> i64 {

// entry, init state
block0(v0: ref<managed i64>, v1: i64):
    v2 = load v0
    v3 = iconst 0i64
    v4 = icmp_eq v2, v3
    branch v4, block2, block1

// return accumulated value
block1:
    v5 = iadd v1, v2
    v6 = field.addr v0, 1
    v7 = load v6
    v8 = call @walk_list(v7, v5)
    return v8

// return result
block2:
    return v1
}

function @linked_walk(v0: i64) -> i64 {

// entry, init allocations, call helper
block0(v0: i64):
    v1 = iconst 2i64
    v2 = managed.alloc_array i64, v1
    v3 = iconst 0i64
    store v2, v3
    v4 = call @build_list(v0, v2)
    v5 = call @walk_list(v4, v3)
    return v5
}
