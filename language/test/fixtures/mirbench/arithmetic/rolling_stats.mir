
function @rolling_stats(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    v3: i64 = iconst 0i64
    jump block1(v1, v2, v3)

// loop condition, check limit
block1(v4: i64, v5: i64, v6: i64):
    v7: bool = icmp_sge v4, v0
    branch v7, block3(v5, v6), block2

// loop body, update rolling stats
block2:
    v8: i64 = iadd v5, v4
    v9: i64 = imul v4, v4
    v10: i64 = iadd v6, v9
    v11: i64 = iconst 1i64
    v12: i64 = iadd v4, v11
    jump block1(v12, v8, v10)

// return result
block3(v13: i64, v14: i64):
    v15: i64 = iadd v13, v14
    v16: i64 = iconst 7i64
    v17: i64 = imul v0, v16
    v18: i64 = iadd v15, v17
    v19: i64 = iconst 3i64
    v20: i64 = iadd v18, v19
    v21: i64 = iconst 3i64
    v22: i64 = sshr v15, v21
    v23: i64 = bxor v20, v22
    v24: i64 = iconst 33i64
    v25: i64 = imul v23, v24
    v26: i64 = iconst 255i64
    v27: i64 = band v0, v26
    v28: i64 = iadd v25, v27
    return v28
}
