
function @binary_float(v0: i64, v1: f64, v2: f64, v3: f64) -> f64 {

// entry, init state
block0(v0: i64, v1: f64, v2: f64, v3: f64):
    v4 = iconst 0i64
    jump block1(v4, v1)

// loop condition, check limit
block1(v5: i64, v6: f64):
    v7 = icmp_sge v5, v0
    branch v7, block3(v6), block2

// loop body, update accumulators
block2:
    v8 = fadd v6, v2
    v9 = fmul v8, v3
    v10 = fsub v9, v2
    v11 = fdiv v10, v3
    v12 = iconst 1i64
    v13 = iadd v5, v12
    jump block1(v13, v11)

// return result
block3(v14: f64):
    return v14
}
