function countPrimes(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 2int64
    v2: int64 = 0int64
    jump b1(v1, v2)
b1(v3: int64, v4: int64):
    v5: boolean = int.gt.s v3, v0
    branch v5, b6(v4), b2
b2:
    v6: int64 = 2int64
    jump b3(v6)
b3(v7: int64):
    v8: int64 = int.mul v7, v7
    v9: boolean = int.gt.s v8, v3
    branch v9, b5, b4
b4:
    v10: int64 = int.rem.s v3, v7
    v11: int64 = 0int64
    v12: boolean = int.eq v10, v11
    branch v12, b7, b8
b5:
    v13: int64 = 1int64
    v14: int64 = int.add v4, v13
    v15: int64 = int.add v3, v13
    jump b1(v15, v14)
b6(v16: int64):
    return v16
b7:
    v17: int64 = 1int64
    v18: int64 = int.add v3, v17
    jump b1(v18, v4)
b8:
    v19: int64 = 1int64
    v20: int64 = int.add v7, v19
    jump b3(v20)
}
