
function mandelbrotSum(
    v0: int64,
    v1: float64,
    v2: float64,
    v3: float64,
    v4: float64,
    v5: float64
) -> int64 {
b0(
    v0: int64,
    v1: float64,
    v2: float64,
    v3: float64,
    v4: float64,
    v5: float64
):
    v6: int64 = 64int64
    v7: int64 = int.mul v6, v6
    v8: int64 = int.div.s v0, v7
    v9: int64 = 1int64
    v10: boolean = int.lt.s v8, v9
    branch v10, b1, b2

// merge branch, continue
b1:
    jump b3(v9)

// merge branch, continue
b2:
    jump b3(v8)

// merge branch, continue
b3(v11: int64):
    v12: int64 = 0int64
    v13: int64 = 0int64
    jump b4(v12, v13, v11)

// loop condition, check limit
b4(v14: int64, v15: int64, v16: int64):
    v17: boolean = int.ge.s v14, v16
    branch v17, b24(v15), b5

// merge branch, continue
b5:
    v18: int64 = 0int64
    jump b6(v18, v14, v15, v16)

// loop condition, check limit
b6(v19: int64, v20: int64, v21: int64, v22: int64):
    v23: boolean = int.ge.s v19, v6
    branch v23, b23(v20, v21, v22), b7

// merge branch, continue
b7:
    v24: int64 = 0int64
    jump b8(v24, v19, v20, v21, v22)

// loop condition, check limit
b8(v25: int64, v26: int64, v27: int64, v28: int64, v29: int64):
    v30: boolean = int.ge.s v25, v6
    branch v30, b22(v26, v27, v28, v29), b9

// branch on condition
b9:
    v31: float64 = cast.intToFloat.s v25 -> float64
    v32: float64 = cast.intToFloat.s v26 -> float64
    v33: float64 = float.mul v31, v3
    v34: float64 = float.add v1, v33
    v35: float64 = float.mul v32, v3
    v36: float64 = float.add v2, v35
    v37: float64 = float.sub v1, v1
    v38: float64 = float.sub v2, v2
    v39: int64 = 0int64
    jump b10(v39, v37, v38, v34, v36, v25, v26, v27, v28, v29)
b10(
    v40: int64,
    v41: float64,
    v42: float64,
    v43: float64,
    v44: float64,
    v45: int64,
    v46: int64,
    v47: int64,
    v48: int64,
    v49: int64
):
    v50: int64 = 32int64
    v51: boolean = int.ge.s v40, v50
    branch v51, b20(v40, v45, v46, v47, v48, v49), b11

// branch on condition
b11:
    v52: float64 = float.mul v41, v41
    v53: float64 = float.mul v42, v42
    v54: float64 = float.add v52, v53
    v55: boolean = float.gt v54, v4
    branch v55, b20(v40, v45, v46, v47, v48, v49), b12

// loop body, update accumulators
b12:
    v56: float64 = float.mul v41, v42
    v57: float64 = float.mul v56, v5
    v58: float64 = float.add v57, v44
    v59: float64 = float.sub v52, v53
    v60: float64 = float.add v59, v43
    v61: int64 = 1int64
    v62: int64 = int.add v40, v61
    jump b10(v62, v60, v58, v43, v44, v45, v46, v47, v48, v49)

// merge branches, advance loop
b20(v63: int64, v64: int64, v65: int64, v66: int64, v67: int64, v68: int64):
    v69: int64 = int.add v67, v63
    v70: int64 = 1int64
    v71: int64 = int.add v64, v70
    jump b8(v71, v65, v66, v69, v68)

// loop body, update accumulators
b22(v72: int64, v73: int64, v74: int64, v75: int64):
    v76: int64 = 1int64
    v77: int64 = int.add v72, v76
    jump b6(v77, v73, v74, v75)

// loop body, update accumulators
b23(v78: int64, v79: int64, v80: int64):
    v81: int64 = 1int64
    v82: int64 = int.add v78, v81
    jump b4(v82, v79, v80)

// return result
b24(v83: int64):
    return v83
}
