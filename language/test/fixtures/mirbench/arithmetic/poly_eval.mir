
function @poly_eval(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, evaluate polynomial
block2:
    v6: i64 = iconst 3i64
    v7: i64 = imul v3, v6
    v8: i64 = iconst 5i64
    v9: i64 = iadd v7, v8
    v10: i64 = imul v9, v3
    v11: i64 = iconst 7i64
    v12: i64 = iadd v10, v11
    v13: i64 = imul v12, v3
    v14: i64 = iconst 11i64
    v15: i64 = iadd v13, v14
    v16: i64 = iadd v4, v15
    v17: i64 = iconst 1i64
    v18: i64 = iadd v3, v17
    jump block1(v18, v16)

// return result
block3(v19: i64):
    v20: i64 = iconst 7i64
    v21: i64 = imul v0, v20
    v22: i64 = iadd v19, v21
    v23: i64 = iconst 3i64
    v24: i64 = iadd v22, v23
    v25: i64 = iconst 3i64
    v26: i64 = sshr v19, v25
    v27: i64 = bxor v24, v26
    v28: i64 = iconst 33i64
    v29: i64 = imul v27, v28
    v30: i64 = iconst 255i64
    v31: i64 = band v0, v30
    v32: i64 = iadd v29, v31
    return v32
}
