function collatzSteps(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 0int64
    jump b1(v0, v1)
b1(v2: int64, v3: int64):
    v4: int64 = 1int64
    v5: boolean = int.eq v2, v4
    branch v5, b5(v3), b2
b2:
    v6: int64 = 2int64
    v7: int64 = int.rem.s v2, v6
    v8: int64 = 0int64
    v9: boolean = int.eq v7, v8
    branch v9, b3, b4
b3:
    v10: int64 = 2int64
    v11: int64 = int.div.s v2, v10
    v12: int64 = 1int64
    v13: int64 = int.add v3, v12
    jump b1(v11, v13)
b4:
    v14: int64 = 3int64
    v15: int64 = int.mul v2, v14
    v16: int64 = 1int64
    v17: int64 = int.add v15, v16
    v18: int64 = int.add v3, v16
    jump b1(v17, v18)
b5(v19: int64):
    return v19
}
function collatzSum(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 1int64
    v2: int64 = 0int64
    jump b1(v1, v2)
b1(v3: int64, v4: int64):
    v5: boolean = int.gt.s v3, v0
    branch v5, b3(v4), b2
b2:
    v6: int64 = call collatzSteps(v3): (int64) -> int64
    v7: int64 = int.add v4, v6
    v8: int64 = 1int64
    v9: int64 = int.add v3, v8
    jump b1(v9, v7)
b3(v10: int64):
    return v10
}
