
function @collatz_steps(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    jump block1(v0, v1)

// base case check
block1(v2: i64, v3: i64):
    v4: i64 = iconst 1i64
    v5: bool = icmp_eq v2, v4
    branch v5, block5(v3), block2

// base case check
block2:
    v6: i64 = iconst 2i64
    v7: i64 = srem v2, v6
    v8: i64 = iconst 0i64
    v9: bool = icmp_eq v7, v8
    branch v9, block3, block4

// loop body, update accumulators
block3:
    v10: i64 = iconst 2i64
    v11: i64 = sdiv v2, v10
    v12: i64 = iconst 1i64
    v13: i64 = iadd v3, v12
    jump block1(v11, v13)

// loop body, update accumulators
block4:
    v14: i64 = iconst 3i64
    v15: i64 = imul v2, v14
    v16: i64 = iconst 1i64
    v17: i64 = iadd v15, v16
    v18: i64 = iadd v3, v16
    jump block1(v17, v18)

// return result
block5(v19: i64):
    return v19
}

function @collatz_sum(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 1i64
    v2: i64 = iconst 0i64
    jump block1(v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sgt v3, v0
    branch v5, block3(v4), block2

// loop body, call helper
block2:
    v6: i64 = call @collatz_steps(v3)
    v7: i64 = iadd v4, v6
    v8: i64 = iconst 1i64
    v9: i64 = iadd v3, v8
    jump block1(v9, v7)

// return result
block3(v10: i64):
    return v10
}
