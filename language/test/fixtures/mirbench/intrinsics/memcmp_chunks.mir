
function @memcmp_chunks(v0: i64, v1: i64) -> i64 {

// entry, clamp length
block0(v0: i64, v1: i64):
    v2: i64 = iconst 16i64
    v3: bool = icmp_slt v1, v2
    branch v3, block1, block2

// merge branch, continue
block1:
    jump block3(v2)

// merge branch, continue
block2:
    jump block3(v1)

// entry, init state
block3(v4: i64):
    v5: ref<managed u8> = managed.alloc_array u8, v4
    v6: ref<managed u8> = managed.alloc_array u8, v4
    v7: i64 = iconst 0i64
    jump block4(v7, v4, v5, v6)

// loop condition, fill buffers
block4(v8: i64, v9: i64, v10: ref<managed u8>, v11: ref<managed u8>):
    v12: bool = icmp_sge v8, v9
    branch v12, block9(v9, v10, v11), block5

// fill buffers
block5:
    v13: i64 = iconst 3i64
    v14: i64 = imul v8, v13
    v15: i64 = iconst 1i64
    v16: i64 = iadd v14, v15
    v17: i64 = iconst 255i64
    v18: i64 = band v16, v17
    v19: u8 = trunc v18 -> u8
    v20: ref<borrowed u8> = element.addr v10, v8
    store v20, v19
    v21: i64 = iconst 7i64
    v22: i64 = band v8, v21
    v23: i64 = iconst 0i64
    v24: bool = icmp_eq v22, v23
    branch v24, block6(v18, v8, v9, v10, v11), block7(v19, v8, v9, v10, v11)

// fill right buffer with offset
block6(v25: i64, v26: i64, v27: i64, v28: ref<managed u8>, v29: ref<managed u8>):
    v30: i64 = iconst 1i64
    v31: i64 = iadd v25, v30
    v32: i64 = iconst 255i64
    v33: i64 = band v31, v32
    v34: u8 = trunc v33 -> u8
    v35: ref<borrowed u8> = element.addr v29, v26
    store v35, v34
    jump block8(v26, v27, v28, v29)

// fill right buffer without offset
block7(v36: u8, v37: i64, v38: i64, v39: ref<managed u8>, v40: ref<managed u8>):
    v41: ref<borrowed u8> = element.addr v40, v37
    store v41, v36
    jump block8(v37, v38, v39, v40)

// advance fill loop
block8(v42: i64, v43: i64, v44: ref<managed u8>, v45: ref<managed u8>):
    v46: i64 = iconst 1i64
    v47: i64 = iadd v42, v46
    jump block4(v47, v43, v44, v45)

// init compare loop
block9(v48: i64, v49: ref<managed u8>, v50: ref<managed u8>):
    v51: i64 = iconst 0i64
    v52: i64 = iconst 0i64
    jump block10(v51, v52, v48, v49, v50)

// loop condition, compare chunks
block10(v53: i64, v54: i64, v55: i64, v56: ref<managed u8>, v57: ref<managed u8>):
    v58: bool = icmp_sge v53, v55
    branch v58, block15(v54), block11

// compute chunk length
block11:
    v59: i64 = isub v55, v53
    v60: i64 = iconst 16i64
    v61: bool = icmp_slt v59, v60
    branch v61, block12(v59, v53, v54, v55, v56, v57), block13(v60, v53, v54, v55, v56, v57)

// use tail length
block12(v62: i64, v63: i64, v64: i64, v65: i64, v66: ref<managed u8>, v67: ref<managed u8>):
    jump block14(v62, v63, v64, v65, v66, v67)

// use full chunk length
block13(v68: i64, v69: i64, v70: i64, v71: i64, v72: ref<managed u8>, v73: ref<managed u8>):
    jump block14(v68, v69, v70, v71, v72, v73)

// compare chunk
block14(v74: i64, v75: i64, v76: i64, v77: i64, v78: ref<managed u8>, v79: ref<managed u8>):
    v80: ref<borrowed u8> = element.addr v78, v75
    v81: ref<borrowed u8> = element.addr v79, v75
    v82: i32 = intrinsic.memcmp(v80, v81, v74)
    v83: i64 = sextend v82 -> i64
    v84: i64 = iadd v76, v83
    v85: i64 = iadd v75, v74
    jump block10(v85, v84, v77, v78, v79)

// init scale loop
block15(v86: i64):
    v87: i64 = iconst 0i64
    v88: i64 = iconst 0i64
    jump block16(v87, v88, v86)

// loop condition, scale result
block16(v89: i64, v90: i64, v91: i64):
    v92: bool = icmp_sge v89, v0
    branch v92, block18(v90), block17

// loop body, accumulate
block17:
    v93: i64 = iadd v90, v91
    v94: i64 = iconst 1i64
    v95: i64 = iadd v89, v94
    jump block16(v95, v93, v91)

// return result
block18(v96: i64):
    v97: i64 = bxor v0, v4
    v98: i64 = iconst 7i64
    v99: i64 = imul v97, v98
    v100: i64 = iadd v96, v99
    v101: i64 = iconst 3i64
    v102: i64 = iadd v100, v101
    v103: i64 = iconst 3i64
    v104: i64 = sshr v96, v103
    v105: i64 = bxor v102, v104
    v106: i64 = iconst 33i64
    v107: i64 = imul v105, v106
    v108: i64 = iconst 255i64
    v109: i64 = band v97, v108
    v110: i64 = iadd v107, v109
    return v110
}
