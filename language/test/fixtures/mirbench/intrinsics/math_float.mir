
function @math_float(v0: i64, v1: f64, v2: f64) -> f64 {

// entry, init state
block0(v0: i64, v1: f64, v2: f64):
    v3: i64 = iconst 0i64
    jump block1(v3, v1, v2)

// loop condition, check limit
block1(v4: i64, v5: f64, v6: f64):
    v7: bool = icmp_sge v4, v0
    branch v7, block3(v5), block2

// loop body, update memory
block2:
    v8: f64 = intrinsic.sqrt(v6)
    v9: f64 = intrinsic.sin(v6)
    v10: f64 = intrinsic.cos(v6)
    v11: f64 = fmul v9, v9
    v12: f64 = fmul v10, v10
    v13: f64 = fadd v11, v12
    v14: f64 = fadd v5, v13
    v15: f64 = fadd v6, v2
    v16: i64 = iconst 1i64
    v17: i64 = iadd v4, v16
    jump block1(v17, v14, v15)

// return result
block3(v18: f64):
    return v18
}
