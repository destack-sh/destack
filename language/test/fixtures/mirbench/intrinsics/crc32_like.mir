
function @crc32_like(v0: i64, v1: i64) -> i64 {

// entry, init state
block0(v0: i64, v1: i64):
    v2: i64 = iconst 0i64
    jump block1(v2, v1)

// loop condition, check limit
block1(v3: i64, v4: i64):
    v5: bool = icmp_sge v3, v0
    branch v5, block3(v4), block2

// loop body, update memory
block2:
    v6: i64 = iconst 31i64
    v7: i64 = imul v3, v6
    v8: i64 = iconst 17i64
    v9: i64 = iadd v7, v8
    v10: i64 = iconst 255i64
    v11: i64 = band v9, v10
    v12: i64 = bxor v4, v11
    v13: i64 = iconst 5i64
    v14: i64 = intrinsic.rotate_left(v12, v13)
    v15: i64 = intrinsic.byte_swap(v14)
    v16: i64 = iconst 517762881i64
    v17: i64 = imul v15, v16
    v18: i64 = bxor v17, v11
    v19: i64 = iconst 11i64
    v20: i64 = intrinsic.rotate_right(v18, v19)
    v21: i64 = iconst 2246822519i64
    v22: i64 = imul v20, v21
    v23: i64 = iconst 1i64
    v24: i64 = iadd v3, v23
    jump block1(v24, v22)

// return result
block3(v25: i64):
