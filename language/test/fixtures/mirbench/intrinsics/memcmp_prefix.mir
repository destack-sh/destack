    jump b10(v50, v51, v47, v48, v49)
b10(v52: int64, v53: int64, v54: int64, v55: slice<uint8>, v56: slice<uint8>):
    v57: boolean = int.ge.s v52, v54
    branch v57, b12(v53), b11
b11:
    v58: ref<uint8, borrowed> = element.address v55, v52
    v59: ref<uint8, borrowed> = element.address v56, v52
    v60: int64 = int.sub v54, v52
    v61: int32 = intrinsic.memcmp(v58, v59, v60)
    v62: int64 = cast.extend.s v61 -> int64
    v63: int64 = int.add v53, v62
    v64: int64 = 1int64
    v65: int64 = int.add v52, v64
    jump b10(v65, v63, v54, v55, v56)
b12(v66: int64):
    v67: int64 = 7int64
    v68: int64 = int.mul v54, v67
    v69: int64 = int.add v66, v68
    v70: int64 = 3int64
    v71: int64 = int.add v69, v70
    v72: int64 = 3int64
    v73: int64 = int.shiftRight.s v66, v72
    v74: int64 = int.xor v71, v73
    v75: int64 = 33int64
    v76: int64 = int.mul v74, v75
    v77: int64 = 255int64
    v78: int64 = int.and v54, v77
    v79: int64 = int.add v76, v78
    return v79
}
