    v18: uint8 = cast.truncate v17 -> uint8
    v19: ref<uint8, borrowed> = element.address v9, v7
    store v19, v18
    v20: int64 = 3int64
    v21: int64 = int.and v7, v20
    v22: int64 = 0int64
    v23: boolean = int.eq v21, v22
    branch v23, b6(v17, v7, v8, v9, v10), b7(v18, v7, v8, v9, v10)
b6(v24: int64, v25: int64, v26: int64, v27: slice<uint8>, v28: slice<uint8>):
    v29: int64 = 1int64
