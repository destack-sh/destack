function memcmpPrefix(v0: int64): int64 {
b0(v0: int64):
    v1: int64 = 1int64
    v2: boolean = int.lt.s v0, v1
    branch v2, b1, b2
b1:
    jump b3(v1)
b2:
    jump b3(v0)
b3(v3: int64):
    v4: slice<uint8> = new.slice uint8, v3
    v5: slice<uint8> = new.slice uint8, v3
