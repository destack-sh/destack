
function @checked_arith(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1: i64 = iconst 0i64
    v2: i64 = iconst 1i64
    jump block1(v1, v2, v1)

// loop condition, check limit
block1(v3: i64, v4: i64, v5: i64):
    v6: bool = icmp_sge v3, v0
    branch v6, block3(v5), block2

// branch on condition
