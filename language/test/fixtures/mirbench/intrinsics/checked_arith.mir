    v7: (i64, bool) = intrinsic.add.overflow(v4, v2)
    v8: i64 = field.get v7, 0
    v9: bool = field.get v7, 1
    branch v9, block4, block6

// merge branch, continue
block4:
    v10: i64 = iconst 1i64
    jump block5(v10)

// loop body, advance state
block6:
    v11: i64 = iconst 0i64
    jump block5(v11)

// merge branches, advance loop
block5(v12: i64):
    v13: i64 = iadd v5, v12
    v14: i64 = iconst 1i64
    v15: i64 = iadd v3, v14
    v16: i64 = iconst 127i64
    v17: i64 = srem v8, v16
    jump block1(v15, v17, v13)

