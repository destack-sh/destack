            "bundle": {
                "minify": {
                    "whitespace": true
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        },
        "page3": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/pages/page3.html"
            ],
            "outFile": "dist/page3.html",
            "bundle": {
                "minify": {
                    "whitespace": true
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
