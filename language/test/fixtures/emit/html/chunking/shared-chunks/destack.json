{
    "name": "html-chunking-shared-chunks",
    "targets": {
        "page1": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/pages/page1.html"
            ],
            "outFile": "dist/page1.html",
            "bundle": {
                "minify": {
                    "whitespace": true
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        },
        "page2": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/pages/page2.html"
            ],
