{
  "name": "html-chunking-shared-asset-grid",
  "defaultTarget": "landing",
  "targets": {
    "landing": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/pages/landing.html"
      ],
      "outFile": "dist/landing.html",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name]-[hash].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    },
    "docs": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/pages/docs.html"
      ],
      "outFile": "dist/docs.html",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name]-[hash].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    },
    "pricing": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/pages/pricing.html"
      ],
      "outFile": "dist/pricing.html",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name]-[hash].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    },
    "status": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/pages/status.html"
      ],
      "outFile": "dist/status.html",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name]-[hash].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
