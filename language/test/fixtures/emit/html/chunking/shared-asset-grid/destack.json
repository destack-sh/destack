{
    "name": "html-chunking-shared-asset-grid",
    "targets": {
        "landing": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/pages/landing.html"
            ],
            "outFile": "dist/landing.html",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "assetFileNames": "assets/[name]-[hash].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        },
        "docs": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/pages/docs.html"
