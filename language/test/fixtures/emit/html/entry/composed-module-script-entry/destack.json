{
  "name": "emit-html-entry-composed-module-script-entry",
  "targets": {
    "site": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/index.html"
      ],
      "outFile": "dist/index.html",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name]-[hash].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
