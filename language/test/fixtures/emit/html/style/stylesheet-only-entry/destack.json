{
  "name": "emit-html-style-stylesheet-only-entry",
  "targets": {
    "site": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/page.html"
      ],
      "outFile": "dist/page.html",
      "output": {
        "assetFileNames": "assets/[name].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
