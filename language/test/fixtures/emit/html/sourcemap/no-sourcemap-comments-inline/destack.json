{
  "name": "emit-html-sourcemap-no-sourcemap-comments-inline",
  "targets": {
    "site": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/in/index.html"
      ],
      "outFile": "dist/index.html",
      "output": {
        "sourcemap": "inline",
        "manifest": true
      }
    }
  }
}
