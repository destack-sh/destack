import { getPageSummary, pageTitle, pageHeading } from "./page-summary.ds";
import { getSectionBadge, normalizePageSlug } from "./page-sections.ds";

export { pageTitle, pageHeading };

/** Read the exported page summary for one workspace page slug. */
export function pageSummary(slug = "overview") {
    return getPageSummary(slug);
}

/** Read the section badge for one workspace page slug. */
export function pageSectionBadge(slug = "overview") {
    return getSectionBadge(slug);
}

/** Build the section path for one workspace page slug. */
export function pageSectionPath(slug = "overview") {
    return `/reference/${normalizePageSlug(slug)}`;
}
