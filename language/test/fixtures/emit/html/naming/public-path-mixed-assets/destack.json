{
    "name": "html-naming-public-path-mixed-assets",
    "targets": {
        "site": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/index.html"
            ],
            "outFile": "dist/index.html",
            "bundle": {
                "output": {
                    "publicPath": "https://cdn.example.com/site",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
