{
    "name": "html-loaders-js-imported-css",
    "targets": {
        "site": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/index.html"
            ],
            "outFile": "dist/index.html",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
