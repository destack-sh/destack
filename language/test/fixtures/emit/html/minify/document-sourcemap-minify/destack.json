{
  "name": "html-minify-document-sourcemap-minify",
  "targets": {
    "site": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/index.html"
      ],
      "outFile": "dist/index.html",
      "assets": {
        "mode": "emit"
      },
      "minify": {
        "syntax": true,
        "whitespace": true
      },
      "output": {
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
