{
  "name": "html-minify-document-css-syntax",
  "targets": {
    "site": {
      "emit": "html",
      "runtime": "browser",
      "entry": [
        "src/index.html"
      ],
      "outFile": "dist/index.html",
      "minify": {
        "syntax": true
      },
      "output": {
        "manifest": true
      }
    }
  }
}
