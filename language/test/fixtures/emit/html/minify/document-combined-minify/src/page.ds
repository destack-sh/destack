import { formatMetricLabel, unreadActivityCount } from "./metrics.ts";
import { featureName, productName, releaseChannel } from "./strings.ts";

const shellLabel = `${productName} ${featureName}`;
const activityLabel =
    unreadActivityCount === 0
        ? "Inbox clear"
        : formatMetricLabel(unreadActivityCount);
const channelLabel = releaseChannel ? `channel:${releaseChannel}` : "channel:stable";

export const pageTitle = shellLabel;
export const summaryLine = `${shellLabel} • ${activityLabel} • ${channelLabel}`;
