{
    "name": "html-minify-document-public-path-minify",
    "targets": {
        "site": {
            "emit": "html",
            "runtime": "browser",
            "entry": [
                "src/index.html"
            ],
            "outFile": "dist/index.html",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "minify": true,
                "output": {
                    "publicPath": "https://cdn.example.com/minified",
                    "assetFileNames": "assets/[name]-[hash].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
