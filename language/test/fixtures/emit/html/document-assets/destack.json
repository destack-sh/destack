{
    "name": "html-document-assets",
    "targets": {
        "site": {
            "emit": "html",
            "entry": ["src/index.html"],
            "outFile": "dist/index.html",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "assetFileNames": "assets/[name].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
