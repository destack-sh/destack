{
  "name": "script-loaders-absolute-uri-import",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/index.ts"
      ],
      "outFile": "dist/site/index.ts",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
