{
    "name": "script-loaders-split-shared",
    "targets": {
        "site": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/index.ts"
            ],
            "outDir": "dist/site",
            "bundle": {
                "mode": "chunked",
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "assetFileNames": "assets/[name].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
