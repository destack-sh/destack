{
    "name": "script-loaders-url-in-supports-query",
    "targets": {
        "site": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/index.ts"
            ],
            "outFile": "dist/site/index.ts",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "assetFileNames": "assets/[name].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
