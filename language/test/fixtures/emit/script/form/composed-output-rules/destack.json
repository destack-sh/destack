{
    "name": "script-form-composed-output-rules",
    "targets": {
        "bundle": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/main.ts"
            ],
            "outFile": "dist/bundle/bundle.js",
            "bundle": {
                "dependencies": {
                    "neverBundle": [
                        "external"
                    ]
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
