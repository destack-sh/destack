{
  "name": "script-preserve-modules-banner-footer",
  "targets": {
    "library": {
      "emit": "js",
      "entry": ["src/application.ts"],
      "outDir": "dist/library",
      "bundle": {
        "mode": "preserveModules",
        "output": {
          "banner": "/* banner */",
          "footer": "/* footer */",
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
