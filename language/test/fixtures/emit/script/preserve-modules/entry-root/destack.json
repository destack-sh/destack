{
  "name": "script-preserve-modules-entry-root",
  "targets": {
    "library": {
      "emit": "js",
      "entry": ["src/application.js"],
      "outDir": "dist/library",
      "bundle": {
        "preserveModules": true,
        "output": {
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
