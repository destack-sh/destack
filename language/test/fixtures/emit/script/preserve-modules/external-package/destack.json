{
  "name": "script-preserve-modules-external-package",
  "targets": {
    "library": {
      "emit": "js",
      "include": ["src/**/*.ts"],
      "outDir": "dist/library",
      "sourceMapMode": "external",
      "bundle": {
        "chunk": {
          "preserveModules": true
        },
        "dependency": {
          "neverBundle": ["react"]
        },
        "output": {
          "manifest": true
        }
      }
    }
  }
}
