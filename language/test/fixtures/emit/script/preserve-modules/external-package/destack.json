{
  "name": "script-preserve-modules-external-package",
  "targets": {
    "library": {
      "emit": "js",
      "include": ["src/**/*.ts"],
      "outDir": "dist/library",
      "bundle": {
        "preserveModules": true,
        "dependencies": {
          "neverBundle": ["react"]
        },
        "output": {
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
