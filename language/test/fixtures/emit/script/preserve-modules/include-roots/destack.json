{
  "name": "script-preserve-modules-include-roots",
  "targets": {
    "library": {
      "emit": "js",
      "include": ["src/**/*.js"],
      "outDir": "dist/library",
      "bundle": {
        "preserveModules": true,
        "output": {
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
