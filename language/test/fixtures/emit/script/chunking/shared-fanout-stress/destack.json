{
  "name": "script-chunking-shared-fanout-stress",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/app.ts",
        "src/admin.ts",
        "src/docs.ts",
        "src/reports.ts"
      ],
      "outDir": "dist/site",
      "mode": "chunked",
      "output": {
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
