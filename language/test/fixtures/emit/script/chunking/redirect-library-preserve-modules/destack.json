{
    "name": "script-preserve-modules-redirect-library",
    "targets": {
        "library": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/app.ts"
            ],
            "outDir": "dist/library",
            "bundle": {
                "preserveModules": true,
                "preserveModulesRoot": "src",
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
