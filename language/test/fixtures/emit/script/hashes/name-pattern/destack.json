{
  "name": "script-hashes-name-pattern",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/pages/home.ts",
        "src/pages/settings.ts"
      ],
      "outDir": "dist/site",
      "assembly": "chunked",
      "output": {
        "entryFileNames": "entries/[name]-[hash].js",
        "chunkFileNames": "chunks/[name]-[hash].js",
        "manifest": true
      }
    }
  }
}
