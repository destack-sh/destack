{
  "name": "script-single-file-external-package",
  "targets": {
    "bundle": {
      "emit": "js",
      "entry": ["src/react-bridge.ts"],
      "outFile": "dist/bundle.js",
      "bundle": {
        "dependencies": {
          "neverBundle": ["react"]
        },
        "output": {
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
