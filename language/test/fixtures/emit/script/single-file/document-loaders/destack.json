{
    "name": "script-single-file-document-loaders",
    "targets": {
        "preview": {
            "emit": "js",
            "entry": ["src/app.ts"],
            "outFile": "dist/preview/app.js",
            "bundle": {
                "assets": {
                    "mode": "emit"
                },
                "output": {
                    "assetFileNames": "assets/[name].[ext]",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
