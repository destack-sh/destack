{
    "name": "script-single-file-react-bridge",
    "targets": {
        "bridge": {
            "emit": "js",
            "entry": ["src/react-bridge.ts"],
            "outFile": "dist/bridge/react-bridge.js",
            "bundle": {
                "dependencies": {
                    "neverBundle": ["react"]
                },
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
