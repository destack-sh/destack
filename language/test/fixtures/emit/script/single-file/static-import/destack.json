{
  "name": "script-single-file-static-import",
  "targets": {
    "bundle": {
      "emit": "js",
      "entry": ["src/application.js"],
      "outFile": "dist/bundle.js",
      "sourceMapMode": "external",
      "bundle": {
        "output": {
          "manifest": true
        }
      }
    }
  }
}
