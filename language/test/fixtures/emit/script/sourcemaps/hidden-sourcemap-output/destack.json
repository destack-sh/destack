{
    "name": "script-sourcemaps-hidden-sourcemap-output",
    "targets": {
        "preview": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/main.ts"
            ],
            "outFile": "dist/preview/app.js",
            "bundle": {
                "output": {
                    "sourcemap": "hidden",
                    "manifest": true
                }
            }
        }
    }
}
