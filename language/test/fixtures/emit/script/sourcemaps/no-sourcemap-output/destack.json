{
  "name": "script-sourcemaps-no-sourcemap-output",
  "targets": {
    "preview": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/main.ts"
      ],
      "outFile": "dist/preview/app.js",
      "output": {
        "sourcemap": false,
        "manifest": true
      }
    }
  }
}
