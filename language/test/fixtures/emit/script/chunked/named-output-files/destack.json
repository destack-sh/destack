{
  "name": "script-chunked-named-output-files",
  "targets": {
    "bundle": {
      "emit": "js",
      "entry": ["src/application.ts", "src/dashboard.ts"],
      "outDir": "dist/bundle",
      "bundle": {
        "output": {
          "entryFileNames": "entries/[name]-entry.[ext]",
          "chunkFileNames": "chunks/[name]-shared.[ext]",
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
