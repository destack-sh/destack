{
    "name": "script-chunked-oauth-console",
    "targets": {
        "site": {
            "emit": "js",
            "entry": ["src/app.ts", "src/dashboard.ts"],
            "outDir": "dist/site",
            "bundle": {
                "output": {
                    "entryFileNames": "entries/[name].js",
                    "chunkFileNames": "chunks/[name].js",
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
