{
  "name": "script-chunked-dynamic-import",
  "targets": {
    "bundle": {
      "emit": "js",
      "entry": ["src/application.ts"],
      "outDir": "dist/bundle",
      "bundle": {
        "mode": "chunked",
        "output": {
          "sourcemap": "external",
          "manifest": true
        }
      }
    }
  }
}
