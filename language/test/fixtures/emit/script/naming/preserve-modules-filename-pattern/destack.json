{
    "name": "script-naming-preserve-modules-filename-pattern",
    "targets": {
        "library": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/main.ts"
            ],
            "outDir": "dist/library",
            "bundle": {
                "preserveModules": true,
                "preserveModulesRoot": "src",
                "output": {
                    "sourcemap": "external",
                    "manifest": true
                }
            }
        }
    }
}
