{
    "name": "script-minify-compact-multiple-imports",
    "targets": {
        "preview": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/main.ts"
            ],
            "outFile": "dist/preview/app.js",
            "bundle": {
                "minify": {
                    "whitespace": true
                },
                "output": {
                    "manifest": true
                }
            }
        }
    }
}
