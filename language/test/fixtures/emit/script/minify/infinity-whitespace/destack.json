{
  "name": "script-minify-infinity-whitespace",
  "targets": {
    "preview": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/app.ts"
      ],
      "outFile": "dist/preview/app.js",
      "minify": {
        "syntax": true,
        "whitespace": true
      },
      "output": {
        "manifest": true
      }
    }
  }
}
