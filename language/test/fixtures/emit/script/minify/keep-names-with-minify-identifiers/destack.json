{
  "name": "script-minify-keep-names-with-minify-identifiers",
  "targets": {
    "preview": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/app.ts"
      ],
      "outFile": "dist/preview/app.js",
      "minify": {
        "syntax": true,
        "identifiers": true,
        "keepNames": true
      },
      "output": {
        "manifest": true
      }
    }
  }
}
