{
    "name": "script-minify-trim-code-in-dead-control-flow",
    "targets": {
        "preview": {
            "emit": "js",
            "runtime": "browser",
            "entry": [
                "src/app.ts"
            ],
            "outFile": "dist/preview/app.js",
            "bundle": {
                "minify": {
                    "syntax": true,
                    "whitespace": true
                },
                "output": {
                    "manifest": true
                }
            }
        }
    }
}
