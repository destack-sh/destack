{
  "name": "emit-js-dependency-reexport-external-namespace",
  "targets": {
    "bundle": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/main.ts"
      ],
      "outFile": "dist/bundle/bundle.js",
      "dependencies": {
        "neverBundle": [
          "external"
        ]
      },
      "output": {
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
