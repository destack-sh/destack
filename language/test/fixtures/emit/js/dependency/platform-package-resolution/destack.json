{
  "name": "emit-js-dependency-platform-package-resolution",
  "targets": {
    "cli": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/app.ts"
      ],
      "outFile": "dist/cli/app.js",
      "output": {
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
