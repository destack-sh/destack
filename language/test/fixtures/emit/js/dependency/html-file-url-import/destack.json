{
  "name": "emit-js-dependency-html-file-url-import",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/entry.ts"
      ],
      "outFile": "dist/entry.js",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
