{
  "name": "emit-js-dependency-multiple-html-string-imports",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/server.ts"
      ],
      "outFile": "dist/server.js",
      "assets": {
        "mode": "emit"
      },
      "output": {
        "assetFileNames": "assets/[name].[ext]",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
