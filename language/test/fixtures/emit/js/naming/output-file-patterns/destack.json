{
  "name": "emit-js-naming-output-file-patterns",
  "targets": {
    "site": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/main1.ts",
        "src/main2.ts",
        "src/main3.ts"
      ],
      "outDir": "dist/site",
      "assembly": "chunked",
      "output": {
        "entryFileNames": "entries/entry-[name]-[hash]-[format].js",
        "chunkFileNames": "chunks/chunk-[name]-[hash]-[format].js",
        "sourcemap": "external",
        "manifest": true
      }
    }
  }
}
