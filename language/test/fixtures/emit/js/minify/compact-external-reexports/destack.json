{
  "name": "emit-js-minify-compact-external-reexports",
  "targets": {
    "preview": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/main.ts"
      ],
      "outFile": "dist/preview/app.js",
      "dependencies": {
        "neverBundle": [
          "external1",
          "external2",
          "external3",
          "external4"
        ]
      },
      "minify": {
        "whitespace": true
      },
      "output": {
        "manifest": true
      }
    }
  }
}
