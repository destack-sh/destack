{
  "name": "emit-js-minify-compact-named-export",
  "targets": {
    "preview": {
      "emit": "js",
      "runtime": "browser",
      "entry": [
        "src/main.ts"
      ],
      "outFile": "dist/preview/app.js",
      "minify": {
        "whitespace": true
      },
      "output": {
        "manifest": true
      }
    }
  }
}
