{
  "$schema": "../../schema/suite.schema.json",
  "id": "formatter.prettier",
  "domain": "formatter",
  "suite": "prettier",
  "title": "Formatter Prettier",
  "origin": {
    "repo": "https://github.com/prettier/prettier.git",
    "ref": "574b18d7d692370ace1b67c763b486926b4fb139",
    "kind": "git"
  },
  "fetch": {
    "entries": [
      {
        "kind": "source",
        "label": "prettier formatter",
        "version": "3.x",
        "layout": "strip",
        "include": [
          "**/*.js",
          "**/*.jsx",
          "**/*.ts",
          "**/*.tsx",
          "**/__snapshots__/format.test.js.snap"
        ],
        "exclude": [
          "**/format.test.js"
        ],
        "paths": [
          "tests/format"
        ]
      }
    ]
  }
}
