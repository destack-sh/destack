        },
        {
            "patterns": ["js/comments/logical.js"],
            "status": "known-fail-idempotence",
            "reason": "upstream",
            "note": "Oxc itself is non-idempotent for this fixture; second pass moves the trailing logical-expression comment outside the inner parentheses"
        },
        {
            "patterns": [
                "js/comments/assignments.js",
