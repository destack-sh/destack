{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuiteMetadata",
  "description": "One conformance suite metadata file.",
  "type": "object",
  "properties": {
    "id": {
      "description": "The stable suite identifier.",
      "type": "string"
    },
    "domain": {
      "description": "The top level compatibility domain.",
      "$ref": "#/$defs/ConformanceDomain"
    },
    "suite": {
      "description": "The imported suite name.",
      "type": "string"
    },
    "title": {
      "description": "The human readable suite title.",
      "type": "string"
    },
    "origin": {
      "description": "The origin source metadata.",
      "$ref": "#/$defs/OriginMetadata"
    },
    "fetch": {
      "description": "The optional fetch metadata for the suite case tree.",
      "$ref": "#/$defs/FetchMetadata",
      "default": {
        "entries": []
      }
    }
  },
  "required": [
    "id",
    "domain",
    "suite",
    "title",
    "origin"
  ],
  "$defs": {
    "ConformanceDomain": {
      "description": "One conformance domain.",
      "oneOf": [
        {
          "description": "The ECMA compatibility domain.",
          "type": "string",
          "const": "ecma"
        },
        {
          "description": "The formatter compatibility domain.",
          "type": "string",
          "const": "formatter"
        }
      ]
    },
    "OriginMetadata": {
      "description": "Origin source metadata for one suite.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The origin transport kind.",
          "$ref": "#/$defs/OriginKind"
        },
        "repo": {
          "description": "The origin repository URL.",
          "type": "string"
        },
        "ref": {
          "description": "The pinned origin ref.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "repo",
        "ref"
      ]
    },
    "OriginKind": {
      "description": "One origin kind.",
      "oneOf": [
        {
          "description": "A git backed origin.",
          "type": "string",
          "const": "git"
        }
      ]
    },
    "FetchMetadata": {
      "description": "One fetch manifest embedded in one suite file.",
      "type": "object",
      "properties": {
        "entries": {
          "description": "The fetch entries for one suite.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FetchEntry"
          },
          "default": []
        }
      }
    },
    "FetchEntry": {
      "description": "One fetch entry in one suite manifest.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The fetch entry kind.",
          "$ref": "#/$defs/FetchEntryKind"
        },
        "label": {
          "description": "The human-readable fetch label.",
          "type": "string",
          "default": ""
        },
        "version": {
          "description": "The fetched source version label.",
          "type": "string",
          "default": ""
        },
        "layout": {
          "description": "The fetch layout mode.",
          "type": "string",
          "default": ""
        },
        "root": {
          "description": "The cached source root for copied files.",
          "type": "string",
          "default": ""
        },
        "paths": {
          "description": "The sparse checkout paths for fetched sources.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "include": {
          "description": "The path patterns to keep after fetching one source entry.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "exclude": {
          "description": "The path patterns to drop after fetching one source entry.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "files": {
          "description": "The declared file mappings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FetchFileEntry"
          },
          "default": []
        }
      },
      "required": [
        "kind"
      ]
    },
    "FetchEntryKind": {
      "description": "One fetch entry kind.",
      "oneOf": [
        {
          "description": "One fetched source entry.",
          "type": "string",
          "const": "source"
        },
        {
          "description": "One translated local entry.",
          "type": "string",
          "const": "translated"
        },
        {
          "description": "One manual local entry.",
          "type": "string",
          "const": "manual"
        }
      ]
    },
    "FetchFileEntry": {
      "description": "One fetch file entry.",
      "type": "object",
      "properties": {
        "source": {
          "description": "The source-relative path for one fetched file.",
          "type": "string",
          "default": ""
        },
        "target": {
          "description": "The case-relative target path for one fetched file.",
          "type": "string",
          "default": ""
        },
        "path": {
          "description": "The case-relative local file path.",
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
