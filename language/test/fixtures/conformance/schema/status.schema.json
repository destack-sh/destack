{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusSet",
  "description": "One status file.",
  "type": "object",
  "properties": {
    "entries": {
      "description": "The status entries in declaration order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatusEntry"
      },
      "default": []
    }
  },
  "$defs": {
    "StatusEntry": {
      "description": "One case status entry.",
      "type": "object",
      "properties": {
        "patterns": {
          "description": "The case patterns or identifiers.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_file": {
          "description": "The source-relative file path.",
          "type": "string"
        },
        "source_kind": {
          "description": "The semantic source selector kind.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSelectorKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_key": {
          "description": "The semantic source selector key.",
          "type": "string"
        },
        "source_hash": {
          "description": "The canonical hash of the extracted source fragment.",
          "type": "string"
        },
        "source_ordinal": {
          "description": "The source-relative ordinal suffix.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "target_file": {
          "description": "The target-relative file path.",
          "type": "string"
        },
        "target_subcase": {
          "description": "The target-relative subcase label.",
          "type": "string"
        },
        "target_ordinal": {
          "description": "The target-relative ordinal suffix.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "status": {
          "description": "The case status.",
          "$ref": "#/$defs/CaseStatus"
        },
        "reason": {
          "description": "The reason for the status.",
          "type": "string"
        },
        "note": {
          "description": "One human note describing the status.",
          "type": "string"
        },
        "capabilities": {
          "description": "Optional capability filters.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConformanceCapability"
          }
        },
        "environments": {
          "description": "Optional environment filters.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConformanceEnvironment"
          }
        }
      },
      "required": [
        "status"
      ]
    },
    "SourceSelectorKind": {
      "description": "One semantic source selector kind.",
      "oneOf": [
        {
          "description": "The full source file is the logical test.",
          "type": "string",
          "const": "file"
        },
        {
          "description": "The logical test is keyed by one explicit title.",
          "type": "string",
          "const": "title"
        },
        {
          "description": "The logical test is keyed by one explicit message string.",
          "type": "string",
          "const": "message"
        },
        {
          "description": "The logical test is keyed by one statement-group anchor.",
          "type": "string",
          "const": "statement-group"
        },
        {
          "description": "The logical test is keyed by one loop or template item.",
          "type": "string",
          "const": "template-item"
        },
        {
          "description": "The logical test is keyed by one table row.",
          "type": "string",
          "const": "table-row"
        }
      ]
    },
    "CaseStatus": {
      "description": "One case status value.",
      "oneOf": [
        {
          "description": "The case is maintained as one direct sound translation.",
          "type": "string",
          "const": "translated"
        },
        {
          "description": "The case is intentionally excluded from Destack execution.",
          "type": "string",
          "const": "excluded"
        },
        {
          "description": "The case is maintained as one adapted Destack-native case.",
          "type": "string",
          "const": "adapted"
        },
        {
          "description": "The case is a known failure.",
          "type": "string",
          "const": "known-fail"
        },
        {
          "description": "The case is a known idempotence-only failure.",
          "type": "string",
          "const": "known-fail-idempotence"
        },
        {
          "description": "The case is intentionally ignored.",
          "type": "string",
          "const": "ignore"
        },
        {
          "description": "The case is blocked on environment availability.",
          "type": "string",
          "const": "env-blocked"
        },
        {
          "description": "The case is flaky.",
          "type": "string",
          "const": "flaky"
        },
        {
          "description": "The case is manually managed.",
          "type": "string",
          "const": "manual"
        }
      ]
    },
    "ConformanceCapability": {
      "description": "One conformance capability.",
      "oneOf": [
        {
          "description": "The parsing capability.",
          "type": "string",
          "const": "parse"
        },
        {
          "description": "The checking capability.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "The execution capability.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The formatting capability.",
          "type": "string",
          "const": "format"
        },
        {
          "description": "The emit capability.",
          "type": "string",
          "const": "emit"
        },
        {
          "description": "The query capability.",
          "type": "string",
          "const": "query"
        },
        {
          "description": "The LSP capability.",
          "type": "string",
          "const": "lsp"
        }
      ]
    },
    "ConformanceEnvironment": {
      "description": "One conformance environment.",
      "oneOf": [
        {
          "description": "A hostless environment.",
          "type": "string",
          "const": "hostless"
        },
        {
          "description": "A filesystem backed environment.",
          "type": "string",
          "const": "fs"
        },
        {
          "description": "A network backed environment.",
          "type": "string",
          "const": "network"
        },
        {
          "description": "A worker backed environment.",
          "type": "string",
          "const": "worker"
        },
        {
          "description": "A GPU backed environment.",
          "type": "string",
          "const": "gpu"
        },
        {
          "description": "An offline audio environment.",
          "type": "string",
          "const": "audio-offline"
        },
        {
          "description": "A serial device environment.",
          "type": "string",
          "const": "device-serial"
        },
        {
          "description": "A USB device environment.",
          "type": "string",
          "const": "device-usb"
        },
        {
          "description": "A bluetooth environment.",
          "type": "string",
          "const": "bluetooth"
        },
        {
          "description": "A manual or special environment.",
          "type": "string",
          "const": "manual"
        }
      ]
    }
  }
}
