declare module "*.txt" {
    let text: string
    export = text
}

declare module "*.toml" {
    let contents: any
    export = contents
}

declare module "*.yaml" {
    let contents: any
    export = contents
}

declare module "*.yml" {
    let contents: any
    export = contents
}

declare module "*.jsonc" {
    let contents: any
    export = contents
}

declare module "*/bun.lock" {
    let contents: import("bun").BunLockFile
    export = contents
}

declare module "*.html" {
    let contents: import("bun").HTMLBundle
    export = contents
}