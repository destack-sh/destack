declare namespace "*.txt" {
    let text: string
    export = text
}

declare namespace "*.toml" {
    let contents: any
    export = contents
}

declare namespace "*.yaml" {
    let contents: any
    export = contents
}

declare namespace "*.yml" {
    let contents: any
    export = contents
}

declare namespace "*.jsonc" {
    let contents: any
    export = contents
}

declare namespace "*/bun.lock" {
    let contents: import("bun").BunLockFile
    export = contents
}

declare namespace "*.html" {
    let contents: import("bun").HTMLBundle
    export = contents
}