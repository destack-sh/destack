const MyApp = {
    utils: {
        clamp(x, min, max) { return Math.min(max, Math.max(min, x)); },
        lerp(a, b, t) { return a + (b - a) * t; }
    },
    version: "1.0"
};

console.log(MyApp.utils.clamp(5, 0, 10));

export interface X {
    reason: 
        | "URL"
        | "DOM"
        | "AnimationFrame"
        | "Interval"
        | "Listener",
}

interface Client {
    /// Callback fired when the client connects to the Redis server
    onconnect: ((self: Client) => void) | null;
    /// Callback fired when the client disconnects from the Redis server
    onclose: ((this: Client, error: Error) => void) | null;
    /// Get TTL of hash fields in milliseconds (Redis 7.4+)
    hpttl: (
      key: RedisClient.KeyLike,
      fieldsKeyword: "FIELDS",
      numfields: number,
      ...fields: RedisClient.KeyLike[]
    ): Promise<number[]>;
}