set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

# selected crates
packages := "-p destack_artifact -p destack_artifact_macros -p destack_compiler -p destack_core -p destack_daemon -p destack_dir -p destack_program -p destack_fir -p destack_formatter -p destack_heap -p destack_js -p destack_json -p destack_language_cli -p destack_linter -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_memory -p destack_mir -p destack_parser -p destack_query -p destack_runtime -p destack_workspace -p destack_session -p destack_source -p destack_unicode -p destack_vm -p destack_repository"
packages-no-linter := "-p destack_artifact -p destack_artifact_macros -p destack_compiler -p destack_core -p destack_daemon -p destack_dir -p destack_program -p destack_fir -p destack_formatter -p destack_heap -p destack_js -p destack_json -p destack_language_cli -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_memory -p destack_mir -p destack_parser -p destack_query -p destack_runtime -p destack_workspace -p destack_session -p destack_source -p destack_unicode -p destack_vm -p destack_repository"

_default:
    @just --list --unsorted

# --- build ---

# lint
lint:
    cargo clippy --release {{ packages }} --no-deps

# test runtime privileged
test-runtime-privileged:
    bash scripts/test-runtime-privileged.sh

# install toolchain
install-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh install

# doctor toolchain
doctor-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh doctor

# ensure toolchain
ensure-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh ensure

# lint toolchain
lint-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh lint

# check runtime linux
check-runtime-linux:
    bash ../dev/toolchain/check-runtime-linux.sh

# check runtime linux x11
check-runtime-linux-x11:
    bash ../dev/toolchain/check-runtime-linux-x11.sh

# check runtime linux aarch64
check-runtime-linux-aarch64:
    bash ../dev/toolchain/check-runtime-linux-aarch64.sh

# check runtime windows gnu
check-runtime-windows-gnu:
    bash ../dev/toolchain/check-runtime-windows-gnu.sh

# check runtime linux wayland
check-runtime-linux-wayland:
    bash ../dev/toolchain/check-runtime-linux-wayland.sh

# check runtime macos rust
check-runtime-macos-rust:
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo check -p destack_runtime
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo clippy -p destack_runtime --all-targets -- -D warnings
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo test -p destack_runtime -- --nocapture

# check runtime macos
check-runtime-macos:
    just check-runtime-macos-rust

# check runtime windows msvc
check-runtime-windows-msvc:
    bash ../dev/toolchain/check-runtime-windows-msvc.sh

# build
build:
    cargo build --release {{ packages }}
    just generate-schema

# format
format:
    cargo fmt {{ packages }}

# check formatting
format-check:
    cargo fmt --check {{ packages }}

# format
alias fmt := format

# doc
doc:
    cargo doc --release {{ packages }} --no-deps

# clean
clean:
    cargo clean

# --- generate ---

# generate
generate:
    just generate-unicode
    just generate-schema

# generate unicode
generate-unicode:
    cd unicode && python3 src/generate.py

# generate schema
generate-schema:
    cargo run -p destack_repository --features schema --bin generate-schema --release > ../bridge/vscode/destack.schema.json
    @echo "generated ../bridge/vscode/destack.schema.json"

# --- test ---

# test unit
test-unit:
    cargo test --release --lib {{ packages-no-linter }}
    cargo test --release --lib -p destack_linter

# bless compiler
bless-compiler filter="":
    DESTACK_BLESS=1 cargo test -p destack_compiler {{filter}} -- --test-threads=1

# test
test:
    just test-unit
    just test-query
    just test-formatter
    just test-grammar

# check
check:
    just check-quick

# check quick
check-quick:
    just format-check
    just lint
    just test

# check full
check-full:
    just format-check
    just lint
    just test-all
    just test-grammar

# test all
test-all:
    cargo test --release --all-targets --no-fail-fast {{ packages-no-linter }}
    cargo test --release --all-targets --no-fail-fast -p destack_linter

# report heap overhead
report-heap-overhead:
    cargo run -p destack_heap --example overhead --quiet

# test linter
test-linter:
    cargo test --release --all-targets --no-fail-fast -p destack_linter

# test formatter
test-formatter:
    cargo test --release -p destack_formatter --test fixture

# test grammar destack
test-grammar-destack:
    bash grammar/scripts/test-grammar.sh destack

# test grammar mir
test-grammar-mir:
    bash grammar/scripts/test-grammar.sh mir

# test grammar bytecode
test-grammar-bytecode:
    bash grammar/scripts/test-grammar.sh bytecode

# test grammar
test-grammar:
    just test-grammar-destack
    just test-grammar-bytecode
    just test-grammar-mir

# test query
test-query:
    cargo test --release -p destack_query --test fixture

# --- bench ---

# bench
bench:
    just bench-parser
    just bench-lexer
    just bench-compiler

# bench compiler
bench-compiler:
    cargo bench -p destack_compiler -- destack_compile

# bench runtime footprint
bench-runtime-footprint:
    cargo bench -p destack_runtime --bench footprint

# bench compiler stats
bench-compiler-stats args="--help":
    cargo run -p destack_compiler --example bench_stats --features bench -- {{args}}

# bench linter stats
bench-linter-stats args="--help":
    cargo run -p destack_linter --example bench_stats -- {{args}}

# bench lexer
bench-lexer:
    cargo bench -p destack_parser --bench destack_lex

# bench parser
bench-parser:
    cargo bench -p destack_parser --bench destack_parse

# bench parser corpus
bench-parser-corpus corpus="library" trivia="documentation" stage="parse":
    DESTACK_PARSE_CORPUS={{corpus}} DESTACK_PARSE_TRIVIA={{trivia}} DESTACK_PARSE_STAGE={{stage}} cargo bench -p destack_parser --bench destack_parse

# --- fuzz ---

# fuzz
fuzz duration="60":
    just fuzz-lexer {{duration}}
    just fuzz-parser {{duration}}
    just fuzz-formatter {{duration}}

# fuzz lexer
fuzz-lexer duration="300":
    cd parser/fuzz && cargo +nightly fuzz run lexer -- -max_total_time={{duration}}

# fuzz parser
fuzz-parser duration="300":
    cd parser/fuzz && cargo +nightly fuzz run parser -- -max_total_time={{duration}}

# fuzz formatter
fuzz-formatter duration="300":
    cd formatter/fuzz && cargo +nightly fuzz run formatter -- -max_total_time={{duration}}

# fuzz list
fuzz-list:
    @echo "parser/fuzz:"
    @cd parser/fuzz && cargo +nightly fuzz list
    @echo "formatter/fuzz:"
    @cd formatter/fuzz && cargo +nightly fuzz list
