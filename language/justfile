set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

# all language crates
packages := "-p destack_artifact -p destack_artifact_macros -p destack_codegen_js -p destack_codegen_lib -p destack_codegen_native -p destack_compiler -p destack_core -p destack_css -p destack_dir -p destack_engine -p destack_fir -p destack_formatter -p destack_heap -p destack_html -p destack_js -p destack_json -p destack_linter -p destack_linter_macros -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_mir -p destack_native -p destack_parser -p destack_query -p destack_runtime -p destack_service -p destack_session -p destack_source -p destack_test -p destack_unicode -p destack_vm -p destack_workspace"
packages-no-linter := "-p destack_artifact -p destack_artifact_macros -p destack_codegen_js -p destack_codegen_lib -p destack_codegen_native -p destack_compiler -p destack_core -p destack_css -p destack_dir -p destack_engine -p destack_fir -p destack_formatter -p destack_heap -p destack_html -p destack_js -p destack_json -p destack_linter_macros -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_mir -p destack_native -p destack_parser -p destack_query -p destack_runtime -p destack_service -p destack_session -p destack_source -p destack_test -p destack_unicode -p destack_vm -p destack_workspace"

_default:
    @just --list --unsorted

# keep rust test concurrency on one repo wide knob when configured
_run-rust-test *args:
    #!/usr/bin/env bash
    set -euo pipefail

    test_threads="${DESTACK_TEST_THREADS:-${RUST_TEST_THREADS:-}}"

    if [ -n "${test_threads}" ]; then
        export RUST_TEST_THREADS="${test_threads}"
    fi

    # provide the runtime execution helper explicitly on macOS
    if [ "$(uname -s)" = "Darwin" ]; then
        export DESTACK_RUNTIME_EXECUTION_HELPER="$({
            CARGO_INCREMENTAL=0 cargo test -p destack_runtime --features execution --test runtime_execution --no-run --message-format=json             | python3 -c 'import json, sys; messages = (json.loads(line) for line in sys.stdin if line.lstrip().startswith("{")); executables = (message.get("executable") for message in messages if message.get("reason") == "compiler-artifact" and message.get("target", {}).get("name") == "runtime_execution" and message.get("executable")); executable = next(executables, None); print(executable) if executable else (_ for _ in ()).throw(SystemExit("failed to resolve runtime_execution helper executable"))'
        })"
    fi

    cargo test {{args}}

# keep custom harness worker pools on one repo wide knob when configured
_run-destack-test test_binary *args:
    cargo_bin="cargo"; if [ "${OS:-}" = "Windows_NT" ] && command -v cargo.exe >/dev/null 2>&1; then cargo_bin="cargo.exe"; fi; test_threads="${DESTACK_TEST_THREADS:-${RUST_TEST_THREADS:-}}"; test_jobs="${DESTACK_TEST_JOBS:-${DESTACK_TEST_THREADS:-}}"; if [ -n "${test_threads}" ]; then export RUST_TEST_THREADS="${test_threads}"; fi; command=( "${cargo_bin}" test --release -p destack_test --test "{{test_binary}}" ); if [ -n "${test_jobs}" ]; then command+=( -- -j "${test_jobs}" ); set -- {{args}}; if [ "$#" -gt 0 ]; then command+=( "$@" ); fi; else set -- {{args}}; if [ "$#" -gt 0 ]; then command+=( -- "$@" ); fi; fi; "${command[@]}"

# --- setup ---

# install language test fixtures
install:
    just install-conformance

# install conformance suites
install-conformance:
    just install-conformance-ecma
    just install-conformance-formatter

# install ecma conformance suites
install-conformance-ecma:
    python3 ./test/fixtures/conformance/fetch-suite.py \
        ./test/fixtures/conformance/ecma/test262 \
        ./test/fixtures/conformance/ecma/babel \
        ./test/fixtures/conformance/ecma/swc \
        ./test/fixtures/conformance/ecma/biome

# install formatter conformance sources
install-conformance-formatter:
    python3 ./test/fixtures/conformance/fetch-suite.py \
        ./test/fixtures/conformance/formatter/oxfmt

# --- build ---

# run language static checks
check:
    cargo clippy --release {{ packages }} --no-deps

# audit unsafe source usage
unsafe-audit *args:
    @python3 scripts/audit-unsafe.py {{args}}

# run privileged runtime platform tests for process, fs, and net
test-runtime-privileged:
    bash scripts/test-runtime-privileged.sh

# install runtime target toolchains and host prerequisites where possible
install-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh install

# inspect runtime target toolchain readiness on this host
doctor-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh doctor

# ensure runtime target toolchains are present, optionally auto install with DESTACK_AUTO_INSTALL_TOOLCHAINS=1
ensure-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh ensure

# lint runtime toolchain shell scripts
lint-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh lint

# check runtime on linux host
check-runtime-linux:
    bash ../dev/toolchain/check-runtime-linux.sh

# check runtime x11 backend against one headless x server on linux host
check-runtime-linux-x11:
    bash ../dev/toolchain/check-runtime-linux-x11.sh

# check runtime for linux aarch64 target using one configured cross toolchain
check-runtime-linux-aarch64:
    bash ../dev/toolchain/check-runtime-linux-aarch64.sh

# check runtime for windows gnu target using one configured mingw or zig cross toolchain
check-runtime-windows-gnu:
    bash ../dev/toolchain/check-runtime-windows-gnu.sh

# check runtime wayland backend against one real compositor on linux host
check-runtime-linux-wayland:
    bash ../dev/toolchain/check-runtime-linux-wayland.sh

# check runtime on macos host
check-runtime-macos-rust:
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo check -p destack_runtime
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo clippy -p destack_runtime --all-targets -- -D warnings
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 just _run-rust-test -p destack_runtime -- --nocapture

# check runtime on macos host
check-runtime-macos:
    just check-runtime-macos-rust

# check runtime on windows host
check-runtime-windows-msvc:
    bash ../dev/toolchain/check-runtime-windows-msvc.sh

# build language packages
