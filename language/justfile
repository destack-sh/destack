    ./test/fixtures/formatter/conformance/biome-fetch.sh
    ./test/fixtures/formatter/conformance/prettier-fetch.sh
    ./test/fixtures/formatter/conformance/oxfmt-fetch.sh

# install resolver fixture dependencies
install-resolver:
    #!/usr/bin/env bash
    set -euo pipefail
    FIXTURES_DIR="test/fixtures/resolver"
    # require vendored fixture sources
    required_fixture_sources=(
        "$FIXTURES_DIR/enhanced_resolve/test/fixtures/node_modules/m1/a.js"
        "$FIXTURES_DIR/enhanced_resolve/test/fixtures/multiple_modules/node_modules/m1/a.js"
        "$FIXTURES_DIR/bench-tsconfig-paths/README.md"
        "$FIXTURES_DIR/tsconfck/package.json"
    )

    for fixture_source_path in "${required_fixture_sources[@]}"; do
        if [ ! -f "$fixture_source_path" ]; then
            echo "missing vendored resolver fixture source: $fixture_source_path"
            echo "restore resolver fixtures from git before running install-resolver"
            exit 1
        fi
    done

    # install pnpm fixture dependencies
    for dir in "$FIXTURES_DIR/pnpm" "$FIXTURES_DIR/pnpm-workspace"; do
        if [ -f "$dir/package.json" ]; then
            (cd "$dir" && pnpm install --ignore-workspace)
        fi
    done

    # install yarn fixture dependencies
    for dir in "$FIXTURES_DIR/yarn" "$FIXTURES_DIR/global-pnp" "$FIXTURES_DIR/pnp"; do
        if [ -f "$dir/package.json" ]; then
            (cd "$dir" && yarn install)
        fi
    done

# fetch ecosystem packages
ecosystem-fetch:
