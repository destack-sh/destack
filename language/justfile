set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]

# selected crates
packages := "-p destack_artifact -p destack_artifact_macros -p destack_codegen_js -p destack_codegen_lib -p destack_codegen_native -p destack_compiler -p destack_core -p destack_css -p destack_dir -p destack_engine -p destack_fir -p destack_formatter -p destack_heap -p destack_html -p destack_js -p destack_json -p destack_linter -p destack_linter_macros -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_memory -p destack_mir -p destack_native -p destack_parser -p destack_qir -p destack_query -p destack_runtime -p destack_service -p destack_session -p destack_source -p destack_test -p destack_unicode -p destack_vm -p destack_workspace"
packages-no-linter := "-p destack_artifact -p destack_artifact_macros -p destack_codegen_js -p destack_codegen_lib -p destack_codegen_native -p destack_compiler -p destack_core -p destack_css -p destack_dir -p destack_engine -p destack_fir -p destack_formatter -p destack_heap -p destack_html -p destack_js -p destack_json -p destack_linter_macros -p destack_lsp -p destack_lsp_server -p destack_lsp_types -p destack_memory -p destack_mir -p destack_native -p destack_parser -p destack_qir -p destack_query -p destack_runtime -p destack_service -p destack_session -p destack_source -p destack_test -p destack_unicode -p destack_vm -p destack_workspace"

_default:
    @just --list --unsorted

# --- build ---

# run static checks
lint:
    cargo clippy --release {{ packages }} --no-deps

# run privileged runtime platform tests for process, fs, and net
test-runtime-privileged:
    bash scripts/test-runtime-privileged.sh

# install runtime target toolchains and host prerequisites where possible
install-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh install

# inspect runtime target toolchain readiness on this host
doctor-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh doctor

# ensure runtime target toolchains are present, optionally auto install with DESTACK_AUTO_INSTALL_TOOLCHAINS=1
ensure-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh ensure

# lint runtime toolchain shell scripts
lint-toolchain:
    bash ../dev/toolchain/runtime-toolchain.sh lint

# check runtime on linux host
check-runtime-linux:
    bash ../dev/toolchain/check-runtime-linux.sh

# check runtime x11 backend against one headless x server on linux host
check-runtime-linux-x11:
    bash ../dev/toolchain/check-runtime-linux-x11.sh

# check runtime for linux aarch64 target using one configured cross toolchain
check-runtime-linux-aarch64:
    bash ../dev/toolchain/check-runtime-linux-aarch64.sh

# check runtime for windows gnu target using one configured mingw or zig cross toolchain
check-runtime-windows-gnu:
    bash ../dev/toolchain/check-runtime-windows-gnu.sh

# check runtime wayland backend against one real compositor on linux host
check-runtime-linux-wayland:
    bash ../dev/toolchain/check-runtime-linux-wayland.sh

# check runtime on macos host
check-runtime-macos-rust:
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo check -p destack_runtime
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo clippy -p destack_runtime --all-targets -- -D warnings
    LC_ALL=C LANG=C LC_CTYPE=C CARGO_INCREMENTAL=0 cargo test -p destack_runtime -- --nocapture

# check runtime on macos host
check-runtime-macos:
    just check-runtime-macos-rust

# check runtime on windows host
check-runtime-windows-msvc:
    bash ../dev/toolchain/check-runtime-windows-msvc.sh

# build packages
build:
    cargo build --release {{ packages }}
    just generate-schema

# format code
format:
    cargo fmt {{ packages }}

# check formatting
format-check:
    cargo fmt --check {{ packages }}

# alias for format
alias fmt := format

# build docs
doc:
    cargo doc --release {{ packages }} --no-deps

# clean build artifacts
clean:
    cargo clean

# --- generate ---

# regenerate all generated code
generate:
    just generate-unicode
    just generate-schema
    just generate-conformance-schema
    just generate-stress

# regenerate unicode tables
generate-unicode:
    cd unicode && python3 src/generate.py

# generate JSON schema
generate-schema:
    mkdir -p workspace/generated
    cargo run -p destack_workspace --features schema --bin generate-schema --release > workspace/generated/destack.schema.json
    cp workspace/generated/destack.schema.json ../bridge/vscode/destack.schema.json
    @echo "generated workspace/generated/destack.schema.json"

# generate conformance fixture JSON schema
generate-conformance-schema:
    cargo run -p destack_test --bin update_conformance_schema
    @echo "generated language/test/fixtures/conformance/schema/*.json"

# generate parser and formatter stress fixtures
generate-stress:
    cargo test --release -p destack_test --test stress -- --generate

# --- test ---

# run crate unit tests
test-unit:
    cargo test --release --lib {{ packages-no-linter }}
    cargo test --release --lib -p destack_linter

# run tests
test:
    just test-unit
    just test-emit
    just test-specification
    just test-query
    just test-lsp
    just test-formatter
    just test-grammar
    just test-conformance

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint
    just test

# check with slow suites
check-full:
    just check-quick
    just test-stress

# run all crate tests
test-all:
    cargo test --release --all-targets --no-fail-fast {{ packages-no-linter }}
    cargo test --release --all-targets --no-fail-fast -p destack_linter

# run linter tests
test-linter:
    cargo test --release --all-targets --no-fail-fast -p destack_linter

# run emit tests
test-emit:
    cargo test --release -p destack_test --test emit

# refresh emit snapshots from actual outputs
test-emit-update:
    cargo test --release -p destack_test --test emit -- --update-snapshots

# run all conformance tests
test-conformance:
    just test-conformance-ecma
    just test-conformance-formatter

# run ecma conformance tests
test-conformance-ecma:
    cargo test --release -p destack_test --test conformance-ecma

# update ecma conformance baselines
test-conformance-ecma-update:
    cargo test --release -p destack_test --test conformance-ecma -- --update-known-failures

# run formatter tests
test-formatter:
    cargo test --release -p destack_test --test formatter

# run formatter conformance tests
test-conformance-formatter:
    cargo test --release -p destack_test --test conformance-formatter

# update formatter conformance known failures
test-conformance-formatter-update:
    cargo test --release -p destack_test --test conformance-formatter -- --update-known-failures

# regenerate shared conformance catalog sections
update-conformance-catalog:
    cargo run -p destack_test --bin update_conformance_catalog

# run specification tests (type checking specification)
test-specification:
    cargo test --release -p destack_test --test specification

# validate tree sitter overlay coverage
test-grammar-overlay:
    bun grammar/scripts/check-overlay.mjs

# validate corpus language routing
test-grammar-corpus-routing:
    bun grammar/scripts/check-corpus-routing.mjs

# run Destack tree sitter corpus tests
test-grammar-destack:
    bash grammar/scripts/test-tree-sitter-destack.sh destack

# run MIR tree sitter corpus tests
test-grammar-mir:
    cd grammar/mir && bunx tree-sitter-cli@0.24.4 test --rebuild

# validate destack-only tree sitter node coverage in corpus
test-grammar-destack-node-coverage:
    bun grammar/scripts/check-destack-node-coverage.mjs

# validate shared grammar fixture structure and parse smoke
test-grammar-fixtures:
    bun grammar/scripts/check-grammar-fixtures.mjs

# validate design and specification code fences parse and tokenize
test-grammar-fences:
    cd grammar/destack && npm run report:specification -- --fail

# run the grammar validation stack
test-grammar:
    just test-grammar-corpus-routing
    just test-grammar-destack
    just test-grammar-mir
    just test-grammar-destack-node-coverage
    just test-grammar-fixtures
    just test-grammar-overlay
    just test-grammar-fences

# profile tree sitter grammar state deltas
profile-grammar-delta args="--target destack --baseline tsx --top 30":
    bun grammar/scripts/profile-grammar-delta.mjs {{args}}

# run query tests
test-query:
    cargo test --release -p destack_test --test query

# run applied lsp tests
test-lsp:
    cargo test --release -p destack_test --test lsp

# run all stress tests
test-stress:
    cargo test --release -p destack_test --test stress

# run parser stress tests
test-stress-parser:
    cargo test --release -p destack_test --test stress -- --parser

# run formatter stress tests
test-stress-formatter:
    cargo test --release -p destack_test --test stress -- --formatter

# --- bench ---

# run the bench suite
bench:
    just bench-parser
    just bench-lexer
    just bench-compiler

# run compiler benches
bench-compiler:
    cargo bench -p destack_compiler -- destack_compile

# run compiler bench stats
bench-compiler-stats args="--help":
    cargo run -p destack_compiler --example bench_stats --features bench -- {{args}}

# run linter bench stats
bench-linter-stats args="--help":
    cargo run -p destack_linter --example bench_stats -- {{args}}

# run lexer benches
bench-lexer:
    cargo bench -p destack_parser --bench destack_lex

# run parser benches
bench-parser:
    cargo bench -p destack_parser --bench destack_parse

# run parser benches for one or more named corpora
bench-parser-corpus corpus="library" trivia="documentation" stage="parse":
    DESTACK_PARSE_CORPUS={{corpus}} DESTACK_PARSE_TRIVIA={{trivia}} DESTACK_PARSE_STAGE={{stage}} cargo bench -p destack_parser --bench destack_parse

# --- fuzz ---

# run all fuzzers
fuzz duration="60":
    just fuzz-lexer {{duration}}
    just fuzz-parser {{duration}}
    just fuzz-formatter {{duration}}

# run lexer fuzzer
fuzz-lexer duration="300":
    cd parser/fuzz && cargo +nightly fuzz run lexer -- -max_total_time={{duration}}

# run parser fuzzer
fuzz-parser duration="300":
    cd parser/fuzz && cargo +nightly fuzz run parser -- -max_total_time={{duration}}

# run formatter fuzzer
fuzz-formatter duration="300":
    cd formatter/fuzz && cargo +nightly fuzz run formatter -- -max_total_time={{duration}}

# list fuzz targets
fuzz-list:
    @echo "parser/fuzz:"
    @cd parser/fuzz && cargo +nightly fuzz list
    @echo "formatter/fuzz:"
    @cd formatter/fuzz && cargo +nightly fuzz list
