packages-no-linter := "-p destack_ast -p destack_codegen_js -p destack_compiler -p destack_dir -p destack_fir -p destack_formatter -p destack_vm -p destack_mir -p destack_parser -p destack_resolver -p destack_source -p destack_test -p destack_unicode -p destack_workspace"
linter-test-threads := "2"

_default:
    @just --list --unsorted

# --- setup ---

