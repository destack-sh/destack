# check all generated files for drift, including conformance and stress fixtures
generate-check-full:
    bash scripts/check-generated.sh full

# regenerate unicode tables
generate-unicode:
    cd unicode && python3 src/generate.py

# regenerate lexer tables
generate-lexer:
    cd parser/src/lex && python3 generate.py

# generate JSON schema
generate-schema:
    mkdir -p workspace/generated
    cargo run -p destack_workspace --features schema --bin generate-schema --release > workspace/generated/destack.schema.json
    cp workspace/generated/destack.schema.json ../bridge/vscode/destack.schema.json
    @echo "generated workspace/generated/destack.schema.json"

# generate conformance fixture JSON schema
generate-conformance-schema:
    cargo run -p destack_test --bin update_conformance_schema
    @echo "generated language/test/fixtures/conformance/schema/*.json"

# generate runtime binding catalog
generate-bindings *args:
    bash scripts/generate-bindings.sh {{args}}

