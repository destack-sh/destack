set shell := ["bash", "-cu"]

# all language crates
packages := "-p destack_ast -p destack_codegen_js -p destack_compiler -p destack_dir -p destack_fir -p destack_formatter -p destack_linter -p destack_machine -p destack_mir -p destack_parser -p destack_resolver -p destack_source -p destack_test -p destack_unicode -p destack_workspace"

_default:
    @just --list --unsorted

# --- setup ---

# install test fixtures (conformance suites, ecosystem packages, resolver fixtures)
install:
    ./test/fixtures/conformance/test262-fetch.sh
    ./test/fixtures/conformance/babel-fetch.sh
    ./test/fixtures/conformance/swc-fetch.sh
    ./test/fixtures/conformance/biome-fetch.sh
    ./test/fixtures/ecosystem/ecosystem-fetch.sh
    just install-resolver

# install resolver fixture dependencies
install-resolver:
    #!/usr/bin/env bash
    set -euo pipefail
    FIXTURES_DIR="test/fixtures/resolver"
    for dir in "$FIXTURES_DIR/pnpm" "$FIXTURES_DIR/pnpm-workspace"; do
        if [ -f "$dir/package.json" ]; then
            (cd "$dir" && pnpm install --ignore-workspace)
        fi
    done

# --- build ---

# check (clippy)
check:
    cargo clippy --release {{ packages }}

# build
build:
    cargo build --release {{ packages }}
    just generate-schema

# format code
format:
    cargo fmt {{ packages }}

# alias for format
fmt := "format"

# generate docs
doc:
    cargo doc --release {{ packages }} --no-deps

# clean
clean:
    cargo clean

# --- codegen ---

# regenerate all generated code
generate:
    just generate-unicode
    just generate-lexer
    just generate-schema

# regenerate unicode tables
generate-unicode:
    cd unicode && python3 src/generate.py

# regenerate lexer tables
generate-lexer:
    cd parser/src/lex && python3 generate.py

# generate JSON schema
generate-schema:
    mkdir -p workspace/generated
    cargo run -p destack_workspace --features schema --bin generate-schema --release > workspace/generated/dsconfig.schema.json
    cp workspace/generated/dsconfig.schema.json ../platform/vscode/dsconfig.schema.json
    @echo "generated workspace/generated/dsconfig.schema.json"

# --- test ---

# run all tests
test:
    cargo test --release --all-targets --no-fail-fast {{ packages }}

# run smoke tests
test-smoke:
    cargo test --release --test smoke

# run codegen tests
test-codegen:
    cargo test --release --test codegen

# run mdtest (markdown-driven type tests)
test-mdtest:
    cargo test --release --test mdtest

# run conformance tests
test-conformance:
    cargo test --release --test conformance

# update conformance test baselines
test-conformance-update:
    cargo test --release --test conformance -- --update-known-failures

# run formatter tests
test-formatter:
    cargo test --release --test formatter

# run ecosystem tests
test-ecosystem:
    cargo test --release --test ecosystem

# run resolver tests
test-resolver:
    cargo test --release -p destack_resolver

# --- bench ---

# run all benchmarks
bench:
    cargo bench -p destack_parser

# run lexer benchmarks
bench-lexer:
    cargo bench -p destack_parser -- destack_lex

# run parser benchmarks
bench-parser:
    cargo bench -p destack_parser -- destack_ast

# --- fuzz ---

# run all fuzzers
fuzz duration="60":
    just fuzz-lexer {{duration}}
    just fuzz-parser {{duration}}
    just fuzz-formatter {{duration}}

# run lexer fuzzer
fuzz-lexer duration="300":
    cd parser/fuzz && cargo +nightly fuzz run lexer -- -max_total_time={{duration}}

# run parser fuzzer
fuzz-parser duration="300":
    cd parser/fuzz && cargo +nightly fuzz run parser -- -max_total_time={{duration}}

# run formatter fuzzer
fuzz-formatter duration="300":
    cd formatter/fuzz && cargo +nightly fuzz run formatter -- -max_total_time={{duration}}

# list fuzz targets
fuzz-list:
    @echo "parser/fuzz:"
    @cd parser/fuzz && cargo +nightly fuzz list
    @echo "formatter/fuzz:"
    @cd formatter/fuzz && cargo +nightly fuzz list
