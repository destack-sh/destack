# --- build ---

# check (clippy)
check:
    cargo clippy --release {{ packages }}

# lint (alias for check)
lint:
    just check

# check runtime against windows gnu cross target
check-runtime-windows-cross:
    LC_ALL=C LANG=C CARGO_INCREMENTAL=0 cargo check -p destack_runtime --target x86_64-pc-windows-gnu

# run runtime smoke binary on the active host target
run-runtime-smoke-host:
    CARGO_INCREMENTAL=0 cargo run -p destack_runtime --bin runtime-smoke --quiet

# run runtime smoke binary on windows gnu target through wine
run-runtime-smoke-windows-gnu:
    CARGO_INCREMENTAL=0 cargo build -p destack_runtime --target x86_64-pc-windows-gnu --bin runtime-smoke
    EXE="../target/x86_64-pc-windows-gnu/debug/runtime-smoke.exe"; \
    if [ ! -f "$EXE" ]; then \
      EXE="target/x86_64-pc-windows-gnu/debug/runtime-smoke.exe"; \
    fi; \
    if [ ! -f "$EXE" ]; then \
      echo "missing windows gnu runtime smoke executable"; \
      exit 1; \
    fi; \
    WINEDEBUG="${WINEDEBUG:--all}" wine "$EXE"

# check runtime on windows gnu target with compile, clippy, and executable tests
check-runtime-windows-gnu:
    ../scripts/toolchain/check-runtime-windows-gnu.sh

# build and run one crate's tests for windows target through wine
test-windows-crate crate:
    #!/usr/bin/env bash
    set -euo pipefail

    crate="{{crate}}"
    crate_pattern="${crate//-/_}"

    CARGO_INCREMENTAL=0 CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc \
      cargo test -p "$crate" --target x86_64-pc-windows-gnu --no-run
    # locate newest windows test binary from cargo output layout
    EXE=$(ls -t ../target/x86_64-pc-windows-gnu/debug/deps/${crate_pattern}-*.exe 2>/dev/null | head -n1); \
    if [ -z "$EXE" ]; then \
      EXE=$(ls -t target/x86_64-pc-windows-gnu/debug/deps/${crate_pattern}-*.exe 2>/dev/null | head -n1); \
    fi; \
    if [ -z "$EXE" ]; then \
      echo "missing windows test executable for crate: $crate"; \
      exit 1; \
    fi; \
    WINEDEBUG="${WINEDEBUG:--all}" wine "$EXE"

# build and run runtime tests for windows target through wine
test-runtime-windows-cross:
