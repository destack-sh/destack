# --- codegen ---

# regenerate all generated code
generate:
    just generate-unicode
    just generate-lexer
    just generate-schema

# regenerate unicode tables
generate-unicode:
    cd unicode && python3 src/generate.py

# regenerate lexer tables
generate-lexer:
    cd parser/src/lex && python3 generate.py

# generate JSON schema
generate-schema:
    mkdir -p workspace/generated
    cargo run -p destack_workspace --features schema --bin generate-schema --release > workspace/generated/dsconfig.schema.json
    cp workspace/generated/dsconfig.schema.json ../platform/vscode/dsconfig.schema.json
    @echo "generated workspace/generated/dsconfig.schema.json"

# generate runtime binding catalog
generate-bindings *args:
    #!/usr/bin/env bash
    set -euo pipefail

    runtime_args=()
    refresh_stubs="true"

    set -- {{args}}
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --domains)
                if [ "$#" -lt 2 ]; then
                    echo "missing value for --domains"
                    exit 1
                fi
                runtime_args+=("--domains" "$2")
                shift
                ;;
            --domains=*)
                runtime_args+=("$1")
                ;;
            --domain)
                if [ "$#" -lt 2 ]; then
                    echo "missing value for --domain"
                    exit 1
                fi
                runtime_args+=("--domain" "$2")
                shift
                ;;
            --domain=*)
                runtime_args+=("$1")
                ;;
            --refresh-stubs)
                refresh_stubs="true"
                ;;
            --no-refresh-stubs)
                refresh_stubs="false"
                ;;
            *)
                echo "unsupported generate-bindings option: $1"
                echo "supported: --domain, --domains, --refresh-stubs, --no-refresh-stubs"
                exit 1
                ;;
        esac
        shift
    done

    if [ "$refresh_stubs" = "true" ]; then
        runtime_args+=("--refresh-stubs")
    fi

    if [ "${#runtime_args[@]}" -gt 0 ]; then
        cargo run -p destack_runtime --features generate_bindings --bin generate-bindings --release -- "${runtime_args[@]}"
    else
        cargo run -p destack_runtime --features generate_bindings --bin generate-bindings --release
    fi
    cargo fmt -p destack_runtime
    echo "generated runtime binding catalog"

# compatibility wrapper for domain-scoped generation
generate-bindings-domains domains:
    just generate-bindings --domains "{{domains}}"

