set shell := ["bash", "-cu"]

# all language crates
packages := "-p destack_ast -p destack_codegen_js -p destack_compiler -p destack_dir -p destack_fir -p destack_formatter -p destack_linter -p destack_vm -p destack_mir -p destack_parser -p destack_resolver -p destack_source -p destack_test -p destack_unicode -p destack_workspace"
packages-no-linter := "-p destack_ast -p destack_codegen_js -p destack_compiler -p destack_dir -p destack_fir -p destack_formatter -p destack_vm -p destack_mir -p destack_parser -p destack_resolver -p destack_source -p destack_test -p destack_unicode -p destack_workspace"
linter-test-threads := "2"

_default:
    @just --list --unsorted

# --- setup ---

# install test fixtures (conformance suites, ecosystem packages, resolver fixtures)
install:
    ./test/fixtures/conformance/test262-fetch.sh
    ./test/fixtures/conformance/babel-fetch.sh
    ./test/fixtures/conformance/swc-fetch.sh
    ./test/fixtures/conformance/biome-fetch.sh
    just install-formatter-conformance
    ./test/fixtures/ecosystem/ecosystem-fetch.sh
    just install-resolver

# alias for install
install-fixtures := "install"

# install formatter conformance sources
install-formatter-conformance:
    ./test/fixtures/formatter/conformance/biome-fetch.sh
    ./test/fixtures/formatter/conformance/prettier-fetch.sh
    ./test/fixtures/formatter/conformance/oxfmt-fetch.sh

# install resolver fixture dependencies
install-resolver:
    #!/usr/bin/env bash
    set -euo pipefail
    FIXTURES_DIR="test/fixtures/resolver"
    for dir in "$FIXTURES_DIR/pnpm" "$FIXTURES_DIR/pnpm-workspace"; do
        if [ -f "$dir/package.json" ]; then
            (cd "$dir" && pnpm install --ignore-workspace)
        fi
    done

# fetch ecosystem packages
ecosystem-fetch:
    ./test/fixtures/ecosystem/ecosystem-fetch.sh

# --- build ---

# check (clippy)
check:
    cargo clippy --release {{ packages }}

# build
build:
    cargo build --release {{ packages }}
    just generate-schema

# format code
format:
    cargo fmt {{ packages }}

# alias for format
alias fmt := format

# generate docs
doc:
    cargo doc --release {{ packages }} --no-deps

# clean
clean:
    cargo clean

# --- codegen ---

# regenerate all generated code
generate:
    just generate-unicode
    just generate-lexer
    just generate-schema

# regenerate unicode tables
generate-unicode:
    cd unicode && python3 src/generate.py

# regenerate lexer tables
generate-lexer:
    cd parser/src/lex && python3 generate.py

# generate JSON schema
generate-schema:
    mkdir -p workspace/generated
    cargo run -p destack_workspace --features schema --bin generate-schema --release > workspace/generated/dsconfig.schema.json
    cp workspace/generated/dsconfig.schema.json ../platform/vscode/dsconfig.schema.json
    @echo "generated workspace/generated/dsconfig.schema.json"

# generate runtime binding catalog
generate-bindings:
    cargo run -p destack_runtime --features generate_bindings --bin generate-bindings --release
    cargo fmt -p destack_runtime
    @echo "generated runtime binding catalog"

# --- builtin libs ---

# typescript lib version is pinned in builtin/fetch.py
fetch-builtin-libs-version:
    python3 ./builtin/fetch.py --print-versions

# fetch typescript libs into builtin/lib
fetch-builtin-libs:
    python3 ./builtin/fetch.py

# generate builtin lib registry
generate-builtin-libs:
    python3 ./builtin/generate.py
    cargo fmt -p destack_builtin

# --- test ---

# run all tests
test:
    cargo test --release --all-targets --no-fail-fast {{ packages-no-linter }}
    cargo test --release --all-targets --no-fail-fast -p destack_linter -- --test-threads={{ linter-test-threads }}

# run linter tests with capped rust test threads
test-linter:
    cargo test --release --all-targets --no-fail-fast -p destack_linter -- --test-threads={{ linter-test-threads }}

# run smoke tests
test-smoke:
    cargo test --release --test smoke

# run codegen tests
test-codegen:
    cargo test --release --test codegen

# run mdtest suites (specification + query)
test-mdtest:
    just test-specification
    just test-query

# run conformance tests
test-conformance:
    cargo test --release --test conformance

# update conformance test baselines
test-conformance-update:
    cargo test --release --test conformance -- --update-known-failures

# run formatter tests
test-formatter:
    cargo test --release --test formatter

# run formatter conformance tests
test-formatter-conformance:
    cargo test --release --test formatter-conformance

# update formatter conformance known failures
test-formatter-conformance-update:
    cargo test --release --test formatter-conformance -- --update-known-failures

# snapshot formatter output for a corpus
formatter-corpus-snapshot root="test/fixtures/formatter/conformance/staging/oxfmt" out="/tmp/destack-formatter-corpus-snapshot":
    ./formatter/scripts/corpus_snapshot.sh "{{root}}" "{{out}}"

# benchmark formatter parse and print throughput on a corpus
formatter-corpus-bench root="test/fixtures/ecosystem" runs="5":
    ./formatter/scripts/corpus_bench.sh "{{root}}" "{{runs}}"

# run formatter bench stats
bench-formatter-stats args="--help":
    cargo run --release -p destack_formatter --example bench_stats -- {{args}}

# diff two formatter corpus snapshots
formatter-corpus-diff baseline candidate:
    ./formatter/scripts/corpus_diff.sh "{{baseline}}" "{{candidate}}"

# run ecosystem tests
test-ecosystem:
    cargo test --release --test ecosystem

# run resolver tests
test-resolver:
    cargo test --release -p destack_resolver

# run specification tests (type checking specification)
test-specification:
    cargo test --release --test specification

# validate tree sitter overlay coverage
test-grammar-overlay:
    node grammar/scripts/check-overlay.mjs

# validate corpus language routing
test-grammar-corpus-routing:
    node grammar/scripts/check-corpus-routing.mjs

# run TypeScript and TSX tree sitter corpus tests
test-grammar-typescript-tsx:
    cd grammar/destack && npx tree-sitter test --rebuild

# run Destack tree sitter corpus tests
test-grammar-destack:
    cd grammar/destack/destack && npx tree-sitter test --rebuild

# validate destack-only tree sitter node coverage in corpus
test-grammar-destack-node-coverage:
    node grammar/scripts/check-destack-node-coverage.mjs

# run all tree sitter grammar tests
test-grammar-all:
    just test-grammar-corpus-routing
    just test-grammar-typescript-tsx
    just test-grammar-destack
    just test-grammar-destack-node-coverage
    just test-grammar-specification-sweep-positive
    just test-grammar-overlay

# sweep specification markdown fixtures through tree sitter parsers
test-grammar-specification-sweep args="":
    node grammar/scripts/specification-parser-sweep.mjs {{args}}

# fail when specification positive cases produce parser errors
test-grammar-specification-sweep-positive:
    node grammar/scripts/specification-parser-sweep.mjs --fail-on-positive

# profile tree sitter grammar state deltas
profile-grammar-delta args="--target destack --baseline tsx --top 30":
    node grammar/scripts/profile-grammar-delta.mjs {{args}}

# run query tests (IDE/LSP queries)
test-query:
    cargo test --release --test query

# run stress tests (requires generated fixtures)
test-stress:
    cargo test --release --test stress

# --- stress fixtures ---

# generate all stress test fixtures
generate-stress:
    ./test/fixtures/stress/generate.sh all

# generate parser stress fixtures
generate-stress-parser:
    ./test/fixtures/stress/generate.sh parser

# generate resolver stress fixtures
generate-stress-resolver:
    ./test/fixtures/stress/generate.sh resolver

# generate checker stress fixtures
generate-stress-checker:
    ./test/fixtures/stress/generate.sh checker

# --- bench ---

# run parser benchmarks
bench:
    cargo bench -p destack_parser

# run compiler benchmarks
bench-compiler:
    cargo bench -p destack_compiler -- destack_compile

# run compiler bench stats
bench-compiler-stats args="--help":
    cargo run -p destack_compiler --example bench_stats --features bench -- {{args}}

# run linter bench stats
bench-linter-stats args="--help":
    cargo run -p destack_linter --example bench_stats -- {{args}}

# run lexer benchmarks
bench-lexer:
    cargo bench -p destack_parser -- destack_lex

# run parser benchmarks
bench-parser:
    cargo bench -p destack_parser -- destack_ast

# --- fuzz ---

# run all fuzzers
fuzz duration="60":
    just fuzz-lexer {{duration}}
    just fuzz-parser {{duration}}
    just fuzz-formatter {{duration}}

# run lexer fuzzer
fuzz-lexer duration="300":
    cd parser/fuzz && cargo +nightly fuzz run lexer -- -max_total_time={{duration}}

# run parser fuzzer
fuzz-parser duration="300":
    cd parser/fuzz && cargo +nightly fuzz run parser -- -max_total_time={{duration}}

# run formatter fuzzer
fuzz-formatter duration="300":
    cd formatter/fuzz && cargo +nightly fuzz run formatter -- -max_total_time={{duration}}

# list fuzz targets
fuzz-list:
    @echo "parser/fuzz:"
    @cd parser/fuzz && cargo +nightly fuzz list
    @echo "formatter/fuzz:"
    @cd formatter/fuzz && cargo +nightly fuzz list
