set shell := ["bash", "-cu"]

_default:
    @just --list --unsorted

# install workspace js deps
install:
    pnpm install

# install fixture-local deps with their own .pnpm trees
install-fixtures:
    #!/usr/bin/env bash
    set -euo pipefail
    FIXTURES_DIR="../test/fixtures/resolver"
    for dir in "$FIXTURES_DIR/pnpm" "$FIXTURES_DIR/pnpm-workspace"; do
        if [ -f "$dir/package.json" ]; then
            (cd "$dir" && pnpm install --ignore-workspace)
        fi
    done

# run resolver tests
test:
    cargo test --release -p destack_resolver

