{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mir",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "block_comment"
        },
        {
          "type": "SYMBOL",
          "name": "declaration_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "function_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "terminator_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "type_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "memory_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "arrow"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "ssa_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "block_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "local_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "function_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "boolean_literal"
        },
        {
          "type": "SYMBOL",
          "name": "number_literal"
        },
        {
          "type": "SYMBOL",
          "name": "character_literal"
        },
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "unknown"
        }
      ]
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    },
    "function_keyword": {
      "type": "STRING",
      "value": "function"
    },
    "declaration_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "external"
            },
            {
              "type": "STRING",
              "value": "export"
            },
            {
              "type": "STRING",
              "value": "global"
            },
            {
              "type": "STRING",
              "value": "type"
            },
            {
              "type": "STRING",
              "value": "block"
            },
            {
              "type": "STRING",
              "value": "local"
            }
          ]
        }
      }
    },
    "terminator_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "return"
            },
            {
              "type": "STRING",
              "value": "jump"
            },
            {
              "type": "STRING",
              "value": "branch"
            },
            {
              "type": "STRING",
              "value": "switch"
            },
            {
              "type": "STRING",
              "value": "yield"
            },
            {
              "type": "STRING",
              "value": "check"
            },
            {
              "type": "STRING",
              "value": "panic"
            },
            {
              "type": "STRING",
              "value": "panic.resume"
            },
            {
              "type": "STRING",
              "value": "trap.abort"
            },
            {
              "type": "STRING",
              "value": "unreachable"
            },
            {
              "type": "STRING",
              "value": "call"
            },
            {
              "type": "STRING",
              "value": "tailCall"
            },
            {
              "type": "STRING",
              "value": "call.indirect"
            },
            {
              "type": "STRING",
              "value": "tailCall.indirect"
            },
            {
              "type": "STRING",
              "value": "call.class"
            },
            {
              "type": "STRING",
              "value": "tailCall.class"
            },
            {
              "type": "STRING",
              "value": "call.interface"
            },
            {
              "type": "STRING",
              "value": "tailCall.interface"
            }
          ]
        }
      }
    },
    "type_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "void"
            },
            {
              "type": "STRING",
              "value": "boolean"
            },
            {
              "type": "STRING",
              "value": "ref"
            },
            {
              "type": "STRING",
              "value": "vector"
            },
            {
              "type": "STRING",
              "value": "tensor"
            },
            {
              "type": "STRING",
              "value": "tensorView"
            },
            {
              "type": "STRING",
              "value": "space"
            },
            {
              "type": "STRING",
              "value": "struct"
            },
            {
              "type": "STRING",
              "value": "newtype"
            },
            {
              "type": "STRING",
              "value": "atomic"
            },
            {
              "type": "STRING",
              "value": "variant"
            },
            {
              "type": "STRING",
              "value": "slice"
            },
            {
              "type": "STRING",
              "value": "any"
            },
            {
              "type": "STRING",
              "value": "isize"
            },
            {
              "type": "STRING",
              "value": "usize"
            },
            {
              "type": "STRING",
              "value": "typeDescriptor"
            },
            {
              "type": "STRING",
              "value": "typeId"
            },
            {
              "type": "PATTERN",
              "value": "(?:int|uint)(?:8|16|32|64|128|256)"
            },
            {
              "type": "PATTERN",
              "value": "float(?:32|64)"
            }
          ]
        }
      }
    },
    "memory_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "managed"
            },
            {
              "type": "STRING",
              "value": "borrowed"
            },
            {
              "type": "STRING",
              "value": "owned"
            },
            {
              "type": "STRING",
              "value": "raw"
            },
            {
              "type": "STRING",
              "value": "unique"
            },
            {
              "type": "STRING",
              "value": "copy"
            },
            {
              "type": "STRING",
              "value": "readonly"
            },
            {
              "type": "STRING",
              "value": "const"
            },
            {
              "type": "STRING",
              "value": "nullable"
            },
            {
              "type": "STRING",
              "value": "undefined"
            },
            {
              "type": "STRING",
              "value": "nullish"
            },
            {
              "type": "STRING",
              "value": "exclusive"
            }
          ]
        }
      }
    },
    "arrow": {
      "type": "STRING",
      "value": "->"
    },
    "symbol_identifier": {
      "type": "PATTERN",
      "value": "@[A-Za-z_][A-Za-z0-9_.]*"
    },
    "ssa_identifier": {
      "type": "PATTERN",
      "value": "v[0-9]+"
    },
    "block_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "(?:block|entry|bb|b)[0-9]+"
        }
      }
    },
    "local_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "local[0-9]+"
        }
      }
    },
    "function_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "function[0-9]+"
        }
      }
    },
    "number_literal": {
      "type": "PATTERN",
      "value": "[+-]?\\d(?:[\\d_]*\\d)?(?:\\.(?:\\d(?:[\\d_]*\\d)?))?(?:[eE][+-]?\\d(?:[\\d_]*\\d)?)?(?:(?:int|uint|float)(?:8|16|32|64|128|256)|[iuf](?:8|16|32|64|128))?"
    },
    "boolean_literal": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "true"
            },
            {
              "type": "STRING",
              "value": "false"
            }
          ]
        }
      }
    },
    "character_literal": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^'\\\\\\n]+"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "string_literal": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\n]+"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_.]*"
    },
    "punctuation": {
      "type": "PATTERN",
      "value": "[(){}\\[\\],:;]"
    },
    "operator": {
      "type": "PATTERN",
      "value": "[=<>+\\-*/%!&|^~.]+"
    },
    "unknown": {
      "type": "PATTERN",
      "value": "[^\\s]"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\s\\uFEFF\\u2060\\u200B\\u00A0]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
