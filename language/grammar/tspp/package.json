{
  "name": "tree-sitter-tspp",
  "private": true,
  "version": "2026.9.0",
  "description": "TS++ grammar for tree-sitter",
  "repository": "https://github.com/destack-sh/destack",
  "license": "MIT",
  "keywords": [
    "tspp",
    "incremental",
    "parsing",
    "tree-sitter",
    "typescript"
  ],
  "files": [
    "queries/*",
    "grammar.js",
    "src/**",
    "tree-sitter.json",
    "*.wasm"
  ],
  "dependencies": {
    "tree-sitter-javascript": "0.25.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-treesitter": "1.0.2",
    "tree-sitter-cli": "0.26.12"
  },
  "scripts": {
    "generate": "tree-sitter generate --abi 15",
    "lint": "eslint grammar.js",
    "test": "bash ../scripts/test-grammar.sh tspp"
  }
}
