{
  "grammars": [
    {
      "name": "tspp",
      "camelcase": "Tspp",
      "scope": "source.tspp",
      "path": ".",
      "file-types": [
        "tspp"
      ],
      "highlights": [
        "queries/highlights.scm",
        "queries/javascript-jsx.scm",
        "queries/javascript.scm"
      ],
      "injections": "queries/injections.scm",
      "locals": [
        "queries/locals.scm",
        "queries/javascript-locals.scm"
      ],
      "tags": [
        "queries/tags.scm",
        "queries/javascript-tags.scm"
      ],
      "injection-regex": "^tspp$"
    }
  ],
  "metadata": {
    "version": "2026.9.0",
    "license": "MIT",
    "description": "TS++ grammar for tree-sitter",
    "authors": [
      {
        "name": "Destack"
      }
    ],
    "links": {
      "repository": "https://github.com/destack-sh/tspp"
    }
  },
  "bindings": {}
}
