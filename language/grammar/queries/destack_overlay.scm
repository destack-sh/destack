; destack builtin and tspp numeric aliases
([
  (identifier)
  (type_identifier)
] @type.builtin
 (#match?
  @type.builtin
  "^(?:unknown|boolean|bool|character|char|string|str|number|symbol|bigint|object|void|isize|usize|int(?:\\d+)?|uint(?:\\d+)?|float(?:\\d+)?|i\\d+|u\\d+|f\\d+)$"))
