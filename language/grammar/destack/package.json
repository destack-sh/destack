{
  "name": "tree-sitter-destack",
  "private": true,
  "version": "0.23.2",
  "description": "Destack grammar for tree-sitter",
  "repository": "https://github.com/symbol-industries/destack",
  "license": "MIT",
  "keywords": [
    "destack",
    "incremental",
    "parsing",
    "tree-sitter",
    "typescript",
    "tsx"
  ],
  "files": [
    "queries/*",
    "destack/grammar.js",
    "destack/src/**",
    "tree-sitter.json",
    "common/scanner.h",
    "*.wasm"
  ],
  "dependencies": {
    "tree-sitter-javascript": "^0.23.1"
  },
  "devDependencies": {
    "eslint": ">=9.14.0",
    "eslint-config-treesitter": "^1.0.2",
    "tree-sitter-cli": "^0.24.4"
  },
  "scripts": {
    "lint": "eslint destack/grammar.js common/define-grammar.js",
    "report:docs": "node ../scripts/check-docs.mjs",
    "test": "tree-sitter test"
  }
}
