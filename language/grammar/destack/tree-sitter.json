{
  "grammars": [
    {
      "name": "destack",
      "camelcase": "Destack",
      "scope": "source.ds",
      "path": ".",
      "file-types": [
        "ds"
      ],
      "highlights": [
        "queries/highlights.scm",
        "queries/javascript-jsx.scm",
        "queries/javascript.scm"
      ],
      "injections": "queries/injections.scm",
      "locals": [
        "queries/locals.scm",
        "queries/javascript-locals.scm"
      ],
      "tags": [
        "queries/tags.scm",
        "queries/javascript-tags.scm"
      ],
      "injection-regex": "^(ds|destack)$"
    }
  ],
  "metadata": {
    "version": "2026.9.0",
    "license": "MIT",
    "description": "Destack grammar for tree-sitter",
    "authors": [
      {
        "name": "Destack"
      }
    ],
    "links": {
      "repository": "https://github.com/destack-sh/destack"
    }
  },
  "bindings": {}
}
