{
    "name": "tspp",
    "displayName": "TS++",
    "description": "TS++ language and toolchain support for VS Code",
    "icon": "icon.png",
    "version": "2026.9.0",
    "license": "MIT",
    "engines": {
        "vscode": "^1.125.0"
    },
    "publisher": "symbol-industries",
    "author": {
        "name": "Florian C\u00e4sar",
        "email": "florian@symbol.industries"
    },
    "categories": [
        "Formatters",
        "Programming Languages"
    ],
    "repository": {
        "type": "web",
        "url": "https://github.com/destack-sh/destack.git"
    },
    "homepage": "https://destack.sh",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "activationEvents": [
        "onLanguage:tspp",
        "workspaceContains:destack.json"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Language support remains available through an installed or managed TS++ toolchain. Workspace commands and workspace-built toolchains require trust.",
            "restrictedConfigurations": [
                "tspp.server.command",
                "tspp.server.args",
                "tspp.server.cwd"
            ]
        }
    },
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "tspp.json",
        "tspp.tmLanguage.json",
        "tsppm.json",
        "tsppm.tmLanguage.json",
        "tsppa.json",
        "tsppa.tmLanguage.json",
        "destack.schema.json",
        "icon.png",
        "package.json",
        "LICENSE.txt"
    ],
    "contributes": {
        "configuration": {
            "title": "TS++",
            "properties": {
                "tspp.server.command": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Command for the TS++ language server. If empty, uses a workspace build, an installed `tspp`, or the release matching this extension. Supports `~` and `${workspaceFolder}`."
                },
                "tspp.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional arguments passed to the language server."
                },
                "tspp.server.cwd": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory for the language server. Supports `~` and `${workspaceFolder}`."
                },
                "tspp.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace structured language server messages. Verbose tracing also includes message bodies and detailed artifact timings."
                },
                "tspp.completion.autoImports": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Include auto import completions in the completion list."
                },
                "tspp.inlayHints.parameterHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show parameter name inlay hints for call arguments."
                },
                "tspp.inlayHints.typeHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show inferred type inlay hints for local bindings."
                }
            }
        },
        "commands": [
            {
                "command": "tspp.restart",
                "title": "Destack: Restart Server"
            },
            {
                "command": "tspp.reload",
                "title": "Destack: Reload Workspace"
            },
            {
                "command": "tspp.showLogs",
                "title": "Destack: Show Logs"
            }
        ],
        "languages": [
            {
                "id": "tspp",
                "aliases": [
                    "TS++",
                    "tspp"
                ],
                "extensions": [
                    ".tspp",
                    ".d.tspp"
                ],
                "configuration": "./tspp.json"
            },
            {
                "id": "tsppm",
                "aliases": [
                    "TS++ MIR",
                    "tsppm"
                ],
                "extensions": [
                    ".tsppm"
                ],
                "configuration": "./tsppm.json"
            },
            {
                "id": "tsppa",
                "aliases": [
                    "TS++ Bytecode Assembly",
                    "tsppa"
                ],
                "extensions": [
                    ".tsppa"
                ],
                "configuration": "./tsppa.json"
            }
        ],
        "grammars": [
            {
                "language": "tspp",
                "scopeName": "source.tspp",
                "path": "./tspp.tmLanguage.json"
            },
            {
                "language": "tsppm",
                "scopeName": "source.tsppm",
                "path": "./tsppm.tmLanguage.json"
            },
            {
                "language": "tsppa",
                "scopeName": "source.tsppa",
                "path": "./tsppa.tmLanguage.json"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    "destack.json",
                    "*.destack.json"
                ],
                "url": "./destack.schema.json"
            }
        ]
    },
    "scripts": {
        "compile": "tsc --noEmit",
        "bundle": "deno run -A npm:esbuild src/extension/index.ts --bundle --platform=node --format=cjs --legal-comments=none --minify --outfile=out/extension.js --external:vscode",
        "vscode:prepublish": "deno task compile && deno task bundle",
        "package": "deno run -A npm:@vscode/vsce package --no-dependencies",
        "publish:live": "deno run -A npm:@vscode/vsce publish --no-dependencies",
        "test:grammar": "deno run -A npm:vscode-tmgrammar-test --grammar tspp.tmLanguage.json \"../fixture/highlight/tspp/**/*.txt\" && deno run -A npm:vscode-tmgrammar-test --grammar tsppm.tmLanguage.json \"../fixture/highlight/mir/*.txt\" && deno run -A npm:vscode-tmgrammar-test --grammar tsppa.tmLanguage.json \"../fixture/highlight/bytecode/*.txt\""
    },
    "dependencies": {
        "extract-zip": "^2.0.1",
        "tar": "^7.5.19",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.125.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
