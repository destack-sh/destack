{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DsConfigJson",
  "description": "DsConfig JSON (usually from `dsconfig.json`)",
  "type": "object",
  "properties": {
    "extends": {
      "description": "Extends other dsconfigs or tsconfigs.",
      "anyOf": [
        {
          "$ref": "#/$defs/ExtendsFieldJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "description": "Specific files to include in the project.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "include": {
      "description": "Glob patterns for files to include.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "description": "Glob patterns for files to exclude.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "compilerOptions": {
      "description": "Compiler options.",
      "$ref": "#/$defs/CompilerOptionsJson"
    },
    "formatter": {
      "description": "Formatter options.",
      "$ref": "#/$defs/DsConfigFormatterJson"
    },
    "linter": {
      "description": "Linter options.",
      "$ref": "#/$defs/DsConfigLinterJson"
    },
    "targets": {
      "description": "Build targets.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/DsConfigTargetJson"
      }
    }
  },
  "$defs": {
    "ExtendsFieldJson": {
      "description": "Value for the \"extends\" field of a dsconfig.",
      "anyOf": [
        {
          "description": "Extend a single dsconfig.",
          "type": "string"
        },
        {
          "description": "Extend multiple dsconfigs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "CompilerOptionsJson": {
      "description": "Destack configuration compiler options.",
      "type": "object",
      "properties": {
        "baseUrl": {
          "description": "Base URL for resolving non-relative module names.",
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "description": "Path alias mappings (resolved relative to baseUrl, like tsconfig paths).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "module": {
          "description": "Module format for output (e.g., \"esnext\", \"commonjs\").",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "ECMAScript target version (e.g., \"es2022\", \"esnext\").",
          "type": [
            "string",
            "null"
          ]
        },
        "lib": {
          "description": "Library files to include (e.g., [\"es2024\", \"dom\"]).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "strict": {
          "description": "Enable all TypeScript-derived strict type-checking options. Default: true for .ds files.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitAny": {
          "description": "Error on expressions and declarations with implied `any` type.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "strictNullChecks": {
          "description": "Enable strict null checks (`null` and `undefined` are distinct types).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitThis": {
          "description": "Error on `this` expressions with implied `any` type.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "strictFunctionTypes": {
          "description": "Enable strict checking of function types (contravariant parameters).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "strictBindCallApply": {
          "description": "Enable strict checking of `bind`, `call`, and `apply` methods.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "strictPropertyInitialization": {
          "description": "Require class properties to be initialized in constructor.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "useUnknownInCatchVariables": {
          "description": "Use `unknown` instead of `any` for catch clause variables.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noUnusedLocals": {
          "description": "Report errors on unused local variables.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noUnusedParameters": {
          "description": "Report errors on unused function parameters.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitReturns": {
          "description": "Report error when not all code paths return a value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowUnreachableCode": {
          "description": "Allow unreachable code (disables dead code warnings).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitOverride": {
          "description": "Require `override` keyword when overriding class members.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noFallthroughCasesInSwitch": {
          "description": "Report errors for fallthrough cases in switch statements.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "exactOptionalPropertyTypes": {
          "description": "Interpret optional property types as written (no implicit `undefined`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noUncheckedIndexedAccess": {
          "description": "Add `undefined` to index signature results (safer array access).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noAny": {
          "description": "Forbid use of `any` type.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noUnknown": {
          "description": "Forbid use of `unknown` type.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImprecisePrimitives": {
          "description": "Require precise primitive types (int32 vs number, etc.).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitConversions": {
          "description": "Require explicit widening/narrowing conversions.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noUnsafeTypeAssertions": {
          "description": "Forbid unsafe type assertions (`as T`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitSelf": {
          "description": "Require explicit `self.` for member access in methods.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noArguments": {
          "description": "Forbid `arguments` object (use rest parameters instead).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noRedeclaredLocals": {
          "description": "Forbid re-declaration of local variables.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitManagedType": {
          "description": "Require `^T` or `&T` in type positions (no implicit managed types).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitManagedValue": {
          "description": "Require explicit copy/borrow at call sites (no implicit managed values).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noManaged": {
          "description": "Forbid managed runtime features entirely (no &T at all, pure value types only).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noReferentialEquality": {
          "description": "Forbid referential equality.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noDynamicEvaluation": {
          "description": "Forbid `eval()` and `Function` constructor.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noGlobalThis": {
          "description": "Forbid `globalThis` access.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noDynamicImport": {
          "description": "Forbid dynamic `import()` and `require()` expressions.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noDynamicShapes": {
          "description": "Forbid defineProperty, prototype mutation, delete (require static object shapes).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noComputedPropertyAccess": {
          "description": "Forbid computed property access `obj[expr]` where expr isn't constant.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noProxy": {
          "description": "Forbid `Proxy`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noImplicitDynamicDispatch": {
          "description": "Require overloads to be statically resolvable (no implicit runtime dispatch).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "noExceptions": {
          "description": "Forbid `throw` and `try`/`catch` (use Result types instead).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "rootDir": {
          "description": "Root directory of source files (controls output directory structure, not module resolution).",
          "type": [
            "string",
            "null"
          ]
        },
        "outDir": {
          "description": "Output directory for compiled files.",
          "type": [
            "string",
            "null"
          ]
        },
        "declarationDir": {
          "description": "Output directory for declaration files (.d.ts). Defaults to outDir.",
          "type": [
            "string",
            "null"
          ]
        },
        "tsconfig": {
          "description": "Path to tsconfig.json to inherit settings from.",
          "type": [
            "string",
            "null"
          ]
        },
        "allowTs": {
          "description": "Allow TypeScript files (.ts, .tsx) in the project.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "checkTs": {
          "description": "Type-check TypeScript files.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowJs": {
          "description": "Allow JavaScript files (.js, .jsx) in the project.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "checkJs": {
          "description": "Type-check JavaScript files.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "skipLibCheck": {
          "description": "Skip type checking of declaration files (.d.ts, .d.ds).",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "DsConfigFormatterJson": {
      "description": "Formatter options (top-level, like Biome/Deno).\n\nField names use Prettier-compatible naming for familiarity.",
      "type": "object",
      "properties": {
        "lineEnding": {
          "description": "Line ending style: \"lf\", \"crlf\", or \"cr\".",
          "anyOf": [
            {
              "$ref": "#/$defs/LineEndingJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "useTabs": {
          "description": "Use tabs instead of spaces.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "indentStyle": {
          "description": "Indent style: \"tab\" or \"space\".",
          "anyOf": [
            {
              "$ref": "#/$defs/IndentStyleJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "indentWidth": {
          "description": "Number of spaces per indent. Default: 4.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "lineWidth": {
          "description": "Maximum line width (best effort). Default: 100.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "quoteStyle": {
          "description": "Quote style: \"double\", \"single\", or \"semantic\".",
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteStyleJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "singleQuote": {
          "description": "Use single quotes. Takes precedence over quoteStyle.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "trailingComma": {
          "description": "Trailing comma policy: \"all\", \"es5\", or \"none\".",
          "anyOf": [
            {
              "$ref": "#/$defs/TrailingCommaJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "bracketSpacing": {
          "description": "Spaces inside object braces: `{ foo }` (true) vs `{foo}` (false). Default: true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "arrowParens": {
          "description": "Arrow function parentheses: \"always\" or \"avoid\".",
          "anyOf": [
            {
              "$ref": "#/$defs/ArrowParenthesesJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "quoteProps": {
          "description": "Object property quoting: \"as-needed\", \"consistent\", or \"preserve\".",
          "anyOf": [
            {
              "$ref": "#/$defs/QuotePropertyJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "bracketSameLine": {
          "description": "Put `>` of multi-line JSX on same line as last attribute.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "singleAttributePerLine": {
          "description": "Force each JSX attribute onto its own line.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "organizeImports": {
          "description": "Whether to organize imports: \"on\" or \"off\". Default: off.",
          "anyOf": [
            {
              "$ref": "#/$defs/OrganizeImportsJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "importSortOrder": {
          "description": "Sort order for import specifiers: \"natural\" or \"alphabetical\". Default: natural.",
          "anyOf": [
            {
              "$ref": "#/$defs/ImportSortOrderJson"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LineEndingJson": {
      "description": "Line ending style for JSON deserialization.",
      "oneOf": [
        {
          "description": "Unix-style line endings (LF).",
          "type": "string",
          "const": "lf"
        },
        {
          "description": "Windows-style line endings (CRLF).",
          "type": "string",
          "const": "crlf"
        },
        {
          "description": "Classic Mac-style line endings (CR).",
          "type": "string",
          "const": "cr"
        }
      ]
    },
    "IndentStyleJson": {
      "description": "Indent style for JSON deserialization.",
      "type": "string",
      "enum": [
        "tab",
        "space"
      ]
    },
    "QuoteStyleJson": {
      "description": "Quote style for JSON deserialization (Prettier: `singleQuote`).",
      "oneOf": [
        {
          "description": "Use double quotes.",
          "type": "string",
          "const": "double"
        },
        {
          "description": "Use single quotes.",
          "type": "string",
          "const": "single"
        },
        {
          "description": "Use single quotes for single characters, double quotes for strings.",
          "type": "string",
          "const": "semantic"
        }
      ]
    },
    "TrailingCommaJson": {
      "description": "Trailing comma policy for JSON deserialization (Prettier: `trailingComma`).",
      "oneOf": [
        {
          "description": "Trailing commas everywhere valid.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Trailing commas where valid in ES5.",
          "type": "string",
          "const": "es5"
        },
        {
          "description": "No trailing commas.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "ArrowParenthesesJson": {
      "description": "Arrow function parentheses for JSON deserialization.",
      "oneOf": [
        {
          "description": "Always include parentheses.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Omit when possible.",
          "type": "string",
          "const": "avoid"
        }
      ]
    },
    "QuotePropertyJson": {
      "description": "Object property quoting for JSON deserialization.",
      "oneOf": [
        {
          "description": "Only quote when required.",
          "type": "string",
          "const": "as-needed"
        },
        {
          "description": "Quote all if any require quotes.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "Preserve original quoting.",
          "type": "string",
          "const": "preserve"
        }
      ]
    },
    "OrganizeImportsJson": {
      "description": "Whether to organize imports.",
      "oneOf": [
        {
          "description": "Organize imports: sort statements by group and specifiers alphabetically.",
          "type": "string",
          "const": "on"
        },
        {
          "description": "Don't reorder imports (preserve original order).",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "ImportSortOrderJson": {
      "description": "Sort order for import specifiers.",
      "oneOf": [
        {
          "description": "Natural sort: numbers ordered as integers (a1 < a2 < a10).",
          "type": "string",
          "const": "natural"
        },
        {
          "description": "Alphabetical/lexicographic sort (a1 < a10 < a2).",
          "type": "string",
          "const": "alphabetical"
        }
      ]
    },
    "DsConfigLinterJson": {
      "description": "Linter options (top-level, like Biome/Deno).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether linting is enabled. Default: true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "rules": {
          "description": "Rule configuration.",
          "$ref": "#/$defs/DsConfigLinterRulesJson"
        },
        "maxBooleans": {
          "description": "Maximum boolean parameters or fields.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxCognitiveComplexity": {
          "description": "Maximum cognitive complexity.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxCyclomaticComplexity": {
          "description": "Maximum cyclomatic complexity.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxDepth": {
          "description": "Maximum nesting depth.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxLines": {
          "description": "Maximum lines per file.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxLinesPerFunction": {
          "description": "Maximum lines per function.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxNestedCallbacks": {
          "description": "Maximum callback nesting.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxParams": {
          "description": "Maximum function parameters.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxStatements": {
          "description": "Maximum statements per function.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxReturnStatements": {
          "description": "Maximum return statements per function.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxSwitchCases": {
          "description": "Maximum switch cases per switch statement.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxTypeVariants": {
          "description": "Maximum variants in a union type or enum.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxTypeFields": {
          "description": "Maximum fields in a struct, class, or interface.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxTypeComplexity": {
          "description": "Maximum type complexity (nesting depth of generics/unions/intersections).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxDuplicateStringOccurrences": {
          "description": "Maximum occurrences of the same string literal before warning.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "maxTryBlockStatements": {
          "description": "Maximum statements in a try block.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "arrayType": {
          "description": "Preferred array type syntax: \"array\" or \"generic\".",
          "anyOf": [
            {
              "$ref": "#/$defs/ArrayTypeStyleJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "typeDefinitionStyle": {
          "description": "Preferred type definition syntax: \"type\" or \"interface\".",
          "anyOf": [
            {
              "$ref": "#/$defs/TypeDefinitionStyleJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "catchErrorName": {
          "description": "Required catch clause error name.",
          "type": [
            "string",
            "null"
          ]
        },
        "filenameCase": {
          "description": "Required filename case style.",
          "anyOf": [
            {
              "$ref": "#/$defs/FilenameCaseJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedMagicNumbers": {
          "description": "Magic numbers to allow.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "restrictedGlobals": {
          "description": "Globals to restrict.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "restrictedImports": {
          "description": "Import paths to restrict.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "warningCommentTerms": {
          "description": "Comment terms to warn on.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DsConfigLinterRulesJson": {
      "description": "Linter rules configuration.",
      "type": "object",
      "properties": {
        "preset": {
          "description": "Preset: \"none\", \"recommended\", or \"all\".",
          "type": [
            "string",
            "null"
          ]
        },
        "recommended": {
          "description": "Enable the recommended rule set (shorthand for preset: \"recommended\").",
          "type": [
            "boolean",
            "null"
          ]
        },
        "all": {
          "description": "Enable all rules (shorthand for preset: \"all\").",
          "type": [
            "boolean",
            "null"
          ]
        },
        "categories": {
          "description": "Category-level severity overrides.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/RuleSeverityJson"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/RuleSeverityJson"
      }
    },
    "RuleSeverityJson": {
      "description": "Rule severity for JSON deserialization.",
      "oneOf": [
        {
          "description": "Rule is disabled.",
          "type": "string",
