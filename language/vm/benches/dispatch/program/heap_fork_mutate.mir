function buildForkGraph(v0: int32): ref<int32, managed, readonly> {
b0(v0: int32):
    v1: int32 = 0int32
    v2: ref<int32, managed, readonly> = new.zeroed int32
    jump b1(v1, v2)
b1(v3: int32, v4: ref<int32, managed, readonly>):
    v5: boolean = int.lt.s v3, v0
    branch v5, b2(v3), b3(v4)
b2(v6: int32):
    v7: ref<int32, managed, readonly> = new.zeroed int32
    store v7, v6
    v8: int32 = 1int32
    v9: int32 = int.add v6, v8
    jump b1(v9, v7)
b3(v10: ref<int32, managed, readonly>):
    return v10
}

function mutateHotCell(v0: ref<int32, managed, readonly>, v1: int32): int32 {
b0(v0: ref<int32, managed, readonly>, v1: int32):
    v2: int32 = 0int32
    v3: int32 = 0int32
    jump b1(v2, v3)
b1(v4: int32, v5: int32):
    v6: boolean = int.lt.s v4, v1
    branch v6, b2(v4, v5), b3(v5)
b2(v7: int32, v8: int32):
    store v0, v7
    v9: int32 = load v0
    v10: int32 = int.add v8, v9
    v11: int32 = 1int32
    v12: int32 = int.add v7, v11
    jump b1(v12, v10)
b3(v13: int32):
    return v13
}
