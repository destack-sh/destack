function @call_direct_deep(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    jump block1(v1, v1)

// loop condition, check limit
block1(v2: i64, v3: i64):
    v4 = icmp_sge v2, v0
    branch v4, block3(v3), block2

// loop body, call helper
block2:
    v5 = call @d1(v3)
    v6 = iconst 1i64
    v7 = iadd v2, v6
    jump block1(v7, v5)

// return result
block3(v8: i64):
    return v8
}
