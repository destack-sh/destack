
function @d20(v0: i64) -> i64 { block0(v0: i64): v1 = iconst 1i64 v2 = iadd v0, v1 return v2 }
function @d19(v0: i64) -> i64 { block0(v0: i64): v1 = call @d20(v0) return v1 }
