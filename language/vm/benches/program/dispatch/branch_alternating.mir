
function @branch_alternating(v0: i64) -> i64 {
block0(v0: i64):
    v1 = iconst 0i64
    jump block1(v1, v1)
block1(v2: i64, v3: i64):
    v4 = icmp_sge v2, v0
    branch v4, block5(v3), block2
block2:
    v5 = iconst 2i64
    v6 = srem v2, v5
    v7 = iconst 0i64
    v8 = icmp_eq v6, v7
    branch v8, block3, block4
block3:
    v9 = iconst 1i64
    v10 = iadd v3, v9
    v11 = iadd v2, v9
    jump block1(v11, v10)
block4:
    v12 = iconst 1i64
    v13 = iadd v2, v12
    jump block1(v13, v3)
block5(v14: i64):
    return v14
}
