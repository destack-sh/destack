    switch v6, block3, 0 => block3, 1 => block4, 2 => block5, 3 => block6, 4 => block7, 5 => block8, 6 => block9, 7 => block10, 8 => block11, 9 => block12, 10 => block13, 11 => block14, 12 => block15, 13 => block16, 14 => block17, 15 => block18
