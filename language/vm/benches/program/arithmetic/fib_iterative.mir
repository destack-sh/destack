
function @fib_iter(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    v2 = iconst 1i64
    jump block1(v1, v1, v2)

// loop condition, check limit
block1(v3: i64, v4: i64, v5: i64):
    v6 = icmp_sge v3, v0
    branch v6, block3(v4), block2

// loop body, update accumulators
block2:
    v7 = iadd v4, v5
    v8 = iconst 1i64
    v9 = iadd v3, v8
    jump block1(v9, v5, v7)

// return result
block3(v10: i64):
    return v10
}
