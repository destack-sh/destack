
function @checked_arith(v0: i64) -> i64 {

// entry, init state
block0(v0: i64):
    v1 = iconst 0i64
    v2 = iconst 1i64
    jump block1(v1, v2, v1)

// loop condition, check limit
block1(v3: i64, v4: i64, v5: i64):
    v6 = icmp_sge v3, v0
    branch v6, block3(v5), block2

// branch on condition
block2:
    v7 = intrinsic.add.overflow(v4, v2)
    v8 = field.get v7, 0
    v9 = field.get v7, 1
    branch v9, block4, block6

// merge branch, continue
block4:
    v10 = iconst 1i64
    jump block5(v10)

// loop body, advance state
block6:
    v18 = iconst 0i64
    jump block5(v18)

// merge branches, advance loop
block5(v11: i64):
    v12 = iadd v5, v11
    v13 = iconst 1i64
    v14 = iadd v3, v13
    v15 = iconst 127i64
    v16 = srem v8, v15
    jump block1(v14, v16, v12)

// return result
block3(v17: i64):
    return v17
}
