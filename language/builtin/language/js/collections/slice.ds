/// A borrowed view into a JS array.
struct Slice<T> {
    /// Backing array storage.
    data: Array<T>;
    /// Start offset within the backing array.
    start: uint32;
    /// Number of elements in the slice.
    length: uint32;
}

extension<T> of Slice<T> implements Index<number, T>, IndexSet<number, T>, Iterable<T> {
    /// Get the length of the slice.
    get length(): number {
        this.length as number
    }

    /// Check if the slice is empty.
    get isEmpty(): boolean {
        this.length == 0
    }

    /// Get the element at the index with bounds checks.
    index(i: number): T {
        if (i < 0 || i >= this.length as number) {
            undefined!
        }
        // #Incomplete
        undefined!
    }

    /// Get a sub-slice.
    slice(start?: number, end?: number): Slice<T> {
        // #Incomplete
        this
    }

    /// Get the first element.
    first(): T | undefined {
        if (this.length == 0) {
            return undefined;
        }
        this.index(0)
    }

    /// Get the last element.
    last(): T | undefined {
        if (this.length == 0) {
            return undefined;
        }
        this.index(this.length as number - 1)
    }

    /// Split at index into two slices.
    splitAt(index: number): [Slice<T>, Slice<T>] {
        // #Incomplete
        [this, this]
    }

    /// Create an iterator.
    [Symbol.iterator](): Iterator<T> {
        // #Incomplete
        undefined!
    }

    /// Copy slice contents to an owned array.
    toArray(): Array<T> {
        // #Incomplete
        []
    }

    /// Set the element at the index with bounds checks.
    indexSet(this: &Slice<T>, i: number, value: T): void {
        if (i < 0 || i >= this.length as number) {
            undefined!
        }
        // #Incomplete
    }

    /// Fill the slice with a value.
    fill(this: &Slice<T>, value: T): void {
        // #Incomplete
    }

    /// Copy from another slice.
    copyFrom(this: &Slice<T>, src: Slice<T>): void {
