/// Result of a checked arithmetic operation.
struct OverflowResult<T> {
    /// The wrapped result value.
    value: T;
    /// Whether overflow occurred.
    overflow: boolean;
}

/// Add with overflow detection.
@intrinsic
declare function addOverflow<T>(a: T, b: T): OverflowResult<T>;

/// Subtract with overflow detection.
@intrinsic
declare function subOverflow<T>(a: T, b: T): OverflowResult<T>;

/// Multiply with overflow detection.
@intrinsic
declare function mulOverflow<T>(a: T, b: T): OverflowResult<T>;

/// Saturating add (clamps to max on overflow).
@intrinsic
declare function satAdd<T>(a: T, b: T): T;

/// Saturating subtract (clamps to min on underflow).
@intrinsic
declare function satSub<T>(a: T, b: T): T;
