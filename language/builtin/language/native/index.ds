// core types (ambient)
export { String, StringBuilder } from "./string/index.ds";
export { Array, arrayOf, arrayFill } from "./collections/index.ds";
export { type ReadonlyArray, type FixedArray } from "./collections/index.ds";
export { Slice } from "./collections/index.ds";
export { Map, type Record } from "./collections/index.ds";
export { Set } from "./collections/index.ds";
export { type Vector } from "intrinsic/primitive/vector.ds";
export { type PlatformCapability } from "intrinsic/primitive/binding.ds";

// low-level primitives (not ambient, must be imported explicitly)
export {
    rawAlloc,
    rawFree,
    rawRealloc,
    memcpy,
    memmove,
    memset,
    memcmp,
    sizeOf,
    alignOf,
    RawBuffer,
} from "./memory/index.ds";
export {
    AtomicScope,
    MemoryOrdering,
    MemoryRegionSet,
    MemoryScope,
    atomicCas,
    atomicCasWeak,
    atomicExchange,
    atomicFence,
    atomicFetchAdd,
    atomicFetchAnd,
    atomicFetchFadd,
    atomicFetchFmax,
    atomicFetchFmin,
    atomicFetchMax,
    atomicFetchMin,
    atomicFetchOr,
    atomicFetchSub,
    atomicFetchUmax,
    atomicFetchUmin,
    atomicFetchXor,
    atomicLoad,
    atomicStore,
} from "./sync/index.ds";

// math (not ambient)
export {
    // bit manipulation
    clz,
    ctz,
    popcnt,
    byteSwap,
    bitReverse,
    rotateLeft,
    rotateRight,
    // float math
    sqrt,
    abs,
    fma,
    copysign,
    min,
    max,
    sin,
    cos,
    tan,
    asin,
    acos,
    atan,
    atan2,
    exp,
    exp2,
    log,
    log2,
    log10,
    pow,
    floor,
    ceil,
    trunc,
    round,
    // checked arithmetic (aliases)
    OverflowResult,
    addOverflow,
    subOverflow,
    mulOverflow,
    satAdd,
    satSub,
} from "./math/index.ds";
