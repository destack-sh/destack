/// Native dynamic array.
export struct Array<T> {
    /// Number of elements in the array.
    length: uint32;
    /// Allocated capacity (in elements).
    capacity: uint32;
    /// Pointer to contiguous element storage.
    data: *T;
}

/// Readonly view of a dynamic array.
export type ReadonlyArray<T> = readonly T[];

/// Fixed-size array alias with explicit comptime disambiguation.
export type FixedArray<T, comptime N: number> = T[N as comptime];

extension<T> of Array<T> implements Index<number, T>, IndexSet<number, T>, Iterable<T> {
    /// Get the length of the array.
    get length(): number {
        this.length as number
    }

    /// Check if the array is empty.
    get isEmpty(): boolean {
        this.length == 0
    }

    /// Get the element at the index with bounds checks.
    index(i: number): T {
        // #Incomplete
    }

    /// Set the element at the index with bounds checks.
    indexSet(i: number, value: T): void {
        // #Incomplete
    }

    /// Get element at index (unchecked).
    unsafeGet(i: uint32): T {
        // #Incomplete
        undefined!
    }

    /// Set element at index (unchecked).
    unsafeSet(i: uint32, value: T): void {
        // #Incomplete
    }

    /// Push an element to the end.
    push(value: T): void {
        // #Incomplete
    }

    /// Pop an element from the end.
    pop(): T | undefined {
        if this.length == 0 {
            return undefined;
        }
        // #Incomplete
        undefined
    }

    /// Get the first element.
    first(): T | undefined {
        if this.length == 0 {
            return undefined;
        }
        this.index(0)
    }

    /// Get the last element.
    last(): T | undefined {
        if this.length == 0 {
            return undefined;
        }
        this.index(this.length as number - 1)
    }

    /// Clear all elements.
    clear(): void {
        // #Incomplete: should drop elements
        this.length = 0;
    }

    /// Reserve capacity for at least `additional` more elements.
    reserve(additional: uint32): void {
        // #Incomplete
    }

    /// Shrink capacity to fit current length.
    shrinkToFit(): void {
        // #Incomplete
    }

    /// Create an iterator over the array.
    [Symbol.iterator](): Iterator<T> {
        // #Incomplete
        undefined!
    }

    // --- higher-order methods ---

    /// Map each element to a new value.
    map<U>(f: (value: T, index: number) => U): Array<U> {
        // #Incomplete
        Array { length: 0, capacity: 0, data: null as *U }
    }

    /// Filter elements by predicate.
    filter(predicate: (value: T, index: number) => boolean): Array<T> {
        // #Incomplete
        Array { length: 0, capacity: 0, data: null as *T }
    }

    /// Reduce array to single value.
    reduce<U>(f: (acc: U, value: T, index: number) => U, initial: U): U {
        // #Incomplete
        initial
    }

    /// Find first element matching predicate.
    find(predicate: (value: T, index: number) => boolean): T | undefined {
        // #Incomplete
        undefined
    }

    /// Find index of first element matching predicate.
    findIndex(predicate: (value: T, index: number) => boolean): number {
        // #Incomplete
        -1
    }

    /// Check if any element matches predicate.
    some(predicate: (value: T, index: number) => boolean): boolean {
        // #Incomplete
        false
    }

    /// Check if all elements match predicate.
    every(predicate: (value: T, index: number) => boolean): boolean {
        // #Incomplete
        true
    }

    /// Execute function for each element.
    forEach(f: (value: T, index: number) => void): void {
        // #Incomplete
    }

    /// Check if array includes a value.
    includes(value: T, fromIndex?: number): boolean {
        // #Incomplete
