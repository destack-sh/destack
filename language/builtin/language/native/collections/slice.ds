import { intrinsic } from "intrinsic/primitive/decorator.ds";

/// A borrowed view into contiguous memory.
export newtype Slice<T> = unknown;

/// Return the slice length.
@intrinsic("slice.length")
declare function sliceLength<T>(slice: Slice<T>): uint32;

/// Load one element without bounds checks.
@intrinsic("slice.get")
declare function sliceUnsafeGet<T>(slice: Slice<T>, index: uint32): T;

/// Store one element without bounds checks.
@intrinsic("slice.set")
declare function sliceUnsafeSet<T>(slice: &Slice<T>, index: uint32, value: T): void;

extension<T> of Slice<T> implements Index<number, T>, IndexSet<number, T>, Iterable<T> {
    /// Get the length of the slice.
    get length(): number {
        sliceLength(this) as number
    }

    /// Check if the slice is empty.
    get isEmpty(): boolean {
        sliceLength(this) == 0
    }

    /// Get the element at the index with bounds checks.
    index(i: number): T {
        let length = sliceLength(this) as number;

        if (i < 0 || i >= length) {
            undefined!
        }

        this.unsafeGet(i as uint32)
    }

    /// Get element at index (unchecked).
    unsafeGet(i: uint32): T {
        sliceUnsafeGet(this, i)
    }

    /// Get a sub-slice.
    slice(start?: number, end?: number): Slice<T> {
        // #Incomplete
        undefined!
    }

    /// Get the first element.
    first(): T | undefined {
        if (sliceLength(this) == 0) {
            return undefined;
        }

        this.index(0)
    }

    /// Get the last element.
    last(): T | undefined {
        let length = sliceLength(this);

        if (length == 0) {
            return undefined;
        }

        this.index(length as number - 1)
    }

    /// Split at index into two slices.
    splitAt(index: number): [Slice<T>, Slice<T>] {
        // #Incomplete
        undefined!
    }

    /// Copy slice contents to an owned array.
    toArray(): Array<T> {
        // #Incomplete
        undefined!
    }

    /// Set the element at the index with bounds checks.
    indexSet(this: &Slice<T>, i: number, value: T): void {
        let length = sliceLength(this) as number;

        if (i < 0 || i >= length) {
            undefined!
        }

        sliceUnsafeSet(this, i as uint32, value);
    }

    /// Fill the slice with a value.
    fill(this: &Slice<T>, value: T): void {
        // #Incomplete
    }

    /// Copy from another slice.
    copyFrom(this: &Slice<T>, src: Slice<T>): void {
        // #Incomplete
    }

    /// Swap two elements.
    swap(this: &Slice<T>, i: number, j: number): void {
        // #Incomplete
    }

    /// Reverse in place.
    reverse(this: &Slice<T>): void {
        // #Incomplete
    }
}
