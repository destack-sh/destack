/// Control flow result for the Try interface.
///
/// Used to signal whether to continue or break/return early.
newtype ControlFlow<B, C> =
    | { kind: "continue", value: C }
    | { kind: "break", value: B };

/// Interface for the `?` operator (try/propagate).
///
/// The `?` operator provides early return on "error" values.
/// `x?` becomes:
/// ```
/// match x.branch() {
///     ControlFlow.Continue(v) => v
///     ControlFlow.Break(e) => return Self.fromResidual(e)
/// }
/// ```
///
/// # Example
///
/// ```
/// // Result<T, E> implements Try
/// function divide(a: int, b: int): Result<int, string> {
///     if (b == 0) { 
///         Result.err("division by zero") 
///     } else { 
///         Result.ok(a / b) 
///     }
/// }
///
/// function calculate(): Result<int, string> {
///     const x = divide(10, 2)?;  // x = 5, or returns early on error
///     const y = divide(x, 0)?;   // returns Err("division by zero")
///     Result.ok(y)
/// }
/// ```
newtype interface Try {
    /// The success/output type.
    type Output;

    /// The residual type (for early return).
    type Residual;

    /// Branch on success or failure.
    branch(): ControlFlow<Self.Residual, Self.Output>;

    /// Construct Self from a residual (for propagation).
    static fromResidual(residual: Self.Residual): Self;
}

/// A range bound - included, excluded, or unbounded.
newtype Bound<T> =
    | { kind: "included", value: T }
    | { kind: "excluded", value: T }
    | { kind: "unbounded" };

/// Interface for types that represent a range of values.
///
/// Implemented by all range types (`Range`, `RangeInclusive`, etc.).
newtype interface RangeBounds<T> {
    /// The start bound of this range.
    startBound(): Bound<T>;

    /// The end bound of this range.
    endBound(): Bound<T>;

    /// Check if a value is contained in this range.
    contains(value: T): boolean;
}

/// Exclusive range: `start..end` (includes start, excludes end).
///
/// ```
/// for (const i of 0..5) {
///     print(i);  // 0, 1, 2, 3, 4
/// }
/// ```
struct Range<T> implements RangeBounds<T> {
    start: T,
    end: T,
}

/// Inclusive range: `start..=end` (includes both start and end).
///
/// ```
/// for (const i of 0..=5) {
///     print(i);  // 0, 1, 2, 3, 4, 5
/// }
/// ```
struct RangeInclusive<T> implements RangeBounds<T> {
    start: T,
    end: T,
}

/// Range from: `start..` (includes start, no upper bound).
///
/// ```
/// for (const i of 5..) {
///     if (i > 10) { break }
///     print(i);  // 5, 6, 7, 8, 9, 10
/// }
/// ```
struct RangeFrom<T> implements RangeBounds<T> {
    start: T,
}

/// Range to (exclusive): `..end` (no lower bound, excludes end).
///
/// ```
/// array[..5]  // first 5 elements (indices 0-4)
/// ```
struct RangeTo<T> implements RangeBounds<T> {
    end: T,
}

/// Range to (inclusive): `..=end` (no lower bound, includes end).
///
/// ```
/// array[..=5]  // first 6 elements (indices 0-5)
/// ```
struct RangeToInclusive<T> implements RangeBounds<T> {
    end: T,
}

/// Full range: `..` (no bounds, matches everything).
///
/// ```
/// array[..]   // entire array
/// ```
struct RangeFull implements RangeBounds<unknown> {}