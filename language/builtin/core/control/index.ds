// Control flow primitives
//
// Types and interfaces for control flow operations:
// - Error handling: Result, Try
// - Iteration: Range types

export { type Try, type TryBranch } from "./try.ds";
export { type Error } from "./error.ds";
export { Ok, Err, Result, AsyncResult } from "./result.ds";
export {
    type IteratorYieldResult,
    type IteratorReturnResult,
    type IteratorResult,
    type Iterator,
    type Iterable,
    type IterableIterator,
} from "./iterable.ds";
export {
    Bound,
    type RangeBounds,
    Range,
    RangeInclusive,
    RangeFrom,
    RangeTo,
    RangeToInclusive,
    RangeFull,
} from "./range.ds";
