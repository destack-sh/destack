// Cast-related intrinsics.
//
// Operations here map directly to MIR cast operators.

import { intrinsic } from "./decorator.ds";

// saturating conversions: clamp to bounds and map NaN to zero

/// Saturating float to signed integer conversion.
///
/// NaN converts to 0 and out of range values clamp to bounds.
@intrinsic("fcvt_to_sint.sat")
export declare function floatToSignedIntSaturating<T extends int, F extends float>(value: F): T;

/// Saturating float to unsigned integer conversion.
///
/// NaN converts to 0 and out of range values clamp to bounds.
@intrinsic("fcvt_to_uint.sat")
export declare function floatToUnsignedIntSaturating<T extends int, F extends float>(
    value: F,
): T;
