// Compiler-recognized decorator markers.
//
// These newtypes are used as decorators that the compiler understands.
// When applied to declarations, they affect compilation behavior.

/// Marks something as an external symbol.
///
/// ```
/// @extern("C")
/// function oldAPI() { }
/// ```
export newtype extern = (string,) | ();

/// Marks something as deprecated.
///
/// When used as a decorator, emits a compile-time warning.
/// The message is included in the warning and accessible at runtime.
///
/// ```
/// @deprecated("use newAPI instead")
/// function oldAPI() { }
/// ```
export newtype deprecated = (string,) | ();

/// Marks something as experimental/unstable.
///
/// ```
/// @experimental
/// function newFeature() { }
/// ```
export newtype experimental = (string,) | ();

/// Allow some diagnostic.
/// ```
/// @allow(E001)
/// function oldAPI() { }
/// ```
export newtype allow = (string,) | ();

/// Warn on some diagnostic.
/// ```
/// @warn(E001)
/// function oldAPI() { }
/// ```
export newtype warn = (string,) | ();

/// Deny some diagnostic with an error.
/// ```
/// @deny(E001)
/// function oldAPI() { }
/// ```
export newtype deny = (string,) | ();

/// Forbid some diagnostic (cannot be allowed later).
/// ```
/// @forbid(E001)
/// function oldAPI() { }
/// ```
export newtype forbid = (string,) | ();

/// Expect some diagnostic.
/// ```
/// @expect(E001)
/// function oldAPI() { }
/// ```
export newtype expect = (string,) | ();

/// Compiler intrinsic marker.
///
/// Marks a declaration as implemented by the compiler.
/// The declaration body (if any) is ignored; the compiler provides the implementation.
///
/// ```
/// @intrinsic
/// declare function typeOf<T>(value: T): Type<T>;
/// ```
export newtype intrinsic = (string,) | ();

/// Compiler language item marker.
///
/// Marks a declaration as a compiler language item.
/// The compiler will look up the symbol during compilation and do something special with it.
///
/// ```
/// @languageItem("Type")
/// declare function typeOf<T>(value: T): Type<T>;
/// ```
export newtype languageItem = (string,) | ();

/// Forbid managed allocations in a function.
///
/// ```
/// @noManaged
/// function processFrame() { }
/// ```
export newtype noManaged = ();

/// Forbid all heap allocations in a function (managed or raw).
///
/// ```
/// @stackOnly
/// function processFrame() { }
/// ```
export newtype stackOnly = ();

/// Inline hint for the optimizer.
///
/// Suggests that this function should be inlined at call sites.
/// The compiler may ignore this hint based on heuristics.
///
/// ```
/// @inline
/// function add(a: int, b: int): int { a + b }
/// ```
export newtype inline = ();

/// No-inline hint for the optimizer.
///
/// Prevents this function from being inlined.
///
/// ```
/// @noinline
/// function complexCalculation() { ... }
/// ```
export newtype noinline = ();

/// Loop unroll hint for the optimizer.
///
/// Suggests that a loop should be unrolled. Can optionally specify
/// the unroll factor.
///
/// ```
/// @unroll
/// for (let i = 0; i < 4; i++) { }
///
/// @unroll(4)
/// for (let i = 0; i < 16; i++) { }
/// ```
export newtype unroll = (int,) | ();

/// Taint a value or expression.
///
/// Taints are used to track usage of certain values, fields, expressions, or other constructs.
///
/// ```
/// @taint("unsafe")
/// function oldAPI() { }
/// ```
export newtype taint = (string,) | ();

/// Tag a value or expression.
///
/// Tags are used for general purpose metadata when more specific decorators are not available.
///
/// ```
/// @tag("user")
/// function oldAPI() { }
/// ```
export newtype tag = (string,) | ();

/// Lifetime annotation for borrow tracking.
///
/// Specifies which values a borrowed reference or containing aggregate may
/// borrow from. Used to resolve ambiguity when conservative inference
/// (borrow from ALL &T params) is too restrictive.
///
/// **On return types:**
/// - `@lifetime("param")` - return borrows from `param`
/// - `@lifetime("a", "b")` - return may borrow from `a` or `b`
/// - `@lifetime("static")` - return borrows from static/global data only
///
/// **On function declarations (shorthand for return type):**
/// - `@lifetime("x") function foo(): &T` is equivalent to `function foo(): @lifetime("x") &T`
///
/// **Inference rules (when no annotation):**
/// - Single `&T` parameter: return borrows from it
/// - `&self` or `&this` method: return borrows from receiver
/// - Multiple `&T` parameters: conservative (borrows from all)
///
/// ```
/// // explicit: return borrows only from 'a'
/// function first(a: &string, b: &string): @lifetime(a) &string {
///     return a;
/// }
///
/// // explicit: return may borrow from either
/// function pick(a: &string, b: &string): @lifetime(a, b) &string {
///     if (cond) { return a; }
///     return b;
/// }
///
/// // static lifetime: string literal lives forever
/// function constant(): @lifetime("static") &string {
///     return &"hello";
/// }
///
/// // struct containing borrowed reference
/// function makeTokenizer(source: &string): @lifetime(source) Tokenizer {
///     return Tokenizer { source, pos: 0 };
/// }
/// ```
///
/// The compiler verifies that the annotated lifetime is valid:
/// returning a value that doesn't actually borrow from the declared
/// parameters is a compile error.
export newtype lifetime = string;
