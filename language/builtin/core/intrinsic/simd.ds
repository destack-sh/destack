// SIMD (Single Instruction, Multiple Data) intrinsics.
//
// Vector operations for parallel processing of multiple values.

import { intrinsic } from "./decorator.ds";

/// Broadcast scalar to all lanes.
///
/// Creates a vector with all lanes set to the same scalar value.
@intrinsic("splat")
export declare function splat<T, N extends int>(value: T): vec<N, T>;

/// Shuffle vector lanes.
///
/// Rearranges elements from two input vectors according to a mask.
/// Each element in the result comes from either `a` or `b` as specified by the mask.
@intrinsic("shuffle")
export declare function shuffle<T, N extends int, M extends int>(
    a: vec<N, T>,
    b: vec<N, T>,
    mask: vec<M, int>
): vec<M, T>;

/// Per-lane conditional select.
///
/// Returns a[i] if mask[i] is true, otherwise b[i], for each lane.
@intrinsic("select")
export declare function select<T, N extends int>(
    mask: vec<N, boolean>,
    a: vec<N, T>,
    b: vec<N, T>
): vec<N, T>;

/// Horizontal reduction: sum all lanes.
@intrinsic("reduce.add")
export declare function reduceAdd<T, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: multiply all lanes.
@intrinsic("reduce.mul")
export declare function reduceMul<T, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: minimum of all lanes.
@intrinsic("reduce.min")
export declare function reduceMin<T, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: maximum of all lanes.
@intrinsic("reduce.max")
export declare function reduceMax<T, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: bitwise AND of all lanes.
@intrinsic("reduce.and")
export declare function reduceAnd<T extends int, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: bitwise OR of all lanes.
@intrinsic("reduce.or")
export declare function reduceOr<T extends int, N extends int>(v: vec<N, T>): T;

/// Horizontal reduction: bitwise XOR of all lanes.
@intrinsic("reduce.xor")
export declare function reduceXor<T extends int, N extends int>(v: vec<N, T>): T;
