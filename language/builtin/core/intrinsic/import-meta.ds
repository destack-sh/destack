/// The target platform (OS) the code is being compiled for.
export type Platform = "web"
    | "windows"
    | "macos"
    | "linux"
    | "ios"
    | "android"
    | "wasi"
    | "universal";;

/// The output format the code is being compiled to.
export type OutputFormat = "js" | "ts" | "wasm" | "native";;

/// The runtime environment that will execute the code.
export type Runtime = "browser"
    | "node"
    | "deno"
    | "bun"
    | "worker"
    | "workerd"
    | "embedded"
    | "wasm-js"
    | "wasm-wasi"
    | "wasm-standalone"
    | "destack";;

/// Environment variables available at compile time.
export interface ImportMetaEnv {
    /// Index signature for arbitrary environment variables.
    readonly [key: string]: string | undefined,
    /// Node environment mode.
    readonly NODE_ENV?: "development" | "production" | "test",
    /// True in development builds.
    readonly DEV: boolean,
    /// True in production builds.
    readonly PROD: boolean,
    /// True in test builds.
    readonly TEST: boolean,
}

/// Metadata about the current module and build configuration.
export interface ImportMeta {
    /// The URL of the current module (file:// for local, https:// for remote).
    readonly url: string,
    /// The file path of the current module (only for local files).
    readonly file: string,
    /// The directory containing the current module.
    readonly dir: string,
    /// The target platform (OS) being compiled for.
    readonly platform: Platform,
    /// The output format being compiled to.
    readonly output: OutputFormat,
    /// The runtime environment that will execute the code.
    readonly runtime: Runtime,
    /// True if this is a debug/development build (from target.debug).
    readonly debug: boolean,
    /// The compiler version.
    readonly version: string,
    /// Environment variables (from build configuration).
    readonly env: ImportMetaEnv,
}