/// Compiler intrinsics - features provided by the compiler.
///
/// These are "magic" features that the compiler knows about and provides
/// specialized implementations for. They cannot be implemented in user code.
///
/// # What's Here
///
/// - **import-meta.ds** - `import.meta` compile-time module information
/// - **decorator.ds** - Compiler-recognized decorator markers (@intrinsic, @inline, etc.)

export * from "./import-meta.ds";
export * from "./decorator.ds";
