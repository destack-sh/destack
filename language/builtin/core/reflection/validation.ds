/// Validation types - results from type validation.
///
/// These types are used by the reflection system to report validation errors.
/// The `@destack-sh/schema` library builds on these to provide `parse()`,
/// `safeParse()`, and other utilities.

// ============================================================================
// VALIDATION RESULT
// ============================================================================

/// Result of validating a value against a type.
///
/// # Example
///
/// ```
/// struct User {
///     name: string.minLength(1),
///     age: int.min(0).max(150),
/// }
///
/// const result = User.validate({ name: "", age: 200 });
/// // => ValidationResult {
/// //      valid: false,
/// //      errors: [
/// //          { path: ["name"], code: "minLength", message: "..." },
/// //          { path: ["age"], code: "max", message: "..." },
/// //      ],
/// //    }
/// ```
struct ValidationResult {
    /// Whether the value is valid.
    valid: boolean,

    /// Validation errors, if any.
    errors: readonly ValidationError[],
}

// ============================================================================
// VALIDATION ERROR
// ============================================================================

/// A single validation error.
struct ValidationError {
    /// Path to the invalid value (e.g., ["user", "address", "zip"]).
    /// Empty for root-level errors.
    path: readonly string[],

    /// Error code (e.g., "min", "maxLength", "required", "type").
    code: string,

    /// Human-readable error message.
    message: string,

    /// Expected type or constraint (for error reporting).
    expected?: string,

    /// Actual value or type received (for error reporting).
    received?: string,
}

// ============================================================================
// ERROR CODES
// ============================================================================

/// Well-known validation error codes.
///
/// These codes are used by the built-in validation and can be used for
/// custom error handling and i18n.
type ValidationErrorCode =
    // Type errors
    | "type"              // Wrong type (expected string, got number)
    | "required"          // Missing required property
    | "unrecognized"      // Unrecognized property (in strict mode)

    // Refinement errors
    | "min"               // Value below minimum
    | "max"               // Value above maximum
    | "minLength"         // String/array too short
    | "maxLength"         // String/array too long
    | "length"            // Wrong exact length
    | "pattern"           // Doesn't match pattern
    | "email"             // Invalid email format
    | "url"               // Invalid URL format
    | "uuid"              // Invalid UUID format

    // Union/enum errors
    | "invalidUnion"      // Doesn't match any union member
    | "invalidEnum"       // Not a valid enum value
    | string              // custom error codes
;

// ============================================================================
// VALIDATION HELPERS
// ============================================================================

/// Create a successful validation result.
function validResult(): ValidationResult {
    ValidationResult { valid: true, errors: [] }
}

/// Create a failed validation result with errors.
function invalidResult(errors: readonly ValidationError[]): ValidationResult {
    ValidationResult { valid: false, errors }
}

/// Create a single validation error.
function validationError(
    path: readonly string[],
    code: string,
    message: string,
): ValidationError {
    ValidationError { path, code, message }
}
