/// Stable unique identifier for a type.
///
/// Format: "module/path:TypeName" (e.g., "myapp/models:User")
newtype TypeId = string;


/// Common interface implemented by all type descriptor variants.
///
/// This enables polymorphic operations on any type descriptor:
/// ```
/// function printType(t: Type<unknown>) {
///     print(t.name);  // works for any Type
/// }
/// ```
newtype interface TypeBase<T> {
    /// The name of this type (e.g., "User", "int", "string[]").
    readonly name: string;

    /// Stable unique identifier for this type.
    readonly id: TypeId;

    /// Type guard - checks if a value is of this type.
    is(input: unknown): boolean;
}

/// Primitive type descriptor (string, int, float, boolean, null).
struct PrimitiveType<T> implements TypeBase<T> {
    kind: "primitive" = "primitive",
    name: string,
    id: TypeId,

    /// The specific primitive kind.
    primitive: PrimitiveKind,
}

/// The specific kind of primitive type.
type PrimitiveKind =
    | "string"
    | "boolean"
    | "null"
    | "undefined"
    | "int8" | "int16" | "int32" | "int64" | "int128"
    | "uint8" | "uint16" | "uint32" | "uint64" | "uint128"
    | "float32" | "float64"
    | "bigint"
;

/// Struct type descriptor.
struct StructType<T> implements TypeBase<T> {
    kind: "struct" = "struct",
    name: string,
    id: TypeId,

    /// Properties of this struct.
    properties: readonly Property[],

    /// Decorators on the struct declaration.
    decorators: readonly DecoratorInfo[],

    /// Documentation comment, if present.
    description?: string,
}

/// Class type descriptor.
struct ClassType<T> implements TypeBase<T> {
    kind: "class" = "class",
    name: string,
    id: TypeId,

    /// Properties of this class (instance fields).
    properties: readonly Property[],

    /// Parent class, if any.
    extends?: Type<unknown>,

    /// Implemented interfaces.
    implements: readonly Type<unknown>[],

    /// Decorators on the class declaration.
    decorators: readonly DecoratorInfo[],

    /// Documentation comment, if present.
    description?: string,
}

/// Enum type descriptor.
struct EnumType<T> implements TypeBase<T> {
    kind: "enum" = "enum",
    name: string,
    id: TypeId,

    /// Variants of this enum.
    variants: readonly Variant[],

    /// Decorators on the enum declaration.
    decorators: readonly DecoratorInfo[],

    /// Documentation comment, if present.
    description?: string,
}

/// Interface type descriptor.
struct InterfaceType<T> implements TypeBase<T> {
    kind: "interface" = "interface",
    name: string,
    id: TypeId,

    /// Whether this is a nominal interface (newtype interface).
    nominal: boolean,

    /// Properties defined in this interface.
    properties: readonly Property[],

    /// Extended interfaces.
    extends: readonly Type<unknown>[],

    /// Documentation comment, if present.
    description?: string,
}

/// Newtype type descriptor (nominal wrapper around another type).
struct NewtypeType<T> implements TypeBase<T> {
    kind: "newtype" = "newtype",
    name: string,
    id: TypeId,

    /// The underlying type being wrapped.
    underlying: Type<unknown>,

    /// Decorators on the newtype declaration.
    decorators: readonly DecoratorInfo[],

    /// Documentation comment, if present.
    description?: string,
}

/// Array type descriptor.
struct ArrayType<T> implements TypeBase<T> {
    kind: "array" = "array",
    name: string,
    id: TypeId,

    /// The element type.
    element: Type<unknown>,

    /// Fixed length, if this is a fixed-size array (e.g., `int[10]`).
    length?: int,
}

/// Tuple type descriptor.
struct TupleType<T> implements TypeBase<T> {
    kind: "tuple" = "tuple",
    name: string,
    id: TypeId,

    /// Element types, in order.
    elements: readonly Type<unknown>[],

    /// Element names, if this is a named tuple.
    names?: readonly string[],
}

/// Union type descriptor.
struct UnionType<T> implements TypeBase<T> {
    kind: "union" = "union",
    name: string,
    id: TypeId,

    /// Member types of the union.
    members: readonly Type<unknown>[],
}

/// Intersection type descriptor.
struct IntersectionType<T> implements TypeBase<T> {
    kind: "intersection" = "intersection",
    name: string,
    id: TypeId,

    /// Member types of the intersection.
    members: readonly Type<unknown>[],
}

/// Function type descriptor.
struct FunctionType<T> implements TypeBase<T> {
    kind: "function" = "function",
    name: string,
    id: TypeId,

    /// Parameter types.
    parameters: readonly Parameter[],

    /// Return type.
    returnType: Type<unknown>,

    /// Whether this function is async.
    isAsync: boolean,

    /// Whether this function is a generator.
    isGenerator: boolean,
}

/// A function parameter.
struct Parameter {
    name: string,
    type: Type<unknown>,
    optional: boolean,
    rest: boolean,
}

/// Object type descriptor (anonymous structural type `{ x: T, y: U }`).
struct ObjectType<T> implements TypeBase<T> {
    kind: "object" = "object",
    name: string,
    id: TypeId,

    /// Properties of this object type.
    properties: readonly Property[],
}

/// Refined type descriptor (a type with additional constraints).
struct RefinedType<T> implements TypeBase<T> {
    kind: "refined" = "refined",
    name: string,
    id: TypeId,

    /// The base type being refined.
    base: Type<unknown>,

    /// Refinements (constraints) on this type.
    refinements: readonly Refinement[],
}

/// A type descriptor - the union of all type variants.
///
/// This is the primary type for working with runtime type information.
/// All variants implement `TypeBase<T>`, so common operations like
/// `.name`, `.id`, `.is()`, and `.validate()` work on any `Type<T>`.
///
/// # Example
///
/// ```
/// struct User { name: string, age: int }
///
/// // Type<User> is actually StructType<User>
/// match (User) {
///     StructType { properties } => {
///         for (const prop of properties) {
///             print(`${prop.name}: ${prop.type.name}`);
///         }
///     }
///     _ => {}
/// }
/// ```
newtype Type<T> =
    | PrimitiveType<T>
    | StructType<T>
    | ClassType<T>
    | EnumType<T>
    | InterfaceType<T>
    | NewtypeType<T>
    | ArrayType<T>
    | TupleType<T>
    | UnionType<T>
    | IntersectionType<T>
    | FunctionType<T>
    | ObjectType<T>
    | RefinedType<T>
;

/// Get the type descriptor for a value.
///
/// Unlike JavaScript's `typeof` (which returns a coarse string like "object"),
/// this returns the full `Type<T>` descriptor.
///
/// ```
/// const user = User { name: "Alice", age: 30 };
/// const t = typeOf(user);  // Type<User>
/// t.name                   // "User"
/// t.kind                   // "struct"
/// ```
@intrinsic
declare function typeOf<T>(value: T): Type<T>;
