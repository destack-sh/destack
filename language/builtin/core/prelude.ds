// @destack/core/prelude - Auto-imported symbols
//
// This module defines what gets automatically imported into every Destack file.
// It re-exports the most fundamental types and traits from core/.

// reflection
export { Type, typeOf } from "./reflect/type.ds";

// control flow
export { Try } from "./control/try.ds";
export { Error } from "./control/error.ds";
export { Ok, Err, Result, AsyncResult } from "./control/result.ds";
export {
    Bound,
    RangeBounds,
    Range,
    RangeInclusive,
    RangeFrom,
    RangeTo,
    RangeToInclusive,
    RangeFull,
} from "./control/range.ds";

// decorator metadata (reflection)
export { DecoratorInfo } from "./reflect/decorator.ds";

// decorator markers (intrinsics)
export {
    deprecated,
    experimental,
    allow,
    warn,
    deny,
    forbid,
    expect,
    intrinsic,
    inline,
    noinline,
    unroll,
    taint,
    tag,
} from "./intrinsic/decorator.ds";

// arithmetic operators
export {
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Power,
    Plus,
    Negate,
    And,
    Or,
    Xor,
    Not,
    ShiftLeft,
    ShiftRight,
    ShiftRightUnsigned,
    Concatenate,
} from "./operator/arithmetic.ds";

// comparison operators
export { Equal, PartialEqual, Compare, PartialCompare, Ordering } from "./operator/comparison.ds";

// formatting operators
export { Display, Debug } from "./operator/format.ds";

// subscript operators
export { Index, IndexSet, Deref, DerefSet } from "./operator/subscript.ds";
