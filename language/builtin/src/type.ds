// Destack Type Reflection Built-ins
// NOTE #Incomplete: built-in types are just a placeholder for now
// These types are implicitly available when Reflection feature is enabled.

/// Get the type descriptor for a value.
/// Unlike JavaScript's `typeof` (which returns a string), this returns `Type<T>`.
declare function typeOf<T>(value: T): Type<T>;

/// The kind of a type descriptor.
type TypeKind =
    "primitive" | "struct" | "class" | "enum" | "interface" | "function" | "union" | "intersection" | "tuple" | "array" | "object" | "newtype"
;

/// A field descriptor for struct/class/interface types.
interface Field {
    readonly name: string,
    readonly type: Type<unknown>,
    readonly optional: boolean,
    readonly readonly: boolean,
}

/// A method descriptor for struct/class/interface types.
interface Method {
    readonly name: string,
    readonly type: Type<Function>,
    readonly static: boolean,
}

/// A variant descriptor for enum types.
interface Variant {
    readonly name: string,
    readonly value: unknown,
}

/// Type descriptor - runtime representation of a type.
/// Available when Reflection feature is enabled.
interface Type<T> {
    /// The name of the type.
    readonly name: string,
    /// The kind of type.
    readonly kind: TypeKind,
    /// Fields for struct/class/interface types.
    readonly fields?: readonly Field[],
    /// Methods for struct/class/interface types.
    readonly methods?: readonly Method[],
    /// Variants for enum types.
    readonly variants?: readonly Variant[],
    /// Element type for array types.
    readonly element?: Type<unknown>,
    /// Element types for tuple types.
    readonly elements?: readonly Type<unknown>[],
    /// Parameter types for function types.
    readonly parameters?: readonly Type<unknown>[],
    /// Return type for function types.
    readonly returnType?: Type<unknown>,
    /// Whether function is async.
    readonly isAsync?: boolean,
    /// Whether function is a generator.
    readonly isGenerator?: boolean,
    /// Create an instance of this type (for constructable types).
    create(...args: unknown[]): T
    /// Check if a value is of this type.
    is(value: unknown): value is T
}

/// Decorator metadata attached to a declaration.
interface DecoratorInfo {
    readonly name: string,
    readonly args: readonly unknown[],
}

