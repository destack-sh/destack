// === Signed Integers ===

/// 8-bit signed integer (-128 to 127).
declare type int8;

/// 16-bit signed integer (-32,768 to 32,767).
declare type int16;

/// 32-bit signed integer (-2^31 to 2^31-1).
declare type int32;

/// 64-bit signed integer (-2^63 to 2^63-1).
declare type int64;

/// 128-bit signed integer.
declare type int128;

/// Alias for int64.
declare type int;

// === Unsigned Integers ===

/// 8-bit unsigned integer (0 to 255).
declare type uint8;

/// 16-bit unsigned integer (0 to 65,535).
declare type uint16;

/// 32-bit unsigned integer (0 to 2^32-1).
declare type uint32;

/// 64-bit unsigned integer (0 to 2^64-1).
declare type uint64;

/// 128-bit unsigned integer.
declare type uint128;

/// Alias for uint64.
declare type uint;

// === Floating Point ===

/// 32-bit floating point (IEEE 754 single precision).
declare type float32;

/// 64-bit floating point (IEEE 754 double precision).
declare type float64;

/// Alias for float64.
declare type float;

// === Character ===

/// Single Unicode codepoint.
declare type character;

// === Pointer Types (for WASM/Native targets) ===

/// Size type for memory operations (platform-dependent).
declare type usize;

/// Signed size type (platform-dependent).
declare type isize;
