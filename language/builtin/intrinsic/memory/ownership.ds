/// Mark a type as copyable without ownership transfer.
export newtype interface Copy {}

/// Clone the value into a new owned value.
export interface Clone {}

/// Mark a type as safe to send across threads.
export newtype interface Send {}

/// Mark a type as safe to share across threads.
export newtype interface Sync {}

/// Region marker for borrowed validity.
///
/// `Region` is a compiler known static parameter kind.
/// It is not a runtime value type and has no interface behavior.
export newtype Region = unknown;

/// Borrowed value of `T` within region `R`.
export newtype interface Borrowed<R, T> {}

/// Owned value of `T`.
export newtype interface Owned<T> {}

/// Located value `T` in space `S`.
export newtype interface Space<S, T> {}

/// Shared value `T` (located in the shared space).
export type Shared<T> = Space<"shared", T>;
