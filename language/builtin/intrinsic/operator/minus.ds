/// Interface for the `-` operator.
///
/// `a - b` becomes `a.subtract(b)`.
export newtype interface Subtract<T = this> {
    /// The result type.
    type Output;

    /// Subtract `other` from this value.
    subtract(other: T): this.Output;
}

/// Interface for unary `-`.
///
/// `-a` becomes `a.negate()`.
export newtype interface Negate {
    /// The result type.
    type Output;

    /// Negate this value.
    negate(): this.Output;
}
