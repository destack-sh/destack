/// Successful `Try` branch.
export type TryContinue<T> = { kind: "continue"; value: T };

/// Failed `Try` branch.
export type TryFailure<E> = { kind: "failure"; error: E };

/// Branch result for the `?` and `??` operators.
export type TryBranch<T, E> = TryContinue<T> | TryFailure<E>;

/// Source protocol for values that can be unwrapped or propagated with `?`.
export newtype interface Try {
    /// The value produced when evaluation continues.
    type Value;

    /// The value produced when evaluation fails.
    type Error;

    /// Branch into success or failure control flow.
    branch(): TryBranch<this.Value, this.Error>;
}

/// Target protocol for rebuilding a return type from a propagated failure.
export newtype interface FromFailure<E> {
    /// Construct this type from a failure value.
    static fromFailure(error: E): this;
}
