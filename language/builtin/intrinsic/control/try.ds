/// Interface for the `?` and `??` operators.
///
/// Types implementing `Try` support both error propagation (`?`) and
/// default values (`??`).
///
/// The `Try` protocol is structural at the branch level.
/// Implementations must return a `TryBranch<T, E>` shape from `branch()`.
///
/// ## The `?` Operator (propagate)
///
/// `x?` extracts the success value or returns early with the error:
/// ```
/// match (x.branch()) {
///     { kind: "ok", value } => value
///     { kind: "err", error } => return fromError(error)
/// }
/// ```
///
/// ## The `??` Operator (default)
///
/// `x ?? default` extracts the success value or uses the default:
/// ```
/// match (x.branch()) {
///     { kind: "ok", value } => value
///     { kind: "err", error: _ } => default
/// }
/// ```
///
/// This means `??` on `Result<T, E>` works like `unwrapOr`:
/// ```
/// const config = loadConfig() ?? defaultConfig;
/// ```
///
/// For nullable types (`T | null`), `??` behaves exactly like TypeScript's
/// nullish coalescing operator.
///
/// ## Example
///
/// ```
/// function divide(a: int, b: int): Result<int, string> {
///     if (b == 0) {
///         Result.err("division by zero")
///     } else {
///         Result.ok(a / b)
///     }
/// }
///
/// function calculate(): Result<int, string> {
///     const x = divide(10, 2)?;  // x = 5, or returns early on error
///     const y = divide(x, 0)?;   // returns Err("division by zero")
///     Result.ok(y)
/// }
///
/// // Using ?? for defaults
/// const result = divide(10, 0) ?? 0;  // result = 0
/// ```

/// Try branch result for the `?` and `??` operators.
///
/// Implementations may return this shape directly or any compatible union.
export type TryBranch<T, E> = { kind: "ok"; value: T } | { kind: "err"; error: E };

export newtype interface Try<T, E> {
    /// Branch on success or failure.
    /// Returns a TryBranch value to continue or break.
    branch(): TryBranch<T, E>;

    /// Construct the implementing type from an error (for early return with `?`).
    static fromError(error: E): this;
}
