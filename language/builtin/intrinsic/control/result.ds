/// Result type for recoverable error handling.
///
/// `Result<T, E>` is the standard way to handle recoverable errors in Destack.
/// Use `Result.ok(value)` for success and `Result.err(error)` for failure.
///
/// # Example
///
/// ```
/// function divide(a: int, b: int): Result<int, string> {
///     if (b == 0) {
///         Result.err("division by zero")
///     } else {
///         Result.ok(a / b)
///     }
/// }
///
/// // Pattern matching
/// match (divide(10, 2)) {
///     Ok { value } => print(`result: ${value}`)
///     Err { error } => print(`error: ${error}`)
/// }
///
/// // With ? operator
/// function calculate(): Result<int, string> {
///     const x = divide(10, 2)?;  // propagates error if Err
///     const y = divide(x, 2)?;
///     Result.ok(y)
/// }
/// ```
import { type FromFailure, type Try, type TryBranch } from "./try.ds";
import { type Equal } from "../operator/comparison.ds";
import { type Display, type Debug } from "../operator/format.ds";

/// Success variant of Result.
export struct Ok<T> {
    kind: "Ok" = "Ok";
    value: T;
}

/// Error variant of Result.
export struct Err<E> {
    kind: "Err" = "Err";
    error: E;
}

/// A type that represents either success (`Ok`) or failure (`Err`).
///
/// Result is the idiomatic way to handle recoverable errors in Destack.
/// Unlike exceptions, errors are explicit in the type system.
export newtype Result<T, E> = Ok<T> | Err<E>;

/// Extension methods for Result.
extension<T, E> of Result<T, E> {
    /// Create a success result.
    static ok(value: T): Result<T, E> {
        Result(Ok { kind: "Ok", value });
    }

    /// Create an error result.
    static err(error: E): Result<T, E> {
        Result(Err { kind: "Err", error });
    }

    /// Returns true if this is Ok.
    isOk(): boolean {
        this.kind == "Ok";
    }

    /// Returns true if this is Err.
    isErr(): boolean {
        this.kind == "Err";
    }

    /// Returns the contained Ok value, or panics if Err.
    ///
    /// Use only when you're certain the result is Ok, or for prototyping.
    /// Prefer pattern matching or `unwrapOr` in production code.
    unwrap(): T {
        match (this) {
            Ok { value } => value
            Err { error } => throw `called unwrap() on Err: ${error}`
        }
    }

    /// Returns the contained Ok value, or a default.
    unwrapOr(default: T): T {
        match (this) {
            Ok { value } => value
            Err { error: _ } => default
        }
    }

    /// Returns the contained Ok value, or computes it from the error.
    unwrapOrElse(f: (E) => T): T {
        match (this) {
            Ok { value } => value
            Err { error } => f(error)
        }
    }

    /// Returns the contained Err value, or panics if Ok.
    unwrapErr(): E {
        match (this) {
            Ok { value } => throw `called unwrapErr() on Ok: ${value}`
            Err { error } => error
        }
    }

    /// Maps a `Result<T, E>` to `Result<U, E>` by applying a function to the Ok value.
    map<U>(f: (T) => U): Result<U, E> {
        match (this) {
            Ok { value } => Result.ok(f(value))
            Err { error } => Result.err(error)
        }
    }

    /// Maps a `Result<T, E>` to `Result<T, F>` by applying a function to the Err value.
    mapErr<F>(f: (E) => F): Result<T, F> {
        match (this) {
            Ok { value } => Result.ok(value)
            Err { error } => Result.err(f(error))
        }
    }

    /// Chains another Result-returning operation.
    ///
    /// If this is Ok, applies `f` to the value and returns the result.
    /// If this is Err, returns the Err unchanged.
    andThen<U>(f: (T) => Result<U, E>): Result<U, E> {
        match (this) {
            Ok { value } => f(value)
            Err { error } => Result.err(error)
        }
    }

    /// Returns this result if Ok, otherwise calls `f` with the error.
    orElse<F>(f: (E) => Result<T, F>): Result<T, F> {
        match (this) {
            Ok { value } => Result.ok(value)
            Err { error } => f(error)
        }
    }

    /// Returns the Ok value if both are Ok, otherwise returns the first Err.
    and<U>(other: Result<U, E>): Result<U, E> {
        match (this) {
            Ok { value: _ } => other
            Err { error } => Result.err(error)
        }
    }

    /// Returns the first Ok, or if both are Err, returns the second Err.
    or(other: Result<T, E>): Result<T, E> {
        match (this) {
            Ok { value } => Result.ok(value)
            Err { error: _ } => other
        }
    }

    /// Transposes a `Result<T | null, E>` into `Result<T, E> | null`.
    ///
    /// - `Ok { value: null }` becomes `null`
    /// - `Ok { value }` becomes `Ok { value }`
    /// - `Err { error }` stays `Err { error }`
    transpose(): Result<T, E> | null {
        match (this) {
            Ok { value: null } => null
            Ok { value } => Result.ok(value)
            Err { error } => Result.err(error)
        }
    }
}

/// Result implements Try for the ? and ?? operators.
extension<T, E> of Result<T, E> implements Try {
    /// The successful result value.
    type Value = T;

    /// The failed result value.
    type Error = E;

    /// Branch on Ok or Err.
    branch(): TryBranch<T, E> {
        match (this) {
            Ok { value } => ({ kind: "continue", value })
            Err { error } => ({ kind: "failure", error })
        }
    }
}

/// Result can be rebuilt from a propagated failure.
extension<T, E> of Result<T, E> implements FromFailure<E> {
    /// Construct a Result from a failure.
    static fromFailure(error: E): Result<T, E> {
        Result.err(error);
    }
}

/// Result equality when both T and E implement Equal.
extension<T: Equal<T>, E: Equal<E>> of Result<T, E> implements Equal<Result<T, E>> {
    equal(other: Result<T, E>): boolean {
        match (this) {
            Ok { value: a } => {
                match (other) {
                    Ok { value: b } => a.equal(b)
                    Err { error: _ } => false
                }
            }
            Err { error: a } => {
                match (other) {
                    Err { error: b } => a.equal(b)
                    Ok { value: _ } => false
                }
            }
        }
    }
}

/// Async result type for recoverable errors in async contexts.
///
/// `AsyncResult<T, E>` wraps `Promise<Result<T, E>>` with ergonomic methods.
/// Unlike raw Promises, errors are typed and explicit.
///
/// # Key Principle
///
/// **AsyncResult never rejects.** Promise rejection is reserved for panics
/// (bugs, invariant violations). All recoverable errors go through Result.
///
/// # Using with ?
///
/// Since `AsyncResult<T, E>` is a newtype over `Promise<Result<T, E>>`,
/// you await it to get a `Result`, then use `?` to propagate:
///
/// ```
/// async function fetchUser(id: string): AsyncResult<User, ApiError> {
///     const response = (await fetchJson(`/users/${id}`))?;  // await then ?
///     const user = User.parse(response)?;                    // sync ?
///     Result.ok(user)
/// }
/// ```
///
/// Alternatively, use `await?` as syntactic sugar for `(await expr)?`:
///
/// ```
/// async function fetchUser(id: string): AsyncResult<User, ApiError> {
///     const response = await? fetchJson(`/users/${id}`);  // combined!
///     const user = User.parse(response)?;
///     Result.ok(user)
/// }
/// ```
export newtype AsyncResult<T, E> = Promise<Result<T, E>>;

/// Extension methods for AsyncResult.
extension<T, E> of AsyncResult<T, E> {
    /// Create a successful async result.
    static ok(value: T): AsyncResult<T, E> {
        AsyncResult(Promise.resolve(Result.ok(value)));
    }

    /// Create a failed async result.
    static err(error: E): AsyncResult<T, E> {
        AsyncResult(Promise.resolve(Result.err(error)));
    }

    /// Wrap a Result as an AsyncResult.
    static from(result: Result<T, E>): AsyncResult<T, E> {
        AsyncResult(Promise.resolve(result));
    }

    /// Wrap a Promise<T> that might reject into AsyncResult<T, unknown>.
    ///
    /// Catches any rejection and converts it to an Err.
    static fromPromise<T2>(promise: Promise<T2>): AsyncResult<T2, unknown> {
        AsyncResult(
            promise.then((value) => Result.ok(value))["catch"]((error) => Result.err(error)),
        );
    }

    /// Run an async function and catch any thrown errors.
    ///
    /// ```
    /// const result = await AsyncResult.try(async () => {
    ///     const response = await fetch(url);
    ///     return response.json();
    /// });
    /// ```
    static try<T2>(f: () => Promise<T2>): AsyncResult<T2, unknown> {
        AsyncResult.fromPromise(f());
    }

    /// Maps the success value.
    map<U>(f: (T) => U): AsyncResult<U, E> {
        AsyncResult(this.then((result) => result.map(f)));
    }

    /// Maps the error value.
    mapErr<F>(f: (E) => F): AsyncResult<T, F> {
        AsyncResult(this.then((result) => result.mapErr(f)));
    }

    /// Chains another async Result-returning operation.
    ///
    /// If this succeeds, applies `f` to the value and returns its result.
    /// If this fails, returns the error unchanged.
    andThen<U>(f: (T) => AsyncResult<U, E>): AsyncResult<U, E> {
        AsyncResult(
            this.then(async (result) => {
                match (result) {
                    Ok { value } => await f(value)
                    Err { error } => Result.err(error)
                }
            }),
        );
    }

    /// Like andThen but for sync functions returning Result.
    andThenSync<U>(f: (T) => Result<U, E>): AsyncResult<U, E> {
        AsyncResult(this.then((result) => result.andThen(f)));
    }

    /// Returns this if Ok, otherwise calls f with the error.
    orElse<F>(f: (E) => AsyncResult<T, F>): AsyncResult<T, F> {
        AsyncResult(
            this.then(async (result) => {
                match (result) {
                    Ok { value } => Result.ok(value)
                    Err { error } => await f(error)
                }
            }),
        );
    }

    /// Returns the Ok value, or panics if Err.
    async unwrap(): Promise<T> {
        const result = await this;
        result.unwrap();
    }

    /// Returns the Ok value, or a default if Err.
    async unwrapOr(default: T): Promise<T> {
        const result = await this;
        result.unwrapOr(default);
    }

    /// Returns the Ok value, or computes it from the error.
    async unwrapOrElse(f: (E) => T): Promise<T> {
        const result = await this;
        result.unwrapOrElse(f);
    }

    /// Returns true if this is Ok.
    async isOk(): Promise<boolean> {
        const result = await this;
        result.isOk();
    }

    /// Returns true if this is Err.
    async isErr(): Promise<boolean> {
        const result = await this;
        result.isErr();
    }

    /// Wait for all AsyncResults, returning first error or all successes.
    ///
    /// ```
    /// const results = await AsyncResult.all([
    ///     fetchUser("1"),
    ///     fetchUser("2"),
    ///     fetchUser("3"),
    /// ]);
    /// // Result<User[], ApiError>
    /// ```
    static all<T2, E2>(results: AsyncResult<T2, E2>[]): AsyncResult<T2[], E2> {
        AsyncResult(
            Promise.all(results).then((resultArray) => {
                const values: T2[] = [];
                for (const result of resultArray) {
                    match (result) {
                        Ok { value } => values.push(value)
                        Err { error } => return Result.err(error)
                    }
                }
                Result.ok(values);
            }),
        );
    }

    /// Race all AsyncResults, returning first to complete (success or error).
    static race<T2, E2>(results: AsyncResult<T2, E2>[]): AsyncResult<T2, E2> {
        AsyncResult(Promise.race(results));
    }

    /// Run all AsyncResults, collecting all results (both Ok and Err).
    ///
    /// Unlike `all`, this doesn't short-circuit on error.
    static allSettled<T2, E2>(results: AsyncResult<T2, E2>[]): AsyncResult<
        Result<T2, E2>[],
        never
    > {
        AsyncResult(Promise.all(results).then((resultArray) => Result.ok(resultArray)));
    }
}
