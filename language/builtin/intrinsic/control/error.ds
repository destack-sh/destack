/// Marker interface for error values.
///
/// Implement this to signal that a type is intended for error reporting.
/// Most code should use Result<T, E> with E: Error.
export newtype interface Error {
    /// Human readable error message.
    message: string;

    /// Optional cause for chained errors.
    cause?: Error;

    /// Optional stack trace or debugging detail.
    stack?: string;
}
