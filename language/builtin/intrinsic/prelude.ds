// reflection
export * from "./reflect/index.ds";

// ownership
export {
    type Region,
    type Space,
    type Place,
    type Ownership,
    type Form,
    type Managed,
    type Borrowed,
    type Raw,
    type Owned,
    type Shared,
    type BaseOf,
    type OwnershipOf,
    type PlaceOf,
    type SpaceOf,
    type RegionOf,
    type OwnershipOr,
    type PlaceOr,
    type SpaceOr,
    type PlaceIn,
    type IsManaged,
    type IsOwned,
    type IsBorrowed,
    type IsRaw,
    type IsShared,
    type IsSharedIn,
    type WithBase,
    type WithOwnership,
    type WithPlace,
    type WithSpace,
    type WithRegion,
    type AsManaged,
    type AsOwned,
    type AsBorrowed,
    type AsRaw,
    type Bytes,
    type Buffer,
    type Copy,
    type Clone,
    type Dispose,
    type AsyncDispose,
    type Send,
    type Sync,
} from "./memory/index.ds";

// control flow
export {
    type Try,
    type FromFailure,
    type TryBranch,
    type TryContinue,
    type TryFailure,
} from "./control/try.ds";
export { type Error } from "./control/error.ds";
export {
    type Promise,
    type PromiseConstructor,
    Promise,
    Ok,
    Err,
    Result,
    AsyncResult,
} from "./control/result.ds";
export {
    type SymbolConstructor,
    Symbol,
    type IteratorYieldResult,
    type IteratorReturnResult,
    type IteratorResult,
    type Iterator,
    type Iterable,
    type IterableIterator,
} from "./control/iterable.ds";

// simd
export {
    Vector,
    splat,
    shuffle,
    select,
    reduceAdd,
    reduceMul,
    reduceMin,
    reduceMax,
    reduceAnd,
    reduceOr,
    reduceXor,
} from "./primitive/vector.ds";

// decorator markers (intrinsics)
export {
    deprecated,
    experimental,
    allow,
    warn,
    deny,
    forbid,
    expect,
    extern,
    intrinsic,
    languageItem,
    noManaged,
    stackOnly,
    capture,
    type CaptureKind,
    type CapturePolicy,
    type CaptureDirective,
    inline,
    noinline,
    unroll,
    hot,
    cold,
    likely,
    unlikely,
    mustUse,
    pure,
    tailcall,
    unsafe,
    transmute,
    taint,
    sink,
    sanitizer,
    tag,
    lifetime,
    space,
} from "./primitive/decorator.ds";

// binding decorators (intrinsics)
export {
    binding,
    require,
    type BindingOptions,
    type PlatformCapability,
} from "./primitive/binding.ds";

// operator interfaces
export { type Add, type Plus } from "./operator/plus.ds";
export { type Subtract } from "./operator/minus.ds";
export { type Negate } from "./operator/negate.ds";
export { type Multiply } from "./operator/multiply.ds";
export { type Divide } from "./operator/divide.ds";
export { type Remainder } from "./operator/remainder.ds";
export { type Power } from "./operator/power.ds";
export { type And, type Or, type Xor, type Not } from "./operator/bitwise.ds";
export {
    type ShiftLeft,
    type ShiftRight,
    type ShiftRightUnsigned,
} from "./operator/shift.ds";

// equality and comparison operators
export { type Equal, type PartialEqual } from "./operator/equality.ds";
export {
    type Compare,
    type PartialCompare,
    Ordering,
} from "./operator/comparison.ds";

// formatting
export { type Display, type Debug } from "./operator/format.ds";

// subscript operators
export { type Index, type IndexSet } from "./operator/subscript.ds";
export { type ReadonlyDereference, type Dereference } from "./operator/dereference.ds";
