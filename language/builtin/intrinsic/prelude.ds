// reflection
export { Type, typeOf } from "./reflect/type.ds";

// ownership
export {
    type Region,
    type Borrowed,
    type Owned,
    type Shared,
    type Space,
    type Bytes,
    type Buffer,
    type Copy,
    type Clone,
    type Dispose,
    type AsyncDispose,
    type Send,
    type Sync,
} from "./memory/index.ds";

// control flow
export { type Try, type TryBranch } from "./control/try.ds";
export { type Error } from "./control/error.ds";
export {
    type Promise,
    type PromiseConstructor,
    Promise,
    Ok,
    Err,
    Result,
    AsyncResult,
} from "./control/result.ds";
export {
    type SymbolConstructor,
    Symbol,
    type IteratorYieldResult,
    type IteratorReturnResult,
    type IteratorResult,
    type Iterator,
    type Iterable,
    type IterableIterator,
} from "./control/iterable.ds";

// simd
export {
    Vector,
    splat,
    shuffle,
    select,
    reduceAdd,
    reduceMul,
    reduceMin,
    reduceMax,
    reduceAnd,
    reduceOr,
    reduceXor,
} from "./primitive/vector.ds";

// decorator metadata (reflection)
export { DecoratorInfo } from "./reflect/decorator.ds";

// decorator markers (intrinsics)
export {
    deprecated,
    experimental,
    allow,
    warn,
    deny,
    forbid,
    expect,
    extern,
    intrinsic,
    languageItem,
    noManaged,
    stackOnly,
    capture,
    type CaptureKind,
    type CapturePolicy,
    type CaptureDirective,
    inline,
    noinline,
    unroll,
    hot,
    cold,
    likely,
    unlikely,
    mustUse,
    pure,
    tailcall,
    unsafe,
    transmute,
    taint,
    sink,
    sanitizer,
    tag,
    lifetime,
    space,
} from "./primitive/decorator.ds";

// binding decorators (intrinsics)
export {
    binding,
    require,
    type BindingOptions,
    type PlatformCapability,
} from "./primitive/binding.ds";

// arithmetic operators
export {
    type Add,
    type Subtract,
    type Multiply,
    type Divide,
    type Remainder,
    type Power,
    type Plus,
    type Negate,
    type And,
    type Or,
    type Xor,
    type Not,
    type ShiftLeft,
    type ShiftRight,
    type ShiftRightUnsigned,
    type Concatenate,
} from "./operator/arithmetic.ds";

// comparison operators
export {
    type Equal,
    type PartialEqual,
    type Compare,
    type PartialCompare,
    Ordering,
} from "./operator/comparison.ds";

// formatting operators
export { type Display, type Debug } from "./operator/format.ds";

// subscript operators
export { type Index, type IndexSet, type Deref, type DerefSet } from "./operator/subscript.ds";
