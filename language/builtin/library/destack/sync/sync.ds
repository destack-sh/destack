import {
    AtomicScope,
    MemoryOrdering,
    MemoryRegionSet,
    MemoryScope,
    atomicCas,
    atomicCasWeak,
    atomicExchange,
    atomicFence,
    atomicFetchAdd,
    atomicFetchAnd,
    atomicFetchFadd,
    atomicFetchFmax,
    atomicFetchFmin,
    atomicFetchMax,
    atomicFetchMin,
    atomicFetchOr,
    atomicFetchSub,
    atomicFetchUmax,
    atomicFetchUmin,
    atomicFetchXor,
    atomicLoad,
    atomicStore,
} from "native";
import * as platform from "library/platform/index.ds";
import type { PlatformError } from "../error/index.ds";

export {
    AtomicScope,
    MemoryOrdering,
    MemoryRegionSet,
    MemoryScope,
    atomicCas,
    atomicCasWeak,
    atomicExchange,
    atomicFence,
    atomicFetchAdd,
    atomicFetchAnd,
    atomicFetchFadd,
    atomicFetchFmax,
    atomicFetchFmin,
    atomicFetchMax,
    atomicFetchMin,
    atomicFetchOr,
    atomicFetchSub,
    atomicFetchUmax,
    atomicFetchUmin,
    atomicFetchXor,
    atomicLoad,
    atomicStore,
};

/// Userland synchronization substrate.
export namespace sync {
    /// Wait while one 32 bit word still matches the expected value.
    export function addressWait(
        address: uint64,
        expected: uint32,
        timeoutNs: uint64,
    ): Result<void, PlatformError> {
        platform.thread.addressWait(address, expected, timeoutNs);
    }

    /// Wake one waiter blocked on one 32 bit word address.
    export function addressWakeOne(address: uint64): Result<void, PlatformError> {
        platform.thread.addressWakeOne(address);
    }

    /// Wake all waiters blocked on one 32 bit word address.
    export function addressWakeAll(address: uint64): Result<void, PlatformError> {
        platform.thread.addressWakeAll(address);
    }
}
