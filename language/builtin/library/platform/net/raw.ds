import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { SocketFamily } from "./address.ds";
import { SocketHandle } from "../resource/index.ds";

/// Packet timestamp mode.
export enum PacketTimestampMode {
    /// Disable packet timestamps.
    Disabled = 0,
    /// Enable software timestamps.
    Software = 1,
    /// Enable hardware timestamps when available.
    Hardware = 2,
}

/// Packet timestamp clock domain.
export enum PacketTimestampClock {
    /// No packet timestamp is present.
    None = 0,
    /// Timestamp is in the host wall-clock domain.
    Wall = 1,
    /// Timestamp is in the host monotonic clock domain.
    Monotonic = 2,
    /// Timestamp is in one backend-specific hardware clock domain.
    HardwareRaw = 3,
}

/// Packet backend selector.
export enum PacketBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// Linux AF_PACKET backend.
    AfPacket = 1,
    /// BSD BPF device backend.
    Bpf = 2,
    /// Windows raw-socket backend.
    WinRawSocket = 3,
    /// Null backend for tests and simulation.
    Null = 255,
}

/// Packet backend selection policy.
export enum PacketBackendSelectionPolicy {
    /// Require that the requested backend is used with no fallback.
    Strict = 1,
    /// Allow fallback to one host-default backend when unavailable.
    AllowFallback = 2,
}

/// Packet backend capability flags.
export newtype PacketBackendCapabilityFlags = uint64;

/// Packet backend descriptor.
export struct PacketBackendDescriptor {
    /// Backend selector.
    backend: PacketBackend;
    /// Stable backend name.
    name: string;
    /// Whether this backend is currently available on this host.
    available: boolean;
    /// Priority in default auto-selection order.
    priority: uint16;
    /// Backend capability flags.
    capabilityFlags: PacketBackendCapabilityFlags;
}

/// Backend capability flag bit for packet capture operations.
export const PACKET_BACKEND_CAP_CAPTURE: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x1);
/// Backend capability flag bit for packet send operations.
export const PACKET_BACKEND_CAP_SEND: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x2);
/// Backend capability flag bit for timestamp configuration.
export const PACKET_BACKEND_CAP_TIMESTAMP: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x4);
/// Backend capability flag bit for packet filter programs.
export const PACKET_BACKEND_CAP_FILTER: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x8);
/// Backend capability flag bit for packet fanout operations.
export const PACKET_BACKEND_CAP_FANOUT: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x10);
/// Backend capability flag bit for packet ring operations.
export const PACKET_BACKEND_CAP_RING: PacketBackendCapabilityFlags =
    PacketBackendCapabilityFlags(0x20);

/// Packet capture options.
export struct PacketCaptureOptions {
    /// Preferred packet backend selector.
    backend: PacketBackend;
    /// Packet backend selection policy.
    backendPolicy: PacketBackendSelectionPolicy;
    /// Interface index for capture.
    interfaceIndex: uint32;
    /// Maximum frame bytes per packet.
    snapLength: uint32;
    /// Capture timeout in milliseconds.
    timeoutMs: int32;
    /// Whether promiscuous mode is requested.
    promiscuous: boolean;
}

/// Captured packet metadata.
export struct PacketCaptureRecord {
    /// Number of packet bytes written to the target buffer.
    bytes: uint64;
    /// Interface index that produced the packet.
    interfaceIndex: uint32;
    /// Packet timestamp clock domain.
    timestampClock: PacketTimestampClock;
    /// Capture timestamp in nanoseconds for `timestampClock`.
    timestampNs: uint64;
    /// Whether packet bytes were truncated.
    truncated: boolean;
}

/// Packet capture backend statistics.
export struct PacketCaptureStats {
    /// Number of packets received by the backend.
    receivedPackets: uint64;
    /// Number of packets dropped by the backend.
    droppedPackets: uint64;
    /// Number of packets dropped by the interface.
    interfaceDroppedPackets: uint64;
}

/// Packet fanout mode for shared packet sockets.
export enum PacketFanoutMode {
    /// Hash packets across sockets.
    Hash = 0,
    /// Load balance packets across sockets.
    LoadBalance = 1,
    /// Forward packets to the same CPU socket.
    Cpu = 2,
    /// Use round robin packet distribution.
    RoundRobin = 3,
    /// Use rollover failover packet distribution.
    Rollover = 4,
    /// Keep flows and load balance across sockets.
    QueueMap = 5,
}

/// Packet fanout options for packet sockets.
export struct PacketFanoutOptions {
    /// Fanout group identifier.
    groupId: uint16;
    /// Fanout algorithm mode.
    mode: PacketFanoutMode;
    /// Mode-specific fanout flags.
    flags: uint16;
}

/// Packet ring options for rx and tx packet queues.
export struct PacketRingOptions {
    /// Ring block size in bytes.
    blockSize: uint32;
    /// Number of blocks in the ring.
    blockCount: uint32;
    /// Frame size in bytes.
    frameSize: uint32;
    /// Number of frames in the ring.
    frameCount: uint32;
    /// Block retire timeout in milliseconds.
    retireTimeoutMs: uint32;
}

/// Raw network bindings for the native runtime.
declare namespace net {
    /// List host packet backends.
    ///
    /// Enumerate available packet backend implementations and backend-level feature flags.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetBackendList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetBackendList(): Result<Slice<PacketBackendDescriptor>, PlatformError>;

    /// Open a raw IP socket.
    ///
    /// Creates a raw socket endpoint for protocol-level packet control.
    /// Host privilege checks and protocol restrictions are enforced by the kernel.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses socket(AF_INET/AF_INET6, SOCK_RAW) on Unix and WSASocketW raw mode on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.socket", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function rawSocket(
        family: SocketFamily,
        protocol: int32,
    ): Result<SocketHandle, PlatformError>;

    /// Enable or disable IP header inclusion on a raw socket.
    ///
    /// Updates the raw socket header include mode.
    /// Caller is responsible for writing valid protocol headers when enabled.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setsockopt(IP_HDRINCL) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.setHeaderIncluded", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function rawSetHeaderIncluded(
        handle: SocketHandle,
        enabled: boolean,
    ): Result<void, PlatformError>;

    /// Open a packet capture or inject endpoint.
    ///
    /// Opens one host packet endpoint for packet capture and injection.
    /// Frame shape and metadata are backend specific.
    /// Host privilege checks and backend-specific limits are enforced by the kernel or driver.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses AF_PACKET on Linux and `/dev/bpf` packet devices on macOS.
    /// Returns `notSupported` on Unix targets without a packet backend.
    /// Uses one configured host packet backend on Windows.
    /// Current Windows backend uses raw IPv4 sockets with `SIO_RCVALL`, payloads are IP packets rather than Ethernet frames.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetOpen(options: PacketCaptureOptions): Result<SocketHandle, PlatformError>;

    /// Receive one packet from a packet endpoint.
    ///
    /// Reads one packet record into the provided payload buffer and returns packet metadata.
    /// Truncation is reported explicitly when the payload buffer is smaller than the captured frame.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses AF_PACKET packet reads on Linux and BPF packet reads on macOS.
    /// Returns `notSupported` on Unix targets without a packet backend.
    /// Uses one configured host packet backend on Windows.
    /// Current Windows backend reads raw IPv4 packets from `SOCK_RAW` capture lanes.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetReceive", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetReceive(
        handle: SocketHandle,
        payload: Slice<uint8>,
    ): Result<PacketCaptureRecord, PlatformError>;

    /// Send one packet through a packet endpoint.
    ///
    /// Writes one raw packet frame from the provided payload buffer.
    /// Partial sends are reported through the returned byte count.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses AF_PACKET packet writes on Linux and BPF packet writes on macOS.
    /// Returns `notSupported` on Unix targets without a packet backend.
    /// Uses one configured host packet backend on Windows.
    /// Current Windows backend sends raw IPv4 packets through `SOCK_RAW`.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSend", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSend(
        handle: SocketHandle,
        payload: Slice<uint8>,
    ): Result<uint64, PlatformError>;

    /// Configure packet timestamp mode for a socket or packet endpoint.
    ///
    /// Updates timestamping mode for packet metadata capture on supported backends.
    /// Unsupported timestamp modes return notSupported.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses SO_TIMESTAMP families on Linux and BPF timestamp lanes on macOS.
    /// Returns `notSupported` on Unix targets without timestamp-capable packet backends.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSetTimestampMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSetTimestampMode(
        handle: SocketHandle,
        mode: PacketTimestampMode,
    ): Result<void, PlatformError>;

    /// Attach one packet filter program to a raw endpoint.
    ///
    /// Installs one backend packet filter program for capture path filtering.
    /// Filter verification and accepted instruction sets are host defined.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses SO_ATTACH_FILTER on Linux and BIOCSETF on macOS.
    /// Returns `notSupported` on Unix targets without packet-filter backends.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSetFilter", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSetFilter(
        handle: SocketHandle,
        filterProgram: Slice<uint8>,
    ): Result<void, PlatformError>;

    /// Clear the active packet filter program.
    ///
    /// Removes any backend packet filter from the raw endpoint.
    /// Filter teardown semantics are host defined.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses SO_DETACH_FILTER on Linux and BIOCSETF reset on macOS.
    /// Returns `notSupported` on Unix targets without packet-filter backends.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetClearFilter", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetClearFilter(handle: SocketHandle): Result<void, PlatformError>;

    /// Set packet fanout on a packet endpoint.
    ///
    /// Attach this endpoint to one kernel packet fanout group with the provided mode.
    /// Fanout group behavior and mode-specific flags follow host packet socket semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses PACKET_FANOUT on Linux and returns `notSupported` where fanout groups are unavailable.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSetFanout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSetFanout(
        handle: SocketHandle,
        options: PacketFanoutOptions,
    ): Result<void, PlatformError>;

    /// Clear packet fanout from a packet endpoint.
    ///
    /// Remove this endpoint from any active fanout group.
    /// Group teardown behavior and packet redistribution follow host kernel semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses PACKET_FANOUT reset on Linux and returns `notSupported` where fanout groups are unavailable.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetClearFanout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetClearFanout(handle: SocketHandle): Result<void, PlatformError>;

    /// Configure one packet rx ring for zero-copy capture.
    ///
    /// Configure one receive ring so packet frames are delivered through kernel ring buffers.
    /// Ring geometry is validated by the host kernel and may be clamped or rejected.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses PACKET_RX_RING on Linux and returns `notSupported` where packet rings are unavailable.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSetRxRing", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSetRxRing(
        handle: SocketHandle,
        options: PacketRingOptions,
    ): Result<void, PlatformError>;

    /// Configure one packet tx ring for zero-copy transmit.
    ///
    /// Configure one transmit ring so packet frames are queued through kernel ring buffers.
    /// Ring geometry is validated by the host kernel and may be clamped or rejected.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses PACKET_TX_RING on Linux and returns `notSupported` where packet rings are unavailable.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetSetTxRing", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetSetTxRing(
        handle: SocketHandle,
        options: PacketRingOptions,
    ): Result<void, PlatformError>;

    /// Clear packet rx and tx ring configuration.
    ///
    /// Disable ring-backed packet queues and return to syscall-based send and receive.
    /// Pending ring buffers are released according to host packet socket semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses PACKET_RX_RING and PACKET_TX_RING reset on Linux and returns `notSupported` elsewhere.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetClearRing", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetClearRing(handle: SocketHandle): Result<void, PlatformError>;

    /// Read packet capture statistics from one endpoint.
    ///
    /// Reads cumulative backend packet counters for the endpoint.
    /// Counter units and reset behavior follow host backend semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses packet socket stats on Linux and BPF stats on macOS.
    /// Returns `notSupported` on Unix targets without packet stats backends.
    /// Uses one configured host packet backend on Windows.
    /// Returns `notSupported` on Windows when no packet backend is configured.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.raw`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.raw.packetStats", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.raw"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function packetStats(handle: SocketHandle): Result<PacketCaptureStats, PlatformError>;
}
