    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getReadTimeout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getReadTimeout(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read the write timeout in milliseconds.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_SNDTIMEO) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getWriteTimeout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getWriteTimeout(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read IPv6-only mode.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(IPV6_V6ONLY) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getOnlyV6", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getOnlyV6(handle: SocketHandle): Result<boolean, PlatformError>;

    /// Set one raw socket option payload.
    ///
    /// Set one host socket option using raw level, name, and byte payload.
    /// This escape hatch covers options that do not yet have typed bindings.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setSockOptRaw", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setSockOptRaw(
        handle: SocketHandle,
        level: SocketOptionLevel,
        name: SocketOptionName,
        value: Slice<uint8>,
    ): Result<void, PlatformError>;

    /// Read one raw socket option payload.
    ///
    /// Read one host socket option using raw level and name.
    /// The returned byte payload is host-defined and must be decoded by the caller.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getSockOptRaw", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getSockOptRaw(
        handle: SocketHandle,
        level: SocketOptionLevel,
        name: SocketOptionName,
        maxBytes: uint32,
    ): Result<uint8[], PlatformError>;
}
