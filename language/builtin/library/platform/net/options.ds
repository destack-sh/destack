import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";

/// Socket linger settings.
export struct Linger {
    /// Whether linger is enabled.
    enabled: boolean;
    /// Linger duration in seconds.
    seconds: uint32;
}

/// Packet timestamping mode.
export enum SocketTimestampingMode {
    /// Disable packet timestamping.
    Off = 0,
    /// Enable software timestamping.
    Software = 1,
    /// Enable hardware timestamping when available.
    Hardware = 2,
}

/// Native socket option level.
export newtype SocketOptionLevel = uint32;

/// Native socket option name.
export newtype SocketOptionName = uint32;

/// Socket option bindings for the native runtime.
declare namespace net {
    /// Set socket linger settings.
    ///
    /// Set SO_LINGER parameters on the target socket.
    /// The host kernel validates and applies linger policy exactly once for this call.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_LINGER) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setLinger", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setLinger(handle: SocketHandle, linger: Linger): Result<void, PlatformError>;

    /// Set the receive buffer size.
    ///
    /// Set SO_RCVBUF on the target socket.
    /// The host kernel clamps requested values according to platform limits.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_RCVBUF) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setRecvBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setRecvBuffer(handle: SocketHandle, size: uint32): Result<void, PlatformError>;

    /// Set the send buffer size.
    ///
    /// Set SO_SNDBUF on the target socket.
    /// The host kernel clamps requested values according to platform limits.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_SNDBUF) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setSendBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setSendBuffer(handle: SocketHandle, size: uint32): Result<void, PlatformError>;

    /// Enable or disable broadcast.
    ///
    /// Enable or disable broadcast via host kernel APIs.
    /// Return values and failures map directly to host contracts so higher layers can apply policy explicitly.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_BROADCAST) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setBroadcast", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setBroadcast(
        handle: SocketHandle,
        enabled: boolean,
    ): Result<void, PlatformError>;

    /// Set the IP time-to-live.
    ///
    /// Set the requested control value on the descriptor through the native option interface.
    /// The binding performs one control transaction and returns the exact host outcome without policy retries.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(IP_TTL/IPV6_UNICAST_HOPS) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setTtl", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setTtl(handle: SocketHandle, ttl: uint32): Result<void, PlatformError>;

    /// Set the IP type-of-service field.
    ///
    /// Set the requested control value on the descriptor through the native option interface.
    /// The binding performs one control transaction and returns the exact host outcome without policy retries.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(IP_TOS/IPV6_TCLASS) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setTos", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setTos(handle: SocketHandle, tos: uint32): Result<void, PlatformError>;

    /// Set the read timeout in milliseconds.
    ///
    /// Set SO_RCVTIMEO on the target socket.
    /// Timeout interpretation and rounding follow host kernel socket-timeout semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_RCVTIMEO) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setReadTimeout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setReadTimeout(
        handle: SocketHandle,
        timeoutMs: uint32,
    ): Result<void, PlatformError>;

    /// Set the write timeout in milliseconds.
    ///
    /// Set SO_SNDTIMEO on the target socket.
    /// Timeout interpretation and rounding follow host kernel socket-timeout semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_SNDTIMEO) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setWriteTimeout", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setWriteTimeout(
        handle: SocketHandle,
        timeoutMs: uint32,
    ): Result<void, PlatformError>;

    /// Restrict an IPv6 socket to IPv6 traffic only.
    ///
    /// Set IPV6_V6ONLY on the target socket.
    /// Dual-stack behavior follows host kernel policy after this option is applied.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(IPV6_V6ONLY) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setOnlyV6", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setOnlyV6(handle: SocketHandle, enabled: boolean): Result<void, PlatformError>;

    /// Read socket linger settings.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_LINGER) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getLinger", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getLinger(handle: SocketHandle): Result<Linger, PlatformError>;

    /// Read the receive buffer size.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_RCVBUF) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getRecvBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getRecvBuffer(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read the send buffer size.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_SNDBUF) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getSendBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getSendBuffer(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read broadcast mode.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_BROADCAST) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getBroadcast", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getBroadcast(handle: SocketHandle): Result<boolean, PlatformError>;

    /// Read the IP time-to-live.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(IP_TTL/IPV6_UNICAST_HOPS) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getTtl", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getTtl(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read the IP type-of-service field.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(IP_TOS/IPV6_TCLASS) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getTos", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getTos(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Set packet timestamping mode.
    ///
    /// Configure timestamping controls on one socket endpoint.
    /// Timestamp delivery channel and precision follow host kernel capabilities.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses SO_TIMESTAMP families on Unix and host timestamping controls on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setTimestamping", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setTimestamping(
        handle: SocketHandle,
        mode: SocketTimestampingMode,
    ): Result<void, PlatformError>;

    /// Read packet timestamping mode.
    ///
    /// Read timestamping controls from one socket endpoint.
    /// Returned mode is normalized across host option variants.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses SO_TIMESTAMP families on Unix and host timestamping controls on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getTimestamping", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getTimestamping(
        handle: SocketHandle,
    ): Result<SocketTimestampingMode, PlatformError>;

    /// Set socket packet mark.
    ///
    /// Set packet mark metadata used by host routing and firewall policy.
    /// Mark interpretation is host-network-stack specific.
    ///
    /// # Platform
    /// Unix only.
    /// Uses SO_MARK on Linux and returns `notSupported` on Unix targets without socket-mark support.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.setPacketMark", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setPacketMark(handle: SocketHandle, mark: uint32): Result<void, PlatformError>;

    /// Read socket packet mark.
    ///
    /// Read packet mark metadata from one socket endpoint.
    /// Mark value interpretation is host-network-stack specific.
    ///
    /// # Platform
    /// Unix only.
    /// Uses SO_MARK on Linux and returns `notSupported` on Unix targets without socket-mark support.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.options.getPacketMark", {
        effect: "external",
        replay: "recordable",
        capabilities: ["net.control"],
        platforms: ["unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function getPacketMark(handle: SocketHandle): Result<uint32, PlatformError>;

    /// Read the read timeout in milliseconds.
    ///
    /// Read the current option value from the host socket option layer.
    /// Returned units and ranges follow host option semantics for the active platform.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_RCVTIMEO) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
