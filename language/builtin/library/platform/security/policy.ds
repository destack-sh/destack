import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import type { PlatformCapability } from "./capability.ds";

/// Policy decision mode for one capability entry.
export enum SecurityPolicyMode {
    /// Explicitly allow the capability.
    Allow = 1,
    /// Explicitly deny the capability.
    Deny = 2,
    /// Allow but emit diagnostics or audit records.
    Audit = 3,
}

/// Structured policy rule for one capability.
export struct SecurityPolicyRule {
    /// Capability selector for the rule.
    capability: PlatformCapability;
    /// Decision mode for the capability.
    mode: SecurityPolicyMode;
}

/// Security policy bindings.
declare namespace security {
    /// Read policy capabilities for one named scope.
    ///
    /// Read one policy scope and return its effective capability set.
    /// Scope resolution and inheritance follow runtime security policy rules.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime security policy state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `security.policy.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.security.policy.get", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["security.policy.read"],
        platforms: ["windows", "unix"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",
        affinity: "any",
    })
    export function policyGet(scope: string): Result<Slice<PlatformCapability>, PlatformError>;

    /// Read structured policy rules for one named scope.
    ///
    /// Read one policy scope and return explicit capability rules with allow, deny, and audit decisions.
    /// Rule ordering and precedence follow runtime policy resolution semantics.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime security policy state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `security.policy.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.security.policy.getRules", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["security.policy.read"],
        platforms: ["windows", "unix"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",
        affinity: "any",
    })
    export function policyGetRules(scope: string): Result<Slice<SecurityPolicyRule>, PlatformError>;

    /// Replace policy capabilities for one named scope.
    ///
    /// Replace one policy scope with an explicit capability set.
    /// Policy writes are validated against runtime security admin policy.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime security policy state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `security.policy.write`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.security.policy.set", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["security.policy.write"],
        platforms: ["windows", "unix"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",
        affinity: "any",
    })
    export function policySet(
        scope: string,
        capabilities: Slice<PlatformCapability>,
    ): Result<void, PlatformError>;

    /// Replace structured policy rules for one named scope.
    ///
    /// Replace one policy scope with explicit capability rules and decision modes.
    /// Rule conflicts and precedence are validated by runtime policy authoring rules.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime security policy state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `security.policy.write`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.security.policy.setRules", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["security.policy.write"],
        platforms: ["windows", "unix"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",
        affinity: "any",
    })
    export function policySetRules(
        scope: string,
        rules: Slice<SecurityPolicyRule>,
    ): Result<void, PlatformError>;
}
