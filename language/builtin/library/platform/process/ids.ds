import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";

/// Process identifier.
export newtype ProcessId = uint32;

/// User identifier.
export newtype UserId = uint32;

/// Group identifier.
export newtype GroupId = uint32;

/// Real, effective, and saved-set user identifiers.
export struct ProcessUserIds {
    /// Real user identifier.
    real: UserId;
    /// Effective user identifier.
    effective: UserId;
    /// Saved-set user identifier.
    saved: UserId;
}

/// Real, effective, and saved-set group identifiers.
export struct ProcessGroupIds {
    /// Real group identifier.
    real: GroupId;
    /// Effective group identifier.
    effective: GroupId;
    /// Saved-set group identifier.
    saved: GroupId;
}

/// Process identity bindings for the native runtime.
declare namespace process {
    /// Return the current process identifier.
    ///
    /// Read the caller process id from the host process table.
    /// The value is stable for the lifetime of the process.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getpid(2) on Unix and GetCurrentProcessId on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.pid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function pid(): Result<ProcessId, PlatformError>;

    /// Return the parent process identifier.
    ///
    /// Read the parent id relation as reported by the host kernel.
    /// Parent visibility on Windows can be restricted by host policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getppid(2) on Unix and process snapshot APIs on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.ppid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function ppid(): Result<ProcessId, PlatformError>;

    /// Return the current user identifier.
    ///
    /// Read the real user identity for the calling process.
    /// Identity mapping on Windows is best-effort and may require token translation.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getuid(2) on Unix and token SID translation on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.uid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function uid(): Result<UserId, PlatformError>;

    /// Return the current group identifier.
    ///
    /// Read the real primary group for the calling process.
    /// Group mapping on Windows is best-effort and may require token translation.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getgid(2) on Unix and token group translation on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.gid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function gid(): Result<GroupId, PlatformError>;

    /// Return the effective user identifier.
    ///
    /// Read the effective user identity for the calling process.
    /// Effective identity can differ from the real identity under setuid-style execution.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses geteuid(2) on Unix and token SID translation on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.euid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function euid(): Result<UserId, PlatformError>;

    /// Return the effective group identifier.
    ///
    /// Read the effective primary group for the calling process.
    /// Effective group can differ from the real group under setgid-style execution.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getegid(2) on Unix and token group translation on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.egid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function egid(): Result<GroupId, PlatformError>;

    /// Return real, effective, and saved-set user identifiers.
    ///
    /// Read all user-id classes for the calling process in one operation.
    /// Saved-id availability follows host kernel semantics and can be unsupported on some targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getresuid(2) on Unix and token mapping or `notSupported` on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.userIds", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function userIds(): Result<ProcessUserIds, PlatformError>;

    /// Return real, effective, and saved-set group identifiers.
    ///
    /// Read all group-id classes for the calling process in one operation.
    /// Saved-id availability follows host kernel semantics and can be unsupported on some targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getresgid(2) on Unix and token mapping or `notSupported` on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.groupIds", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function groupIds(): Result<ProcessGroupIds, PlatformError>;

    /// Set the effective user identifier.
    ///
    /// Set the process user identity.
    /// Real and effective identity update behavior follows host setuid semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setuid(2) on Unix and token adjustment on Windows where supported.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setUid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setUid(userId: UserId): Result<void, PlatformError>;

    /// Set the effective user identifier only.
    ///
    /// Change only the effective user identity while preserving the real identity.
    /// Privilege checks and saved-ID rules are enforced by the host kernel.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses seteuid(2) on Unix and token adjustment on Windows where supported.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setEuid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setEuid(userId: UserId): Result<void, PlatformError>;

    /// Set the effective group identifier.
    ///
    /// Set the process primary group identity.
    /// Real and effective group update behavior follows host setgid semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setgid(2) on Unix and token adjustment on Windows where supported.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setGid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setGid(groupId: GroupId): Result<void, PlatformError>;

    /// Set the effective group identifier only.
    ///
    /// Change only the effective primary group while preserving the real group.
    /// Privilege checks and saved-ID rules are enforced by the host kernel.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setegid(2) on Unix and token adjustment on Windows where supported.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setEgid", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setEgid(groupId: GroupId): Result<void, PlatformError>;

    /// Set real, effective, and saved-set user identifiers together.
    ///
    /// Update all user-id classes in one host operation.
    /// Privilege checks and immutable-id restrictions follow host kernel rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setresuid(2) on Unix and token adjustment or `notSupported` on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setUserIds", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setUserIds(ids: ProcessUserIds): Result<void, PlatformError>;

    /// Set real, effective, and saved-set group identifiers together.
    ///
    /// Update all group-id classes in one host operation.
    /// Privilege checks and immutable-id restrictions follow host kernel rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setresgid(2) on Unix and token adjustment or `notSupported` on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setGroupIds", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setGroupIds(ids: ProcessGroupIds): Result<void, PlatformError>;

    /// Return supplementary group identifiers.
    ///
    /// Read the supplementary group list attached to the calling process.
    /// Group ordering follows host kernel reporting order.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses getgroups(2) on Unix and token group enumeration on Windows.
    ///
    /// # Errors
    /// Returns ioInvalidData, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.groups", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function groups(): Result<Slice<GroupId>, PlatformError>;

    /// Set supplementary group identifiers.
    ///
    /// Replace the calling process supplementary group list.
    /// This operation is typically restricted to privileged processes.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses setgroups(2) on Unix and token group adjustment on Windows where supported.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.identity.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.process.ids.setGroups", {
        effect: "external",
        replay: "recordable",
        capabilities: ["process.identity.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function setGroups(groups: Slice<GroupId>): Result<void, PlatformError>;
}
