import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CryptoKeyHandle } from "../resource/index.ds";
import { CryptoDigestAlgorithm, CryptoKeyAgreementAlgorithm } from "./algorithm.ds";

/// Key-agreement key-derivation request.
export struct CryptoAgreementDeriveKeyRequest {
    /// Key-agreement algorithm.
    algorithm: CryptoKeyAgreementAlgorithm;
    /// Digest algorithm used by the KDF stage.
    digest: CryptoDigestAlgorithm;
    /// KDF salt bytes.
    salt: Slice<uint8>;
    /// KDF context info bytes.
    info: Slice<uint8>;
    /// Derived key length in bytes.
    outputLength: uint32;
}

/// Key-agreement bindings.
declare namespace crypto {
    /// Derive one shared secret from one local private key and one peer public key.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL key-agreement primitives for software providers, and host key APIs for host-managed keys: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when registered.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.agree`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.crypto.agreement.deriveSharedSecret", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["crypto.key.agree"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function agreementDeriveSharedSecret(
        privateKey: CryptoKeyHandle,
        peerPublicKey: CryptoKeyHandle,
        algorithm: CryptoKeyAgreementAlgorithm,
    ): Result<Slice<uint8>, PlatformError>;

    /// Derive one symmetric key from one local private key and one peer public key.
    ///
    /// This operation performs key agreement and an explicit KDF stage.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL key-agreement and KDF primitives for software providers, and host key APIs for host-managed keys: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when registered.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.agree`, `crypto.kdf`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.crypto.agreement.deriveKey", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["crypto.key.agree", "crypto.kdf"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function agreementDeriveKey(
        privateKey: CryptoKeyHandle,
        peerPublicKey: CryptoKeyHandle,
        request: CryptoAgreementDeriveKeyRequest,
    ): Result<Slice<uint8>, PlatformError>;
}
