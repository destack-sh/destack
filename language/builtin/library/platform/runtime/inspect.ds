        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",
        affinity: "owner",
    })
    export function runtimeList(
        view: WorldViewHandle,
        filter?: RuntimeFilter,
        after?: RuntimeId,
        limit?: uint32,
    ): Result<Array<RuntimeDescriptor>, PlatformError>;

