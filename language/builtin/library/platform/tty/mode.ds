import type { PlatformError } from "../error/index.ds";
import { TtyHandle } from "../resource/index.ds";

/// TTY mode snapshot.
export struct TtyMode {
    /// Input-mode bit flags.
    inputFlags: uint64;
    /// Output-mode bit flags.
    outputFlags: uint64;
    /// Control-mode bit flags.
    controlFlags: uint64;
    /// Local-mode bit flags.
    localFlags: uint64;
}

/// TTY mode bindings.
declare namespace tty {
    /// Read terminal mode flags.
    ///
    /// Read one terminal mode snapshot for one terminal handle.
    /// Mode fields are projected from host terminal APIs.
    /// Field-level behavior is host-specific, especially for non-POSIX backends.
    /// Windows PTY worker handles may report `notSupported` because ConPTY pipes do not expose console-mode APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios get attributes on Unix and GetConsoleMode on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `tty.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.tty.mode.getMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["tty.mode"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function getMode(handle: TtyHandle): Result<TtyMode, PlatformError>;

    /// Apply terminal mode flags.
    ///
    /// Apply one terminal mode snapshot to one terminal handle.
    /// Mode transition timing and unsupported bits follow host API behavior.
    /// Windows PTY worker handles may report `notSupported` because ConPTY pipes do not expose console-mode APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios set attributes on Unix and SetConsoleMode on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `tty.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.tty.mode.setMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["tty.mode"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function setMode(handle: TtyHandle, mode: TtyMode): Result<void, PlatformError>;

    /// Enable or disable raw terminal mode.
    ///
    /// Apply one host-defined raw-mode profile for one terminal handle.
    /// This maps to cfmakeraw-style behavior on Unix and console-mode toggles on Windows.
    /// Windows PTY worker handles may report `notSupported` because ConPTY pipes do not expose console-mode APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses cfmakeraw plus tcsetattr on Unix and SetConsoleMode profile updates on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `tty.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.tty.mode.setRawMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["tty.mode"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function setRawMode(handle: TtyHandle, enabled: boolean): Result<void, PlatformError>;
}
