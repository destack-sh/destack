import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { BackgroundEventHandle } from "../resource/index.ds";

/// Background-task scheduler status.
export enum BackgroundStatus {
    /// Background scheduling is unavailable on this host.
    Unavailable = 1,
    /// Background scheduling is available but currently restricted by host policy.
    Restricted = 2,
    /// Background scheduling is available.
    Available = 3,
}

/// Background-task trigger class.
export enum BackgroundTriggerKind {
    /// Opportunistic short refresh task.
    AppRefresh = 1,
    /// Longer processing task.
    Processing = 2,
}

/// Background-task network requirement.
export enum BackgroundNetworkRequirement {
    /// No network route is required.
    None = 1,
    /// One network route is required.
    Connected = 2,
    /// One unmetered network route is required.
    Unmetered = 3,
}

/// Background-task registration conflict policy.
export enum BackgroundConflictPolicy {
    /// Replace one existing registration with the same identifier.
    Replace = 1,
    /// Keep one existing registration with the same identifier.
    Keep = 2,
}

/// Background-task schedule class.
export enum BackgroundTaskScheduleKind {
    /// Schedule one single future execution.
    Once = 1,
    /// Schedule one recurring execution stream.
    Recurring = 2,
}

/// Background-task completion class.
export enum BackgroundTaskResult {
    /// This scheduled execution completed successfully.
    Success = 1,
    /// This scheduled execution should be retried sooner than the next regular occurrence when the host supports one retry path.
    Retry = 2,
    /// This scheduled execution failed and should not be retried before the next regular occurrence.
    Failure = 3,
}

/// Background-task schedule payload.
export struct BackgroundTaskSchedule {
    /// Schedule class.
    kind: BackgroundTaskScheduleKind;
    /// Earliest target execution timestamp in UTC nanoseconds when provided.
    earliestBeginUnixNs?: uint64;
    /// Repeat interval in nanoseconds for recurring schedules.
    repeatIntervalNs?: uint64;
}

/// Background-task scheduling options.
export struct BackgroundTaskOptions {
    /// Stable task identifier.
    identifier: string;
    /// Trigger class.
    trigger: BackgroundTriggerKind;
    /// Requested schedule payload.
    schedule: BackgroundTaskSchedule;
    /// Requested network requirement.
    network: BackgroundNetworkRequirement;
    /// Whether charging power is required.
    requiresCharging: boolean;
    /// Whether idle mode is required.
    requiresIdle: boolean;
    /// Registration conflict policy for one existing identifier.
    conflictPolicy: BackgroundConflictPolicy;
}

/// Background-task descriptor payload.
export struct BackgroundTaskDescriptor {
    /// Stable task identifier.
    identifier: string;
    /// Trigger class.
    trigger: BackgroundTriggerKind;
    /// Effective schedule payload.
    schedule: BackgroundTaskSchedule;
    /// Effective network requirement.
    network: BackgroundNetworkRequirement;
    /// Whether charging power is required.
    requiresCharging: boolean;
    /// Whether idle mode is required.
    requiresIdle: boolean;
    /// Registration conflict policy for one existing identifier.
    conflictPolicy: BackgroundConflictPolicy;
}

/// Background-task event stream open options.
export struct BackgroundEventOpenOptions {
    /// Whether task-ready events should be included.
    includeTaskReady: boolean;
    /// Whether task-expired events should be included.
    includeTaskExpired: boolean;
}

/// Shared metadata for all background-task events.
export struct BackgroundEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this event stream.
    sequence: uint64;
    /// Stable task identifier.
    identifier: string;
    /// Stable execution identifier for this one scheduled execution.
    executionId: string;
    /// Host execution deadline in UTC nanoseconds when provided.
    deadlineUnixNs: uint64;
}

/// Task-ready background event.
export struct BackgroundTaskReadyEvent {
    /// Discriminator for this background event variant.
    kind: "taskReady";
    /// Shared event metadata.
    metadata: BackgroundEventMetadata;
}

/// Task-expired background event.
export struct BackgroundTaskExpiredEvent {
    /// Discriminator for this background event variant.
    kind: "taskExpired";
    /// Shared event metadata.
    metadata: BackgroundEventMetadata;
}

/// Background-task event payload.
export newtype BackgroundEvent = BackgroundTaskReadyEvent | BackgroundTaskExpiredEvent;

/// Background-task bindings.
declare namespace os {
    /// Read background-task scheduler status.
    ///
    /// Read the current background-task scheduler status for this host runtime.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host scheduler bridges on supported desktop platforms.
    ///
    /// # Errors
    /// Returns ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.status", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function backgroundStatus(): Result<BackgroundStatus, PlatformError>;

    /// List background-task registrations.
    ///
    /// Enumerate background-task registrations for this runtime identity.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background scheduler registration queries.
    ///
    /// # Errors
    /// Returns ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundList(): Result<Array<BackgroundTaskDescriptor>, PlatformError>;

    /// Register one background task.
    ///
    /// Create one background-task registration or resolve one existing identifier according to the selected registration policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background scheduler registration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.background.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.background.register", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.background.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundRegister(options: BackgroundTaskOptions): Result<void, PlatformError>;

    /// Unregister one background task.
    ///
    /// Remove one background-task registration by identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background scheduler unregistration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.background.unregister", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.background.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundUnregister(identifier: string): Result<void, PlatformError>;

    /// Trigger one background task for testing.
    ///
    /// Ask the host scheduler to trigger one registered task immediately for development validation where supported.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host developer test hooks where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.background.triggerTest", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.background.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundTriggerTest(identifier: string): Result<boolean, PlatformError>;

    /// Report completion for one scheduled background-task execution.
    ///
    /// Submit final execution status for one scheduled task execution token.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background scheduler completion APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.background.complete", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.background.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundComplete(
        executionId: string,
        result: BackgroundTaskResult,
    ): Result<void, PlatformError>;

    /// Open one background-task event stream.
    ///
    /// Open one event stream for task-ready and expiration callbacks.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background scheduler callback bridges.
    ///
    /// # Errors
    /// Returns ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.event.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundEventOpen(
        options: BackgroundEventOpenOptions,
    ): Result<BackgroundEventHandle, PlatformError>;

    /// Close one background-task event stream.
    ///
    /// Close one opened event stream and release host callback routing resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host callback unregistration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.event.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundEventClose(
        handle: BackgroundEventHandle,
    ): Result<void, PlatformError>;

    /// Wait for one background-task event.
    ///
    /// Wait for one queued background-task event from one opened event stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host background event queues.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.event.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function backgroundEventRead(
        handle: BackgroundEventHandle,
        timeoutNs: uint64,
    ): Result<BackgroundEvent, PlatformError>;

    /// Poll one background-task event without blocking.
    ///
    /// Poll one queued background-task event from one opened event stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host nonblocking background event queue reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.background.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.background.event.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.background.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function backgroundEventTryRead(
        handle: BackgroundEventHandle,
    ): Result<BackgroundEvent, PlatformError>;
}
