import type { PlatformError } from "../error/index.ds";
import { NetworkWatchHandle } from "../resource/index.ds";

/// Host network connection class.
export enum NetworkConnectionType {
    /// No active network route.
    None = 1,
    /// Unknown or backend-specific route class.
    Unknown = 2,
    /// Wi-Fi route.
    Wifi = 3,
    /// Cellular route.
    Cellular = 4,
    /// Ethernet route.
    Ethernet = 5,
    /// Bluetooth PAN route.
    Bluetooth = 6,
    /// VPN tunnel route.
    Vpn = 7,
    /// Other route class.
    Other = 8,
}

/// Cellular radio generation class.
export enum NetworkCellularGeneration {
    /// Generation is unknown.
    Unknown = 1,
    /// Second-generation cellular network.
    G2 = 2,
    /// Third-generation cellular network.
    G3 = 3,
    /// Fourth-generation cellular network.
    G4 = 4,
    /// Fifth-generation cellular network.
    G5 = 5,
}

/// Host network state snapshot.
export struct NetworkState {
    /// Route connection class.
    connectionType: NetworkConnectionType;
    /// Whether one route to a local network is available.
    connected: boolean;
    /// Whether one route to the public internet is available.
    internetReachable: boolean;
    /// Whether the route is metered or expensive when the host can determine it.
    expensive?: boolean;
    /// Whether the route is constrained by low-data mode when the host can determine it.
    constrained?: boolean;
    /// Whether the active route is roaming when the host can determine it.
    roaming?: boolean;
    /// Cellular generation when `connectionType` is `Cellular` and the host can determine it.
    cellularGeneration?: NetworkCellularGeneration;
    /// Estimated downstream bandwidth in megabits per second when the host can determine it.
    downlinkMbps?: float64;
    /// Estimated upstream bandwidth in megabits per second when the host can determine it.
    uplinkMbps?: float64;
}

/// Host network event payload.
export struct NetworkEvent {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Network state snapshot.
    state: NetworkState;
}

/// Network bindings.
declare namespace os {
    /// Read host network state.
    ///
    /// Read one point-in-time host network state snapshot.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host network state facilities.
    ///
    /// # Errors
    /// Returns ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.network.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.network.state", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.network.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function networkState(): Result<NetworkState, PlatformError>;

    /// Open host network watch stream.
    ///
    /// Open one host network watch stream for connectivity state transitions.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host network state facilities and runtime watch state.
    ///
    /// # Errors
    /// Returns ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.network.watch`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.network.watchOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.network.watch"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function networkWatchOpen(): Result<NetworkWatchHandle, PlatformError>;

    /// Close host network watch stream.
    ///
    /// Close one host network watch stream and release host subscription resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses runtime watch state cleanup.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.network.watch`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.network.watchClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.network.watch"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function networkWatchClose(handle: NetworkWatchHandle): Result<void, PlatformError>;

    /// Wait for one host network event.
    ///
    /// Wait for one queued host network event from one opened watch stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses runtime network watch state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `os.network.watch`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.network.watchRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.network.watch"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function networkWatchRead(
        handle: NetworkWatchHandle,
        timeoutNs: uint64,
    ): Result<NetworkEvent, PlatformError>;

    /// Poll one host network event without blocking.
    ///
    /// Poll one queued host network event from one opened watch stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses runtime network watch state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.network.watch`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.network.watchTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.network.watch"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function networkWatchTryRead(
        handle: NetworkWatchHandle,
    ): Result<NetworkEvent, PlatformError>;
}
