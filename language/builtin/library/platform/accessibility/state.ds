/// Tri-state value for `aria-checked` and `aria-pressed`.
export enum AccessibilityTristate {
    /// `false`.
    False = 1,
    /// `true`.
    True = 2,
    /// `mixed`.
    Mixed = 3,
}

/// `aria-current` selector.
export enum AccessibilityCurrentKind {
    /// `true`.
    True = 1,
    /// `page`.
    Page = 2,
    /// `step`.
    Step = 3,
    /// `location`.
    Location = 4,
    /// `date`.
    Date = 5,
    /// `time`.
    Time = 6,
}

/// `aria-invalid` selector.
export enum AccessibilityInvalidKind {
    /// `true`.
    True = 1,
    /// `grammar`.
    Grammar = 2,
    /// `spelling`.
    Spelling = 3,
}

/// `aria-autocomplete` selector.
export enum AccessibilityAutoComplete {
    /// `inline`.
    Inline = 1,
    /// `list`.
    List = 2,
    /// `both`.
    Both = 3,
}

/// `aria-haspopup` selector.
export enum AccessibilityHasPopup {
    /// `menu` or `true`.
    Menu = 1,
    /// `listbox`.
    ListBox = 2,
    /// `tree`.
    Tree = 3,
    /// `grid`.
    Grid = 4,
    /// `dialog`.
    Dialog = 5,
}

/// `aria-orientation` selector.
export enum AccessibilityOrientation {
    /// `horizontal`.
    Horizontal = 1,
    /// `vertical`.
    Vertical = 2,
}

/// `aria-live` politeness selector.
export enum AccessibilityLiveRegionPoliteness {
    /// `off`.
    Off = 1,
    /// `polite`.
    Polite = 2,
    /// `assertive`.
    Assertive = 3,
}

/// `aria-sort` selector.
export enum AccessibilitySortDirection {
    /// `ascending`.
    Ascending = 1,
    /// `descending`.
    Descending = 2,
    /// `other`.
    Other = 3,
}

/// `aria-relevant` flags.
export newtype AccessibilityRelevantFlags = uint32;

/// No `aria-relevant` tokens.
export const ACCESSIBILITY_RELEVANT_NONE: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x0);

/// `additions`.
export const ACCESSIBILITY_RELEVANT_ADDITIONS: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x1);

/// `removals`.
export const ACCESSIBILITY_RELEVANT_REMOVALS: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x2);

/// `text`.
export const ACCESSIBILITY_RELEVANT_TEXT: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x4);

/// `all`.
export const ACCESSIBILITY_RELEVANT_ALL: AccessibilityRelevantFlags =
    AccessibilityRelevantFlags(0x7);

/// Numeric range value for widgets such as sliders, meters, and spin buttons.
export struct AccessibilityRangeValue {
    /// `aria-valuemin`.
    min: float64 | void;
    /// `aria-valuemax`.
    max: float64 | void;
    /// `aria-valuenow`.
    now: float64 | void;
    /// `aria-valuetext`.
    text: string | void;
}

/// Grid or list metadata for collection style widgets.
export struct AccessibilityCollectionInfo {
    /// `aria-rowcount`.
    rowCount: int32 | void;
    /// `aria-colcount`.
    columnCount: int32 | void;
    /// Whether the collection supports multiple selection.
    isMultiselectable: boolean;
    /// Whether the collection requires at least one selected item.
    isSelectionRequired: boolean;
}

/// Grid or list item metadata for collection members.
export struct AccessibilityCollectionItemInfo {
    /// `aria-level`.
    level: uint32 | void;
    /// `aria-posinset`.
    positionInSet: uint32 | void;
    /// `aria-setsize`.
    setSize: uint32 | void;
    /// `aria-rowindex`.
    rowIndex: uint32 | void;
    /// `aria-colindex`.
    columnIndex: uint32 | void;
    /// `aria-rowspan`.
    rowSpan: uint32 | void;
    /// `aria-colspan`.
    columnSpan: uint32 | void;
}

/// Scroll state for one scrollable accessibility node.
export struct AccessibilityScrollState {
    /// Whether the node is currently scrollable.
    isScrollable: boolean;
    /// Horizontal scroll offset when available.
    x: float64 | void;
    /// Vertical scroll offset when available.
    y: float64 | void;
    /// Horizontal scroll range maximum when available.
    maxX: float64 | void;
    /// Vertical scroll range maximum when available.
    maxY: float64 | void;
    /// Horizontal viewport size when available.
    viewportWidth: float64 | void;
    /// Vertical viewport size when available.
    viewportHeight: float64 | void;
}

/// Shared node state derived from ARIA and platform accessibility properties.
export struct AccessibilityNodeState {
    /// `aria-checked`.
    checked: AccessibilityTristate | void;
    /// `aria-pressed`.
    pressed: AccessibilityTristate | void;
    /// `aria-current`.
    current: AccessibilityCurrentKind | void;
    /// `aria-invalid`.
    invalid: AccessibilityInvalidKind | void;
    /// `aria-autocomplete`.
    autoComplete: AccessibilityAutoComplete | void;
    /// `aria-haspopup`.
    hasPopup: AccessibilityHasPopup | void;
    /// `aria-orientation`.
    orientation: AccessibilityOrientation | void;
    /// `aria-live`.
    live: AccessibilityLiveRegionPoliteness | void;
    /// `aria-relevant`.
    relevant: AccessibilityRelevantFlags;
    /// `aria-sort`.
    sort: AccessibilitySortDirection | void;
    /// `aria-level`.
    level: uint32 | void;
    /// `aria-valuetext`.
    valueText: string | void;
    /// `aria-valuenow`, `aria-valuemin`, and `aria-valuemax`.
    rangeValue: AccessibilityRangeValue | void;
    /// Collection metadata for containers such as grids and lists.
    collection: AccessibilityCollectionInfo | void;
    /// Collection metadata for collection members.
    collectionItem: AccessibilityCollectionItemInfo | void;
    /// Scroll metadata for scrollable nodes.
    scroll: AccessibilityScrollState | void;
    /// Whether `aria-atomic` is true.
    isAtomic: boolean;
    /// Whether `aria-busy` is true.
    isBusy: boolean;
    /// Whether `aria-disabled` is true.
    isDisabled: boolean;
    /// Whether the node is hidden from the accessibility tree.
    isHidden: boolean;
    /// Whether `aria-expanded` is true.
    isExpanded: boolean;
    /// Whether the node can receive accessibility focus.
    isFocusable: boolean;
    /// Whether the node currently owns accessibility focus.
    isFocused: boolean;
    /// Whether `aria-modal` is true.
    isModal: boolean;
    /// Whether the node accepts editable text input.
    isEditable: boolean;
    /// Whether `aria-readonly` is true.
    isReadOnly: boolean;
    /// Whether `aria-required` is true.
    isRequired: boolean;
    /// Whether `aria-selected` is true.
    isSelected: boolean;
    /// Whether the node represents one visited link target.
    isVisited: boolean;
}
