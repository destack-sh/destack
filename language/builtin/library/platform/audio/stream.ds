import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { AudioDeviceHandle, AudioStreamHandle } from "../resource/index.ds";
import { AudioBackend } from "./backend.ds";
import { AudioChannelLayout, AudioSampleFormat, AudioShareMode } from "./device.ds";

/// Stream option flags.
export newtype AudioStreamFlags = uint32;

/// Stream requirement flags.
export newtype AudioStreamRequirementFlags = uint32;

/// Stream status flags.
export newtype AudioStreamStatusFlags = uint32;

/// Stream transfer mode selector.
export enum AudioStreamTransferMode {
    /// Runtime pushes packets to the host stream.
    Push = 1,
}

/// Stream run-state selector.
export enum AudioStreamStateKind {
    /// Stream is stopped.
    Stopped = 1,
    /// Stream is starting.
    Starting = 2,
    /// Stream is running.
    Running = 3,
    /// Stream is paused.
    Paused = 4,
    /// Stream is draining queued playback data.
    Draining = 5,
    /// Stream is stopping.
    Stopping = 6,
    /// Stream reported one underrun or overrun.
    XRun = 7,
    /// Stream lost the underlying device.
    DeviceLost = 8,
    /// Stream backend was disconnected.
    BackendDisconnected = 9,
    /// Stream is interrupted by host policy.
    Interrupted = 10,
}

/// Audio stream configuration.
export struct AudioStreamConfig {
    /// Sample rate in hertz.
    sampleRate: uint32;
    /// Channel count.
    channels: uint16;
    /// Requested channel layout.
    channelLayout: AudioChannelLayout;
    /// Requested speaker channel mask, zero to use backend defaults.
    channelMask: uint64;
    /// Audio sample format.
    format: AudioSampleFormat;
    /// Target period size in frames.
    periodFrames: uint32;
    /// Stream transfer mode.
    transferMode: AudioStreamTransferMode;
}

/// Audio stream open options.
export struct AudioStreamOpenOptions {
    /// Requested stream option flags.
    flags: AudioStreamFlags;
    /// Requested strict requirement flags.
    /// Any unsatisfied requirement must fail open with `notSupported`.
    requirements: AudioStreamRequirementFlags;
}

/// Audio stream support result.
export struct AudioStreamSupport {
    /// Whether the requested stream configuration is fully supported.
    supported: boolean;
    /// Negotiated stream descriptor for this support check.
    /// When `supported` is false this is the closest backend-supported candidate.
    descriptor: AudioStreamDescriptor;
    /// Requirement flags satisfied by this support result.
    satisfiedRequirements: AudioStreamRequirementFlags;
    /// Requirement flags not satisfied by this support result.
    unsatisfiedRequirements: AudioStreamRequirementFlags;
}

/// Audio stream state.
export struct AudioStreamState {
    /// Stream run-state selector.
    state: AudioStreamStateKind;
    /// Whether the stream is currently running.
    running: boolean;
    /// Whether the stream is currently paused.
    paused: boolean;
    /// Frames buffered by the host backend.
    bufferedFrames: uint64;
    /// Estimated input latency in nanoseconds.
    inputLatencyNs: uint64;
    /// Estimated output latency in nanoseconds.
    outputLatencyNs: uint64;
    /// Estimated total latency in nanoseconds.
    totalLatencyNs: uint64;
    /// Current stream status flags.
    statusFlags: AudioStreamStatusFlags;
    /// Total xrun count observed by the backend.
    xrunCount: uint64;
    /// Total input underflow count observed by the backend.
    inputUnderflowCount: uint64;
    /// Total input overflow count observed by the backend.
    inputOverflowCount: uint64;
    /// Total output underflow count observed by the backend.
    outputUnderflowCount: uint64;
    /// Total output overflow count observed by the backend.
    outputOverflowCount: uint64;
    /// Backend callback CPU load estimate in [0, +inf) when available.
    callbackCpuLoad: float64;
}

/// Audio stream negotiated format descriptor.
export struct AudioStreamDescriptor {
    /// Host backend for this stream instance.
    backend: AudioBackend;
    /// Backend identifier for this stream instance.
    backendId: string;
    /// Current device identifier for this stream instance.
    deviceId: string;
    /// Effective sample rate in hertz.
    sampleRate: uint32;
    /// Effective channel count.
    channels: uint16;
    /// Effective channel layout.
    channelLayout: AudioChannelLayout;
    /// Effective speaker channel mask when available.
    channelMask: uint64;
    /// Effective sample format.
    format: AudioSampleFormat;
    /// Effective period size in frames.
    periodFrames: uint32;
    /// Stream transfer mode selected by backend.
    transferMode: AudioStreamTransferMode;
    /// Effective share mode selected by backend.
    shareMode: AudioShareMode;
    /// Requested stream option flags from open time.
    requestedFlags: AudioStreamFlags;
    /// Requested stream requirement flags from open time.
    requestedRequirements: AudioStreamRequirementFlags;
    /// Effective stream option flags after backend negotiation.
    effectiveFlags: AudioStreamFlags;
    /// Effective stream requirement flags satisfied by the backend.
    effectiveRequirements: AudioStreamRequirementFlags;
    /// Backend period jitter estimate in nanoseconds.
    /// Zero indicates unavailable timing history or insufficient callback samples.
    periodJitterNs: uint64;
    /// Whether this stream currently uses non-interleaved backend buffers.
    nonInterleaved: boolean;
    /// Whether scheduled write submission is supported.
    supportsWriteAt: boolean;
    /// Whether pause and resume operations are supported.
    supportsPause: boolean;
    /// Whether non-interleaved operation is supported.
    supportsNonInterleaved: boolean;
    /// Whether stream gain control is supported.
    supportsVolume: boolean;
    /// Whether stream mute control is supported.
    supportsMute: boolean;
    /// Whether hardware timestamp correlation is supported.
    supportsHardwareTimestamps: boolean;
}

/// Audio stream timing.
export struct AudioStreamTiming {
    /// Stream position in frames.
    streamFrames: uint64;
    /// Stream clock in nanoseconds when available.
    streamTimeNs: uint64;
    /// ADC capture timestamp in nanoseconds when available.
    inputAdcTimeNs: uint64 | void;
    /// DAC presentation timestamp in nanoseconds when available.
    outputDacTimeNs: uint64 | void;
    /// Callback invocation timestamp in nanoseconds when available.
    callbackTimeNs: uint64 | void;
    /// Host device clock in nanoseconds when available.
    deviceClockNs: uint64 | void;
    /// Runtime monotonic clock in nanoseconds.
    monotonicClockNs: uint64;
    /// Estimated drift in parts-per-million.
    /// Zero indicates unavailable timing history or insufficient callback samples.
    driftPpm: float64;
    /// Backend callback CPU load estimate in [0, +inf) when available.
    callbackCpuLoad: float64;
}

/// Audio stream availability.
export struct AudioStreamAvailability {
    /// Immediately readable frames in the backend capture buffer.
    readableFrames: uint64;
    /// Immediately writable frames in the backend playback buffer.
    writableFrames: uint64;
    /// Minimum transfer frame count for the current callback quantum.
    minTransferFrames: uint32;
    /// Maximum transfer frame count for the current callback quantum.
    maxTransferFrames: uint32;
    /// Snapshot timestamp in nanoseconds.
    timestampNs: uint64;
}

/// Audio stream bindings.
declare namespace audio {
    /// Check one audio stream configuration for backend support.
    ///
    /// Check one stream configuration and return backend negotiation results without opening one long-lived stream handle.
    /// Requirement flags are resolved into `satisfiedRequirements` and `unsatisfiedRequirements`.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors PortAudio `Pa_IsFormatSupported` intent and miniaudio native-format probing behavior.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.support", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamSupport(
        device: AudioDeviceHandle,
        config: AudioStreamConfig,
        options: AudioStreamOpenOptions,
    ): Result<AudioStreamSupport, PlatformError>;

    /// Open one audio stream on one device.
    ///
    /// Create one host audio stream with explicit sample format, channel, and period configuration.
    /// Open options carry optional tuning hints and strict requirement lanes.
    /// Any unsatisfied requirement must fail open with `notSupported`.
    /// Buffering and latency behavior follow host backend contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream creation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamOpen(
        device: AudioDeviceHandle,
        config: AudioStreamConfig,
        options: AudioStreamOpenOptions,
    ): Result<AudioStreamHandle, PlatformError>;

    /// Close one audio stream.
    ///
    /// Close one host audio stream and release backend buffers and synchronization state.
    /// Stream handle becomes invalid after close completes.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamClose(handle: AudioStreamHandle): Result<void, PlatformError>;

    /// Start one audio stream.
    ///
    /// Transition one opened stream to running state and begin host DMA or scheduler processing.
    /// Start timing follows host backend scheduling semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream start operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.start", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamStart(handle: AudioStreamHandle): Result<void, PlatformError>;

    /// Pause or resume one audio stream.
    ///
    /// Transition one running stream into paused state and back.
    /// Pause support is backend-dependent.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors libsoundio `soundio_outstream_pause` and SDL stream-device pause semantics.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.pause", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamPause(
        handle: AudioStreamHandle,
        pause: boolean,
    ): Result<void, PlatformError>;

    /// Stop one audio stream.
    ///
    /// Transition one running stream to stopped state and flush host backend scheduling.
    /// Buffered frames can be discarded based on host backend semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream stop operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.stop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamStop(handle: AudioStreamHandle): Result<void, PlatformError>;

    /// Abort one audio stream immediately.
    ///
    /// Request one immediate stream stop without graceful drain.
    /// Pending buffered data can be discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors PortAudio `Pa_AbortStream` semantics.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.stream`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.abort", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.stream"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamAbort(handle: AudioStreamHandle): Result<void, PlatformError>;

    /// Read one stream state.
    ///
    /// Read one point-in-time state sample of stream run state and backend buffering metrics.
    /// State values are advisory and can change immediately after read.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream query primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.state", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamState(handle: AudioStreamHandle): Result<AudioStreamState, PlatformError>;

    /// Read one stream negotiated configuration descriptor.
    ///
    /// Read one normalized view of negotiated stream parameters and backend mode.
    /// Values reflect backend negotiation outcomes and can differ from open-time requests.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream-parameter query operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.descriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamDescriptor(
        handle: AudioStreamHandle,
    ): Result<AudioStreamDescriptor, PlatformError>;

    /// Read one stream timing sample.
    ///
    /// Read one full timing sample that correlates stream position and available backend clocks.
    /// Missing optional lanes are reported through `has*` fields instead of `notSupported`.
    /// Timing values are intended for drift correction and synchronization.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream-clock query operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.timing", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamTiming(
        handle: AudioStreamHandle,
    ): Result<AudioStreamTiming, PlatformError>;

    /// Read one stream immediate availability sample.
    ///
    /// Read one point-in-time sample of immediately readable and writable frame counts.
    /// Values are advisory and can change immediately after read.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream-space query operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.availability", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamAvailability(
        handle: AudioStreamHandle,
    ): Result<AudioStreamAvailability, PlatformError>;

    /// Flush buffered stream data.
    ///
    /// Drop pending buffered data for one stream without closing it.
    /// Flushing semantics are backend-defined for capture and duplex streams.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream flush or reset operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.flush", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamFlush(handle: AudioStreamHandle): Result<void, PlatformError>;

    /// Drain one playback stream.
    ///
    /// Wait for one playback stream to consume currently queued samples.
    /// Drain timeout is expressed in nanoseconds in the runtime monotonic domain.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available drain or synchronized-stop operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.drain", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamDrain(
        handle: AudioStreamHandle,
        timeoutNs: uint64,
    ): Result<void, PlatformError>;

    /// Set one stream name.
    ///
    /// Apply one stream label for host mixers and diagnostics where supported.
    /// Backend label visibility and truncation follow host policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors cubeb `cubeb_stream_set_name` behavior where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.setName", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamSetName(
        handle: AudioStreamHandle,
        name: string,
    ): Result<void, PlatformError>;

    /// Set one stream gain multiplier.
    ///
    /// Apply one linear gain multiplier for one stream processing lane.
    /// This controls stream-level gain and does not imply global endpoint mixer ownership.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO stream-level gain paths where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.setVolume", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamSetVolume(
        handle: AudioStreamHandle,
        linearGain: float64,
    ): Result<void, PlatformError>;

    /// Set one stream mute state.
    ///
    /// Apply one mute state for one stream processing lane.
    /// This controls stream-level mute and does not imply global endpoint mute ownership.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO stream-level mute paths where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `audio.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.setMute", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamSetMute(
        handle: AudioStreamHandle,
        muted: boolean,
    ): Result<void, PlatformError>;

    /// Write one packet of audio frames.
    ///
    /// Submit one packet of interleaved audio frames to the playback stream.
    /// Short writes can occur when host buffers are near capacity.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream write or render-client operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.write", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamWrite(
        handle: AudioStreamHandle,
        data: Slice<uint8>,
    ): Result<uint64, PlatformError>;

    /// Try to write one packet of audio frames without blocking.
    ///
    /// Submit one packet of interleaved audio frames to the playback stream without waiting.
    /// Empty output space is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available nonblocking stream write operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.tryWrite", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamTryWrite(
        handle: AudioStreamHandle,
        data: Slice<uint8>,
    ): Result<uint64, PlatformError>;

    /// Write one packet from vectorized buffers.
    ///
    /// Submit one packet of audio frames from multiple byte slices.
    /// Buffers can represent segmented interleaved payloads or channel planes when non-interleaved mode is active.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors writev-style submission behavior and backend non-interleaved lanes where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.writev", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamWritev(
        handle: AudioStreamHandle,
        buffers: Slice<Slice<uint8>>,
    ): Result<uint64, PlatformError>;

    /// Try to write one packet from vectorized buffers without blocking.
    ///
    /// Submit one packet of audio frames from multiple byte slices without waiting.
    /// Empty output space is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors nonblocking writev-style submission behavior.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.tryWritev", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamTryWritev(
        handle: AudioStreamHandle,
        buffers: Slice<Slice<uint8>>,
    ): Result<uint64, PlatformError>;

    /// Write one packet for one target presentation time.
    ///
    /// Submit one packet of interleaved audio frames for one target presentation timestamp.
    /// Scheduling precision depends on host backend timing guarantees.
    /// This is one optional scheduling lane and can return `notSupported` when unavailable.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available scheduled-render operations when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback.schedule`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.writeAt", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback.schedule"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamWriteAt(
        handle: AudioStreamHandle,
        data: Slice<uint8>,
        presentationTimeNs: uint64,
    ): Result<uint64, PlatformError>;

    /// Write one vectorized packet for one target presentation time.
    ///
    /// Submit one packet of audio frames from multiple byte slices for one target presentation timestamp.
    /// Buffers can represent segmented interleaved payloads or channel planes when non-interleaved mode is active.
    /// Scheduling precision depends on host backend timing guarantees.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors scheduled-render operations where available and extends them for writev-style payload submission.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.playback.schedule`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.writeAtv", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.playback.schedule"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamWriteAtv(
        handle: AudioStreamHandle,
        buffers: Slice<Slice<uint8>>,
        presentationTimeNs: uint64,
    ): Result<uint64, PlatformError>;

    /// Read one packet of captured audio frames.
    ///
    /// Read one packet of captured interleaved audio frames from the capture stream.
    /// Packet sizing and buffering follow host backend capture contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available stream read or capture-client operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamRead(
        handle: AudioStreamHandle,
        maxBytes: uint32,
    ): Result<Slice<uint8>, PlatformError>;

    /// Try to read one packet of captured audio frames without blocking.
    ///
    /// Read one packet of captured interleaved audio frames without waiting.
    /// Empty input state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available nonblocking stream read operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamTryRead(
        handle: AudioStreamHandle,
        maxBytes: uint32,
    ): Result<Slice<uint8>, PlatformError>;

    /// Read one packet into vectorized buffers.
    ///
    /// Read one packet of captured audio frames into multiple byte slices.
    /// Buffers can represent segmented interleaved payloads or channel planes when non-interleaved mode is active.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors readv-style capture behavior and backend non-interleaved lanes where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.readv", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function streamReadv(
        handle: AudioStreamHandle,
        buffers: Slice<Slice<uint8>>,
    ): Result<uint64, PlatformError>;

    /// Try to read one packet into vectorized buffers without blocking.
    ///
    /// Read one packet of captured audio frames into multiple byte slices without waiting.
    /// Empty input state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors nonblocking readv-style capture behavior.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.stream.tryReadv", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function streamTryReadv(
        handle: AudioStreamHandle,
        buffers: Slice<Slice<uint8>>,
    ): Result<uint64, PlatformError>;
}

/// Default stream behavior.
export const AUDIO_STREAM_NONE: AudioStreamFlags = AudioStreamFlags(0x0);
/// Request non-interleaved channel buffers.
export const AUDIO_STREAM_NON_INTERLEAVED: AudioStreamFlags = AudioStreamFlags(0x1);
/// Request minimal callback period and latency.
export const AUDIO_STREAM_MINIMIZE_LATENCY: AudioStreamFlags = AudioStreamFlags(0x2);
/// Request strict sample-format matching with no backend substitution.
export const AUDIO_STREAM_EXPLICIT_SAMPLE_FORMAT: AudioStreamFlags = AudioStreamFlags(0x8);
/// Disable backend-side automatic sample-rate conversion where possible.
export const AUDIO_STREAM_NO_AUTO_CONVERT: AudioStreamFlags = AudioStreamFlags(0x10);
/// Request stream status updates for xrun diagnostics.
export const AUDIO_STREAM_REPORT_XRUN: AudioStreamFlags = AudioStreamFlags(0x20);

/// Default stream requirement behavior.
export const AUDIO_STREAM_REQUIRE_NONE: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x0);
/// Require non-interleaved stream buffers.
export const AUDIO_STREAM_REQUIRE_NON_INTERLEAVED: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x1);
/// Require scheduled write submission support.
export const AUDIO_STREAM_REQUIRE_SCHEDULED_WRITE: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x2);
/// Require pause and resume support.
export const AUDIO_STREAM_REQUIRE_PAUSE: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x4);
/// Require hardware timestamp correlation support.
export const AUDIO_STREAM_REQUIRE_HARDWARE_TIMESTAMPS: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x8);
/// Require bit-exact PCM with no backend-side conversion.
export const AUDIO_STREAM_REQUIRE_BIT_EXACT_PCM: AudioStreamRequirementFlags =
    AudioStreamRequirementFlags(0x10);

/// Input underflow status bit.
export const AUDIO_STREAM_STATUS_INPUT_UNDERFLOW: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x1);
/// Input overflow status bit.
export const AUDIO_STREAM_STATUS_INPUT_OVERFLOW: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x2);
/// Output underflow status bit.
export const AUDIO_STREAM_STATUS_OUTPUT_UNDERFLOW: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x4);
/// Output overflow status bit.
export const AUDIO_STREAM_STATUS_OUTPUT_OVERFLOW: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x8);
/// Output priming status bit.
export const AUDIO_STREAM_STATUS_PRIMING_OUTPUT: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x10);
/// Device-changed status bit.
export const AUDIO_STREAM_STATUS_DEVICE_CHANGED: AudioStreamStatusFlags =
    AudioStreamStatusFlags(0x20);
/// Rerouted status bit.
export const AUDIO_STREAM_STATUS_REROUTED: AudioStreamStatusFlags = AudioStreamStatusFlags(0x40);
/// Interrupted status bit.
export const AUDIO_STREAM_STATUS_INTERRUPTED: AudioStreamStatusFlags = AudioStreamStatusFlags(0x80);
