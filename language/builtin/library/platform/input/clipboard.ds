import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";

/// Clipboard binary format tag.
export enum ClipboardBinaryFormat {
    /// Plain UTF-8 text bytes.
    TextUtf8 = 1,
    /// HTML fragment bytes.
    Html = 2,
    /// Application-specific binary bytes.
    Binary = 3,
}

/// Clipboard bindings.
declare namespace input {
    /// Query whether text clipboard payload exists.
    ///
    /// Return whether one text payload is currently available on the host clipboard.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.clipboard.hasText", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.clipboard.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardHasText(): Result<boolean, PlatformError>;

    /// Read text clipboard payload.
    ///
    /// Read one text payload from the host clipboard.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.clipboard.readText", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.clipboard.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardReadText(): Result<string, PlatformError>;

    /// Write text clipboard payload.
    ///
    /// Write one text payload into the host clipboard.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.input.clipboard.writeText", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["input.clipboard.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardWriteText(text: string): Result<void, PlatformError>;

    /// Read binary clipboard payload.
    ///
    /// Read one binary payload in one selected clipboard format.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.clipboard.readBytes", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.clipboard.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardReadBytes(format: ClipboardBinaryFormat): Result<Slice<uint8>, PlatformError>;

    /// Write binary clipboard payload.
    ///
    /// Write one binary payload in one selected clipboard format.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.input.clipboard.writeBytes", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["input.clipboard.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardWriteBytes(
        format: ClipboardBinaryFormat,
        bytes: Slice<uint8>,
    ): Result<void, PlatformError>;

    /// Read clipboard sequence number.
    ///
    /// Read one monotonic sequence marker for host clipboard contents.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.clipboard.sequence", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.clipboard.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function clipboardSequence(): Result<uint64, PlatformError>;

    /// Clear clipboard payload.
    ///
    /// Clear current host clipboard ownership or payload contents.
    ///
    /// # Platform
    /// Unix and Windows.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.clipboard.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.input.clipboard.clear", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["input.clipboard.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function clipboardClear(): Result<void, PlatformError>;
}
