import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { FileHandle } from "../resource/index.ds";
import { FileOffset, FileSize } from "./flags.ds";

/// Memory protection flags for mappings.
export newtype MmapProt = uint32;
/// Permit reads through the mapping.
export const PROT_READ: MmapProt = MmapProt(0x1);
/// Permit writes through the mapping.
export const PROT_WRITE: MmapProt = MmapProt(0x2);
/// Permit instruction fetch through the mapping.
export const PROT_EXEC: MmapProt = MmapProt(0x4);

/// Mapping flags.
export newtype MmapFlags = uint32;
/// Share mapping writes with the underlying object.
export const MAP_SHARED: MmapFlags = MmapFlags(0x1);
/// Keep mapping writes private to the process.
export const MAP_PRIVATE: MmapFlags = MmapFlags(0x2);
/// Request a fixed virtual address when the host supports it.
export const MAP_FIXED: MmapFlags = MmapFlags(0x10);
/// Create an anonymous mapping with no file backing.
export const MAP_ANON: MmapFlags = MmapFlags(0x20);

/// Sync flags for msync.
export newtype MmapSyncFlags = uint32;
/// Schedule asynchronous writeback for dirty mapping pages.
export const MS_ASYNC: MmapSyncFlags = MmapSyncFlags(0x1);
/// Invalidate cached mapping pages after synchronization.
export const MS_INVALIDATE: MmapSyncFlags = MmapSyncFlags(0x2);
/// Wait for dirty mapping pages to be written back.
export const MS_SYNC: MmapSyncFlags = MmapSyncFlags(0x4);

/// Advice for madvise.
export enum MmapAdvice {
    /// Default behavior.
    Normal = 0,
    /// Access will be sequential.
    Sequential = 1,
    /// Access will be random.
    Random = 2,
    /// Will need data soon.
    WillNeed = 3,
    /// Will not need data soon.
    DontNeed = 4,
}

/// Memory mapping bindings for the native runtime.
declare namespace fs {
    /// Create a file-backed memory mapping.
    ///
    /// Map a file-backed region into virtual memory using the requested offset, length, and protection.
    /// Page alignment, commit behavior, and memory fault semantics follow host virtual-memory rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses mmap(2) MAP_SHARED/MAP_PRIVATE on Unix and CreateFileMapping/MapViewOfFile on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.mmapFile", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function mmapFile(
        handle: FileHandle,
        offset: FileOffset,
        length: FileSize,
        prot: MmapProt,
        flags: MmapFlags,
    ): Result<Slice<uint8>, PlatformError>;

    /// Create an anonymous memory mapping.
    ///
    /// Map an anonymous zero-initialized region into virtual memory using host allocation primitives.
    /// Page alignment, commit behavior, and memory fault semantics follow host virtual-memory rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses mmap(2) MAP_ANONYMOUS on Unix and VirtualAlloc/MapViewOfFile on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.mmapAnonymous", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function mmapAnonymous(
        length: FileSize,
        prot: MmapProt,
        flags: MmapFlags,
    ): Result<Slice<uint8>, PlatformError>;

    /// Unmap a memory region.
    ///
    /// Unmap the specified virtual-memory range and release its mapping resources.
    /// Page alignment, commit behavior, and memory fault semantics follow host virtual-memory rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses munmap(2) on Unix and UnmapViewOfFile/VirtualFree on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.munmap", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function munmap(mapping: Slice<uint8>): Result<void, PlatformError>;

    /// Change memory protection for a mapping.
    ///
    /// Change memory protection for a mapping via host kernel APIs.
    /// Page alignment, commit behavior, and memory fault semantics follow host virtual-memory rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses mprotect(2) on Unix and VirtualProtect on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.mprotect", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function mprotect(mapping: Slice<uint8>, prot: MmapProt): Result<void, PlatformError>;

    /// Flush a mapping to storage.
    ///
    /// Flush a mapping to storage via host kernel APIs.
    /// Return values and failures map directly to host contracts so higher layers can apply policy explicitly.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses msync(2) on Unix and FlushViewOfFile on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.msync", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function msync(mapping: Slice<uint8>, flags: MmapSyncFlags): Result<void, PlatformError>;

    /// Advise the kernel about access patterns.
    ///
    /// Advise the kernel about access patterns via host kernel APIs.
    /// Return values and failures map directly to host contracts so higher layers can apply policy explicitly.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses madvise(2) on Unix and advisory memory APIs where available on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `fs.mmap`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.fs.mmap.madvise", {
        effect: "external",
        replay: "recordable",
        capabilities: ["fs.mmap"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function madvise(mapping: Slice<uint8>, advice: MmapAdvice): Result<void, PlatformError>;
}
