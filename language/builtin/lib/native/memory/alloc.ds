/// Allocate raw memory.
/// Returns null on allocation failure.
@intrinsic
declare function rawAlloc(size: uint64, align: uint64): *unknown;

/// Free raw memory.
@intrinsic
declare function rawFree(ptr: *unknown): void;

/// Reallocate raw memory.
@intrinsic
declare function rawRealloc(ptr: *unknown, newSize: uint64, align: uint64): *unknown;
