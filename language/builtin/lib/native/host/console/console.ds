import { extern } from "../../../../core/intrinsic/decorator.ds";

/// Console bindings for native runtime.
declare namespace console {
    /// Write a line to stdout.
    @extern("destack.console.log")
    export function log(value: string): void;

    /// Write an info line to stdout.
    @extern("destack.console.info")
    export function info(value: string): void;

    /// Write a warning line to stderr.
    @extern("destack.console.warn")
    export function warn(value: string): void;

    /// Write an error line to stderr.
    @extern("destack.console.error")
    export function error(value: string): void;
}
