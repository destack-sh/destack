/// File offset in bytes.
export newtype FileOffset = int64;

/// File size in bytes.
export newtype FileSize = uint64;

/// Open flags for file descriptors.
export newtype OpenFlags = uint32;

/// Copy flags for copyfile-style operations.
export newtype CopyFlags = uint32;

/// Allocation flags for fallocate-style operations.
export newtype AllocFlags = uint32;

/// Sync flags for sync_file_range-style operations.
export newtype SyncFlags = uint32;

/// Read and write modifier flags for positioned and vectored I/O.
export newtype ReadWriteFlags = uint32;

/// File permission mode bits.
export newtype FileMode = uint32;

/// Access mode bitmask for access checks.
export newtype AccessMode = uint32;

/// Flags for *at-style operations.
export newtype AtFlags = uint32;

/// Flags for file locking operations.
export newtype FileLockFlags = uint32;

/// Resolve flags for openat2.
export newtype OpenResolveFlags = uint64;

/// Flags for renameat2.
export newtype RenameFlags = uint32;

/// File descriptor flags for fcntl(F_GETFD/F_SETFD).
export newtype FdFlags = uint32;

/// File status flags for fcntl(F_GETFL/F_SETFL).
export newtype StatusFlags = uint32;

/// Device identifier for mknod-style calls.
export newtype NodeDevice = uint64;

/// Pipe and descriptor splice flags.
export newtype SpliceFlags = uint32;

/// Seek origin for seek operations.
export enum SeekWhence {
    /// Seek from the start of the file.
    Set = 0,
    /// Seek from the current offset.
    Cur = 1,
    /// Seek from the end of the file.
    End = 2,
}

/// File access pattern advice.
export enum FileAdvice {
    /// No special behavior.
    Normal = 0,
    /// File will be accessed sequentially.
    Sequential = 1,
    /// File will be accessed randomly.
    Random = 2,
    /// File data will be needed soon.
    WillNeed = 3,
    /// File data will not be needed soon.
    DontNeed = 4,
    /// File data will be used once.
    NoReuse = 5,
}
