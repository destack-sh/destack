import { DirectoryHandle, FileHandle } from "../resource/resource.ds";

/// File offset in bytes.
export newtype FileOffset = uint64;

/// File size in bytes.
export newtype FileSize = uint64;

/// Open flags for file descriptors.
export newtype OpenFlags = uint32;

/// File permission mode bits.
export newtype FileMode = uint32;

/// Access mode bitmask for access checks.
export newtype AccessMode = uint32;

/// File type for directory entries.
export enum DirentKind {
    /// A regular file.
    File = 1,
    /// A directory.
    Directory = 2,
    /// A symbolic link.
    Symlink = 3,
    /// A block device.
    BlockDevice = 4,
    /// A character device.
    CharDevice = 5,
    /// A FIFO/pipe.
    Fifo = 6,
    /// A socket.
    Socket = 7,
    /// An unknown type.
    Unknown = 255,
}

/// Directory entry metadata.
export struct Dirent {
    /// Entry name.
    name: string,
    /// Entry kind.
    kind: DirentKind,
}

/// File metadata returned by stat calls.
export struct Stat {
    /// Device id.
    dev: uint64,
    /// Inode number.
    ino: uint64,
    /// File mode bits.
    mode: uint32,
    /// Hard link count.
    nlink: uint32,
    /// User id of owner.
    uid: uint32,
    /// Group id of owner.
    gid: uint32,
    /// Device id for special files.
    rdev: uint64,
    /// File size in bytes.
    size: FileSize,
    /// Block size for filesystem I/O.
    blksize: uint64,
    /// Number of allocated blocks.
    blocks: uint64,
    /// Last access time in nanoseconds.
    atimeNs: uint64,
    /// Last modification time in nanoseconds.
    mtimeNs: uint64,
    /// Last status change time in nanoseconds.
    ctimeNs: uint64,
    /// File creation time in nanoseconds.
    birthtimeNs: uint64,
}

/// Filesystem metadata returned by statfs calls.
export struct StatFs {
    /// Optimal transfer block size.
    bsize: uint64,
    /// Fragment size.
    frsize: uint64,
    /// Total data blocks in filesystem.
    blocks: uint64,
    /// Free blocks in filesystem.
    bfree: uint64,
    /// Free blocks available to unprivileged user.
    bavail: uint64,
    /// Total file nodes in filesystem.
    files: uint64,
    /// Free file nodes in filesystem.
    ffree: uint64,
    /// Filesystem ID.
    fsid: uint64,
    /// Mount flags.
    flags: uint64,
    /// Maximum filename length.
    namelen: uint64,
}

/// File handle for stat variants.
export newtype StatFileHandle = FileHandle;

/// Directory handle for readdir variants.
export newtype DirHandle = DirectoryHandle;
