import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import {
    GpuBufferHandle,
    GpuDeviceHandle,
    GpuSamplerHandle,
    GpuTextureHandle,
    GpuTextureViewHandle,
} from "../resource/index.ds";

/// GPU buffer creation options.
export struct GpuBufferOptions {
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: uint64;
    /// Whether the buffer starts mapped for host access.
    mappedAtCreation: boolean;
    /// Buffer option flags.
    flags: uint32;
}

/// GPU texture creation options.
export struct GpuTextureOptions {
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: uint32;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
    /// Texture usage bitset.
    usage: uint64;
    /// Additional compatible texture-view format identifiers.
    viewFormats: Slice<uint32>;
    /// Texture option flags.
    flags: uint32;
}

/// GPU texture-view creation options.
export struct GpuTextureViewOptions {
    /// View format identifier, zero to inherit the texture format.
    format: uint32;
    /// View dimension selector.
    dimension: uint32;
    /// Base mip-level index.
    baseMipLevel: uint32;
    /// Mip-level count, zero for all remaining levels.
    mipLevelCount: uint32;
    /// Base array-layer index.
    baseArrayLayer: uint32;
    /// Array-layer count, zero for all remaining layers.
    arrayLayerCount: uint32;
    /// Texture aspect selector.
    aspect: uint32;
    /// Texture-view option flags.
    flags: uint32;
}

/// GPU sampler creation options.
export struct GpuSamplerOptions {
    /// Minification filter selector.
    minFilter: uint32;
    /// Magnification filter selector.
    magFilter: uint32;
    /// Mipmap filter selector.
    mipFilter: uint32;
    /// Address mode u selector.
    addressU: uint32;
    /// Address mode v selector.
    addressV: uint32;
    /// Address mode w selector.
    addressW: uint32;
    /// Sampler LOD minimum clamp.
    lodMinClamp: float64;
    /// Sampler LOD maximum clamp.
    lodMaxClamp: float64;
    /// Compare-function selector, zero when comparison is disabled.
    compare: uint32;
    /// Maximum anisotropy level.
    maxAnisotropy: uint16;
    /// Sampler option flags.
    flags: uint32;
}

/// Buffer mapping mode.
export enum GpuMapMode {
    /// Read-only map mode.
    Read = 1,
    /// Write-only map mode.
    Write = 2,
}

/// Buffer map-state selector.
export enum GpuBufferMapState {
    /// Buffer is not currently mapped.
    Unmapped = 1,
    /// Buffer map request is pending.
    Pending = 2,
    /// Buffer is currently mapped.
    Mapped = 3,
}

/// Texture dimension selector.
export enum GpuTextureDimension {
    /// One-dimensional texture.
    D1 = 1,
    /// Two-dimensional texture.
    D2 = 2,
    /// Three-dimensional texture.
    D3 = 3,
}

/// GPU mapped buffer range.
export struct GpuMappedBufferRange {
    /// Host-visible pointer address represented as integer.
    address: uint64;
    /// Mapped byte length.
    length: uint64;
    /// Whether cache coherence is guaranteed for this mapping.
    coherent: boolean;
}

/// Buffer metadata snapshot.
export struct GpuBufferInfo {
    /// Buffer size in bytes.
    size: uint64;
    /// Buffer usage bitset.
    usage: uint64;
    /// Current map-state selector.
    mapState: GpuBufferMapState;
}

/// Texture metadata snapshot.
export struct GpuTextureInfo {
    /// Texture width in texels.
    width: uint32;
    /// Texture height in texels.
    height: uint32;
    /// Texture depth or layer count.
    depthOrLayers: uint32;
    /// Texture mip-level count.
    mipLevels: uint32;
    /// Texture sample count.
    samples: uint32;
    /// Texture format identifier.
    format: uint32;
    /// Texture usage bitset.
    usage: uint64;
    /// Texture dimension selector.
    dimension: GpuTextureDimension;
}

/// GPU resource bindings.
declare namespace gpu {
    /// Create one GPU buffer.
    ///
    /// Create one buffer resource on one logical device with explicit size and usage flags.
    /// Allocation placement and memory domain are host backend decisions.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style buffer creation operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferCreate", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferCreate(
        device: GpuDeviceHandle,
        options: GpuBufferOptions,
    ): Result<GpuBufferHandle, PlatformError>;

    /// Destroy one GPU buffer.
    ///
    /// Destroy one buffer resource and release host backend memory references.
    /// Outstanding use of the buffer is host-undefined and must be synchronized by callers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style buffer destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferDestroy", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferDestroy(handle: GpuBufferHandle): Result<void, PlatformError>;

    /// Write one byte range to one GPU buffer.
    ///
    /// Write one byte range into one buffer resource from host memory.
    /// Host staging and synchronization behavior follow backend upload semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style upload or mapped-write paths on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferWrite", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferWrite(
        handle: GpuBufferHandle,
        offset: uint64,
        bytes: Slice<uint8>,
    ): Result<void, PlatformError>;

    /// Read one byte range from one GPU buffer.
    ///
    /// Read one byte range from one buffer resource into host-visible memory.
    /// Readback can stall based on backend synchronization and transfer state.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style readback or mapped-read paths on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferRead(
        handle: GpuBufferHandle,
        offset: uint64,
        length: uint64,
    ): Result<Slice<uint8>, PlatformError>;

    /// Map one buffer range.
    ///
    /// Map one host-visible byte range for direct CPU access.
    /// Mapping coherence and cache behavior follow host backend memory rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style buffer map operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferMap", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferMap(
        handle: GpuBufferHandle,
        offset: uint64,
        length: uint64,
        mode: GpuMapMode,
    ): Result<GpuMappedBufferRange, PlatformError>;

    /// Unmap one mapped buffer.
    ///
    /// Unmap one previously mapped buffer range and flush host synchronization as required.
    /// Visibility of writes follows backend memory model semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style buffer unmap operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferUnmap", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function bufferUnmap(handle: GpuBufferHandle): Result<void, PlatformError>;

    /// Read one buffer metadata snapshot.
    ///
    /// Read one metadata snapshot for one buffer resource.
    /// Snapshot values remain stable except map state, which can change asynchronously.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style buffer property query operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.bufferInfo", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "never",
    })
    export function bufferInfo(handle: GpuBufferHandle): Result<GpuBufferInfo, PlatformError>;

    /// Create one texture resource.
    ///
    /// Create one texture resource with explicit dimensions, format, and usage flags.
    /// Allocation placement and tiling are host backend decisions.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style texture creation operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.textureCreate", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function textureCreate(
        device: GpuDeviceHandle,
        options: GpuTextureOptions,
    ): Result<GpuTextureHandle, PlatformError>;

    /// Destroy one texture resource.
    ///
    /// Destroy one texture resource and release host backend memory references.
    /// Outstanding use of the texture must be synchronized by callers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style texture destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.textureDestroy", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function textureDestroy(handle: GpuTextureHandle): Result<void, PlatformError>;

    /// Read one texture metadata snapshot.
    ///
    /// Read one metadata snapshot for one texture resource.
    /// Snapshot values remain stable for the texture lifetime.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style texture property query operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.textureInfo", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "never",
    })
    export function textureInfo(handle: GpuTextureHandle): Result<GpuTextureInfo, PlatformError>;

    /// Create one texture view.
    ///
    /// Create one view of one texture resource for bindings and render attachments.
    /// View range and dimension are validated against the source texture descriptor.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style texture-view creation operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.textureViewCreate", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function textureViewCreate(
        texture: GpuTextureHandle,
        options: GpuTextureViewOptions,
    ): Result<GpuTextureViewHandle, PlatformError>;

    /// Destroy one texture view.
    ///
    /// Destroy one texture-view endpoint and release backend view resources.
    /// The texture-view handle becomes invalid after destroy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style texture-view destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.textureViewDestroy", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function textureViewDestroy(handle: GpuTextureViewHandle): Result<void, PlatformError>;

    /// Create one sampler resource.
    ///
    /// Create one sampler resource with explicit filter and address mode selections.
    /// Sampler state maps to host backend sampler descriptors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style sampler creation operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.samplerCreate", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function samplerCreate(
        device: GpuDeviceHandle,
        options: GpuSamplerOptions,
    ): Result<GpuSamplerHandle, PlatformError>;

    /// Destroy one sampler resource.
    ///
    /// Destroy one sampler resource and release host backend references.
    /// The sampler handle becomes invalid after destroy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style sampler destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.memory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.resource.samplerDestroy", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.memory"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function samplerDestroy(handle: GpuSamplerHandle): Result<void, PlatformError>;
}
