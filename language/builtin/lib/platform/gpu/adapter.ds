import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { GpuAdapterHandle } from "../resource/index.ds";

/// GPU backend selector.
export enum GpuBackend {
    /// Vulkan backend.
    Vulkan = 1,
    /// Metal backend.
    Metal = 2,
    /// Direct3D 12 backend.
    D3D12 = 3,
    /// OpenGL backend.
    OpenGL = 4,
    /// WebGPU backend.
    WebGpu = 5,
    /// Null backend for tests and simulation.
    Null = 255,
}

/// GPU adapter category.
export enum GpuAdapterType {
    /// Integrated GPU.
    Integrated = 1,
    /// Discrete GPU.
    Discrete = 2,
    /// Software or CPU adapter.
    Cpu = 3,
    /// Unknown adapter type.
    Unknown = 255,
}

/// Power preference for adapter selection.
export enum GpuPowerPreference {
    /// Prefer lower power adapters.
    LowPower = 1,
    /// Prefer higher performance adapters.
    HighPerformance = 2,
    /// Do not request a specific preference.
    None = 3,
}

/// Adapter discovery options.
export struct GpuAdapterRequest {
    /// Preferred backend. Zero means backend agnostic.
    backend: uint32;
    /// Preferred power profile.
    powerPreference: GpuPowerPreference;
    /// Whether software fallback adapters are allowed.
    allowFallback: boolean;
}

/// GPU adapter information.
export struct GpuAdapterInfo {
    /// Stable runtime adapter identifier.
    id: string;
    /// Host adapter name.
    name: string;
    /// Backend API kind.
    backend: GpuBackend;
    /// Adapter category.
    adapterType: GpuAdapterType;
    /// Vendor identifier when available.
    vendorId: uint32;
    /// Device identifier when available.
    deviceId: uint32;
    /// Supported feature bitset.
    featureMask: uint64;
    /// Maximum bind groups supported by this adapter.
    maxBindGroups: uint32;
    /// Maximum 2D texture dimension.
    maxTextureDimension2D: uint32;
    /// Maximum storage buffer binding size.
    maxStorageBufferBindingSize: uint64;
}

/// GPU adapter bindings.
declare namespace gpu {
    /// List available GPU adapters.
    ///
    /// Enumerate host GPU adapters and return stable identifiers with normalized capability metadata.
    /// Adapter visibility and ordering follow host graphics API enumeration behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses Vulkan, Metal, D3D12, OpenGL, and backend discovery APIs.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.adapter`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.adapter.list", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.adapter"],
        scope: "os",
        blocking: "sometimes",
    })
    export function adapterList(request: GpuAdapterRequest): Result<Array<GpuAdapterInfo>, PlatformError>;

    /// Open one GPU adapter.
    ///
    /// Open one host GPU adapter endpoint for device creation and capability queries.
    /// Handle lifetime follows host backend object ownership semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific adapter open or retain operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.adapter`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.adapter.open", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.adapter"],
        scope: "os",
        blocking: "sometimes",
    })
    export function adapterOpen(id: string): Result<GpuAdapterHandle, PlatformError>;

    /// Read metadata for one opened adapter.
    ///
    /// Query the current normalized adapter metadata through an opened adapter handle.
    /// Returned values reflect host backend limits and feature reporting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend adapter property and feature query operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.adapter`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.adapter.info", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.adapter"],
        scope: "os",
        blocking: "never",
    })
    export function adapterInfo(handle: GpuAdapterHandle): Result<GpuAdapterInfo, PlatformError>;

    /// Close one GPU adapter.
    ///
    /// Close one opened adapter endpoint and release host backend references.
    /// The adapter handle becomes invalid after close.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific release or destroy operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.adapter`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.adapter.close", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.adapter"],
        scope: "os",
        blocking: "never",
    })
    export function adapterClose(handle: GpuAdapterHandle): Result<void, PlatformError>;
}
