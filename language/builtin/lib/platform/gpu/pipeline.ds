import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import {
    GpuDeviceHandle,
    GpuPipelineHandle,
    GpuShaderHandle,
} from "../resource/index.ds";

/// GPU shader stage selector.
export enum GpuShaderStage {
    /// Vertex stage.
    Vertex = 1,
    /// Fragment stage.
    Fragment = 2,
    /// Compute stage.
    Compute = 3,
}

/// GPU shader module options.
export struct GpuShaderOptions {
    /// Shader stage selector.
    stage: GpuShaderStage;
    /// Shader binary format selector.
    format: uint32;
    /// Shader entry point name.
    entry: string;
}

/// Compute pipeline creation options.
export struct GpuComputePipelineOptions {
    /// Compute shader module.
    shader: GpuShaderHandle;
    /// Compute shader entry point.
    entry: string;
    /// Pipeline option flags.
    flags: uint32;
}

/// Render pipeline creation options.
export struct GpuRenderPipelineOptions {
    /// Vertex shader module.
    vertexShader: GpuShaderHandle;
    /// Vertex shader entry point.
    vertexEntry: string;
    /// Fragment shader module.
    fragmentShader: GpuShaderHandle;
    /// Fragment shader entry point.
    fragmentEntry: string;
    /// Color attachment format identifier.
    colorFormat: uint32;
    /// Depth stencil format identifier, zero when unused.
    depthStencilFormat: uint32;
    /// Sample count.
    sampleCount: uint32;
    /// Pipeline option flags.
    flags: uint32;
}

/// GPU pipeline bindings.
declare namespace gpu {
    /// Create one shader module.
    ///
    /// Create one shader module from one binary payload and explicit stage metadata.
    /// Shader validation and backend translation follow host compiler rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend shader module creation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.shader`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.pipeline.shaderCreate", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.shader"],
        scope: "os",
        blocking: "sometimes",
    })
    export function shaderCreate(
        device: GpuDeviceHandle,
        options: GpuShaderOptions,
        bytes: Slice<uint8>,
    ): Result<GpuShaderHandle, PlatformError>;

    /// Destroy one shader module.
    ///
    /// Destroy one shader module and release backend compiler or cache resources.
    /// The shader handle becomes invalid after destroy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend shader module destroy operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.shader`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.pipeline.shaderDestroy", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.shader"],
        scope: "os",
        blocking: "never",
    })
    export function shaderDestroy(handle: GpuShaderHandle): Result<void, PlatformError>;

    /// Create one compute pipeline.
    ///
    /// Create one compute pipeline with one explicit compute stage descriptor.
    /// Pipeline compilation and cache behavior follow host backend semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend compute pipeline creation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.compute`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.pipeline.computeCreate", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.compute"],
        scope: "os",
        blocking: "sometimes",
    })
    export function computePipelineCreate(
        device: GpuDeviceHandle,
        options: GpuComputePipelineOptions,
    ): Result<GpuPipelineHandle, PlatformError>;

    /// Create one render pipeline.
    ///
    /// Create one render pipeline with explicit vertex and fragment stages and attachment formats.
    /// Pipeline compilation and backend render state linkage follow host API semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend render pipeline creation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.pipeline.renderCreate", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.render"],
        scope: "os",
        blocking: "sometimes",
    })
    export function renderPipelineCreate(
        device: GpuDeviceHandle,
        options: GpuRenderPipelineOptions,
    ): Result<GpuPipelineHandle, PlatformError>;

    /// Destroy one pipeline object.
    ///
    /// Destroy one pipeline object and release backend compiled state.
    /// Outstanding command lists referencing the pipeline should be synchronized by callers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend pipeline destroy operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.compute`, `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.pipeline.destroy", {
        effect: "external",
        replay: "recordable",
        requires: ["gpu.compute", "gpu.render"],
        scope: "os",
        blocking: "sometimes",
    })
    export function pipelineDestroy(handle: GpuPipelineHandle): Result<void, PlatformError>;
}
