import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import {
    GpuBindGroupHandle,
    GpuBufferHandle,
    GpuCommandListHandle,
    GpuComputePassHandle,
    GpuDeviceHandle,
    GpuPipelineHandle,
    GpuQuerySetHandle,
    GpuQueueHandle,
    GpuRenderPassHandle,
    GpuRenderBundleEncoderHandle,
    GpuRenderBundleHandle,
    GpuTextureHandle,
    GpuTextureViewHandle,
} from "../resource/index.ds";

/// Command encoder creation options.
export struct GpuCommandEncoderOptions {
    /// Encoder option flags.
    flags: uint32;
}

/// Render-bundle-encoder creation options.
export struct GpuRenderBundleEncoderOptions {
    /// Color attachment format identifiers.
    colorFormats: Slice<uint32>;
    /// Depth-stencil format identifier, zero when unused.
    depthStencilFormat: uint32;
    /// Sample count.
    sampleCount: uint32;
    /// Bundle-encoder option flags.
    flags: uint32;
}

/// Queue submission options.
export struct GpuSubmitOptions {
    /// Submit option flags.
    flags: uint32;
    /// Optional wait timeout in nanoseconds.
    timeoutNs: uint64;
}

/// Render-pass load operation selector.
export enum GpuLoadOp {
    /// Load operation is unspecified.
    Undefined = 0,
    /// Keep existing attachment contents.
    Load = 1,
    /// Clear attachment contents.
    Clear = 2,
}

/// Render-pass store operation selector.
export enum GpuStoreOp {
    /// Store operation is unspecified.
    Undefined = 0,
    /// Store attachment contents.
    Store = 1,
    /// Discard attachment contents.
    Discard = 2,
}

/// Render-pass color-attachment descriptor.
export struct GpuRenderPassColorAttachment {
    /// Render-target texture-view handle.
    view: GpuTextureViewHandle;
    /// Resolve-target texture-view handle when provided.
    resolveTarget: GpuTextureViewHandle | void;
    /// Color load operation.
    loadOp: GpuLoadOp;
    /// Color store operation.
    storeOp: GpuStoreOp;
    /// Clear color red component.
    clearColorR: float64;
    /// Clear color green component.
    clearColorG: float64;
    /// Clear color blue component.
    clearColorB: float64;
    /// Clear color alpha component.
    clearColorA: float64;
}

/// Render-pass depth-stencil-attachment descriptor.
export struct GpuRenderPassDepthStencilAttachment {
    /// Depth-stencil texture-view handle.
    view: GpuTextureViewHandle;
    /// Depth load operation.
    depthLoadOp: GpuLoadOp;
    /// Depth store operation.
    depthStoreOp: GpuStoreOp;
    /// Clear depth value.
    clearDepth: float64;
    /// Whether depth attachment is read-only.
    depthReadOnly: boolean;
    /// Stencil load operation.
    stencilLoadOp: GpuLoadOp;
    /// Stencil store operation.
    stencilStoreOp: GpuStoreOp;
    /// Clear stencil value.
    clearStencil: uint32;
    /// Whether stencil attachment is read-only.
    stencilReadOnly: boolean;
}

/// Render-pass descriptor.
export struct GpuRenderPassOptions {
    /// Render-pass color attachments.
    colorAttachments: Slice<GpuRenderPassColorAttachment>;
    /// Render-pass depth-stencil attachment descriptor when provided.
    depthStencil: GpuRenderPassDepthStencilAttachment | void;
    /// Timestamp-write descriptor when enabled.
    timestampWrites: GpuPassTimestampWrites | void;
    /// Pass-wide occlusion query set when enabled.
    occlusionQuerySet: GpuQuerySetHandle | void;
}

/// Pass timestamp-write descriptor.
export struct GpuPassTimestampWrites {
    /// Query set receiving pass timestamps.
    querySet: GpuQuerySetHandle;
    /// Beginning-of-pass query index when enabled.
    beginningWriteIndex: uint32 | void;
    /// End-of-pass query index when enabled.
    endWriteIndex: uint32 | void;
}

/// Compute-pass descriptor.
export struct GpuComputePassOptions {
    /// Timestamp-write descriptor when enabled.
    timestampWrites: GpuPassTimestampWrites | void;
    /// Compute-pass option flags.
    flags: uint32;
}

/// 3D extent descriptor.
export struct GpuExtent3D {
    /// Width in texels.
    width: uint32;
    /// Height in texels.
    height: uint32;
    /// Depth or array layer count.
    depthOrArrayLayers: uint32;
}

/// Texture copy source or destination descriptor.
export struct GpuTextureCopy {
    /// Texture handle.
    texture: GpuTextureHandle;
    /// Mip level index.
    mipLevel: uint32;
    /// Origin x coordinate.
    originX: uint32;
    /// Origin y coordinate.
    originY: uint32;
    /// Origin z coordinate.
    originZ: uint32;
    /// Texture aspect selector.
    aspect: uint32;
}

/// Buffer copy layout descriptor.
export struct GpuBufferCopyLayout {
    /// Byte offset in the buffer.
    offset: uint64;
    /// Bytes per row.
    bytesPerRow: uint32;
    /// Rows per image.
    rowsPerImage: uint32;
}

/// Buffer copy source or destination descriptor.
export struct GpuBufferCopy {
    /// Buffer handle.
    buffer: GpuBufferHandle;
    /// Buffer layout metadata.
    layout: GpuBufferCopyLayout;
}

/// Index element format selector.
export enum GpuIndexFormat {
    /// Index format is unspecified.
    Undefined = 0,
    /// Unsigned 16-bit indices.
    Uint16 = 1,
    /// Unsigned 32-bit indices.
    Uint32 = 2,
}

/// GPU command bindings.
declare namespace gpu {
    /// Open one command encoder.
    ///
    /// Open one command encoder object for recording backend commands.
    /// Encoder lifecycle follows backend recording and submission semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style command encoder or command buffer creation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.queue`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.encoderOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.queue"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function commandEncoderOpen(
        device: GpuDeviceHandle,
        options: GpuCommandEncoderOptions,
    ): Result<GpuCommandListHandle, PlatformError>;

    /// Close one command encoder.
    ///
    /// Close one command encoder object and release backend recording resources.
    /// The encoder handle becomes invalid after close.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style command encoder destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.queue`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.encoderClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.queue"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandEncoderClose(handle: GpuCommandListHandle): Result<void, PlatformError>;

    /// Finish one command encoder.
    ///
    /// Finalize recording for one command encoder and make it ready for queue submission.
    /// Finalization semantics follow backend validation rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style end command recording calls on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.queue`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.encoderFinish", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.queue"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function commandEncoderFinish(handle: GpuCommandListHandle): Result<void, PlatformError>;

    /// Open one render-bundle encoder.
    ///
    /// Open one render-bundle encoder object for pre-recording reusable draw commands.
    /// Bundle-encoder configuration defines attachment compatibility requirements.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle or secondary-command-buffer creation APIs on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleEncoderOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function renderBundleEncoderOpen(
        device: GpuDeviceHandle,
        options: GpuRenderBundleEncoderOptions,
    ): Result<GpuRenderBundleEncoderHandle, PlatformError>;

    /// Close one render-bundle encoder without producing a bundle.
    ///
    /// Close one opened bundle encoder and release recording resources.
    /// Any recorded commands are discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style bundle-encoder destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleEncoderClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleEncoderClose(handle: GpuRenderBundleEncoderHandle): Result<void, PlatformError>;

    /// Finish one render-bundle encoder.
    ///
    /// Finalize one render-bundle encoder and produce one reusable render bundle.
    /// The encoder handle becomes invalid after successful finish.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style bundle finalize operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleEncoderFinish", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function renderBundleEncoderFinish(
        handle: GpuRenderBundleEncoderHandle,
    ): Result<GpuRenderBundleHandle, PlatformError>;

    /// Begin one compute pass.
    ///
    /// Begin compute-pass encoding on one command encoder with optional timestamp writes.
    /// Returns one compute-pass handle for pass-scoped commands.
    /// Nested pass semantics follow backend command recording rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style begin compute pass commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `gpu.compute`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.computePassBegin", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.compute"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandComputePassBegin(
        handle: GpuCommandListHandle,
        options: GpuComputePassOptions,
    ): Result<GpuComputePassHandle, PlatformError>;

    /// End one compute pass.
    ///
    /// End compute-pass encoding for one active compute-pass handle.
    /// Pass finalization follows backend validation behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style end compute pass commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.compute`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.computePassEnd", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.compute"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandComputePassEnd(handle: GpuComputePassHandle): Result<void, PlatformError>;

    /// Begin one render pass.
    ///
    /// Begin render-pass encoding on one command encoder with explicit attachments and optional query wiring.
    /// Attachment load, clear, timestamp, and occlusion behavior follow backend render pass semantics.
    /// Returns one render-pass handle for pass-scoped commands.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style begin render pass commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderPassBegin", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandRenderPassBegin(
        handle: GpuCommandListHandle,
        options: GpuRenderPassOptions,
    ): Result<GpuRenderPassHandle, PlatformError>;

    /// End one render pass.
    ///
    /// End render-pass encoding for one active render-pass handle.
    /// Pass finalization follows backend validation behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style end render pass commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderPassEnd", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandRenderPassEnd(handle: GpuRenderPassHandle): Result<void, PlatformError>;

    /// Execute one batch of render bundles in the active render pass.
    ///
    /// Execute recorded render bundles in-order within one active render pass.
    /// Bundle compatibility is validated against current render-pass configuration.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style execute-bundle commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.executeBundles", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function commandExecuteBundles(
        handle: GpuRenderPassHandle,
        bundles: Slice<GpuRenderBundleHandle>,
    ): Result<void, PlatformError>;

    /// Destroy one render bundle.
    ///
    /// Destroy one render-bundle object and release backend command storage.
    /// The bundle handle becomes invalid after destroy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle destroy operations on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleDestroy", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleDestroy(handle: GpuRenderBundleHandle): Result<void, PlatformError>;

    /// Bind one render pipeline for one bundle encoder.
    ///
    /// Bind one render pipeline in one render-bundle encoder.
    /// Binding state remains active for subsequent bundle draw commands.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle pipeline bind commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleSetPipeline", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleSetPipeline(
        handle: GpuRenderBundleEncoderHandle,
        pipeline: GpuPipelineHandle,
    ): Result<void, PlatformError>;

    /// Bind one bind group in one bundle encoder.
    ///
    /// Bind one bind group at the requested index for bundle recording.
    /// Dynamic offsets are interpreted in backend-defined binding order.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle bind-group commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.bind`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleSetBindGroup", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.bind"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleSetBindGroup(
        handle: GpuRenderBundleEncoderHandle,
        index: uint32,
        bindGroup: GpuBindGroupHandle,
        dynamicOffsets: Slice<uint32>,
    ): Result<void, PlatformError>;

    /// Bind one vertex buffer in one bundle encoder.
    ///
    /// Bind one vertex buffer slot with explicit byte range metadata.
    /// Vertex fetch semantics follow the bound render pipeline.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle vertex-buffer bind commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleSetVertexBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleSetVertexBuffer(
        handle: GpuRenderBundleEncoderHandle,
        slot: uint32,
        buffer: GpuBufferHandle,
        offset: uint64,
        size: uint64,
    ): Result<void, PlatformError>;

    /// Bind one index buffer in one bundle encoder.
    ///
    /// Bind one index buffer with explicit format and byte range metadata.
    /// Index fetch semantics follow backend draw-indexed contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle index-buffer bind commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleSetIndexBuffer", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleSetIndexBuffer(
        handle: GpuRenderBundleEncoderHandle,
        buffer: GpuBufferHandle,
        format: GpuIndexFormat,
        offset: uint64,
        size: uint64,
    ): Result<void, PlatformError>;

    /// Encode one non-indexed draw in one bundle encoder.
    ///
    /// Encode one non-indexed draw call with explicit vertex and instance ranges.
    /// Draw semantics follow backend bundle-encoding contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle draw commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleDraw", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleDraw(
        handle: GpuRenderBundleEncoderHandle,
        vertexCount: uint32,
        instanceCount: uint32,
        firstVertex: uint32,
        firstInstance: uint32,
    ): Result<void, PlatformError>;

    /// Encode one indexed draw in one bundle encoder.
    ///
    /// Encode one indexed draw call with explicit index and instance ranges.
    /// Draw semantics follow backend bundle-encoding contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle indexed draw commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleDrawIndexed", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleDrawIndexed(
        handle: GpuRenderBundleEncoderHandle,
        indexCount: uint32,
        instanceCount: uint32,
        firstIndex: uint32,
        baseVertex: int32,
        firstInstance: uint32,
    ): Result<void, PlatformError>;

    /// Encode one indirect non-indexed draw range in one bundle encoder.
    ///
    /// Encode one or more non-indexed draws loaded from one argument buffer.
    /// Indirect argument layout and alignment follow backend contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle draw-indirect commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleDrawIndirect", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleDrawIndirect(
        handle: GpuRenderBundleEncoderHandle,
        buffer: GpuBufferHandle,
        offset: uint64,
        drawCount: uint32,
        stride: uint32,
    ): Result<void, PlatformError>;

    /// Encode one indirect indexed draw range in one bundle encoder.
    ///
    /// Encode one or more indexed draws loaded from one argument buffer.
    /// Indirect argument layout and alignment follow backend contracts.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle indexed draw-indirect commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.render`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleDrawIndexedIndirect", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.render"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleDrawIndexedIndirect(
        handle: GpuRenderBundleEncoderHandle,
        buffer: GpuBufferHandle,
        offset: uint64,
        drawCount: uint32,
        stride: uint32,
    ): Result<void, PlatformError>;

    /// Insert one debug marker in one bundle encoder.
    ///
    /// Insert one lightweight marker in one active render-bundle encoding scope.
    /// Marker visibility is backend-defined and intended for tooling.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle marker commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `gpu.debug`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.gpu.command.renderBundleInsertDebugMarker", {
        effect: "external",
        replay: "recordable",
        capabilities: ["gpu.debug"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function renderBundleInsertDebugMarker(
        handle: GpuRenderBundleEncoderHandle,
        marker: string,
    ): Result<void, PlatformError>;

    /// Push one debug group in one bundle encoder.
    ///
    /// Push one nested debug group in one render-bundle encoder scope.
    /// Groups must be balanced with matching pop operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses WebGPU-style render-bundle debug-group push commands on Vulkan, Metal, D3D12, and OpenGL-class backends.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `gpu.debug`.
    ///
    /// # Replay
    /// External, recordable.
