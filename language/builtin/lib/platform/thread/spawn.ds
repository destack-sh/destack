import type { PlatformError } from "../error/index.ds";
import { ThreadHandle } from "../resource/index.ds";

/// Thread spawn options.
export struct ThreadOptions {
    /// Requested stack size in bytes.
    stackBytes: uint64;
    /// Thread creation flags.
    flags: uint32;
}

/// Thread lifecycle bindings.
declare namespace thread {
    /// Spawn one host thread.
    ///
    /// Spawn one host thread that enters a runtime-provided entry symbol.
    /// Entry dispatch and argument passing are runtime ABI contracts.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_create on Unix, CreateThread on Windows, and wasi thread support when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.start",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function spawn(entry: string, argument: uint64, options: ThreadOptions): Result<ThreadHandle, PlatformError>;

    /// Join one host thread.
    ///
    /// Wait for one joinable thread to exit and return its exit code.
    /// Join behavior follows host thread lifecycle rules.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_join on Unix, WaitForSingleObject plus exit code on Windows, and wasi equivalents where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.join",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function join(handle: ThreadHandle): Result<uint32, PlatformError>;

    /// Detach one host thread.
    ///
    /// Detach one thread from join tracking.
    /// Detached thread lifecycle and cleanup are host-managed.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_detach on Unix and handle-release semantics on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.detach",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function detach(handle: ThreadHandle): Result<void, PlatformError>;

    /// Read the current host thread handle.
    ///
    /// Return the runtime handle for the currently executing host thread.
    /// Handle identity and lifetime rules follow host threading primitives.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_self on Unix, GetCurrentThread on Windows, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.current",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "never",
        },
    )
    export function current(): Result<ThreadHandle, PlatformError>;

    /// Yield execution for the current host thread.
    ///
    /// Hint the host scheduler to run another runnable thread before continuing.
    /// Scheduling effect is host-defined and may be a no-op on some targets.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses sched_yield on Unix, SwitchToThread on Windows, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `thread.wait`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.yieldNow",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.wait"],
            scope: "os",
            blocking: "never",
        },
    )
    export function yieldNow(): Result<void, PlatformError>;

    /// Set one host thread name.
    ///
    /// Assign one debug-visible name to the target host thread.
    /// Name length and encoding limits are host-defined.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_setname_np on Unix, SetThreadDescription on Windows, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.thread.spawn.setName",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function setName(handle: ThreadHandle, name: string): Result<void, PlatformError>;

    /// Read one host thread name.
    ///
    /// Read one debug-visible name from the target host thread.
    /// Returned text is normalized from host representation by runtime policy.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses pthread_getname_np on Unix, GetThreadDescription on Windows, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `thread.spawn`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.thread.spawn.getName",
        {
            effect: "external",
            replay: "recordable",
            requires: ["thread.spawn"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function getName(handle: ThreadHandle): Result<string, PlatformError>;
}
