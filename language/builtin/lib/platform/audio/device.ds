import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { AudioDeviceHandle } from "../resource/index.ds";

/// Audio device direction.
export enum AudioDeviceDirection {
    /// Playback-only device.
    Playback = 1,
    /// Capture-only device.
    Capture = 2,
    /// Duplex playback and capture device.
    Duplex = 3,
    /// Capture endpoint for host loopback or monitor lanes.
    Loopback = 4,
}

/// Audio backend selector.
export enum AudioBackend {
    /// Select the best backend for the current host.
    Auto = 0,
    /// ALSA backend.
    Alsa = 1,
    /// PulseAudio backend.
    PulseAudio = 2,
    /// PipeWire backend.
    PipeWire = 3,
    /// CoreAudio backend.
    CoreAudio = 4,
    /// WASAPI backend.
    Wasapi = 5,
    /// AAudio backend.
    AAudio = 6,
    /// OpenSL ES backend.
    OpenSLES = 7,
    /// JACK backend.
    Jack = 8,
    /// ASIO backend.
    Asio = 9,
    /// Null backend for tests and simulation.
    Null = 255,
}

/// Backend selection policy.
export enum AudioBackendSelectionPolicy {
    /// Require that the requested backend is used with no fallback.
    Strict = 1,
    /// Allow fallback to a host-default backend when the requested backend is unavailable.
    AllowFallback = 2,
}

/// Audio stream share mode selector.
export enum AudioShareMode {
    /// Shared mode with host mixing.
    Shared = 1,
    /// Exclusive mode with direct endpoint access.
    Exclusive = 2,
}

/// Device list option flags.
export newtype AudioDeviceListFlags = uint32;

/// Device open option flags.
export newtype AudioDeviceOpenFlags = uint32;

/// Backend capability flags.
export newtype AudioBackendCapabilityFlags = uint64;

/// Device capability flags.
export newtype AudioDeviceCapabilityFlags = uint64;

/// Backend-specific open flags.
export newtype AudioBackendOpenFlags = uint64;

/// Audio sample format selector.
export enum AudioSampleFormat {
    /// Unsigned 8-bit PCM.
    U8 = 1,
    /// Signed 16-bit PCM.
    S16 = 2,
    /// Signed 24-bit PCM in 32-bit lanes.
    S24 = 3,
    /// Signed 32-bit PCM.
    S32 = 4,
    /// 32-bit floating-point PCM.
    F32 = 5,
    /// 64-bit floating-point PCM.
    F64 = 6,
}

/// Standard channel-layout selector.
export enum AudioChannelLayout {
    /// Backend did not report one canonical layout.
    Unknown = 0,
    /// Mono layout.
    Mono = 1,
    /// Stereo layout.
    Stereo = 2,
    /// Quadraphonic layout.
    Quad = 3,
    /// 4.1 surround layout.
    Surround41 = 4,
    /// 5.1 surround layout.
    Surround51 = 5,
    /// 6.1 surround layout.
    Surround61 = 6,
    /// 7.1 surround layout.
    Surround71 = 7,
    /// One custom layout described by a channel mask.
    Custom = 255,
}

/// Backend descriptor.
export struct AudioBackendDescriptor {
    /// Backend selector.
    backend: AudioBackend;
    /// Stable backend name.
    name: string;
    /// Whether this backend is currently available on this host.
    available: boolean;
    /// Priority in default auto-selection order.
    priority: uint16;
    /// Backend-level capability flags.
    capabilityFlags: AudioBackendCapabilityFlags;
}

/// Audio device list request.
export struct AudioDeviceListRequest {
    /// Device direction filter.
    direction: AudioDeviceDirection;
    /// Preferred backend selector.
    backend: AudioBackend;
    /// Backend selection policy.
    backendPolicy: AudioBackendSelectionPolicy;
    /// Request option flags.
    flags: AudioDeviceListFlags;
}

/// Audio device open options.
export struct AudioDeviceOpenOptions {
    /// Stream direction for the opened endpoint.
    direction: AudioDeviceDirection;
    /// Preferred backend selector.
    backend: AudioBackend;
    /// Backend selection policy.
    backendPolicy: AudioBackendSelectionPolicy;
    /// Shared or exclusive endpoint mode.
    shareMode: AudioShareMode;
    /// Open option flags.
    flags: AudioDeviceOpenFlags;
    /// Backend-specific open flags.
    backendFlags: AudioBackendOpenFlags;
    /// Backend-specific selector string.
    /// Examples: ASIO driver name, JACK client name, or one host endpoint profile.
    backendHint: string;
}

/// Audio device information.
export struct AudioDeviceDescriptor {
    /// Stable runtime device identifier.
    id: string;
    /// Stable group identifier used to correlate related endpoints.
    groupId: string;
    /// Host-facing device name.
    name: string;
    /// Backend transport name when available.
    transport: string;
    /// Host backend for this device.
    backend: AudioBackend;
    /// Device direction capability.
    direction: AudioDeviceDirection;
    /// Whether this device is currently connected.
    connected: boolean;
    /// Whether this device exposes raw or direct endpoint mode.
    isRaw: boolean;
    /// Whether this device is the default playback endpoint.
    isDefaultPlayback: boolean;
    /// Whether this device is the default capture endpoint.
    isDefaultCapture: boolean;
    /// Whether this device is the default loopback endpoint.
    isDefaultLoopback: boolean;
    /// Device-level capability flags.
    capabilityFlags: AudioDeviceCapabilityFlags;
    /// Preferred sample rate in hertz.
    preferredSampleRate: uint32;
    /// Minimum sample rate in hertz.
    minSampleRate: uint32;
    /// Maximum sample rate in hertz.
    maxSampleRate: uint32;
    /// Preferred period in frames.
    preferredPeriodFrames: uint32;
    /// Minimum channel count.
    minChannels: uint16;
    /// Maximum channel count.
    maxChannels: uint16;
    /// Preferred channel layout.
    preferredLayout: AudioChannelLayout;
    /// Preferred speaker channel mask when available.
    preferredChannelMask: uint64;
    /// Supported speaker channel mask when available.
    supportedChannelMask: uint64;
    /// Minimum low-latency period in frames.
    minPeriodFrames: uint32;
    /// Maximum period in frames.
    maxPeriodFrames: uint32;
    /// Supported sample format bitmask.
    formatMask: uint32;
    /// Supported share mode bitmask.
    /// Bit 0 is shared mode.
    /// Bit 1 is exclusive mode.
    shareModeMask: uint32;
}

/// Audio device bindings.
declare namespace audio {
    /// List host audio backends.
    ///
    /// Enumerate available backend implementations and backend-level feature flags.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors cubeb `cubeb_get_backend_names`, libsoundio `soundio_backend_count` plus `soundio_get_backend`, and miniaudio `ma_get_enabled_backends`.
    /// Mirrors PortAudio host-api enumeration through `PaHostApiTypeId`.
    ///
    /// # Errors
    /// Returns ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.backend.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function backendList(): Result<Slice<AudioBackendDescriptor>, PlatformError>;

    /// Trigger one backend rescan.
    ///
    /// Request one immediate backend device rescan.
    /// This allows recovery from stale backend snapshots after hotplug churn.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors libsoundio `soundio_force_device_scan` semantics and backend-native refresh flows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.rescan", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function deviceRescan(
        backend: AudioBackend,
        backendPolicy: AudioBackendSelectionPolicy,
    ): Result<void, PlatformError>;

    /// List available audio devices.
    ///
    /// Enumerate host audio endpoints and return stable identifiers for later open operations.
    /// Device visibility and ordering follow host backend semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available device enumeration.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function deviceList(request: AudioDeviceListRequest): Result<Slice<AudioDeviceDescriptor>, PlatformError>;

    /// Read one default device identifier for the selected direction.
    ///
    /// Resolve one default host audio endpoint for the selected direction and backend policy.
    /// Default selection can change asynchronously as host policy changes.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors cubeb and libsoundio default-endpoint query semantics.
    /// Mirrors SDL default logical-device routing behavior for playback and recording defaults.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.default", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function deviceDefault(
        direction: AudioDeviceDirection,
        backend: AudioBackend,
        backendPolicy: AudioBackendSelectionPolicy,
    ): Result<string, PlatformError>;

    /// Open one audio device endpoint.
    ///
    /// Open one host audio endpoint for playback, capture, duplex, or loopback operation.
    /// Handle lifetime and exclusivity semantics follow host backend rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available endpoint open operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function deviceOpen(
        id: string,
        options: AudioDeviceOpenOptions,
    ): Result<AudioDeviceHandle, PlatformError>;

    /// Read metadata for one opened device endpoint.
    ///
    /// Read one normalized snapshot for one opened device handle.
    /// Snapshot values are advisory and can change as host routes are updated.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available endpoint information query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.descriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function deviceDescriptor(handle: AudioDeviceHandle): Result<AudioDeviceDescriptor, PlatformError>;

    /// Close one audio device endpoint.
    ///
    /// Close one opened audio endpoint and release host resources.
    /// Close semantics follow host backend teardown behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available endpoint close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.device.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function deviceClose(handle: AudioDeviceHandle): Result<void, PlatformError>;
}

/// Default list behavior.
export const AUDIO_DEVICE_LIST_NONE: AudioDeviceListFlags = AudioDeviceListFlags(0x0);
/// Include disconnected or unavailable endpoints when possible.
export const AUDIO_DEVICE_LIST_INCLUDE_DISCONNECTED: AudioDeviceListFlags = AudioDeviceListFlags(0x1);
/// Include raw endpoints when the backend exposes separate raw rows.
export const AUDIO_DEVICE_LIST_INCLUDE_RAW: AudioDeviceListFlags = AudioDeviceListFlags(0x2);
/// Include loopback endpoints when the backend exposes loopback rows.
export const AUDIO_DEVICE_LIST_INCLUDE_LOOPBACK: AudioDeviceListFlags = AudioDeviceListFlags(0x4);
/// Include duplicate aliases when backend identity is ambiguous.
export const AUDIO_DEVICE_LIST_INCLUDE_DUPLICATES: AudioDeviceListFlags = AudioDeviceListFlags(0x8);

/// Default open behavior.
export const AUDIO_DEVICE_OPEN_NONE: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x0);
/// Follow default-route migrations for default endpoint identifiers.
export const AUDIO_DEVICE_OPEN_FOLLOW_DEFAULT_ROUTE: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x1);
/// Request low-latency scheduling policy where supported.
export const AUDIO_DEVICE_OPEN_LOW_LATENCY: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x2);
/// Disable backend-side automatic format conversion where possible.
export const AUDIO_DEVICE_OPEN_NO_AUTO_CONVERT: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x4);
/// Disable backend-side automatic stream routing where possible.
export const AUDIO_DEVICE_OPEN_NO_AUTO_ROUTE: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x8);
/// Request hardware offload lanes where available.
export const AUDIO_DEVICE_OPEN_HARDWARE_OFFLOAD: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x10);
/// Request realtime callback thread scheduling where available.
export const AUDIO_DEVICE_OPEN_REALTIME_THREAD: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x20);
/// Request raw endpoint mode where available.
export const AUDIO_DEVICE_OPEN_RAW: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x40);
/// Request explicit sample-format matching with no backend substitution.
export const AUDIO_DEVICE_OPEN_EXPLICIT_SAMPLE_FORMAT: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x80);
/// Request backend-default PCM routing for ALSA-style stacks.
export const AUDIO_DEVICE_OPEN_USE_DEFAULT_PCM: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x100);
/// Request JACK-style no-autoconnect behavior.
export const AUDIO_DEVICE_OPEN_JACK_DONT_CONNECT: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x200);
/// Request hard-exclusive endpoint ownership where available.
export const AUDIO_DEVICE_OPEN_HOG_DEVICE: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x400);
/// Request minimized callback period where available.
export const AUDIO_DEVICE_OPEN_MINIMIZE_LATENCY: AudioDeviceOpenFlags = AudioDeviceOpenFlags(0x800);

/// Default backend-open behavior.
export const AUDIO_BACKEND_OPEN_NONE: AudioBackendOpenFlags = AudioBackendOpenFlags(0x0);
/// Request one event-driven callback scheduling mode on WASAPI-like backends.
export const AUDIO_BACKEND_OPEN_WASAPI_EVENT_CALLBACK: AudioBackendOpenFlags = AudioBackendOpenFlags(0x1);
/// Request one exclusive endpoint path on backends that expose explicit exclusive mode.
export const AUDIO_BACKEND_OPEN_REQUIRE_EXCLUSIVE: AudioBackendOpenFlags = AudioBackendOpenFlags(0x2);
/// Request one host loopback path when supported by the selected backend.
export const AUDIO_BACKEND_OPEN_REQUIRE_LOOPBACK: AudioBackendOpenFlags = AudioBackendOpenFlags(0x4);
/// Request no-autoconnect behavior on JACK-like backends.
export const AUDIO_BACKEND_OPEN_JACK_NO_AUTOCONNECT: AudioBackendOpenFlags = AudioBackendOpenFlags(0x8);
/// Request no-resample behavior on ALSA-style backends.
export const AUDIO_BACKEND_OPEN_ALSA_NO_RESAMPLE: AudioBackendOpenFlags = AudioBackendOpenFlags(0x10);
/// Request hog mode on CoreAudio-like backends.
export const AUDIO_BACKEND_OPEN_COREAUDIO_HOG_MODE: AudioBackendOpenFlags = AudioBackendOpenFlags(0x20);
/// Request hardware timestamps when backend support exists.
export const AUDIO_BACKEND_OPEN_REQUIRE_HARDWARE_TIMESTAMPS: AudioBackendOpenFlags = AudioBackendOpenFlags(0x40);
/// Request bit-exact PCM path with no backend-side format conversion.
export const AUDIO_BACKEND_OPEN_REQUIRE_BIT_EXACT_PCM: AudioBackendOpenFlags = AudioBackendOpenFlags(0x80);

/// Backend supports hotplug notifications.
export const AUDIO_BACKEND_CAP_HOTPLUG_EVENTS: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x1);
/// Backend supports default-route change notifications.
export const AUDIO_BACKEND_CAP_DEFAULT_ROUTE_EVENTS: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x2);
/// Backend supports backend-disconnect notifications.
export const AUDIO_BACKEND_CAP_BACKEND_DISCONNECT_EVENTS: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x4);
/// Backend supports shared stream mode.
export const AUDIO_BACKEND_CAP_SHARED_MODE: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x8);
/// Backend supports exclusive stream mode.
export const AUDIO_BACKEND_CAP_EXCLUSIVE_MODE: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x10);
/// Backend supports loopback capture.
export const AUDIO_BACKEND_CAP_LOOPBACK: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x20);
/// Backend supports non-interleaved stream buffers.
export const AUDIO_BACKEND_CAP_NON_INTERLEAVED: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x40);
/// Backend supports device-clock or hardware timestamp correlation.
export const AUDIO_BACKEND_CAP_DEVICE_CLOCK: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x80);
/// Backend supports scheduled write or presentation-time submission.
export const AUDIO_BACKEND_CAP_SCHEDULED_WRITE: AudioBackendCapabilityFlags = AudioBackendCapabilityFlags(0x100);

/// Device supports shared stream mode.
export const AUDIO_DEVICE_CAP_SHARED_MODE: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x1);
/// Device supports exclusive stream mode.
export const AUDIO_DEVICE_CAP_EXCLUSIVE_MODE: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x2);
/// Device supports loopback capture.
export const AUDIO_DEVICE_CAP_LOOPBACK: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x4);
/// Device supports full-duplex stream lanes.
export const AUDIO_DEVICE_CAP_FULL_DUPLEX: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x8);
/// Device supports stream gain controls.
export const AUDIO_DEVICE_CAP_STREAM_VOLUME: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x10);
/// Device supports stream mute controls.
export const AUDIO_DEVICE_CAP_STREAM_MUTE: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x20);
/// Device supports scheduled write submission.
export const AUDIO_DEVICE_CAP_SCHEDULED_WRITE: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x40);
/// Device supports device-clock or hardware timestamp correlation.
export const AUDIO_DEVICE_CAP_DEVICE_CLOCK: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x80);
/// Device supports backend reroute notifications.
export const AUDIO_DEVICE_CAP_REROUTE_EVENTS: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x100);
/// Device supports interruption notifications.
export const AUDIO_DEVICE_CAP_INTERRUPTION_EVENTS: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x200);
/// Device supports backend disconnect notifications.
export const AUDIO_DEVICE_CAP_BACKEND_DISCONNECT_EVENTS: AudioDeviceCapabilityFlags = AudioDeviceCapabilityFlags(0x400);
