import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { AudioEventHandle, AudioStreamHandle } from "../resource/index.ds";
import { AudioBackend, AudioBackendSelectionPolicy } from "./device.ds";
import { AudioStreamStatusFlags } from "./stream.ds";

/// Event subscription flags.
export newtype AudioEventSubscriptionFlags = uint32;

/// Event delivery mode selector.
export enum AudioEventDeliveryMode {
    /// Use native backend events when available, otherwise synthesize from polling.
    Auto = 1,
    /// Require native backend events and fail when unavailable.
    NativeOnly = 2,
    /// Force synthesized polling-driven events.
    PollOnly = 3,
}

/// Event queue overflow policy selector.
export enum AudioEventOverflowPolicy {
    /// Drop oldest queued events first.
    DropOldest = 1,
    /// Drop newest incoming events first.
    DropNewest = 2,
    /// Report overflow as an error.
    Error = 3,
}

/// Event source selector.
export enum AudioEventSource {
    /// Event came from one native backend notification feed.
    Native = 1,
    /// Event was synthesized from runtime polling snapshots.
    SyntheticPoll = 2,
}

/// Audio event kind.
export enum AudioEventKind {
    /// One device became available.
    DeviceAdded = 1,
    /// One device became unavailable.
    DeviceRemoved = 2,
    /// Default playback device changed.
    DefaultPlaybackChanged = 3,
    /// Default capture device changed.
    DefaultCaptureChanged = 4,
    /// Default loopback device changed.
    DefaultLoopbackChanged = 5,
    /// Device format capabilities changed.
    DeviceFormatChanged = 6,
    /// Device stream route changed.
    DeviceRerouted = 7,
    /// Host interruption started.
    InterruptionBegan = 8,
    /// Host interruption ended.
    InterruptionEnded = 9,
    /// Backend disconnected.
    BackendDisconnected = 10,
    /// Stream reported one xrun.
    StreamXRun = 11,
    /// Stream device changed.
    StreamDeviceChanged = 12,
    /// Stream state changed.
    StreamStateChanged = 13,
    /// Backend session reset occurred.
    BackendReset = 14,
}

/// Event subscription options.
export struct AudioEventSubscriptionOptions {
    /// Backend selector for this subscription.
    backend: AudioBackend;
    /// Backend selection policy.
    backendPolicy: AudioBackendSelectionPolicy;
    /// Subscription behavior flags.
    flags: AudioEventSubscriptionFlags;
    /// Event delivery mode.
    deliveryMode: AudioEventDeliveryMode;
    /// Queue overflow policy.
    overflowPolicy: AudioEventOverflowPolicy;
    /// Whether this subscription also tracks one stream.
    hasStream: boolean;
    /// Stream to monitor when `hasStream` is true.
    stream: AudioStreamHandle;
    /// Requested queue capacity, or zero for backend default.
    queueCapacity: uint32;
    /// Requested backend poll interval in nanoseconds, or zero for backend default.
    pollIntervalNs: uint64;
}

/// Audio event payload.
export struct AudioEvent {
    /// Event kind selector.
    kind: AudioEventKind;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Event sequence number for one subscription queue.
    sequence: uint64;
    /// Number of events dropped before this event.
    droppedCount: uint64;
    /// Event source selector.
    source: AudioEventSource;
    /// Backend selector for this event.
    backend: AudioBackend;
    /// Event flags.
    flags: uint32;
    /// Current stream status flags when event kind is stream-related.
    statusFlags: AudioStreamStatusFlags;
    /// Xrun count delta when event kind is stream-related.
    xrunCountDelta: uint64;
    /// Whether one target device identifier is present.
    hasDeviceId: boolean;
    /// Target device identifier when `hasDeviceId` is true.
    deviceId: string;
    /// Whether one target stream handle is present.
    hasStream: boolean;
    /// Target stream handle when `hasStream` is true.
    stream: AudioStreamHandle;
}

/// Audio event bindings.
declare namespace audio {
    /// Open one audio event subscription.
    ///
    /// Open one backend event subscription for device and optional stream events.
    /// Subscription routing and queue depth follow host backend behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Mirrors cubeb device and stream change callbacks.
    /// Mirrors libsoundio device-change and backend-disconnect callback families.
    /// Mirrors miniaudio `ma_device_notification_proc` notification routing.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function eventOpen(options: AudioEventSubscriptionOptions): Result<AudioEventHandle, PlatformError>;

    /// Close one audio event subscription.
    ///
    /// Close one event subscription and release backend notification resources.
    /// Pending events are discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available notification unregistration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function eventClose(handle: AudioEventHandle): Result<void, PlatformError>;

    /// Wait for one audio event.
    ///
    /// Wait for one pending event from one subscription queue.
    /// Timeout uses nanoseconds in the runtime monotonic domain.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available event wait or callback-queue drain operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function eventRead(
        handle: AudioEventHandle,
        timeoutNs: uint64,
    ): Result<AudioEvent, PlatformError>;

    /// Wait for one batch of audio events.
    ///
    /// Wait for pending events from one subscription queue and return up to `maxEvents` events.
    /// Timeout uses nanoseconds in the runtime monotonic domain.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO queue-drain operations where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.readBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function eventReadBatch(
        handle: AudioEventHandle,
        maxEvents: uint32,
        timeoutNs: uint64,
    ): Result<Slice<AudioEvent>, PlatformError>;

    /// Poll one audio event without blocking.
    ///
    /// Poll one pending event from one subscription queue.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO where available nonblocking event queue reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function eventTryRead(handle: AudioEventHandle): Result<AudioEvent, PlatformError>;

    /// Poll one batch of audio events without blocking.
    ///
    /// Poll pending events from one subscription queue and return up to `maxEvents` events.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses ALSA, PulseAudio, PipeWire, CoreAudio, WASAPI, AAudio, OpenSL ES, JACK, and ASIO nonblocking queue-drain operations where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `audio.device.monitor`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.audio.event.tryReadBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["audio.device.monitor"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function eventTryReadBatch(
        handle: AudioEventHandle,
        maxEvents: uint32,
    ): Result<Slice<AudioEvent>, PlatformError>;
}

/// Subscribe to device hotplug add and remove events.
export const AUDIO_EVENT_SUBSCRIBE_DEVICE_HOTPLUG: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x1);
/// Subscribe to default-route change events.
export const AUDIO_EVENT_SUBSCRIBE_DEFAULT_ROUTE: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x2);
/// Subscribe to format-change events.
export const AUDIO_EVENT_SUBSCRIBE_FORMAT_CHANGE: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x4);
/// Subscribe to reroute events.
export const AUDIO_EVENT_SUBSCRIBE_REROUTE: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x8);
/// Subscribe to interruption begin and end events.
export const AUDIO_EVENT_SUBSCRIBE_INTERRUPTION: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x10);
/// Subscribe to backend disconnect and reset events.
export const AUDIO_EVENT_SUBSCRIBE_BACKEND: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x20);
/// Subscribe to stream xrun, state, and device-change events.
export const AUDIO_EVENT_SUBSCRIBE_STREAM: AudioEventSubscriptionFlags = AudioEventSubscriptionFlags(0x40);
