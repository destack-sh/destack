export newtype AudioEventHandle = ResourceId;

/// Handle for one display device endpoint.
export newtype DisplayHandle = ResourceId;

/// Handle for one window or surface host object.
export newtype WindowHandle = ResourceId;

/// Handle for one input device endpoint.
export newtype InputDeviceHandle = ResourceId;

