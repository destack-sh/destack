import { ResourceId } from "./id.ds";

/// Handle for an open file.
export newtype FileHandle = ResourceId;

/// Handle for an open directory.
export newtype DirectoryHandle = ResourceId;

/// Handle for a network socket.
export newtype SocketHandle = ResourceId;

/// Handle for a network listener.
export newtype ListenerHandle = ResourceId;

/// Handle for a spawned process.
export newtype ProcessHandle = ResourceId;

/// Handle for a process file descriptor style object.
export newtype ProcessFdHandle = ResourceId;

/// Handle for a scheduled timer.
export newtype TimerHandle = ResourceId;

/// Handle for a timerfd style descriptor.
export newtype TimerFdHandle = ResourceId;

/// Handle for a filesystem watcher.
export newtype WatchHandle = ResourceId;

/// Handle for a pipe endpoint.
export newtype PipeHandle = ResourceId;

/// Handle for an IPC shared memory object.
export newtype SharedMemoryHandle = ResourceId;

/// Handle for an IPC semaphore.
export newtype SemaphoreHandle = ResourceId;

/// Handle for a readiness poll instance.
export newtype PollHandle = ResourceId;

/// Handle for a completion queue instance.
export newtype CompletionHandle = ResourceId;

/// Handle for an io_uring ring instance.
export newtype UringHandle = ResourceId;

/// Handle for a dynamically loaded library.
export newtype LibraryHandle = ResourceId;

/// Handle for a foreign function symbol.
export newtype SymbolHandle = ResourceId;

/// Handle for one cryptographic key store.
export newtype CryptoStoreHandle = ResourceId;

/// Handle for one cryptographic key object.
export newtype CryptoKeyHandle = ResourceId;

