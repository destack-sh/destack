export newtype CryptoCertificateHandle = ResourceId;

/// Handle for one TLS context.
export newtype TlsContextHandle = ResourceId;

/// Handle for one TLS session.
export newtype TlsSessionHandle = ResourceId;

/// Handle for a device endpoint.
export newtype DeviceHandle = ResourceId;

/// Handle for a pseudo terminal endpoint.
export newtype PtyHandle = ResourceId;

/// Handle for a thread object.
export newtype ThreadHandle = ResourceId;

/// Handle for a mutex object.
export newtype MutexHandle = ResourceId;

/// Handle for a read write lock object.
export newtype RwLockHandle = ResourceId;

/// Handle for a condition variable object.
export newtype CondVarHandle = ResourceId;

/// Handle for a thread-scoped semaphore object.
