/// Handle for a thread-scoped barrier object.
export newtype BarrierHandle = ResourceId;

/// Handle for a thread local key.
export newtype ThreadLocalKey = ResourceId;

/// Handle for a sandbox scope.
export newtype SandboxHandle = ResourceId;

/// Handle for an inspector session.
export newtype InspectorHandle = ResourceId;

/// Handle for an active profiler session.
export newtype ProfileHandle = ResourceId;

/// Handle for an active trace stream.
