import type { PlatformError } from "../error/index.ds";
import { SharedMemoryHandle } from "../resource/index.ds";

/// Shared memory mapping result.
export struct SharedMemoryMapping {
    /// Base address in the process virtual space.
    address: uint64,
    /// Mapping length in bytes.
    length: uint64,
}

/// Shared memory bindings.
declare namespace ipc {
    /// Create one named shared memory object.
    ///
    /// Create one shared memory object with explicit size and creation flags.
    /// Name namespace and visibility follow host object manager semantics.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses shm_open or memfd-style APIs on Unix, file mapping objects on Windows, and wasi shared-memory support when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioAlreadyExists, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.create",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryCreate(name: string, size: uint64, flags: uint32): Result<SharedMemoryHandle, PlatformError>;

    /// Open one named shared memory object.
    ///
    /// Open one existing shared memory object by name.
    /// Access rights and visibility follow host object manager semantics.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses shm_open-style APIs on Unix, OpenFileMapping on Windows, and wasi shared-memory support when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.open",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryOpen(name: string, flags: uint32): Result<SharedMemoryHandle, PlatformError>;

    /// Close one shared memory object handle.
    ///
    /// Close one shared memory handle without unmapping process mappings.
    /// Mapping lifetime remains independent until explicit unmap calls.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses close(2), CloseHandle, or wasi equivalent object close semantics.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.close",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryClose(handle: SharedMemoryHandle): Result<void, PlatformError>;

    /// Remove one named shared memory object.
    ///
    /// Remove one shared memory object name from the host namespace.
    /// Live mappings and handles remain valid until they are closed and unmapped.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses shm_unlink-style APIs on Unix, named mapping object removal on Windows, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.unlink",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryUnlink(name: string): Result<void, PlatformError>;

    /// Resize one shared memory object.
    ///
    /// Resize one shared memory object to the requested length.
    /// Shrinking and growth semantics for existing mappings follow host virtual-memory rules.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses ftruncate-style resizing on Unix, section resizing on Windows where supported, and wasi equivalents when available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.resize",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryResize(handle: SharedMemoryHandle, size: uint64): Result<void, PlatformError>;

    /// Map one shared memory range.
    ///
    /// Map one region of a shared memory object into the current process address space.
    /// Mapping protection and coherence follow host virtual-memory semantics.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses mmap family on Unix, MapViewOfFile on Windows, and wasi memory mapping equivalents.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.map",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryMap(
        handle: SharedMemoryHandle,
        offset: uint64,
        length: uint64,
        flags: uint32,
    ): Result<SharedMemoryMapping, PlatformError>;

    /// Unmap one shared memory range.
    ///
    /// Unmap one previously mapped memory range from the process address space.
    /// Unmap operation does not destroy the underlying shared memory object.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses munmap on Unix, UnmapViewOfFile on Windows, and wasi unmap equivalents.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `ipc.sharedMemory`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.ipc.sharedMemory.unmap",
        {
            effect: "external",
            replay: "recordable",
            requires: ["ipc.sharedMemory"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function sharedMemoryUnmap(address: uint64, length: uint64): Result<void, PlatformError>;
}
