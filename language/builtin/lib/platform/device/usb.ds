import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { UsbDeviceHandle, UsbWatchHandle } from "../resource/index.ds";

/// USB endpoint descriptor.
export struct UsbEndpointDescriptor {
    /// Endpoint number.
    endpointNumber: uint8;
    /// Endpoint transfer direction.
    direction: UsbEndpointDirection;
    /// Endpoint transfer type.
    transferType: UsbEndpointTransferType;
    /// Endpoint max-packet size in bytes.
    maxPacketSize: uint16;
    /// Endpoint polling interval.
    interval: uint8;
}

/// USB endpoint selector.
export struct UsbEndpointSelector {
    /// Endpoint number.
    number: uint8;
    /// Endpoint transfer direction.
    direction: UsbEndpointDirection;
}

/// USB endpoint direction.
export enum UsbEndpointDirection {
    /// Device-to-host endpoint direction.
    In = 1,
    /// Host-to-device endpoint direction.
    Out = 2,
}

/// USB endpoint transfer type.
export enum UsbEndpointTransferType {
    /// Bulk transfer endpoint.
    Bulk = 1,
    /// Interrupt transfer endpoint.
    Interrupt = 2,
    /// Isochronous transfer endpoint.
    Isochronous = 3,
}

/// USB interface descriptor.
export struct UsbInterfaceDescriptor {
    /// Interface number.
    number: uint8;
    /// Alternate setting number.
    alternateSetting: uint8;
    /// Interface class code.
    classCode: uint8;
    /// Interface subclass code.
    subclassCode: uint8;
    /// Interface protocol code.
    protocolCode: uint8;
    /// Interface string descriptor when available.
    name?: string;
    /// Endpoints for this interface.
    endpoints: Slice<UsbEndpointDescriptor>;
}

/// USB device descriptor.
export struct UsbDeviceDescriptor {
    /// Stable USB device identifier.
    id: string;
    /// USB vendor identifier.
    vendorId: uint16;
    /// USB product identifier.
    productId: uint16;
    /// Device class code.
    classCode: uint8;
    /// Device subclass code.
    subclassCode: uint8;
    /// Device protocol code.
    protocolCode: uint8;
    /// Device manufacturer string when available.
    manufacturer?: string;
    /// Device product string when available.
    product?: string;
    /// Device serial-number string when available.
    serialNumber?: string;
}

/// USB control transfer type.
export enum UsbControlTransferType {
    /// USB standard request type.
    Standard = 1,
    /// USB class-specific request type.
    Class = 2,
    /// USB vendor-specific request type.
    Vendor = 3,
}

/// USB device control-transfer target.
export struct UsbControlDeviceTarget {
    /// Discriminator for this control-target variant.
    kind: "device";
}

/// USB interface control-transfer target.
export struct UsbControlInterfaceTarget {
    /// Discriminator for this control-target variant.
    kind: "interface";
    /// Interface number.
    interfaceNumber: uint8;
}

/// USB endpoint control-transfer target.
export struct UsbControlEndpointTarget {
    /// Discriminator for this control-target variant.
    kind: "endpoint";
    /// Endpoint selector.
    endpoint: UsbEndpointSelector;
}

/// USB other-recipient control-transfer target.
export struct UsbControlOtherTarget {
    /// Discriminator for this control-target variant.
    kind: "other";
    /// Raw recipient index value.
    index: uint16;
}

/// USB control-transfer target selector.
export newtype UsbControlTarget =
    | UsbControlDeviceTarget
    | UsbControlInterfaceTarget
    | UsbControlEndpointTarget
    | UsbControlOtherTarget;

/// USB setup packet for control transfers.
export struct UsbControlSetup {
    /// USB control transfer type selector.
    transferType: UsbControlTransferType;
    /// USB control transfer target selector.
    target: UsbControlTarget;
    /// bRequest field.
    request: uint8;
    /// wValue field.
    value: uint16;
    /// wLength field.
    length: uint16;
}

/// USB transfer completion status.
export enum UsbTransferStatus {
    /// Transfer completed successfully.
    Ok = 1,
    /// Endpoint reported a stall condition.
    Stall = 2,
    /// Host detected a babble condition.
    Babble = 3,
}

/// USB configuration descriptor.
export struct UsbConfigurationDescriptor {
    /// Configuration value.
    value: uint8;
    /// Configuration string descriptor when available.
    name?: string;
    /// Whether this configuration is self-powered.
    selfPowered: boolean;
    /// Whether this configuration supports remote wakeup.
    remoteWakeup: boolean;
    /// Maximum bus power in milliamps.
    maxPowerMilliAmps: uint16;
    /// Interface descriptors for this configuration.
    interfaces: Slice<UsbInterfaceDescriptor>;
}

/// USB inbound transfer result.
export struct UsbInTransferResult {
    /// Transfer completion status.
    status: UsbTransferStatus;
    /// Transfer payload bytes.
    bytes: Slice<uint8>;
}

/// USB outbound transfer result.
export struct UsbOutTransferResult {
    /// Transfer completion status.
    status: UsbTransferStatus;
    /// Number of bytes accepted by the host transfer.
    bytesWritten: uint32;
}

/// USB isochronous packet result.
export struct UsbIsochronousPacketResult {
    /// Packet completion status.
    status: UsbTransferStatus;
    /// Packet transfer length in bytes.
    actualLength: uint32;
}

/// USB isochronous transfer result.
export struct UsbIsochronousTransferResult {
    /// Flattened transfer bytes for all packets.
    bytes: Slice<uint8>;
    /// Per-packet transfer results.
    packets: Slice<UsbIsochronousPacketResult>;
}

/// Shared metadata for all USB hotplug events.
export struct UsbHotplugEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this watch stream.
    sequence: uint64;
    /// Hotplug device descriptor payload.
    device: UsbDeviceDescriptor;
}

/// USB-attached hotplug event.
export struct UsbHotplugAttachedEvent {
    /// Discriminator for this usb hotplug event variant.
    kind: "attached";
    /// Shared event metadata.
    metadata: UsbHotplugEventMetadata;
}

/// USB-detached hotplug event.
export struct UsbHotplugDetachedEvent {
    /// Discriminator for this usb hotplug event variant.
    kind: "detached";
    /// Shared event metadata.
    metadata: UsbHotplugEventMetadata;
}

/// USB hotplug event payload.
export newtype UsbHotplugEvent = UsbHotplugAttachedEvent | UsbHotplugDetachedEvent;

/// USB string descriptor payload.
export struct UsbStringDescriptor {
    /// Language identifier used for string reads.
    languageId: uint16;
    /// Manufacturer string value when available.
    manufacturer?: string;
    /// Product string value when available.
    product?: string;
    /// Serial-number string value when available.
    serialNumber?: string;
}

/// USB BOS capability kind.
export enum UsbBosCapabilityKind {
    /// Host did not classify the capability.
    Unknown = 1,
    /// Wireless USB capability.
    WirelessUsb = 2,
    /// USB 2.0 extension capability.
    Usb20Extension = 3,
    /// SuperSpeed USB capability.
    SuperspeedUsb = 4,
    /// Container identifier capability.
    ContainerId = 5,
    /// Platform capability.
    Platform = 6,
    /// Billboard capability.
    Billboard = 7,
    /// Configuration summary capability.
    ConfigurationSummary = 8,
}

/// USB BOS capability descriptor.
export struct UsbBosCapabilityDescriptor {
    /// Normalized BOS capability classification.
    kind: UsbBosCapabilityKind;
    /// Raw bDevCapabilityType value.
    capabilityType: uint8;
    /// Platform capability UUID when applicable.
    platformUuid?: string;
    /// Raw capability payload bytes.
    bytes: Slice<uint8>;
}

/// USB bindings.
declare namespace device {
    /// List USB devices.
    ///
    /// Enumerate attached USB devices and return stable descriptors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses libusb-family enumeration or host USB APIs.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbList(): Result<Slice<UsbDeviceDescriptor>, PlatformError>;

    /// Open USB hotplug watch stream.
    ///
    /// Open one USB hotplug watch stream for attach and detach events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB hotplug subscription APIs.
    ///
    /// # Errors
    /// Returns ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.watchOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbWatchOpen(): Result<UsbWatchHandle, PlatformError>;

    /// Close USB hotplug watch stream.
    ///
    /// Close one USB hotplug watch stream and release host subscription resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB hotplug unsubscription APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.watchClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbWatchClose(handle: UsbWatchHandle): Result<void, PlatformError>;

    /// Wait for one USB hotplug event.
    ///
    /// Wait for one queued USB hotplug event from one opened watch stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB hotplug event queues.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.watchRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbWatchRead(
        handle: UsbWatchHandle,
        timeoutNs: uint64,
    ): Result<UsbHotplugEvent, PlatformError>;

    /// Poll one USB hotplug event without blocking.
    ///
    /// Poll one queued USB hotplug event from one opened watch stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host nonblocking USB hotplug event queue reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.watchTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function usbWatchTryRead(handle: UsbWatchHandle): Result<UsbHotplugEvent, PlatformError>;

    /// Open USB device.
    ///
    /// Open one USB device for control and data transfers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB open APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbOpen(id: string): Result<UsbDeviceHandle, PlatformError>;

    /// Close USB device.
    ///
    /// Close one opened USB device and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB close APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbClose(handle: UsbDeviceHandle): Result<void, PlatformError>;

    /// Claim USB interface.
    ///
    /// Claim one interface on one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB interface-claim APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.claimInterface", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbClaimInterface(
        handle: UsbDeviceHandle,
        interfaceNumber: uint8,
    ): Result<void, PlatformError>;

    /// Release USB interface.
    ///
    /// Release one interface previously claimed on one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB interface-release APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.releaseInterface", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbReleaseInterface(
        handle: UsbDeviceHandle,
        interfaceNumber: uint8,
    ): Result<void, PlatformError>;

    /// Set USB interface alternate setting.
    ///
    /// Select one alternate setting for one claimed interface.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB alternate-setting APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.setInterfaceAlternateSetting", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbSetInterfaceAlternateSetting(
        handle: UsbDeviceHandle,
        interfaceNumber: uint8,
        alternateSetting: uint8,
    ): Result<void, PlatformError>;

    /// Read active USB device descriptor.
    ///
    /// Read descriptor metadata for one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB descriptor-query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.descriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbDescriptor(handle: UsbDeviceHandle): Result<UsbDeviceDescriptor, PlatformError>;

    /// List USB string-descriptor language identifiers.
    ///
    /// Enumerate string-descriptor language identifiers for one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB string-descriptor language query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.stringLanguageList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbStringLanguageList(handle: UsbDeviceHandle): Result<Slice<uint16>, PlatformError>;

    /// Read USB string descriptors.
    ///
    /// Read manufacturer, product, and serial-number string descriptors for one language identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB string-descriptor read APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.stringDescriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbStringDescriptor(
        handle: UsbDeviceHandle,
        languageId: uint16,
    ): Result<UsbStringDescriptor, PlatformError>;

    /// List USB BOS capabilities.
    ///
    /// Enumerate BOS capability descriptors for one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host BOS or device-capability descriptor query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.bosCapabilityList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbBosCapabilityList(
        handle: UsbDeviceHandle,
    ): Result<Slice<UsbBosCapabilityDescriptor>, PlatformError>;

    /// List USB configurations.
    ///
    /// Enumerate USB configurations and nested interface descriptors for one opened device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB configuration-descriptor query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.enumerate`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.configurationList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.enumerate"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbConfigurationList(handle: UsbDeviceHandle): Result<Slice<UsbConfigurationDescriptor>, PlatformError>;

    /// Read active USB configuration value.
    ///
    /// Read active configuration value for one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB configuration-state APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.configurationGet", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbConfigurationGet(handle: UsbDeviceHandle): Result<uint8, PlatformError>;

    /// Set active USB configuration value.
    ///
    /// Apply active configuration value for one opened USB device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB set-configuration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.configurationSet", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbConfigurationSet(
        handle: UsbDeviceHandle,
        configurationValue: uint8,
    ): Result<void, PlatformError>;

    /// Read control-transfer response bytes.
    ///
    /// Execute one control-transfer read and return transfer status with response bytes.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB control-transfer APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.transfer`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.controlRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.transfer"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbControlRead(
        handle: UsbDeviceHandle,
        setup: UsbControlSetup,
        timeoutNs: uint64,
    ): Result<UsbInTransferResult, PlatformError>;

    /// Write control-transfer request bytes.
    ///
    /// Execute one control-transfer write and return transfer status with transferred byte count.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB control-transfer APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.transfer`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.controlWrite", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.transfer"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbControlWrite(
        handle: UsbDeviceHandle,
        setup: UsbControlSetup,
        bytes: Slice<uint8>,
        timeoutNs: uint64,
    ): Result<UsbOutTransferResult, PlatformError>;

    /// Read bulk endpoint bytes.
    ///
    /// Read up to `maxBytes` from one bulk IN endpoint and return transfer status.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB bulk-transfer APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.transfer`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.bulkRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.transfer"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbBulkRead(
        handle: UsbDeviceHandle,
        endpoint: UsbEndpointSelector,
        maxBytes: uint32,
        timeoutNs: uint64,
    ): Result<UsbInTransferResult, PlatformError>;

    /// Write bulk endpoint bytes.
    ///
    /// Write bytes to one bulk OUT endpoint and return transfer status with transferred byte count.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB bulk-transfer APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.transfer`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.bulkWrite", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.usb.transfer"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function usbBulkWrite(
        handle: UsbDeviceHandle,
        endpoint: UsbEndpointSelector,
        bytes: Slice<uint8>,
        timeoutNs: uint64,
    ): Result<UsbOutTransferResult, PlatformError>;

    /// Read interrupt endpoint bytes.
    ///
    /// Read up to `maxBytes` from one interrupt IN endpoint and return transfer status.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host USB interrupt-transfer APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.usb.transfer`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.usb.interruptRead", {
