import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { OsPath } from "../fs/path.ds";
import { SerialPortHandle } from "../resource/index.ds";

/// Serial parity mode.
export enum SerialParity {
    /// No parity bit.
    None = 1,
    /// Odd parity bit.
    Odd = 2,
    /// Even parity bit.
    Even = 3,
}

/// Serial stop-bit mode.
export enum SerialStopBits {
    /// One stop bit.
    One = 1,
    /// Two stop bits.
    Two = 2,
}

/// Serial flow-control mode.
export enum SerialFlowControl {
    /// No flow control.
    None = 1,
    /// RTS or CTS hardware flow control.
    RtsCts = 2,
    /// XON or XOFF software flow control.
    XonXoff = 3,
}

/// Serial endpoint configuration.
export struct SerialPortConfig {
    /// Baud rate in symbols per second.
    baudRate: uint32;
    /// Number of data bits per frame.
    dataBits: uint8;
    /// Parity mode.
    parity: SerialParity;
    /// Stop-bit mode.
    stopBits: SerialStopBits;
    /// Flow-control mode.
    flowControl: SerialFlowControl;
    /// Read timeout in nanoseconds.
    readTimeoutNs: uint64;
    /// Write timeout in nanoseconds.
    writeTimeoutNs: uint64;
}

/// Serial endpoint descriptor.
export struct SerialPortDescriptor {
    /// Stable serial endpoint identifier.
    id: string;
    /// Host-visible endpoint name.
    name: string;
    /// Device path for the endpoint.
    path: OsPath;
    /// USB vendor identifier when the endpoint is USB backed.
    usbVendorId?: uint16;
    /// USB product identifier when the endpoint is USB backed.
    usbProductId?: uint16;
    /// Whether the endpoint is USB backed.
    usbBacked: boolean;
}

/// Serial status-line bitmask.
export enum SerialSignalBits {
    /// Clear-to-send line.
    Cts = 0x1,
    /// Data-set-ready line.
    Dsr = 0x2,
    /// Data-carrier-detect line.
    Dcd = 0x4,
    /// Ring-indicator line.
    Ri = 0x8,
}

/// Read-ready event payload.
export struct SerialReadReadyPayload {
    /// Estimated number of readable bytes.
    availableBytes: uint32;
}

/// Write-ready event payload.
export struct SerialWriteReadyPayload {
    /// Estimated number of writable bytes.
    writableBytes: uint32;
}

/// Signal-line changed event payload.
export struct SerialSignalsChangedPayload {
    /// Current serial signal-line bitmask.
    signalBits: uint32;
}

/// Serial error event payload.
export struct SerialErrorPayload {
    /// Backend-specific error code.
    code: int32;
    /// Backend-specific detail value.
    detail: int32;
}

/// Shared metadata for all serial events.
export struct SerialEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this serial event stream.
    sequence: uint64;
}

/// Read-ready serial event.
export struct SerialReadReadyEvent {
    /// Discriminator for this serial event variant.
    kind: "readReady";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Read-ready payload.
    payload: SerialReadReadyPayload;
}

/// Write-ready serial event.
export struct SerialWriteReadyEvent {
    /// Discriminator for this serial event variant.
    kind: "writeReady";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Write-ready payload.
    payload: SerialWriteReadyPayload;
}

/// Signal-line-changed serial event.
export struct SerialSignalsChangedEvent {
    /// Discriminator for this serial event variant.
    kind: "signalsChanged";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Signal-line payload.
    payload: SerialSignalsChangedPayload;
}

/// Error serial event.
export struct SerialErrorEvent {
    /// Discriminator for this serial event variant.
    kind: "error";
    /// Shared event metadata.
    metadata: SerialEventMetadata;
    /// Error payload.
    payload: SerialErrorPayload;
}

/// Serial event.
export newtype SerialEvent = SerialReadReadyEvent | SerialWriteReadyEvent | SerialSignalsChangedEvent | SerialErrorEvent;

/// Serial bindings.
declare namespace device {
    /// List serial endpoints.
    ///
    /// Enumerate available host serial endpoints and return stable identifiers.
    /// Enumeration ordering follows host backend behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses `/dev/tty*` style enumeration on Unix-like hosts and SetupAPI COM-port enumeration on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialList(): Result<Slice<SerialPortDescriptor>, PlatformError>;

    /// Open serial endpoint.
    ///
    /// Open one serial endpoint with explicit line configuration.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios-family open operations on Unix-like hosts and CreateFile serial APIs on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialOpen(id: string, config: SerialPortConfig): Result<SerialPortHandle, PlatformError>;

    /// Close serial endpoint.
    ///
    /// Close one opened serial endpoint and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific serial close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialClose(handle: SerialPortHandle): Result<void, PlatformError>;

    /// Reconfigure serial endpoint.
    ///
    /// Apply one serial line configuration on one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios reconfiguration on Unix-like hosts and DCB reconfiguration on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.configure", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialConfigure(handle: SerialPortHandle, config: SerialPortConfig): Result<void, PlatformError>;

    /// Read serial bytes.
    ///
    /// Read up to `maxBytes` from one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend read operations with timeout handling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialRead(
        handle: SerialPortHandle,
        maxBytes: uint32,
        timeoutNs: uint64,
    ): Result<Slice<uint8>, PlatformError>;

    /// Poll serial bytes without blocking.
    ///
    /// Read up to `maxBytes` from one opened serial endpoint without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking serial read operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
    })
    export function serialTryRead(handle: SerialPortHandle, maxBytes: uint32): Result<Slice<uint8>, PlatformError>;

    /// Write serial bytes.
    ///
    /// Write one byte sequence to one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend serial write operations with timeout handling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.write", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.write"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialWrite(
        handle: SerialPortHandle,
        data: Slice<uint8>,
        timeoutNs: uint64,
    ): Result<uint32, PlatformError>;

    /// Flush serial output.
    ///
    /// Drain queued outbound bytes on one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend serial flush operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.flush", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.write"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialFlush(handle: SerialPortHandle): Result<void, PlatformError>;

    /// Discard queued inbound serial bytes.
    ///
    /// Drop queued unread inbound bytes for one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios and Win32 purge APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.discardInput", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialDiscardInput(handle: SerialPortHandle): Result<void, PlatformError>;

    /// Discard queued outbound serial bytes.
    ///
    /// Drop queued unwritten outbound bytes for one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses termios and Win32 purge APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.discardOutput", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialDiscardOutput(handle: SerialPortHandle): Result<void, PlatformError>;

    /// Read serial signal lines.
    ///
    /// Return current serial signal-line bitmask for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend modem-status APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.signalBits", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
    })
    export function serialSignalBits(handle: SerialPortHandle): Result<uint32, PlatformError>;

    /// Set DTR and RTS control lines.
    ///
    /// Apply DTR and RTS line state for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend serial line-control APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.setControlLines", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialSetControlLines(
        handle: SerialPortHandle,
        dtr: boolean,
        rts: boolean,
    ): Result<void, PlatformError>;

    /// Set serial break state.
    ///
    /// Apply break signaling state for one opened serial endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend serial break-control APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.setBreak", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialSetBreak(handle: SerialPortHandle, enabled: boolean): Result<void, PlatformError>;

    /// Wait for one serial event.
    ///
    /// Wait for one pending serial event for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend serial event queues where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.readEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function serialReadEvent(
        handle: SerialPortHandle,
        timeoutNs: uint64,
    ): Result<SerialEvent, PlatformError>;

    /// Poll one serial event without blocking.
    ///
    /// Poll one pending serial event for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking serial event polling where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.serial.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.serial.tryEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.serial.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
    })
    export function serialTryEvent(handle: SerialPortHandle): Result<SerialEvent, PlatformError>;
}
