import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CameraDeviceHandle, CameraStreamHandle } from "../resource/index.ds";

/// Camera endpoint descriptor.
export struct CameraDeviceDescriptor {
    /// Stable camera endpoint identifier.
    id: string;
    /// Host-visible endpoint name.
    name: string;
    /// Host-visible endpoint manufacturer string when available.
    manufacturer?: string;
    /// Whether the endpoint is front-facing.
    frontFacing: boolean;
    /// Whether the endpoint is depth-capable.
    depthCapable: boolean;
}

/// Camera pixel format.
export enum CameraPixelFormat {
    /// Packed 8-bit BGRA.
    Bgra8 = 1,
    /// Packed 8-bit RGBA.
    Rgba8 = 2,
    /// Planar YUV 4:2:0.
    Yuv420 = 3,
    /// JPEG encoded frame bytes.
    Jpeg = 4,
}

/// Camera stream configuration.
export struct CameraStreamConfig {
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame rate in milli-frames-per-second.
    frameRateMilliHz: uint32;
    /// Pixel format selector.
    format: CameraPixelFormat;
}

/// Camera color space selector.
export enum CameraColorSpace {
    /// Backend did not provide color-space metadata.
    Unknown = 1,
    /// sRGB color space.
    Srgb = 2,
    /// ITU-R BT.601 color space.
    Bt601 = 3,
    /// ITU-R BT.709 color space.
    Bt709 = 4,
    /// ITU-R BT.2020 color space.
    Bt2020 = 5,
}

/// Camera dynamic-range mode.
export enum CameraDynamicRange {
    /// Standard dynamic range.
    Standard = 1,
    /// HDR10 dynamic range.
    Hdr10 = 2,
    /// Hybrid log-gamma dynamic range.
    Hlg = 3,
}

/// Camera stabilization mode.
export enum CameraStabilizationMode {
    /// Stabilization disabled.
    Off = 1,
    /// Standard stabilization mode.
    Standard = 2,
    /// High quality stabilization mode.
    HighQuality = 3,
}

/// Camera torch mode.
export enum CameraTorchMode {
    /// Torch disabled.
    Off = 1,
    /// Torch enabled.
    On = 2,
    /// Host auto torch policy.
    Auto = 3,
}

/// Camera exposure mode.
export enum CameraExposureMode {
    /// Automatic exposure mode.
    Auto = 1,
    /// Continuous automatic exposure mode.
    ContinuousAuto = 2,
    /// Manual exposure mode.
    Manual = 3,
}

/// Camera frame plane layout descriptor.
export struct CameraPlaneLayout {
    /// Plane byte offset in `CameraFrame.bytes`.
    offsetBytes: uint32;
    /// Plane byte length in `CameraFrame.bytes`.
    lengthBytes: uint32;
    /// Plane row stride in bytes.
    rowStrideBytes: uint32;
    /// Plane pixel stride in bytes.
    pixelStrideBytes: uint32;
}

/// Camera frame metadata payload.
export struct CameraFrameMetadata {
    /// Exposure time in nanoseconds when available.
    exposureTimeNs?: uint64;
    /// Sensor sensitivity ISO value when available.
    sensorIso?: uint32;
    /// White-balance color temperature in kelvin when available.
    whiteBalanceKelvin?: uint32;
    /// Lens focus distance in diopters when available.
    focusDistanceDiopters?: float64;
    /// Applied zoom ratio when available.
    zoomRatio?: float64;
}

/// Camera stream frame payload.
export struct CameraFrame {
    /// Frame timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame pixel format.
    format: CameraPixelFormat;
    /// Frame color-space metadata.
    colorSpace: CameraColorSpace;
    /// Plane layout descriptors for this frame.
    /// Packed formats use one plane.
    planes: Slice<CameraPlaneLayout>;
    /// Frame metadata payload when available.
    metadata: CameraFrameMetadata;
    /// Frame byte payload.
    bytes: Slice<uint8>;
}

/// Camera stream capability descriptor.
export struct CameraStreamCapability {
    /// Stream configuration payload.
    config: CameraStreamConfig;
    /// Minimum supported frame rate in milli-frames-per-second.
    minimumFrameRateMilliHz: uint32;
    /// Maximum supported frame rate in milli-frames-per-second.
    maximumFrameRateMilliHz: uint32;
    /// Dynamic-range mode bitmask.
    dynamicRangeMask: uint32;
    /// Stabilization-mode bitmask.
    stabilizationModeMask: uint32;
}

/// Camera control selector.
export enum CameraControl {
    /// Exposure compensation control.
    Exposure = 1,
    /// White-balance control.
    WhiteBalance = 2,
    /// Focus-distance control.
    Focus = 3,
    /// Digital-zoom ratio control.
    Zoom = 4,
}

/// Camera control range descriptor.
export struct CameraControlRange {
    /// Control selector.
    control: CameraControl;
    /// Minimum normalized control value.
    minimum: float64;
    /// Maximum normalized control value.
    maximum: float64;
    /// Default normalized control value.
    defaultValue: float64;
    /// Step size for discrete controls, zero for continuous controls.
    step: float64;
    /// Whether host auto mode is supported for this control.
    autoSupported: boolean;
}

/// Camera bindings.
declare namespace device {
    /// List camera endpoints.
    ///
    /// Enumerate host camera endpoints and return stable identifiers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera device enumeration APIs such as AVFoundation, Media Foundation, or V4L2.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceList(): Result<Slice<CameraDeviceDescriptor>, PlatformError>;

    /// Open camera endpoint.
    ///
    /// Open one host camera endpoint for stream operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint open operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceOpen(id: string): Result<CameraDeviceHandle, PlatformError>;

    /// List supported stream configurations for one opened camera endpoint.
    ///
    /// Enumerate host camera stream configurations for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera format and frame-rate enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.streamConfigList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceStreamConfigList(
        handle: CameraDeviceHandle,
    ): Result<Slice<CameraStreamConfig>, PlatformError>;

    /// List supported stream capabilities for one opened camera endpoint.
    ///
    /// Enumerate host camera stream capability descriptors for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera capability enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.streamCapabilityList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceStreamCapabilityList(
        handle: CameraDeviceHandle,
    ): Result<Slice<CameraStreamCapability>, PlatformError>;

    /// Close camera endpoint.
    ///
    /// Close one opened camera endpoint and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceClose(handle: CameraDeviceHandle): Result<void, PlatformError>;

    /// Open camera stream.
    ///
    /// Open one camera stream with explicit stream configuration.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream configuration and negotiation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamOpen(
        device: CameraDeviceHandle,
        config: CameraStreamConfig,
    ): Result<CameraStreamHandle, PlatformError>;

    /// Close camera stream.
    ///
    /// Close one opened camera stream and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamClose(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Start camera stream.
    ///
    /// Start one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream start operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.start", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamStart(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Stop camera stream.
    ///
    /// Stop one running camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream stop operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.stop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamStop(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Read camera frame.
    ///
    /// Wait for one camera frame from one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamRead(handle: CameraStreamHandle, timeoutNs: uint64): Result<CameraFrame, PlatformError>;

    /// Poll camera frame without blocking.
    ///
    /// Poll one camera frame from one running stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function cameraStreamTryRead(handle: CameraStreamHandle): Result<CameraFrame, PlatformError>;

    /// Set one camera control value.
    ///
    /// Apply one normalized camera control value in one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setControl", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamSetControl(
        handle: CameraStreamHandle,
        control: CameraControl,
        value: float64,
    ): Result<void, PlatformError>;

    /// Read one camera control value.
    ///
    /// Read one normalized camera control value from one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera control query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.getControl", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamGetControl(
        handle: CameraStreamHandle,
        control: CameraControl,
    ): Result<float64, PlatformError>;

    /// Read one camera control range.
    ///
    /// Read one normalized camera control range descriptor for one opened stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera control capability query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.controlRange", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamControlRange(
        handle: CameraStreamHandle,
        control: CameraControl,
    ): Result<CameraControlRange, PlatformError>;

    /// Set camera exposure mode.
    ///
    /// Apply one exposure mode on one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera exposure mode APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setExposureMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamSetExposureMode(
        handle: CameraStreamHandle,
        mode: CameraExposureMode,
    ): Result<void, PlatformError>;

    /// Read camera exposure mode.
    ///
    /// Read one exposure mode from one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera exposure mode query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.exposureMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamExposureMode(handle: CameraStreamHandle): Result<CameraExposureMode, PlatformError>;

    /// Set camera stabilization mode.
    ///
    /// Apply one stabilization mode on one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stabilization APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setStabilizationMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamSetStabilizationMode(
        handle: CameraStreamHandle,
        mode: CameraStabilizationMode,
    ): Result<void, PlatformError>;

    /// Read camera stabilization mode.
    ///
    /// Read one stabilization mode from one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stabilization mode query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.stabilizationMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamStabilizationMode(
        handle: CameraStreamHandle,
    ): Result<CameraStabilizationMode, PlatformError>;

    /// Set camera torch mode.
    ///
    /// Apply one torch mode on one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend torch APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setTorchMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamSetTorchMode(
        handle: CameraStreamHandle,
        mode: CameraTorchMode,
    ): Result<void, PlatformError>;

    /// Read camera torch mode.
    ///
    /// Read one torch mode from one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend torch mode query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.torchMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamTorchMode(handle: CameraStreamHandle): Result<CameraTorchMode, PlatformError>;
}
