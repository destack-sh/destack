import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CameraDeviceHandle, CameraStreamHandle } from "../resource/index.ds";

/// Camera endpoint descriptor.
export struct CameraDeviceDescriptor {
    /// Stable camera endpoint identifier.
    id: string;
    /// Shared physical-device group identifier when available.
    groupId?: string;
    /// Host-visible endpoint name.
    name: string;
    /// Host-visible endpoint manufacturer string when available.
    manufacturer?: string;
    /// Host-reported facing mode.
    facingMode: CameraFacingMode;
    /// Whether the endpoint is depth-capable.
    depthCapable: boolean;
}

/// Camera facing mode.
export enum CameraFacingMode {
    /// Host did not provide a stronger facing-mode classification.
    Unknown = 1,
    /// User-facing camera.
    User = 2,
    /// Environment-facing camera.
    Environment = 3,
    /// Left-facing camera.
    Left = 4,
    /// Right-facing camera.
    Right = 5,
    /// External or detached camera.
    External = 6,
}

/// Camera pixel format.
export enum CameraPixelFormat {
    /// Packed 8-bit BGRA.
    Bgra8 = 1,
    /// Packed 8-bit RGBA.
    Rgba8 = 2,
    /// Planar YUV 4:2:0.
    Yuv420 = 3,
    /// JPEG encoded frame bytes.
    Jpeg = 4,
}

/// Camera pixel-format family.
export enum CameraPixelFormatFamily {
    /// Packed RGB-family pixel data.
    PackedRgb = 1,
    /// Planar YUV-family pixel data.
    PlanarYuv = 2,
    /// Encoded or compressed pixel data.
    Encoded = 3,
}

/// Camera pixel-format descriptor.
export struct CameraPixelFormatDescriptor {
    /// Specific pixel format selector.
    format: CameraPixelFormat;
    /// Higher-level pixel-format family.
    family: CameraPixelFormatFamily;
    /// Whether the pixel payload is compressed or encoded.
    compressed: boolean;
}

/// Camera stream configuration.
export struct CameraStreamConfig {
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame rate in milli-frames-per-second.
    frameRateMilliHz: uint32;
    /// Pixel format descriptor.
    pixelFormat: CameraPixelFormatDescriptor;
}

/// Camera color space selector.
export enum CameraColorSpace {
    /// Backend did not provide color-space metadata.
    Unknown = 1,
    /// sRGB color space.
    Srgb = 2,
    /// ITU-R BT.601 color space.
    Bt601 = 3,
    /// ITU-R BT.709 color space.
    Bt709 = 4,
    /// ITU-R BT.2020 color space.
    Bt2020 = 5,
}

/// Camera dynamic-range mode.
export enum CameraDynamicRange {
    /// Standard dynamic range.
    Standard = 1,
    /// HDR10 dynamic range.
    Hdr10 = 2,
    /// Hybrid log-gamma dynamic range.
    Hlg = 3,
}

/// Camera stabilization mode.
export enum CameraStabilizationMode {
    /// Stabilization disabled.
    Off = 1,
    /// Standard stabilization mode.
    Standard = 2,
    /// High quality stabilization mode.
    HighQuality = 3,
}

/// Camera torch mode.
export enum CameraTorchMode {
    /// Torch disabled.
    Off = 1,
    /// Torch enabled.
    On = 2,
    /// Host auto torch policy.
    Auto = 3,
}

/// Camera exposure mode.
export enum CameraExposureMode {
    /// Automatic exposure mode.
    Auto = 1,
    /// Continuous automatic exposure mode.
    ContinuousAuto = 2,
    /// Manual exposure mode.
    Manual = 3,
}

/// Camera frame plane layout descriptor.
export struct CameraPlaneLayout {
    /// Plane byte offset in `CameraFrame.bytes`.
    offsetBytes: uint32;
    /// Plane byte length in `CameraFrame.bytes`.
    lengthBytes: uint32;
    /// Plane row stride in bytes.
    rowStrideBytes: uint32;
    /// Plane pixel stride in bytes.
    pixelStrideBytes: uint32;
}

/// Camera frame metadata payload.
export struct CameraFrameMetadata {
    /// Exposure time in nanoseconds when available.
    exposureTimeNs?: uint64;
    /// Sensor sensitivity ISO value when available.
    sensorIso?: uint32;
    /// White-balance color temperature in kelvin when available.
    whiteBalanceKelvin?: uint32;
    /// Lens focus distance in diopters when available.
    focusDistanceDiopters?: float64;
    /// Applied zoom ratio when available.
    zoomRatio?: float64;
}

/// Camera stream frame payload.
export struct CameraFrame {
    /// Frame timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame pixel-format descriptor.
    pixelFormat: CameraPixelFormatDescriptor;
    /// Frame color-space metadata.
    colorSpace: CameraColorSpace;
    /// Plane layout descriptors for this frame.
    /// Packed formats use one plane.
    planes: Slice<CameraPlaneLayout>;
    /// Frame metadata payload when available.
    metadata: CameraFrameMetadata;
    /// Frame byte payload.
    bytes: Slice<uint8>;
}

/// Camera stream capability descriptor.
export struct CameraStreamCapability {
    /// Stream configuration payload.
    config: CameraStreamConfig;
    /// Minimum supported frame rate in milli-frames-per-second.
    minimumFrameRateMilliHz: uint32;
    /// Maximum supported frame rate in milli-frames-per-second.
    maximumFrameRateMilliHz: uint32;
    /// Supported dynamic-range modes.
    dynamicRanges: Slice<CameraDynamicRange>;
    /// Supported stabilization modes.
    stabilizationModes: Slice<CameraStabilizationMode>;
}

/// Camera exposure-compensation range descriptor.
export struct CameraExposureCompensationRange {
    /// Minimum supported compensation in EV units.
    minimumEv: float64;
    /// Maximum supported compensation in EV units.
    maximumEv: float64;
    /// Default compensation in EV units.
    defaultEv: float64;
    /// Step size in EV units, zero for continuous controls.
    stepEv: float64;
    /// Whether host auto exposure is supported.
    autoSupported: boolean;
}

/// Camera white-balance range descriptor.
export struct CameraWhiteBalanceRange {
    /// Minimum supported white-balance value in kelvin.
    minimumKelvin: uint32;
    /// Maximum supported white-balance value in kelvin.
    maximumKelvin: uint32;
    /// Default white-balance value in kelvin.
    defaultKelvin: uint32;
    /// Step size in kelvin, zero for continuous controls.
    stepKelvin: uint32;
    /// Whether host auto white-balance is supported.
    autoSupported: boolean;
}

/// Camera focus-distance range descriptor.
export struct CameraFocusDistanceRange {
    /// Minimum supported focus distance in diopters.
    minimumDiopters: float64;
    /// Maximum supported focus distance in diopters.
    maximumDiopters: float64;
    /// Default focus distance in diopters.
    defaultDiopters: float64;
    /// Step size in diopters, zero for continuous controls.
    stepDiopters: float64;
    /// Whether host auto focus is supported.
    autoSupported: boolean;
}

/// Camera zoom-ratio range descriptor.
export struct CameraZoomRatioRange {
    /// Minimum supported zoom ratio.
    minimumRatio: float64;
    /// Maximum supported zoom ratio.
    maximumRatio: float64;
    /// Default zoom ratio.
    defaultRatio: float64;
    /// Step size for discrete zoom ratios, zero for continuous controls.
    stepRatio: float64;
}

/// Camera bindings.
declare namespace device {
    /// List camera endpoints.
    ///
    /// Enumerate host camera endpoints and return stable identifiers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera device enumeration APIs such as AVFoundation, Media Foundation, or V4L2.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraDeviceList(): Result<Slice<CameraDeviceDescriptor>, PlatformError>;

    /// Open camera endpoint.
    ///
    /// Open one host camera endpoint for stream operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint open operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraDeviceOpen(id: string): Result<CameraDeviceHandle, PlatformError>;

    /// List supported stream configurations for one opened camera endpoint.
    ///
    /// Enumerate host camera stream configurations for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera format and frame-rate enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.streamConfigList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraDeviceStreamConfigList(handle: CameraDeviceHandle): Result<Slice<CameraStreamConfig>, PlatformError>;

    /// List supported stream capabilities for one opened camera endpoint.
    ///
    /// Enumerate host camera stream capability descriptors for one opened endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera capability enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.streamCapabilityList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraDeviceStreamCapabilityList(handle: CameraDeviceHandle): Result<Slice<CameraStreamCapability>, PlatformError>;

    /// Close camera endpoint.
    ///
    /// Close one opened camera endpoint and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraDeviceClose(handle: CameraDeviceHandle): Result<void, PlatformError>;

    /// Open camera stream.
    ///
    /// Open one camera stream with explicit stream configuration.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream configuration and negotiation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamOpen(
        device: CameraDeviceHandle,
        config: CameraStreamConfig,
    ): Result<CameraStreamHandle, PlatformError>;

    /// Close camera stream.
    ///
    /// Close one opened camera stream and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamClose(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Start camera stream.
    ///
    /// Start one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream start operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.start", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamStart(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Stop camera stream.
    ///
    /// Stop one running camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream stop operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.stop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamStop(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Read camera frame.
    ///
    /// Wait for one camera frame from one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamRead(
        handle: CameraStreamHandle,
        timeoutNs: uint64,
    ): Result<CameraFrame, PlatformError>;

    /// Poll camera frame without blocking.
    ///
    /// Poll one camera frame from one running stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function cameraStreamTryRead(handle: CameraStreamHandle): Result<CameraFrame, PlatformError>;

    /// Read current camera stream configuration.
    ///
    /// Read one active stream-configuration snapshot for one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream settings and active-format query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.config", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamConfig(handle: CameraStreamHandle): Result<CameraStreamConfig, PlatformError>;

    /// Set camera exposure compensation.
    ///
    /// Apply one exposure-compensation value in EV units on one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend exposure-compensation control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setExposureCompensation", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamSetExposureCompensation(
        handle: CameraStreamHandle,
        valueEv: float64,
    ): Result<void, PlatformError>;

    /// Read camera exposure compensation.
    ///
    /// Read one exposure-compensation value in EV units from one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend exposure-compensation query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.exposureCompensation", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamExposureCompensation(
        handle: CameraStreamHandle,
    ): Result<float64, PlatformError>;

    /// Read exposure-compensation range.
    ///
    /// Read one exposure-compensation range descriptor for one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend exposure-compensation capability query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.exposureCompensationRange", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamExposureCompensationRange(
        handle: CameraStreamHandle,
    ): Result<CameraExposureCompensationRange, PlatformError>;

    /// Set camera white balance.
    ///
    /// Apply one white-balance value in kelvin on one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend white-balance control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setWhiteBalanceKelvin", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamSetWhiteBalanceKelvin(
        handle: CameraStreamHandle,
        kelvin: uint32,
    ): Result<void, PlatformError>;

    /// Read camera white balance.
    ///
    /// Read one white-balance value in kelvin from one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend white-balance query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.whiteBalanceKelvin", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamWhiteBalanceKelvin(
        handle: CameraStreamHandle,
    ): Result<uint32, PlatformError>;

    /// Read white-balance range.
    ///
    /// Read one white-balance range descriptor for one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend white-balance capability query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.whiteBalanceRange", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function cameraStreamWhiteBalanceRange(
        handle: CameraStreamHandle,
