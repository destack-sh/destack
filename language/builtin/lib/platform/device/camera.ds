import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CameraDeviceHandle, CameraStreamHandle } from "../resource/index.ds";

/// Camera endpoint descriptor.
export struct CameraDeviceDescriptor {
    /// Stable camera endpoint identifier.
    id: string;
    /// Host-visible endpoint name.
    name: string;
    /// Host-visible endpoint manufacturer string when available.
    manufacturer: string;
    /// Whether the endpoint is front-facing.
    frontFacing: boolean;
    /// Whether the endpoint is depth-capable.
    depthCapable: boolean;
}

/// Camera pixel format.
export enum CameraPixelFormat {
    /// Packed 8-bit BGRA.
    Bgra8 = 1,
    /// Packed 8-bit RGBA.
    Rgba8 = 2,
    /// Planar YUV 4:2:0.
    Yuv420 = 3,
    /// JPEG encoded frame bytes.
    Jpeg = 4,
}

/// Camera stream configuration.
export struct CameraStreamConfig {
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame rate in milli-frames-per-second.
    frameRateMilliHz: uint32;
    /// Pixel format selector.
    format: CameraPixelFormat;
}

/// Camera color space selector.
export enum CameraColorSpace {
    /// Backend did not provide color-space metadata.
    Unknown = 1,
    /// sRGB color space.
    Srgb = 2,
    /// ITU-R BT.601 color space.
    Bt601 = 3,
    /// ITU-R BT.709 color space.
    Bt709 = 4,
    /// ITU-R BT.2020 color space.
    Bt2020 = 5,
}

/// Camera frame plane layout descriptor.
export struct CameraPlaneLayout {
    /// Plane byte offset in `CameraFrame.bytes`.
    offsetBytes: uint32;
    /// Plane byte length in `CameraFrame.bytes`.
    lengthBytes: uint32;
    /// Plane row stride in bytes.
    rowStrideBytes: uint32;
    /// Plane pixel stride in bytes.
    pixelStrideBytes: uint32;
}

/// Camera stream frame payload.
export struct CameraFrame {
    /// Frame timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Frame width in pixels.
    width: uint32;
    /// Frame height in pixels.
    height: uint32;
    /// Frame pixel format.
    format: CameraPixelFormat;
    /// Frame color-space metadata.
    colorSpace: CameraColorSpace;
    /// Plane layout descriptors for this frame.
    /// Packed formats use one plane.
    planes: Slice<CameraPlaneLayout>;
    /// Frame byte payload.
    bytes: Slice<uint8>;
}

/// Camera control selector.
export enum CameraControl {
    /// Exposure compensation control.
    Exposure = 1,
    /// White-balance control.
    WhiteBalance = 2,
    /// Focus-distance control.
    Focus = 3,
    /// Digital-zoom ratio control.
    Zoom = 4,
}

/// Camera bindings.
declare namespace device {
    /// List camera endpoints.
    ///
    /// Enumerate host camera endpoints and return stable identifiers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera device enumeration APIs such as AVFoundation, Media Foundation, or V4L2.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceList(): Result<Slice<CameraDeviceDescriptor>, PlatformError>;

    /// Open camera endpoint.
    ///
    /// Open one host camera endpoint for stream operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint open operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceOpen(id: string): Result<CameraDeviceHandle, PlatformError>;

    /// Close camera endpoint.
    ///
    /// Close one opened camera endpoint and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera endpoint close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.device`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.device.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.device"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraDeviceClose(handle: CameraDeviceHandle): Result<void, PlatformError>;

    /// Open camera stream.
    ///
    /// Open one camera stream with explicit stream configuration.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream configuration and negotiation APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamOpen(
        device: CameraDeviceHandle,
        config: CameraStreamConfig,
    ): Result<CameraStreamHandle, PlatformError>;

    /// Close camera stream.
    ///
    /// Close one opened camera stream and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamClose(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Start camera stream.
    ///
    /// Start one opened camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream start operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.start", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamStart(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Stop camera stream.
    ///
    /// Stop one running camera stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend stream stop operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.stop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamStop(handle: CameraStreamHandle): Result<void, PlatformError>;

    /// Read camera frame.
    ///
    /// Wait for one camera frame from one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamRead(handle: CameraStreamHandle, timeoutNs: uint64): Result<CameraFrame, PlatformError>;

    /// Poll camera frame without blocking.
    ///
    /// Poll one camera frame from one running stream without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking camera frame queue operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.capture`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.capture"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function cameraStreamTryRead(handle: CameraStreamHandle): Result<CameraFrame, PlatformError>;

    /// Set one camera control value.
    ///
    /// Apply one normalized camera control value in one running stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend camera control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.camera.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.camera.stream.setControl", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.camera.control"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function cameraStreamSetControl(
        handle: CameraStreamHandle,
        control: CameraControl,
        value: float64,
    ): Result<void, PlatformError>;
}
