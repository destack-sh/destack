import { Array, Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import {
    BluetoothDeviceHandle,
    BluetoothScanHandle,
    BluetoothSubscriptionHandle,
} from "../resource/index.ds";

/// Bluetooth adapter capability descriptor.
export struct BluetoothAdapterCapabilities {
    /// Whether the adapter supports Low Energy mode.
    lowEnergy: boolean;
    /// Whether the adapter supports Classic Bluetooth mode.
    classic: boolean;
    /// Whether the adapter supports central-role operations.
    central: boolean;
    /// Whether the adapter supports peripheral-role operations.
    peripheral: boolean;
    /// Whether the adapter supports extended advertising when known.
    extendedAdvertising?: boolean;
}

/// Bluetooth adapter descriptor.
export struct BluetoothAdapterDescriptor {
    /// Stable adapter identifier.
    id: string;
    /// Host-visible adapter name.
    name: string;
    /// Whether the adapter is powered.
    powered: boolean;
    /// Whether the adapter is currently discoverable when known.
    discoverable?: boolean;
    /// Whether the adapter is currently scanning or discovering when known.
    discovering?: boolean;
    /// Adapter capability descriptor.
    capabilities: BluetoothAdapterCapabilities;
}

/// Bluetooth scan mode.
export enum BluetoothScanMode {
    /// Passive scan mode.
    Passive = 1,
    /// Active scan mode.
    Active = 2,
}

/// Bluetooth transport selector.
export enum BluetoothTransport {
    /// LE transport only.
    LowEnergy = 1,
    /// Classic transport only.
    Classic = 2,
    /// Dual-mode transport selection.
    Dual = 3,
}

/// Bluetooth LE PHY selector.
export enum BluetoothPhy {
    /// LE 1M PHY.
    Le1M = 1,
    /// LE 2M PHY.
    Le2M = 2,
    /// LE coded PHY.
    LeCoded = 3,
    /// Host default PHY policy.
    Any = 4,
}

/// Bluetooth advertisement data filter.
export struct BluetoothDataFilter {
    /// Required leading bytes in the payload.
    dataPrefix: Slice<uint8>;
    /// Optional bit mask applied to `dataPrefix`.
    mask?: Slice<uint8>;
}

/// Bluetooth advertisement manufacturer-data filter.
export struct BluetoothManufacturerDataFilter {
    /// Bluetooth company identifier.
    companyId: uint16;
    /// Optional manufacturer payload filter.
    data?: BluetoothDataFilter;
}

/// Bluetooth advertisement service-data filter.
export struct BluetoothServiceDataFilter {
    /// Service UUID.
    serviceUuid: string;
    /// Optional service payload filter.
    data?: BluetoothDataFilter;
}

/// Bluetooth GATT write mode.
export enum BluetoothGattWriteMode {
    /// Write with an ATT response.
    WithResponse = 1,
    /// Write without an ATT response.
    WithoutResponse = 2,
}

/// Bluetooth advertisement manufacturer payload.
export struct BluetoothAdvertisementManufacturerData {
    /// Bluetooth company identifier.
    companyId: uint16;
    /// Manufacturer payload bytes.
    data: Slice<uint8>;
}

/// Bluetooth advertisement service payload.
export struct BluetoothAdvertisementServiceData {
    /// Service UUID.
    serviceUuid: string;
    /// Service payload bytes.
    data: Slice<uint8>;
}

/// Bluetooth advertisement payload.
export struct BluetoothAdvertisementData {
    /// Advertised local name when available.
    localName?: string;
    /// Advertised transmit power in dBm when available.
    txPower?: int16;
    /// Service UUID list.
    serviceUuids: Array<string>;
    /// Manufacturer payload entries.
    manufacturerData: Array<BluetoothAdvertisementManufacturerData>;
    /// Service payload entries.
    serviceData: Array<BluetoothAdvertisementServiceData>;
}

/// Bluetooth pairing state.
export enum BluetoothPairState {
    /// Pairing state is unknown.
    Unknown = 1,
    /// Device is not paired.
    Unpaired = 2,
    /// Pairing is in progress.
    Pairing = 3,
    /// Device is paired.
    Paired = 4,
}

/// Bluetooth device descriptor.
export struct BluetoothDeviceDescriptor {
    /// Stable device identifier.
    id: string;
    /// Device address string when the host exposes one.
    address?: string;
    /// Host-visible device name when available.
    name?: string;
    /// Signal strength in dBm when available.
    rssi?: int32;
    /// Whether the device is currently paired when the host reports it.
    paired?: boolean;
    /// Pairing state when reported by host.
    pairState?: BluetoothPairState;
    /// Whether the device is currently connected.
    connected: boolean;
    /// Whether this advertisement indicates connectable state when known.
    connectable?: boolean;
    /// Host-reported transport classification when available.
    transport?: BluetoothTransport;
    /// Advertisement payload.
    advertisement: BluetoothAdvertisementData;
}

/// Bluetooth scan filter.
export struct BluetoothScanFilter {
    /// Service UUID filters.
    serviceUuids: Array<string>;
    /// Exact device name filter.
    name?: string;
    /// Device name prefix filter.
    namePrefix?: string;
    /// Manufacturer-data filters.
    manufacturerData: Array<BluetoothManufacturerDataFilter>;
    /// Service-data filters.
    serviceData: Array<BluetoothServiceDataFilter>;
    /// Whether to retain repeated advertisements.
    keepRepeatedDevices: boolean;
    /// Minimum RSSI filter in dBm.
    minimumRssi?: int32;
    /// Transport selector.
    transport?: BluetoothTransport;
    /// Scan mode selector.
    scanMode?: BluetoothScanMode;
    /// Preferred primary PHY.
    primaryPhy?: BluetoothPhy;
    /// Preferred secondary PHY.
    secondaryPhy?: BluetoothPhy;
}

/// GATT characteristic property set.
export struct BluetoothGattCharacteristicProperties {
    /// Whether broadcast writes are supported.
    broadcast: boolean;
    /// Whether characteristic reads are supported.
    read: boolean;
    /// Whether writes without response are supported.
    writeWithoutResponse: boolean;
    /// Whether writes with response are supported.
    write: boolean;
    /// Whether notifications are supported.
    notify: boolean;
    /// Whether indications are supported.
    indicate: boolean;
    /// Whether signed writes are supported.
    authenticatedSignedWrites: boolean;
    /// Whether reliable writes are supported.
    reliableWrite: boolean;
    /// Whether writable auxiliaries are supported.
    writableAuxiliaries: boolean;
}

/// GATT value notification event.
export struct BluetoothGattValueEvent {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Stable service identifier within this device session.
    serviceId: string;
    /// Stable characteristic identifier within this device session.
    characteristicId: string;
    /// Service UUID.
    serviceUuid: string;
    /// Characteristic UUID.
    characteristicUuid: string;
    /// Characteristic value bytes.
    value: Slice<uint8>;
}

/// Shared metadata for Bluetooth scan events.
export struct BluetoothScanEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this scan stream.
    sequence: uint64;
    /// Device descriptor payload for this event.
    device: BluetoothDeviceDescriptor;
}

/// Bluetooth scan discovered event.
export struct BluetoothScanDiscoveredEvent {
    /// Discriminator for this Bluetooth scan event variant.
    kind: "discovered";
    /// Shared event metadata.
    metadata: BluetoothScanEventMetadata;
}

/// Bluetooth scan updated event.
export struct BluetoothScanUpdatedEvent {
    /// Discriminator for this Bluetooth scan event variant.
    kind: "updated";
    /// Shared event metadata.
    metadata: BluetoothScanEventMetadata;
}

/// Bluetooth scan lost event.
export struct BluetoothScanLostEvent {
    /// Discriminator for this Bluetooth scan event variant.
    kind: "lost";
    /// Shared event metadata.
    metadata: BluetoothScanEventMetadata;
}

/// Bluetooth scan event payload.
export newtype BluetoothScanEvent =
    | BluetoothScanDiscoveredEvent
    | BluetoothScanUpdatedEvent
    | BluetoothScanLostEvent;

/// Shared metadata for Bluetooth session events.
export struct BluetoothSessionEventMetadata {
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this session event stream.
    sequence: uint64;
}

/// Bluetooth session disconnected payload.
export struct BluetoothSessionDisconnectedPayload {}

/// Bluetooth session pair-state-changed payload.
export struct BluetoothSessionPairStateChangedPayload {
    /// Current pairing state.
    pairState: BluetoothPairState;
}

/// Bluetooth session GATT-database-changed payload.
export struct BluetoothSessionGattDatabaseChangedPayload {}

/// Bluetooth session disconnected event.
export struct BluetoothSessionDisconnectedEvent {
    /// Discriminator for this Bluetooth session event variant.
    kind: "disconnected";
    /// Shared event metadata.
    metadata: BluetoothSessionEventMetadata;
    /// Session event payload.
    payload: BluetoothSessionDisconnectedPayload;
}

/// Bluetooth session pair-state-changed event.
export struct BluetoothSessionPairStateChangedEvent {
    /// Discriminator for this Bluetooth session event variant.
    kind: "pairStateChanged";
    /// Shared event metadata.
    metadata: BluetoothSessionEventMetadata;
    /// Session event payload.
    payload: BluetoothSessionPairStateChangedPayload;
}

/// Bluetooth session GATT-database-changed event.
export struct BluetoothSessionGattDatabaseChangedEvent {
    /// Discriminator for this Bluetooth session event variant.
    kind: "gattDatabaseChanged";
    /// Shared event metadata.
    metadata: BluetoothSessionEventMetadata;
    /// Session event payload.
    payload: BluetoothSessionGattDatabaseChangedPayload;
}

/// Bluetooth session event payload.
export newtype BluetoothSessionEvent =
    | BluetoothSessionDisconnectedEvent
    | BluetoothSessionPairStateChangedEvent
    | BluetoothSessionGattDatabaseChangedEvent;

/// GATT service descriptor.
export struct BluetoothGattServiceDescriptor {
    /// Stable service identifier within this device session.
    id: string;
    /// Service UUID.
    uuid: string;
    /// Whether this service is primary.
    primary: boolean;
    /// Included service identifiers.
    includedServiceIds: Array<string>;
}

/// GATT characteristic descriptor.
export struct BluetoothGattCharacteristicDescriptor {
    /// Stable characteristic identifier within this device session.
    id: string;
    /// Parent service identifier.
    serviceId: string;
    /// Characteristic UUID.
    uuid: string;
    /// Characteristic property set.
    properties: BluetoothGattCharacteristicProperties;
}

/// GATT descriptor descriptor.
export struct BluetoothGattDescriptorDescriptor {
    /// Stable descriptor identifier within this device session.
    id: string;
    /// Parent service identifier.
    serviceId: string;
    /// Parent characteristic identifier.
    characteristicId: string;
    /// Descriptor UUID.
    uuid: string;
}

/// Bluetooth bindings.
declare namespace device {
    /// List Bluetooth adapters.
    ///
    /// Enumerate host Bluetooth adapters and return stable identifiers.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth adapter enumeration APIs.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.adapterList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothAdapterList(): Result<Slice<BluetoothAdapterDescriptor>, PlatformError>;

    /// Open Bluetooth scan session.
    ///
    /// Open one Bluetooth scan session on one adapter with one optional filter.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth scan APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothScanOpen(
        adapterId: string,
        filter?: BluetoothScanFilter,
    ): Result<BluetoothScanHandle, PlatformError>;

    /// Close Bluetooth scan session.
    ///
    /// Close one scan session and stop host discovery operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth scan-stop APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothScanClose(handle: BluetoothScanHandle): Result<void, PlatformError>;

    /// Wait for one scanned device.
    ///
    /// Wait for one scanned device advertisement from one opened scan session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth scan result queues.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothScanRead(
        handle: BluetoothScanHandle,
        timeoutNs: uint64,
    ): Result<BluetoothDeviceDescriptor, PlatformError>;

    /// Poll one scanned device without blocking.
    ///
    /// Poll one scanned device advertisement from one opened scan session without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth nonblocking scan result reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function bluetoothScanTryRead(handle: BluetoothScanHandle): Result<BluetoothDeviceDescriptor, PlatformError>;

    /// Wait for one Bluetooth scan event.
    ///
    /// Wait for one typed scan event from one opened scan session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth scan event queues.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.readEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothScanReadEvent(
        handle: BluetoothScanHandle,
        timeoutNs: uint64,
    ): Result<BluetoothScanEvent, PlatformError>;

    /// Poll one Bluetooth scan event without blocking.
    ///
    /// Poll one typed scan event from one opened scan session without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host nonblocking Bluetooth scan event reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.scan`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.scan.tryReadEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.scan"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function bluetoothScanTryReadEvent(
        handle: BluetoothScanHandle,
    ): Result<BluetoothScanEvent, PlatformError>;

    /// Open Bluetooth device session.
    ///
    /// Open one device session for link and GATT operations.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth connect APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.session.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothOpen(
        adapterId: string,
        deviceId: string,
    ): Result<BluetoothDeviceHandle, PlatformError>;

    /// Close Bluetooth device session.
    ///
    /// Close one opened Bluetooth device session and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth disconnect APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.session.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothClose(handle: BluetoothDeviceHandle): Result<void, PlatformError>;

    /// Wait for one Bluetooth session event.
    ///
    /// Wait for one typed session event from one opened Bluetooth device session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth link-state and pairing event queues where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.session.readEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothSessionReadEvent(
        handle: BluetoothDeviceHandle,
        timeoutNs: uint64,
    ): Result<BluetoothSessionEvent, PlatformError>;

    /// Poll one Bluetooth session event without blocking.
    ///
    /// Poll one typed session event from one opened Bluetooth device session without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host nonblocking Bluetooth session event reads where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.session.tryReadEvent", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function bluetoothSessionTryReadEvent(
        handle: BluetoothDeviceHandle,
    ): Result<BluetoothSessionEvent, PlatformError>;

    /// Pair one Bluetooth device.
    ///
    /// Pair one opened Bluetooth device session with host bonding APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host pairing and bonding APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.device.bluetooth.session.pair", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothPair(
        handle: BluetoothDeviceHandle,
        timeoutNs: uint64,
    ): Result<void, PlatformError>;

    /// Remove one Bluetooth device bond.
    ///
    /// Remove host bond state for one Bluetooth device on one adapter.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host unpair or remove-device APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.device.bluetooth.session.unpair", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothUnpair(
        adapterId: string,
        deviceId: string,
    ): Result<void, PlatformError>;

    /// Read link RSSI for one Bluetooth device session.
    ///
    /// Read current received signal strength indicator for one connected device session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth RSSI query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.session.rssi", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.connect"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothReadRssi(
        handle: BluetoothDeviceHandle,
        timeoutNs: uint64,
    ): Result<int32, PlatformError>;

    /// List discovered GATT services.
    ///
    /// Enumerate GATT services available on one connected device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses CoreBluetooth, BluetoothGatt, and host Bluetooth stack service-discovery APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.gatt`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.gatt.serviceList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.gatt"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothGattServiceList(handle: BluetoothDeviceHandle): Result<Slice<BluetoothGattServiceDescriptor>, PlatformError>;

    /// List discovered GATT characteristics for one service.
    ///
    /// Enumerate GATT characteristics in one selected service.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth GATT characteristic-discovery APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.gatt`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.gatt.characteristicList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.gatt"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothGattCharacteristicList(
        handle: BluetoothDeviceHandle,
        serviceId: string,
    ): Result<Slice<BluetoothGattCharacteristicDescriptor>, PlatformError>;

    /// List discovered GATT descriptors for one characteristic.
    ///
    /// Enumerate GATT descriptors in one selected service and characteristic.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host Bluetooth GATT descriptor-discovery APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.gatt`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.gatt.descriptorList", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.gatt"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothGattDescriptorList(
        handle: BluetoothDeviceHandle,
        characteristicId: string,
    ): Result<Slice<BluetoothGattDescriptorDescriptor>, PlatformError>;

    /// Read one GATT descriptor value.
    ///
    /// Read one descriptor value from one connected Bluetooth device session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host GATT descriptor read APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.gatt`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.gatt.readDescriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["device.bluetooth.gatt"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function bluetoothGattReadDescriptor(
        handle: BluetoothDeviceHandle,
        descriptorId: string,
        timeoutNs: uint64,
    ): Result<Slice<uint8>, PlatformError>;

    /// Write one GATT descriptor value.
    ///
    /// Write one descriptor value on one connected Bluetooth device session.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host GATT descriptor write APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `device.bluetooth.gatt`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.device.bluetooth.gatt.writeDescriptor", {
        effect: "external",
