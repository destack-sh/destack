import type { PlatformError } from "../error/index.ds";
import { TraceHandle } from "../resource/index.ds";

/// Trace verbosity level.
export enum TraceLevel {
    /// Emit critical events only.
    Error = 1,
    /// Emit warning and critical events.
    Warn = 2,
    /// Emit informational and above events.
    Info = 3,
    /// Emit verbose diagnostic events.
    Debug = 4,
}

/// Trace stream control bindings.
declare namespace debug {
    /// Start a runtime trace stream.
    ///
    /// Start one trace stream for runtime events with the requested level and destination.
    /// Destination routing is runtime-defined and may target file, socket, or collector backends.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime trace pipeline, optionally backed by host transports.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `debug.trace`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.debug.trace.start",
        {
            effect: "external",
            replay: "recordable",
            requires: ["debug.trace"],
            platforms: ["unix", "windows", "wasi"],
            scope: "runtime",
            blocking: "sometimes",
        },
    )
    export function traceStart(level: TraceLevel, destination: string): Result<TraceHandle, PlatformError>;

    /// Stop a runtime trace stream.
    ///
    /// Stop one active trace stream and flush buffered events.
    /// Flush behavior and durability guarantees follow runtime trace backend policy.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime trace stream teardown and flush logic.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `debug.trace`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.debug.trace.stop",
        {
            effect: "external",
            replay: "recordable",
            requires: ["debug.trace"],
            platforms: ["unix", "windows", "wasi"],
            scope: "runtime",
            blocking: "sometimes",
        },
    )
    export function traceStop(handle: TraceHandle): Result<void, PlatformError>;

    /// Emit one trace event.
    ///
    /// Append one structured trace record to the active runtime trace stream.
    /// Event ordering follows runtime scheduling and stream flush policy.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime trace event encoder and sink.
    ///
    /// # Errors
    /// Returns invalidArgument, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `debug.trace`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.debug.trace.emit",
        {
            effect: "external",
            replay: "recordable",
            requires: ["debug.trace"],
            platforms: ["unix", "windows", "wasi"],
            scope: "runtime",
            blocking: "sometimes",
        },
    )
    export function traceEmit(category: string, name: string, payloadJson: string): Result<void, PlatformError>;
}
