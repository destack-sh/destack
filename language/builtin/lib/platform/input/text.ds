import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle } from "../resource/index.ds";
import { InputEventAction } from "./event.ds";
import { InputWindowTarget } from "./target.ds";

/// Text input type hint.
export enum InputTextInputType {
    /// General free-form text.
    Text = 0,
    /// Numeric text input.
    Number = 1,
    /// Email text input.
    Email = 2,
    /// URL text input.
    Url = 3,
    /// Password text input.
    Password = 4,
    /// Phone number text input.
    Phone = 5,
}

/// Text input area geometry.
export struct InputTextInputArea {
    /// Area left coordinate in backend-native units.
    x: int32;
    /// Area top coordinate in backend-native units.
    y: int32;
    /// Area width in backend-native units.
    width: uint32;
    /// Area height in backend-native units.
    height: uint32;
    /// Cursor offset inside the text area.
    cursor: int32;
}

/// Composition event payload.
export struct InputCompositionEvent {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Composition action kind.
    action: InputEventAction;
    /// UTF-8 composition payload.
    text: string;
    /// Selection start offset when reported by backend.
    selectionStart: int32;
    /// Selection end offset when reported by backend.
    selectionEnd: int32;
}

/// Input text bindings.
declare namespace input {
    /// Start text input.
    ///
    /// Enable text input and composition dispatch for one opened input device and one optional window target.
    /// Text conversion behavior follows host IME and keyboard policy for the selected target scope.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Returns operation-level `notSupported` where text input sessions or one window scope are unavailable.
    /// Uses backend-specific text input activation primitives.
    /// Uses host IME activation for global or window-scoped paths.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.start", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function textStart(
        handle: InputDeviceHandle,
        target: InputWindowTarget,
        inputType: InputTextInputType,
    ): Result<void, PlatformError>;

    /// Stop text input.
    ///
    /// Disable text input and composition dispatch for one opened input device and one optional window target.
    /// Pending composition updates are finalized or canceled according to backend policy for the selected target scope.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where one window scope is unavailable.
    /// Uses backend-specific text input deactivation primitives for global or window-scoped paths.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.stop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function textStop(
        handle: InputDeviceHandle,
        target: InputWindowTarget,
    ): Result<void, PlatformError>;

    /// Query text input active state.
    ///
    /// Return whether text input is currently active for one opened input device.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific text session status checks.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.isActive", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function textIsActive(handle: InputDeviceHandle): Result<boolean, PlatformError>;

    /// Set text input area.
    ///
    /// Set one text input area and cursor position hint for one opened input device and one optional window target.
    /// Area hints are used by host IME placement when supported for the selected target scope.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where text-area hints or one window scope are unavailable.
    /// Uses backend-specific IME candidate window placement hints for global or window-scoped paths.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.setArea", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function textSetArea(
        handle: InputDeviceHandle,
        target: InputWindowTarget,
        area: InputTextInputArea,
    ): Result<void, PlatformError>;

    /// Get text input area.
    ///
    /// Return the currently configured text input area and cursor position hint.
    /// Resolve state for one opened input device and one optional window target.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where one window scope is unavailable.
    /// Uses backend-specific text-area hint state tracking for global or window-scoped paths.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.getArea", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function textGetArea(
        handle: InputDeviceHandle,
        target: InputWindowTarget,
    ): Result<InputTextInputArea, PlatformError>;

    /// Read one composition event.
    ///
    /// Read one pending composition lifecycle event for one opened input device.
    /// Composition events represent begin, update, commit, end, and cancel transitions.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where composition events are unavailable.
    /// Uses backend-specific IME composition queues.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.readComposition", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function textReadComposition(
        handle: InputDeviceHandle,
    ): Result<InputCompositionEvent, PlatformError>;

    /// Poll one composition event without blocking.
    ///
    /// Poll one pending composition lifecycle event and return immediately when no event is queued.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where composition events are unavailable.
    /// Uses backend-specific nonblocking IME composition queue reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.text`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.text.tryReadComposition", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.text"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function textTryReadComposition(
        handle: InputDeviceHandle,
    ): Result<InputCompositionEvent, PlatformError>;
}
