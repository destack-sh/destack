import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle, InputMonitorHandle } from "../resource/index.ds";
import { InputDeviceKind } from "./device.ds";

/// Input event action.
export enum InputEventAction {
    /// One input control became active.
    Press = 1,
    /// One input control became inactive.
    Release = 2,
    /// One input control repeated while held.
    Repeat = 3,
    /// One continuous control moved.
    Move = 4,
    /// One scroll axis changed.
    Scroll = 5,
    /// One analog axis changed.
    Axis = 6,
    /// One text payload was emitted.
    Text = 7,
    /// One source became available.
    Connect = 8,
    /// One source became unavailable.
    Disconnect = 9,
    /// One active gesture or contact was canceled.
    Cancel = 10,
    /// One composite operation started.
    Begin = 11,
    /// One composite operation updated.
    Update = 12,
    /// One composite operation committed.
    Commit = 13,
    /// One composite operation ended.
    End = 14,
}

/// Input read mode.
export enum InputReadMode {
    /// Read translated events where the host backend applies keymap and composition behavior when applicable.
    Cooked = 1,
    /// Read raw hardware-style events where available.
    Raw = 2,
}

/// Key event payload.
export struct InputKeyEventPayload {
    /// Key action.
    action: InputEventAction;
    /// Backend-native key code.
    backendCode: uint32;
    /// Backend-native scan code when available.
    backendScanCode: uint32;
    /// Backend-native key value.
    backendValue: int64;
    /// Backend modifier bitset.
    modifiers: uint32;
    /// Whether this key event is a repeat.
    repeat: boolean;
}

/// Pointer motion event payload.
export struct InputPointerMotionEventPayload {
    /// Pointer x coordinate or delta.
    x: float64;
    /// Pointer y coordinate or delta.
    y: float64;
    /// Backend button bitset.
    buttons: uint32;
    /// Backend modifier bitset.
    modifiers: uint32;
}

/// Pointer button event payload.
export struct InputPointerButtonEventPayload {
    /// Button action.
    action: InputEventAction;
    /// Backend-native button code.
    backendCode: uint32;
    /// Backend-native button value.
    backendValue: int64;
    /// Pointer x coordinate.
    x: float64;
    /// Pointer y coordinate.
    y: float64;
    /// Backend modifier bitset.
    modifiers: uint32;
}

/// Scroll event payload.
export struct InputScrollEventPayload {
    /// Horizontal wheel delta.
    wheelX: float64;
    /// Vertical wheel delta.
    wheelY: float64;
    /// Pointer x coordinate.
    x: float64;
    /// Pointer y coordinate.
    y: float64;
    /// Backend modifier bitset.
    modifiers: uint32;
}

/// Touch event payload.
export struct InputTouchEventPayload {
    /// Touch action.
    action: InputEventAction;
    /// Backend contact identifier.
    contactId: uint32;
    /// Contact x coordinate.
    x: float64;
    /// Contact y coordinate.
    y: float64;
    /// Contact pressure when available.
    pressure: float64;
}

/// Gamepad event payload.
export struct InputGamepadEventPayload {
    /// Gamepad action.
    action: InputEventAction;
    /// Backend-native control code.
    backendCode: uint32;
    /// Backend-native control value.
    backendValue: int64;
}

/// Text event payload.
export struct InputTextEventPayload {
    /// UTF-8 text payload.
    text: string;
}

/// Device event payload.
export struct InputDeviceEventPayload {
    /// Device action.
    action: InputEventAction;
    /// Backend-native device code.
    backendCode: uint32;
    /// Backend-native device value.
    backendValue: int64;
}

/// Sensor event payload.
export struct InputSensorEventPayload {
    /// Sensor action.
    action: InputEventAction;
    /// Backend-native sensor code.
    backendCode: uint32;
    /// Backend-native sensor value.
    backendValue: int64;
    /// Sensor x component when available.
    x: float64;
    /// Sensor y component when available.
    y: float64;
    /// Sensor z component when available.
    z: float64;
}

/// Composition event payload.
export struct InputCompositionEventPayload {
    /// Composition action.
    action: InputEventAction;
    /// UTF-8 composition text.
    text: string;
    /// Selection start offset when available.
    selectionStart: int32;
    /// Selection end offset when available.
    selectionEnd: int32;
}

/// Shared metadata for all input events.
export struct InputEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
}

/// Key input event.
export struct InputKeyEvent {
    /// Discriminator for this input event variant.
    kind: "key";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Key payload.
    payload: InputKeyEventPayload;
}

/// Pointer-motion input event.
export struct InputPointerMotionEvent {
    /// Discriminator for this input event variant.
    kind: "pointerMotion";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Pointer-motion payload.
    payload: InputPointerMotionEventPayload;
}

/// Pointer-button input event.
export struct InputPointerButtonEvent {
    /// Discriminator for this input event variant.
    kind: "pointerButton";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Pointer-button payload.
    payload: InputPointerButtonEventPayload;
}

/// Scroll input event.
export struct InputScrollEvent {
    /// Discriminator for this input event variant.
    kind: "scroll";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Scroll payload.
    payload: InputScrollEventPayload;
}

/// Touch input event.
export struct InputTouchEvent {
    /// Discriminator for this input event variant.
    kind: "touch";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Touch payload.
    payload: InputTouchEventPayload;
}

/// Gamepad input event.
export struct InputGamepadEvent {
    /// Discriminator for this input event variant.
    kind: "gamepad";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Gamepad payload.
    payload: InputGamepadEventPayload;
}

/// Text input event.
export struct InputTextEvent {
    /// Discriminator for this input event variant.
    kind: "text";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Text payload.
    payload: InputTextEventPayload;
}

/// Device input event.
export struct InputDeviceEvent {
    /// Discriminator for this input event variant.
    kind: "device";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Device payload.
    payload: InputDeviceEventPayload;
}

/// Sensor input event.
export struct InputSensorEvent {
    /// Discriminator for this input event variant.
    kind: "sensor";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Sensor payload.
    payload: InputSensorEventPayload;
}

/// Composition input event.
export struct InputCompositionEvent {
    /// Discriminator for this input event variant.
    kind: "composition";
    /// Shared event metadata.
    metadata: InputEventMetadata;
    /// Composition payload.
    payload: InputCompositionEventPayload;
}

/// Input event payload.
export newtype InputEvent = InputKeyEvent | InputPointerMotionEvent | InputPointerButtonEvent | InputScrollEvent | InputTouchEvent | InputGamepadEvent | InputTextEvent | InputDeviceEvent | InputSensorEvent | InputCompositionEvent;

/// Shared metadata for all monitor events.
export struct InputMonitorEventMetadata {
    /// Monotonic event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the monitor stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Device kind when available.
    deviceKind: InputDeviceKind;
    /// Whether the device is connected after this event.
    connected: boolean;
}

/// Device-connected monitor event.
export struct InputMonitorConnectEvent {
    /// Discriminator for this input monitor event variant.
    kind: "connect";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device-disconnected monitor event.
export struct InputMonitorDisconnectEvent {
    /// Discriminator for this input monitor event variant.
    kind: "disconnect";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device-changed monitor event.
export struct InputMonitorChangeEvent {
    /// Discriminator for this input monitor event variant.
    kind: "change";
    /// Shared monitor event metadata.
    metadata: InputMonitorEventMetadata;
}

/// Device monitor event payload.
export newtype InputMonitorEvent = InputMonitorConnectEvent | InputMonitorDisconnectEvent | InputMonitorChangeEvent;

/// Input event bindings.
declare namespace input {
    /// Open one global input event monitor.
    ///
    /// Open one monitor stream that reports host input topology events, including connect and disconnect.
    /// Monitor streams are independent from per-device data streams.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses inotify-backed `/dev/input` monitor events on Linux.
    /// Falls back to snapshot scans on Linux when watcher setup is unavailable.
    /// Uses session and terminal-device scans on macOS and other Unix hosts.
    /// Uses raw-input device-change subscriptions on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorOpen(): Result<InputMonitorHandle, PlatformError>;

    /// Close one global input event monitor.
    ///
    /// Close one opened monitor stream and release host subscription resources.
    /// Pending unread monitor events are discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses close(2) on Unix and CloseHandle on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorClose(handle: InputMonitorHandle): Result<void, PlatformError>;

    /// Read one global input monitor event.
    ///
    /// Read one pending monitor event from the global input monitor stream.
    /// This stream is the canonical source for device connect, disconnect, and metadata-change events.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses blocking reads from inotify-backed Linux monitor queues.
    /// Falls back to snapshot scans on Linux when watcher setup is unavailable.
    /// Uses terminal or session monitor streams on Unix hosts.
    /// Uses raw-input monitor queues on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorRead(handle: InputMonitorHandle): Result<InputMonitorEvent, PlatformError>;

    /// Poll one global input monitor event without blocking.
    ///
    /// Poll one pending monitor event and return immediately when no event is queued.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses nonblocking reads from inotify-backed Linux monitor queues.
    /// Falls back to snapshot scans on Linux when watcher setup is unavailable.
    /// Uses terminal or session monitor streams on Unix hosts.
    /// Uses raw-input monitor queues on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
    })
    export function monitorTryRead(handle: InputMonitorHandle): Result<InputMonitorEvent, PlatformError>;

    /// Read one input event.
    ///
    /// Read one pending input event from one opened device stream.
    /// Per-device streams report control and motion events for that device and exclude global device topology events.
    /// Backend framing packets are filtered from this semantic stream.
    /// Queue pressure can report one device cancel packet through the typed payload.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses evdev event reads on Linux.
    /// Uses event-tap queue reads on macOS.
    /// Uses terminal-byte event reads on other Unix hosts.
    /// Uses `ReadConsoleInputW` queue reads or raw-state polling on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function read(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

    /// Poll one input event without blocking.
    ///
    /// Poll one pending input event from one opened device stream and return immediately when no event is queued.
    /// Empty queue state is reported through ioWouldBlock.
    /// Backend framing packets are filtered from this semantic stream.
    /// Queue pressure can report one device cancel packet through the typed payload.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses nonblocking evdev reads on Linux.
    /// Uses nonblocking event-tap queue reads on macOS.
    /// Uses nonblocking terminal-byte reads on other Unix hosts.
    /// Uses nonblocking console queue reads or raw-state polling on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
    })
    export function tryRead(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

    /// Read one batch of input events.
    ///
    /// Read up to `maxEvents` events from one opened device stream in one call.
    /// Batch ordering matches backend delivery order and excludes global device topology events.
    /// Backend framing packets are filtered from this semantic stream.
    /// Queue pressure can report one device cancel packet through the typed payload.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses batched reads when supported and runtime looped reads otherwise.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.readBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function readBatch(
        handle: InputDeviceHandle,
        maxEvents: uint32,
    ): Result<Array<InputEvent>, PlatformError>;

    /// Enable or disable exclusive device grab.
    ///
    /// Toggle exclusive-grab mode for one input device when the host backend supports it.
    /// This is one device-wide exclusivity control and is distinct from pointer confinement or locking modes.
    /// Grabs can prevent event delivery to other clients.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where exclusive grab is not defined by host policy.
    /// Uses `EVIOCGRAB` on Linux.
    /// Returns `notSupported` for global-session and terminal-backed Unix input.
    /// Uses `SetConsoleMode` capture toggles on Windows console input.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.grab`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.setExclusiveGrab", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.grab"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function setExclusiveGrab(handle: InputDeviceHandle, enable: boolean): Result<void, PlatformError>;

    /// Select event decoding mode for one input stream.
    ///
    /// Select translated or raw decoding mode for one opened input endpoint.
    /// Hosts can return notSupported when raw mode is unavailable for the selected endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses per-stream runtime mode selection on Linux evdev and macOS session backends.
    /// Uses termios raw and cooked mode updates on Unix TTY paths.
    /// Uses `SetConsoleMode` updates on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.setReadMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.control"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
    })
    export function setReadMode(handle: InputDeviceHandle, mode: InputReadMode): Result<void, PlatformError>;
}
