import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { InputDeviceHandle, InputMonitorHandle } from "../resource/index.ds";

/// Input event kind.
export enum InputEventKind {
    /// Key event.
    Key = 1,
    /// Pointer motion event.
    PointerMotion = 2,
    /// Pointer button event.
    PointerButton = 3,
    /// Scroll wheel event.
    Scroll = 4,
    /// Touch event.
    Touch = 5,
    /// Gamepad axis or button event.
    Gamepad = 6,
    /// Text input event.
    Text = 7,
    /// Device connection state event.
    Device = 8,
    /// Sensor event.
    Sensor = 9,
}

/// Input event action.
export enum InputEventAction {
    /// One input control became active.
    Press = 1,
    /// One input control became inactive.
    Release = 2,
    /// One input control repeated while held.
    Repeat = 3,
    /// One continuous control moved.
    Move = 4,
    /// One scroll axis changed.
    Scroll = 5,
    /// One analog axis changed.
    Axis = 6,
    /// One text payload was emitted.
    Text = 7,
    /// One source became available.
    Connect = 8,
    /// One source became unavailable.
    Disconnect = 9,
    /// One active gesture or contact was canceled.
    Cancel = 10,
}

/// Input read mode.
export enum InputReadMode {
    /// Read translated events where the host backend applies keymap and composition behavior when applicable.
    Cooked = 1,
    /// Read raw hardware-style events where available.
    Raw = 2,
}

/// Input event payload.
export struct InputEvent {
    /// Event kind selector.
    kind: InputEventKind;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number generated by the backend stream.
    sequence: uint64;
    /// Stable source device identifier.
    deviceId: string;
    /// Event action.
    action: InputEventAction;
    /// Event code value.
    code: uint32;
    /// Hardware scan code value when available.
    scanCode: uint32;
    /// Event value payload.
    value: int64;
    /// Event x coordinate when applicable.
    x: float64;
    /// Event y coordinate when applicable.
    y: float64;
    /// Event scroll delta on the horizontal axis.
    wheelX: float64;
    /// Event scroll delta on the vertical axis.
    wheelY: float64;
    /// Event modifiers bitset.
    modifiers: uint32;
    /// Whether this event represents a repeat.
    repeat: boolean;
    /// UTF-8 text payload for text events.
    text: string;
}

/// Input event bindings.
declare namespace input {
    /// Open one global input event monitor.
    ///
    /// Open one monitor stream that reports host input topology events, including connect and disconnect.
    /// Monitor streams are independent from per-device data streams.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses evdev monitor subscriptions on Linux, global-session subscriptions on macOS, terminal-device scans on other Unix hosts, and console-device subscriptions on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "sometimes",
    })
    export function monitorOpen(): Result<InputMonitorHandle, PlatformError>;

    /// Close one global input event monitor.
    ///
    /// Close one opened monitor stream and release host subscription resources.
    /// Pending unread monitor events are discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses close(2) on Unix and CloseHandle on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "sometimes",
    })
    export function monitorClose(handle: InputMonitorHandle): Result<void, PlatformError>;

    /// Read one global input monitor event.
    ///
    /// Read one pending monitor event from the global input monitor stream.
    /// This stream is the canonical source for device connect and disconnect events.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses blocking reads from evdev monitor streams on Linux, terminal or session monitor streams on Unix hosts, and console input event reads on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "sometimes",
    })
    export function monitorRead(handle: InputMonitorHandle): Result<InputEvent, PlatformError>;

    /// Poll one global input monitor event without blocking.
    ///
    /// Poll one pending monitor event and return immediately when no event is queued.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one global monitor stream.
    /// Uses nonblocking reads from evdev monitor streams on Linux, terminal or session monitor streams on Unix hosts, and console input event reads on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.monitorTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "never",
    })
    export function monitorTryRead(handle: InputMonitorHandle): Result<InputEvent, PlatformError>;

    /// Read one input event.
    ///
    /// Read one pending input event from one opened device stream.
    /// Per-device streams report control and motion events for that device and exclude global device topology events.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses evdev event reads on Linux, global-session state polling on macOS, terminal-byte event reads on other Unix hosts, and ReadConsoleInputW queue reads or raw-state polling on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "sometimes",
    })
    export function read(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

    /// Poll one input event without blocking.
    ///
    /// Poll one pending input event from one opened device stream and return immediately when no event is queued.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses nonblocking evdev reads on Linux, nonblocking global-session polling on macOS, nonblocking terminal-byte reads on other Unix hosts, and nonblocking console queue reads or raw-state polling on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "never",
    })
    export function tryRead(handle: InputDeviceHandle): Result<InputEvent, PlatformError>;

    /// Read one batch of input events.
    ///
    /// Read up to `maxEvents` events from one opened device stream in one call.
    /// Batch ordering matches backend delivery order and excludes global device topology events.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` on hosts that do not expose one readable input backend.
    /// Uses batched reads when supported and runtime looped reads otherwise.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `input.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.readBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.read"],
        platforms: ["windows", "unix"],
        scope: "hybrid",
        blocking: "sometimes",
    })
    export function readBatch(
        handle: InputDeviceHandle,
        maxEvents: uint32,
    ): Result<Array<InputEvent>, PlatformError>;

    /// Enable or disable exclusive device grab.
    ///
    /// Toggle exclusive-grab mode for one input device when the host backend supports it.
    /// Grabs can prevent event delivery to other clients.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` where exclusive grab is not defined by host policy.
    /// Uses EVIOCGRAB on Linux, returns notSupported for global-session and terminal-backed Unix input, and uses SetConsoleMode capture toggles on Windows console input.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.grab`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.setGrab", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.grab"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function setGrab(handle: InputDeviceHandle, enable: boolean): Result<void, PlatformError>;

    /// Select event decoding mode for one input stream.
    ///
    /// Select translated or raw decoding mode for one opened input endpoint.
    /// Hosts can return notSupported when raw mode is unavailable for the selected endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses EVIOCGRAB or evdev read-mode controls on Linux where supported, terminal mode toggles on Unix TTY paths, and SetConsoleMode updates on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `input.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.input.event.setReadMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["input.control"],
        platforms: ["windows", "unix"],
        scope: "os",
        blocking: "sometimes",
    })
    export function setReadMode(handle: InputDeviceHandle, mode: InputReadMode): Result<void, PlatformError>;
}
