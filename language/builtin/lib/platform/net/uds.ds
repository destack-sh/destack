import type { PlatformError } from "../error/index.ds";
import { ListenerHandle, SocketHandle } from "../resource/index.ds";
import { OsPath } from "../fs/path.ds";
import { SocketPair, SocketType } from "./socket.ds";

/// Address kind for unix domain sockets.
export enum UdsAddressKind {
    /// Filesystem-backed socket path.
    Path = 1,
    /// Linux abstract socket namespace.
    Abstract = 2,
    /// Unnamed address.
    Unnamed = 3,
}

/// Unix domain socket address payload.
export struct UdsAddress {
    /// Address payload kind.
    kind: UdsAddressKind;
    /// Filesystem path when `kind` is Path.
    path: OsPath;
    /// Abstract namespace name when `kind` is Abstract.
    abstractName: uint8[];
}

/// Unix domain socket (UDS) bindings for the native runtime.
///
/// On byte path targets, `OsPath.Utf16` inputs are transcoded before syscall dispatch.
/// Use `OsPath.Bytes` when socket paths contain non-UTF-8 bytes.
declare namespace net {
    /// Connect to a UDS endpoint.
    ///
    /// Connect to an existing AF_UNIX endpoint address.
    /// Address kind and endpoint type validation follow host AF_UNIX semantics.
    ///
    /// # Platform
    /// Unix and Windows only when AF_UNIX support is available at runtime.
    /// Uses connect(2) on AF_UNIX sockets on Unix and AF_UNIX connect on Windows where available.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.udsConnect", { effect: "external", replay: "recordable", requires: ["net.connect"], platforms: ["unix", "windows"], scope: "os", blocking: "sometimes" })
    export function udsConnect(address: UdsAddress): Result<SocketHandle, PlatformError>;

    /// Listen on a UDS address.
    ///
    /// Place the bound socket into passive listen mode with the requested backlog semantics.
    /// Path addresses are forwarded from `OsPath` without runtime normalization, while abstract and unnamed addresses follow host AF_UNIX rules.
    ///
    /// # Platform
    /// Unix and Windows only when AF_UNIX support is available at runtime.
    /// Uses bind(2)+listen(2) on AF_UNIX sockets on Unix and AF_UNIX listen on Windows where available.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.listen`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.udsListen", { effect: "external", replay: "recordable", requires: ["net.listen"], platforms: ["unix", "windows"], scope: "os", blocking: "sometimes" })
    export function udsListen(
        address: UdsAddress,
        backlog: uint32,
    ): Result<ListenerHandle, PlatformError>;

    /// Accept a connection from a UDS listener.
    ///
    /// Accept the next pending AF_UNIX stream connection.
    /// Accept ordering and descriptor flags follow host kernel semantics.
    ///
    /// # Platform
    /// Unix and Windows only when AF_UNIX support is available at runtime.
    /// Uses accept(2) on AF_UNIX sockets on Unix and accept on Windows where available.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.accept`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.udsAccept", { effect: "external", replay: "recordable", requires: ["net.accept"], platforms: ["unix", "windows"], scope: "os", blocking: "sometimes" })
    export function udsAccept(listener: ListenerHandle): Result<SocketHandle, PlatformError>;

    /// Close a UDS listener handle.
    ///
    /// Close an AF_UNIX listener socket descriptor.
    /// Pending accepts are interrupted according to host kernel semantics.
    ///
    /// # Platform
    /// Unix and Windows only when AF_UNIX support is available at runtime.
    /// Uses close(2) on Unix and closesocket on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.close`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.udsCloseListener", { effect: "external", replay: "recordable", requires: ["net.close"], platforms: ["unix", "windows"], scope: "os", blocking: "sometimes" })
    export function udsCloseListener(handle: ListenerHandle): Result<void, PlatformError>;

    /// Create a connected UDS socket pair.
    ///
    /// Allocate a connected AF_UNIX socket pair for local full-duplex messaging.
    /// Pair semantics and descriptor inheritance follow host kernel behavior.
    ///
    /// # Platform
    /// Unix and Windows only when AF_UNIX support is available at runtime.
    /// Uses socketpair(AF_UNIX) on Unix and runtime emulation on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.connect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.udsSocketPair", { effect: "external", replay: "recordable", requires: ["net.connect"], platforms: ["unix", "windows"], scope: "os", blocking: "sometimes" })
    export function udsSocketPair(socketType: SocketType): Result<SocketPair, PlatformError>;
}
