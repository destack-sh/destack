import type { PlatformError } from "../error/index.ds";
import { SocketHandle } from "../resource/index.ds";

/// TCP keepalive parameters.
export struct KeepAliveConfig {
    /// Whether keepalive probes are enabled.
    enabled: boolean;
    /// Idle time before probes begin, in seconds.
    idleSeconds: uint32;
    /// Interval between probes, in seconds.
    intervalSeconds: uint32;
    /// Number of failed probes before timeout.
    probeCount: uint32;
}

/// TCP socket option bindings for the native runtime.
declare namespace net {
    /// Enable or disable TCP_NODELAY.
    ///
    /// Set TCP_NODELAY on the target TCP socket.
    /// Nagle aggregation behavior changes immediately according to host TCP stack semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(TCP_NODELAY) on Unix and setsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.tcp.setNoDelay", { effect: "external", replay: "recordable", capabilities: ["net.control"], platforms: ["windows", "unix"], scope: "os", blocking: "never" })
    export function setNoDelay(
        handle: SocketHandle,
        enabled: boolean,
    ): Result<void, PlatformError>;

    /// Read TCP_NODELAY.
    ///
    /// Read the current TCP_NODELAY setting from the host TCP option layer.
    /// The returned boolean reflects whether Nagle aggregation is disabled for this socket.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(TCP_NODELAY) on Unix and getsockopt on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.tcp.getNoDelay", { effect: "external", replay: "recordable", capabilities: ["net.control"], platforms: ["windows", "unix"], scope: "os", blocking: "never" })
    export function getNoDelay(handle: SocketHandle): Result<boolean, PlatformError>;

    /// Write full TCP keepalive parameters.
    ///
    /// Set host keepalive configuration fields for this TCP socket.
    /// Unsupported subfields are returned as `notSupported` rather than silently ignored.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses setsockopt(SO_KEEPALIVE and TCP_KEEP*) on Unix and WSAIoctl on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.tcp.setKeepAlive", { effect: "external", replay: "recordable", capabilities: ["net.control"], platforms: ["windows", "unix"], scope: "os", blocking: "never" })
    export function setKeepAlive(
        handle: SocketHandle,
        config: KeepAliveConfig,
    ): Result<void, PlatformError>;

    /// Read full TCP keepalive parameters.
    ///
    /// Read host keepalive configuration fields for this TCP socket.
    /// Field units and defaults follow platform TCP stack semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the socket feature is unavailable.
    /// Uses getsockopt(SO_KEEPALIVE and TCP_KEEP*) on Unix and WSAIoctl on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, netTimedOut, netConnectionReset, netBrokenPipe, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `net.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.tcp.getKeepAlive", { effect: "external", replay: "recordable", capabilities: ["net.control"], platforms: ["windows", "unix"], scope: "os", blocking: "never" })
    export function getKeepAlive(handle: SocketHandle): Result<KeepAliveConfig, PlatformError>;
}
