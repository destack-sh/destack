import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { SocketAddress, SocketFamily } from "./address.ds";

/// Route entry kind.
export enum RouteKind {
    /// Unicast route.
    Unicast = 1,
    /// Local route.
    Local = 2,
    /// Broadcast route.
    Broadcast = 3,
    /// Multicast route.
    Multicast = 4,
    /// Blackhole route.
    Blackhole = 5,
}

/// Route table entry.
export struct RouteEntry {
    /// Route family.
    family: SocketFamily,
    /// Destination prefix address.
    destination: SocketAddress,
    /// Prefix length in bits.
    prefixLength: uint8,
    /// Next-hop gateway address.
    gateway: SocketAddress,
    /// Output interface index.
    interfaceIndex: uint32,
    /// Route metric.
    metric: uint32,
    /// Route kind.
    kind: RouteKind,
}

/// Route table bindings for the native runtime.
declare namespace net {
    /// List route table entries.
    ///
    /// Reads the host route table and returns route entries for the selected family.
    /// Results are snapshots and may become stale immediately after the call.
    ///
    /// # Platform
    /// Linux, BSD, and Windows.
    /// Uses netlink or routing sockets on Unix and iphlpapi route tables on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netTimedOut, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.route.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.routeList", { effect: "external", replay: "recordable", requires: ["net.route.read"], scope: "os", blocking: "sometimes" })
    export function routeList(family: SocketFamily): Result<Array<RouteEntry>, PlatformError>;

    /// Add a route table entry.
    ///
    /// Requests host route table insertion for the supplied entry.
    /// Host privilege and policy checks are enforced by the kernel.
    ///
    /// # Platform
    /// Linux, BSD, and Windows.
    /// Uses netlink or routing sockets on Unix and iphlpapi route mutation APIs on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.route.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.routeAdd", { effect: "external", replay: "recordable", requires: ["net.route.write"], scope: "os", blocking: "sometimes" })
    export function routeAdd(route: RouteEntry): Result<void, PlatformError>;

    /// Remove a route table entry.
    ///
    /// Requests host route table deletion for the supplied entry.
    /// Host privilege and policy checks are enforced by the kernel.
    ///
    /// # Platform
    /// Linux, BSD, and Windows.
    /// Uses netlink or routing sockets on Unix and iphlpapi route mutation APIs on Windows.
    ///
    /// # Errors
    /// Returns netAddressNotAvailable, netConnectionRefused, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `net.route.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.net.routeDelete", { effect: "external", replay: "recordable", requires: ["net.route.write"], scope: "os", blocking: "sometimes" })
    export function routeDelete(route: RouteEntry): Result<void, PlatformError>;

}
