import type { PlatformError } from "../error/index.ds";
import { EventFdHandle, ResourceId } from "../resource/index.ds";

/// Event token handle.
export newtype EventToken = uint64;

/// Flags for eventfd style descriptors.
export newtype EventFdFlags = uint32;

/// User-event bindings.
declare namespace io {
    /// Create a user-event token.
    ///
    /// Create one runtime user-event token for explicit wakeups and cross-task signaling.
    /// Token semantics are stable across runtime backends.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses eventfd or kqueue user events on Unix and event objects on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.open",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventOpen(initial: uint64): Result<EventToken, PlatformError>;

    /// Close a user-event token.
    ///
    /// Close one user-event token and release host resources.
    /// Closing behavior for waiters follows host wakeup semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses close semantics for eventfd, kqueue user events, or event objects.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.close",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventClose(token: EventToken): Result<void, PlatformError>;

    /// Signal a user-event token.
    ///
    /// Increment one user-event token and wake waiters.
    /// Counter saturation and coalescing are host-backend defined.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses eventfd write, kqueue trigger, or SetEvent on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.signal",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventSignal(token: EventToken, value: uint64): Result<void, PlatformError>;

    /// Read and consume one user-event token value.
    ///
    /// Read and consume one accumulated event counter value from one token.
    /// Counter consume semantics follow host event primitive behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses eventfd read, kqueue user-event readback, or event-object counter bridges on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.read",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventRead(token: EventToken): Result<uint64, PlatformError>;

    /// Try to read and consume one user-event token value.
    ///
    /// Attempt one nonblocking read of the event counter for one token.
    /// Returns ioWouldBlock when no value is currently available.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking eventfd read, kqueue polling readback, or nonblocking event-object bridges on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.tryRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "never",
        },
    )
    export function eventTryRead(token: EventToken): Result<uint64, PlatformError>;

    /// Open an eventfd style descriptor.
    ///
    /// Create one descriptor-backed event counter with the requested initial value and flags.
    /// Counter increment semantics and wake behavior follow host eventfd contracts.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses eventfd(2) on Linux and runtime fallback on targets without eventfd support.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.eventfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.fdOpen",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.eventfd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventFdOpen(
        initial: uint64,
        flags: EventFdFlags,
    ): Result<EventFdHandle, PlatformError>;

    /// Close an eventfd style descriptor.
    ///
    /// Close one descriptor and release host event counter state.
    /// Waiting readers are released according to host descriptor close behavior.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses close(2) on Linux and runtime fallback on targets without eventfd support.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.eventfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.fdClose",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.eventfd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventFdClose(handle: EventFdHandle): Result<void, PlatformError>;

    /// Read and consume one value from an eventfd style descriptor.
    ///
    /// Consume one accumulated counter value and return the host-reported amount.
    /// Counter consume rules follow eventfd mode and host descriptor semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses read(2) on Linux eventfd descriptors and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.eventfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.fdRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.eventfd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventFdRead(handle: EventFdHandle): Result<uint64, PlatformError>;

    /// Try to read one value from an eventfd style descriptor.
    ///
    /// Attempt one nonblocking descriptor read and return immediately when no value is queued.
    /// Empty queue state is reported as ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses nonblocking read(2) on Linux eventfd descriptors and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.eventfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.fdTryRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.eventfd"],
            scope: "os",
            blocking: "never",
        },
    )
    export function eventFdTryRead(handle: EventFdHandle): Result<uint64, PlatformError>;

    /// Increment an eventfd style descriptor by one value.
    ///
    /// Add one value to the descriptor counter and wake blocked readers.
    /// Counter saturation behavior follows host eventfd rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses write(2) on Linux eventfd descriptors and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.eventfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.fdWrite",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.eventfd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventFdWrite(handle: EventFdHandle, value: uint64): Result<void, PlatformError>;

    /// Attach an event token to a poll target key.
    ///
    /// Associate one event token with one runtime resource for explicit wakeup wiring.
    /// Association behavior is backend-specific and intended for runtime internals.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses runtime event routing over host poll infrastructure.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `io.event`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.io.event.attach",
        {
            effect: "external",
            replay: "recordable",
            requires: ["io.event"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function eventAttach(token: EventToken, target: ResourceId, key: uint64): Result<void, PlatformError>;
}
