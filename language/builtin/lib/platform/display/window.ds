import type { PlatformError } from "../error/index.ds";
import { DisplayHandle, WindowHandle } from "../resource/index.ds";
import { DisplayBackend, DisplayBackendSelectionPolicy } from "./backend.ds";
import { DisplayMode } from "./monitor.ds";

/// Window mode selector.
export enum WindowMode {
    /// Standard decorated host window mode.
    Windowed = 1,
    /// Borderless host window mode.
    Borderless = 2,
    /// Exclusive fullscreen mode.
    ExclusiveFullscreen = 3,
}

/// Window visibility state.
export enum WindowVisibility {
    /// Window is hidden.
    Hidden = 1,
    /// Window is visible.
    Visible = 2,
    /// Window is minimized.
    Minimized = 3,
    /// Window is maximized.
    Maximized = 4,
}

/// Cursor interaction mode.
export enum WindowCursorMode {
    /// Cursor is visible and unconstrained.
    Normal = 1,
    /// Cursor is hidden and unconstrained.
    Hidden = 2,
    /// Cursor is locked to one position.
    Locked = 3,
    /// Cursor is confined to one window region.
    Confined = 4,
}

/// Standard system cursor icon selector.
export enum WindowCursorIcon {
    /// Default platform pointer icon.
    Default = 1,
    /// Text-edit insertion icon.
    Text = 2,
    /// Crosshair icon.
    Crosshair = 3,
    /// Hand pointer icon.
    Pointer = 4,
    /// Context help icon.
    Help = 5,
    /// Busy icon.
    Wait = 6,
    /// Busy-in-background icon.
    Progress = 7,
    /// Move icon.
    Move = 8,
    /// Prohibited-operation icon.
    NotAllowed = 9,
    /// Grab icon.
    Grab = 10,
    /// Active-grab icon.
    Grabbing = 11,
    /// East resize icon.
    EResize = 12,
    /// North resize icon.
    NResize = 13,
    /// North-east resize icon.
    NeResize = 14,
    /// North-west resize icon.
    NwResize = 15,
    /// South resize icon.
    SResize = 16,
    /// South-east resize icon.
    SeResize = 17,
    /// South-west resize icon.
    SwResize = 18,
    /// West resize icon.
    WResize = 19,
    /// East-west resize icon.
    EwResize = 20,
    /// North-south resize icon.
    NsResize = 21,
    /// North-east to south-west resize icon.
    NeswResize = 22,
    /// North-west to south-east resize icon.
    NwseResize = 23,
    /// Column resize icon.
    ColResize = 24,
    /// Row resize icon.
    RowResize = 25,
    /// Pan or all-scroll icon.
    AllScroll = 26,
    /// Zoom-in icon.
    ZoomIn = 27,
    /// Zoom-out icon.
    ZoomOut = 28,
}

/// Attention request level.
export enum WindowAttentionLevel {
    /// Non-critical attention request.
    Informational = 1,
    /// Critical attention request.
    Critical = 2,
}

/// Window theme selector.
export enum WindowTheme {
    /// Backend did not provide one theme value.
    Unknown = 0,
    /// Light theme value.
    Light = 1,
    /// Dark theme value.
    Dark = 2,
    /// Light high-contrast theme value.
    HighContrastLight = 3,
    /// Dark high-contrast theme value.
    HighContrastDark = 4,
}

/// Logical window size in platform points.
export struct WindowLogicalSize {
    /// Logical width.
    width: float64;
    /// Logical height.
    height: float64;
}

/// Physical window size in pixels.
export struct WindowPhysicalSize {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
}

/// Window position in desktop coordinates.
export struct WindowPosition {
    /// Desktop x coordinate.
    x: int32;
    /// Desktop y coordinate.
    y: int32;
}

/// Logical size constraints.
export struct WindowSizeConstraints {
    /// Optional minimum logical size.
    min: WindowLogicalSize | void;
    /// Optional maximum logical size.
    max: WindowLogicalSize | void;
}

/// Window mode configuration.
export struct WindowModeOptions {
    /// Target window mode.
    mode: WindowMode;
    /// Preferred display for fullscreen transitions.
    display: DisplayHandle | void;
    /// Preferred exclusive fullscreen mode.
    displayMode: DisplayMode | void;
}

/// Window creation options.
export struct WindowOptions {
    /// Preferred backend selector.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Initial window title string.
    title: string;
    /// Initial logical size.
    sizeLogical: WindowLogicalSize;
    /// Initial window position when explicitly requested.
    position: WindowPosition | void;
    /// Initial window size constraints.
    constraints: WindowSizeConstraints | void;
    /// Initial display preference.
    display: DisplayHandle | void;
    /// Initial window mode.
    mode: WindowModeOptions;
    /// Initial visibility state.
    visibility: WindowVisibility;
    /// Whether host resize controls are enabled.
    resizable: boolean;
    /// Whether host window decorations are enabled.
    decorated: boolean;
    /// Whether compositor alpha transparency is requested.
    transparent: boolean;
    /// Whether the window should request focus at creation.
    focusOnShow: boolean;
    /// Whether this window should stay above standard windows.
    alwaysOnTop: boolean;
}

/// Window descriptor payload.
export struct WindowDescriptor {
    /// Resolved backend that owns this window.
    backend: DisplayBackend;
    /// Stable runtime window identifier.
    id: string;
    /// Current host-visible title.
    title: string;
    /// Current mode configuration.
    mode: WindowModeOptions;
    /// Current display association.
    display: DisplayHandle | void;
    /// Whether this window is resizable.
    resizable: boolean;
    /// Whether this window uses host decorations.
    decorated: boolean;
    /// Whether this window requested compositor transparency.
    transparent: boolean;
    /// Whether this window is configured as always-on-top.
    alwaysOnTop: boolean;
}

/// Window state snapshot.
export struct WindowState {
    /// Resolved backend that owns this window.
    backend: DisplayBackend;
    /// Current desktop position.
    position: WindowPosition;
    /// Current logical size.
    sizeLogical: WindowLogicalSize;
    /// Current physical size.
    sizePhysical: WindowPhysicalSize;
    /// Current scale factor in milli-scale units.
    scaleFactorMilli: uint32;
    /// Current visibility state.
    visibility: WindowVisibility;
    /// Current display association.
    display: DisplayHandle | void;
    /// Whether this window currently has keyboard focus.
    focused: boolean;
    /// Whether this window is currently occluded.
    occluded: boolean;
    /// Current theme for this window.
    theme: WindowTheme;
    /// Whether this window is currently always-on-top.
    alwaysOnTop: boolean;
}

/// Window bindings.
declare namespace display {
    /// Open one window.
    ///
    /// Create one host window with one explicit window configuration payload.
    /// Window lifecycle and compositor integration follow host window-system semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses winit or SDL class host backends over Wayland or X11 or Win32 windowing APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowOpen(options: WindowOptions): Result<WindowHandle, PlatformError>;

    /// Close one window.
    ///
    /// Close one host window and release associated compositor or window-system resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific window close and destroy operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowClose(window: WindowHandle): Result<void, PlatformError>;

    /// Read descriptor metadata for one window.
    ///
    /// Read one normalized descriptor snapshot for one opened host window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific window metadata queries.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.descriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowDescriptor(window: WindowHandle): Result<WindowDescriptor, PlatformError>;

    /// Read one window state snapshot.
    ///
    /// Read one point-in-time host window state snapshot.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific window state queries.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.state", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowState(window: WindowHandle): Result<WindowState, PlatformError>;

    /// Set one window title string.
    ///
    /// Update one host window title using host window-system APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific title update operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setTitle", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetTitle(window: WindowHandle, title: string): Result<void, PlatformError>;

    /// Set one window position.
    ///
    /// Apply one host window position in desktop coordinates.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific window move operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setPosition", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetPosition(window: WindowHandle, position: WindowPosition): Result<void, PlatformError>;

    /// Set one logical window size.
    ///
    /// Apply one host window size in logical platform points.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific window resize operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setSize", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetSizeLogical(window: WindowHandle, size: WindowLogicalSize): Result<void, PlatformError>;

    /// Set one physical window size.
    ///
    /// Apply one host window size in physical pixels.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific pixel-size resize operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setSizePhysical", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetSizePhysical(window: WindowHandle, size: WindowPhysicalSize): Result<void, PlatformError>;

    /// Set logical size constraints.
    ///
    /// Apply minimum and maximum logical size constraints for one window.
    /// Passing `void` clears current constraints.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific size-constraint operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setSizeConstraints", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetSizeConstraints(
        window: WindowHandle,
        constraints: WindowSizeConstraints | void,
    ): Result<void, PlatformError>;

    /// Set one window visibility state.
    ///
    /// Apply one window visibility state transition.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific show and hide and minimize and maximize operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setVisibility", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetVisibility(window: WindowHandle, visibility: WindowVisibility): Result<void, PlatformError>;

    /// Set one window mode.
    ///
    /// Apply one host window mode transition for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific fullscreen and borderless and windowed mode operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetMode(window: WindowHandle, mode: WindowModeOptions): Result<void, PlatformError>;

    /// Set window resizable state.
    ///
    /// Toggle host resize affordances for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific resizable-window flags.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setResizable", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetResizable(window: WindowHandle, resizable: boolean): Result<void, PlatformError>;

    /// Set window decoration state.
    ///
    /// Toggle host decorations for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific decorated-window flags.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setDecorated", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetDecorated(window: WindowHandle, decorated: boolean): Result<void, PlatformError>;

    /// Set always-on-top state.
    ///
    /// Toggle host always-on-top policy for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific topmost-window flags.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setAlwaysOnTop", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetAlwaysOnTop(window: WindowHandle, alwaysOnTop: boolean): Result<void, PlatformError>;

    /// Request one redraw for one window.
    ///
    /// Enqueue one host redraw request for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend redraw request operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.requestRefresh", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowRequestRefresh(window: WindowHandle): Result<void, PlatformError>;

    /// Request user attention for one window.
    ///
    /// Request host-specific user attention signaling for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific request-attention primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.requestAttention", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowRequestAttention(window: WindowHandle, level: WindowAttentionLevel): Result<void, PlatformError>;

    /// Set cursor interaction mode for one window.
    ///
    /// Apply one cursor mode policy for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific cursor lock and confine and hide operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setCursorMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetCursorMode(window: WindowHandle, mode: WindowCursorMode): Result<void, PlatformError>;

    /// Set cursor icon for one window.
    ///
    /// Apply one standard system cursor icon for one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific cursor-shape operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setCursorIcon", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetCursorIcon(window: WindowHandle, icon: WindowCursorIcon): Result<void, PlatformError>;

    /// Set cursor visibility for one window.
    ///
    /// Show or hide one window cursor without changing lock or confinement state.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific cursor visibility operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setCursorVisible", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetCursorVisible(window: WindowHandle, visible: boolean): Result<void, PlatformError>;

    /// Set cursor position for one window.
    ///
    /// Warp cursor position relative to one opened window.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific cursor warp operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.setCursorPosition", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowSetCursorPosition(window: WindowHandle, position: WindowPosition): Result<void, PlatformError>;

    /// Present one frame interval marker.
    ///
    /// Block until the next present interval for one window when host backends support vsync synchronization.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses compositor frame callbacks or swap-chain present fences.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.vsync`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.vsyncWait", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.vsync"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowVsyncWait(window: WindowHandle, timeoutNs: uint64): Result<void, PlatformError>;
}
