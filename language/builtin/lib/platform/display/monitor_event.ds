import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { DisplayEventHandle } from "../resource/index.ds";
import {
    DisplayBackend,
    DisplayBackendSelectionPolicy,
    DisplayEventQueueOptions,
} from "./backend.ds";
import { DisplayDescriptor, DisplayMode } from "./monitor.ds";

/// Monitor event kind.
export enum DisplayEventKind {
    /// One display became available.
    Added = 1,
    /// One display was removed.
    Removed = 2,
    /// Primary display selection changed.
    PrimaryChanged = 3,
    /// One display descriptor changed.
    DescriptorChanged = 4,
    /// One display mode changed.
    ModeChanged = 5,
}

/// Display added-event payload.
export struct DisplayAddedPayload {
    /// Descriptor after this event.
    descriptor: DisplayDescriptor;
}

/// Display removed-event payload.
export struct DisplayRemovedPayload {
    /// Identifier for the removed display.
    id: string;
}

/// Display primary-change payload.
export struct DisplayPrimaryPayload {
    /// Current primary display identifier when available.
    id: string | void;
}

/// Display descriptor-change payload.
export struct DisplayDescriptorChangedPayload {
    /// Descriptor after this event.
    descriptor: DisplayDescriptor;
    /// Changed descriptor fields as bit flags.
    changedMask: uint32;
}

/// Display mode-change payload.
export struct DisplayModeChangedPayload {
    /// Active mode after this event.
    mode: DisplayMode;
}

/// Typed payload for one monitor event.
export newtype DisplayEventPayload = DisplayAddedPayload | DisplayRemovedPayload | DisplayPrimaryPayload | DisplayDescriptorChangedPayload | DisplayModeChangedPayload;

/// Monitor event payload.
export struct DisplayEvent {
    /// Display identifier associated with this event.
    displayId: string | void;
    /// Event kind selector.
    kind: DisplayEventKind;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic event sequence number.
    sequence: uint64;
    /// Typed event payload.
    payload: DisplayEventPayload;
}

/// Monitor event stream open options.
export struct DisplayMonitorEventOpenOptions {
    /// Preferred backend selector.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Event queue configuration.
    queue: DisplayEventQueueOptions;
}

/// Display monitor event bindings.
declare namespace display {
    /// Open one global monitor-event stream.
    ///
    /// Open one host monitor-event stream for display hotplug and metrics-change routing.
    /// Event ordering follows host event-loop delivery behavior.
    /// This stream should be consumed from one runtime event-loop thread.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host monitor callback or message subscriptions similar to GLFW monitor callbacks and SDL display events.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorEventOpen(
        options: DisplayMonitorEventOpenOptions,
    ): Result<DisplayEventHandle, PlatformError>;

    /// Close one global monitor-event stream.
    ///
    /// Close one opened monitor-event stream and release host monitor routing resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific event-stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorEventClose(handle: DisplayEventHandle): Result<void, PlatformError>;

    /// Wait for one monitor event.
    ///
    /// Wait for one event from one opened monitor-event stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host event queue wait operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorEventRead(handle: DisplayEventHandle, timeoutNs: uint64): Result<DisplayEvent, PlatformError>;

    /// Poll one monitor event without blocking.
    ///
    /// Poll one pending event from one opened monitor-event stream without waiting.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking host event queue polling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function monitorEventTryRead(handle: DisplayEventHandle): Result<DisplayEvent, PlatformError>;

    /// Wait for one batch of monitor events.
    ///
    /// Wait for pending events from one opened monitor-event stream and return up to `maxEvents` events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host event queue batch wait operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventReadBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function monitorEventReadBatch(
        handle: DisplayEventHandle,
        maxEvents: uint32,
        timeoutNs: uint64,
    ): Result<Array<DisplayEvent>, PlatformError>;

    /// Poll one batch of monitor events without blocking.
    ///
    /// Poll pending events from one opened monitor-event stream and return up to `maxEvents` events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking host event queue batch polling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.eventTryReadBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function monitorEventTryReadBatch(
        handle: DisplayEventHandle,
        maxEvents: uint32,
    ): Result<Array<DisplayEvent>, PlatformError>;
}
