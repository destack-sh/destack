/// Window event payload.
export newtype WindowEvent = WindowCreatedEvent | WindowCloseRequestedEvent | WindowDestroyedEvent | WindowFocusChangedEvent | WindowVisibilityChangedEvent | WindowOcclusionChangedEvent | WindowPositionChangedEvent | WindowSizeChangedEvent | WindowScaleFactorChangedEvent | WindowRefreshRequestedEvent | WindowModeChangedEvent | WindowDisplayChangedEvent | WindowThemeChangedEvent | WindowChromeChangedEvent | WindowTaskbarVisibilityChangedEvent | WindowSafeAreaChangedEvent | WindowOpacityChangedEvent | WindowParentChangedEvent | WindowTransientChangedEvent | WindowModalChangedEvent | WindowMousePassthroughChangedEvent | WindowAspectRatioChangedEvent | WindowDropStartedEvent | WindowFileHoveredEvent | WindowDropCancelledEvent | WindowDropCompletedEvent | WindowFileHoverLeftEvent | WindowFileDroppedEvent | WindowTextDroppedEvent;

/// Window-event kind filter mask.
export newtype WindowEventKindMask = uint64;

/// Event kind bit for `created`.
export const WINDOW_EVENT_KIND_CREATED: WindowEventKindMask = WindowEventKindMask(0x1);
/// Event kind bit for `closeRequested`.
export const WINDOW_EVENT_KIND_CLOSE_REQUESTED: WindowEventKindMask = WindowEventKindMask(0x2);
/// Event kind bit for `destroyed`.
export const WINDOW_EVENT_KIND_DESTROYED: WindowEventKindMask = WindowEventKindMask(0x4);
/// Event kind bit for `focusChanged`.
export const WINDOW_EVENT_KIND_FOCUS_CHANGED: WindowEventKindMask = WindowEventKindMask(0x8);
/// Event kind bit for `visibilityChanged`.
export const WINDOW_EVENT_KIND_VISIBILITY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x10);
/// Event kind bit for `occlusionChanged`.
export const WINDOW_EVENT_KIND_OCCLUSION_CHANGED: WindowEventKindMask = WindowEventKindMask(0x20);
/// Event kind bit for `positionChanged`.
export const WINDOW_EVENT_KIND_POSITION_CHANGED: WindowEventKindMask = WindowEventKindMask(0x40);
/// Event kind bit for `sizeChanged`.
export const WINDOW_EVENT_KIND_SIZE_CHANGED: WindowEventKindMask = WindowEventKindMask(0x80);
/// Event kind bit for `scaleFactorChanged`.
export const WINDOW_EVENT_KIND_SCALE_FACTOR_CHANGED: WindowEventKindMask = WindowEventKindMask(0x100);
/// Event kind bit for `refreshRequested`.
export const WINDOW_EVENT_KIND_REFRESH_REQUESTED: WindowEventKindMask = WindowEventKindMask(0x200);
/// Event kind bit for `modeChanged`.
export const WINDOW_EVENT_KIND_MODE_CHANGED: WindowEventKindMask = WindowEventKindMask(0x400);
/// Event kind bit for `displayChanged`.
export const WINDOW_EVENT_KIND_DISPLAY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x800);
/// Event kind bit for `themeChanged`.
export const WINDOW_EVENT_KIND_THEME_CHANGED: WindowEventKindMask = WindowEventKindMask(0x1000);
/// Event kind bit for `chromeChanged`.
export const WINDOW_EVENT_KIND_CHROME_CHANGED: WindowEventKindMask = WindowEventKindMask(0x2000);
/// Event kind bit for `taskbarVisibilityChanged`.
export const WINDOW_EVENT_KIND_TASKBAR_VISIBILITY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x4000);
/// Event kind bit for `safeAreaChanged`.
export const WINDOW_EVENT_KIND_SAFE_AREA_CHANGED: WindowEventKindMask = WindowEventKindMask(0x8000);
/// Event kind bit for `opacityChanged`.
export const WINDOW_EVENT_KIND_OPACITY_CHANGED: WindowEventKindMask = WindowEventKindMask(0x10000);
/// Event kind bit for `parentChanged`.
export const WINDOW_EVENT_KIND_PARENT_CHANGED: WindowEventKindMask = WindowEventKindMask(0x20000);
/// Event kind bit for `transientChanged`.
export const WINDOW_EVENT_KIND_TRANSIENT_CHANGED: WindowEventKindMask = WindowEventKindMask(0x40000);
/// Event kind bit for `modalChanged`.
export const WINDOW_EVENT_KIND_MODAL_CHANGED: WindowEventKindMask = WindowEventKindMask(0x80000);
/// Event kind bit for `mousePassthroughChanged`.
export const WINDOW_EVENT_KIND_MOUSE_PASSTHROUGH_CHANGED: WindowEventKindMask = WindowEventKindMask(0x100000);
/// Event kind bit for `aspectRatioChanged`.
export const WINDOW_EVENT_KIND_ASPECT_RATIO_CHANGED: WindowEventKindMask = WindowEventKindMask(0x200000);
/// Event kind bit for `dropStarted`.
export const WINDOW_EVENT_KIND_DROP_STARTED: WindowEventKindMask = WindowEventKindMask(0x400000);
/// Event kind bit for `fileHovered`.
export const WINDOW_EVENT_KIND_FILE_HOVERED: WindowEventKindMask = WindowEventKindMask(0x800000);
/// Event kind bit for `dropCancelled`.
export const WINDOW_EVENT_KIND_DROP_CANCELLED: WindowEventKindMask = WindowEventKindMask(0x1000000);
/// Event kind bit for `dropCompleted`.
export const WINDOW_EVENT_KIND_DROP_COMPLETED: WindowEventKindMask = WindowEventKindMask(0x2000000);
/// Event kind bit for `fileHoverLeft`.
export const WINDOW_EVENT_KIND_FILE_HOVER_LEFT: WindowEventKindMask = WindowEventKindMask(0x4000000);
/// Event kind bit for `fileDropped`.
export const WINDOW_EVENT_KIND_FILE_DROPPED: WindowEventKindMask = WindowEventKindMask(0x8000000);
/// Event kind bit for `textDropped`.
export const WINDOW_EVENT_KIND_TEXT_DROPPED: WindowEventKindMask = WindowEventKindMask(0x10000000);

/// Window-event stream filter options.
export struct WindowEventFilter {
    /// Restrict events to one window when set.
    window: WindowHandle | void;
    /// Restrict events to selected kinds when set.
    kindMask: WindowEventKindMask | void;
}

/// Window event stream open options.
export struct WindowEventOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
    /// Event queue configuration.
    queue: DisplayEventQueueOptions;
    /// Optional filter for narrowing delivered events.
    filter: WindowEventFilter | void;
}

/// Window event bindings.
declare namespace display {
    /// Open one global window-event stream.
    ///
    /// Open one host window-event stream for all windows in this runtime.
    /// Event ordering follows host event-loop delivery behavior.
    /// Stream payloads include drop-session lifecycle events and final drop payload events.
    /// This stream should be consumed from one runtime event-loop thread.
    /// Dropped events are reported through `metadata.droppedCount`.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses one host event-loop stream model with stable window-handle routing.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventOpen", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowEventOpen(options: WindowEventOpenOptions): Result<WindowEventHandle, PlatformError>;

    /// Close one global window-event stream.
    ///
    /// Close one opened window-event stream and release host event routing resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific event-stream close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventClose", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowEventClose(handle: WindowEventHandle): Result<void, PlatformError>;

    /// Wait for one window event.
    ///
    /// Wait for one event from one opened host window-event stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host event queue wait operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowEventRead(handle: WindowEventHandle, timeoutNs: uint64): Result<WindowEvent, PlatformError>;

    /// Poll one window event without blocking.
    ///
    /// Poll one pending event from one opened host window-event stream without waiting.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking host event queue polling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventTryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowEventTryRead(handle: WindowEventHandle): Result<WindowEvent, PlatformError>;

    /// Wait for one batch of window events.
    ///
    /// Wait for pending events from one opened host window-event stream and return up to `maxEvents` events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host event queue batch wait operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventReadBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function windowEventReadBatch(
        handle: WindowEventHandle,
        maxEvents: uint32,
        timeoutNs: uint64,
    ): Result<Array<WindowEvent>, PlatformError>;

    /// Poll one batch of window events without blocking.
    ///
    /// Poll pending events from one opened host window-event stream and return up to `maxEvents` events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking host event queue batch polling.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.window.events`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.window.eventTryReadBatch", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.window.events"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function windowEventTryReadBatch(
        handle: WindowEventHandle,
        maxEvents: uint32,
    ): Result<Array<WindowEvent>, PlatformError>;
}
