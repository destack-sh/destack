import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { OsPath } from "../fs/path.ds";
import { DisplayHandle, WindowEventHandle, WindowHandle } from "../resource/index.ds";
import {
    DisplayBackend,
    DisplayBackendSelectionPolicy,
    DisplayEventQueueOptions,
} from "./backend.ds";
import {
    WindowAspectRatio,
    WindowChromeKind,
    WindowLogicalSize,
    WindowModeOptions,
    WindowOcclusionState,
    WindowPhysicalSize,
    WindowPosition,
    WindowSafeAreaInsets,
    WindowTheme,
    WindowVisibility,
} from "./window.ds";

/// Window focus-change payload.
export struct WindowFocusPayload {
    /// Focus state before this event.
    previousFocused: boolean;
    /// Focus state after this event.
    currentFocused: boolean;
}

/// Window visibility-change payload.
export struct WindowVisibilityPayload {
    /// Visibility state before this event.
    previousVisibility: WindowVisibility;
    /// Visibility state after this event.
    currentVisibility: WindowVisibility;
}

/// Window occlusion-change payload.
export struct WindowOcclusionPayload {
    /// Occlusion state before this event.
    previousOcclusion: WindowOcclusionState;
    /// Occlusion state after this event.
    currentOcclusion: WindowOcclusionState;
}

/// Window position-change payload.
export struct WindowPositionPayload {
    /// Position before this event.
    previousPosition: WindowPosition;
    /// Position after this event.
    currentPosition: WindowPosition;
}

/// Window size-change payload.
export struct WindowSizePayload {
    /// Logical size before this event.
    previousSizeLogical: WindowLogicalSize;
    /// Physical size before this event.
    previousSizePhysical: WindowPhysicalSize;
    /// Logical size after this event.
    currentSizeLogical: WindowLogicalSize;
    /// Physical size after this event.
    currentSizePhysical: WindowPhysicalSize;
}

/// Window scale-factor payload.
export struct WindowScaleFactorPayload {
    /// Scale factor before this event in milli-scale units.
    previousScaleFactorMilli: uint32;
    /// Scale factor after this event in milli-scale units.
    currentScaleFactorMilli: uint32;
}

/// Window mode-change payload.
export struct WindowModePayload {
    /// Mode before this event.
    previousMode: WindowModeOptions;
    /// Mode after this event.
    currentMode: WindowModeOptions;
}

/// Window display-change payload.
export struct WindowDisplayPayload {
    /// Display before this event.
    previousDisplay: DisplayHandle | void;
    /// Display after this event.
    currentDisplay: DisplayHandle | void;
}

/// Window theme-change payload.
export struct WindowThemePayload {
    /// Theme value before this event.
    previousTheme: WindowTheme;
    /// Theme value after this event.
    currentTheme: WindowTheme;
}

/// Window chrome-style-change payload.
export struct WindowChromePayload {
    /// Chrome style before this event.
    previousChrome: WindowChromeKind;
    /// Chrome style after this event.
    currentChrome: WindowChromeKind;
}

/// Window taskbar-visibility-change payload.
export struct WindowTaskbarVisibilityPayload {
    /// Taskbar visibility before this event.
    previousTaskbarVisible: boolean;
    /// Taskbar visibility after this event.
    currentTaskbarVisible: boolean;
}

/// Window safe-area-change payload.
export struct WindowSafeAreaPayload {
    /// Safe-area insets before this event when available.
    previousSafeAreaInsets: WindowSafeAreaInsets | void;
    /// Safe-area insets after this event when available.
    currentSafeAreaInsets: WindowSafeAreaInsets | void;
}

/// Window opacity-change payload.
export struct WindowOpacityPayload {
    /// Opacity before this event.
    previousOpacity: float64;
    /// Opacity after this event.
    currentOpacity: float64;
}

/// Window parent-change payload.
export struct WindowParentPayload {
    /// Parent before this event.
    previousParent: WindowHandle | void;
    /// Parent after this event.
    currentParent: WindowHandle | void;
}

/// Window transient-owner-change payload.
export struct WindowTransientPayload {
    /// Transient-owner relationship before this event.
    previousTransientFor: WindowHandle | void;
    /// Transient-owner relationship after this event.
    currentTransientFor: WindowHandle | void;
}

/// Window modal-change payload.
export struct WindowModalPayload {
    /// Modal state before this event.
    previousModal: boolean;
    /// Modal state after this event.
    currentModal: boolean;
}

/// Window mouse-passthrough-change payload.
export struct WindowMousePassthroughPayload {
    /// Mouse-passthrough state before this event.
    previousMousePassthrough: boolean;
    /// Mouse-passthrough state after this event.
    currentMousePassthrough: boolean;
}

/// Window aspect-ratio-change payload.
export struct WindowAspectRatioPayload {
    /// Aspect-ratio lock before this event.
    previousAspectRatio: WindowAspectRatio | void;
    /// Aspect-ratio lock after this event.
    currentAspectRatio: WindowAspectRatio | void;
}

/// Window file-drop payload.
export struct WindowDropFilePayload {
    /// Dropped path payload.
    path: OsPath | void;
    /// Drop position in desktop coordinates when provided by the backend.
    position: WindowPosition | void;
}

/// Window text-drop payload.
export struct WindowDropTextPayload {
    /// Dropped text content.
    text: string;
    /// Drop position in desktop coordinates when provided by the backend.
    position: WindowPosition | void;
}

/// Window drop-hover payload.
export struct WindowDropHoverPayload {
    /// Hovered path payload.
    path: OsPath | void;
    /// Hover position in desktop coordinates when provided by the backend.
    position: WindowPosition | void;
}

/// Window drop-hover-leave payload.
export struct WindowDropHoverLeavePayload {
    /// Last hovered path payload when available.
    previousPath: OsPath | void;
    /// Last hover position in desktop coordinates when provided by the backend.
    position: WindowPosition | void;
}

/// Shared metadata for all window events.
export struct WindowEventMetadata {
    /// Resolved backend that produced this event.
    backend: DisplayBackend;
    /// Window handle associated with this event.
    window: WindowHandle;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic event sequence number.
    sequence: uint64;
    /// Number of events dropped by this stream before this event.
    droppedCount: uint64;
}

/// Window-created event.
export struct WindowCreatedEvent {
    /// Discriminator for this window event variant.
    kind: "created";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
}

/// Window-close-requested event.
export struct WindowCloseRequestedEvent {
    /// Discriminator for this window event variant.
    kind: "closeRequested";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
}

/// Window-destroyed event.
export struct WindowDestroyedEvent {
    /// Discriminator for this window event variant.
    kind: "destroyed";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
}

/// Window-focus-changed event.
export struct WindowFocusChangedEvent {
    /// Discriminator for this window event variant.
    kind: "focusChanged";
    /// Shared event metadata.
    metadata: WindowEventMetadata;
    /// Focus-change payload.
    payload: WindowFocusPayload;
}

