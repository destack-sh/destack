import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { DisplayHandle } from "../resource/index.ds";
import { DisplayBackend, DisplayBackendSelectionPolicy } from "./backend.ds";

/// Display output orientation.
export enum DisplayOrientation {
    /// Unknown or backend-unspecified orientation.
    Unknown = 0,
    /// Landscape orientation.
    Landscape = 1,
    /// Portrait orientation.
    Portrait = 2,
    /// Inverted landscape orientation.
    LandscapeFlipped = 3,
    /// Inverted portrait orientation.
    PortraitFlipped = 4,
}

/// Display descriptor metric bit flags.
export newtype DisplayMetricChangedMask = uint32;

/// Display metric changed-mask bit for display-name updates.
export const DISPLAY_METRIC_CHANGED_NAME: DisplayMetricChangedMask = DisplayMetricChangedMask(0x1);
/// Display metric changed-mask bit for primary-display updates.
export const DISPLAY_METRIC_CHANGED_PRIMARY: DisplayMetricChangedMask = DisplayMetricChangedMask(0x2);
/// Display metric changed-mask bit for desktop-bounds updates.
export const DISPLAY_METRIC_CHANGED_BOUNDS: DisplayMetricChangedMask = DisplayMetricChangedMask(0x4);
/// Display metric changed-mask bit for work-area updates.
export const DISPLAY_METRIC_CHANGED_WORK_AREA: DisplayMetricChangedMask = DisplayMetricChangedMask(0x8);
/// Display metric changed-mask bit for scale-factor updates.
export const DISPLAY_METRIC_CHANGED_SCALE_FACTOR: DisplayMetricChangedMask = DisplayMetricChangedMask(0x10);
/// Display metric changed-mask bit for orientation updates.
export const DISPLAY_METRIC_CHANGED_ORIENTATION: DisplayMetricChangedMask = DisplayMetricChangedMask(0x20);

/// Support status for one capability that may be unknown on some hosts.
export enum DisplaySupportStatus {
    /// Backend cannot determine support status.
    Unknown = 0,
    /// Backend determined this capability is unsupported.
    Unsupported = 1,
    /// Backend determined this capability is supported.
    Supported = 2,
}

/// One display mode descriptor.
export struct DisplayMode {
    /// Pixel width.
    width: uint32;
    /// Pixel height.
    height: uint32;
    /// Refresh rate in millihertz.
    refreshMilliHz: uint32;
    /// Color format identifier.
    format: uint32;
    /// Color depth in bits per pixel.
    bitDepth: uint16;
}

/// Display HDR policy mode.
export enum DisplayHdrMode {
    /// Backend does not expose a concrete HDR mode.
    Unknown = 0,
    /// Use host-default HDR policy.
    System = 1,
    /// Force SDR output mode.
    Sdr = 2,
    /// Force HDR output mode.
    Hdr = 3,
}

/// Display color-space selector.
export enum DisplayColorSpace {
    /// Backend does not expose a concrete color space.
    Unknown = 0,
    /// Standard RGB color space.
    Srgb = 1,
    /// Display-P3 color space.
    DisplayP3 = 2,
    /// BT.2020 color space.
    Bt2020 = 3,
    /// scRGB color space.
    ScRgb = 4,
    /// HDR10 transfer and primaries.
    Hdr10 = 5,
}

/// Display color-state snapshot.
export struct DisplayColorState {
    /// Current HDR policy mode.
    hdrMode: DisplayHdrMode;
    /// Current output color space.
    colorSpace: DisplayColorSpace;
    /// Effective color-channel depth in bits when available.
    bitsPerChannel: uint16 | void;
}

/// Display gamma-ramp payload.
export struct DisplayGammaRamp {
    /// Red channel gamma table entries.
    red: Slice<uint16>;
    /// Green channel gamma table entries.
    green: Slice<uint16>;
    /// Blue channel gamma table entries.
    blue: Slice<uint16>;
}

/// One monitor descriptor snapshot.
export struct DisplayDescriptor {
    /// Resolved backend that produced this descriptor.
    backend: DisplayBackend;
    /// Stable runtime display identifier.
    id: string;
    /// Host display name.
    name: string;
    /// Whether this display is primary.
    primary: boolean;
    /// Display origin x coordinate in desktop space.
    x: int32;
    /// Display origin y coordinate in desktop space.
    y: int32;
    /// Display width in physical pixels.
    widthPx: uint32;
    /// Display height in physical pixels.
    heightPx: uint32;
    /// Work-area origin x coordinate in desktop space.
    workAreaX: int32;
    /// Work-area origin y coordinate in desktop space.
    workAreaY: int32;
    /// Work-area width in physical pixels.
    workAreaWidthPx: uint32;
    /// Work-area height in physical pixels.
    workAreaHeightPx: uint32;
    /// Physical width in millimeters when reported by the backend.
    widthMm: uint32;
    /// Physical height in millimeters when reported by the backend.
    heightMm: uint32;
    /// Scale factor in milli-scale units.
    scaleFactorMilli: uint32;
    /// Current orientation.
    orientation: DisplayOrientation;
    /// Built-in panel status.
    builtinPanel: DisplaySupportStatus;
    /// Variable-refresh capability status.
    variableRefreshSupport: DisplaySupportStatus;
    /// HDR capability status.
    hdrSupport: DisplaySupportStatus;
}

/// Display monitor list request.
export struct DisplayMonitorListRequest {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
}

/// Display monitor open options.
export struct DisplayMonitorOpenOptions {
    /// Preferred backend selector from the declared display backend set.
    /// Runtime host builds can implement one subset of these backend kinds.
    backend: DisplayBackend;
    /// Backend selection policy.
    backendPolicy: DisplayBackendSelectionPolicy;
}

/// Display monitor bindings.
declare namespace display {
    /// List available displays.
    ///
    /// Enumerate host display outputs and return stable identifiers and physical metadata.
    /// Output ordering and hotplug visibility follow host compositor or kernel display APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Declared backend kinds include mobile and Apple backends, while this host runtime currently implements one subset.
    /// Uses host display-enumeration APIs on Unix and Windows targets.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorList(request: DisplayMonitorListRequest): Result<Slice<DisplayDescriptor>, PlatformError>;

    /// Read the current primary display handle.
    ///
    /// Return one opened display handle for the current primary display when available.
    /// Returns `void` when the backend has no discoverable primary display.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses compositor and system-display primary-output selection.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.primary", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorPrimary(request: DisplayMonitorListRequest): Result<DisplayHandle | void, PlatformError>;

    /// Open one display endpoint.
    ///
    /// Open one host display endpoint by identifier for mode queries and updates.
    /// Endpoint lifetime semantics follow host display management APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific display open handles.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorOpen(
        id: string,
        options: DisplayMonitorOpenOptions,
    ): Result<DisplayHandle, PlatformError>;

    /// Close one display endpoint.
    ///
    /// Close one opened display endpoint and release host resources.
    /// Any outstanding mode-change session state is discarded.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific display close operations.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "eventLoop",
    })
    export function monitorClose(handle: DisplayHandle): Result<void, PlatformError>;

    /// Read descriptor metadata for one opened display.
    ///
    /// Read one normalized descriptor snapshot for one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific monitor metadata queries.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.descriptor", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "never",
        affinity: "eventLoop",
    })
    export function monitorDescriptor(handle: DisplayHandle): Result<DisplayDescriptor, PlatformError>;

    /// Read available display modes.
    ///
    /// Read all host-supported modes for one opened display endpoint.
    /// Mode list ordering follows host backend reporting behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host mode-enumeration APIs on Unix and Windows targets.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.modes", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorModes(handle: DisplayHandle): Result<Slice<DisplayMode>, PlatformError>;

    /// Read the current mode for one opened display.
    ///
    /// Read one point-in-time active mode for one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific current-mode queries.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.currentMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorCurrentMode(handle: DisplayHandle): Result<DisplayMode, PlatformError>;

    /// Read the desktop-preferred mode for one opened display.
    ///
    /// Read one platform desktop mode for one opened display endpoint.
    /// This aligns with host desktop-resolution semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend desktop-mode queries where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.desktopMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorDesktopMode(handle: DisplayHandle): Result<DisplayMode, PlatformError>;

    /// Resolve one requested mode to the closest supported mode.
    ///
    /// Return one backend-selected closest mode for one requested mode.
    /// Mode-matching behavior follows host backend selection policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend mode-matching queries where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.closestMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorClosestMode(
        handle: DisplayHandle,
        requested: DisplayMode,
    ): Result<DisplayMode, PlatformError>;

    /// Apply one display mode.
    ///
    /// Apply one mode to an opened display endpoint.
    /// Mode-set behavior and rollback semantics are host-defined.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses KMS mode setting on Unix-like hosts and display mode APIs on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.display.monitor.setMode", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorSetMode(
        handle: DisplayHandle,
        mode: DisplayMode,
    ): Result<void, PlatformError>;

    /// Read one display color-state snapshot.
    ///
    /// Read one point-in-time display color-state snapshot for one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific color-state and colorspace query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.colorState", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorColorState(handle: DisplayHandle): Result<DisplayColorState, PlatformError>;

    /// Read one display HDR policy mode.
    ///
    /// Read one point-in-time HDR policy mode for one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific HDR query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.hdrMode", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorHdrMode(handle: DisplayHandle): Result<DisplayHdrMode, PlatformError>;

    /// Set one display HDR policy mode.
    ///
    /// Apply one HDR policy mode to one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific HDR control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.display.monitor.setHdrMode", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorSetHdrMode(
        handle: DisplayHandle,
        mode: DisplayHdrMode,
    ): Result<void, PlatformError>;

    /// Read one display gamma ramp.
    ///
    /// Read one gamma-ramp table payload for one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend gamma-ramp query APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `display.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.display.monitor.gammaRamp", {
        effect: "external",
        replay: "recordable",
        capabilities: ["display.read"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorGammaRamp(handle: DisplayHandle): Result<DisplayGammaRamp, PlatformError>;

    /// Set one display gamma ramp.
    ///
    /// Apply one gamma-ramp table payload to one opened display endpoint.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend gamma-ramp control APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `display.mode`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.display.monitor.setGammaRamp", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["display.mode"],
        platforms: ["windows", "unix"],
        simulation: "stub",
        scope: "host",
        blocking: "sometimes",
        affinity: "eventLoop",
    })
    export function monitorSetGammaRamp(
        handle: DisplayHandle,
        ramp: DisplayGammaRamp,
    ): Result<void, PlatformError>;
}
