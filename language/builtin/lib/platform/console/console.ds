import type { PlatformError } from "../error/index.ds";

/// Console bindings for native runtime.
export declare namespace console {
    /// Write a line to stdout.
    ///
    /// Emit one plain log line to stdout using the runtime console sink.
    /// The payload is written as-is, without level prefixes, interpolation, or color transforms.
    ///
    /// # Platform
    /// All runtime targets that include the native platform runtime.
    /// Uses write(2) to stdout on Unix, WriteFile on Windows stdout handle.
    ///
    /// # Errors
    /// Returns ioWriteFailed, ioBrokenPipe, notSupported.
    ///
    /// # Security
    /// Requires `console.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.console.log", { effect: "external", replay: "recordable", requires: ["console.write"], scope: "runtime", blocking: "sometimes" })
    export function log(value: string): Result<void, PlatformError>;

    /// Write an info line to stdout.
    ///
    /// Emit one informational line to stdout using the runtime console sink.
    /// The payload is written as-is, without level prefixes, interpolation, or color transforms.
    ///
    /// # Platform
    /// All runtime targets that include the native platform runtime.
    /// Uses write(2) to stdout on Unix, WriteFile on Windows stdout handle.
    ///
    /// # Errors
    /// Returns ioWriteFailed, ioBrokenPipe, notSupported.
    ///
    /// # Security
    /// Requires `console.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.console.info", { effect: "external", replay: "recordable", requires: ["console.write"], scope: "runtime", blocking: "sometimes" })
    export function info(value: string): Result<void, PlatformError>;

    /// Write a warning line to stderr.
    ///
    /// Emit one warning line to stderr using the runtime console sink.
    /// The payload is written as-is, without level prefixes, interpolation, or color transforms.
    ///
    /// # Platform
    /// All runtime targets that include the native platform runtime.
    /// Uses write(2) to stderr on Unix, WriteFile on Windows stderr handle.
    ///
    /// # Errors
    /// Returns ioWriteFailed, ioBrokenPipe, notSupported.
    ///
    /// # Security
    /// Requires `console.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.console.warn", { effect: "external", replay: "recordable", requires: ["console.write"], scope: "runtime", blocking: "sometimes" })
    export function warn(value: string): Result<void, PlatformError>;

    /// Write an error line to stderr.
    ///
    /// Emit one error line to stderr using the runtime console sink.
    /// The payload is written as-is, without level prefixes, interpolation, or color transforms.
    ///
    /// # Platform
    /// All runtime targets that include the native platform runtime.
    /// Uses write(2) to stderr on Unix, WriteFile on Windows stderr handle.
    ///
    /// # Errors
    /// Returns ioWriteFailed, ioBrokenPipe, notSupported.
    ///
    /// # Security
    /// Requires `console.write`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.console.error", { effect: "external", replay: "recordable", requires: ["console.write"], scope: "runtime", blocking: "sometimes" })
    export function error(value: string): Result<void, PlatformError>;
}
