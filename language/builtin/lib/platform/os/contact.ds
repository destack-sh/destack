import { Array } from "native";
import type { PlatformError } from "../error/index.ds";

/// Contact query options.
export struct OsContactQuery {
    /// Opaque page cursor from one prior list or search call.
    cursor: string;
    /// Maximum returned contacts for this page.
    limit: uint32;
    /// Whether phone numbers should be returned.
    includePhones: boolean;
    /// Whether email addresses should be returned.
    includeEmails: boolean;
    /// Whether postal addresses should be returned.
    includeAddresses: boolean;
    /// Whether organization metadata should be returned.
    includeOrganization: boolean;
    /// Whether note fields should be returned.
    includeNotes: boolean;
}

/// Contact name payload.
export struct OsContactName {
    /// Given or first name.
    givenName: string;
    /// Middle name.
    middleName: string;
    /// Family or last name.
    familyName: string;
    /// Honorific prefix.
    prefix: string;
    /// Honorific suffix.
    suffix: string;
    /// Nickname.
    nickname: string;
    /// Phonetic given name.
    phoneticGivenName: string;
    /// Phonetic family name.
    phoneticFamilyName: string;
}

/// Contact phone payload.
export struct OsContactPhone {
    /// Label for this phone value.
    label: string;
    /// Original phone number string.
    number: string;
    /// Normalized phone number string when available.
    normalizedNumber: string;
    /// Whether this phone value is marked as primary.
    primary: boolean;
}

/// Contact email payload.
export struct OsContactEmail {
    /// Label for this email value.
    label: string;
    /// Email address.
    address: string;
    /// Whether this email value is marked as primary.
    primary: boolean;
}

/// Contact postal address payload.
export struct OsContactAddress {
    /// Label for this address value.
    label: string;
    /// Street-line payload.
    street: string;
    /// City payload.
    city: string;
    /// Region or state payload.
    region: string;
    /// Postal-code payload.
    postalCode: string;
    /// Country payload.
    country: string;
    /// Country-code payload.
    countryCode: string;
}

/// Contact organization payload.
export struct OsContactOrganization {
    /// Organization or company name.
    company: string;
    /// Department name.
    department: string;
    /// Job title.
    title: string;
}

/// Contact payload.
export struct OsContact {
    /// Stable contact identifier.
    id: string;
    /// Structured name payload.
    name: OsContactName;
    /// Phone values.
    phones: Array<OsContactPhone>;
    /// Email values.
    emails: Array<OsContactEmail>;
    /// Address values.
    addresses: Array<OsContactAddress>;
    /// Organization metadata.
    organization: OsContactOrganization;
    /// Contact note payload.
    note: string;
}

/// Contact draft payload for create and update operations.
export struct OsContactDraft {
    /// Structured name payload.
    name: OsContactName;
    /// Phone values.
    phones: Array<OsContactPhone>;
    /// Email values.
    emails: Array<OsContactEmail>;
    /// Address values.
    addresses: Array<OsContactAddress>;
    /// Organization metadata.
    organization: OsContactOrganization;
    /// Contact note payload.
    note: string;
}

/// Paged contact result payload.
export struct OsContactPage {
    /// Contact items for this page.
    contacts: Array<OsContact>;
    /// Opaque cursor for the next page, empty when unavailable.
    nextCursor: string;
    /// Whether more items are available.
    hasMore: boolean;
}

/// Contact bindings.
declare namespace os {
    /// List contacts.
    ///
    /// Return one page of host contacts with one selected field set.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses Contacts framework on Apple platforms, ContactsContract on Android, and address-book provider APIs on desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.list", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactList(query: OsContactQuery): Result<OsContactPage, PlatformError>;

    /// Search contacts.
    ///
    /// Return one page of host contacts matching one backend query string.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host contact search APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.search", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactSearch(queryText: string, query: OsContactQuery): Result<OsContactPage, PlatformError>;

    /// Read one contact by identifier.
    ///
    /// Read one host contact payload by stable identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host contact read APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.read", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactRead(id: string): Result<OsContact, PlatformError>;

    /// Create one contact.
    ///
    /// Create one host contact record and return its stable identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host contact-write APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.create", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactCreate(contact: OsContactDraft): Result<string, PlatformError>;

    /// Update one contact.
    ///
    /// Update one existing host contact by identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host contact-write APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.update", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactUpdate(id: string, contact: OsContactDraft): Result<void, PlatformError>;

    /// Delete one contact.
    ///
    /// Delete one existing host contact by identifier.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host contact-delete APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.contact.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.contact.delete", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.contact.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function contactDelete(id: string): Result<void, PlatformError>;
}
