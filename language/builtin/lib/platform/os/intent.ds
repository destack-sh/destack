import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { OsPath } from "../fs/path.ds";
import { IntentHandle } from "../resource/index.ds";

/// Host intent event kind.
export enum OsIntentKind {
    /// Runtime was activated with one URL target.
    OpenUrl = 1,
    /// Runtime was activated with one file target.
    OpenFile = 2,
    /// Runtime received one text-share payload.
    ShareText = 3,
    /// Runtime received one file-share payload.
    ShareFiles = 4,
    /// Runtime received one custom action payload.
    CustomAction = 5,
}

/// Inbound intent payload.
export struct OsIntentPayload {
    /// URL payload when kind is `OpenUrl`.
    url: string;
    /// File payloads when kind is `OpenFile` or `ShareFiles`.
    paths: Array<OsPath>;
    /// Text payload when kind is `ShareText`.
    text: string;
    /// MIME type when provided by host.
    mimeType: string;
    /// Action identifier when kind is `CustomAction`.
    action: string;
}

/// Inbound intent event.
export struct OsIntentEvent {
    /// Event kind selector.
    kind: OsIntentKind;
    /// Event timestamp in nanoseconds.
    timestampNs: uint64;
    /// Monotonic sequence number for this stream.
    sequence: uint64;
    /// Host source package or process identifier when available.
    source: string;
    /// Typed payload for the event.
    payload: OsIntentPayload;
}

/// Intent stream open options.
export struct OsIntentOpenOptions {
    /// Whether to include URL activation events.
    includeOpenUrl: boolean;
    /// Whether to include file activation events.
    includeOpenFile: boolean;
    /// Whether to include share events.
    includeShare: boolean;
    /// Whether to include custom action events.
    includeCustomAction: boolean;
}

/// Host intent bindings.
declare namespace os {
    /// Open one host intent stream.
    ///
    /// Open one inbound host intent stream for activation and share payload events.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses shell activation hooks on desktop platforms and runtime host intent bridges on mobile-like hosts.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.intent.open", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.intent.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentOpen(options: OsIntentOpenOptions): Result<IntentHandle, PlatformError>;

    /// Close one host intent stream.
    ///
    /// Close one opened host intent stream and release host callback routing resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend-specific intent callback unregistration.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.intent.close", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.intent.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentClose(handle: IntentHandle): Result<void, PlatformError>;

    /// Wait for one inbound intent event.
    ///
    /// Wait for one queued inbound intent event from one opened intent stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend intent event queues or callback bridges.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.intent.read", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.intent.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentRead(handle: IntentHandle, timeoutNs: uint64): Result<OsIntentEvent, PlatformError>;

    /// Poll one inbound intent event without blocking.
    ///
    /// Poll one queued inbound intent event from one opened intent stream.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses backend nonblocking intent queue reads.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.read`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.intent.tryRead", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.intent.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "never",
    })
    export function intentTryRead(handle: IntentHandle): Result<OsIntentEvent, PlatformError>;

    /// Request host to open one URL target.
    ///
    /// Ask host shell or app framework to open one URL with default routing.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses shell open-url APIs on desktop platforms and intent launch APIs on mobile-like hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.intent.openUrl", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.intent.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentOpenUrl(url: string): Result<void, PlatformError>;

    /// Request host to open one file path target.
    ///
    /// Ask host shell or app framework to open one file path with default routing.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses shell open-file APIs and host launcher integration.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.intent.openPath", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.intent.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentOpenPath(path: OsPath): Result<void, PlatformError>;

    /// Share one text payload through host share routing.
    ///
    /// Ask host share infrastructure to present one text payload to target applications.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses platform share APIs where available.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.intent.shareText", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.intent.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentShareText(text: string, mimeType: string): Result<void, PlatformError>;

    /// Share file paths through host share routing.
    ///
    /// Ask host share infrastructure to present one file list to target applications.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses platform share APIs and shell handoff integration.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.intent.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.intent.sharePaths", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.intent.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function intentSharePaths(paths: Array<OsPath>, mimeType: string): Result<void, PlatformError>;
}
