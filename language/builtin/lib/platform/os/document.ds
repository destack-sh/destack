import { Array, Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { OsPath } from "../fs/path.ds";
import { DocumentHandle } from "../resource/index.ds";

/// Document-provider access mode.
export enum DocumentAccess {
    /// Read access only.
    Read = 1,
    /// Write access only.
    Write = 2,
    /// Read and write access.
    ReadWrite = 3,
}

/// Document picker options.
export struct DocumentPickOptions {
    /// Content-type filters, empty means any type.
    contentTypes: Array<string>;
    /// File-extension filters without the leading dot.
    extensions: Array<string>;
    /// Whether multiple selection is allowed.
    multiple: boolean;
    /// Whether directory selection is allowed.
    allowDirectories: boolean;
}

/// Document descriptor.
export struct DocumentDescriptor {
    /// Host document URI.
    /// This may be one opaque provider URI rather than one filesystem path.
    uri: string;
    /// Host-visible document name.
    name: string;
    /// Normalized content type when cheap or natively available.
    contentType?: string;
    /// Document size in bytes when available.
    sizeBytes?: uint64;
    /// Document modification timestamp in UTC nanoseconds when available.
    modifiedUnixNs?: uint64;
    /// Whether this descriptor represents one directory.
    isDirectory: boolean;
    /// Runtime-visible local path when the host grants direct local access or one app-storage import exists.
    localPath?: OsPath;
}

/// Persisted document-access grant.
export struct DocumentAccessGrant {
    /// Stable persisted grant identifier.
    id: string;
    /// Granted document descriptor.
    document: DocumentDescriptor;
    /// Granted access mode.
    access: DocumentAccess;
    /// Grant persistence timestamp in UTC nanoseconds.
    persistedUnixNs: uint64;
}

/// Document bindings.
declare namespace os {
    /// Pick documents from host picker UI.
    ///
    /// Open host picker UI and return selected document descriptors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses SAF or system picker APIs on Android, UIDocumentPicker on Apple platforms, common file dialogs on Windows, and desktop file-picker bridges or portals on Unix desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.document.pick`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.pick", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.pick"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentPick(options: DocumentPickOptions): Result<Array<DocumentDescriptor>, PlatformError>;

    /// Import selected documents into app-owned storage.
    ///
    /// Copy selected external documents into app-owned storage and return imported document descriptors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host-local filesystem import after one prior picker or provider selection.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.document.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.import", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentImport(
        documents: Array<DocumentDescriptor>,
    ): Result<Array<DocumentDescriptor>, PlatformError>;

    /// Persist external document access for later reopen.
    ///
    /// Persist host-granted access for selected external documents and return durable grant descriptors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host document-grant persistence where available and path-backed grant state on desktop hosts with direct local access.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.access.persist", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentAccessPersist(
        documents: Array<DocumentDescriptor>,
        access: DocumentAccess,
    ): Result<Array<DocumentAccessGrant>, PlatformError>;

    /// List persisted document-access grants.
    ///
    /// Return all persisted document-access grants for the active runtime identity.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host document-grant persistence state.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding("destack.os.document.access.list", {
        effect: "external",
        replay: "recordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentAccessList(): Result<Array<DocumentAccessGrant>, PlatformError>;

    /// Revoke persisted document-access grants.
    ///
    /// Revoke persisted document-access grants by identifier and return revoked grant count.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host document-grant persistence state.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.access.revoke", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentAccessRevoke(ids: Array<string>): Result<uint32, PlatformError>;

    /// Open one document URI.
    ///
    /// Open one document URI with one selected access mode.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local `file://` URI opens on current desktop hosts, with future provider-backed backends layered onto the same handle contract.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.open", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentOpen(
        uri: string,
        access: DocumentAccess,
    ): Result<DocumentHandle, PlatformError>;

    /// Open one persisted document-access grant.
    ///
    /// Open one persisted external-access grant by identifier with one selected access mode.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses persisted desktop grant state backed by local paths on current hosts, with future provider-specific reopen backends layered onto the same handle contract.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.access.open", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentAccessOpen(
        id: string,
        access: DocumentAccess,
    ): Result<DocumentHandle, PlatformError>;

    /// Close one opened document handle.
    ///
    /// Close one opened document handle and release host resources.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local host file-handle close semantics on current desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.control`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.close", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.control"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentClose(handle: DocumentHandle): Result<void, PlatformError>;

    /// Read one chunk of document bytes.
    ///
    /// Read up to `maxBytes` from one opened document handle.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local host file reads on current desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, ioInterrupted, notSupported.
    ///
    /// # Security
    /// Requires `os.document.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.read", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentRead(
        handle: DocumentHandle,
        maxBytes: uint32,
        timeoutNs: uint64,
    ): Result<Slice<uint8>, PlatformError>;

    /// Poll one chunk of document bytes without blocking.
    ///
    /// Read up to `maxBytes` from one opened document handle without waiting.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local host file reads on current desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.tryRead", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.read"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "never",
        affinity: "any",
    })
    export function documentTryRead(
        handle: DocumentHandle,
        maxBytes: uint32,
    ): Result<Slice<uint8>, PlatformError>;

    /// Write one chunk of document bytes.
    ///
    /// Write one byte chunk into one opened document handle and return written byte count.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local host file writes on current desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.write", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentWrite(
        handle: DocumentHandle,
        bytes: Slice<uint8>,
        timeoutNs: uint64,
    ): Result<uint32, PlatformError>;

    /// Flush one opened document handle.
    ///
    /// Flush buffered outbound document bytes for one opened handle.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses local host file flush semantics on current desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.document.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.document.flush", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.document.write"],
        platforms: ["windows", "unix"],
        simulation: "model",
        scope: "host",
        blocking: "sometimes",
        affinity: "any",
    })
    export function documentFlush(handle: DocumentHandle): Result<void, PlatformError>;
}
