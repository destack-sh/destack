import type { PlatformError } from "../error/index.ds";

/// System topology and capacity snapshot.
export struct SystemInfo {
    /// Logical CPU count.
    cpuCount: uint32;
    /// Total physical memory bytes.
    memoryTotal: uint64;
    /// Available memory bytes.
    memoryAvailable: uint64;
    /// Virtual-memory page size bytes.
    pageSize: uint64;
}

/// Host load-average tuple.
export struct LoadAverage {
    /// One-minute load average.
    one: float64;
    /// Five-minute load average.
    five: float64;
    /// Fifteen-minute load average.
    fifteen: float64;
}

/// System information bindings.
declare namespace os {
    /// Read host system information.
    ///
    /// Return one normalized system-information payload.
    /// Topology and capacity fields are sampled from host APIs at call time.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses sysconf/sysinfo-style APIs on Unix, GlobalMemoryStatusEx and processor APIs on Windows, and wasi sysinfo support.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.sysinfo`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.os.info.systemInfo",
        {
            effect: "external",
            replay: "recordable",
            requires: ["os.sysinfo"],
            platforms: ["unix", "windows", "wasi"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function systemInfo(): Result<SystemInfo, PlatformError>;

    /// Read host uptime.
    ///
    /// Return host uptime in nanoseconds from system boot.
    /// Uptime source follows host monotonic uptime facilities.
    ///
    /// # Platform
    /// Unix, Windows, and Wasi.
    /// Uses clock_gettime style uptime on Unix, GetTickCount64 style uptime on Windows, and wasi clocks when available.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.sysinfo`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.os.info.uptimeNs",
        {
            effect: "external",
            replay: "recordable",
            requires: ["os.sysinfo"],
            platforms: ["unix", "windows", "wasi"],
            scope: "os",
            blocking: "never",
        },
    )
    export function uptimeNs(): Result<uint64, PlatformError>;

    /// Read host load averages.
    ///
    /// Return host load averages over one, five, and fifteen minute windows.
    /// Values reflect host scheduler accounting and may be unavailable on some kernels.
    ///
    /// # Platform
    /// Unix only.
    /// Uses getloadavg style interfaces or kernel load-average exports.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.sysinfo`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.os.info.loadAverage",
        {
            effect: "external",
            replay: "recordable",
            requires: ["os.sysinfo"],
            platforms: ["unix"],
            scope: "os",
            blocking: "never",
        },
    )
    export function loadAverage(): Result<LoadAverage, PlatformError>;

    /// Read host boot time.
    ///
    /// Return the Unix timestamp for host boot time in nanoseconds.
    /// Timestamp origin and precision follow host timekeeping interfaces.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses boot-time sysctl or procfs style sources on Unix and boot-time system info on Windows.
    ///
    /// # Errors
    /// Returns ioNotFound, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.sysinfo`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.os.info.bootTimeUnixNs",
        {
            effect: "external",
            replay: "recordable",
            requires: ["os.sysinfo"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "never",
        },
    )
    export function bootTimeUnixNs(): Result<uint64, PlatformError>;
}
