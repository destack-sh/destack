import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";

/// Credential accessibility class.
export enum OsCredentialAccessibility {
    /// Accessible when the device is unlocked.
    WhenUnlocked = 1,
    /// Accessible after first unlock until restart.
    AfterFirstUnlock = 2,
    /// Accessible with host default policy.
    HostDefault = 3,
}

/// Credential authentication policy.
export enum OsCredentialAuthenticationPolicy {
    /// No additional user authentication requirement.
    None = 1,
    /// Any user-presence signal requirement.
    UserPresence = 2,
    /// Biometric authentication requirement.
    Biometric = 3,
    /// Device passcode or PIN authentication requirement.
    DevicePasscode = 4,
}

/// Credential authentication mechanism.
export enum OsCredentialAuthenticationMechanism {
    /// Unknown or backend-defined mechanism.
    Unknown = 1,
    /// Biometric authentication mechanism.
    Biometric = 2,
    /// Device passcode or PIN authentication mechanism.
    DevicePasscode = 3,
}

/// Credential write options.
export struct OsCredentialWriteOptions {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Binary credential payload.
    bytes: Slice<uint8>;
    /// Accessibility policy.
    accessibility: OsCredentialAccessibility;
    /// Authentication policy.
    authentication: OsCredentialAuthenticationPolicy;
    /// Whether replacement is allowed when one credential already exists.
    replaceExisting: boolean;
}

/// Credential query options.
export struct OsCredentialQuery {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Whether host authentication should be requested before returning payload bytes.
    requireAuthentication: boolean;
}

/// Credential payload.
export struct OsCredentialRecord {
    /// Namespace or service name.
    service: string;
    /// Account or key name within one service.
    account: string;
    /// Binary credential payload.
    bytes: Slice<uint8>;
    /// Credential creation timestamp in UTC nanoseconds when available.
    createdUnixNs: uint64;
    /// Credential modification timestamp in UTC nanoseconds when available.
    modifiedUnixNs: uint64;
}

/// Credential authentication options.
export struct OsCredentialAuthenticationOptions {
    /// Authentication prompt title.
    title: string;
    /// Authentication prompt subtitle.
    subtitle: string;
    /// Authentication prompt detail message.
    message: string;
    /// Whether fallback to passcode is allowed.
    allowPasscodeFallback: boolean;
}

/// Credential authentication result payload.
export struct OsCredentialAuthenticationResult {
    /// Whether authentication was successful.
    authenticated: boolean;
    /// Used authentication mechanism.
    mechanism: OsCredentialAuthenticationMechanism;
}

/// Credential bindings.
declare namespace os {
    /// Read one credential record.
    ///
    /// Read one secure credential payload from host credential store.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses Keychain on Apple platforms, Keystore-backed secure storage on Android, and credential manager APIs on desktop hosts.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.credentials.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.credentials.read", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.credentials.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function credentialsRead(query: OsCredentialQuery): Result<OsCredentialRecord, PlatformError>;

    /// Write one credential record.
    ///
    /// Create or replace one secure credential payload in host credential store.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host credential-write APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.credentials.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.credentials.write", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.credentials.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function credentialsWrite(options: OsCredentialWriteOptions): Result<void, PlatformError>;

    /// Delete one credential record.
    ///
    /// Delete one secure credential payload from host credential store.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host credential-delete APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `os.credentials.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.credentials.delete", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.credentials.write"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function credentialsDelete(service: string, account: string): Result<void, PlatformError>;

    /// Query credential presence.
    ///
    /// Return whether one credential record exists for one service and account pair.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host credential-query APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.credentials.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.credentials.contains", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.credentials.read"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function credentialsContains(service: string, account: string): Result<boolean, PlatformError>;

    /// Request one host credential authentication challenge.
    ///
    /// Request one host authentication challenge and return challenge outcome.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses LocalAuthentication and biometric manager APIs when available.
    ///
    /// # Errors
    /// Returns ioPermissionDenied, ioWouldBlock, ioInterrupted, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `os.credentials.auth`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding("destack.os.credentials.authenticate", {
        effect: "external",
        replay: "nonrecordable",
        capabilities: ["os.credentials.auth"],
        platforms: ["windows", "unix"],
        scope: "host",
        blocking: "sometimes",
    })
    export function credentialsAuthenticate(
        options: OsCredentialAuthenticationOptions,
    ): Result<OsCredentialAuthenticationResult, PlatformError>;
}
