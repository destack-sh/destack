import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";

/// Deterministic random stream bindings for the native runtime.
declare namespace random {
    /// Opaque identifier for a deterministic random stream.
    export newtype RandomStream = uint64;

    /// Allocate a deterministic random stream identifier.
    @binding("destack.random.stream", { effect: "external", replay: "recordable" })
    export function stream(): Result<RandomStream, PlatformError>;

    /// Return a deterministic random uint64 from the current stream.
    @binding("destack.random.nextU64", { effect: "external", replay: "recordable" })
    export function nextU64(): Result<uint64, PlatformError>;

    /// Return a deterministic random uint64 from a specific stream.
    @binding("destack.random.nextU64From", { effect: "external", replay: "recordable" })
    export function nextU64From(stream: RandomStream): Result<uint64, PlatformError>;

    /// Fill a slice with deterministic random bytes.
    @binding(
        "destack.random.fillBytes",
        { effect: "external", replay: "recordable" },
    )
    export function fillBytes(buffer: Slice<uint8>): Result<void, PlatformError>;

    /// Fill a slice with deterministic random bytes from a stream.
    @binding(
        "destack.random.fillBytesFrom",
        { effect: "external", replay: "recordable" },
    )
    export function fillBytesFrom(
        stream: RandomStream,
        buffer: Slice<uint8>,
    ): Result<void, PlatformError>;
}
