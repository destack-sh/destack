import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";

/// Cryptographic randomness bindings for the native runtime.
declare namespace random {
    /// Fill a slice with cryptographically secure random bytes.
    @binding(
        "destack.random.secureBytes",
        { effect: "external", replay: "recordable" },
    )
    export function secureBytes(buffer: Slice<uint8>): Result<void, PlatformError>;
}
