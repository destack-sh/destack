import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { SignalFdHandle, SignalHandle } from "../resource/index.ds";
import { ProcessId } from "./ids.ds";

/// Signal number for process control.
export newtype Signal = uint32;

/// Signal mask operation selector.
export enum SignalMaskHow {
    /// Replace the active mask with the provided set.
    Set = 0,
    /// Add signals to the active mask.
    Block = 1,
    /// Remove signals from the active mask.
    Unblock = 2,
}

/// Signal event payload delivered by a subscription.
export struct SignalEvent {
    /// Signal number observed by the runtime.
    signal: Signal;
    /// Process id associated with the signal when provided by the platform.
    pid: ProcessId;
}

/// Flags for signalfd style descriptors.
export newtype SignalFdFlags = uint32;

/// Process signal bindings for the native runtime.
declare namespace process {
    /// Send a signal to a target process.
    ///
    /// Deliver one signal value to the target process according to host signal semantics.
    /// Delivery guarantees and supported signal numbers are host-defined.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses kill(2) on Unix and terminate or control-event APIs on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.send`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.kill",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.send"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function kill(pid: ProcessId, signal: Signal): Result<void, PlatformError>;

    /// Subscribe to one signal value.
    ///
    /// Register one runtime subscription handle for signal delivery.
    /// Subscription mode and coalescing behavior follow runtime and host integration rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host signal registration primitives and runtime subscription state.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalSubscribe",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalSubscribe(signal: Signal): Result<SignalHandle, PlatformError>;

    /// Remove a signal subscription handle.
    ///
    /// Unregister one signal subscription from runtime delivery.
    /// Pending events may still be readable depending on host queueing behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses runtime unregistration with host signal integration.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalUnsubscribe",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "never",
        },
    )
    export function signalUnsubscribe(handle: SignalHandle): Result<void, PlatformError>;

    /// Receive the next signal event from a subscription.
    ///
    /// Wait for the next queued signal event for the subscription.
    /// Delivery ordering and batching follow runtime and host signal queue semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host signal waiting primitives and runtime queues.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalReceive",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalReceive(handle: SignalHandle): Result<SignalEvent, PlatformError>;

    /// Poll one signal event without blocking.
    ///
    /// Read a queued signal event when available and return immediately otherwise.
    /// Empty queue behavior is reported through host-specific not-ready errors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking host and runtime signal queue polling.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalTryReceive",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "never",
        },
    )
    export function signalTryReceive(handle: SignalHandle): Result<SignalEvent, PlatformError>;

    /// Read the current thread signal mask.
    ///
    /// Return the active signal mask as an explicit signal set.
    /// Mask semantics follow host thread-signal rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses sigprocmask or pthread_sigmask on Unix and runtime policy emulation on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalMaskRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalMaskRead(): Result<Signal[], PlatformError>;

    /// Update the current thread signal mask.
    ///
    /// Apply one set, block, or unblock operation to the active signal mask.
    /// Mask transitions are atomic under host signal APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses sigprocmask or pthread_sigmask on Unix and runtime policy emulation on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalMaskUpdate",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalMaskUpdate(
        how: SignalMaskHow,
        signals: Slice<Signal>,
    ): Result<void, PlatformError>;

    /// Wait for one signal from a requested set.
    ///
    /// Block until one of the requested signals is observed and returned.
    /// Selection and wakeup semantics follow host signal wait behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses sigwait-style primitives on Unix and runtime signal wait integration on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalWait",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalWait(signals: Slice<Signal>): Result<SignalEvent, PlatformError>;

    /// Poll one signal from a requested set without blocking.
    ///
    /// Check whether one requested signal is pending and return immediately.
    /// Empty readiness is reported through host-specific not-ready errors.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking signal wait primitives and runtime queue polling.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.signalTryWait",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "never",
        },
    )
    export function signalTryWait(signals: Slice<Signal>): Result<SignalEvent, PlatformError>;

    /// Open a signalfd style descriptor for one signal mask.
    ///
    /// Create one descriptor-backed signal queue bound to the provided mask.
    /// Signal routing and queue coalescing follow host signalfd semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses signalfd(2) on Linux and runtime fallback on targets without signalfd support.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.fd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.fdOpen",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.fd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function signalFdOpen(
        signals: Slice<Signal>,
        flags: SignalFdFlags,
    ): Result<SignalFdHandle, PlatformError>;

    /// Replace the active mask for one signalfd descriptor.
    ///
    /// Update one descriptor mask so future queued signals match the new requested set.
    /// Mask updates are atomic with respect to host signal queue routing rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses signalfd(2) mask updates on Linux and runtime fallback on targets without signalfd support.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.fd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.fdUpdate",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.fd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function signalFdUpdate(
        handle: SignalFdHandle,
        signals: Slice<Signal>,
    ): Result<void, PlatformError>;

    /// Read one queued signal event from a signalfd descriptor.
    ///
    /// Consume one queued signal record and return normalized event data.
    /// Record fields follow host signal information and runtime normalization rules.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses read(2) on signalfd descriptors on Linux and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.fd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.fdRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.fd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function signalFdRead(handle: SignalFdHandle): Result<SignalEvent, PlatformError>;

    /// Try to read one queued signal event from a signalfd descriptor.
    ///
    /// Attempt one nonblocking descriptor read and return immediately if no signals are queued.
    /// Empty queue state is reported as ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses nonblocking read on signalfd descriptors on Linux and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.fd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.fdTryRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.fd"],
            scope: "os",
            blocking: "never",
        },
    )
    export function signalFdTryRead(handle: SignalFdHandle): Result<SignalEvent, PlatformError>;

    /// Close one signalfd descriptor.
    ///
    /// Close one descriptor and release host signal queue resources.
    /// Pending queued records are discarded according to host close semantics.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the kernel feature is unavailable.
    /// Uses close(2) on Linux and runtime fallback on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.fd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.signals.fdClose",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.fd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function signalFdClose(handle: SignalFdHandle): Result<void, PlatformError>;
}
