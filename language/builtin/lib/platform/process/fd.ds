import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { ProcessFdHandle, ProcessHandle, SignalFdHandle } from "../resource/index.ds";
import { ProcessId } from "./ids.ds";
import { Signal, SignalEvent, SignalFdFlags } from "./signals.ds";
import { ProcessWaitStatus } from "./wait.ds";

/// Process file descriptor flags.
export newtype ProcessFdFlags = uint32;

/// Process file descriptor signal flags.
export newtype ProcessFdSignalFlags = uint32;

/// Process control command selector.
export newtype ProcessControlCommand = uint32;

/// Process control flag mask.
export newtype ProcessControlFlags = uint32;

/// Process descriptor bindings.
declare namespace process {
    /// Open one pidfd descriptor for the target process id.
    ///
    /// Open one host pidfd-style process descriptor that can be used for wait and signal operations without pid reuse races.
    /// Descriptor semantics follow pidfd on Linux and host-equivalent process-handle semantics on other targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses pidfd_open(2) on Linux and process handle duplication on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.pidfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdOpen",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function pidfdOpen(
        pid: ProcessId,
        flags: ProcessFdFlags,
    ): Result<ProcessFdHandle, PlatformError>;

    /// Close one pidfd descriptor.
    ///
    /// Close one host pidfd descriptor and release the kernel object reference.
    /// Closing semantics follow host descriptor teardown behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses close(2) on Unix and CloseHandle on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.pidfd`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdClose",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd"],
            scope: "os",
            blocking: "never",
        },
    )
    export function pidfdClose(handle: ProcessFdHandle): Result<void, PlatformError>;

    /// Send one signal through one pidfd descriptor.
    ///
    /// Deliver one signal using a stable process descriptor rather than a numeric pid.
    /// Delivery semantics follow pidfd_send_signal on Linux and host-equivalent process-signal APIs on other targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses pidfd_send_signal(2) on Linux and process-handle control APIs on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.send`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdSendSignal",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd", "process.signal.send"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function pidfdSendSignal(
        handle: ProcessFdHandle,
        signal: Signal,
        flags: ProcessFdSignalFlags,
    ): Result<void, PlatformError>;

    /// Wait for one pidfd descriptor state transition.
    ///
    /// Wait for one child-state transition associated with one pidfd descriptor.
    /// Wait semantics follow pollable pidfd readiness on Linux and host process wait APIs on other targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses poll or waitid over pidfd on Linux and WaitForSingleObject plus status queries on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.wait`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdWait",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd", "process.wait"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function pidfdWait(
        handle: ProcessFdHandle,
        timeoutNs: uint64,
    ): Result<ProcessWaitStatus, PlatformError>;

    /// Poll one pidfd descriptor state transition without blocking.
    ///
    /// Poll one pidfd descriptor for state transition readiness and return immediately when no transition is pending.
    /// Non-ready state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking poll over pidfd on Linux and zero-timeout process wait on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.wait`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdTryWait",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd", "process.wait"],
            scope: "os",
            blocking: "never",
        },
    )
    export function pidfdTryWait(
        handle: ProcessFdHandle,
    ): Result<ProcessWaitStatus, PlatformError>;

    /// Open one signal descriptor for the provided signal mask.
    ///
    /// Open one descriptor-backed signal queue that can be polled and read like other fd resources.
    /// Signal mask semantics follow signalfd on Linux and host-equivalent runtime adapters on other targets.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses signalfd(2) on Linux and runtime-backed signal queue descriptors elsewhere.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.signalFdOpen",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalFdOpen(
        signals: Slice<Signal>,
        flags: SignalFdFlags,
    ): Result<SignalFdHandle, PlatformError>;

    /// Close one signal descriptor.
    ///
    /// Close one descriptor-backed signal queue and release host resources.
    /// Close semantics follow host descriptor teardown behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses close(2) on Unix and CloseHandle on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.signalFdClose",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "never",
        },
    )
    export function signalFdClose(handle: SignalFdHandle): Result<void, PlatformError>;

    /// Read one queued signal event from a signal descriptor.
    ///
    /// Read the next queued signal payload from one descriptor-backed signal queue.
    /// Queue ordering and coalescing behavior follow host signal queue semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses read(2) over signalfd on Linux and runtime queue reads on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioInterrupted, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.signalFdRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalFdRead(handle: SignalFdHandle): Result<SignalEvent, PlatformError>;

    /// Poll one queued signal event from a signal descriptor without blocking.
    ///
    /// Poll one descriptor-backed signal queue for one signal event and return immediately when empty.
    /// Empty queue state is reported through ioWouldBlock.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses nonblocking reads over signalfd on Linux and runtime queue polling elsewhere.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.signalFdTryRead",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "never",
        },
    )
    export function signalFdTryRead(handle: SignalFdHandle): Result<SignalEvent, PlatformError>;

    /// Replace the active signal mask for one signal descriptor.
    ///
    /// Replace the descriptor signal mask with one explicit signal-set value.
    /// Mask transitions are atomic under host signal-descriptor APIs.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses signalfd mask update semantics on Linux and runtime queue mask update elsewhere.
    ///
    /// # Errors
    /// Returns invalidArgument, processPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `process.signal.receive`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.signalFdSetMask",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.signal.receive"],
            scope: "hybrid",
            blocking: "sometimes",
        },
    )
    export function signalFdSetMask(
        handle: SignalFdHandle,
        signals: Slice<Signal>,
    ): Result<void, PlatformError>;

    /// Execute one process-control command.
    ///
    /// Forward one process-control command to the host kernel for the target process handle.
    /// Command semantics follow host process-control ABI definitions.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` when host mapping is unavailable.
    /// Uses prctl or procctl style controls on Unix and process control adapters on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `process.control`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.processControl",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.control"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function processControl(
        handle: ProcessHandle,
        command: ProcessControlCommand,
        argument: uint64,
        flags: ProcessControlFlags,
    ): Result<int64, PlatformError>;

    /// Duplicate one target descriptor from one pidfd process.
    ///
    /// Duplicate one descriptor from one target process into the current process descriptor table.
    /// Descriptor duplication semantics follow host pidfd or process-handle descriptor APIs.
    ///
    /// # Platform
    /// Unix and Windows, with operation-level `notSupported` when host mapping is unavailable.
    /// Uses pidfd_getfd(2) on Linux and process-handle descriptor adapters on other targets.
    ///
    /// # Errors
    /// Returns invalidArgument, processNotFound, processPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `process.pidfd`, `process.handle`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.process.fd.pidfdGetFd",
        {
            effect: "external",
            replay: "recordable",
            requires: ["process.pidfd", "process.handle"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function pidfdGetFd(
        handle: ProcessFdHandle,
        targetFd: int32,
        flags: uint32,
    ): Result<ProcessFdHandle, PlatformError>;
}
