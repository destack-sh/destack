import type { PlatformError } from "../error/index.ds";

/// Environment variable bindings for the native runtime.
declare namespace process {
    /// Read an environment variable by name.
    @binding("destack.process.envGet", { effect: "external", replay: "recordable" })
    export function envGet(name: string): Result<string, PlatformError>;

    /// Set an environment variable by name.
    @binding("destack.process.envSet", { effect: "external", replay: "recordable" })
    export function envSet(name: string, value: string): Result<void, PlatformError>;

    /// Delete an environment variable by name.
    @binding("destack.process.envDelete", { effect: "external", replay: "recordable" })
    export function envDelete(name: string): Result<void, PlatformError>;
}
