import type { PlatformError } from "../error/index.ds";

/// Memory advice bindings.
declare namespace memory {
    /// Apply memory access advice.
    ///
    /// Apply one access-pattern hint to one memory range.
    /// Advice behavior is host-specific and may be ignored.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses madvise family on Unix and host advisory equivalents on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.advise`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.advise.advise",
        {
            effect: "external",
            replay: "recordable",
            requires: ["memory.advise"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function advise(address: uint64, length: uint64, advice: uint32): Result<void, PlatformError>;

    /// Discard memory contents.
    ///
    /// Discard pages in one memory range while keeping mapping metadata.
    /// Future reads after discard are host-defined zero-fill or fault-on-demand behavior.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses madvise discard-style flags on Unix and discard page hints on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.advise`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.advise.discard",
        {
            effect: "external",
            replay: "recordable",
            requires: ["memory.advise"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function discard(address: uint64, length: uint64): Result<void, PlatformError>;

    /// Toggle huge-page preference for one range.
    ///
    /// Enable or disable huge-page preference for one memory range.
    /// Huge-page allocation remains host-policy and availability dependent.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses huge-page advice flags on Unix and large-page APIs on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.hugePage`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.advise.hugePage",
        {
            effect: "external",
            replay: "recordable",
            requires: ["memory.hugePage"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function hugePage(address: uint64, length: uint64, enabled: boolean): Result<void, PlatformError>;
}
