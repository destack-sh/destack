import type { PlatformError } from "../error/index.ds";

/// Memory lock bindings.
declare namespace memory {
    /// Lock one memory range into physical memory.
    ///
    /// Prevent one memory range from being paged out when supported by the host.
    /// Lock behavior and resource limits follow host memory-lock policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses mlock family on Unix and VirtualLock on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.lock`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.lock.range",
        {
            effect: "external",
            replay: "recordable",
            requires: ["memory.lock"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function lock(address: uint64, length: uint64): Result<void, PlatformError>;

    /// Unlock one memory range.
    ///
    /// Release one previously locked memory range.
    /// Unlock behavior and accounting follow host memory-lock policy.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses munlock family on Unix and VirtualUnlock on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.lock`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.lock.unlock",
        {
            effect: "external",
            replay: "recordable",
            requires: ["memory.lock"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function unlock(address: uint64, length: uint64): Result<void, PlatformError>;
}
