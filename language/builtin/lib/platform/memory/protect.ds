import type { PlatformError } from "../error/index.ds";

/// Memory range descriptor.
export struct ProtectedMemoryRange {
    /// Base address of the mapped range.
    address: uint64;
    /// Length of the mapped range in bytes.
    length: uint64;
}

/// Memory protection bindings.
declare namespace memory {
    /// Change memory protection for one range.
    ///
    /// Apply one protection mask to one virtual memory range.
    /// Execute, read, and write semantics follow host protection rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses mprotect on Unix and VirtualProtect on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.protect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.protect.protectRange",
        {
            effect: "external",
            replay: "recordable",
            capabilities: ["memory.protect"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function protect(address: uint64, length: uint64, protection: uint32): Result<void, PlatformError>;

    /// Resize one mapped range.
    ///
    /// Remap one existing mapping to a new length.
    /// Move behavior and address stability are host-defined when remap cannot grow in place.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses mremap on Linux and reserve-plus-copy fallback on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.protect`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.protect.remap",
        {
            effect: "external",
            replay: "recordable",
            capabilities: ["memory.protect"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function remap(address: uint64, oldLength: uint64, newLength: uint64, flags: uint32): Result<ProtectedMemoryRange, PlatformError>;

    /// Change execute permission for one range.
    ///
    /// Toggle execute permission bits for one virtual memory range.
    /// Execute permission policy follows host W^X and code-signing rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses mprotect execute flags on Unix and VirtualProtect execute flags on Windows.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.execute`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.protect.execute",
        {
            effect: "external",
            replay: "recordable",
            capabilities: ["memory.execute"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function protectExecute(address: uint64, length: uint64, enabled: boolean): Result<void, PlatformError>;

    /// Flush instruction cache for one range.
    ///
    /// Flush host instruction caches after writing executable code bytes.
    /// Cache flush granularity and barriers follow host architecture rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses built-in cache flush intrinsics and host process APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `memory.execute`.
    ///
    /// # Replay
    /// External, recordable.
    @binding(
        "destack.memory.protect.flushInstructionCache",
        {
            effect: "external",
            replay: "recordable",
            capabilities: ["memory.execute"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function flushInstructionCache(address: uint64, length: uint64): Result<void, PlatformError>;

    /// Set runtime W^X policy.
    ///
    /// Enable or disable runtime write-xor-execute policy enforcement.
    /// Policy update affects subsequent executable-memory transitions.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime memory policy controls layered over host page protections.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, notSupported.
    ///
    /// # Security
    /// Requires `memory.execute`.
    ///
    /// # Replay
    /// Deterministic.
    @binding(
        "destack.memory.protect.setWriteXorExecute",
        {
            effect: "deterministic",
            replay: "nonrecordable",
            capabilities: ["memory.execute"],
            platforms: ["windows", "unix"],
            scope: "runtime",
            blocking: "never",
        },
    )
    export function setWriteXorExecute(enabled: boolean): Result<void, PlatformError>;
}
