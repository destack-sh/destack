import { ResourceId } from "../resource/index.ds";
import type { PlatformError } from "../error/index.ds";
import {
    AgentDescriptor,
    AgentHandle,
    BranchDescriptor,
    BranchId,
    CheckpointDescriptor,
    CheckpointId,
    ExplanationStep,
    EventLoopDescriptor,
    HeapDescriptor,
    ImageDescriptor,
    ImageId,
    ResourceDescriptor,
    ResourceFilter,
    RevisionDescriptor,
    RevisionId,
    RuntimeDescriptor,
    RuntimeHandle,
    RuntimeViewOptions,
    RuntimeViewHandle,
    SnapshotDescriptor,
    SnapshotId,
    TopologyEdge,
    TopologyEdgeId,
    TopologyEdgeFilter,
    TopologyEntity,
    TopologyEntityId,
    TopologyEntityFilter,
    TraceDescriptor,
    ViewDiffRecord,
    VmDescriptor,
    WorldDescriptor,
    WorldHandle,
} from "./types.ds";

/// Low-level runtime inspection bindings.
declare namespace runtime {
    /// Open one pinned runtime view.
    ///
    /// Create one read-consistent runtime view over one live world or one pinned revision.
    /// Views provide stable reads across topology, state, trace metadata, and lineage without racing live mutation.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime inspection and revision pinning logic.
    ///
    /// # Errors
    /// Returns invalidArgument, ioWouldBlock, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewOpen", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "sometimes",

        affinity: "any",
    })
    export function viewOpen(
        world: WorldHandle,
        options?: RuntimeViewOptions,
    ): Result<RuntimeViewHandle, PlatformError>;

    /// Close one pinned runtime view.
    ///
    /// Release one previously opened runtime view and its pinned state.
    /// Closing one view does not affect the underlying world, trace, or lineage objects.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses runtime inspection teardown logic.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewClose", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewClose(view: RuntimeViewHandle): Result<void, PlatformError>;

    /// Describe the world visible through one pinned runtime view.
    ///
    /// Return one world descriptor as observed through one runtime view.
    /// Descriptor values are stable for the lifetime of the view.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewWorld", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewWorld(view: RuntimeViewHandle): Result<WorldDescriptor, PlatformError>;

    /// Describe one runtime visible through one pinned runtime view.
    ///
    /// Return one runtime descriptor as observed through one runtime view.
    /// Direct lookup avoids scanning when one stable runtime handle is already known.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewRuntime", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewRuntime(
        view: RuntimeViewHandle,
        runtimeHandle: RuntimeHandle,
    ): Result<RuntimeDescriptor, PlatformError>;

    /// List runtimes visible through one pinned runtime view.
    ///
    /// Enumerate runtime descriptors in stable handle order starting after the optional cursor.
    /// This is the low-level bulk enumeration surface for world-owned runtimes.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewRuntimes", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewRuntimes(
        view: RuntimeViewHandle,
        after?: RuntimeHandle,
        limit?: uint32,
    ): Result<Array<RuntimeDescriptor>, PlatformError>;

    /// Describe one agent visible through one pinned runtime view.
    ///
    /// Return one agent descriptor as observed through one runtime view.
    /// Direct lookup avoids scanning when one stable agent handle is already known.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewAgent", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewAgent(
        view: RuntimeViewHandle,
        agent: AgentHandle,
    ): Result<AgentDescriptor, PlatformError>;

    /// List agents visible through one pinned runtime view.
    ///
    /// Enumerate agent descriptors in stable handle order starting after the optional cursor.
    /// When one runtime handle is provided, only agents from that runtime are returned.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewAgents", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewAgents(
        view: RuntimeViewHandle,
        runtimeHandle?: RuntimeHandle,
        after?: AgentHandle,
        limit?: uint32,
    ): Result<Array<AgentDescriptor>, PlatformError>;

    /// Describe one resource visible through one pinned runtime view.
    ///
    /// Return one resource descriptor as observed through one runtime view.
    /// Direct lookup avoids scanning when one stable resource identifier is already known.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewResource", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewResource(
        view: RuntimeViewHandle,
        resource: ResourceId,
    ): Result<ResourceDescriptor, PlatformError>;

    /// List resources visible through one pinned runtime view.
    ///
    /// Enumerate runtime resource descriptors in stable resource-id order starting after the optional cursor.
    /// Resource filters may constrain owner, kind, and exact label matches.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewResources", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewResources(
        view: RuntimeViewHandle,
        filter?: ResourceFilter,
        after?: ResourceId,
        limit?: uint32,
    ): Result<Array<ResourceDescriptor>, PlatformError>;

    /// Describe one topology entity visible through one pinned runtime view.
    ///
    /// Return one topology entity as observed through one runtime view.
    /// Topology queries stay inside the view API rather than a separate topology namespace.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection topology state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.topology.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewEntity", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.topology.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewEntity(
        view: RuntimeViewHandle,
        entityId: TopologyEntityId,
    ): Result<TopologyEntity, PlatformError>;

    /// List topology entities visible through one pinned runtime view.
    ///
    /// Enumerate topology entities in stable id order starting after the optional cursor.
    /// Entity filters may constrain kind and label selectors.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection topology state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.topology.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewEntities", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.topology.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewEntities(
        view: RuntimeViewHandle,
        filter?: TopologyEntityFilter,
        after?: string,
        limit?: uint32,
    ): Result<Array<TopologyEntity>, PlatformError>;

    /// Describe one topology edge visible through one pinned runtime view.
    ///
    /// Return one topology edge as observed through one runtime view.
    /// Direct lookup avoids scanning when one stable edge identifier is already known.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection topology state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.topology.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewEdge", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.topology.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewEdge(
        view: RuntimeViewHandle,
        edgeId: TopologyEdgeId,
    ): Result<TopologyEdge, PlatformError>;

    /// List topology edges visible through one pinned runtime view.
    ///
    /// Enumerate topology edges in stable id order starting after the optional cursor.
    /// Edge filters may constrain kind, endpoints, and label selectors.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection topology state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.topology.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewEdges", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.topology.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewEdges(
        view: RuntimeViewHandle,
        filter?: TopologyEdgeFilter,
        after?: string,
        limit?: uint32,
    ): Result<Array<TopologyEdge>, PlatformError>;

    /// Describe one branch visible through one pinned runtime view.
    ///
    /// Return one branch descriptor as observed through one runtime view.
    /// Branch metadata is read through the same pinned boundary as topology and state.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned lineage state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.lineage.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewBranch", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.lineage.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewBranch(
        view: RuntimeViewHandle,
        branchId: BranchId,
    ): Result<BranchDescriptor, PlatformError>;

    /// Describe one revision visible through one pinned runtime view.
    ///
    /// Return one revision descriptor as observed through one runtime view.
    /// Revision reads stay pinned to one consistent lineage image.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned lineage state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.lineage.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewRevision", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.lineage.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewRevision(
        view: RuntimeViewHandle,
        revisionId: RevisionId,
    ): Result<RevisionDescriptor, PlatformError>;

    /// Describe one checkpoint visible through one pinned runtime view.
    ///
    /// Return one checkpoint descriptor as observed through one runtime view.
    /// Checkpoint metadata stays queryable without leaving the pinned view model.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned lineage state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.lineage.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewCheckpoint", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.lineage.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewCheckpoint(
        view: RuntimeViewHandle,
        checkpointId: CheckpointId,
    ): Result<CheckpointDescriptor, PlatformError>;

    /// Describe one image visible through one pinned runtime view.
    ///
    /// Return one image descriptor as observed through one runtime view.
    /// Image metadata stays queryable through the same low-level inspection path.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned lineage and snapshot metadata only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.snapshot.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewImage", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.snapshot.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewImage(
        view: RuntimeViewHandle,
        imageId: ImageId,
    ): Result<ImageDescriptor, PlatformError>;

    /// Describe one snapshot visible through one pinned runtime view.
    ///
    /// Return one snapshot descriptor as observed through one runtime view.
    /// Snapshot metadata stays queryable without reading the serialized payload.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned snapshot metadata only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.snapshot.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewSnapshot", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.snapshot.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewSnapshot(
        view: RuntimeViewHandle,
        snapshotId: SnapshotId,
    ): Result<SnapshotDescriptor, PlatformError>;

    /// Describe the trace visible through one pinned runtime view.
    ///
    /// Return one trace descriptor as observed through one runtime view.
    /// This keeps lineage and causal metadata aligned with the same pinned read boundary.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned trace metadata only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.trace.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewTrace", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.trace.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewTrace(view: RuntimeViewHandle): Result<TraceDescriptor, PlatformError>;

    /// Describe one agent event loop visible through one pinned runtime view.
    ///
    /// Return one event-loop summary for one agent as observed through one runtime view.
    /// The summary exposes queue, timer, watch, and pending-work counts without exposing raw queue internals.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewEventLoop", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewEventLoop(
        view: RuntimeViewHandle,
        agent: AgentHandle,
    ): Result<EventLoopDescriptor, PlatformError>;

    /// Describe one agent heap visible through one pinned runtime view.
    ///
    /// Return one heap summary for one agent as observed through one runtime view.
    /// The summary exposes heap size, sharing, dirty-page, and GC counters without exposing raw page internals.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewHeap", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewHeap(
        view: RuntimeViewHandle,
        agent: AgentHandle,
    ): Result<HeapDescriptor, PlatformError>;

    /// Describe one agent VM state visible through one pinned runtime view.
    ///
    /// Return one VM execution summary for one agent as observed through one runtime view.
    /// The summary exposes continuation, frame, and image-size counters without exposing raw frame layouts.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned inspection state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewVm", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "never",

        affinity: "any",
    })
    export function viewVm(
        view: RuntimeViewHandle,
        agent: AgentHandle,
    ): Result<VmDescriptor, PlatformError>;

    /// Diff two pinned runtime views.
    ///
    /// Compare two pinned runtime views and return structural and state differences in stable diff order.
    /// Diff records may describe topology, runtime, agent, resource, or field-level changes.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned view state only.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewDiff", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "sometimes",

        affinity: "any",
    })
    export function viewDiff(
        left: RuntimeViewHandle,
        right: RuntimeViewHandle,
        after?: string,
        limit?: uint32,
    ): Result<Array<ViewDiffRecord>, PlatformError>;

    /// Explain one topology entity visible through one pinned runtime view.
    ///
    /// Return provenance steps for why one topology entity exists in the pinned view.
    /// Explanations may point at trace sequences, revisions, and related entities or edges.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned trace, topology, and lineage metadata.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewExplainEntity", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "sometimes",

        affinity: "any",
    })
    export function viewExplainEntity(
        view: RuntimeViewHandle,
        entityId: TopologyEntityId,
    ): Result<Array<ExplanationStep>, PlatformError>;

    /// Explain one resource visible through one pinned runtime view.
    ///
    /// Return provenance steps for why one runtime resource exists in the pinned view.
    /// Explanations may point at trace sequences, revisions, owners, and topology entities.
    ///
    /// # Platform
    /// Runtime-managed on all targets.
    /// Uses pinned trace, resource, and lineage metadata.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `runtime.inspect.read`.
    ///
    /// # Replay
    /// Deterministic.
    @binding("destack.runtime.inspect.viewExplainResource", {
        effect: "deterministic",
        replay: "nonrecordable",
        capabilities: ["runtime.inspect.read"],
        platforms: ["windows", "unix", "wasi"],
        simulation: "unsupported",
        scope: "runtime",
        blocking: "sometimes",

        affinity: "any",
    })
    export function viewExplainResource(
        view: RuntimeViewHandle,
        resource: ResourceId,
    ): Result<Array<ExplanationStep>, PlatformError>;
}
