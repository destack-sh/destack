import { Array } from "native";
import type { PlatformError } from "../error/index.ds";
import { CryptoCertificateHandle, CryptoKeyHandle, CryptoStoreHandle } from "../resource/index.ds";

/// Crypto store backend kind.
export enum CryptoStoreKind {
    /// Use the host default trust and key provider.
    System = 0,
    /// Use one user-scoped host key and certificate store.
    User = 1,
    /// Use one machine-scoped host key and certificate store.
    Machine = 2,
    /// Use one named provider backend.
    Provider = 3,
}

/// Crypto store options.
export struct CryptoStoreOptions {
    /// Store backend kind.
    kind: CryptoStoreKind;
    /// Provider name for provider-backed stores.
    providerName: string;
}

/// Key query selector for store enumeration.
export struct CryptoKeyQuery {
    /// Label prefix filter.
    labelPrefix: string;
    /// Algorithm filter name.
    algorithm: string;
    /// Required key usage mask bits.
    usageMask: uint32;
}

/// Certificate query selector for store enumeration.
export struct CryptoCertificateQuery {
    /// Subject substring filter.
    subjectContains: string;
    /// Issuer substring filter.
    issuerContains: string;
    /// Required subject alternative name entry.
    subjectAlternativeName: string;
}

/// Crypto store bindings for host provider stores.
declare namespace crypto {
    /// Open one crypto store.
    ///
    /// Create one host provider store handle for key and certificate operations.
    /// Provider selection and access scope follow host keychain and keystore semantics.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses Security.framework on macos and ios, CNG and cert stores on Windows, and provider backends on Linux.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.store.open",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["crypto.store.read"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function storeOpen(options: CryptoStoreOptions): Result<CryptoStoreHandle, PlatformError>;

    /// Close one crypto store.
    ///
    /// Release one host provider store handle.
    /// Open key and certificate handles remain valid according to host provider lifetime rules.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses provider-specific store teardown semantics.
    ///
    /// # Errors
    /// Returns invalidArgument, ioNotFound, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.store.close",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["crypto.store.read"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function storeClose(handle: CryptoStoreHandle): Result<void, PlatformError>;

    /// List keys from one store.
    ///
    /// Enumerate key handles that match one query selector.
    /// Result ordering and visibility follow host provider policies and caller permissions.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host keychain and keystore enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.store.listKeys",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["crypto.store.read"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function storeListKeys(
        handle: CryptoStoreHandle,
        query: CryptoKeyQuery,
    ): Result<Array<CryptoKeyHandle>, PlatformError>;

    /// List certificates from one store.
    ///
    /// Enumerate certificate handles that match one query selector.
    /// Result ordering and visibility follow host provider policies and caller permissions.
    ///
    /// # Platform
    /// Unix and Windows.
    /// Uses host certificate store enumeration APIs.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.store.listCertificates",
        {
            effect: "external",
            replay: "nonrecordable",
            requires: ["crypto.store.read"],
            platforms: ["unix", "windows"],
            scope: "os",
            blocking: "sometimes",
        },
    )
    export function storeListCertificates(
        handle: CryptoStoreHandle,
        query: CryptoCertificateQuery,
    ): Result<Array<CryptoCertificateHandle>, PlatformError>;
}
