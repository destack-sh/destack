import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CryptoKeyHandle, CryptoStoreHandle } from "../resource/index.ds";
import {
    CryptoAsymmetricEncryptionAlgorithm,
    CryptoDigestAlgorithm,
    CryptoKeyAlgorithm,
    CryptoKeyFormat,
    CryptoKeyKind,
    CryptoKeyUsageMask,
    CryptoNamedCurve,
    CryptoSignatureAlgorithm,
} from "./algorithm.ds";
import { CryptoStoreProvenance } from "./store.ds";

/// Key-generation request.
export struct CryptoKeyGenerationRequest {
    /// Key algorithm family.
    algorithm: CryptoKeyAlgorithm;
    /// Named curve for EC, EdDSA, and XDH key families.
    namedCurve?: CryptoNamedCurve;
    /// RSA modulus size in bits for RSA key families.
    modulusBits?: uint32;
    /// RSA public exponent for RSA key families.
    publicExponent?: uint32;
    /// Digest algorithm for RSA-PSS, RSA-OAEP, and HMAC defaults.
    digest?: CryptoDigestAlgorithm;
    /// Key size in bits for symmetric key families.
    sizeBits?: uint32;
    /// Key usage mask.
    /// Use zero for no allowed key operations.
    usageMask: CryptoKeyUsageMask;
    /// User-visible key label.
    label: string;
    /// Whether key material is exportable.
    extractable: boolean;
    /// Whether host hardware-backed storage is required.
    hardwareBacked: boolean;
    /// Whether key material should persist beyond process lifetime.
    persistent: boolean;
}

/// Key import request.
export struct CryptoKeyImportRequest {
    /// Key material format.
    format: CryptoKeyFormat;
    /// Encoded key bytes.
    bytes: Slice<uint8>;
    /// Key algorithm family.
    algorithm: CryptoKeyAlgorithm;
    /// Named curve for EC, EdDSA, and XDH key families.
    namedCurve?: CryptoNamedCurve;
    /// Digest algorithm for RSA-PSS, RSA-OAEP, and HMAC defaults.
    digest?: CryptoDigestAlgorithm;
    /// Key usage mask.
    /// Use zero for no allowed key operations.
    usageMask: CryptoKeyUsageMask;
    /// User-visible key label.
    label: string;
    /// Whether key material is exportable.
    extractable: boolean;
    /// Whether key material should persist beyond process lifetime.
    persistent: boolean;
}

/// Generated key pair.
export struct CryptoKeyPair {
    /// Public key handle.
    publicKey: CryptoKeyHandle;
    /// Private key handle.
    privateKey: CryptoKeyHandle;
}

/// Key descriptor.
export struct CryptoKeyDescriptor {
    /// Key object kind.
    kind: CryptoKeyKind;
    /// Key algorithm family.
    algorithm: CryptoKeyAlgorithm;
    /// Named curve for EC, EdDSA, and XDH key families.
    namedCurve?: CryptoNamedCurve;
    /// RSA modulus size in bits when available.
    modulusBits?: uint32;
    /// RSA public exponent when available.
    publicExponent?: uint32;
    /// Digest algorithm for RSA-PSS, RSA-OAEP, and HMAC defaults.
    digest?: CryptoDigestAlgorithm;
    /// Effective key size in bits when available.
    sizeBits?: uint32;
    /// Key usage mask.
    /// Use zero for no allowed key operations.
    usageMask: CryptoKeyUsageMask;
    /// User-visible key label.
    label: string;
    /// Whether key material is exportable.
    extractable: boolean;
    /// Whether key storage is hardware-backed.
    hardwareBacked: boolean;
    /// Whether key material persists beyond process lifetime.
    persistent: boolean;
    /// Effective key store provenance.
    storeProvenance: CryptoStoreProvenance;
}

/// Signature parameters.
export struct CryptoSignatureParameters {
    /// Signature algorithm.
    algorithm: CryptoSignatureAlgorithm;
    /// Digest algorithm.
    digest?: CryptoDigestAlgorithm;
    /// RSA-PSS salt length in bytes.
    ///
    /// Set to zero to use backend default salt behavior.
    saltLengthBytes?: uint32;
}

/// Asymmetric encryption parameters.
export struct CryptoAsymmetricEncryptionParameters {
    /// Asymmetric encryption algorithm.
    algorithm: CryptoAsymmetricEncryptionAlgorithm;
    /// Digest algorithm.
    digest?: CryptoDigestAlgorithm;
    /// OAEP label bytes.
    ///
    /// Use one empty slice for no label.
    label: Slice<uint8>;
}

/// Key bindings for runtime store key objects.
declare namespace crypto {
    /// Generate one symmetric key.
    ///
    /// Create one store-backed secret key object.
    /// Generation policy and persistence semantics follow runtime store behavior.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.generate`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.generateSecret",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.generate"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyGenerateSecret(
        store: CryptoStoreHandle,
        request: CryptoKeyGenerationRequest,
    ): Result<CryptoKeyHandle, PlatformError>;

    /// Generate one asymmetric key pair.
    ///
    /// Create one store-backed asymmetric key pair and return public and private handles.
    /// Generation policy and persistence semantics follow runtime store behavior.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.generate`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.generatePair",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.generate"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyGeneratePair(
        store: CryptoStoreHandle,
        request: CryptoKeyGenerationRequest,
    ): Result<CryptoKeyPair, PlatformError>;

    /// Import one key object.
    ///
    /// Parse and import one key blob into one store lane.
    /// Key visibility and persistence follow runtime store policies.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.import",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.write"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyImport(
        store: CryptoStoreHandle,
        request: CryptoKeyImportRequest,
    ): Result<CryptoKeyHandle, PlatformError>;

    /// Export one public key.
    ///
    /// Export one public key representation in the requested encoding format.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.exportPublic",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyExportPublic(
        handle: CryptoKeyHandle,
        format: CryptoKeyFormat,
    ): Result<Slice<uint8>, PlatformError>;

    /// Export one private key.
    ///
    /// Export one private key representation in the requested encoding format.
    /// The operation fails when store policy marks this key as non-exportable.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.exportPrivate",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyExportPrivate(
        handle: CryptoKeyHandle,
        format: CryptoKeyFormat,
    ): Result<Slice<uint8>, PlatformError>;

    /// Export one secret key.
    ///
    /// Export one symmetric or raw-secret key representation in the requested encoding format.
    /// The operation fails when store policy marks this key as non-exportable.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.exportSecret",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyExportSecret(
        handle: CryptoKeyHandle,
        format: CryptoKeyFormat,
    ): Result<Slice<uint8>, PlatformError>;

    /// Return one key descriptor.
    ///
    /// Query one key object and return normalized metadata fields.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.descriptor",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyDescriptor(handle: CryptoKeyHandle): Result<CryptoKeyDescriptor, PlatformError>;

    /// Sign one payload.
    ///
    /// Produce one signature over one payload using one store-backed private key.
    /// Payload hashing behavior is controlled by signature parameters.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.sign`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.sign",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.sign"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keySign(
        handle: CryptoKeyHandle,
        parameters: CryptoSignatureParameters,
        payload: Slice<uint8>,
    ): Result<Slice<uint8>, PlatformError>;

    /// Verify one signature.
    ///
    /// Verify one signature over one payload using one store-backed public key.
    /// Payload hashing behavior is controlled by signature parameters.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.verify`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.verify",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.verify"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyVerify(
        handle: CryptoKeyHandle,
        parameters: CryptoSignatureParameters,
        payload: Slice<uint8>,
        signature: Slice<uint8>,
    ): Result<boolean, PlatformError>;

    /// Encrypt one payload with one asymmetric key.
    ///
    /// Encrypt one payload using one store-backed public key.
    /// Padding and label semantics are controlled by encryption parameters.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.encrypt`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.encrypt",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.encrypt"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyEncrypt(
        handle: CryptoKeyHandle,
        parameters: CryptoAsymmetricEncryptionParameters,
        payload: Slice<uint8>,
    ): Result<Slice<uint8>, PlatformError>;

    /// Decrypt one payload with one asymmetric key.
    ///
    /// Decrypt one payload using one store-backed private key.
    /// Padding and label semantics are controlled by encryption parameters.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.decrypt`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.decrypt",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.decrypt"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyDecrypt(
        handle: CryptoKeyHandle,
        parameters: CryptoAsymmetricEncryptionParameters,
        payload: Slice<uint8>,
    ): Result<Slice<uint8>, PlatformError>;

    /// Wrap one key.
    ///
    /// Export and encrypt one key object under one wrapping key.
    /// Wrapping format and encryption semantics follow runtime store behavior.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.wrap`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.wrap",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.wrap"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyWrap(
        wrappingKey: CryptoKeyHandle,
        keyToWrap: CryptoKeyHandle,
        format: CryptoKeyFormat,
        parameters: CryptoAsymmetricEncryptionParameters,
    ): Result<Slice<uint8>, PlatformError>;

    /// Unwrap one key.
    ///
    /// Decrypt and import one wrapped key object into one store lane.
    /// Import semantics follow runtime store policy and the import request.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.key.unwrap`, `crypto.store.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.unwrap",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.key.unwrap", "crypto.store.write"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyUnwrap(
        store: CryptoStoreHandle,
        wrappingKey: CryptoKeyHandle,
        wrappedKey: Slice<uint8>,
        parameters: CryptoAsymmetricEncryptionParameters,
        request: CryptoKeyImportRequest,
    ): Result<CryptoKeyHandle, PlatformError>;

    /// Delete one key object.
    ///
    /// Delete one store-backed key object and invalidate this handle.
    /// Deletion permissions and persistence policies are enforced by runtime store policy.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses OpenSSL software key-management primitives and host key-store lanes: Security.framework on Apple, CNG on Windows, and Android keystore callbacks when configured for hardware-backed lanes.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.store.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.key.delete",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.store.write"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function keyDelete(handle: CryptoKeyHandle): Result<void, PlatformError>;
}
