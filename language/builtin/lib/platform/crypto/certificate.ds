import { Array, Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import { CryptoCertificateHandle, CryptoStoreHandle } from "../resource/index.ds";

/// Certificate encoding format.
export enum CryptoCertificateFormat {
    /// PEM encoded certificate bytes.
    Pem = 1,
    /// DER encoded certificate bytes.
    Der = 2,
}

/// Certificate verification purpose.
export enum CryptoCertificatePurpose {
    /// Server TLS authentication.
    ServerAuth = 1,
    /// Client TLS authentication.
    ClientAuth = 2,
    /// Code signing validation.
    CodeSigning = 3,
    /// Email protection validation.
    EmailProtection = 4,
}

/// Revocation policy for certificate verification.
export enum CryptoCertificateRevocationMode {
    /// Use host default revocation behavior.
    Default = 1,
    /// Require successful revocation checks.
    Strict = 2,
    /// Skip revocation checks.
    Disabled = 3,
}

/// Certificate validity window.
export struct CryptoCertificateValidity {
    /// Not-before timestamp in Unix seconds.
    notBeforeUnixSeconds: uint64;
    /// Not-after timestamp in Unix seconds.
    notAfterUnixSeconds: uint64;
}

/// Certificate descriptor fields.
export struct CryptoCertificateDescriptor {
    /// Distinguished subject name.
    subject: string;
    /// Distinguished issuer name.
    issuer: string;
    /// Serial number string.
    serialNumber: string;
    /// Subject alternative names.
    subjectAlternativeNames: Array<string>;
    /// SHA-256 fingerprint bytes.
    fingerprintSha256: Slice<uint8>;
    /// Certificate validity window.
    validity: CryptoCertificateValidity;
    /// Whether this certificate is a certificate authority.
    isCertificateAuthority: boolean;
    /// Key-usage bitmask.
    keyUsageMask: uint32;
}

/// Certificate key usage: digital signature.
export const CRYPTO_CERTIFICATE_KEY_USAGE_DIGITAL_SIGNATURE: uint32 = 1 << 0;

/// Certificate key usage: non-repudiation.
export const CRYPTO_CERTIFICATE_KEY_USAGE_NON_REPUDIATION: uint32 = 1 << 1;

/// Certificate key usage: key encipherment.
export const CRYPTO_CERTIFICATE_KEY_USAGE_KEY_ENCIPHERMENT: uint32 = 1 << 2;

/// Certificate key usage: data encipherment.
export const CRYPTO_CERTIFICATE_KEY_USAGE_DATA_ENCIPHERMENT: uint32 = 1 << 3;

/// Certificate key usage: key agreement.
export const CRYPTO_CERTIFICATE_KEY_USAGE_KEY_AGREEMENT: uint32 = 1 << 4;

/// Certificate key usage: certificate signing.
export const CRYPTO_CERTIFICATE_KEY_USAGE_CERTIFICATE_SIGN: uint32 = 1 << 5;

/// Certificate key usage: crl signing.
export const CRYPTO_CERTIFICATE_KEY_USAGE_CRL_SIGN: uint32 = 1 << 6;

/// Certificate key usage: encipher only.
export const CRYPTO_CERTIFICATE_KEY_USAGE_ENCIPHER_ONLY: uint32 = 1 << 7;

/// Certificate key usage: decipher only.
export const CRYPTO_CERTIFICATE_KEY_USAGE_DECIPHER_ONLY: uint32 = 1 << 8;

/// Certificate chain verify request.
export struct CryptoCertificateVerifyRequest {
    /// Leaf certificate handle.
    leaf: CryptoCertificateHandle;
    /// Intermediate certificate handles.
    intermediates: Slice<CryptoCertificateHandle>;
    /// Trust anchor certificate handles.
    trustAnchors: Slice<CryptoCertificateHandle>;
    /// Whether host system trust anchors should be included.
    useSystemTrustAnchors: boolean;
    /// Verification purpose.
    purpose: CryptoCertificatePurpose;
    /// Optional DNS name for server identity verification.
    ///
    /// Use one empty string when no server name check is needed.
    serverName?: string;
    /// Verification time in Unix seconds.
    verificationUnixSeconds?: uint64;
    /// Revocation policy.
    revocationMode: CryptoCertificateRevocationMode;
}

/// Certificate chain verify result.
export struct CryptoCertificateVerifyResult {
    /// Whether the chain validates.
    valid: boolean;
    /// Provider or runtime error code when validation fails.
    errorCode: uint32;
    /// Number of certificates in the verified chain.
    chainLength: uint32;
    /// Whether one system trust anchor was used.
    usedSystemTrustAnchor: boolean;
}

/// Certificate bindings for runtime provider certificate stores.
declare namespace crypto {
    /// Import one certificate into one provider store.
    ///
    /// Parse and import one certificate blob into one store and return one certificate handle.
    /// Import visibility and persistence are enforced by runtime provider policies.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses runtime certificate parsing, store, and chain-verification provider primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.certificate.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.certificate.import",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.certificate.write"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function certificateImport(
        store: CryptoStoreHandle,
        format: CryptoCertificateFormat,
        certificate: Slice<uint8>,
    ): Result<CryptoCertificateHandle, PlatformError>;

    /// Export one certificate from one handle.
    ///
    /// Serialize one certificate handle into the requested encoding format.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses runtime certificate parsing, store, and chain-verification provider primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.certificate.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.certificate.export",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.certificate.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function certificateExport(
        handle: CryptoCertificateHandle,
        format: CryptoCertificateFormat,
    ): Result<Slice<uint8>, PlatformError>;

    /// Return one certificate descriptor.
    ///
    /// Query one certificate handle and return normalized identity and validity metadata.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses runtime certificate parsing, store, and chain-verification provider primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.certificate.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.certificate.descriptor",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.certificate.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function certificateDescriptor(
        handle: CryptoCertificateHandle,
    ): Result<CryptoCertificateDescriptor, PlatformError>;

    /// Verify one certificate chain against one trust policy.
    ///
    /// Build and verify one certificate path for the requested purpose and verification time.
    /// Chain building and policy evaluation follow runtime provider trust engine behavior.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses runtime certificate parsing, store, and chain-verification provider primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.certificate.read`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.certificate.verify",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.certificate.read"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function certificateVerify(
        request: CryptoCertificateVerifyRequest,
    ): Result<CryptoCertificateVerifyResult, PlatformError>;

    /// Delete one certificate from one provider store when allowed.
    ///
    /// Remove one certificate object and invalidate the handle.
    /// Deletion permissions and persistence are enforced by runtime provider policies.
    ///
    /// # Platform
    /// Unix and Windows. Operations return `notSupported` when the crypto feature is unavailable.
    /// Uses runtime certificate parsing, store, and chain-verification provider primitives.
    ///
    /// # Errors
    /// Returns invalidArgument, ioPermissionDenied, ioInvalidData, notSupported.
    ///
    /// # Security
    /// Requires `crypto.certificate.write`.
    ///
    /// # Replay
    /// External, nonrecordable.
    @binding(
        "destack.crypto.certificate.delete",
        {
            effect: "external",
            replay: "nonrecordable",
            capabilities: ["crypto.certificate.write"],
            platforms: ["windows", "unix"],
            scope: "host",
            blocking: "sometimes",
        },
    )
    export function certificateDelete(handle: CryptoCertificateHandle): Result<void, PlatformError>;
}
