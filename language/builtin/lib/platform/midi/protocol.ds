/// MIDI transport data format selector.
export enum MidiDataFormat {
    /// Classic MIDI 1.0 byte-stream transport.
    Midi1Bytes = 1,
    /// Universal MIDI Packet transport with packed 32-bit words.
    Ump = 2,
}

/// Supported MIDI transport data-format flags.
export newtype MidiDataFormatFlags = uint32;

/// No supported MIDI transport data formats.
export const MIDI_DATA_FORMAT_FLAG_NONE: MidiDataFormatFlags = MidiDataFormatFlags(0x0);

/// Support for MIDI 1.0 byte-stream transport.
export const MIDI_DATA_FORMAT_FLAG_MIDI1_BYTES: MidiDataFormatFlags = MidiDataFormatFlags(0x1);

/// Support for Universal MIDI Packet transport.
export const MIDI_DATA_FORMAT_FLAG_UMP: MidiDataFormatFlags = MidiDataFormatFlags(0x2);

/// MIDI protocol selector.
///
/// This is distinct from `MidiDataFormat`.
/// One backend may transport MIDI 1.0 semantics either as classic byte-stream records or as Universal MIDI Packet records.
export enum MidiProtocol {
    /// MIDI 1.0 protocol semantics.
    Midi1 = 1,
    /// MIDI 2.0 protocol semantics.
    Midi2 = 2,
}

/// Supported MIDI protocol flags.
export newtype MidiProtocolFlags = uint32;

/// No supported MIDI protocols.
export const MIDI_PROTOCOL_FLAG_NONE: MidiProtocolFlags = MidiProtocolFlags(0x0);

/// Support for MIDI 1.0 protocol semantics.
export const MIDI_PROTOCOL_FLAG_MIDI1: MidiProtocolFlags = MidiProtocolFlags(0x1);

/// Support for MIDI 2.0 protocol semantics.
export const MIDI_PROTOCOL_FLAG_MIDI2: MidiProtocolFlags = MidiProtocolFlags(0x2);

/// MIDI transport-record framing selector.
export enum MidiRecordFraming {
    /// One complete transport record.
    Complete = 1,
    /// The first fragment of one multi-record transport payload.
    Start = 2,
    /// One middle fragment of one multi-record transport payload.
    Continue = 3,
    /// The final fragment of one multi-record transport payload.
    End = 4,
}
