import { Slice } from "native";
import type { PlatformError } from "../error/index.ds";
import * as platform from "../../platform/index.ds";
import type {
    AccessMode,
    Dirent,
    FileMode,
    FileOffset,
    OpenFlags,
    Stat,
    StatFs,
} from "../../platform/fs/index.ds";
import { DirectoryHandle, FileHandle } from "../resource/index.ds";

export type { AccessMode, Dirent, FileMode, FileOffset, OpenFlags, Stat, StatFs };

/// Filesystem API for the Destack runtime.
export namespace fs {
    /// Open a file and return a handle.
    export function open(
        path: string,
        flags: OpenFlags,
        mode: FileMode,
    ): Result<FileHandle, PlatformError> {
        platform.fs.open(path, flags, mode)
    }

    /// Close an open file handle.
    export function close(handle: FileHandle): Result<void, PlatformError> {
        platform.fs.close(handle)
    }

    /// Read from a file into the provided slice at the given file offset.
    export function read(
        handle: FileHandle,
        buffer: Slice<uint8>,
        offset: FileOffset,
    ): Result<uint64, PlatformError> {
        platform.fs.read(handle, buffer, offset)
    }

    /// Write to a file from the provided slice at the given file offset.
    export function write(
        handle: FileHandle,
        buffer: Slice<uint8>,
        offset: FileOffset,
    ): Result<uint64, PlatformError> {
        platform.fs.write(handle, buffer, offset)
    }

    /// Read into multiple buffers at the given file offset.
    export function readv(
        handle: FileHandle,
        buffers: Slice<Slice<uint8>>,
        offset: FileOffset,
    ): Result<uint64, PlatformError> {
        platform.fs.readv(handle, buffers, offset)
    }

    /// Write from multiple buffers at the given file offset.
    export function writev(
        handle: FileHandle,
        buffers: Slice<Slice<uint8>>,
        offset: FileOffset,
    ): Result<uint64, PlatformError> {
        platform.fs.writev(handle, buffers, offset)
    }

    /// Stat a file by path.
    export function stat(path: string): Result<Stat, PlatformError> {
        platform.fs.stat(path)
    }

    /// Stat a file by handle.
    export function fstat(handle: FileHandle): Result<Stat, PlatformError> {
        platform.fs.fstat(handle)
    }

    /// Stat a file by path without following symlinks.
    export function lstat(path: string): Result<Stat, PlatformError> {
        platform.fs.lstat(path)
    }

    /// Stat a filesystem by path.
    export function statfs(path: string): Result<StatFs, PlatformError> {
        platform.fs.statfs(path)
    }

    /// Stat a filesystem by handle.
    export function fstatfs(handle: FileHandle): Result<StatFs, PlatformError> {
        platform.fs.fstatfs(handle)
    }

    /// Check file access permissions.
    export function access(path: string, mode: AccessMode): Result<void, PlatformError> {
        platform.fs.access(path, mode)
    }

    /// Create a directory.
    export function mkdir(path: string, mode: FileMode): Result<void, PlatformError> {
        platform.fs.mkdir(path, mode)
    }

    /// Remove a directory.
    export function rmdir(path: string): Result<void, PlatformError> {
        platform.fs.rmdir(path)
    }

    /// Open a directory and return a handle.
    export function opendir(path: string): Result<DirectoryHandle, PlatformError> {
        platform.fs.opendir(path)
    }

    /// Read directory entries from an open directory handle.
    export function readdir(handle: DirectoryHandle): Result<Array<Dirent>, PlatformError> {
        platform.fs.readdir(handle)
    }

    /// Close a directory handle.
    export function closedir(handle: DirectoryHandle): Result<void, PlatformError> {
        platform.fs.closedir(handle)
    }

    /// Rename or move a file.
    export function rename(from: string, to: string): Result<void, PlatformError> {
        platform.fs.rename(from, to)
    }

    /// Unlink a file.
    export function unlink(path: string): Result<void, PlatformError> {
        platform.fs.unlink(path)
    }

    /// Create a hard link.
    export function link(existingPath: string, newPath: string): Result<void, PlatformError> {
        platform.fs.link(existingPath, newPath)
    }

    /// Create a symbolic link.
    export function symlink(target: string, path: string): Result<void, PlatformError> {
        platform.fs.symlink(target, path)
    }

    /// Read a symbolic link.
    export function readlink(path: string): Result<string, PlatformError> {
        platform.fs.readlink(path)
    }

    /// Resolve a path to its canonical form.
    export function realpath(path: string): Result<string, PlatformError> {
        platform.fs.realpath(path)
    }

    /// Change file permissions.
    export function chmod(path: string, mode: FileMode): Result<void, PlatformError> {
        platform.fs.chmod(path, mode)
    }

    /// Change file permissions by handle.
    export function fchmod(handle: FileHandle, mode: FileMode): Result<void, PlatformError> {
        platform.fs.fchmod(handle, mode)
    }

    /// Change file owner and group.
    export function chown(path: string, uid: uint32, gid: uint32): Result<void, PlatformError> {
        platform.fs.chown(path, uid, gid)
    }

    /// Change file owner and group by handle.
    export function fchown(
        handle: FileHandle,
        uid: uint32,
        gid: uint32,
    ): Result<void, PlatformError> {
        platform.fs.fchown(handle, uid, gid)
    }

    /// Update access and modification times.
    export function utimes(
        path: string,
        atimeNs: uint64,
        mtimeNs: uint64,
    ): Result<void, PlatformError> {
        platform.fs.utimes(path, atimeNs, mtimeNs)
    }

    /// Update access and modification times by handle.
    export function futimes(
        handle: FileHandle,
        atimeNs: uint64,
        mtimeNs: uint64,
    ): Result<void, PlatformError> {
        platform.fs.futimes(handle, atimeNs, mtimeNs)
    }

    /// Update access and modification times without following symlinks.
    export function lutimes(
        path: string,
        atimeNs: uint64,
        mtimeNs: uint64,
    ): Result<void, PlatformError> {
        platform.fs.lutimes(path, atimeNs, mtimeNs)
    }

    /// Truncate a file by path.
    export function truncate(path: string, size: FileOffset): Result<void, PlatformError> {
        platform.fs.truncate(path, size)
    }

    /// Truncate a file by handle.
    export function ftruncate(handle: FileHandle, size: FileOffset): Result<void, PlatformError> {
        platform.fs.ftruncate(handle, size)
    }

    /// Synchronize a file's in-core state with storage.
    export function fsync(handle: FileHandle): Result<void, PlatformError> {
        platform.fs.fsync(handle)
    }

    /// Synchronize file data only.
    export function fdatasync(handle: FileHandle): Result<void, PlatformError> {
        platform.fs.fdatasync(handle)
    }

    /// Copy a file.
    export function copyfile(
        from: string,
        to: string,
        flags: uint32,
    ): Result<void, PlatformError> {
        platform.fs.copyfile(from, to, flags)
    }

    /// Create a temporary directory.
    export function mkdtemp(template: string): Result<string, PlatformError> {
        platform.fs.mkdtemp(template)
    }
}
