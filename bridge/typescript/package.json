{
    "name": "@destack/language",
    "version": "0.55.4",
    "description": "Destack language bridge for JavaScript and TypeScript",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/destack-sh/destack.git",
        "directory": "bridge/typescript"
    },
    "homepage": "https://github.com/destack-sh/destack/tree/main/bridge/typescript",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "keywords": [
        "destack",
        "language",
        "javascript",
        "sdk",
        "bridge"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./napi": {
            "types": "./dist/napi.d.ts",
            "import": "./dist/napi.js",
            "default": "./dist/napi.js"
        },
        "./wasm": {
            "types": "./dist/wasm.d.ts",
            "import": "./dist/wasm.js",
            "default": "./dist/wasm.js"
        },
        "./repository": {
            "types": "./dist/repository/repository.d.ts",
            "import": "./dist/repository/repository.js",
            "default": "./dist/repository/repository.js"
        },
        "./session": {
            "types": "./dist/session/session.d.ts",
            "import": "./dist/session/session.js",
            "default": "./dist/session/session.js"
        },
        "./workspace": {
            "types": "./dist/workspace/workspace.d.ts",
            "import": "./dist/workspace/workspace.js",
            "default": "./dist/workspace/workspace.js"
        },
        "./artifact/*": {
            "types": "./dist/artifact/*.generated.d.ts",
            "import": "./dist/artifact/*.generated.js",
            "default": "./dist/artifact/*.generated.js"
        },
        "./diagnostic/*": {
            "types": "./dist/diagnostic/*.generated.d.ts",
            "import": "./dist/diagnostic/*.generated.js",
            "default": "./dist/diagnostic/*.generated.js"
        },
        "./dir/*": {
            "types": "./dist/dir/*.generated.d.ts",
            "import": "./dist/dir/*.generated.js",
            "default": "./dist/dir/*.generated.js"
        },
        "./repository/*": {
            "types": "./dist/repository/*.generated.d.ts",
            "import": "./dist/repository/*.generated.js",
            "default": "./dist/repository/*.generated.js"
        },
        "./session/*": {
            "types": "./dist/session/*.generated.d.ts",
            "import": "./dist/session/*.generated.js",
            "default": "./dist/session/*.generated.js"
        },
        "./source/*": {
            "types": "./dist/source/*.generated.d.ts",
            "import": "./dist/source/*.generated.js",
            "default": "./dist/source/*.generated.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "generate": "cargo run -p destack_bridge_generate",
        "build": "bun run generate && rm -rf dist && bun x tsc -p tsconfig.json",
        "test": "bun run generate && bun x tsc --noEmit -p tsconfig.json && bun run build && node --test test/open.mjs test/edit.mjs test/parse.mjs test/check.mjs test/lint.mjs test/build.mjs test/format.mjs test/content.mjs",
        "prepublishOnly": "bun run build",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@destack/language-napi": "0.55.4",
        "@destack/language-wasm": "0.55.4"
    },
    "devDependencies": {
        "typescript": "5.8.3"
    }
}
