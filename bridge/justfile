set shell := ["bash", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# all bridge crates
packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"
format-packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"
test-packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"

_default:
    @just --list --unsorted

# --- ci ---

# install js dependencies required by bridge gates
ci-install:
    bun install --frozen-lockfile

# install bridge language toolchains for this host
toolchain-install:
    bash scripts/language-bridge-toolchain.sh install

# inspect bridge language toolchain readiness on this host
toolchain-doctor:
    bash scripts/language-bridge-toolchain.sh doctor

# ensure bridge language toolchains are present, optionally auto install with DESTACK_AUTO_INSTALL_TOOLCHAINS=1
toolchain-ensure:
    bash scripts/language-bridge-toolchain.sh ensure

# run bridge format gate
ci-format:
    just format-check

# run bridge lint gate
ci-lint:
    just lint

# run bridge test gate
ci-tests:
    just test-ci

# run all blocking bridge ci gates locally
ci:
    just ci-install
    just ci-format
    just ci-lint
    just ci-tests

# --- build ---

# check bridge crates and typescript bridge packages
check:
    cargo clippy --release {{ packages }}
    bun x tsc --noEmit -p napi/tsconfig.json
    bun x tsc --noEmit -p wasm/tsconfig.json
    bun x tsc -p typescript/tsconfig.json
    bun run biome lint napi wasm typescript

# lint alias
lint:
    just check

# build all bridge packages
build:
    cargo build --release {{ packages }}
    bun run --cwd napi build
    bun run --cwd wasm build
    bun run --cwd typescript build
    just build-vscode
    just build-zed

# build napi package
napi:
    cargo build --release -p destack_napi
    bun run --cwd napi build

# build wasm package
wasm:
    cargo build --release -p destack_wasm
    bun run --cwd wasm build

# build vscode extension
build-vscode:
    cd vscode && bun run bundle && bun run package

# build zed extension
build-zed:
    cd zed && cargo check

# canonical wasm size analysis command
wasm-size:
    cd wasm && bun ./scripts/size-report.mjs

# canonical wasm size analysis command without rebuilding
wasm-size-no-build:
    cd wasm && bun ./scripts/size-report.mjs

# analyze one preset with canonical size report settings
wasm-size-preset preset="core":
    cd wasm && bun ./scripts/size-report.mjs

# format code
format:
    cargo fmt {{ format-packages }}
    bun run biome format --write napi wasm typescript

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}
    bun run biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false napi wasm typescript

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean
    rm -rf napi/node_modules wasm/node_modules typescript/node_modules
    rm -rf typescript/dist
    rm -rf vscode/out vscode/*.vsix
    rm -rf zed/grammars zed/extension.wasm

# --- test ---

# run quick tests for local development
test-quick:
    cargo test --release --all-targets {{ test-packages }}
    bun run --cwd napi test
    bun run --cwd wasm test
    bun run --cwd typescript test
    just test-vscode
    just test-zed

# run blocking ci test gates
test-ci:
    just test-quick
    just check-zed-grammars
    just test-language-bridges

# run nightly test gates
test-nightly:
    just test-ci
    just test-vscode-lsp

# run release test gates
test-release:
    just test-ci

# run quick tests alias
test:
    just test-quick

# test vscode grammar
test-vscode:
    cd vscode && bun run test:grammar

# test vscode lsp smoke suite
test-vscode-lsp:
    cd vscode && bun run test:lsp

# test zed extension and shared tree sitter overlays
test-zed:
    cd zed && cargo test --release
    cd zed && cargo build --target wasm32-wasip2 --release
    bun ../language/grammar/scripts/check-overlay.mjs

# test language bridges
test-language-bridges:
    just toolchain-ensure
    bash scripts/test-language-bridges.sh

# backwards compatibility aliases
alias install-language-bridge-toolchains := toolchain-install
alias language-bridge-toolchain-doctor := toolchain-doctor
alias ensure-language-bridge-toolchains := toolchain-ensure

# validate zed grammar references
check-zed-grammars:
    python3 zed/scripts/check_grammar_sources.py

# validate zed grammar references in strict release mode
check-zed-grammars-pinned:
    python3 zed/scripts/check_grammar_sources.py --require-pinned

# test the core ide integration surface
test-ide:
    just test-vscode
    just test-vscode-lsp
    just test-zed

# backward compatibility alias
alias test-editor := test-ide

# --- release ---

# publish npm sdk packages dry by default
publish-npm dry="--dry-run":
    cd napi && npm publish {{dry}} --access public
    cd wasm && npm publish {{dry}} --access public
    cd typescript && npm publish {{dry}} --access public
    cd typescript/aliases/destack-js && npm publish {{dry}} --access public
    cd typescript/aliases/destack-ts && npm publish {{dry}} --access public

# publish cargo sdk crate dry by default
publish-cargo dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cargo check -p destack_bridge_core -p destack; \
        cargo check --manifest-path rust/aliases/destack-rs/Cargo.toml; \
        (cd core && cargo package --allow-dirty --list >/dev/null); \
        (cd rust && cargo package --allow-dirty --list >/dev/null); \
        (cd rust/aliases/destack-rs && cargo package --allow-dirty --list >/dev/null); \
    else \
        if [ -z "${CARGO_TOKEN:-}" ]; then \
            echo "missing CARGO_TOKEN env var for live cargo publish"; \
            exit 1; \
        fi; \
        (cd core && cargo publish --token "${CARGO_TOKEN}"); \
        (cd rust && cargo publish --token "${CARGO_TOKEN}"); \
        (cd rust/aliases/destack-rs && cargo publish --token "${CARGO_TOKEN}"); \
    fi

# publish pypi package dry by default
publish-pypi dry="--dry-run":
    python3 -m venv .publish-python-venv
    .publish-python-venv/bin/python -m pip install --quiet --disable-pip-version-check build twine
    cd python && ../.publish-python-venv/bin/python -m build
    cd python && ../.publish-python-venv/bin/python -m twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" ../.publish-python-venv/bin/python -m twine upload --non-interactive dist/*; \
    fi
    cd python/aliases/destack-py && ../../../.publish-python-venv/bin/python -m build
    cd python/aliases/destack-py && ../../../.publish-python-venv/bin/python -m twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python legacy alias package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python/aliases/destack-py && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" ../../../.publish-python-venv/bin/python -m twine upload --non-interactive dist/*; \
    fi
    @if [ -d ".publish-python-venv" ]; then \
        rm -r .publish-python-venv; \
    fi
    @if [ -d "python/dist" ]; then \
        rm -r python/dist; \
    fi
    @if [ -d "python/aliases/destack-py/dist" ]; then \
        rm -r python/aliases/destack-py/dist; \
    fi

# publish nuget package dry by default
publish-nuget dry="--dry-run":
    #!/usr/bin/env bash
    set -euo pipefail

    # resolve dotnet executable
    dotnet_bin="$(command -v dotnet 2>/dev/null || true)"
    if [ -z "${dotnet_bin}" ] && [ -x "${HOME}/.dotnet/dotnet" ]; then
        dotnet_bin="${HOME}/.dotnet/dotnet"
    fi
    if [ -z "${dotnet_bin}" ]; then
        echo "missing dotnet command, run: just bridge/toolchain-ensure"
        exit 1
    fi

    # build the nuget package payload
    (cd dotnet && "${dotnet_bin}" pack -c Release --nologo src/Destack/Destack.csproj)

    # stop before upload in dry run mode
    if [ "{{dry}}" = "--dry-run" ]; then
        echo "Dry run: built and packed nuget package"
        exit 0
    fi

    # prefer oidc issued api keys when available
    nuget_api_key="${NUGET_OIDC_API_KEY:-${NUGET_API_KEY:-}}"
    if [ -z "${nuget_api_key}" ]; then
        echo "missing nuget publish key, set NUGET_OIDC_API_KEY or NUGET_API_KEY"
        exit 1
    fi

    # publish package and symbols package
    version="$(cat ../VERSION.txt)"
    nupkg_path="dotnet/src/Destack/bin/Release/Destack.${version}.nupkg"
    snupkg_path="dotnet/src/Destack/bin/Release/Destack.${version}.snupkg"
    "${dotnet_bin}" nuget push "${nupkg_path}" --source "https://api.nuget.org/v3/index.json" --api-key "${nuget_api_key}" --skip-duplicate
    if [ -f "${snupkg_path}" ]; then
        "${dotnet_bin}" nuget push "${snupkg_path}" --source "https://api.nuget.org/v3/index.json" --api-key "${nuget_api_key}" --skip-duplicate
    fi

# publish maven package dry by default
publish-maven dry="--dry-run":
    (cd java && mvn -q -DskipTests package)
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built java package"; \
    else \
        if [ -z "${MAVEN_REPOSITORY_USERNAME:-}" ]; then \
            echo "missing MAVEN_REPOSITORY_USERNAME env var for live maven publish"; \
            exit 1; \
        fi; \
        if [ -z "${MAVEN_REPOSITORY_PASSWORD:-}" ]; then \
            echo "missing MAVEN_REPOSITORY_PASSWORD env var for live maven publish"; \
            exit 1; \
        fi; \
        if [ -z "${MAVEN_GPG_KEY_ID:-}" ]; then \
            echo "missing MAVEN_GPG_KEY_ID env var for live maven publish"; \
            exit 1; \
        fi; \
        maven_gpg_private_key="${MAVEN_GPG_PRIVATE_KEY:-}"; \
        if [ -z "${maven_gpg_private_key}" ] && [ -n "${MAVEN_GPG_PRIVATE_KEY_FILE:-}" ]; then \
            if [ ! -f "${MAVEN_GPG_PRIVATE_KEY_FILE}" ]; then \
                echo "missing MAVEN_GPG_PRIVATE_KEY_FILE path: ${MAVEN_GPG_PRIVATE_KEY_FILE}"; \
                exit 1; \
            fi; \
            maven_gpg_private_key="$(cat "${MAVEN_GPG_PRIVATE_KEY_FILE}")"; \
        fi; \
        settings_path=".maven-settings.xml"; \
        printf '%s\n' \
            '<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">' \
            '  <servers>' \
            "    <server><id>central</id><username>${MAVEN_REPOSITORY_USERNAME}</username><password>${MAVEN_REPOSITORY_PASSWORD}</password></server>" \
            '  </servers>' \
            '</settings>' > "${settings_path}"; \
        if [ -n "${maven_gpg_private_key}" ]; then \
            printf '%s\n' "${maven_gpg_private_key}" | gpg --batch --import; \
        fi; \
        (cd java && mvn -q -DskipTests -P release-signing -Dgpg.keyname="${MAVEN_GPG_KEY_ID}" -Dgpg.passphrase="${MAVEN_GPG_PASSPHRASE:-}" --settings "../${settings_path}" deploy); \
        rm -f "${settings_path}"; \
    fi

# publish rubygems package dry by default
publish-rubygems dry="--dry-run":
    (cd ruby && gem build destack.gemspec >/dev/null)
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built ruby gem"; \
    else \
        if [ -z "${RUBYGEMS_API_KEY:-}" ] && [ ! -f "${HOME}/.gem/credentials" ]; then \
            echo "missing rubygems credentials, set RUBYGEMS_API_KEY or configure ~/.gem/credentials"; \
            exit 1; \
        fi; \
        version="$(cat ../VERSION.txt)"; \
        if [ -n "${RUBYGEMS_API_KEY:-}" ]; then \
            GEM_HOST_API_KEY="${RUBYGEMS_API_KEY}" gem push "ruby/destack-${version}.gem"; \
        else \
            gem push "ruby/destack-${version}.gem"; \
        fi; \
    fi
    @version="$(cat ../VERSION.txt)"; \
    if [ -f "ruby/destack-${version}.gem" ]; then \
        rm "ruby/destack-${version}.gem"; \
    fi

# publish hex package dry by default
publish-hex dry="--dry-run":
    (cd elixir && mix local.hex --force)
    @if [ "{{dry}}" = "--dry-run" ]; then \
        (cd elixir && mix hex.build); \
        echo "Dry run: built hex package"; \
    else \
        if [ -z "${HEX_API_KEY:-}" ]; then \
            echo "missing HEX_API_KEY env var for live hex publish"; \
            exit 1; \
        fi; \
        (cd elixir && HEX_API_KEY="${HEX_API_KEY}" mix hex.publish package --yes); \
    fi

# publish pub.dev package dry by default
publish-pub dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        (cd dart && dart pub publish --dry-run); \
    elif [ "${DESTACK_PUB_USE_OIDC:-0}" = "1" ]; then \
        (cd dart && dart pub publish --force); \
    else \
        pub_credentials_path=""; \
        if [ -n "${XDG_CONFIG_HOME:-}" ]; then \
            pub_credentials_path="${XDG_CONFIG_HOME}/dart/pub-credentials.json"; \
        else \
            pub_credentials_path="${HOME}/.config/dart/pub-credentials.json"; \
        fi; \
        if [ "$(uname -s)" = "Darwin" ]; then \
            pub_credentials_path="${HOME}/Library/Application Support/dart/pub-credentials.json"; \
        fi; \
        if [ -n "${PUB_DEV_CREDENTIALS_JSON:-}" ]; then \
            mkdir -p "$(dirname "${pub_credentials_path}")"; \
            printf '%s' "${PUB_DEV_CREDENTIALS_JSON}" > "${pub_credentials_path}"; \
        fi; \
        if [ ! -f "${pub_credentials_path}" ] && [ -f "${HOME}/.pub-cache/credentials.json" ]; then \
            pub_credentials_path="${HOME}/.pub-cache/credentials.json"; \
        fi; \
        if [ ! -f "${pub_credentials_path}" ]; then \
            echo "missing pub.dev credentials, set PUB_DEV_CREDENTIALS_JSON or run dart pub login"; \
            exit 1; \
        fi; \
        (cd dart && dart pub publish --force); \
    fi

# publish swift package dry by default
publish-swift dry="--dry-run":
    (cd swift && swift package describe >/dev/null)
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: validated swift package manifest"; \
    else \
        version="$(cat ../VERSION.txt)"; \
        echo "SwiftPM package publishing is tag based, push tag v${version} to publish"; \
    fi

