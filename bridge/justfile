set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

packages := "-p destack_zed"

_default:
    @just --list --unsorted

# --- setup ---

# validate supported bridge toolchains
install-toolchain:
    bash ../client/scripts/client-toolchain.sh install

# inspect supported bridge toolchains
doctor-toolchain:
    bash ../client/scripts/client-toolchain.sh doctor

# ensure supported bridge toolchains
ensure-toolchain:
    bash ../client/scripts/client-toolchain.sh ensure

# --- build ---

# build editor bridges
build:
    just build-vscode
    just build-zed

# build vscode extension
build-vscode:
    cd vscode && bun run package

# build zed extension
build-zed:
    cargo build --release --target wasm32-wasip2 {{ packages }}

# format code
format:
    cargo fmt {{ packages }}
    bun x biome format --write vscode

# check formatting
format-check:
    cargo fmt --check {{ packages }}
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false vscode

# alias for format
alias fmt := format

# run static checks
lint:
    cargo clippy --release --target wasm32-wasip2 {{ packages }}
    bun run --cwd vscode compile

# clean build artifacts
clean:
    rm -rf vscode/out vscode/*.vsix

# --- test ---

# run tests
test:
    just test-vscode
    just test-zed

# test vscode grammar
test-vscode:
    cd vscode && bun run test:grammar

# compile zed tree-sitter queries
test-zed:
    for query in zed/languages/ds/*.scm; do (cd ../language/grammar/destack && bun x tree-sitter query --quiet "../../../bridge/${query}" "../../test/fixtures/formatter/roundtrip/tree-idempotent-basic.ds") >/dev/null; done
    for query in zed/languages/dsm/*.scm; do (cd ../language/grammar/mir && bun x tree-sitter query --quiet "../../../bridge/${query}" "../../test/fixtures/grammar/mir/mir.txt") >/dev/null; done
    for query in zed/languages/dsa/*.scm; do (cd ../language/grammar/bytecode && bun x tree-sitter query --quiet "../../../bridge/${query}" "../../test/fixtures/grammar/bytecode/bytecode.txt") >/dev/null; done

# default check
check:
    just check-quick

# normal check
check-quick:
    just format-check
    just lint
    just test

# check distributable bridge artifacts
check-full:
    just check-quick
    just build

# --- release ---

# publish vscode extension dry by default
publish-vscode dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cd vscode && bun run package; \
        echo "Dry run: would publish vscode extension"; \
    else \
        if [ -z "${VSCE_PAT:-}" ]; then \
            echo "missing VSCE_PAT env var for live vscode publish"; \
            exit 1; \
        fi; \
        cd vscode && bun run publish:live; \
    fi

# publish zed extension registry update dry by default
publish-zed dry="--dry-run" version="":
    bash zed/scripts/create-registry-pr.sh "{{dry}}" "{{version}}"

# publish bridges dry by default
publish dry="--dry-run":
    just publish-vscode "{{dry}}"
    just publish-zed "{{dry}}"
