set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# selected crates
packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"
format-packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"
test-packages := "-p destack_bridge_core -p destack_capi -p destack_napi -p destack_wasm -p destack -p destack_python -p destack_zed"

_default:
    @just --list --unsorted

# --- setup ---

# validate supported toolchains
install-toolchain:
    bash scripts/language-bridge-toolchain.sh install

# inspect supported toolchains
doctor-toolchain:
    bash scripts/language-bridge-toolchain.sh doctor

# ensure supported toolchains
ensure-toolchain:
    bash scripts/language-bridge-toolchain.sh ensure

# --- build ---

# run static checks
lint:
    cargo clippy --release {{ packages }}
    bun x tsc --noEmit -p napi/tsconfig.json
    bun x tsc --noEmit -p wasm/tsconfig.json
    bun x tsc -p typescript/tsconfig.json
    bun x biome lint napi wasm typescript

# build packages
build:
    cargo build --release {{ packages }}
    just build-napi
    just build-wasm
    bun run --cwd typescript build
    just build-vscode
    just build-zed

# build napi package
build-napi:
    cargo build --release -p destack_napi
    bun run --cwd napi build

# build wasm package
build-wasm:
    cargo build --release -p destack_wasm
    bun run --cwd wasm build

# build vscode extension
build-vscode:
    cd vscode && bun run bundle && bun run package

# build zed extension
build-zed:
    cd zed && cargo check

# canonical wasm size analysis command
wasm-size:
    cd wasm && bun ./scripts/size-report.mjs

# format code
format:
    cargo fmt {{ format-packages }}
    bun x biome format --write napi wasm typescript

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false napi wasm typescript

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean
    rm -rf napi/node_modules wasm/node_modules typescript/node_modules
    rm -rf typescript/dist
    rm -rf vscode/out vscode/*.vsix
    rm -rf zed/grammars zed/extension.wasm

# --- test ---

# run tests
test:
    cargo test --release --all-targets {{ test-packages }}
    bun run --cwd napi test
    bun run --cwd wasm test
    bun run --cwd typescript test
    just test-vscode

# default check
check *args:
    just check-quick {{args}}

# normal check
check-quick *args:
    just format-check
    just lint
    just test
    just validate-zed-grammars-strict {{args}}

# check with slow suites
check-full *args:
    just check-quick {{args}}
    just test-language-bridges

# test vscode grammar
test-vscode:
    cd vscode && bun run test:grammar

# test supported clients
test-language-bridges:
    just ensure-toolchain
    bash scripts/test-language-bridges.sh

# validate zed grammar references
validate-zed-grammars *args:
    python3 zed/scripts/check_grammar_sources.py {{args}}

# validate zed grammar references strictly
validate-zed-grammars-strict *args:
    python3 zed/scripts/check_grammar_sources.py --require-pinned {{args}}

# --- release ---

# publish npm sdk packages dry by default
publish-npm dry="--dry-run":
    cd napi && npm publish {{dry}} --access public
    cd wasm && npm publish {{dry}} --access public
    cd typescript && npm publish {{dry}} --access public
    cd typescript/aliases/destack-js && npm publish {{dry}} --access public
    cd typescript/aliases/destack-ts && npm publish {{dry}} --access public

# publish cargo sdk crate dry by default
publish-cargo dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cargo check -p destack_bridge_core -p destack; \
        cargo check --manifest-path rust/aliases/destack-rs/Cargo.toml; \
        (cd core && cargo package --allow-dirty --list >/dev/null); \
        (cd rust && cargo package --allow-dirty --list >/dev/null); \
        (cd rust/aliases/destack-rs && cargo package --allow-dirty --list >/dev/null); \
    else \
        if [ -z "${CARGO_TOKEN:-}" ]; then \
            echo "missing CARGO_TOKEN env var for live cargo publish"; \
            exit 1; \
        fi; \
        (cd core && cargo publish --token "${CARGO_TOKEN}"); \
        (cd rust && cargo publish --token "${CARGO_TOKEN}"); \
        (cd rust/aliases/destack-rs && cargo publish --token "${CARGO_TOKEN}"); \
    fi

# publish pypi package dry by default
publish-pypi dry="--dry-run":
    python3 -m venv .publish-python-venv
    .publish-python-venv/bin/python -m pip install --quiet --disable-pip-version-check build twine
    cd python && ../.publish-python-venv/bin/python -m build
    cd python && ../.publish-python-venv/bin/python -m twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" ../.publish-python-venv/bin/python -m twine upload --non-interactive dist/*; \
    fi
    cd python/aliases/destack-py && ../../../.publish-python-venv/bin/python -m build
    cd python/aliases/destack-py && ../../../.publish-python-venv/bin/python -m twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python legacy alias package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python/aliases/destack-py && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" ../../../.publish-python-venv/bin/python -m twine upload --non-interactive dist/*; \
    fi
    @if [ -d ".publish-python-venv" ]; then \
        rm -r .publish-python-venv; \
    fi
    @if [ -d "python/dist" ]; then \
        rm -r python/dist; \
    fi
    @if [ -d "python/aliases/destack-py/dist" ]; then \
        rm -r python/aliases/destack-py/dist; \
    fi

# publish vscode extension dry by default
publish-vscode dry="--dry-run":
    cd vscode && bun run package
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: would publish vscode extension"; \
    else \
        if [ -z "${VSCE_PAT:-}" ]; then \
            echo "missing VSCE_PAT env var for live vscode publish"; \
            exit 1; \
        fi; \
        cd vscode && bunx --bun @vscode/vsce@latest publish; \
    fi

# publish zed extension registry update dry by default
publish-zed dry="--dry-run" version="":
    bash zed/scripts/create-registry-pr.sh "{{dry}}" "{{version}}"

# publish packages dry by default
publish dry="--dry-run":
    just publish-npm "{{dry}}"
    just publish-cargo "{{dry}}"
    just publish-pypi "{{dry}}"
    just publish-vscode "{{dry}}"
