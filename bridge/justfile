set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

packages := "-p destack_zed"

_default:
    @just --list --unsorted

# --- build ---

# build
build:
    just build-vscode
    just build-zed

# build vscode
build-vscode:
    cd vscode && deno task package

# build zed
build-zed:
    cargo build --release --target wasm32-wasip2 {{ packages }}

# format
format:
    cargo fmt {{ packages }}
    deno run -A npm:@biomejs/biome format --write vscode

# check formatting
format-check:
    cargo fmt --check {{ packages }}
    deno run -A npm:@biomejs/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false vscode

# format
alias fmt := format

# lint
lint:
    cargo clippy --release --target wasm32-wasip2 {{ packages }}
    deno task --cwd vscode compile

# clean
clean:
    rm -rf vscode/out vscode/*.vsix

# --- test ---

# test
test:
    just test-vscode
    just test-zed

# test vscode
test-vscode:
    cd vscode && deno task test:grammar

# test zed
test-zed:
    for query in zed/languages/ds/*.scm; do (cd ../language/grammar/destack && deno run -A npm:tree-sitter-cli query --quiet "../../../bridge/${query}" "../../formatter/fixture/roundtrip/tree-idempotent-basic.ds") >/dev/null || exit 1; done
    for query in zed/languages/dsm/*.scm; do (cd ../language/grammar/mir && deno run -A npm:tree-sitter-cli query --quiet "../../../bridge/${query}" "../../../bridge/fixture/highlight/mir/mir.txt") >/dev/null || exit 1; done
    for query in zed/languages/dsa/*.scm; do (cd ../language/grammar/bytecode && deno run -A npm:tree-sitter-cli query --quiet "../../../bridge/${query}" "../../../bridge/fixture/highlight/bytecode/bytecode.txt") >/dev/null || exit 1; done

# check
check:
    just check-quick

# check quick
check-quick:
    just format-check
    just lint
    just test

# check full
check-full:
    just check-quick
    just build

# --- release ---

# publish vscode
publish-vscode dry="--dry-run" prerelease="":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cd vscode && deno task package; \
        echo "Dry run: would publish vscode extension"; \
    else \
        if [ -z "${VSCE_PAT:-}" ]; then \
            echo "missing VSCE_PAT env var for live vscode publish"; \
            exit 1; \
        fi; \
        prerelease="{{prerelease}}"; \
        stability="$(node -p 'JSON.parse(require("node:fs").readFileSync("../dev/release/config.json", "utf8")).stability')"; \
        if [ -z "${prerelease}" ] && [ "${stability}" != "stable" ]; then \
            prerelease="--pre-release"; \
        fi; \
        cd vscode && deno run -A npm:@vscode/vsce publish --no-dependencies ${prerelease}; \
    fi

# publish zed
publish-zed dry="--dry-run" version="":
    bash zed/scripts/create-registry-pr.sh "{{dry}}" "{{version}}"

# publish
publish dry="--dry-run" prerelease="":
    just publish-vscode "{{dry}}" "{{prerelease}}"
    just publish-zed "{{dry}}"
