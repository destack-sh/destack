set shell := ["bash", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

# all bridge crates
packages := "-p destack_napi -p destack_wasm -p destack -p destack_python -p destack_vscode -p destack_zed"
format-packages := "-p destack_napi -p destack_wasm -p destack -p destack_python -p destack_vscode -p destack_zed"
test-packages := "-p destack_napi -p destack_wasm -p destack -p destack_python -p destack_vscode -p destack_zed"

_default:
    @just --list --unsorted

# --- ci ---

# install js dependencies required by bridge gates
ci-install:
    bun install --frozen-lockfile

# run bridge format gate
ci-format:
    just format-check

# run bridge lint gate
ci-lint:
    just lint

# run bridge test gate
ci-tests:
    just test-ci

# run all blocking bridge ci gates locally
ci:
    just ci-install
    just ci-format
    just ci-lint
    just ci-tests

# --- build ---

# check bridge crates and typescript bridge packages
check:
    cargo clippy --release {{ packages }}
    bun x tsc --noEmit -p napi/tsconfig.json
    bun x tsc --noEmit -p wasm/tsconfig.json
    bun x tsc -p typescript/tsconfig.json
    bun run biome lint napi wasm typescript

# lint alias
lint:
    just check

# build all bridge packages
build:
    cargo build --release {{ packages }}
    bun run --cwd napi build
    bun run --cwd wasm build
    bun run --cwd typescript build
    just build-vscode
    just build-zed

# build napi package
napi:
    cargo build --release -p destack_napi
    bun run --cwd napi build

# build wasm package
wasm:
    cargo build --release -p destack_wasm
    bun run --cwd wasm build

# build vscode extension
build-vscode:
    cd vscode && bun run bundle && bun run package

# build zed extension
build-zed:
    cd zed && cargo check

# canonical wasm size analysis command
wasm-size:
    cd wasm && bun ./scripts/size-report.mjs

# canonical wasm size analysis command without rebuilding
wasm-size-no-build:
    cd wasm && bun ./scripts/size-report.mjs

# analyze one preset with canonical size report settings
wasm-size-preset preset="core":
    cd wasm && bun ./scripts/size-report.mjs

# format code
format:
    cargo fmt {{ format-packages }}
    bun run biome format --write napi wasm typescript

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}
    bun run biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false napi wasm typescript

# alias for format
alias fmt := format

# clean build artifacts
clean:
    cargo clean
    rm -rf napi/node_modules wasm/node_modules typescript/node_modules
    rm -rf typescript/dist
    rm -rf vscode/out vscode/*.vsix
    rm -rf zed/grammars zed/extension.wasm

# --- test ---

# run quick tests for local development
test-quick:
    cargo test --release --all-targets {{ test-packages }}
    bun run --cwd napi test
    bun run --cwd wasm test
    bun run --cwd typescript test
    just test-vscode
    just test-zed

# run blocking ci test gates
test-ci:
    just test-quick
    just check-zed-grammars

# run nightly test gates
test-nightly:
    just test-ci
    just test-vscode-host

# run release test gates
test-release:
    just test-ci

# run quick tests alias
test:
    just test-quick

# test vscode grammar
test-vscode:
    cd vscode && bun run test:grammar

# test vscode extension host smoke suite
test-vscode-host:
    cd vscode && bun run test:host

# test zed extension and shared tree sitter overlays
test-zed:
    cd zed && cargo test --release
    cd zed && cargo build --target wasm32-wasip2 --release
    bun ../language/grammar/scripts/check-overlay.mjs

# validate zed grammar references
check-zed-grammars:
    python3 zed/scripts/check_grammar_sources.py

# validate zed grammar references in strict release mode
check-zed-grammars-pinned:
    python3 zed/scripts/check_grammar_sources.py --require-pinned

# test the core ide integration surface
test-ide:
    just test-vscode
    just test-vscode-host
    just test-zed

# backward compatibility alias
alias test-editor := test-ide

# --- release ---

# publish npm sdk packages dry by default
publish-npm dry="--dry-run":
    cd napi && npm publish {{dry}} --access public
    cd wasm && npm publish {{dry}} --access public
    cd typescript && npm publish {{dry}} --access public

# publish cargo sdk crate dry by default
publish-cargo dry="--dry-run":
    @if [ "{{dry}}" = "--dry-run" ]; then \
        cd rust && cargo publish --dry-run --allow-dirty; \
    else \
        if [ -z "${CARGO_TOKEN:-}" ]; then \
            echo "missing CARGO_TOKEN env var for live cargo publish"; \
            exit 1; \
        fi; \
        cd rust && cargo publish --token "${CARGO_TOKEN}"; \
    fi

# publish pypi package dry by default
publish-pypi dry="--dry-run":
    python3 -m venv .publish-python-venv
    .publish-python-venv/bin/python -m pip install --quiet --disable-pip-version-check build twine
    cd python && ../.publish-python-venv/bin/python -m build
    cd python && ../.publish-python-venv/bin/python -m twine check dist/*
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: built and validated python package"; \
    else \
        if [ -z "${PYPI_TOKEN:-}" ]; then \
            echo "missing PYPI_TOKEN env var for live pypi publish"; \
            exit 1; \
        fi; \
        cd python && TWINE_USERNAME="__token__" TWINE_PASSWORD="${PYPI_TOKEN}" ../.publish-python-venv/bin/python -m twine upload --non-interactive dist/*; \
    fi
    @if [ -d ".publish-python-venv" ]; then \
        rm -r .publish-python-venv; \
    fi
    @if [ -d "python/dist" ]; then \
        rm -r python/dist; \
    fi

# publish bun bridge package dry by default
publish-bun dry="--dry-run":
    cd bun && npm publish {{dry}} --access public

# publish vite bridge package dry by default
publish-vite dry="--dry-run":
    cd vite && npm publish {{dry}} --access public

# publish vscode extension dry by default
publish-vscode dry="--dry-run":
    cd vscode && bun run package
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: would publish vscode extension"; \
    else \
        if [ -z "${VSCE_PAT:-}" ]; then \
            echo "missing VSCE_PAT env var for live vscode publish"; \
            exit 1; \
        fi; \
        cd vscode && bunx --bun @vscode/vsce@latest publish; \
    fi

# publish zed extension registry update dry by default
publish-zed dry="--dry-run" version="":
    bash zed/scripts/create-registry-pr.sh "{{dry}}" "{{version}}"

# publish all bridge packages dry by default
publish dry="--dry-run":
    just publish-npm "{{dry}}"
    just publish-cargo "{{dry}}"
    just publish-pypi "{{dry}}"
    just publish-bun "{{dry}}"
    just publish-vite "{{dry}}"
    just publish-vscode "{{dry}}"
