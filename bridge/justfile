set shell := ["bash", "-cu"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-cu"]
set dotenv-load := true
set dotenv-filename := "../.env.local"

packages := "-p destack_zed"
format-packages := "-p destack_zed"
test-packages := "-p destack_zed"

_default:
    @just --list --unsorted

# --- setup ---

# validate supported bridge toolchains
install-toolchain:
    bash ../client/scripts/client-toolchain.sh install

# inspect supported bridge toolchains
doctor-toolchain:
    bash ../client/scripts/client-toolchain.sh doctor

# ensure supported bridge toolchains
ensure-toolchain:
    bash ../client/scripts/client-toolchain.sh ensure

# --- build ---

# build editor bridges
build:
    just build-vscode
    just build-zed

# build vscode extension
build-vscode:
    cd vscode && bun run bundle && bun run package

# build zed extension
build-zed:
    cd zed && cargo check

# format code
format:
    cargo fmt {{ format-packages }}
    bun x biome format --write vscode

# check formatting
format-check:
    cargo fmt --check {{ format-packages }}
    bun x biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false vscode

# alias for format
alias fmt := format

# run static checks
lint:
    cargo clippy --release {{ packages }}
    bun run --cwd vscode compile
    just validate-zed-grammar

# clean build artifacts
clean:
    rm -rf vscode/out vscode/*.vsix
    rm -rf zed/grammars zed/extension.wasm

# --- test ---

# run tests
test:
    cargo test --release --all-targets {{ test-packages }}
    just test-vscode

# test vscode grammar
test-vscode:
    cd vscode && bun run test:grammar

# default check
check *args:
    just check-quick {{args}}

# normal check
check-quick *args:
    just format-check
    just lint
    just test
    just validate-zed-grammar-strict {{args}}

# check with slow suites
check-full *args:
    just check-quick {{args}}

# validate zed grammar references
validate-zed-grammar *args:
    python3 zed/scripts/check_grammar_sources.py {{args}}

# validate zed grammar references strictly
validate-zed-grammar-strict *args:
    python3 zed/scripts/check_grammar_sources.py --require-pinned {{args}}

# --- release ---

# publish vscode extension dry by default
publish-vscode dry="--dry-run":
    cd vscode && bun run package
    @if [ "{{dry}}" = "--dry-run" ]; then \
        echo "Dry run: would publish vscode extension"; \
    else \
        if [ -z "${VSCE_PAT:-}" ]; then \
            echo "missing VSCE_PAT env var for live vscode publish"; \
            exit 1; \
        fi; \
        cd vscode && bunx --bun @vscode/vsce@latest publish; \
    fi

# publish zed extension registry update dry by default
publish-zed dry="--dry-run" version="":
    bash zed/scripts/create-registry-pr.sh "{{dry}}" "{{version}}"

# publish bridges dry by default
publish dry="--dry-run":
    just publish-vscode "{{dry}}"
