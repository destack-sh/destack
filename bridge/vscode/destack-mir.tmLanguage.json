{
  "name": "Destack MIR",
  "scopeName": "source.dsmir",
  "fileTypes": [
    "mir"
  ],
  "patterns": [
    {
      "include": "#mir"
    }
  ],
  "repository": {
    "mir": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#block-label"
        },
        {
          "include": "#block-reference"
        },
        {
          "include": "#type"
        },
        {
          "include": "#instruction"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#boolean"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dsmir",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dsmir",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.dsmir"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.dsmir"
            }
          }
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.definition.dsmir",
          "match": "(?x)\\b(function)\\s+([A-Za-z_][\\w.#]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.dsmir"
            },
            "2": {
              "name": "entity.name.function.dsmir"
            }
          }
        }
      ]
    },
    "block-label": {
      "patterns": [
        {
          "name": "meta.block.label.dsmir",
          "begin": "(?m)^([A-Za-z_][\\w.#]*)(?=\\s*(?:\\([^\\n)]*\\))?:)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.label.dsmir"
            }
          },
          "end": ":(?=\\s*$)",
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "include": "#type"
            },
            {
              "include": "#number"
            }
          ]
        }
      ]
    },
    "block-reference": {
      "patterns": [
        {
          "name": "entity.name.label.dsmir",
          "match": "\\b(?:bb|block|entry|b)\\d+\\b"
        }
      ]
    },
    "instruction": {
      "patterns": [
        {
          "name": "keyword.operator.instruction.dsmir",
          "match": "\\b(local\\.set|local\\.get|local\\.address|function\\.address|callable\\.environment|global\\.address|store|load|drop|free|pin|unpin|raw\\.drop|stack\\.drop|assume|tensor\\.store|tensor\\.fill|tensor\\.copy|call(?:\\.(?:interface|indirect|class|dynamic))?|tailCall(?:\\.(?:interface|indirect|class|virtual))?|raw\\.alloc|raw\\.free|intrinsic\\.[A-Za-z_][A-Za-z0-9_.]*)\\b"
        },
        {
          "name": "keyword.operator.instruction.dsmir",
          "match": "(?x)(?<=\\=\\s)[A-Za-z_][A-Za-z0-9_.]*"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.flow.dsmir",
          "match": "\\b(?:return|jump|branch|switch|yield|check|panic\\.resume|panic|trap\\.abort|unreachable)\\b"
        },
        {
          "name": "keyword.declaration.dsmir",
          "match": "\\b(?:external|export|global|type|block|local)\\b"
        },
        {
          "name": "keyword.operator.arrow.dsmir",
          "match": "->"
        },
        {
          "name": "keyword.other.memory.dsmir",
          "match": "\\b(?:managed|borrowed|owned|raw|unique|copy|readonly|const|nullable|undefined|nullish|exclusive)\\b"
        },
        {
          "name": "keyword.declaration.function.dsmir",
          "match": "\\bfunction\\b"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "name": "entity.name.symbol.dsmir",
          "match": "@[A-Za-z_][\\w.]*"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "entity.name.function.dsmir",
          "match": "\\bfunction\\d+\\b"
        },
        {
          "name": "variable.other.local.dsmir",
          "match": "\\blocal\\d+\\b"
        },
        {
          "name": "variable.other.ssa.dsmir",
          "match": "\\bv\\d+\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.dsmir",
          "match": "\\b(?:(?:int|uint)(?:8|16|32|64|128|256)|float(?:32|64)|boolean|void|isize|usize|typeDescriptor|typeId|ref|slice|tensorView|tensor|vector|space|struct|newtype|atomic|variant|any)\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.dsmir",
          "match": "(?x)(?<![A-Za-z0-9_])[+-]?\\d+(?:_\\d+)*(?:\\.(?:\\d[\\d_]*))?(?:[eE][+-]?\\d[\\d_]*)?(?:(?:int|uint|float)\\d+)?\\b"
        }
      ]
    },
    "boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.dsmir",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.dsmir",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dsmir"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dsmir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dsmir",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.quoted.single.dsmir",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.character.begin.dsmir"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.character.end.dsmir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dsmir",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  }
}
