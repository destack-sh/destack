{
  "name": "Destack MIR",
  "scopeName": "source.dsmir",
  "fileTypes": [
    "mir"
  ],
  "patterns": [
    {
      "include": "#mir"
    }
  ],
  "repository": {
    "mir": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#block-label"
        },
        {
          "include": "#block-reference"
        },
        {
          "include": "#instruction"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#type"
        },
        {
          "include": "#number"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dsmir",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dsmir",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.dsmir"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.dsmir"
            }
          }
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.definition.dsmir",
          "match": "(?x)\\b(function)\\s+([A-Za-z_][\\w.#]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.dsmir"
            },
            "2": {
              "name": "entity.name.function.dsmir"
            }
          }
        }
      ]
    },
    "block-label": {
      "patterns": [
        {
          "name": "meta.block.label.dsmir",
          "begin": "(?m)^([A-Za-z_][\\w.#]*)(?=\\s*(?:\\([^\\n)]*\\))?:)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.label.dsmir"
            }
          },
          "end": ":(?=\\s*$)",
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "include": "#type"
            },
            {
              "include": "#number"
            }
          ]
        }
      ]
    },
    "block-reference": {
      "patterns": [
        {
          "name": "entity.name.label.dsmir",
          "match": "\\b(?:bb|block|entry|b)\\d+\\b"
        }
      ]
    },
    "instruction": {
      "patterns": [
        {
          "name": "keyword.operator.instruction.dsmir",
          "match": "\\b(local\\.set|store|raw\\.drop|stack\\.drop|assume|tensor\\.store|tensor\\.fill|tensor\\.copy|call(?:\\.(?:virtual|interface|indirect))?|invoke(?:\\.(?:virtual|interface|indirect))?|tailCall(?:\\.(?:virtual|interface|indirect))?|trap\\.(?:abort|panic)|raw\\.free|intrinsic\\.[A-Za-z_][A-Za-z0-9_.]*)\\b"
        },
        {
          "name": "keyword.operator.instruction.dsmir",
          "match": "(?x)(?<=\\=\\s)[A-Za-z_][A-Za-z0-9_.]*"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.flow.dsmir",
          "match": "\\b(?:return|jump|branch|switch|yield|check|throw|catch|unreachable)\\b"
        },
        {
          "name": "keyword.operator.arrow.dsmir",
          "match": "->"
        },
        {
          "name": "keyword.other.memory.dsmir",
          "match": "\\b(?:managed|borrowed|owned|raw|readonly)\\b"
        },
        {
          "name": "keyword.declaration.function.dsmir",
          "match": "\\bfunction\\b"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "name": "entity.name.symbol.dsmir",
          "match": "@[A-Za-z_][\\w.]*"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.other.ssa.dsmir",
          "match": "\\bv\\d+\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.dsmir",
          "match": "\\b(?:i\\d+|u\\d+|f\\d+|int\\d+|uint\\d+|float\\d+|boolean|void|isize|usize|typeDescriptor|typeId|ref\\??|slice|tensorRef\\??|tensor|vector|fn|closure|addressSpace)\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.dsmir",
          "match": "(?x)(?<![A-Za-z0-9_])[+-]?\\d+(?:_\\d+)*(?:\\.(?:\\d[\\d_]*))?(?:[eE][+-]?\\d[\\d_]*)?(?:(?:int|uint|float)\\d+)?\\b"
        }
      ]
    }
  }
}
