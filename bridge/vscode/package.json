{
    "name": "destack",
    "displayName": "Destack",
    "description": "Destack language and toolchain support for VS Code",
    "version": "0.55.4",
    "license": "MIT",
    "engines": {
        "vscode": "^1.125.0"
    },
    "publisher": "symbol-industries",
    "author": {
        "name": "Florian C\u00e4sar",
        "email": "florian@symbol.industries"
    },
    "categories": [
        "Formatters",
        "Programming Languages"
    ],
    "repository": {
        "type": "web",
        "url": "https://github.com/destack-sh/destack.git"
    },
    "homepage": "https://destack.sh",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "activationEvents": [
        "onLanguage:destack",
        "workspaceContains:destack.json"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Language support remains available through an installed or managed Destack toolchain. Workspace commands and workspace-built toolchains require trust.",
            "restrictedConfigurations": [
                "destack.server.command",
                "destack.server.args",
                "destack.server.cwd"
            ]
        }
    },
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "destack-ds.json",
        "destack-ds.tmLanguage.json",
        "destack-dsm.json",
        "destack-dsm.tmLanguage.json",
        "destack-dsa.json",
        "destack-dsa.tmLanguage.json",
        "destack.schema.json",
        "package.json",
        "LICENSE.txt"
    ],
    "contributes": {
        "configuration": {
            "title": "Destack",
            "properties": {
                "destack.server.command": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Command for the Destack language server. If empty, uses a workspace build, an installed `destack`, or the release matching this extension. Supports `~` and `${workspaceFolder}`."
                },
                "destack.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional arguments passed to the language server."
                },
                "destack.server.cwd": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory for the language server. Supports `~` and `${workspaceFolder}`."
                },
                "destack.completion.autoImports": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Include auto import completions in the completion list."
                },
                "destack.inlayHints.parameterHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show parameter name inlay hints for call arguments."
                },
                "destack.inlayHints.typeHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show inferred type inlay hints for local bindings."
                }
            }
        },
        "commands": [
            {
                "command": "destack.restart",
                "title": "Destack: Restart Server"
            },
            {
                "command": "destack.reload",
                "title": "Destack: Reload Workspace"
            },
            {
                "command": "destack.showLogs",
                "title": "Destack: Show Logs"
            }
        ],
        "languages": [
            {
                "id": "destack",
                "aliases": [
                    "Destack",
                    "ds"
                ],
                "extensions": [
                    ".ds",
                    ".d.ds"
                ],
                "configuration": "./destack-ds.json"
            },
            {
                "id": "destack-mir",
                "aliases": [
                    "Destack MIR",
                    "dsm"
                ],
                "extensions": [
                    ".dsm"
                ],
                "configuration": "./destack-dsm.json"
            },
            {
                "id": "destack-bytecode",
                "aliases": [
                    "Destack Bytecode Assembly",
                    "dsa"
                ],
                "extensions": [
                    ".dsa"
                ],
                "configuration": "./destack-dsa.json"
            }
        ],
        "grammars": [
            {
                "language": "destack",
                "scopeName": "source.ds",
                "path": "./destack-ds.tmLanguage.json"
            },
            {
                "language": "destack-mir",
                "scopeName": "source.dsm",
                "path": "./destack-dsm.tmLanguage.json"
            },
            {
                "language": "destack-bytecode",
                "scopeName": "source.dsa",
                "path": "./destack-dsa.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "namespace": [
                        "entity.name.namespace.ds"
                    ],
                    "type": [
                        "entity.name.type.ds"
                    ],
                    "class": [
                        "entity.name.type.class.ds",
                        "entity.name.type.ds"
                    ],
                    "enum": [
                        "entity.name.type.enum.ds",
                        "entity.name.type.ds"
                    ],
                    "interface": [
                        "entity.name.type.interface.ds",
                        "entity.name.type.ds"
                    ],
                    "struct": [
                        "entity.name.type.struct.ds",
                        "entity.name.type.ds"
                    ],
                    "typeParameter": [
                        "entity.name.type.parameter.ds"
                    ],
                    "parameter": [
                        "variable.parameter.ds",
                        "variable.other.binding.ds"
                    ],
                    "variable": [
                        "variable.other.binding.ds"
                    ],
                    "variable.readonly": [
                        "variable.other.binding.readonly.ds",
                        "variable.other.binding.ds"
                    ],
                    "property": [
                        "variable.other.property.ds"
                    ],
                    "property.readonly": [
                        "variable.other.property.readonly.ds",
                        "variable.other.property.ds"
                    ],
                    "enumMember": [
                        "variable.other.member.ds",
                        "variable.other.property.ds"
                    ],
                    "function": [
                        "entity.name.function.ds"
                    ],
                    "method": [
                        "entity.name.function.member.ds",
                        "entity.name.function.ds"
                    ],
                    "comment": [
                        "comment.ds"
                    ],
                    "decorator": [
                        "entity.name.type.decorator.ds"
                    ]
                }
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    "destack.json",
                    "*.destack.json"
                ],
                "url": "./destack.schema.json"
            }
        ]
    },
    "scripts": {
        "compile": "tsc --noEmit",
        "bundle": "bun x esbuild src/extension/index.ts --bundle --platform=node --format=cjs --legal-comments=none --minify --outfile=out/extension.js --external:vscode",
        "vscode:prepublish": "bun run compile && bun run bundle",
        "package": "bun x vsce package --no-dependencies",
        "publish:live": "bun x vsce publish --no-dependencies",
        "test:grammar": "bun x vscode-tmgrammar-test --grammar destack-ds.tmLanguage.json \"../../language/test/fixtures/grammar/destack/**/*.txt\" && bun x vscode-tmgrammar-test --grammar destack-dsm.tmLanguage.json \"../../language/test/fixtures/grammar/mir/*.txt\" && bun x vscode-tmgrammar-test --grammar destack-dsa.tmLanguage.json \"../../language/test/fixtures/grammar/bytecode/*.txt\""
    },
    "dependencies": {
        "extract-zip": "^2.0.1",
        "tar": "^7.5.19",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.125.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
