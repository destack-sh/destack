{
    "name": "destack",
    "displayName": "Destack",
    "description": "Destack for VSCode (.ds, .d.ds, .mir)",
    "version": "0.55.4",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "publisher": "symbol-industries",
    "author": {
        "name": "Florian C\u00e4sar",
        "email": "florian@symbol.industries"
    },
    "categories": [
        "AI",
        "Debuggers",
        "Formatters",
        "Language Packs",
        "Languages",
        "Linters",
        "Programming Languages",
        "Testing",
        "Visualization"
    ],
    "repository": {
        "type": "web",
        "url": "https://destack.sh"
    },
    "activationEvents": [
        "onLanguage:destack",
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:typescript",
        "onLanguage:typescriptreact",
        "onLanguage:destack-mir",
        "workspaceContains:destack.json"
    ],
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "destack.json",
        "destack.tmLanguage.json",
        "destack-mir.tmLanguage.json",
        "destack-mir.json",
        "destack.schema.json",
        "package.json",
        "LICENSE.txt"
    ],
    "contributes": {
        "configuration": {
            "title": "Destack",
            "properties": {
                "destack.server.command": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Command for the Destack LSP. If empty, prefers a workspace-built binary (`target/release/destack` or `target/debug/destack`), then tries `destack`, `ds`, or `dsc` on PATH. Supports `~` and `${workspaceFolder}`."
                },
                "destack.server.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional arguments to pass to the language server."
                },
                "destack.server.cwd": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Working directory for the language server. Supports `~` and `${workspaceFolder}`."
                },
                "destack.completion.autoImports": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Include auto import completions in the completion list."
                },
                "destack.inlayHints.parameterHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show parameter name inlay hints for call arguments."
                },
                "destack.inlayHints.typeHints": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show inferred type inlay hints for local bindings."
                }
            }
        },
        "commands": [
            {
                "command": "destack.restart",
                "title": "Destack: Restart Server"
            },
            {
                "command": "destack.rescan",
                "title": "Destack: Rescan Workspace"
            },
            {
                "command": "destack.reindex",
                "title": "Destack: Reindex Workspace"
            },
            {
                "command": "destack.clearCache",
                "title": "Destack: Clear Cache"
            },
            {
                "command": "destack.showClientLogs",
                "title": "Destack: Show Client Logs"
            },
            {
                "command": "destack.showServerLogs",
                "title": "Destack: Show Server Logs"
            }
        ],
        "languages": [
            {
                "id": "destack",
                "aliases": [
                    "Destack",
                    "ds"
                ],
                "extensions": [
                    ".ds",
                    ".d.ds"
                ],
                "configuration": "./destack.json"
            },
            {
                "id": "destack-mir",
                "aliases": [
                    "Destack MIR"
                ],
                "extensions": [
                    ".mir"
                ],
                "configuration": "./destack-mir.json"
            }
        ],
        "grammars": [
            {
                "language": "destack",
                "scopeName": "source.ds",
                "path": "./destack.tmLanguage.json"
            },
            {
                "language": "destack-mir",
                "scopeName": "source.dsmir",
                "path": "./destack-mir.tmLanguage.json"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "mutable",
                "description": "A mutable declaration or reference."
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "namespace": [
                        "entity.name.namespace.ds"
                    ],
                    "type": [
                        "entity.name.type.ds"
                    ],
                    "class": [
                        "entity.name.type.class.ds",
                        "entity.name.type.ds"
                    ],
                    "enum": [
                        "entity.name.type.enum.ds",
                        "entity.name.type.ds"
                    ],
                    "interface": [
                        "entity.name.type.interface.ds",
                        "entity.name.type.ds"
                    ],
                    "struct": [
                        "entity.name.type.struct.ds",
                        "entity.name.type.ds"
                    ],
                    "typeParameter": [
                        "entity.name.type.parameter.ds"
                    ],
                    "parameter": [
                        "variable.parameter.ds",
                        "variable.other.binding.ds"
                    ],
                    "variable": [
                        "variable.other.binding.ds"
                    ],
                    "variable.readonly": [
                        "variable.other.binding.readonly.ds",
                        "variable.other.binding.ds"
                    ],
                    "variable.mutable": [
                        "variable.other.binding.mutable.ds",
                        "variable.other.binding.ds"
                    ],
                    "property": [
                        "variable.other.property.ds"
                    ],
                    "property.readonly": [
                        "variable.other.property.readonly.ds",
                        "variable.other.property.ds"
                    ],
                    "enumMember": [
                        "variable.other.member.ds",
                        "variable.other.property.ds"
                    ],
                    "function": [
                        "entity.name.function.ds"
                    ],
                    "method": [
                        "entity.name.function.member.ds",
                        "entity.name.function.ds"
                    ],
                    "macro": [
                        "entity.name.function.ds"
                    ],
                    "keyword": [
                        "keyword.ds"
                    ],
                    "modifier": [
                        "keyword.other.modifier.ds"
                    ],
                    "comment": [
                        "comment.ds"
                    ],
                    "string": [
                        "string.quoted.double.ds",
                        "string.quoted.single.ds"
                    ],
                    "number": [
                        "constant.numeric.ds"
                    ],
                    "regexp": [
                        "string.regexp.ds"
                    ],
                    "operator": [
                        "keyword.operator.ds"
                    ],
                    "decorator": [
                        "entity.name.type.decorator.ds"
                    ]
                }
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    "destack.json",
                    "*.destack.json"
                ],
                "url": "./destack.schema.json"
            }
        ]
    },
    "scripts": {
        "bundle": "bun x esbuild src/extension/index.ts --bundle --platform=node --format=cjs --legal-comments=none --minify --outfile=out/extension.js --external:vscode",
        "vscode:prepublish": "bun install --no-save --ignore-scripts && bun run bundle",
        "package": "bun x vsce package --no-dependencies",
        "publish:live": "bun x vsce publish",
        "check:grammar": "node scripts/check-grammar.mjs",
        "test:grammar": "node scripts/check-grammar.mjs && bun x vscode-tmgrammar-test --grammar destack.tmLanguage.json \"src/tests-grammar/*.txt\" && bun x vscode-tmgrammar-test --grammar destack-mir.tmLanguage.json \"src/tests-grammar-mir/*.txt\"",
        "test:bridge:build": "node -e \"require('fs').rmSync('out-tests',{recursive:true,force:true})\" && bun run bundle && bun x tsc -p tsconfig.tests.json",
        "test:bridge": "bun run test:bridge:build && node out-tests/tests-bridge/run.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.11.25",
        "@types/vscode": "^1.90.0",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.25.9",
        "mocha": "^11.7.4",
        "typescript": "~5.9.3",
        "vsce": "^2.15.0",
        "vscode": "^1.1.37",
        "vscode-languageclient": "^9.0.1",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
