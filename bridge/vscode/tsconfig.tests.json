{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "out-tests",
        "lib": ["es2020"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noEmit": false,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "mocha", "vscode"]
    },
    "include": ["src/tests-bridge/**/*.ts"]
}
