{
    "name": "@destack/napi",
    "version": "0.55.4",
    "description": "Node-API bindings for Destack",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/destack-sh/destack.git",
        "directory": "bridge/napi"
    },
    "homepage": "https://github.com/destack-sh/destack/tree/main/bridge/napi",
    "bugs": {
        "url": "https://github.com/destack-sh/destack/issues"
    },
    "keywords": [
        "destack",
        "napi",
        "bindings",
        "typescript"
    ],
    "files": [
        "src",
        "README.md",
        "Cargo.toml",
        "tsconfig.json"
    ],
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "sideEffects": false,
    "scripts": {
        "build": "bun x tsc --noEmit -p tsconfig.json",
        "test": "bun x tsc --noEmit -p tsconfig.json",
        "prepublishOnly": "bun run build",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:live": "npm publish --access public"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {},
    "devDependencies": {
        "typescript": "5.9.3"
    }
}
