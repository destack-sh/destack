use destack::*;

/// A Star is a relationship between an Actor and a starred Node.
@entity
struct Star {}

/// Base Star event.
@event
struct StarEvent {
    /// The Star this event pertains to.
    star: EntityReference<Star>,
}

/// Star added.
@event(StarEvent)
struct StarAddedEvent {}

/// Star removed.
@event(StarEvent)
struct StarRemovedEvent {}


