use destack::*;

/// The type of a Snapshot.
enum SnapshotType { 
    Full = 10, 
    Root = 11 
}

/// The status of a Snapshot.
enum SnapshotStatus { 
    Creating = 1, 
    Active = 10, 
    Passive = 50 
}

/// A Snapshot is a point in Space-time.
@entity
struct Snapshot {
    /// The Snapshot type.
    type: SnapshotType,
    /// The Snapshot status.
    status: SnapshotStatus = SnapshotStatus::Active,
}

