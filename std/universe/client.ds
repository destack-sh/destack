use destack;

/// A Client to connect with the system.
@entity
struct Client {
    /// The client type.
    type: ClientType,
    /// The access token, if any.
    accessToken: Optional<String>,
    /// When the client was last seen.
    seenAt: Optional<Timestamp>,
    /// When the client last logged in.
    loggedInAt: Optional<Timestamp>,
    /// The device type.
    deviceType: Optional<String>,
    /// The device name.
    deviceName: Optional<String>,
    /// The operating system name.
    operatingSystem: Optional<String>,
    /// The browser name.
    browserName: Optional<String>,
    /// The browser version.
    browserVersion: Optional<String>,
}


