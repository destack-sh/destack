use destack::*;

/// Day of week.
enum DayOfWeek {
	Monday = 1,
	Tuesday = 2,
	Wednesday = 3,
	Thursday = 4,
	Friday = 5,
	Saturday = 6,
	Sunday = 7,
}

/// Month of year.
enum Month {
	January = 1,
	February = 2,
	March = 3,
	April = 4,
	May = 5,
	June = 6,
	July = 7,
	August = 8,
	September = 9,
	October = 10,
	November = 11,
	December = 12,
}

/// Schedule frequency.
enum ScheduleFrequency {
	Year = 1,
	Month = 2,
	Week = 3,
	Day = 4,
	Hour = 5,
	Minute = 6,
}

/// The time-based schedule of something (compatible with rrule).
struct Schedule {
	/// The recurrence frequency.
	frequency: ScheduleFrequency,
	/// The recurrence interval (>= 1).
	interval: u32 = 1,
	/// The optional start timestamp.
	start: Option<Timestamp>,
	/// The optional end timestamp.
	end: Option<Timestamp>,
	/// The optional total occurrence count.
	count: Option<u32>,
	/// The optional week start day.
	week_start: Option<DayOfWeek>,
	/// Positions to include in the set.
	by_set_pos: Option<u32[]>,
	/// Months to include.
	by_month: Option<Month[]>,
	/// Month days to include.
	by_month_day: Option<u8[]>,
	/// Year days to include.
	by_year_day: Option<u16[]>,
	/// Easter offsets to include.
	by_easter: Option<u8[]>,
	/// Week numbers to include.
	by_week_no: Option<u8[]>,
	/// Week days to include.
	by_week_day: Option<DayOfWeek[]>,
	/// Hours to include.
	by_hour: Option<u8[]>,
	/// Minutes to include.
	by_minute: Option<u8[]>,
	/// Seconds to include.
	by_second: Option<u8[]>,
}

