use destack::*;

/// Built-in transition types
enum TransitionType {
	Tween = 10,
	Spring = 11,
}

/// Built-in spring types
enum SpringType {
	Time = 1,
	Physical = 2,
}

/// A transition value
struct Transition {
	type: TransitionType = TransitionType::Tween,
	template: Option<TransitionTemplate>,
	delay: Option<f32>,
	duration: Option<f32>,
	ease: f32[],
	stiffness: Option<f32>,
	damping: Option<f32>,
	mass: Option<f32>,
	bounce: Option<f32>,
	spring_type: Option<SpringType>,
}

/// A transition template
#entity struct TransitionTemplate {
	type: TransitionType = TransitionType::Tween,
	delay: Option<f32>,
	duration: Option<f32>,
	ease: f32[],
	stiffness: Option<f32>,
	damping: Option<f32>,
	mass: Option<f32>,
	bounce: Option<f32>,
	spring_type: Option<SpringType>,
}


