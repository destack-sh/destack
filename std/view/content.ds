use destack;

/// A 2D content View
@entity(View2D)
struct ContentView2D {}

/// A 2D Text View
@entity(ContentView2D)
struct TextView2D {
    /// The text to display
    text: Optional<Text>,
    /// The font to use for the text
    font: Optional<Font>,
    /// The color of the text
    color: Optional<Fill>,
}


