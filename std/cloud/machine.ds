use destack;

/// Types of machines that provide compute.
enum MachineType {
    Runtime = 10,
    Ubuntu = 1000,
    Mac = 1100,
    Windows = 1200,
    Custom = 9000,
}

/// A Machine provides physical compute.
@entity
struct Machine {
    /// Machine type.
    type: MachineType = MachineType.Runtime,
    /// Runtime version string.
    version: String,
    /// External provider name.
    externalName: Optional<String>,
    /// External provider id.
    externalId: Optional<String>,
    /// Image id in provider.
    imageId: Optional<String>,
    /// vCPU count.
    cpu: float32 = 1.0,
    /// RAM in GB.
    ram: float32 = 1.0,
    /// Virtual display width.
    width: u32 = 1280,
    /// Virtual display height.
    height: u32 = 960,
    /// Whether to run headless.
    isHeadless: bool = false,
}


