/// Game state for the tetris game
enum TetrisGameState {
	/// Game is ready to start
	Ready,
	/// Game is actively being played
	Playing,
	/// Game is paused
	Paused,
	/// Game over - pieces reached the top
	GameOver
}

/// Tetris piece shapes
enum TetrisShape {
	/// I-piece (line)
	I = 1,
	/// J-piece
	J = 2,
	/// L-piece
	L = 3,
	/// O-piece (square)
	O = 4,
	/// S-piece
	S = 5,
	/// T-piece
	T = 6,
	/// Z-piece
	Z = 7
}

/// Direction for piece movement
enum TetrisDirection {
	/// Move left
	Left,
	/// Move right
	Right,
	/// Move down
	Down
}

/// Rotation direction
enum TetrisRotation {
	/// Rotate clockwise
	Clockwise,
	/// Rotate counter-clockwise
	CounterClockwise
}

/// Base component for all tetris game objects
struct TetrisComponent {
	/// Game instance this object belongs to
	game_id: u32,
	/// Whether this object is active in the game
	is_active: bool = true,
}

/// A single cell in the tetris grid
struct TetrisCell {
	/// Whether the cell is occupied by a placed piece
	is_occupied: bool = false,
	/// Color of the piece in this cell
	color: Option<Color> = None,
	/// Shape type that occupies this cell
	shape_type: Option<TetrisShape> = None,
}

/// Component for falling pieces
struct FallingPieceComponent {
	/// Current position on the board
	position: Vector2i,
	/// Current rotation state (0-3)
	rotation: u32 = 0,
	/// Time until next automatic drop
	drop_timer: f32 = 0.0,
	/// Drop interval in seconds
	drop_interval: f32 = 1.0,
}

/// The main tetris game board
entity TetrisBoard<W: u32, H: u32> {
	...TetrisComponent,
	
	/// Grid of cells
	cells: TetrisCell[W, H],
	/// Board width in cells
	width: u32 = 10,
	/// Board height in cells
	height: u32 = 20,
	/// Lines cleared this game
	lines_cleared: u32 = 0,
}

/// A tetris piece (both falling and placed)
entity TetrisPiece {
	...TetrisComponent,
	...FallingPieceComponent,
	
	/// Shape of this piece
	shape: TetrisShape,
	/// Color of this piece
	color: Color,
	/// Whether this piece is currently falling
	is_falling: bool = true,
	/// Block pattern for this shape and rotation
	blocks: List<Vector2i>,
}

/// Main tetris game controller
entity TetrisGame {
	...TetrisComponent,
	
	/// Current game state
	state: TetrisGameState = TetrisGameState::Ready,
	/// Player's current score
	score: u32 = 0,
	/// Current level
	level: u32 = 1,
	/// Total lines cleared
	total_lines: u32 = 0,
	/// Current falling piece
	current_piece: Option<TetrisPiece> = None,
	/// Next piece to spawn
	next_piece: Option<TetrisShape> = None,
	/// Game board reference
	board: TetrisBoard,
}

impl TetrisBoard {
	/// Create a new tetris board
	fn spawn(width: u32, height: u32) -> TetrisBoard {
		let cells = List::new();
		for y in 0..height {
			let row = List::new();
			for x in 0..width {
				row.push(TetrisCell::new());
			}
			cells.push(row);
		}
		
		TetrisBoard {
			cells,
			width,
			height
		}
	}
	
	/// Check if a position is valid for a piece
	fn is_valid_position(self, piece: *TetrisPiece, offset: Vector2i) -> bool {
		for block in *piece.blocks {
			let x = piece.position.x + block.x + offset.x;
			let y = piece.position.y + block.y + offset.y;
			
			// check bounds
			if x < 0 || x >= self.width as i32 || y < 0 || y >= self.height as i32 {
				return false;
			}
			
			// check collision with placed pieces
			if self.cells[y as usize][x as usize].is_occupied {
				return false;
			}
		}
		true
	}
	
	/// Place a piece on the board
	fn place_piece(self, piece: *TetrisPiece) {
		for block in *piece.blocks {
			let x = (piece.position.x + block.x) as usize;
			let y = (piece.position.y + block.y) as usize;
			
			self.cells[y][x].is_occupied = true;
			self.cells[y][x].color = Some(piece.color);
			self.cells[y][x].shape_type = Some(piece.shape);
		}
	}
	
	/// Check for and clear completed lines
	fn clear_lines(self) -> u32 {
		let lines_cleared = 0;
		let y = self.height - 1;
		
		while y > 0 {
			let is_full = true;
			for x in 0..self.width {
				if !self.cells[y as usize][x as usize].is_occupied {
					is_full = false;
					break;
				}
			}
			
			if is_full {
				// remove this line and shift everything down
				self.cells.remove(y as usize);
				self.cells.insert(0, self.create_empty_row());
				lines_cleared += 1;
			} else {
				y -= 1;
			}
		}
		
		self.lines_cleared += lines_cleared;
		lines_cleared
	}
	
	/// Create an empty row
	fn create_empty_row(self) -> List<TetrisCell> {
		let row = List::new();
		for _ in 0..self.width {
			row.push(TetrisCell::new());
		}
		row
	}
}

impl TetrisShape {
	/// Get the block pattern for this shape at rotation 0
	fn get_blocks(self) -> List<Vector2i> {
		match self {
			TetrisShape::I => [
				Vector2i::new(0, 1), Vector2i::new(1, 1),
				Vector2i::new(2, 1), Vector2i::new(3, 1)
			],
			TetrisShape::J => [
				Vector2i::new(0, 0), Vector2i::new(0, 1),
				Vector2i::new(1, 1), Vector2i::new(2, 1)
			],
			TetrisShape::L => [
				Vector2i::new(2, 0), Vector2i::new(0, 1),
				Vector2i::new(1, 1), Vector2i::new(2, 1)
			],
			TetrisShape::O => [
				Vector2i::new(0, 0), Vector2i::new(1, 0),
				Vector2i::new(0, 1), Vector2i::new(1, 1)
			],
			TetrisShape::S => [
				Vector2i::new(1, 0), Vector2i::new(2, 0),
				Vector2i::new(0, 1), Vector2i::new(1, 1)
			],
			TetrisShape::T => [
				Vector2i::new(1, 0), Vector2i::new(0, 1),
				Vector2i::new(1, 1), Vector2i::new(2, 1)
			],
			TetrisShape::Z => [
				Vector2i::new(0, 0), Vector2i::new(1, 0),
				Vector2i::new(1, 1), Vector2i::new(2, 1)
			]
		}
	}
	
	/// Get the color for this shape
	fn get_color(self) -> Color {
		match self {
			TetrisShape::I => Color::cyan(),
			TetrisShape::J => Color::blue(),
			TetrisShape::L => Color::orange(),
			TetrisShape::O => Color::yellow(),
			TetrisShape::S => Color::green(),
			TetrisShape::T => Color::purple(),
			TetrisShape::Z => Color::red()
		}
	}
}

impl TetrisPiece {
	/// Create a new tetris piece
	fn spawn(shape: TetrisShape, x: i32, y: i32) -> TetrisPiece {
		TetrisPiece {
			shape,
			color: shape.get_color(),
			position: Vector2i::new(x, y),
			blocks: shape.get_blocks()
		}
	}
	
	/// Move the piece in a direction
	fn move_piece(self, direction: TetrisDirection, board: *TetrisBoard) -> bool {
		let offset = match direction {
			TetrisDirection::Left => Vector2i::new(-1, 0),
			TetrisDirection::Right => Vector2i::new(1, 0),
			TetrisDirection::Down => Vector2i::new(0, 1)
		};
		
		if board.is_valid_position(self, offset) {
			self.position += offset;
			return true;
		}
		false
	}
	
	/// Rotate the piece
	fn rotate(self, rotation: TetrisRotation, board: *TetrisBoard) -> bool {
		let new_rotation = match rotation {
			TetrisRotation::Clockwise => (self.rotation + 1) % 4,
			TetrisRotation::CounterClockwise => (self.rotation + 3) % 4
		};
		
		let new_blocks = self.get_rotated_blocks(new_rotation);
		let old_blocks = self.blocks.clone();
		self.blocks = new_blocks;
		
		if board.is_valid_position(self, Vector2i::zero()) {
			self.rotation = new_rotation;
			return true;
		} else {
			// revert rotation
			self.blocks = old_blocks;
			return false;
		}
	}
	
	/// Get blocks for a specific rotation
	fn get_rotated_blocks(self, rotation: u32) -> List<Vector2i> {
		let base_blocks = self.shape.get_blocks();
		let rotated_blocks = List::new();
		
		for block in base_blocks {
			let rotated = self.rotate_point(block, rotation);
			rotated_blocks.push(rotated);
		}
		
		rotated_blocks
	}
	
	/// Rotate a point around origin
	fn rotate_point(self, point: Vector2i, rotation: u32) -> Vector2i {
		match rotation % 4 {
			0 => point,
			1 => Vector2i::new(-point.y, point.x),
			2 => Vector2i::new(-point.x, -point.y),
			3 => Vector2i::new(point.y, -point.x),
			_ => point
		}
	}
	
	/// Update falling piece
	fn update(self, delta_time: f32, board: *TetrisBoard) -> bool {
		if !self.is_falling {
			return false;
		}
		
		self.drop_timer -= delta_time;
		if self.drop_timer <= 0.0 {
			self.drop_timer = self.drop_interval;
			return self.move_piece(TetrisDirection::Down, board);
		}
		
		true
	}
}

impl TetrisGame {
	/// Create a new tetris game
	fn spawn() -> TetrisGame {
		TetrisGame {
			board: TetrisBoard::spawn(10, 20),
			state: TetrisGameState::Ready
		}
	}
	
	/// Start or restart the game
	fn start_game(self) {
		self.state = TetrisGameState::Playing;
		self.score = 0;
		self.level = 1;
		self.total_lines = 0;
		self.spawn_next_piece();
	}
	
	/// Update game state each frame
	fn update(self, delta_time: f32) {
		if self.state != TetrisGameState::Playing {
			return;
		}
		
		// update current piece
		if let Some(piece) = *self.current_piece {
			if !piece.update(delta_time, *self.board) {
				// piece can't move down anymore, place it
				self.place_current_piece();
			}
		}
		
		// check for game over
		if self.is_game_over() {
			self.state = TetrisGameState::GameOver;
		}
	}
	
	/// Spawn the next piece
	fn spawn_next_piece(self) {
		let shape = self.next_piece.unwrap_or(self.get_random_shape());
		self.current_piece = Some(TetrisPiece::spawn(shape, 4, 0));
		self.next_piece = Some(self.get_random_shape());
	}
	
	/// Place the current piece on the board
	fn place_current_piece(self) {
		if let Some(piece) = *self.current_piece {
			self.board.place_piece(piece);
			
			// check for line clears
			let lines_cleared = self.board.clear_lines();
			if lines_cleared > 0 {
				self.total_lines += lines_cleared;
				self.score += self.calculate_score(lines_cleared);
				self.level = (self.total_lines / 10) + 1;
			}
			
			self.current_piece = None;
			self.spawn_next_piece();
		}
	}
	
	/// Calculate score for cleared lines
	fn calculate_score(self, lines: u32) -> u32 {
		let base_score = match lines {
			1 => 100,
			2 => 300,
			3 => 500,
			4 => 800,
			_ => 0
		};
		base_score * self.level
	}
	
	/// Check if game is over
	fn is_game_over(self) -> bool {
		// check if top row has any occupied cells
		for x in 0..self.board.width {
			if self.board.cells[0][x as usize].is_occupied {
				return true;
			}
		}
		false
	}
}