use destack::*;

tuple Vector2i(i32, i32);

impl Vector2i {
	fn add(self, other: Vector2i) -> Vector2i {
		Vector2i(self.0 + other.0, self.1 + other.1)
	}
}

struct Vector<T: Type, L: u8> {
	elems: T[L],
}

struct Vector2 = Vector<f32, 2>;
struct Vector3 = Vector<f32, 3>;

// prefix with # to mark a comptime-enforced function (maybe #(only) for comptime only?)
// last argument is the wrapped thing
fn #inline(when: InlinePreference, func: FunctionDefinition) -> FunctionDefinition {
	func.is_inline = true
	func
}

#inline(InlineHint::Always)
fn sum<T: Type, L: u8>(vec: Vector<T, L>) -> T {
	let sum: T = 0;
	#for i in 0..L {
		sum += vec[i];
	}
	sum
}

const x = 5;

#if(IS_TEST)
#test_suite
mod tests {
	#test_case
	fn test_sum() {
		let vec = Vector2 { elems: [1.0, 2.0] };
		let sum = sum(vec);
		assert(sum == 3.0);
	}
}