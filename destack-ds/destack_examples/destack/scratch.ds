}


//
// Entity
//

#flag
enum ProcessFlag {
	Default = 0,
	Deleted = 1,
	Inactive = 2,
	InactiveInput = 4,
	Sleeping = 8,
	SleepingInput = 16
}

#entity struct Entity {
	/// The universally unique identifier.
	id: uuid, 

	/// The Space this Entity is in.
	space: EntityReference<Space>,
	
	branch: Branch,
	
	#(reference=.Spatial)
	snapshot: EntityReference<Snapshot>,
	
	materialization: Materialization,
	definition: Option<Entity>,
	instance: Option<Entity>,

	created_epoch: u64,
	updated_epoch: u64,

	owner: Entity,
	controller: Entity,
	process_flags: ProcessFlag,

	parent: Option<EntityReference<Entity>>,
	name: string,
	key: Option<string>,
	order: Option<order>,

	extension_flags: ExtensionFlag,
	// custom_values: List<NamedValue>?
	// custom_values: Map<string, Value>?
	script: Option<Script>,
}

impl Entity {
	#intrinsic
	fn delete(self);
}

trait Reactable {

} 

#entity struct Entity2D {
	...Transform2D

}

impl Entity2D {
	const Something: u8 = 4;
}

impl Reactable for Entity2D {
	fn react() {

	}
}

