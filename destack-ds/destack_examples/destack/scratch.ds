//
// Events
//

event MyEvent ... InputEvent {

}

//
// Errors
//

struct MyError {
	...Error,
}

//
// Messages
//

struct MyMessage {
	...Message,
}

enum MyEnum {
	A,
	B,
	C
}

union MyUnion {
	A(name: string, alpha: string) = 2,
	B = 4,
	C(bool) = 5,
	D(MyMessage) = 6
}

struct Vector2 {
	x: f32,
	y: f32
}

impl Vector2 {
	fn add(self, other: Vector2) -> Vector2 {

	}

	fn add(self, other: f32) -> Vector2 {
		Vector2 {
			x: self.x + other,
			y: self.x + other
		}
	}
}

trait Error {
	id: uuid,
	client: Client,
	client_nonce: u8,
	client_remote_epoch: u64,
	client_local_epoch: u64
}

struct Position2(Vector2);
// shorthand for => Position2 { ...Vector2 }

struct CustomLength(f32); // newtype