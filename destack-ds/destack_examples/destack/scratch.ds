use destack::*;

enum Materialization {
	Virtual = 3,
	Partial = 4,
	Full = 6,
	Root = 7
}

struct Transform2D {
	position: Vector2,
	scale: Vector2,
	rotation: f32
}

struct Form2D {
	...Transform2D,
}

impl Form2D {
	fn rescale(self, factor: f32) {

	}
}

struct Rectangle2D {
	...Form2D,
	width: f32,
	height: f32
}

fn module_function_rect() -> Rectangle2D {

}


//
// Entity
//

@flag
enum ProcessFlag {
	Default = 0,
	Deleted = 1,
	Inactive = 2,
	InactiveInput = 4,
	Sleeping = 8,
	SleepingInput = 16
}

entity Entity {
	/// The universally unique identifier.
	id: uuid, 

	@(type=.Spatial)
	space: Space,
	
	@(type=.Spatial)
	branch: Branch,
	
	@(type=.Spatial)
	snapshot: Snapshot,
	
	materialization: Materialization,
	definition: Option<Entity>,
	instance: Option<Entity>,

	created_epoch: u64,
	updated_epoch: u64,

	owner: Entity,
	controller: Entity,
	process_flags: ProcessFlag,

	parent: Option<Entity>,
	name: string,
	key: Option<string>,
	order: Option<order>,

	extension_flags: ExtensionFlag,
	// custom_values: List<NamedValue>?
	// custom_values: Map<string, Value>?
	script: Option<Script>,

	@intrinsic
	fn delete(self);
}

trait Reactable {

} 

entity Entity2D {
	...Transform2D

}

impl Entity2D {
	const Something: u8 = 4;
}

impl Reactable for Entity2D {
	fn react() {

	}
}

