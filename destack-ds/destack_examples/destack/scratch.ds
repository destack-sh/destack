use destack::*;

enum Materialization {
	Virtual = 3,
	Partial = 4,
	Full = 6,
	Root = 7
}

struct Transform2D {
	position: Vector2,
	scale: Vector2,
	rotation: f32
}

struct Form2D {
	..Transform2D,
}

impl Form2D {
	fn rescale(self, factor: f32) {

	}
}

struct Rectangle2D {
