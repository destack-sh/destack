struct Vector2 {
	x: f32,
	y: f32
}

impl Vector2 {
	fn add(self, other: Vector2) -> Vector2 {

	}

	fn add(self, other: f32) -> Vector2 {
		Vector2 {
			x: self.x + other,
			y: self.x + other
		}
	}
}

