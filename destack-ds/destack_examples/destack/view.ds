use destack::*;

/// Component for transform properties
struct TransformComponent2D {
	/// The origin of the Entity in 2D space
	origin: Option<Vector2> = None,
	/// The anchor of the Entity in 2D space
	anchor: Option<Anchor> = None,
	/// The offset of the Entity in 2D space
	offset: Option<Offset2> = None,
}

/// Component for sizing properties
struct SizingComponent2D {
	/// The width of the View
	width: Option<Length> = None,
	/// The height of the View
	height: Option<Length> = None,
	/// The minimum width of the View
	min_width: Option<Length> = None,
	/// The minimum height of the View
	min_height: Option<Length> = None,
	/// The maximum width of the View
	max_width: Option<Length> = None,
	/// The maximum height of the View
	max_height: Option<Length> = None,
}

/// Component for visibility properties
struct VisibilityComponent2D {
	/// Whether the View is visible
	is_visible: Option<bool> = None,
	/// The opacity of the View
	opacity: Option<f32> = None,
}

/// Component for style properties
struct StyleComponent2D {
	/// The fill of the View
	fill: Option<Fill> = None,
	/// The shadow of the View
	shadow: Option<Shadow> = None,
	/// The border of the View
	border: Option<Border> = None,
	/// The radius of the View
	radius: Option<Corner2> = None,
}

/// A View2D is a 2D interface element
/// Views add dynamic positioning, sizing and styling to RigidBody2D
entity View2D extends RigidBody2D {
	...TransformComponent2D,
	...SizingComponent2D,
	...VisibilityComponent2D,
	...StyleComponent2D,
}


entity MyCustomView extends View2D {
	fn render(self) {
		ButtonView::new({ text: f`{this.}`})
	}
}