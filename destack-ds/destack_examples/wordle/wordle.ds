/// Game state for the wordle game
enum(u8) WordleGameState {
	/// Game is ready to start
	Ready,
	/// Game is actively being played
	Playing,
	/// Game is paused
	Paused,
	/// Game over - player lost
	GameOver,
	/// Game won - word guessed correctly
	Victory
}

/// Letter state in a wordle guess
enum(string) WordleLetterState {
	/// Letter not yet guessed
	Empty = "Empty",
	/// Letter is in the word and in correct position
	Correct = "Correct",
	/// Letter is in the word but in wrong position
	Present = "Present",
	/// Letter is not in the word
	Absent = "Absent"
}

/// Error 
#error
union WordleError {
	OutOfLetters(u32),
	InvalidGuess({
		guess: String,
		reason: WordleLetterState,
		correct_word: String
	}),
	InvalidTargetWord(String, i32),
	InvalidGuessLength(u32),
	InvalidGuessFormat(String),
}

/// Base component for all wordle game objects
struct WordleComponent {
	/// Whether this object is active in the game
	is_active: bool = true,
}

/// A single letter cell in the wordle grid
struct WordleCell {
	/// The letter in this cell
	letter: Option<char> = None,
	/// State of this letter
	state: WordleLetterState = WordleLetterState::Empty,
	/// Whether this cell is currently being typed into
	is_active: bool = false,
}

/// A single guess row
struct WordleGuess {
	/// The 5 letters in this guess
	cells: WordleCell[5],
	/// Whether this guess has been submitted
	is_submitted: bool = false,
	/// Whether this guess is the current active row
	is_current: bool = false,
}

/// Keyboard key state tracking
struct WordleKeyState {
	/// The letter this key represents
	letter: char,
	/// State of this letter based on guesses
	state: WordleLetterState = WordleLetterState::Empty,
}

/// The main wordle game board
#entity(Entity) struct WordleBoard {
	use WordleComponent::*;
	
	/// Grid of guesses (6 rows of 5 letters)
	guesses: WordleGuess[6],
	/// Current row being typed into
	current_row: u32 = 0,
	/// Current column being typed into
	current_col: u32 = 0,
	/// The target word to guess
	target_word: String,
	/// Whether the game board is accepting input
	is_accepting_input: bool = true,
}

/// Virtual keyboard for letter input
#entity(Entity) struct WordleKeyboard {
	use WordleComponent::*;
	
	/// State of each letter key
	key_states: Map<char, WordleKeyState>,
	/// Whether the keyboard is active
	is_active: bool = true,
}

/// Main wordle game controller
#entity(Entity) struct WordleGame {
	use WordleComponent::*;
	
	/// Current game state
	state: WordleGameState = WordleGameState::Ready,
	/// Number of guesses made
	guesses_made: u32 = 0,
	/// Maximum number of guesses allowed
	max_guesses: u32 = 6,
	/// Current streak of wins
	win_streak: u32 = 0,
	/// Total games played
	games_played: u32 = 0,
	/// Total games won
	games_won: u32 = 0,
	/// Game board reference
	board: WordleBoard,
	/// Keyboard reference
	keyboard: WordleKeyboard,
	/// Word list for random selection
	word_list: List<String>,
}

impl WordleBoard {
	/// Create a new wordle board
	fn spawn(target_word: String) -> WordleBoard {
		let mut guesses: List<String> = List::with_capacity(10);
		for i in 0..6 {
			let mut cells = [];
			for j in 0..5 {
				cells.append(WordleCell::new());
			}
			guesses.push(WordleGuess {
				cells,
				is_current: i == 0
			});
		}
		
		WordleBoard {
			guesses,
			target_word: target_word.to_uppercase()
		}
	}
	
	/// Add a letter to the current position
	fn add_letter(self, letter: char) -> bool {
		if !self.is_accepting_input || self.current_col >= 5 {
			return false;
		}
		
		let mut current_guess = &mut self.guesses[self.current_row as usize];
		current_guess.cells[self.current_col as usize].letter = Some(letter.to_uppercase());
		current_guess.cells[self.current_col as usize].is_active = false;
		
		self.current_col += 1;
		if self.current_col < 5 {
			current_guess.cells[self.current_col as usize].is_active = true;
		}
		
		true
	}
	
	/// Remove the last letter
	fn remove_letter(self) -> bool {
		if !self.is_accepting_input || self.current_col == 0 {
			return false;
		}
		
		let mut current_guess = &mut self.guesses[self.current_row as usize];
		if self.current_col < 5 {
			current_guess.cells[self.current_col as usize].is_active = false;
		}
		
		self.current_col -= 1;
		current_guess.cells[self.current_col as usize].letter = None;
		current_guess.cells[self.current_col as usize].is_active = true;
		
		true
	}
	
	/// Submit the current guess
	fn submit_guess(self) -> Option<String> {
		if !self.is_accepting_input || self.current_col != 5 {
			return None;
		}
		
		let mut current_guess = &mut self.guesses[self.current_row as usize];
		let mut guess_word = self.get_current_word();
		
		// check each letter against target word
		self.evaluate_guess(current_guess, &guess_word);
		
		current_guess.is_submitted = true;
		current_guess.is_current = false;
		
		// move to next row
		self.current_row += 1;
		self.current_col = 0;
		
		if self.current_row < 6 {
			self.guesses[self.current_row as usize].is_current = true;
			self.guesses[self.current_row as usize].cells[0].is_active = true;
		} else {
			self.is_accepting_input = false;
		}
		
		Some(guess_word)
	}
	
	/// Get the current word being typed
	fn get_current_word(self) -> String {
		let current_guess = &self.guesses[self.current_row as usize];
		let mut word = String::new();
		
		for cell in &current_guess.cells {
			if let Some(letter) = cell.letter {
				word.push(letter);
			}
		}
		
		word
	}
	
	/// Evaluate a guess against the target word
	fn evaluate_guess(self, guess: &mut WordleGuess, guess_word: &String) {
		// ..
	}
	
	/// Check if the current guess matches the target word
	fn is_correct_guess(self, guess_word: &String) -> bool {
		*guess_word == self.target_word
	}
}

impl WordleKeyboard {
	/// Create a new wordle keyboard
	fn spawn() -> WordleKeyboard {
		let mut key_states = Map::new();
		
		// initialize all letter keys
		for letter in 'A'..='Z' {
			key_states.insert(letter, WordleKeyState { letter });
		}
		
		WordleKeyboard {
			key_states
		}
	}
	
	/// Update key state based on guess results
	fn update_key_state(self, letter: char, state: WordleLetterState) {
		if let Some(key_state) = self.key_states.get_mut(&letter) {
			// only update if new state is more informative
			match (key_state.state, state) {
				(WordleLetterState::Empty, _) => key_state.state = state,
				(WordleLetterState::Absent, WordleLetterState::Present) => key_state.state = state,
				(WordleLetterState::Absent, WordleLetterState::Correct) => key_state.state = state,
				(WordleLetterState::Present, WordleLetterState::Correct) => key_state.state = state,
				_ => {} // don't downgrade state
			}
		}
	}
	
	/// Reset all key states
	fn reset(self) {
		for (_, key_state) in &mut self.key_states {
			key_state.state = WordleLetterState::Empty;
		}
	}
}