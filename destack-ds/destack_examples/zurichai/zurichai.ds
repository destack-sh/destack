///
/// The module for real gangsters
///


entity MeetupMembership extends Membership {

}

entity MeetupSeries {

}

entity Meetup {
	/// Max number of attendees.
	capacity: u32,
	/// The series this is part of.
	series: Option<EntityReference<MeetupSeries>>,
	starts_at: Option<DateTime>,
	ends_at: Option<DateTime>,
}
#assert(#size_of(Entity) < 64, "{Entity:?} is too big")

impl Meetup {
	fn do_something(self) {

	}

	/// Cancel the Event.
	#action 
	fn cancel(self) -> struct { success: bool } {
		assert(self.starts_at.is_some(), "Meetup must have started to cancel");
	}

	#action
	fn start(self) -> union {
		Success,
		Failure,
	} {

	}

	#action
	fn end(self) {

	}
}

event MeetupEvent {
	meetup: Meetup,
}

event MeetupAlmostFull extends MeetupEvent {}
event MeetupFull extends MeetupEvent {}
event MeetupCancelled extends MeetupEvent {}
event MeetupStarted extends MeetupEvent {}
event MeetupEnded extends MeetupEvent {}