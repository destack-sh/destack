///
/// The module for real gangsters
///


#entity(Membership) struct MeetupMembership {

}

#entity(Entity) struct MeetupSeries {

}

#entity(Entity) struct Meetup {
	/// Max number of attendees.
	capacity: u32,
	/// The series this is part of.
	series: Option<EntityReference<MeetupSeries>>,
	starts_at: Option<DateTime>,
	ends_at: Option<DateTime>,
}
#assert(#size_of(Meetup) < 64, "{Meetup:?} is too big")

impl Meetup {
	/// Cancel the Event.
	#action 
	fn cancel(self) -> struct { success: bool } {
		assert(self.starts_at.is_some(), "Meetup must have started to cancel");
	}

	#action
	fn start(self) -> union {
		Success,
		Failure,
	} {

	}
	// referred to as Meetup::start::Success/Failure

	#action
	fn end(self) {

	}
}

#event struct MeetupEvent {
	meetup: Meetup,
}

#event(MeetupEvent) struct MeetupAlmostFull {}
#event(MeetupEvent) struct MeetupFull {}
#event(MeetupEvent) struct MeetupCancelled {}
#event(MeetupEvent) struct MeetupStarted {}
#event(MeetupEvent) struct MeetupEnded {}