use destack::*;

/// Definition of a builtin Index.
struct IndexDefinition {
	/// The Index id.
	id: u8,
	/// The type of the Index.
	type: IndexType,
	/// The properties the Index covers.
	properties: PropertyReference[],
	/// Additional properties covered by the Index.
	cover: PropertyReference[],
}

/// Index of an Entity for faster querying.
#entity struct Index {
	/// The type of the Index.
	type: IndexType,
	/// The properties the Index covers.
	properties: PropertyReference[],
}


