use destack::*;

/// Folder types.
enum FolderType { System = 1, Home = 2, General = 3, Module = 4, App = 5 }

/// A Folder is a sub-space of a Space.
#entity struct Folder {
	/// The Folder type.
	type: FolderType = FolderType::General,
	/// The optional slug of the Folder.
	slug: Option<String>,
}


