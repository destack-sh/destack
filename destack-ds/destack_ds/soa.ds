

struct Vec<T: Type> {
	len: usize,
	capacity: usize,
	items: T[],
}

impl Vec<T> {
	fn new() -> Vec<T> {
		Vec { len: 0, capacity: 0, items: [] }
	}

	fn with_capacity(capacity: usize) -> Vec<T> {
		Vec { len: 0, capacity, items: [] }
	}
}

fn #build_soa_type(T: Type) -> Type {
	// build a type that is a list of T
	...
}

struct MultiArray<T: Type> {
    type SoaType = #build_soa_type(T),

	len: usize,
	capacity: usize,
	items: SoaType[],
}