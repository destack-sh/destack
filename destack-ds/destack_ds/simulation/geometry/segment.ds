use destack::*;

/// A Segment is a line between two points.
struct Segment2D {
	use Form2D::*;
	start_offset: Vector2,
	end_offset: Vector2,
}

/// A SegmentShape is a shape that represents a line between two points.
#entity(Shape2D) struct SegmentShape2D {
	use Segment2D::*;
}

/// A Segment3D is a line between two points in 3D space.
struct Segment3D {
	use Form3D::*;
	start_offset: Vector3,
	end_offset: Vector3,
}

/// A SegmentShape3D is a shape that represents a line between two points in 3D.
#entity(Shape3D) struct SegmentShape3D {
	use Segment3D::*;
}