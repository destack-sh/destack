use destack::*;

/// The status of a Run.
enum(u8) RunStatus {
	/// Scheduled for sometime
	Scheduled,
	/// Actively running
	Running,
	/// Paused manually
	Paused,
	/// Yielded to someone
	Yielded,
	/// Cancelled before running
	Cancelled,
	/// Aborted while running
	Aborted,
	/// Failed due to an error
	Failed,
	/// Completed successfully
	Completed,
}

/// A Run is an execution of a Function.
#entity(.{
	event_types=[RunEvent],
})
struct Run {
	function: EntityReference<Function>,
	status: RunStatus,
	scheduled_at: Option<Timestamp>,
	started_at: Option<Timestamp>,
	completed_at: Option<Timestamp>,
	seen_at: Option<Timestamp>,
	interrupted_at: Option<Timestamp>,
	terminated_at: Option<Timestamp>,
	duration: Option<Duration>,
}

#event struct RunEvent {
	run: EntityReference<Run>,
}

// this would be cool but not yet supported:
// #for status in RunStatus {
// 	let event = #event(RunEvent) struct RunEvent {
// 		status: RunStatus = status,
// 	}
//  event.name = #format!("Run{status.name()}Event");
//  event
// }

#event(RunEvent) struct RunStartedEvent {}
#event(RunEvent) struct RunPausedEvent {}
#event(RunEvent) struct RunResumedEvent {}
#event(RunEvent) struct RunStoppedEvent {}
#event(RunEvent) struct RunFailedEvent {}
#event(RunEvent) struct RunCompletedEvent {}
