use destack::*;

/// When the effect fires.
enum EffectType {
	Appear = 10,
	Enter = 11,
	Exit = 12,
	Hover = 20,
	Press = 21,
	Drag = 22,
	Focus = 23,
	Loop = 30,
}

/// How a repeating animation behaves.
enum RepeatType {
	Loop = 1,
	Reverse = 2,
	Mirror = 3,
}

/// How to split text for per-part effects.
enum TextSplitType {
	Char = 1,
	Word = 2,
	Line = 3,
}

/// What happens when the element is offscreen.
enum OffscreenBehavior {
	Play = 1,
	Pause = 2,
}

/// An effect value.
struct Effect {
	/// When the effect is applied.
	type: EffectType,
	/// Optional template reference to inherit values from.
	template: Option<EffectTemplate>,
	/// Optional opacity multiplier.
	opacity: Option<f32>,
	/// Optional positional offset in 2D.
	offset: Option<Vector2>,
	/// Optional uniform scale factor.
	scale: Option<f32>,
	/// Optional 3D axis rotation.
	rotate: Option<Axis3>,
	/// Optional 2D skew.
	skew: Option<Vector2>,
	/// Optional perspective amount.
	perspective: Option<f32>,
	/// Optional start delay.
	delay: Option<Duration>,
	/// Optional playback duration.
	duration: Option<f32>,
	/// Optional intersection threshold for visibility-driven effects.
	threshold: Option<f32>,
	/// Whether to apply only once.
	once: Option<bool>,
	/// Optional repeat behavior.
	repeat: Option<RepeatType>,
	/// Optional text split behavior.
	split: Option<TextSplitType>,
	/// Offscreen behavior.
	offscreen: Option<OffscreenBehavior>,
	/// Optional transition configuration.
	transition: Option<Transition>,
}

/// An effect template.
#entity struct EffectTemplate {
	/// When the effect is applied.
	type: EffectType,
	/// Optional opacity multiplier.
	opacity: Option<f32>,
	/// Optional positional offset in 2D.
	offset: Option<Vector2>,
	/// Optional uniform scale factor.
	scale: Option<f32>,
	/// Optional 3D axis rotation.
	rotate: Option<Axis3>,
	/// Optional 2D skew.
	skew: Option<Vector2>,
	/// Optional perspective amount.
	perspective: Option<f32>,
	/// Optional start delay.
	delay: Option<Duration>,
	/// Optional playback duration.
	duration: Option<f32>,
	/// Optional intersection threshold for visibility-driven effects.
	threshold: Option<f32>,
	/// Whether to apply only once.
	once: Option<bool>,
	/// Optional repeat behavior.
	repeat: Option<RepeatType>,
	/// Optional text split behavior.
	split: Option<TextSplitType>,
	/// Offscreen behavior.
	offscreen: Option<OffscreenBehavior>,
	/// Optional transition configuration.
	transition: Option<Transition>,
}


