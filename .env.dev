CLOUD=private
REGION=eu-zurich
LOG_LEVEL=DEBUG
LOG_MODE=PLAIN
LOG_PROMPTS=0
LOG_COMPLETIONS=0
TRACING=1
TRACE_LOCKS=0
OTLP_ENDPOINT="http://localhost:4317"
RUNTIME_PROCESSES=1
RUNTIME_PROCESS_MODE=LOCAL

# Host
