CLOUD=private
REGION=eu-zurich
LOG_LEVEL=DEBUG
LOG_MODE=PLAIN
LOG_PROMPTS=0
LOG_COMPLETIONS=0
TRACING=1
TRACE_LOCKS=0
OTLP_ENDPOINT="http://localhost:4317"
RUNTIME_PROCESSES=1
RUNTIME_PROCESS_MODE=LOCAL

# Sharding
GALAXY_MAP="eu-zurich/test-0=127.0.0.1"
GLOBAL_DATABASE_URL="postgresql://destack:destack@127.0.0.1:5432/destack-global"
DATABASE_MAP="eu-zurich/dev-0/db-0=postgresql://destack:destack@127.0.0.1:5432/destack-db-0"

# S3
S3_REGION="eu-central-1"
S3_ENDPOINT="http://localhost:19000"
S3_ACCESS_KEY="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_KEY="UKht5CaJPQ5ZCaAsfFY52URhg7RWv8V2489e9qSpoAhJRw97gttSBkEWU65wtGz"

# Machine
KUBERNETES_KUBECONFIG_PATH=~/.kube/config
DESTACK_URL="http://localhost:60061"
MACHINE_RUNTIME_IMAGE="ghcr.io/symbolx/destack-machine-runtime"
MACHINE_UBUNTU_DESKTOP_IMAGE="ghcr.io/symbolx/destack-machine-ubuntu-desktop"
MACHINE_UBUNTU_TERMINAL_IMAGE="ghcr.io/symbolx/destack-machine-ubuntu-terminal"
MACHINE_GRPC_PORT=5432
MACHINE_VNC_PORT=6080
KUBERNETES_NAMESPACE=default
KUBERNETES_IMAGE_PULL_SECRET=destack-dev-private-eu-zurich-image-pull-secret

# Web
WEBAPP_URL="http://127.0.0.1:5173"
